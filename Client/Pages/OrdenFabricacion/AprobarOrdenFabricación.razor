    /// <summary>
    /// Maneja el cierre del modal de depósito de consumo sin selección
    /// </summary>
    private void OnModalDepositoConsumoCerrado()
    {
        mostrarModalDepositoConsumo = false;
        
        // Si estamos en el flujo inicial de validación y el depósito requiere selección manual,
        // no podemos continuar sin una selección válida
        if (tipoDepositoSeleccionando == "consumo")
        {
            // El usuario debe seleccionar un depósito válido para continuar
            StateHasChanged();
            return;
        }
        
        // Si estamos cambiando desde la confirmación, no hacer nada más
        StateHasChanged();
    }

    /// <summary>
    /// Procesa la aprobación de la orden de fabricación
    /// Utiliza la funcionalidad existente de cierre de órdenes
    /// </summary>
    private async Task ProcesarAprobacion()
    {
        try
        {
            // 1. Solicitar cantidad a aprobar al usuario
            var cantidadConfirmada = await SolicitarCantidadAprobacion();
            if (cantidadConfirmada <= 0)
            {
                return; // Usuario canceló
            }

            // 2. Validar que no se apruebe más de lo pendiente
            if (saldoPendiente < cantidadConfirmada)
            {
                await sweetAlertService.FireAsync("Error", "Imposible aprobar más cantidad que la pendiente.", SweetAlertIcon.Error);
                return;
            }

            // 3. Confirmación final
            var confirmacionFinal = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmar Aprobación",
                Text = $"¿Confirma cantidades aprobadas por {cantidadConfirmada:F1}?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, Continuar",
                CancelButtonText = "No, Cancelar"
            });

            if (!confirmacionFinal.IsConfirmed)
                return;

            // Mostrar spinner mientras se procesa la aprobación y se refresca la grilla.
            procesandoAprobacion = true;
            StateHasChanged();

            try
            {
                // 4. Usar el endpoint existente de cierre con control de calidad
                await ProcesarAprobacionConCierreExistente(cantidadConfirmada);

                // 5. Mensaje de éxito
                await sweetAlertService.FireAsync("Éxito", "Aprobación procesada correctamente", SweetAlertIcon.Success);

                // 6. Preparar y mostrar el Vale Interno (mismo formato que el emitido al cerrar
                // una O.F. desde la grilla de Órdenes de Fabricación).
                var authState = await AuthProvider.GetAuthenticationStateAsync();
                nombreUsuarioActualVale = authState.User.Identity?.Name ?? "Usuario";
                cantidadVale = cantidadConfirmada;
                observacionesVale = string.Empty;
                mostrarModalVistaPreviaVale = true;
            }
            finally
            {
                // Ocultar spinner una vez que terminó el procesamiento.
                procesandoAprobacion = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // En caso de error, asegurar que el spinner se oculte.
            procesandoAprobacion = false;
            StateHasChanged();

            await sweetAlertService.FireAsync("Error", 
                $"Error al procesar la aprobación: {ex.Message}", 
                SweetAlertIcon.Error);
        }
    }

