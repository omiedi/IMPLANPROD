@page "/AprobarOrdenfabricacion"
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Shared.Components
@using CurrieTechnologies.Razor.SweetAlert2
@using Microsoft.AspNetCore.Components.Authorization
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager
@inject HttpClient Http
@inject PageAccessService PageAccess
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Aprobación de Órdenes de Fabricación</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
<div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-3 d-flex justify-content-between align-items-center">
    <h3 class="m-0 text-primary">Aprobación de Órdenes de Fabricación</h3>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center">
        <input style="width: 400px;" type="text" class="form-control me-2" placeholder="Buscar..." @bind-value="Filter" />
        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>
</div>

<div class="text-muted" style="font-size: 0.85rem; margin-top: -0.5rem;">
    Podés combinar términos con <b>+</b> para exigir coincidencia de ambos (AND). Ej: <code>motor + 450</code>
</div>

<Pagination CurrentPage="currentPage"
            TotalPages="totalPages"
            SelectedPage="SelectedPageAsync" />

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (registros.Count == 0)
{ 
    <div class="alert alert-info mt-3">
        <i class="oi oi-info me-2"></i> No se encontraron registros que coincidan con la búsqueda.
    </div>

}
else
{
    <!-- Contenedor con scroll para más de 16 filas -->
    <div class="table-responsive" style="@(registros.Count > 16 ? "max-height: 800px; overflow-y: auto;" : "")">
        <table class="table table-striped">
            <thead class="sticky-top bg-white">
                <tr>
                    <th>Número O.F.</th>
                    <th>Código Interno</th>
                    <th>Código Externo</th>
                    <th>Descripción</th>
                    <th>Pend.Aprob.</th>
                    <th>Id Cierre</th>
                    <th>Fecha Generación</th>
                    <th>Deposito</th>
                    <th>Ref.Depósito</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in registros)
                {
                    <tr>
                        <td>@item.DoPriCor</td>
                        <td>@item.Cod_Inte</td>
                        <td>@item.Cod_Exte</td>
                        <td>@GetDescripcion(item.Cod_Inte ?? 0)</td>
                        <td>@item.Ajuste</td>
                        <td>@item.IDTEXT</td>
                        <td>@(item.FechMov?.ToShortDateString() ?? "")</td>
                        <td>@item.DepoMovi</td>
                        <td>@GetDepositos(item.DepoMovi ?? 0)</td>
                        <td>
                            <button class="btn btn-success btn-sm" title="Aprobar Orden" 
                                    @onclick="() => AprobarOrden(item)">
                                <i class="oi oi-check"></i> Aprobar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
}

<!-- Componente modal para seleccionar depósito de entrada -->
<DepositoSelectorModal IsVisible="mostrarModalDeposito"
                       OnDepositoSeleccionado="@(EventCallback.Factory.Create<DepositoSeleccionadoDTO>(this, OnDepositoEntradaSeleccionado))"
                       OnModalClosed="@(EventCallback.Factory.Create(this, OnModalDepositoEntradaCerrado))"
                       DepositoPorDefecto="depositoEntrada" />

<!-- Componente modal para seleccionar depósito de consumo -->
<DepositoSelectorModal IsVisible="mostrarModalDepositoConsumo"
                       OnDepositoSeleccionado="@(EventCallback.Factory.Create<DepositoSeleccionadoDTO>(this, OnDepositoConsumoSeleccionado))"
                       OnModalClosed="@(EventCallback.Factory.Create(this, OnModalDepositoConsumoCerrado))"
                       DepositoPorDefecto="depositoConsumo" />

@* Modal de vista previa del Vale Interno emitido al aprobar una Orden de Fabricación *@
@if (mostrarModalVistaPreviaVale && ordenSeleccionadaActual != null)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="oi oi-file me-2"></i>Vale Interno - Aprobación de Orden de Fabricación
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarVistaPreviaVale"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <strong>Observaciones</strong>
                                </div>
                                <div class="card-body">
                                    <textarea class="form-control" rows="4" placeholder="Ingrese observaciones para el vale interno..." @bind="observacionesVale"></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <strong>Vista Previa</strong>
                                </div>
                                <div class="card-body">
                                    <div style="font-family: 'Courier New', monospace; font-size: 12px; border: 1px solid #ccc; padding: 20px; background: white;">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <strong>VALE INTERNO</strong>
                                            </div>
                                            <div class="text-end">
                                                <div>FECHA DE CIERRE: @DateTime.Now.ToString("dd/MM/yyyy")</div>
                                                <div>Origen: @(ordenFabricacionSeleccionada)</div>
                                            </div>
                                        </div>

                                        <div style="border-top: 1px solid black; margin: 10px 0;"></div>

                                        <div class="row mb-2" style="font-weight: bold;">
                                            <div class="col-3">Código</div>
                                            <div class="col-6">Descripción</div>
                                            <div class="col-3 text-end">Cantidad</div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-3">@(ordenSeleccionadaActual.Cod_Exte)</div>
                                            <div class="col-6">@GetDescripcion(ordenSeleccionadaActual.Cod_Inte ?? 0)</div>
                                            <div class="col-3 text-end">@FormatDecimalVale(cantidadVale)</div>
                                        </div>

                                        <div style="border-top: 1px solid black; margin: 10px 0;"></div>
                                        <div style="border-top: 1px solid black; margin: 10px 0;"></div>
                                        <div style="border-top: 1px solid black; margin: 10px 0;"></div>

                                        @if (!string.IsNullOrWhiteSpace(observacionesVale))
                                        {
                                            <div class="mt-3">
                                                <strong>Observaciones:</strong>
                                                <div style="white-space: pre-wrap;">@observacionesVale</div>
                                            </div>
                                            <div style="border-top: 1px solid black; margin: 10px 0;"></div>
                                        }

                                        <div class="text-end mt-3">
                                            <strong>Cerró: @nombreUsuarioActualVale</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-info" @onclick="ImprimirValeOF">
                        <i class="oi oi-print me-1"></i>Imprimir
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelarVistaPreviaVale">
                        <i class="oi oi-check me-1"></i>Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- Área de impresión del Vale Interno (aprobación de O.F.) -->
