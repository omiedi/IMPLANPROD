</div>

@if (procesandoAprobacion)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
         style="background-color: rgba(0,0,0,0.4); z-index: 1050;">
        <div class="bg-white rounded-3 p-4 text-center shadow">
            <div class="spinner-border text-primary mb-2" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Procesando...</span>
            </div>
            <div class="fw-semibold text-primary">Procesando aprobación...</div>
        </div>
    </div>
}

@code
{



    private List<int> depositos = new List<int>();
    private int idFlexoftUsuario = 0;
    private List<OFabricacionRequestDTO> paramUserDepos = new List<OFabricacionRequestDTO>();
    private List<Orfapen> registros = new List<Orfapen>();
    private Dictionary<int, string> descripciones = new Dictionary<int, string>();
    private Dictionary<int, string> descripDepos = new Dictionary<int, string>();
    private bool validando = true;
    private bool esSuperAdmin = false;
    
    // Variables para el proceso de aprobación
    private Orfapen? ordenSeleccionadaActual;
    private string ordenFabricacionSeleccionada = string.Empty;
    private string idTextCierre = string.Empty;
    private decimal saldoPendiente = 0;
    private int depositoEntrada = 0;
    private int depositoConsumo = 0;

    // ------------------------------------------------------------------
    // VALE INTERNO (impreso al aprobar una Orden de Fabricación)
    // ------------------------------------------------------------------
    private bool mostrarModalVistaPreviaVale = false;
    private string? nombreUsuarioActualVale;
    private string observacionesVale = string.Empty;
    private decimal cantidadVale;
    private const string idAreaImpresionValeOF = "areaImpresionValeAprobacionOF";
    
    // Variables para el modal de selección de depósito
    private bool mostrarModalDeposito = false;
    private bool mostrarModalDepositoConsumo = false;
    private bool depositoCambiado = false;
    private bool depositoConsumoCambiado = false;
    private string tipoDepositoSeleccionando = string.Empty; // "entrada" o "consumo"

    // Spinner que se muestra mientras se procesa la aprobación y se refresca la grilla.
    private bool procesandoAprobacion = false;

    // Spinner que se muestra mientras se cargan los resultados (filtro o paginación).
    private bool isLoading = false;

    public class DescripcionResponse
    {
        public string? Descripcion { get; set; }
    }

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
        await PageAccess.RequiereAccesoAsync("/AprobarOrdenfabricacion");
        validando = false;

        // Verificar si el usuario es SUPERADMIN
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        esSuperAdmin = authState.User.IsInRole("SUPERADMIN");

        await InicializarContextoAsync();
        await LoadAsync();
    }

    private async Task InicializarContextoAsync()
    {
        try
        {
            // Si es SUPERADMIN, no filtrar por usuario ni depósito
            if (esSuperAdmin)
            {
                return;
            }

            // 1. Obtener el idFlexoft del usuario logueado
            var responseUsuario = await repository.Get<int?>("api/Usuarios/InterObtenerIdFlexoft");
            if (responseUsuario.Error || responseUsuario.Response == null || !responseUsuario.Response.HasValue)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo obtener la información del usuario logueado", SweetAlertIcon.Error);
                return;
            }

            idFlexoftUsuario = responseUsuario.Response.Value;


            // 2. Obtener el codigoSecProd de UsuariosSectorProd según el idFlexoft
            var responseCodigosSector = await repository.Get<List<int>>($"api/usuariossectorprod/codigossector/{idFlexoftUsuario}");

            if (responseCodigosSector.Error || responseCodigosSector.Response == null || !responseCodigosSector.Response.Any())
            {
                await sweetAlertService.FireAsync("Error", "No se encontró asignación de sector para el usuario logueado", SweetAlertIcon.Error);
                return;
            }

            var codigosSector = responseCodigosSector.Response;
            //
            // 3. Obtener el depósito de la tabla Secprod usando el codigoSecProd
            if (codigosSector == null || !codigosSector.Any())
            {
                await sweetAlertService.FireAsync("Error", "No se encontraron sectores asignados", SweetAlertIcon.Error);
                return;
            }

            // Llamar al nuevo endpoint que devuelve los depósitos
            var responseDepositos = await repository.Get<List<int>>($"api/secprod/depositos?codigos={string.Join(",", codigosSector)}");

            if (responseDepositos.Error || responseDepositos.Response == null || !responseDepositos.Response.Any())
            {
                await sweetAlertService.FireAsync("Error", "No se encontró información de depósitos", SweetAlertIcon.Error);
                return;
            }

            depositos = responseDepositos.Response;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al obtener datos del usuario: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private async Task LoadAsync(int page = 1)
    {
        // Si no es SUPERADMIN y no tiene contexto de usuario, no cargar
        if (!esSuperAdmin && (idFlexoftUsuario <= 0 || depositos == null || !depositos.Any()))
        {
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            currentPage = page;

            var parametros = new OFabricacionRequestDTO
            {
                IdFlexoftUsuario = esSuperAdmin ? null : idFlexoftUsuario,
                Depositos = esSuperAdmin ? null : depositos,
                Page = page,
                RecordsNumber = 10,
                Filter = string.IsNullOrWhiteSpace(Filter) ? null : Filter
            };

            var responseOrdenes = await repository.Post<OFabricacionRequestDTO, List<Orfapen>>(
                "api/AprobacionOrdenFabricacion/pendientesAprobacion", parametros);

            if (responseOrdenes.Error || responseOrdenes.Response == null)
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron obtener las órdenes pendientes de aprobación", SweetAlertIcon.Error);
                return;
            }

            var responsePages = await repository.Post<OFabricacionRequestDTO, int>(
                "api/AprobacionOrdenFabricacion/totalPages", parametros);

            if (!responsePages.Error)
            {
                totalPages = responsePages.Response;
            }

            registros = responseOrdenes.Response;

            // Cargar descripciones
            await CargarDescripciones();
            await CargarDepositos();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        await LoadAsync(1);
    }

    private async Task SelectedPageAsync(int page)
    {
        await LoadAsync(page);
    }


    private async Task CargarDescripciones()
    {
        try
        {
            foreach (var item in registros)
            {
                int codInte = item.Cod_Inte ?? 0;
                if (codInte > 0 && !descripciones.ContainsKey(codInte)) //ContainsKey(codInte) devuelve true si ya cargaste antes la descripción para ese codigo
                {  
                    var response = await Http.GetStringAsync($"api/masterfunciones/descripcion/{codInte}"); // con GetStringAsync por que con
                    var descripcion = response?.Trim() ?? string.Empty;                                     //ar response = await repository.Get<string>($"api/masterfunciones/descripcion/{codInte}");
                                                                                                            // daba error
                    descripciones[codInte] = descripcion;
                    if ( descripcion != null)
                    {
                        descripciones[codInte] = descripcion; //  Guardamos la descripción
                    }
                    else
                    {
                        descripciones[codInte] = string.Empty; //  Fallback si no hay descripción
                    }
                }
            }
            StateHasChanged(); //  Actualiza la UI si estás en Blazor
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar descripciones: {ex.Message}");
        }
    }  private string GetDescripcion(int codInte)
    {// esta es la llamada de la parte html que lee aca el vector diccionario
        if (codInte > 0 && descripciones.ContainsKey(codInte))
        {
            return descripciones[codInte];
        }
        return "Cargando...";
    }
    private async Task CargarDepositos()
    {//leer todos los depositos es decir retornar una lista y luego asignar al vector en GetDepositos
        try
        {
            
                foreach (var item in registros)
                {
                    int depo = item.DepoMovi ?? 0;
                if (depo > 0 && !descripciones.ContainsKey(depo)) //ContainsKey(depo) devuelve true si ya cargaste antes la descripción para ese depósito
                    {
                    var response = await Http.GetStringAsync($"api/tadeposi/descripcion/{depo}"); // con GetStringAsync por que con
                        var descriDepo = response?.Trim() ?? string.Empty;                                     //ar response = await repository.Get<string>($"api/masterfunciones/descripcion/{codInte}");
                                                                                                               // daba error
                        descripDepos[depo] = descriDepo;
                        if (descriDepo != null)
                        {
                            descripDepos[depo] = descriDepo; //  Guardamos la descripción
                        }
                        else
                        {
                            descripDepos[depo] = string.Empty; //  Fallback si no hay descripción
                        }
                    }
                }
                StateHasChanged(); //  Actualiza la UI si estás en Blazor
         }   
                catch (Exception ex)
                 {
                  Console.WriteLine($"Error al cargar descripciones: {ex.Message}");
                 }
    }
    private string GetDepositos(int Deposito)
    {// esta es la llamada de la parte html que lee aca el vector diccionario
        if (Deposito > 0 && descripDepos.ContainsKey(Deposito))
        {
            return descripDepos[Deposito];
        }
        return "Cargando...";
    }

    /// <summary>
    /// Procesa la aprobación de una orden de fabricación
    /// Captura O.F., IDTEXT de cierre, SALDO y valida depósitos
    /// </summary>
    private async Task AprobarOrden(Orfapen orden)
    {
        try
        {
            // Capturar datos de la orden seleccionada (se guarda la orden completa para poder
            // armar el Vale Interno con su código/descripción una vez aprobada).
            ordenSeleccionadaActual = orden;
            ordenFabricacionSeleccionada = orden.DoPriCor ?? string.Empty;
            idTextCierre = orden.IDTEXT ?? string.Empty;
            saldoPendiente = orden.Ajuste;
            
            // Validar que tenemos los datos necesarios
            if (string.IsNullOrEmpty(ordenFabricacionSeleccionada))
            {
                await sweetAlertService.FireAsync("Error", "No se pudo obtener el número de orden de fabricación", SweetAlertIcon.Error);
                return;
            }
            
            if (string.IsNullOrEmpty(idTextCierre))
            {
                await sweetAlertService.FireAsync("Error", "No se pudo obtener el ID de cierre", SweetAlertIcon.Error);
                return;
            }
            
            // Leer y validar el depósito de entrada desde ORFAPEN
            await ValidarDepositoEntrada();
            
            // Leer y validar el depósito de consumo desde ORFAPEN
            await ValidarDepositoConsumo();
            
            // Mostrar información capturada para confirmación con opción de cambiar depósitos
            await MostrarConfirmacionAprobacion();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al procesar la aprobación: {ex.Message}", SweetAlertIcon.Error);
        }
    }
    
    /// <summary>
    /// Valida el depósito de entrada leyendo desde ORFAPEN
    /// donde DOPRICOR = Orden de Fabricación seleccionada y CODIMOVI = 'OF'
    /// </summary>
    private async Task ValidarDepositoEntrada()
    {
        try
        {
            // Llamar al endpoint para obtener el depósito de entrada
            var response = await repository.Get<int?>($"api/orfapen/deposito-entrada?ordenFabricacion={ordenFabricacionSeleccionada}&codigoMovimiento=OF");
            
            if (response.Error || !response.Response.HasValue)
            {
                await sweetAlertService.FireAsync("Error", 
                    $"No se pudo obtener el depósito de entrada para la O.F. {ordenFabricacionSeleccionada}", 
                    SweetAlertIcon.Error);
                return;
            }
            
            depositoEntrada = response.Response.Value;
            
            // Validar que el depósito es válido
            if (depositoEntrada <= 0)
            {
                await sweetAlertService.FireAsync("Error", 
                    $"Depósito de entrada inválido ({depositoEntrada}) para la O.F. {ordenFabricacionSeleccionada}", 
                    SweetAlertIcon.Error);
                return;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", 
                $"Error al validar depósito de entrada: {ex.Message}", 
                SweetAlertIcon.Error);
            throw;
        }
    }
    
    /// <summary>
    /// Valida el depósito de consumo leyendo desde ORFAPEN
    /// </summary>
    private async Task ValidarDepositoConsumo()
    {
        try
        {
            var response = await repository.Get<DepositoConsumoResponseDTO>($"api/orfapen/deposito-consumo?ordenFabricacion={ordenFabricacionSeleccionada}");
            
            if (response.Response != null)
            {
                depositoConsumo = response.Response.CodigoDeposito;
                
                // Si el depósito está inactivo o requiere selección manual, mostrar modal
                if (response.Response.RequiereSeleccion)
                {
                    await sweetAlertService.FireAsync("Atención", 
                        response.Response.Mensaje, 
                        SweetAlertIcon.Warning);
                    
                    // Abrir modal para seleccionar depósito de consumo
                    tipoDepositoSeleccionando = "consumo";
                    mostrarModalDepositoConsumo = true;
                    StateHasChanged();
                    return;
                }
            }
            else
            {
                await sweetAlertService.FireAsync("Error", 
                    "No se pudo obtener información del depósito de consumo", 
                    SweetAlertIcon.Error);
                throw new Exception("No se pudo obtener depósito de consumo");
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", 
                $"Error al validar depósito de consumo: {ex.Message}", 
                SweetAlertIcon.Error);
            throw;
        }
    }
    
    /// <summary>
    /// Muestra las opciones para cambiar depósitos
    /// </summary>
    private async Task MostrarOpcionesCambioDeposito()
    {
        try
        {
            var confirmacion = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Cambiar Depósitos",
                Text = "¿Qué depósito desea cambiar?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ShowDenyButton = true,
                ConfirmButtonText = "📥 Depósito Entrada",
                DenyButtonText = "📤 Depósito Consumo",
                CancelButtonText = "✖ Cancelar",
                ConfirmButtonColor = "#007bff",
                DenyButtonColor = "#28a745",
                CancelButtonColor = "#6c757d"
            });
            
            if (confirmacion.IsConfirmed)
            {
                // Cambiar depósito de entrada
                tipoDepositoSeleccionando = "entrada";
                mostrarModalDeposito = true;
