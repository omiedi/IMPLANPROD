    /// <summary>
    /// Muestra la confirmación de aprobación con opciones para cambiar depósitos
    /// </summary>
    private async Task MostrarConfirmacionAprobacion()
    {
        try
        {
            // Obtener descripciones de los depósitos
            var descripcionDepositoEntrada = await ObtenerDescripcionDeposito(depositoEntrada);
            var descripcionDepositoConsumo = await ObtenerDescripcionDeposito(depositoConsumo);
            
            var mensaje = $"Orden de Fabricación: {ordenFabricacionSeleccionada}\n" +
                         $"ID Cierre: {idTextCierre}\n" +
                         $"Saldo Pendiente: {saldoPendiente:F4}\n" +
                         $"Depósito de Entrada: {depositoEntrada} - {descripcionDepositoEntrada}\n" +
                         $"Depósito de Consumo: {depositoConsumo} - {descripcionDepositoConsumo}\n\n" +
                         "Seleccione una opción:";
            
            var confirmacion = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmar Aprobación",
                Html = mensaje.Replace("\n", "<br>"),
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ShowDenyButton = true,
                ConfirmButtonText = "✓ Aprobar",
                DenyButtonText = "🔄 Cambiar Depósitos",
                CancelButtonText = "✖ Cancelar",
                ConfirmButtonColor = "#28a745",
                DenyButtonColor = "#ffc107",
                CancelButtonColor = "#6c757d"
            });
            
            if (confirmacion.IsConfirmed)
            {
                // Aprobar con los depósitos actuales
                await ProcesarAprobacion();
            }
            else if (confirmacion.IsDenied)
            {
                // Mostrar opciones para cambiar depósitos
                await MostrarOpcionesCambioDeposito();
            }
            // Si es cancelado, no hacer nada
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", 
                $"Error al mostrar confirmación: {ex.Message}", 
                SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Obtiene la descripción de un depósito
    /// </summary>
    private async Task<string> ObtenerDescripcionDeposito(int codigoDeposito)
    {
        try
        {
            if (descripDepos.ContainsKey(codigoDeposito))
            {
                return descripDepos[codigoDeposito];
            }
            
            var response = await Http.GetStringAsync($"api/tadeposi/descripcion/{codigoDeposito}");
            var descripcion = response?.Trim() ?? string.Empty;
            
            // Guardar en cache para futuras consultas
            descripDepos[codigoDeposito] = descripcion;
            
            return descripcion;
        }
        catch
        {
            return "Descripción no disponible";
        }
    }

