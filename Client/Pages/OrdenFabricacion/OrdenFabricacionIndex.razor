                         $"DepoEntrada: {ordenParaCierre.DepoEntrada}, " +
                         $"DepoSalida: {ordenParaCierre.DepoSalida}, " +
                         $"DepoScrap: {ordenParaCierre.DepoScrap}");
    }

    /// <summary>
    /// Muestra el modal de componentes con la fórmula del producto
    /// Si no hay fórmula, continúa directamente con el cierre sin consumir componentes
    /// </summary>
    private async Task MostrarModalComponentes()
    {
        try
        {
            cargandoComponentes = true;
            mostrarModalComponentes = true;
            StateHasChanged();

            // Obtener los componentes de la fórmula con stock
            var responseComponentes = await repository.Get<List<FormulaComponenteDTO>>($"api/formulas/componentes/{ordenParaCierre.Cod_Inte}");

            if (responseComponentes.Error)
            {
                // Si no se pudieron obtener los componentes, mostrar advertencia y continuar sin consumir componentes
                var result = await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Sin Fórmula",
                    Text = "No se pudieron obtener los componentes de la fórmula. Se continuará con el cierre dando de alta solo el producto terminado sin consumir componentes.",
                    Icon = SweetAlertIcon.Warning,
                    ShowCancelButton = true,
                    ConfirmButtonText = "Continuar",
                    CancelButtonText = "Cancelar"
                });

                mostrarModalComponentes = false;
                
                if (result.IsConfirmed)
                {
                    // Continuar con el cierre sin componentes
                    componentesFormula = new List<FormulaComponenteDTO>();
                    await ContinuarConCierre();
                }
                else
                {
                    procesandoCierre = false;
                    StateHasChanged();
                }
                
                return;
            }

            componentesFormula = responseComponentes.Response ?? new List<FormulaComponenteDTO>();

            // Si la lista de componentes está vacía, continuar sin consumir componentes
            if (componentesFormula.Count == 0)
            {
                var result = await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Sin Componentes",
                    Text = "El producto no tiene componentes en su fórmula. Se continuará con el cierre dando de alta solo el producto terminado.",
                    Icon = SweetAlertIcon.Warning,
                    ShowCancelButton = true,
                    ConfirmButtonText = "Continuar",
                    CancelButtonText = "Cancelar"
                });

                mostrarModalComponentes = false;
                
                if (result.IsConfirmed)
                {
                    await ContinuarConCierre();
                }
                else
                {
                    procesandoCierre = false;
                    StateHasChanged();
                }
                
                return;
            }

            // Calcular la cantidad total a cerrar para los cálculos
            // Usar las variables locales del modal, no las propiedades del DTO que son nullable
            decimal cantidadTotalACerrar = cantidadAprobada + cantidadRechazada;

            // Actualizar las cantidades necesarias basándose en la cantidad a cerrar
            // e inicializar CantidadAUtilizar con el valor calculado (editable por el usuario)
            foreach (var componente in componentesFormula)
            {
                componente.NecesidadTotal = componente.UsoBruto * cantidadTotalACerrar;
                // Inicializar la cantidad a utilizar con la cantidad calculada
                // El usuario podrá modificar este valor en el modal
                componente.CantidadAUtilizar = componente.NecesidadTotal;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar componentes: {ex.Message}", SweetAlertIcon.Error);
            mostrarModalComponentes = false;
            procesandoCierre = false;
        }
        finally
        {
            cargandoComponentes = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Cancela el modal de componentes y detiene el proceso de cierre
    /// </summary>
    private void CancelarModalComponentes()
    {
        // Cerrar el modal de componentes sin continuar con el proceso
        mostrarModalComponentes = false;

        // Restablecer el estado del modal principal de cierre para que el usuario pueda modificar datos si lo desea
        procesandoCierre = false;
        StateHasChanged();

        // No se cierra el modal principal de cierre, permitiendo al usuario hacer modificaciones
        // El usuario puede volver a intentar el cierre o cancelar desde el modal principal
    }

    /// <summary>
    /// Continúa con el proceso de cierre después de revisar los componentes
    /// Procesa la persistencia de datos en las tablas correspondientes
    /// </summary>
    private async Task ContinuarConCierre()
    {
        try
        {
            // Cerrar el modal de componentes
            mostrarModalComponentes = false;
            procesandoCierre = true;
            StateHasChanged();

            // Preparar los datos para el cierre avanzado
            var datosCierre = new DatosCierreAvanzadoDTO
                {
                    IdOrden = idOrdenParaCierre,
                    IdSubOr = ordenParaCierre?.IdSubOr ?? string.Empty,
                    CantidadAprobada = cantidadAprobada,
                    CantidadRechazada = cantidadRechazada,
                    DepositoEntrada = depositoEntradaSeleccionado > 0 ? depositoEntradaSeleccionado : null,
                    DepositoSalida = depositoConsumoSeleccionado > 0 ? depositoConsumoSeleccionado : null,
                    DepositoScrap = depositoScrapSeleccionado > 0 ? depositoScrapSeleccionado : null,
                    FechaCierre = fechaCierre,
                    CierraCompleto = cierraCompleto,
                    ModoCierreCalidad = 0, // Por ahora en modo normal, se puede parametrizar después
                    Componentes = componentesFormula?.Select(c => new ComponenteCierreDTO
                    {
                        CodIElem = c.CodIElem,
                        CodXElem = c.CodXElem,
                        Descripcion = c.Descripcion,
                        UsoBruto = c.UsoBruto,
                        CantidadAUtilizar = c.CantidadAUtilizar,
                        Stock = c.Stock
                    }).ToList() ?? new List<ComponenteCierreDTO>()
                };

            // Llamar al endpoint de cierre avanzado
            var response = await repository.Post("api/ordefabr/procesarCierreAvanzado", datosCierre);

            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error",
                    await response.GetErrorMessageAsync(),
                    SweetAlertIcon.Error);
                return;
            }

            // Mostrar mensaje de éxito
            string mensajeCierre = cierraCompleto == 1 ? "La orden se cerró completamente" : "La orden se mantuvo abierta";
            await sweetAlertService.FireAsync("Éxito",
                $"Cierre procesado exitosamente. {mensajeCierre}. Se han actualizado las cantidades y generado las anotaciones correspondientes.",
                SweetAlertIcon.Success);

            // Cerrar el modal principal de cierre
            CerrarModalCierre();

            // Recargar la lista de órdenes para reflejar los cambios
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error",
                $"Error al procesar el cierre: {ex.Message}",
                SweetAlertIcon.Error);
        }
        finally
        {
            procesandoCierre = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Valida las reservas y determina si la orden se cierra completamente o se mantiene abierta
    /// </summary>
    /// <returns>True si se puede continuar con el cierre, False si se debe cancelar</returns>
    private async Task<bool> ValidarReservasYSaldoPendiente()
    {
        try
        {
            if (ordenParaCierre == null)
            {
                await sweetAlertService.FireAsync("Error", "No se encontraron datos de la orden para validar.", SweetAlertIcon.Error);
                return false;
            }

            // Buscar reservas en la tabla reserva según la orden de fabricación (idsubor)
            var responseReservas = await repository.Get<List<Reserva>>($"api/reservas/por-of/{ordenParaCierre.IdSubOr}");

            if (responseReservas.Error)
            {
                await sweetAlertService.FireAsync("Error", "Error al consultar las reservas de la orden de fabricación.", SweetAlertIcon.Error);
                return false;
            }

            // Calcular el saldo pendiente de la OF
            // Saldo pendiente = Cantidad Proyectada - Cantidad ya Aprobada
            decimal saldoPendiente = (ordenParaCierre.CanProy ?? 0) - (ordenParaCierre.CanApro ?? 0);

            // Cantidad total a cerrar = cantidad aprobada + cantidad rechazada
            decimal cantidadACerrar = cantidadAprobada + cantidadRechazada;

            // Validar si la cantidad a cerrar es igual o mayor al saldo pendiente
            if (cantidadACerrar >= saldoPendiente)
            {
                // La cantidad es suficiente para cerrar completamente la orden
                cierraCompleto = 1;

                // Log para verificación
                Console.WriteLine($"Cantidad a cerrar ({cantidadACerrar}) >= Saldo pendiente ({saldoPendiente}) - CIERRA% = 1");

                return true;
            }
            else
            {
                // La cantidad es menor al saldo pendiente, consultar al usuario
                var resultado = await sweetAlertService.FireAsync(new SweetAlertOptions
                    {
                        Title = "Saldo Pendiente",
                        Text = $"Esta O/F queda con un Saldo Pendiente de {FormatDecimal(saldoPendiente - cantidadACerrar)}.\n¿Qué desea hacer?",
                        Icon = SweetAlertIcon.Question,
                        ShowCancelButton = true,
                        ConfirmButtonText = "Cerrar",
                        CancelButtonText = "Mantener Abierta",
                        ConfirmButtonColor = "#d33",
                        CancelButtonColor = "#3085d6"
                    });

                if (resultado.IsConfirmed)
                {
                    // Usuario eligió cerrar la orden a pesar del saldo pendiente
                    cierraCompleto = 1;
                    Console.WriteLine($"Usuario eligió CERRAR - CIERRA% = 1");
                }
                else
                {
                    // Usuario eligió mantener abierta la orden
                    cierraCompleto = 0;
                    Console.WriteLine($"Usuario eligió MANTENER ABIERTA - CIERRA% = 0");
                }

                return true; // Continuar con el proceso independientemente de la elección
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al validar reservas: {ex.Message}", SweetAlertIcon.Error);
            return false;
        }
    }

    /// <summary>
    /// Carga los depósitos disponibles
    /// </summary>
    private async Task CargarDepositosDisponibles()
    {
        var response = await repository.Get<Dictionary<int, string>>("api/tadeposi/combo");
        if (!response.Error)
        {
            depositosDisponibles = response.Response;
        }
    }

    /// <summary>
    /// Carga los datos de la orden para el modal
    /// </summary>
    private async Task CargarDatosOrdenParaCierre()
    {
        var response = await repository.Get<OrdefabrIndexDTO>($"api/ordefabr/{idOrdenParaCierre}");
        if (!response.Error)
        {
            ordenParaCierre = response.Response;
        }
    }

    /// <summary>
    /// Carga la configuración del depósito scrap desde flexcrl
    /// </summary>
    private async Task CargarConfiguracionDepositoScrap()
    {
        try
        {
            // Usar "empty" como placeholder para el parámetro CLABUS vacío
            var response = await repository.Get<FLEXCRL>($"api/flexcrl/empty/DEPSCRAP");
            if (!response.Error && response.Response != null)
            {
                // Intentar convertir el valor a entero
                if (int.TryParse(response.Response.VALCONTROL, out int valor))
                {
                    depositoScrapConfiguracion = valor;
                }
            }
        }
        catch (Exception)
        {
            // En caso de error, usar valor por defecto
            depositoScrapConfiguracion = 0;
        }
    }



    /// <summary>
    /// Valida los datos del modal de cierre según los requisitos especificados
    /// </summary>
    /// <returns>True si todas las validaciones pasan, False en caso contrario</returns>
    private async Task<bool> ValidarDatosCierre()
    {
        // Validación 1: Al menos una cantidad debe ser mayor a 0
        if (cantidadAprobada <= 0 && cantidadRechazada <= 0)
        {
            await sweetAlertService.FireAsync("Validación", "Debe ingresar al menos una cantidad aprobada o rechazada mayor a cero.", SweetAlertIcon.Warning);
            return false;
        }

        // Validación 2: No debe haber cantidades negativas
        if (cantidadAprobada < 0 || cantidadRechazada < 0)
        {
            await sweetAlertService.FireAsync("Validación", "Las cantidades no pueden ser negativas.", SweetAlertIcon.Warning);
            return false;
        }

        // Validación 3: Ambos depósitos deben estar seleccionados
        if (depositoEntradaSeleccionado <= 0 || depositoConsumoSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Validación", "Debe seleccionar tanto el depósito de entrada como el de salida.", SweetAlertIcon.Warning);
            return false;
        }

        // Validación 4: Si cantidad rechazada > 0, debe seleccionar depósito scrap
        if (cantidadRechazada > 0 && depositoScrapSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Validación", "Debe seleccionar un depósito scrap cuando hay cantidad rechazada.", SweetAlertIcon.Warning);
            return false;
        }

        return true;
    }
}
