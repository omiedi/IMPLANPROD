        }
    }

    /// <summary>
    /// Valida las reservas y determina si la orden se cierra completamente o se mantiene abierta
    /// </summary>
    /// <returns>True si se puede continuar con el cierre, False si se debe cancelar</returns>
    private async Task<bool> ValidarReservasYSaldoPendiente()
    {
        try
        {
            if (ordenParaCierre == null)
            {
                await sweetAlertService.FireAsync("Error", "No se encontraron datos de la orden para validar.", SweetAlertIcon.Error);
                return false;
            }

            // Buscar reservas en la tabla reserva según la orden de fabricación (idsubor)
            var responseReservas = await repository.Get<List<Reserva>>($"api/reservas/por-of/{ordenParaCierre.IdSubOr}");

            if (responseReservas.Error)
            {
                await sweetAlertService.FireAsync("Error", "Error al consultar las reservas de la orden de fabricación.", SweetAlertIcon.Error);
                return false;
            }

            // Calcular el saldo pendiente de la OF
            // Saldo pendiente = Cantidad Proyectada - Cantidad ya Aprobada
            decimal saldoPendiente = (ordenParaCierre.CanProy ?? 0) - (ordenParaCierre.CanApro ?? 0);

            // Cantidad total a cerrar = cantidad aprobada + cantidad rechazada
            decimal cantidadACerrar = cantidadAprobada + cantidadRechazada;

            // Validar si la cantidad a cerrar es igual o mayor al saldo pendiente
            if (cantidadACerrar >= saldoPendiente)
            {
                // La cantidad es suficiente para cerrar completamente la orden
                cierraCompleto = 1;

                // Log para verificación
                Console.WriteLine($"Cantidad a cerrar ({cantidadACerrar}) >= Saldo pendiente ({saldoPendiente}) - CIERRA% = 1");

                return true;
            }
            else
            {
                // La cantidad es menor al saldo pendiente, consultar al usuario
                var resultado = await sweetAlertService.FireAsync(new SweetAlertOptions
                    {
                        Title = "Saldo Pendiente",
                        Text = $"Esta O/F queda con un Saldo Pendiente de {FormatDecimal(saldoPendiente - cantidadACerrar)}.\n¿Qué desea hacer?",
                        Icon = SweetAlertIcon.Question,
                        ShowCancelButton = true,
                        ConfirmButtonText = "Cerrar",
                        CancelButtonText = "Mantener Abierta",
                        ConfirmButtonColor = "#d33",
                        CancelButtonColor = "#3085d6"
                    });

                if (resultado.IsConfirmed)
                {
                    // Usuario eligió cerrar la orden a pesar del saldo pendiente
                    cierraCompleto = 1;
                    Console.WriteLine($"Usuario eligió CERRAR - CIERRA% = 1");
                }
                else
                {
                    // Usuario eligió mantener abierta la orden
                    cierraCompleto = 0;
                    Console.WriteLine($"Usuario eligió MANTENER ABIERTA - CIERRA% = 0");
                }

                return true; // Continuar con el proceso independientemente de la elección
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al validar reservas: {ex.Message}", SweetAlertIcon.Error);
            return false;
        }
    }

    /// <summary>
    /// Carga los depósitos disponibles
    /// </summary>
    private async Task CargarDepositosDisponibles()
    {
        var response = await repository.Get<Dictionary<int, string>>("api/tadeposi/combo");
        if (!response.Error)
        {
            depositosDisponibles = response.Response;
        }
    }

    /// <summary>
    /// Carga los datos de la orden para el modal
    /// </summary>
    private async Task CargarDatosOrdenParaCierre()
    {
        var response = await repository.Get<OrdefabrIndexDTO>($"api/ordefabr/{idOrdenParaCierre}");
        if (!response.Error)
        {
            ordenParaCierre = response.Response;
        }
    }

    /// <summary>
    /// Carga la configuración del depósito scrap desde flexcrl
    /// </summary>
    private async Task CargarConfiguracionDepositoScrap()
    {
        try
        {
            // Usar "empty" como placeholder para el parámetro CLABUS vacío
            var response = await repository.Get<FLEXCRL>($"api/flexcrl/empty/DEPSCRAP");
            if (!response.Error && response.Response != null)
            {
                // Intentar convertir el valor a entero
                if (int.TryParse(response.Response.VALCONTROL, out int valor))
                {
                    depositoScrapConfiguracion = valor;
                }
            }
        }
        catch (Exception)
        {
            // En caso de error, usar valor por defecto
            depositoScrapConfiguracion = 0;
        }
    }



    /// <summary>
    /// Valida los datos del modal de cierre según los requisitos especificados
    /// </summary>
    /// <returns>True si todas las validaciones pasan, False en caso contrario</returns>
    private async Task<bool> ValidarDatosCierre()
    {
        // Validación 1: Al menos una cantidad debe ser mayor a 0
        if (cantidadAprobada <= 0 && cantidadRechazada <= 0)
        {
            await sweetAlertService.FireAsync("Validación", "Debe ingresar al menos una cantidad aprobada o rechazada mayor a cero.", SweetAlertIcon.Warning);
            return false;
        }

        // Validación 2: No debe haber cantidades negativas
        if (cantidadAprobada < 0 || cantidadRechazada < 0)
        {
            await sweetAlertService.FireAsync("Validación", "Las cantidades no pueden ser negativas.", SweetAlertIcon.Warning);
            return false;
        }

        // Validación 3: Ambos depósitos deben estar seleccionados
        if (depositoEntradaSeleccionado <= 0 || depositoConsumoSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Validación", "Debe seleccionar tanto el depósito de entrada como el de salida.", SweetAlertIcon.Warning);
            return false;
        }

        // Validación 4: Si cantidad rechazada > 0, debe seleccionar depósito scrap
        if (cantidadRechazada > 0 && depositoScrapSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Validación", "Debe seleccionar un depósito scrap cuando hay cantidad rechazada.", SweetAlertIcon.Warning);
            return false;
        }

        return true;
    }

    // ===================================================================
    // FUNCIONALIDAD DE IMPRESIÓN
    // ===================================================================

    private bool mostrarModalImpresion = false;
    private bool isPrinting = false;
    private string TituloReporte => $"Listado de Órdenes de Fabricación - {DateTime.Now:dd/MM/yyyy}";

    /// <summary>
    /// Diccionario de encabezados para el reporte de impresión
    /// Mapea las propiedades de OrdefabrIndexDTO a nombres legibles
    /// </summary>
    private Dictionary<string, string> encabezadosOrdenes = new Dictionary<string, string>
    {
        { "FechGen", "Fecha" },
        { "IdSubOr", "Ord.Fab" },
        { "Cod_Exte", "Código" },
        { "Descrip", "Descripción" },
        { "CanProy", "Cant.Proy." },
        { "CantidadCerrada", "Cant.Cerrada" },
        { "CantidadAprobadaOrfapen", "Cant.Aprobada" },
        { "PendienteAprobacion", "Pendiente Aprob." },
        { "Id_Orfa", "ID" },
        { "StatuOrf", "Estado" }
    };

    /// <summary>
    /// Obtiene TODAS las órdenes de fabricación que coincidan con los filtros actuales, sin paginación
    /// Utiliza los mismos filtros que LoadAsync pero sin límite de página
    /// </summary>
    private async Task<List<OrdefabrIndexDTO>?> ObtenerTodasLasOrdenesFiltradas()
    {
        try
        {
            // Construir URL con los mismos filtros que LoadAsync
            var parametros = new List<string>();
            
            parametros.Add($"statuOrf={estadoSeleccionado}");
            
            if (fechaDesde.HasValue)
            {
                parametros.Add($"fechaDesde={fechaDesde.Value:yyyy-MM-dd}");
            }
            
            if (fechaHasta.HasValue)
            {
                parametros.Add($"fechaHasta={fechaHasta.Value:yyyy-MM-dd}");
            }
            
            if (!string.IsNullOrWhiteSpace(filter))
            {
                parametros.Add($"filter={filter}");
            }

            // Agregar parámetros para obtener todos los registros (sin paginación)
            parametros.Add("page=1");
            parametros.Add("recordsNumber=999999"); // Número muy alto para obtener todos los registros

            string queryParams = parametros.Count > 0 ? "?" + string.Join("&", parametros) : "";
            string url = $"api/ordefabr{queryParams}";

            var responseHttp = await repository.Get<List<OrdefabrIndexDTO>>(url);
            
            if (!responseHttp.Error)
            {
                return responseHttp.Response;
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron obtener las órdenes para impresión", SweetAlertIcon.Error);
                return new List<OrdefabrIndexDTO>();
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al obtener órdenes: {ex.Message}", SweetAlertIcon.Error);
            return new List<OrdefabrIndexDTO>();
        }
    }

    /// <summary>
    /// Confirma la impresión del listado de órdenes respetando filtros activos
    /// Obtiene TODOS los registros que coincidan con los filtros, no solo la página actual
    /// </summary>
    private async Task MostrarImpresion()
    {
        isPrinting = true;
        StateHasChanged();

        try
        {
            // Obtener TODAS las órdenes que coincidan con los filtros actuales (sin paginación)
            var ordenesCompletas = await ObtenerTodasLasOrdenesFiltradas();
            int cantidadTotal = ordenesCompletas?.Count ?? 0;

            // Mensaje de confirmación
            string mensaje = $"Se van a imprimir {cantidadTotal} registros que coinciden con los filtros aplicados (todas las páginas). ¿Desea continuar?";

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmar impresión",
                Text = mensaje,
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, imprimir",
                CancelButtonText = "Cancelar"
            });

            if (result.IsConfirmed)
            {
                // Actualizar la lista de órdenes para impresión con todos los registros
                ordenesFabricacion = ordenesCompletas;
                mostrarModalImpresion = true;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Resetea el estado de impresión y cierra el modal
    /// Restaura la lista de órdenes original (paginada) después de la impresión
    /// </summary>
    private async void ResetearImpresion()
    {
        mostrarModalImpresion = false;

        // Restaurar la vista paginada original después de cerrar el modal de impresión
        await LoadAsync(currentPage);

        StateHasChanged();
    }
}

@* Modal de anulación de cierre
     Este modal se muestra cuando el usuario hace clic en el botón "Anulación x Cierre" (botón amarillo)
     en la tabla de órdenes de fabricación.
     
     Estructura del modal:
     - Header: título con icono de deshacer y botón X para cerrar
     - Body: muestra una grilla con los cierres reversibles o un mensaje si no hay cierres
     - Footer: botones de Cancelar y Anular Cierre (solo se muestra si hay un cierre seleccionado)
     
     Estados del modal:
     1. Cargando: muestra un spinner mientras se obtienen los cierres del backend
     2. Con datos: muestra la grilla de cierres para que el usuario seleccione uno
     3. Sin datos: muestra mensaje informativo indicando que no hay cierres reversibles
*@ 
@if (mostrarModalAnulacionCierre)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                @* Header del modal con color de advertencia (amarillo) *@
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        <i class="fas fa-undo me-2"></i>Anulación x Cierre - @idSubOrParaAnulacion
                    </h5>
                    @* Botón X para cerrar el modal *@
                    <button type="button" class="btn-close" @onclick="CerrarModalAnulacionCierre"></button>
                </div>
                <div class="modal-body">
                    @* Estado 1: Cargando - muestra spinner mientras se obtienen los cierres *@
                    @if (cargandoCierres)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando cierres...</span>
                            </div>
                        </div>
                    }
                    @* Estado 2: Con datos - muestra la grilla de cierres reversibles *@
                    else if (cierresReversibles != null && cierresReversibles.Any())
                    {
                        @* Mensaje informativo para el usuario *@
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Seleccione un cierre para anular. Los movimientos CF asociados también se anularán.
                        </div>

                        @* Grilla de cierres reversibles *@
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Orden Fab</th>
                                    <th>Fecha</th>
                                    <th>Cantidad</th>
                                    <th>Lote</th>
                                    <th>Fecha/Hora</th>
                                    <th>Seleccionar</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cierre in cierresReversibles)
                                {
                                    @* Fila del cierre: se resalta en amarillo si está seleccionado *@
                                    <tr class="@(cierreSeleccionado?.Id == cierre.Id ? "table-warning" : "")"
                                        style="cursor: pointer;"
                                        @onclick="() => cierreSeleccionado = cierre">
                                        <td>@cierre.DoPriCor</td>
                                        <td>@(cierre.FechMov?.ToString("dd/MM/yyyy") ?? "")</td>
                                        <td class="text-end">@cierre.CantIngre:F1</td>
                                        <td>@cierre.IdenLote</td>
                                        <td>@(cierre.FeReMovi?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                        <td>
                                            @* Botón de selección: se muestra en azul si está seleccionado, en borde azul si no *@
                                            <button class="btn btn-sm @(cierreSeleccionado?.Id == cierre.Id ? "btn-primary" : "btn-outline-primary")"
                                                    @onclick="() => cierreSeleccionado = cierre">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    @* Estado 3: Sin datos - muestra mensaje de que no hay cierres reversibles *@
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No hay cierres reversibles para esta orden de fabricación.
                        </div>
                    }
                </div>
                @* Footer del modal: solo se muestra si hay un cierre seleccionado *@
                @if (cierreSeleccionado != null)
                {
                    <div class="modal-footer">
                        @* Botón Cancelar: cierra el modal sin hacer cambios *@
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalAnulacionCierre">
                            Cancelar
                        </button>
                        @* Botón Anular Cierre: ejecuta la anulación del cierre seleccionado *@
                        <button type="button" class="btn btn-danger" @onclick="AnularCierreSeleccionado">
                            <i class="fas fa-undo me-2"></i>Anular Cierre
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    @* Fondo oscuro del modal: permite cerrar el modal haciendo clic fuera del contenido *@
    <div class="modal-backdrop show" @onclick="CerrarModalAnulacionCierre"></div>
}

@* Modal de confirmación de regeneración de reservas *@
@if (mostrarModalConfirmacionReservas)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                @* Header del modal con color de información *@
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-question-circle me-2"></i>
                        Actualización de Reservas
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarAnulacionCierre"></button>
                </div>
                @* Body del modal con mensaje explicativo *@
                <div class="modal-body">
                    <p class="mb-3">
                        <strong>Al anular este cierre, las reservas de componentes se actualizarán considerando la cantidad pendiente a fabricar sobre la base de los componentes originales.</strong>
                    </p>
                    <p class="text-muted mb-4">
                        ¿Desea actualizar las reservas automáticamente o mantener las reservas actuales?
                    </p>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Si elige mantener las reservas, podrá editarlas manualmente desde la edición de la orden de fabricación.
                    </div>
                </div>
                @* Footer del modal con 3 botones *@
                <div class="modal-footer">
                    @* Botón 1: Cancelar anulación - salir sin hacer nada *@
                    <button type="button" class="btn btn-secondary" @onclick="CancelarAnulacionCierre">
                        <i class="fas fa-times me-2"></i>Cancelar Anulación
                    </button>
                    @* Botón 2: Mantener reservas - no regenerar *@
                    <button type="button" class="btn btn-warning" @onclick="AnularCierreManteniendoReservas">
                        <i class="fas fa-keep me-2"></i>Mantener Reservas
                    </button>
                    @* Botón 3: Actualizar reservas - regenerar *@
                    <button type="button" class="btn btn-success" @onclick="AnularCierreConRegeneracionReservas">
                        <i class="fas fa-sync-alt me-2"></i>Actualizar Reservas
                    </button>
                </div>
            </div>
        </div>
    </div>
    @* Fondo oscuro del modal *@
    <div class="modal-backdrop show" @onclick="CancelarAnulacionCierre"></div>
}
