@code {

    [Parameter]
    public string? Page { get; set; }

    private int currentPage = 1;
    private int totalPages;
    private int recordsNumber = 10;
    private List<OrdefabrIndexDTO>? ordenesFabricacion;
    private string filter = string.Empty;
    private int estadoSeleccionado = 1; // Por defecto muestra abiertas (StatuOrf < 3)
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private bool isLoading = true;
    private bool mostrarInstructivoUsuario = false;
    private bool validando = true;

    // Variables de control de permisos para ANULAROF (anulación completa de orden de fabricación)
    // Estas variables controlan si el usuario puede ver y usar el botón de anulación completa
    private bool tieneAccesoEscritura = false;
    
    // Variables de control de permisos para ANUCIEOF (anulación de cierres parciales)
    // Estas variables indican si el usuario tiene el derecho configurado en DER_ACCE
    // El código de aplicación ANUCIEOF debe estar configurado en la tabla DER_ACCE
    // 
    // NOTA: El nuevo patrón de permisos es:
    // - Los botones siempre están habilitados
    // - Al hacer clic, se verifica si el usuario tiene el derecho
    // - Si no tiene derecho, se muestra un SweetAlert con COD_APLI y DES_APLI
    // - Si tiene derecho, se ejecuta la acción normalmente
    private bool tieneAccesoAnulacionCierre = false;
    private bool verificandoPermisos = true;
    
    // Códigos de aplicación para validación de derechos en DER_ACCE
    // COD_APLI: Código para anulación completa de orden de fabricación
    // COD_APLI_ANUCIEOF: Código para anulación de cierres parciales (nueva funcionalidad)
    private const string COD_APLI = "ANULAROF";
    private const string DES_APLI = "Anulación de Orden de Fabricación";
    private const string COD_APLI_ANUCIEOF = "ANUCIEOF";
    private const string DES_APLI_ANUCIEOF = "Anulación Cierre Parcial de O/F";

    private const string FiltrosStorageKey = "ordenfabricacion_filtros";

    // -------------------------------------------------------------------------
    // ESTADO DEL MODAL DE IMPRESIÓN DE UNA ORDEN DESDE EL LISTADO
    // -------------------------------------------------------------------------
    private bool mostrarModalImprimirOrden = false;
    private string? IdOrdenSeleccionada;
    private int idOrdenSeleccionada;
    private int? codInteOrdenSeleccionada;                // Cod_Inte del producto (para imprimir el Plan de Inspección)
    private bool imprimirOrdenSeleccionada = true;       // Opción 1: Orden de Fabricación (implementada)
    private bool imprimirConsumoSeleccionada = true;     // Opción 2: Consumo de materiales (implementada)
    private bool imprimirPlanSeleccionada = true;        // Opción 3: Plan de Inspección (implementada)
    private bool imprimiendoOrden = false;

    protected override async Task OnInitializedAsync()
    {
        // Paso 1: Validar que el usuario tenga permiso para acceder a esta página
        // Si no tiene permiso, el servicio PageAccess redirigirá a la página de acceso denegado
        await PageAccess.RequiereAccesoAsync("/ordenfabricacion");
        validando = false;

        // Paso 2: Verificar derechos de acceso para ANULAROF (anulación completa de orden)
        // Esto controla si el usuario puede ver y usar el botón de anulación completa (botón rojo)
        verificandoPermisos = true;

        var nivelAcceso = await derechosService.VerificarDerechoAsync(
            COD_APLI,
            DES_APLI,
            mostrarMensaje: false // No mostrar mensaje si no tiene acceso, solo deshabilitar botón
        );

        // Nivel de acceso: 0 = sin acceso, 1 = solo lectura, 2 = escritura
        // Solo permitimos anulación si el usuario tiene nivel 2 (escritura)
        tieneAccesoEscritura = nivelAcceso >= 2;

        Console.WriteLine($"Acceso a {COD_APLI}: Nivel {nivelAcceso} - Escritura: {tieneAccesoEscritura}");

        // Paso 3: Verificar derechos de acceso para ANUCIEOF (anulación de cierres parciales)
        // Esto controla si el usuario puede ver y usar el botón de anulación x cierre (botón amarillo)
        // El código ANUCIEOF debe estar configurado en la tabla DER_ACCE con los usuarios que tienen permiso
        var nivelAccesoAnulacionCierre = await derechosService.VerificarDerechoAsync(
            COD_APLI_ANUCIEOF,
            DES_APLI_ANUCIEOF,
            mostrarMensaje: false
        );

        // Solo permitimos anulación de cierre si el usuario tiene nivel 2 (escritura)
        tieneAccesoAnulacionCierre = nivelAccesoAnulacionCierre >= 2;

        Console.WriteLine($"Acceso a {COD_APLI_ANUCIEOF}: Nivel {nivelAccesoAnulacionCierre} - Escritura: {tieneAccesoAnulacionCierre}");

        verificandoPermisos = false;

        // Restaurar filtros y página guardados al volver desde otra pantalla
        await RestaurarFiltrosAsync();

        // Leer parámetros de la URL
        var uri = new Uri(navigationManager.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);
        
        // Aplicar filtros desde parámetros de URL si existen
        var estadoParam = queryParams["estado"];
        var fechaDesdeParam = queryParams["fechaDesde"];
        var fechaHastaParam = queryParams["fechaHasta"];
        var filtroParam = queryParams["filtro"];
        
        if (!string.IsNullOrEmpty(estadoParam) && int.TryParse(estadoParam, out var estado))
        {
            estadoSeleccionado = estado;
        }
        
        if (!string.IsNullOrEmpty(fechaDesdeParam) && DateTime.TryParse(fechaDesdeParam, out var fDesde))
        {
            fechaDesde = fDesde;
        }
        else if (!fechaDesde.HasValue)
        {
            ConfigurarFechasIniciales();
        }
        
        if (!string.IsNullOrEmpty(fechaHastaParam) && DateTime.TryParse(fechaHastaParam, out var fHasta))
        {
            fechaHasta = fHasta;
        }
        else if (!fechaHasta.HasValue)
        {
            fechaHasta = DateTime.Today;
        }
        
        if (!string.IsNullOrEmpty(filtroParam))
        {
            filter = filtroParam;
        }
        
        await LoadAsync(currentPage);
    }

    /// <summary>
    /// Guarda los filtros y la página actual en sessionStorage para mantenerlos al volver de otra pantalla
    /// </summary>
    private async Task GuardarFiltrosAsync()
    {
        try
        {
            var filtros = new
            {
                filter,
                estadoSeleccionado,
                fechaDesde,
                fechaHasta,
                currentPage
            };

            var filtrosJson = JsonSerializer.Serialize(filtros);
            await JS.InvokeVoidAsync("sessionStorage.setItem", FiltrosStorageKey, filtrosJson);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar filtros: {ex.Message}");
        }
    }

    /// <summary>
    /// Restaura los filtros y la página guardados en sessionStorage
    /// </summary>
    private async Task RestaurarFiltrosAsync()
    {
        try
        {
            var filtrosJson = await JS.InvokeAsync<string>("sessionStorage.getItem", FiltrosStorageKey);

            if (!string.IsNullOrEmpty(filtrosJson))
            {
                var filtrosGuardados = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(filtrosJson);

                if (filtrosGuardados != null)
                {
                    if (filtrosGuardados.TryGetValue("filter", out var filtroGuardado)
                        && filtroGuardado.ValueKind == JsonValueKind.String)
                    {
                        filter = filtroGuardado.GetString() ?? string.Empty;
                    }

                    if (filtrosGuardados.TryGetValue("estadoSeleccionado", out var estadoGuardado)
                        && estadoGuardado.ValueKind == JsonValueKind.Number)
                    {
                        estadoSeleccionado = estadoGuardado.GetInt32();
                    }

                    if (filtrosGuardados.TryGetValue("fechaDesde", out var desdeGuardada)
                        && desdeGuardada.ValueKind == JsonValueKind.String
                        && DateTime.TryParse(desdeGuardada.GetString(), out var desde))
                    {
                        fechaDesde = desde;
                    }

                    if (filtrosGuardados.TryGetValue("fechaHasta", out var hastaGuardada)
                        && hastaGuardada.ValueKind == JsonValueKind.String
                        && DateTime.TryParse(hastaGuardada.GetString(), out var hasta))
                    {
                        fechaHasta = hasta;
                    }

                    if (string.IsNullOrEmpty(Page)
                        && filtrosGuardados.TryGetValue("currentPage", out var paginaGuardada)
                        && paginaGuardada.ValueKind == JsonValueKind.Number)
                    {
                        currentPage = paginaGuardada.GetInt32();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al restaurar filtros: {ex.Message}");
        }

        if (currentPage <= 0)
        {
            currentPage = 1;
        }
    }

    /// <summary>
    /// Configura las fechas iniciales según la lógica requerida:
    /// - Si el día actual es menor a 15, muestra desde el mes anterior
    /// - Si no, muestra desde el inicio del mes actual
    /// </summary>
    private void ConfigurarFechasIniciales()
    {
        var hoy = DateTime.Today;

        // Si estamos en los primeros 15 días del mes, mostrar desde el mes anterior
        if (hoy.Day < 15)
        {
            fechaDesde = new DateTime(hoy.Year, hoy.Month, 1).AddMonths(-1);
        }
        else
        {
            fechaDesde = new DateTime(hoy.Year, hoy.Month, 1);
        }

        fechaHasta = hoy;
    }

    /// <summary>
    /// Formatea un valor decimal para mostrarlo con 2 decimales
    /// </summary>
    private string FormatDecimal(decimal? value)
    {
        if (!value.HasValue)
            return "";

        return value.Value.ToString("N2", CultureInfo.CurrentCulture);
    }

    /// <summary>
    /// Obtiene la descripción del estado de la orden de fabricación
    /// </summary>
    private string GetEstadoDescripcion(short? statuOrf)
    {
        if (!statuOrf.HasValue)
            return "Desconocido";

        return statuOrf.Value switch
        {
            0 => "Abierta",
            1 => "En Proceso",
            3 => "Cerrada",
            9 => "Anulada",
            _ => $"Estado {statuOrf.Value}"
        };
    }

    /// <summary>
    /// Carga los datos según los filtros aplicados
    /// </summary>
    private async Task LoadAsync(int page = 1)
    {
        try
        {
            isLoading = true;

            // Verificar si hay un parámetro de página en la URL
            if (!string.IsNullOrWhiteSpace(Page))
            {
                page = Convert.ToInt32(Page);
            }

            currentPage = page;

            // Construir URLs para datos y total de páginas
            string url1 = $"api/ordefabr?page={page}&statuOrf={estadoSeleccionado}";
            string url2 = $"api/ordefabr/totalPages?statuOrf={estadoSeleccionado}";

            // Agregar filtros de fecha si están presentes
            if (fechaDesde.HasValue)
            {
                string fechaDesdeStr = fechaDesde.Value.ToString("yyyy-MM-dd");
                url1 += $"&fechaDesde={fechaDesdeStr}";
                url2 += $"&fechaDesde={fechaDesdeStr}";
            }

            if (fechaHasta.HasValue)
            {
                string fechaHastaStr = fechaHasta.Value.ToString("yyyy-MM-dd");
                url1 += $"&fechaHasta={fechaHastaStr}";
                url2 += $"&fechaHasta={fechaHastaStr}";
            }

            // Agregar filtro de texto si existe
            if (!string.IsNullOrWhiteSpace(filter))
            {
                url1 += $"&filter={filter}";
                url2 += $"&filter={filter}";
            }

            // Realizar las peticiones en paralelo
            var responseHttp = await repository.Get<List<OrdefabrIndexDTO>>(url1);
            var responseHttp2 = await repository.Get<int>(url2);

            if (responseHttp.Error)
            {
                await sweetAlertService.FireAsync("Error", await responseHttp.GetErrorMessageAsync(), SweetAlertIcon.Error);
            }
            else
            {
                ordenesFabricacion = responseHttp.Response!;
                totalPages = responseHttp2.Response!;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
            await GuardarFiltrosAsync();
        }
    }
