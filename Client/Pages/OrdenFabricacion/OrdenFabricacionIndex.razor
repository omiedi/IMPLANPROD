    private void ActualizarModeloOrdenParaCierre()
    {
        if (ordenParaCierre == null) return;

        // Actualizar las cantidades modificadas por el usuario
        // La cantidad aprobada total será la suma de la cantidad ya aprobada más la nueva cantidad aprobada
        //ordenParaCierre.CanApro = (ordenParaCierre.CanApro ?? 0) + cantidadAprobada;

        // Actualizar las nuevas propiedades agregadas al DTO con los valores del modal

        // Depósitos seleccionados por el usuario en los InputSelect
        ordenParaCierre.DepoEntrada = depositoEntradaSeleccionado > 0 ? depositoEntradaSeleccionado : null;
        ordenParaCierre.DepoSalida = depositoConsumoSeleccionado > 0 ? depositoConsumoSeleccionado : null;
        ordenParaCierre.DepoScrap = depositoScrapSeleccionado > 0 ? depositoScrapSeleccionado : null;

        // Cantidades ingresadas por el usuario en este cierre específico
        ordenParaCierre.CantAprobada = cantidadAprobada > 0 ? cantidadAprobada : null;
        ordenParaCierre.CantRechazada = cantidadRechazada > 0 ? cantidadRechazada : null;

        // Log para verificar que los valores se están actualizando correctamente 
        Console.WriteLine($"Modelo actualizado - " +
