    /// <summary>
    /// Anula el cierre seleccionado por el usuario
    /// 
    /// Este método se ejecuta cuando el usuario hace clic en el botón "Anular Cierre"
    /// del modal después de seleccionar un cierre de la grilla.
    /// 
    /// Flujo:
    /// 1. Valida que haya un cierre seleccionado
    /// 2. Muestra confirmación al usuario (SweetAlert)
    /// 3. Si el usuario confirma, llama al endpoint PUT api/ordefabr/anular-cierre/{id}
    /// 4. Si hay error, muestra mensaje de error
    /// 5. Si tiene éxito, muestra mensaje de éxito, cierra el modal y recarga la tabla
    /// 
    /// El endpoint del backend realiza:
    /// - Anulación del movimiento OF (cantidades a 0, referencia "Anul.")
    /// - Anulación de movimientos CF/SC asociados por IdenMovi
    /// - Actualización de OrdeFabr (resta cantidad, cambia estado a 1)
    /// - Generación de anotación en OrdeFabr.AnotaOrf
    /// - Opcional: Regeneración de reservas según elección del usuario
    /// </summary>
    private async Task AnularCierreSeleccionado()
    {
        // Paso 1: Validar que el usuario haya seleccionado un cierre
        if (cierreSeleccionado == null)
        {
            await sweetAlertService.FireAsync("Advertencia", "Debe seleccionar un cierre para anular", SweetAlertIcon.Warning);
            return;
        }

        // Paso 2: Mostrar modal de confirmación con 3 opciones
        // El modal permite al usuario elegir:
        // - Cancelar anulación: salir sin hacer nada
        // - Actualizar reservas: regenerar reservas según cantidad pendiente
        // - Mantener reservas: mantener reservas actuales (podrá editarlas manualmente)
        mostrarModalConfirmacionReservas = true;
    }

    /// <summary>
    /// Cancela la anulación de cierre y cierra el modal de confirmación
    /// No se realiza ninguna transacción
