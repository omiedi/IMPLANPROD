    /// <summary>
    /// Anula una orden de fabricación
    /// Valida primero si existe nota de pedido de materiales asociada (OCOMENCA)
    /// Valida si hay materiales transferidos (MOVISTO)
    /// Replica las validaciones VB6:
    /// - CONDI$ = "ANEX_OCOM='" & NORFA$ & "' AND STAT_OCOM < 9"
    /// - WHERE DOSECCOR = NORFA$ AND CODIMOVI = 'TR' AND (CANTINGRE - CANTSALID) > 0.5
    /// 
    /// Flujo:
    /// 1. Verifica si el usuario tiene el derecho ANULAROF configurado en DER_ACCE
    /// 2. Si no tiene derecho, muestra SweetAlert con COD_APLI y DES_APLI y retorna
    /// 3. Si tiene derecho, verifica el estado de la orden
    /// 4. Si ya está anulada, muestra mensaje informativo y retorna
    /// 5. Verifica si hay orden de compra asociada
    /// 6. Si hay orden de compra, muestra advertencia y solicita confirmación
    /// 7. Si confirma, llama al endpoint de anulación
    /// </summary>
    /// <param name="id">ID de la orden de fabricación</param>
    /// <param name="idSubOr">ID de la suborden para mostrar en la confirmación</param>
    private async Task AnularOrdenFabricacion(int id, string? idSubOr)
    {
        // Paso 1: Verificar si el usuario tiene el derecho ANULAROF
        // Según el nuevo patrón de permisos, los botones siempre están habilitados
        // y la verificación de permisos se hace al hacer clic
        if (!tieneAccesoEscritura)
        {
            // Mostrar SweetAlert informativo con COD_APLI y DES_APLI
            // Usamos HTML con <br> para respetar los saltos de línea
            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Acceso Denegado",
                Html = $"No tiene el derecho configurado para esta acción.<br><br>Código: {COD_APLI}<br>Descripción: {DES_APLI}<br><br>Contacte al administrador del sistema.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "Entendido"
            });
            return;
        }

        try
        {
            // Paso 2: Buscar la orden para verificar su estado actual
            var orden = ordenesFabricacion.FirstOrDefault(o => o.Id == id);
            
            if (orden?.StatuOrf == 9)
            {
                await sweetAlertService.FireAsync(
                    "Orden Ya Anulada",
                    "La orden de fabricación ya se encuentra anulada",
                    SweetAlertIcon.Warning
                );
                return;
            }

            // Validar primero si existe orden de compra de materiales asociada
            var responseOrdenCompra = await repository.Get<bool>($"api/ocomenca/verificar-orden-compra-asociada/{idSubOr}");

            if (responseOrdenCompra.Error)
            {
                await sweetAlertService.FireAsync("Error", "Error al verificar orden de compra asociada", SweetAlertIcon.Error);
                return;
            }

            var existeOrdenCompra = responseOrdenCompra.Response;

            if (existeOrdenCompra)
            {
                // Si existe orden de compra en curso, impedir la anulación
                await sweetAlertService.FireAsync(
                    "Imposible Anular O.F.",
                    "Imposible Anular S/F, Posee Nota de Pedido de Materiales En Curso\n\nAnule la Nota de Pedido y Vuelva a Intentarlo",
                    SweetAlertIcon.Error
                );
                return;
            }

            // Validar si hay materiales transferidos pendientes
            var responseMateriales = await repository.Get<bool>($"api/movisto/verificar-materiales-transferidos/{idSubOr}");

            if (responseMateriales.Error)
            {
                await sweetAlertService.FireAsync("Error", "Error al verificar materiales transferidos", SweetAlertIcon.Error);
                return;
            }

            var tieneMaterialesTransferidos = responseMateriales.Response;

            if (tieneMaterialesTransferidos)
            {
                // Si hay materiales transferidos pendientes, impedir la anulación
                await sweetAlertService.FireAsync(
                    "Imposible Anular O.F.",
                    "La O/F No puede ser Anulada porque tiene Materiales Transferidos",
                    SweetAlertIcon.Error
                );
                return;
            }

            // Si no hay impedimentos, confirmar anulación
            var resultado = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "¿Anular Orden de Fabricación?",
                Text = $"¿Está seguro que desea anular la orden de fabricación {idSubOr}?",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, Anular",
                CancelButtonText = "Cancelar",
                ConfirmButtonColor = "#d33",
                CancelButtonColor = "#3085d6"
            });

            if (resultado.IsConfirmed)
            {
                // Ejecutar anulación en el servidor
                var responseAnulacion = await repository.Put<object>($"api/ordefabr/anular/{idSubOr}", null);

                if (responseAnulacion.Error)
                {
                    await sweetAlertService.FireAsync("Error", "Error al anular la orden de fabricación", SweetAlertIcon.Error);
                    return;
                }

                await sweetAlertService.FireAsync("Éxito", "Orden de fabricación anulada exitosamente", SweetAlertIcon.Success);
                
                // Recargar la tabla para mostrar el estado actualizado
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al intentar anular la orden: {ex.Message}", SweetAlertIcon.Error);
        }
    }
