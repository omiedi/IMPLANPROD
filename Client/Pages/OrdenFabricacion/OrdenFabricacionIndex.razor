    /// <summary>
    /// Abre el modal de anulación de cierre
    /// 
    /// Este método se ejecuta cuando el usuario hace clic en el botón "Anulación x Cierre" (botón amarillo)
    /// en la tabla de órdenes de fabricación.
    /// 
    /// Flujo:
    /// 1. Verifica si el usuario tiene el derecho ANUCIEOF configurado en DER_ACCE
    /// 2. Si no tiene derecho, muestra SweetAlert con COD_APLI y DES_APLI y retorna
    /// 3. Si tiene derecho, guarda el código interno y el ID de la suborden
    /// 4. Muestra el modal y activa el indicador de carga
    /// 5. Llama al endpoint GET api/ordefabr/cierres-reversibles/{codInte} para obtener los cierres
    /// 6. Si hay error, muestra mensaje de error y cierra el modal
    /// 7. Si no hay cierres reversibles, muestra mensaje informativo y cierra el modal
    /// 8. Si hay cierres, los muestra en la grilla del modal para que el usuario seleccione uno
    /// </summary>
    /// <param name="codInte">Código interno del producto (OrdeFabr.Cod_Inte)</param>
    /// <param name="idSubOr">ID de la suborden de fabricación (OrdeFabr.IdSubOr)</param>
    private async Task AbrirModalAnulacionCierre(int codInte, string idSubOr)
    {
        // Paso 1: Verificar si el usuario tiene el derecho ANUCIEOF
        // Según el nuevo patrón de permisos, los botones siempre están habilitados
        // y la verificación de permisos se hace al hacer clic
        if (!tieneAccesoAnulacionCierre)
        {
            // Mostrar SweetAlert informativo con COD_APLI y DES_APLI
            // Usamos HTML con <br> para respetar los saltos de línea
            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Acceso Denegado",
                Html = $"No tiene el derecho configurado para esta acción.<br><br>Código: {COD_APLI_ANUCIEOF}<br>Descripción: {DES_APLI_ANUCIEOF}<br><br>Contacte al administrador del sistema.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "Entendido"
            });
            return;
        }

        try
        {
            // Paso 2: Guardar los parámetros para usarlos en las consultas al backend
            codInteParaAnulacion = codInte;
            idSubOrParaAnulacion = idSubOr;
            
            // Paso 3: Mostrar el modal y activar el indicador de carga
            // StateHasChanged() fuerza a Blazor a repintar la UI para mostrar el modal y el spinner
            mostrarModalAnulacionCierre = true;
            cargandoCierres = true;
            cierreSeleccionado = null; // Limpiar selección anterior
            StateHasChanged();

            // Paso 4: Obtener los cierres reversibles del backend
            // El endpoint retorna los movimientos OF con CantIngre > 0 para este producto Y esta orden específica
            // Consulta equivalente: SELECT * FROM MOVISTO WHERE CODIMOVI = 'OF' AND COD_INTE = ORDEFABR.COD_INTE AND CANTINGRE > 0 AND DOPRICOR = IdSubOr
            var response = await repository.Get<List<CierreReversibleDTO>>($"api/ordefabr/cierres-reversibles/{codInte}/{idSubOr}");

            // Paso 5: Manejar errores de la llamada al backend
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", "Error al obtener cierres reversibles", SweetAlertIcon.Error);
                mostrarModalAnulacionCierre = false; // Cerrar el modal si hubo error
                return;
            }

            // Paso 6: Guardar la lista de cierres retornada por el backend
            cierresReversibles = response.Response;

            // Paso 7: Validar si hay cierres reversibles
            // Si no hay cierres, informar al usuario y cerrar el modal
            if (cierresReversibles == null || !cierresReversibles.Any())
            {
                await sweetAlertService.FireAsync("Información", "No hay cierres reversibles para esta orden de fabricación", SweetAlertIcon.Info);
                mostrarModalAnulacionCierre = false;
            }
            // Si hay cierres, el modal se queda abierto mostrando la grilla con los cierres
        }
        catch (Exception ex)
        {
            // Manejar cualquier excepción no controlada
            await sweetAlertService.FireAsync("Error", $"Error al abrir modal de anulación: {ex.Message}", SweetAlertIcon.Error);
            mostrarModalAnulacionCierre = false;
        }
        finally
        {
            // Paso 8: Siempre desactivar el indicador de carga, haya éxito o error
            cargandoCierres = false;
            StateHasChanged();
        }
    }

