    /// <summary>
    /// Configura los depósitos por defecto para entrada (DEPOCIE) y salida (DEPODEST)
    /// </summary>
    private async Task ConfigurarDepositosPorDefecto()
    {
        try
        {
            // Cargar configuración del depósito de entrada (DEPOCIE)
            var responseEntrada = await repository.Get<FLEXCRL>($"api/flexcrl/empty/DEPOCIE");
            if (!responseEntrada.Error && responseEntrada.Response != null)
            {
                if (int.TryParse(responseEntrada.Response.VALCONTROL, out int valorEntrada))
                {
                    depositoEntradaSeleccionado = valorEntrada;
                }
            }

            // Cargar configuración del depósito de salida (DEPODEST)
            var responseSalida = await repository.Get<FLEXCRL>($"api/flexcrl/empty/DEPODEST");
            if (!responseSalida.Error && responseSalida.Response != null)
            {
                if (int.TryParse(responseSalida.Response.VALCONTROL, out int valorSalida))
                {
                    depositoConsumoSeleccionado = valorSalida;
                }
            }
        }
        catch (Exception)
        {
            // En caso de error, mantener valores por defecto (0)
            // Los usuarios deberán seleccionar manualmente
        }
    }
