@page "/ordenfabricacion"
@page "/ordenfabricacion/{Page:int?}"
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.Entities
@using System.Globalization
@using System.Web
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager

<PageTitle>Órdenes de Fabricación</PageTitle>

<div class="container-fluid">
    <!-- Título de la página -->
    <div class="mb-4">
        <h2 class="text-center fw-bold text-primary">
            <i class="fas fa-industry me-2"></i>
            ÓRDENES DE FABRICACIÓN
        </h2>
        <hr class="border-primary border-2 opacity-50" />
    </div>

<div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-3 d-flex justify-content-end align-items-center">
    <div class="dropdown">
        <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
            Informes
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <NavLink class="dropdown-item" href="/AprobarOrdenfabricacion">
                    Aprobar Ordenes de Fabricación
                </NavLink>
            </li>
            <li>
                <button class="dropdown-item" type="button" @onclick="AbrirModalConfiguracion">
                    <i class="oi oi-cog me-2"></i>Configuración
                </button>
            </li>
            @* <li>
                <NavLink class="dropdown-item" href="/movimientos-stock">
                    Movimientos Históricos
                </NavLink>
            </li> *@
        </ul>
    </div>
</div>
<div class="row mb-3">
    <div class="col">
        <button class="btn btn-primary" @onclick="NuevoOrdenFabricacion">
            <i class="oi oi-plus"></i> Nueva Orden
        </button>
        <button class="btn btn-secondary" @onclick="NuevoOrdenFabricacion">
            <i class="oi oi-trash"></i> Productos dados de baja
        </button>
    </div>
</div>
<div style="height: 100px;" class="d-flex justify-content-center align-items-center">
    @if (isLoading)
    {
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    }
    else
    {
        <!-- Espacio reservado vacío para mantener altura -->
        <div style="height: 100%;"></div>
    }
</div>


<div class="mb-3">
    <div class="row">
        <div class="col-md-3">
            <div class="mb-3">
                <label>Estado:</label>
                <select class="form-select" @bind="estadoSeleccionado">
                    <option value="0">Todas</option>
                    <option value="1">Abiertas</option>
                    <option value="3">Cerradas</option>
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label>Fecha desde:</label>
                <input type="date" class="form-control" @bind="fechaDesde" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label>Fecha hasta:</label>
                <input type="date" class="form-control" @bind="fechaHasta" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label>Filtro:</label>
                <div class="input-group">
                    <input type="text" class="form-control" @bind-value="filter" @bind-value:event="oninput" placeholder="Buscar..." />
                    <button class="btn btn-outline-primary" type="button" @onclick="ApplyFilterAsync">
                        <i class="oi oi-magnifying-glass"></i>
                    </button>
                    <button class="btn btn-outline-danger" type="button" @onclick="CleanFilterAsync">
                        <i class="oi oi-ban"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 text-end">
            <button class="btn btn-primary" @onclick="ConsultarAsync">
                <i class="oi oi-magnifying-glass"></i> Consultar
            </button>
        </div>
    </div>
</div>

<Pagination CurrentPage="currentPage"
            TotalPages="totalPages"
            SelectedPage="SelectedPageAsync" />

@if (ordenesFabricacion == null || !ordenesFabricacion.Any())
{
    @if (!isLoading)
    {
        <div class="alert alert-info mt-3">
            <i class="oi oi-info me-2"></i> No se encontraron registros que coincidan con la búsqueda.
        </div>
    }
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Ord.Fab</th>
                <!-- Nuevas columnas para mostrar datos del producto -->
                <th>Código</th>
                <th>Descripción</th>
                <th>Cant.Proy.</th>
                <th>ID</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var orden in ordenesFabricacion)
            {
                <tr>
                    <td>@(orden.FechGen.HasValue ? orden.FechGen.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td>@orden.IdSubOr</td>
                    <!-- Nuevas columnas con datos del producto -->
                    <td>@orden.Cod_Exte</td>
                    <td>@orden.Descrip</td>
                    <td>@FormatDecimal(orden.CanProy)</td>
                    <td>@orden.Id_Orfa</td>
                    <td>
                        <a class="btn btn-warning btn-sm" href="/orden-fabricacion-edit/@orden.Id">
                            <i class="oi oi-pencil"></i>
                        </a>
                        <button class="btn btn-info btn-sm" @onclick="() => VerAnotaciones(orden.Id)">
                            <i class="oi oi-eye"></i>
                        </button>
                        @* Botón de cierre solo para órdenes abiertas (statuorf < 3) *@
                        @if (orden.StatuOrf.HasValue && orden.StatuOrf.Value < 3)
                        {
                            <button class="btn btn-success btn-sm ms-1"
                                    @onclick="() => CerrarOrdenFabricacion(orden.Id, orden.IdSubOr)"
                                    title="Cerrar Orden de Fabricación">
                                <i class="oi oi-check"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* Modal de configuración de Orden de Fabricación *@
<OrdenFabricacionConfigModal IsVisible="@mostrarModalConfiguracion"
                             OnCloseRequested="@CerrarModalConfiguracion"
                             OnConfigurationSaved="@OnConfiguracionGuardada" />

@* Modal de cierre de Orden de Fabricación *@
@* Este modal se muestra cuando el usuario hace clic en el botón verde de cierre de una orden abierta *@
@* Permite ingresar datos de cierre como cantidades aprobadas/rechazadas y depósitos *@
@if (mostrarModalCierre)
{
    @* Estructura principal del modal con fondo oscuro *@
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                @* Encabezado del modal con color verde para mantener consistencia visual *@
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="oi oi-check me-2"></i>Cierre de Orden de Fabricación
                    </h5>
                    @* Botón de cierre con estilo blanco para contraste con fondo verde *@
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalCierre"></button>
                </div>
                @* Cuerpo principal del modal donde se muestran los datos y controles *@
                <div class="modal-body">
                    @* Indicador de carga mientras se obtienen los datos de la orden y configuraciones *@
                    @if (cargandoDatosCierre)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando datos...</span>
                            </div>
                        </div>
                    }
                    @* Contenido principal del modal cuando los datos están cargados *@
                    else if (ordenParaCierre is not null)
                    {
                        @* Sección de datos fijos de la orden - información de solo lectura *@
                        <!-- Datos fijos de la orden -->
                        <div class="card mb-3">
                            @* Encabezado de la sección con color verde pastel *@
                            <div class="card-header" style="background-color: #c3e6cb; color: #155724;">
                                <h6 class="card-title mb-0">
                                    <i class="oi oi-document me-2"></i><strong>Datos de la Orden</strong>
                                </h6>
                            </div>
                            @* Contenido del card con los datos fijos de la orden *@
                            <div class="card-body">
                                @* Primera fila: Código del producto y número de orden de fabricación *@
                                <div class="row">
                                    <div class="col-md-6">
                                        @* Código externo del producto (campo Cod_Exte) *@
                                        <div class="mb-2">
                                            <strong>Código:</strong> @ordenParaCierre.Cod_Exte
                                        </div>
                                        @* Número de orden de fabricación (campo IdSubOr) *@
                                        <div class="mb-2">
                                            <strong>O.Fabricación:</strong> @ordenParaCierre.IdSubOr
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        @* Descripción del producto (campo Descrip) *@
                                        <div class="mb-2">
                                            <strong>Descripción:</strong> @ordenParaCierre.Descrip
                                        </div>
                                        @* Cantidad proyectada original de la orden (campo CanProy) *@
                                        <div class="mb-2">
                                            <strong>Cantidad:</strong> @FormatDecimal(ordenParaCierre.CanProy)
                                        </div>
                                    </div>
                                </div>
                                @* Segunda fila: Cantidades aprobadas y pendientes *@
                                <div class="row">
                                    <div class="col-md-6">
                                        @* Cantidad ya aprobada en cierres anteriores (campo CanApro) *@
                                        <div class="mb-2">
                                            <strong>Cant.Aprobadas:</strong> @FormatDecimal(ordenParaCierre.CanApro)
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        @* Cantidad pendiente calculada: CanProy - CanApro *@
                                        <div class="mb-2">
                                            <strong>Cant. Pendiente:</strong> @FormatDecimal((ordenParaCierre.CanProy ?? 0) - (ordenParaCierre.CanApro ?? 0))
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Sección de campos editables para el cierre de la orden *@
                        <!-- Campos editables del modal de cierre -->
                        <div class="card">
                            @* Encabezado de la sección de datos editables con color verde pastel *@
                            <div class="card-header" style="background-color: #c3e6cb; color: #155724;">
                                <h6 class="card-title mb-0">
                                    <i class="oi oi-wrench me-2"></i><strong>Datos de Cierre</strong>
                                </h6>
                            </div>
                            @* Contenido del card con los controles editables *@
                            <div class="card-body">
                                @* Campo de fecha de cierre - por defecto fecha actual *@
                                <!-- Fecha -->
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <label for="fechaCierre" class="form-label"><strong>Fecha:</strong></label>
                                        @* Control de fecha que se inicializa con DateTime.Today *@
                                        <InputDate id="fechaCierre" class="form-control" @bind-Value="fechaCierre" />
                                    </div>
                                </div>

                                @* FILA DE SELECCIÓN DE DEPÓSITOS - AMBOS SON OBLIGATORIOS *@
                                @* Estos depósitos se configuran automáticamente con valores por defecto del sistema *@
                                @* DEPOCIE para entrada y DEPODEST para salida, obtenidos de la tabla flexcrl *@
                                <!-- Dep. Entrada y Dep. Salida -->
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        @* DEPÓSITO DE ENTRADA - DONDE SE ALMACENARÁ EL PRODUCTO TERMINADO *@
                                        @* Se preselecciona automáticamente con el valor configurado en DEPOCIE *@
                                        @* Este depósito recibirá el stock del producto fabricado exitosamente *@
                                        @* El valor por defecto se obtiene de flexcrl con parámetros ("", "DEPOCIE") *@
                                        <label for="depositoEntrada" class="form-label"><strong>Dep. Entrada:</strong></label>
                                        @* InputSelect cargado dinámicamente desde api/tadeposi/combo *@
                                        @* Se inicializa con depositoEntradaSeleccionado = valor de DEPOCIE *@
                                        <InputSelect id="depositoEntrada" class="form-select" @bind-Value="depositoEntradaSeleccionado">
                                            <option value="0">Seleccionar depósito...</option>
                                            @if (depositosDisponibles?.Any() == true)
                                            {
                                                @* LISTA DE DEPÓSITOS DISPONIBLES *@
                                                @* Iteración sobre los depósitos disponibles obtenidos de la API *@
                                                @* El depósito DEPOCIE aparecerá preseleccionado automáticamente *@
                                                @foreach (var deposito in depositosDisponibles)
                                                {
                                                    <option value="@deposito.Key">@deposito.Value</option>
                                                }
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-6">
                                        @* DEPÓSITO DE SALIDA/CONSUMO - DE DONDE SALEN LOS MATERIALES *@
                                        @* Se preselecciona automáticamente con el valor configurado en DEPODEST *@
                                        @* Este depósito es donde se encuentran las materias primas consumidas *@
                                        @* El valor por defecto se obtiene de flexcrl con parámetros ("", "DEPODEST") *@
                                        <label for="depositoConsumo" class="form-label"><strong>Dep. Salida:</strong></label>
                                        @* InputSelect con la misma lista de depósitos disponibles *@
                                        @* Se inicializa con depositoConsumoSeleccionado = valor de DEPODEST *@
                                        <InputSelect id="depositoConsumo" class="form-select" @bind-Value="depositoConsumoSeleccionado">
                                            <option value="0">Seleccionar depósito...</option>
                                            @if (depositosDisponibles?.Any() == true)
                                            {
                                                @* LISTA DE DEPÓSITOS PARA CONSISTENCIA *@
                                                @* Misma lista que el depósito de entrada para mantener coherencia *@
                                                @* El depósito DEPODEST aparecerá preseleccionado automáticamente *@
                                                @foreach (var deposito in depositosDisponibles)
                                                {
                                                    <option value="@deposito.Key">@deposito.Value</option>
                                                }
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                @* FALTA PERSISTIR LOS DATOS DE SCRAP NO SE ESTAN CONSIDERANDO EN LOS CONTROLADORES AUN *@
                                @* Fila de cantidades - al menos una debe ser mayor a 0 *@
                                <!-- Cant.Aprobada y Cant.Rechazada -->
                                <div class="row">
                                    <div class="col-md-6">
                                        @* Cantidad aprobada en este cierre - no puede ser negativa *@
                                        <label for="cantidadAprobada" class="form-label"><strong>Cant.Aprobada:</strong></label>
                                        @* InputNumber con step decimal para permitir valores con decimales *@
                                        <InputNumber id="cantidadAprobada" class="form-control" @bind-Value="cantidadAprobada" step="0.01" />
                                    </div>
                                    <div class="col-md-6">
                                        @* Cantidad rechazada en este cierre - controla la visibilidad del depósito scrap *@
                                        <label for="cantidadRechazada" class="form-label"><strong>Cant.Rechazada:</strong></label>
                                        @* InputNumber que al cambiar puede mostrar/ocultar el control de depósito scrap *@
                                        <InputNumber id="cantidadRechazada" class="form-control" @bind-Value="cantidadRechazada" step="0.01" />
                                    </div>
                                </div>

                                @* CONTROL CONDICIONAL PARA DEPÓSITO SCRAP *@
                                @* Este control tiene un comportamiento dinámico muy importante: *@
                                @* - Solo se muestra cuando cantidadRechazada > 0 *@
                                @* - Al cambiar cantidadRechazada a 0, el control desaparece automáticamente *@
                                @* - Al ingresar cantidadRechazada > 0, el control aparece instantáneamente *@
                                @* - Se preselecciona automáticamente con el valor configurado en DEPSCRAP *@
                                @* - Es obligatorio seleccionar un depósito scrap si hay cantidad rechazada *@
                                <!-- Depósito Scrap (solo visible si cantidad rechazada > 0) -->
                                @if (cantidadRechazada > 0)
                                {
                                    @* FILA CONDICIONAL QUE APARECE DINÁMICAMENTE *@
                                    @* Esta fila se renderiza solo cuando el usuario ingresa cantidad rechazada > 0 *@
                                    @* El binding bidireccional de cantidadRechazada hace que el control aparezca/desaparezca en tiempo real *@
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            @* DEPÓSITO PARA MATERIAL RECHAZADO/SCRAP *@
                                            @* Este depósito almacenará todo el material que no pasó el control de calidad *@
                                            @* Es fundamental para la trazabilidad del material defectuoso *@
                                            <label for="depositoScrap" class="form-label"><strong>Depósito Scrap:</strong></label>
                                            @* INPUT SELECT CON VALOR POR DEFECTO CONFIGURADO *@
                                            @* Se inicializa con depositoScrapConfiguracion obtenido de flexcrl.DEPSCRAP *@
                                            @* El usuario puede cambiar la selección si es necesario usar otro depósito *@
                                            @* La validación requiere que este campo tenga un valor > 0 cuando cantidadRechazada > 0 *@
                                            <InputSelect id="depositoScrap" class="form-select" @bind-Value="depositoScrapSeleccionado">
                                                <option value="0">Seleccionar depósito...</option>
                                                @if (depositosDisponibles?.Any() == true)
                                                {
                                                    @* OPCIONES DE DEPÓSITOS DISPONIBLES *@
                                                    @* Misma lista que los depósitos de entrada y salida para consistencia *@
                                                    @* Cargada dinámicamente desde api/tadeposi/combo *@
                                                    @foreach (var deposito in depositosDisponibles)
                                                    {
                                                        <option value="@deposito.Key">@deposito.Value</option>
                                                    }
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @* Footer del modal con botones de acción *@
                <div class="modal-footer">
                    @* Botón Cancelar - cierra el modal sin procesar el cierre *@
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalCierre">
                        <i class="oi oi-x me-1"></i>Cancelar
                    </button>
                    @* Botón Aceptar - procesa el cierre con validaciones *@
                    <button type="button"
                            class="btn btn-success"
                            @onclick="ProcesarCierreOrden"
                            disabled="@(cargandoDatosCierre || procesandoCierre)">
                        @* Spinner durante el procesamiento o icono de check normal *@
                        @if (procesandoCierre)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="oi oi-check me-1"></i>
                        }
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>
    @* Fondo oscuro del modal para bloquear interacción con el resto de la página *@
    <div class="modal-backdrop fade show"></div>
}

@* Modal de componentes de la fórmula *@
@* Este modal se muestra después de las validaciones y antes del mensaje final de cierre *@
@* Muestra los componentes necesarios para fabricar el producto con sus cantidades y stock *@
@if (mostrarModalComponentes)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                @* Encabezado del modal con color azul para diferenciarlo del modal de cierre *@
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">
                        <i class="oi oi-list me-2"></i>Componentes de la Fórmula
                    </h5>
                    @* Botón de cierre con estilo blanco para contraste con fondo azul *@
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelarModalComponentes"></button>
                </div>
                @* Cuerpo principal del modal con la tabla de componentes *@
                <div class="modal-body">
                    @* Indicador de carga mientras se obtienen los datos de los componentes *@
                    @if (cargandoComponentes)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando componentes...</span>
                            </div>
                        </div>
                    }
                    @* Contenido principal del modal cuando los datos están cargados *@
                    else
                    {
                        @* Información de la orden en la parte superior *@
                        <div class="card mb-3">
                            <div class="card-header" style="background-color: #bee5eb; color: #0c5460;">
                                <h6 class="card-title mb-0">
                                    <i class="oi oi-document me-2"></i><strong>Información de la Orden</strong>
                                </h6>
                            </div>
                            <div class="card-body">
                                @if (ordenParaCierre != null)
                                {
                                    <div class="row">
                                        <div class="col-md-6">
                                            <strong>O.Fabricación:</strong> @ordenParaCierre.IdSubOr
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Producto:</strong> @ordenParaCierre.Cod_Exte - @ordenParaCierre.Descrip
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <strong>Cantidad a Cerrar:</strong> @FormatDecimal(cantidadAprobada + cantidadRechazada)
                                        </div>
                                        <div class="col-md-6">
                                            <strong>Estado:</strong> @(cierraCompleto == 1 ? "Se cerrará completamente" : "Se mantendrá abierta")
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Tabla de componentes *@
                        @if (componentesFormula?.Any() == true)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-info">
                                        <tr>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            <th>Unidad Medida</th>
                                            <th class="text-end">Uso Unitario</th>
                                            <th class="text-end">Cantidad</th>
                                            <th class="text-end">Stock Actual</th>
                                            <th class="text-end">Falta</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var componente in componentesFormula)
                                        {
                                            @* Calcular si falta stock basándose en la cantidad a utilizar (editable) *@
                                            decimal falta = componente.CantidadAUtilizar - componente.Stock;

                                            <tr class="@(falta > 0 ? "table-warning" : "")">
                                                <td>@componente.CodXElem</td>
                                                <td>@componente.Descripcion</td>
                                                <td>UN</td> @* Por ahora fijo, se puede obtener del master si está disponible *@
                                                <td class="text-end">@FormatDecimal(componente.UsoBruto)</td>
                                                <td class="text-end">
                                                    @* Campo editable para la cantidad a utilizar *@
                                                    <InputNumber class="form-control text-end"
                                                                 @bind-Value="componente.CantidadAUtilizar"
                                                                 step="0.01"
                                                                 style="width: 120px; display: inline-block;"
                                                                 @onchange="StateHasChanged" />
                                                </td>
                                                <td class="text-end">@FormatDecimal(componente.Stock)</td>
                                                <td class="text-end @(falta > 0 ? "text-danger fw-bold" : "text-success")">
                                                    @FormatDecimal(falta)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
