    private void CancelarAnulacionCierre()
    {
        mostrarModalConfirmacionReservas = false;
    }

    /// <summary>
    /// Ejecuta la anulación de cierre regenerando las reservas
    /// Llama al backend con regenerarReservas=true
    /// </summary>
    private async Task AnularCierreConRegeneracionReservas()
    {
        mostrarModalConfirmacionReservas = false;
        await EjecutarAnulacionCierre(regenerarReservas: true);
    }

    /// <summary>
    /// Ejecuta la anulación de cierre manteniendo las reservas actuales
    /// Llama al backend con regenerarReservas=false
    /// </summary>
    private async Task AnularCierreManteniendoReservas()
    {
        mostrarModalConfirmacionReservas = false;
        await EjecutarAnulacionCierre(regenerarReservas: false);
    }

    /// <summary>
    /// Ejecuta la anulación de cierre llamando al endpoint del backend
    /// </summary>
    /// <param name="regenerarReservas">Indica si se deben regenerar las reservas (true) o mantenerlas (false)</param>
    private async Task EjecutarAnulacionCierre(bool regenerarReservas)
    {
        try
        {
            // PUT api/ordefabr/anular-cierre/{id}?idSubOr={idSubOr}&regenerarReservas={regenerarReservas}
            // El backend ejecuta la anulación en una transacción (todo o nada)
            var response = await repository.Put<object>($"api/ordefabr/anular-cierre/{cierreSeleccionado.Id}?idSubOr={idSubOrParaAnulacion}&regenerarReservas={regenerarReservas}", null);

            // Paso 5: Manejar errores del backend
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", "Error al anular el cierre", SweetAlertIcon.Error);
                return;
            }

            // Paso 6: Si tuvo éxito, mostrar mensaje de éxito
            await sweetAlertService.FireAsync("Éxito", "Cierre anulado exitosamente", SweetAlertIcon.Success);
            
            // Paso 7: Cerrar el modal y recargar la tabla para mostrar los datos actualizados
            CerrarModalAnulacionCierre();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            // Manejar cualquier excepción no controlada
            await sweetAlertService.FireAsync("Error", $"Error al anular cierre: {ex.Message}", SweetAlertIcon.Error);
        }
    }

