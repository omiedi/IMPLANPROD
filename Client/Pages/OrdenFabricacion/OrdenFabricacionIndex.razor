    /// <summary>
    /// Abre el modal de cierre y carga los datos necesarios
    /// </summary>
    private async Task AbrirModalCierre()
    {
        mostrarModalCierre = true;
        cargandoDatosCierre = true;
        StateHasChanged();

        // Cargar datos básicos
        await CargarDepositosDisponibles();
        await CargarDatosOrdenParaCierre();
        await CargarConfiguracionDepositoScrap();

        // Inicializar valores por defecto
        fechaCierre = DateTime.Today;

        // Calcular cantidad pendiente e inicializar cantidadAprobada con este valor
        // Cantidad pendiente = Cantidad Proyectada - Cantidad ya Aprobada
        decimal cantidadPendiente = 0;
        if (ordenParaCierre != null)
        {
            cantidadPendiente = (ordenParaCierre.CanProy ?? 0) - (ordenParaCierre.CanApro ?? 0);
            // Asegurar que no sea negativa
            if (cantidadPendiente < 0) cantidadPendiente = 0;
        }

        // Calcular cantidad propuesta como Cant.Proy. - Cant.Cerrada
        cantidadAprobada = (ordenParaCierre.CanProy ?? 0) - (ordenParaCierre.CantidadCerrada ?? 0);
        // Asegurar que no sea negativa
        if (cantidadAprobada < 0) cantidadAprobada = 0;
        cantidadRechazada = 0;
        depositoScrapSeleccionado = depositoScrapConfiguracion; // Usar configuración por defecto

        // Configurar depósitos por defecto según configuración del sistema
        await ConfigurarDepositosPorDefecto();

        cargandoDatosCierre = false;
        StateHasChanged();
    }

