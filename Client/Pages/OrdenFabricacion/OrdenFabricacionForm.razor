    /// <summary>
    /// Método para grabar las reservas modificadas
    /// </summary>
    private async Task GrabarReservas()
    {
        if (reservasEdicion == null || !reservasEdicion.Any())
        {
            await sweetAlertService.FireAsync("Advertencia", "No hay reservas para actualizar.", SweetAlertIcon.Warning);
            return;
        }
        
        // Mostrar confirmación antes de grabar
        var confirmResult = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar actualización",
            Text = "Se van a actualizar las reservas. ¿Desea continuar?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, actualizar",
            CancelButtonText = "Cancelar"
        });
        
        if (!confirmResult.IsConfirmed)
        {
            return;
        }
        
        try
        {
            // Usar el nuevo endpoint que actualiza múltiples reservas de una vez
            var response = await repository.Put("api/reservas/multiples", reservasEdicion);
            
            if (response.Error)
            {
                var errorMessage = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al actualizar las reservas: {errorMessage}", SweetAlertIcon.Error);
            }
            else
            {
                // El endpoint devuelve información detallada sobre el resultado
                var resultado = response.Response;
                
                if (resultado != null)
                {
                    // Mostrar mensaje de éxito con detalles
                    await sweetAlertService.FireAsync("Éxito", $"Reservas actualizadas exitosamente.", SweetAlertIcon.Success);
                }
                else
                {
                    await sweetAlertService.FireAsync("Éxito", "Reservas actualizadas exitosamente.", SweetAlertIcon.Success);
                }
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error inesperado al actualizar reservas: {ex.Message}", SweetAlertIcon.Error);
        }
    }
    
    /// <summary>
    /// Actualiza la cantidad reservada cuando el usuario modifica el input
    /// </summary>
    /// <param name="reserva">Reserva a actualizar</param>
    /// <param name="e">Evento de cambio</param>
    private void ActualizarCantidadReservada(Reserva reserva, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal nuevaCantidad))
        {
            reserva.CantRes = nuevaCantidad;
        }
        else
        {
            // Si no se puede parsear, mantener el valor anterior o poner 0
            reserva.CantRes = 0;
        }
        
        StateHasChanged();
    }
    
    /// <summary>
    /// Abre el modal de histórico para una reserva seleccionada
    /// </summary>
    /// <param name="reserva">Reserva seleccionada</param>
    private void AbrirHistoricoReserva(Reserva reserva)
    {
        // Convertir la reserva a ProductoConSaldoDTO para usar con el componente HistoricoMovimientosComponent
        componenteSeleccionado = new ProductoConSaldoDTO
        {
            Cod_inte = reserva.Cod_Inte,
            Codigo = reserva.Cod_Exte ?? "",
            Descripcion = reserva.Descrip ?? ""
        };
        
        mostrarModalHistorico = true;
    }
