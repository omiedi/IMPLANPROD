@page "/ordenFabricacion/anotaciones/{OrdenFabricacionId:int}"
@using IMPLANPROD.Client.Services
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager
@inject PageAccessService PageAccess

<PageTitle>Anotaciones de Órdenes de Fabricación</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
    <div class="card">
        <div class="card-header bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <h4>Orden de Fabricación</h4>
                <button class="btn btn-secondary" @onclick="Volver">Volver</button>
            </div>
        </div>
        <div class="card-body">
            @if (cargando)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p>Cargando datos...</p>
                </div>
            }
            else if (ordenFabricacion == null)
            {
                <div class="alert alert-warning">
                    No se encontró la orden de fabricación solicitada.
                </div>
            }
            else
            {
                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Número:</label>
                            <input type="text" class="form-control" value="@ordenFabricacion.IdSubOr" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Fecha:</label>
                            <input type="text" class="form-control" value="@(ordenFabricacion.FechGen?.ToString("dd/MM/yyyy"))" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Cant:</label>
                            <input type="text" class="form-control" value="@(ordenFabricacion.CanProy?.ToString("F1"))" readonly />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="form-label">Código:</label>
                            <input type="text" class="form-control" value="@ordenFabricacion.Cod_Exte" readonly />
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="form-label">Descripción:</label>
                            <input type="text" class="form-control" value="@ordenFabricacion.Descrip" readonly />
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Status:</label>
                            <input type="text" class="form-control" value="@ordenFabricacion.StatuOrf" readonly />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Pedido:</label>
                            <input type="text" class="form-control" value="@ordenFabricacion.NroPed" readonly />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="form-label">Orden:</label>
                            <input type="text" class="form-control" value="@ordenFabricacion.NuOrNroPed" readonly />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h5>Anotaciones</h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Detalle</th>
                                                <th>Usuario</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (string.IsNullOrEmpty(ordenFabricacion.AnotaOrf))
                                            {
                                                <tr>
                                                    <td colspan="3" class="text-center">No hay anotaciones registradas</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var linea in lineasAnotaciones)
                                                {
                                                    <tr>
                                                        <td style="width: 100px;">@ObtenerFechaDeLinea(linea)</td>
                                                        <td>@ObtenerDetalleDeLinea(linea)</td>
                                                        <td style="width: 150px;">@ObtenerUsuarioDeLinea(linea)</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger mt-3">
                        @mensajeError
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    /// <summary>
    /// ID de la orden de fabricación a mostrar
    /// </summary>
    [Parameter]
    public int OrdenFabricacionId { get; set; }

    /// <summary>
    /// Objeto que contiene los datos de la orden de fabricación
    /// </summary>
    private OrdeFabr? ordenFabricacion;

    /// <summary>
    /// Lista de líneas de anotaciones procesadas para mostrar en la tabla
    /// </summary>
    private List<string> lineasAnotaciones = new List<string>();

    /// <summary>
    /// Indica si se está cargando la información
    /// </summary>
    private bool cargando = true;
    private bool validando = true;

    /// <summary>
    /// Mensaje de error para mostrar al usuario
    /// </summary>
    private string? mensajeError;

    /// <summary>
    /// Texto para la nueva anotación a registrar
    /// </summary>
    private string nuevaAnotacion = string.Empty;
    /// <summary>
    /// Usuario activo actual
    /// </summary>
    private string userActivo = string.Empty;
    /// <summary>
    /// Método que se ejecuta al inicializar el componente
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
        await PageAccess.RequiereAccesoAsync("/ordenFabricacion/anotaciones/{OrdenFabricacionId}");
        validando = false;

        // Obtener el usuario activo
        // var authState = await authService.GetAuthenticationStateAsync();
        // var user = authState.User;
        // if (user.Identity.IsAuthenticated)
        // {
        //     userActivo = user.Identity.Name;
        // }
        await CargarOrdenFabricacion();
    }

    /// <summary>
    /// Carga los datos de la orden de fabricación desde la API
    /// </summary>
    private async Task CargarOrdenFabricacion()
    {
        try
        {
            cargando = true;
            mensajeError = null;

            // Obtener la orden de fabricación por su ID
            var response = await repository.Get<OrdeFabr>($"/api/ordefabr/{OrdenFabricacionId}");

            if (response.Error)
            {
                mensajeError = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
                return;
            }

            ordenFabricacion = response.Response;

            if (ordenFabricacion != null && !string.IsNullOrEmpty(ordenFabricacion.AnotaOrf))
            {
                // Procesar las líneas de anotaciones
                ProcesarAnotaciones(ordenFabricacion.AnotaOrf);
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar la orden de fabricación: {ex.Message}";
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    /// <summary>
    /// Procesa el texto de anotaciones para separarlo en líneas
    /// </summary>
    /// <param name="anotaciones">Texto completo de anotaciones</param>
    private void ProcesarAnotaciones(string anotaciones)
    {
        lineasAnotaciones.Clear();

        // Dividir el texto por saltos de línea
        var lineas = anotaciones.Split(new[] { "\r\n", "\n" }, StringSplitOptions.None);

        foreach (var linea in lineas)
        {
            // Ignorar líneas de separación (líneas con solo caracteres '=')
            if (!string.IsNullOrEmpty(linea) && !linea.All(c => c == '='))
            {
                lineasAnotaciones.Add(linea);
            }
        }
    }

    /// <summary>
    /// Extrae la fecha de una línea de anotación
    /// </summary>
    /// <param name="linea">Línea de texto de anotación</param>
    /// <returns>Fecha formateada</returns>
    private string ObtenerFechaDeLinea(string linea)
    {
        // La fecha está en los primeros 8 caracteres (formato dd/mm/yy)
        if (linea.Length >= 8)
        {
            return linea.Substring(0, 8).Trim();
        }
        return string.Empty;
    }

    /// <summary>
    /// Extrae el detalle de una línea de anotación
    /// </summary>
    /// <param name="linea">Línea de texto de anotación</param>
    /// <returns>Detalle de la anotación</returns>
    private string ObtenerDetalleDeLinea(string linea)
    {
        // El detalle está entre los caracteres 10 y 68 aproximadamente
        if (linea.Length >= 10)
        {
            int inicio = 10;
            int longitud = Math.Min(58, linea.Length - inicio);
            return linea.Substring(inicio, longitud).Trim();
        }
        return string.Empty;
    }

    /// <summary>
    /// Extrae el usuario de una línea de anotación
    /// </summary>
    /// <param name="linea">Línea de texto de anotación</param>
    /// <returns>Usuario que registró la anotación</returns>
    private string ObtenerUsuarioDeLinea(string linea)
    {
        // El usuario está en los últimos 24 caracteres aproximadamente
        if (linea.Length >= 69)
        {
            return linea.Substring(68).Trim();
        }
        return string.Empty;
    }

