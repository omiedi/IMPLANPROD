@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IModalService Modal

<div class="modal-body">
    <h3>Crear categoría</h3>

    <CatoperForm @ref="CatoperForm" Catoper="catoper" OnValidSubmit="Create" ReturnAction="Return" IsEdit="false" />
</div>

@code {
    private Catoper catoper = new();
    private CatoperForm? CatoperForm;
    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = default!;

    // Método para crear una nueva moneda
    private async Task Create()
    {
        var responseHttp = await repository.Post("/api/catoper", catoper);
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        await BlazoredModal.CloseAsync(ModalResult.Ok());
        Return();
    }

    // Método para regresar a la página principal
    private void Return()
    {
        CatoperForm!.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/Catoper/Index");
    }
}
