@using IMPLANPROD.Shared.Entities
@inject HttpClient Http

<form autocomplete="off" @onsubmit="Guardar" @onsubmit:preventDefault>
    <!-- Campo oculto para "engañar" al navegador -->
    <input type="text" 
           style="display:none" 
           name="fakeusernameremembered"
           value="@($"user_{DateTime.Now.Ticks}")" />
    <input type="password" 
           style="display:none" 
           name="fakepasswordremembered" />

    <div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #1F7246; color: white;">
                    <h5 class="modal-title">Cambiar Contraseña</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cancelar"></button>
                </div>
                
                <div class="modal-body">
                    <div class="form-group">
                        <label for="nuevaPassword">Nueva Contraseña:</label>
                        <div class="input-group">
                            <input type="@(mostrarPassword ? "text" : "password")" 
                                   id="nuevaPassword" 
                                   name="@($"pwd_{DateTime.Now.Ticks}")"
                                   @bind="nuevaPassword" 
                                   @bind:event="oninput"
                                   autocomplete="off"
                                   spellcheck="false"
                                   class="form-control @(string.IsNullOrEmpty(nuevaPassword) && intentoGuardar ? "is-invalid" : "")" />
                            <button type="button" 
                                    class="btn btn-outline-secondary" 
                                    @onclick="TogglePasswordVisibility">
                                <i class="@(mostrarPassword ? "oi oi-eye-closed" : "oi oi-eye")" 
                                   aria-hidden="true"></i>
                            </button>
                        </div>
                        @if (string.IsNullOrEmpty(nuevaPassword) && intentoGuardar)
                        {
                            <div class="invalid-feedback d-block">
                                Debe ingresar una nueva contraseña
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger mt-2">
                                @mensajeError
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</form>

@code {
    [CascadingParameter] BlazoredModalInstance Modal { get; set; } = default!;
    [Parameter] public int UsuarioId { get; set; }

    private string nuevaPassword = "";
    private bool mostrarPassword = false;
    private bool intentoGuardar = false;
    private string? mensajeError;

    private void TogglePasswordVisibility()
    {
        mostrarPassword = !mostrarPassword;
    }

    private async Task Guardar()
    {
        try
        {
            intentoGuardar = true;
            mensajeError = null;

            if (string.IsNullOrEmpty(nuevaPassword))
            {
                return;
            }

            // Verificar primero que el usuario exista y sea el correcto
            var usuarioResponse = await Http.GetAsync($"api/Usuarios/{UsuarioId}");
            if (!usuarioResponse.IsSuccessStatusCode)
            {
                mensajeError = "Error: No se pudo verificar el usuario. Por favor, recargue la página.";
                return;
            }

            var passwordUpdate = new
            {
                Id = UsuarioId,
                Password = nuevaPassword
            };

            var response = await Http.PutAsJsonAsync($"api/Usuarios/{UsuarioId}/password", passwordUpdate);
            
            if (response.IsSuccessStatusCode)
            {
                var usuario = await response.Content.ReadFromJsonAsync<Usuario>();
                if (usuario != null)
                {
                    await Modal.CloseAsync(ModalResult.Ok(usuario));
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensajeError = "Error al actualizar la contraseña: " + error;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            mensajeError = "Error al actualizar la contraseña";
        }
    }

    private async Task Cancelar()
    {
        await Modal.CancelAsync();
    }
}
