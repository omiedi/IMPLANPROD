@page "/usuarios"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@using IMPLANPROD.Shared.Entities
@inject IRepository repository
@inject NavigationManager NavigationManager
@inject SweetAlertService sweetAlertService

<h3>Lista de Usuarios</h3>

<div class="mb-3">
    <a href="/registro" class="btn btn-primary">Nuevo Usuario</a>
    <button class="btn btn-info ms-2" @onclick="AbrirModalCopiar">
        <i class="fas fa-copy me-1"></i> Copiar Permisos de Páginas
    </button>
</div>

@if (mostrarModalCopiar)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.55);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="fas fa-copy me-2"></i>Copiar Permisos de Páginas</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalCopiar"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning py-2">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Los permisos actuales del usuario destino serán <strong>reemplazados</strong> por los del origen.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Usuario Origen</label>
                        <select class="form-select" @bind="copiarOrigenId">
                            <option value="0">-- Seleccioná usuario origen --</option>
                            @foreach (var u in usuariosParaCombos)
                            {
                                <option value="@u.Id">@u.NombreUsuario (@(perfiles.FirstOrDefault(p => p.Id == u.PerfilId)?.Nombre ?? "Sin perfil"))</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Usuario Destino</label>
                        <select class="form-select" @bind="copiarDestinoId">
                            <option value="0">-- Seleccioná usuario destino --</option>
                            @foreach (var u in usuariosParaCombos)
                            {
                                <option value="@u.Id">@u.NombreUsuario (@(perfiles.FirstOrDefault(p => p.Id == u.PerfilId)?.Nombre ?? "Sin perfil"))</option>
                            }
                        </select>
                    </div>
                    @if (copiarOrigenId > 0 && copiarDestinoId > 0 && copiarOrigenId == copiarDestinoId)
                    {
                        <div class="alert alert-danger py-1 small">El origen y destino no pueden ser el mismo usuario.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalCopiar">Cancelar</button>
                    <button class="btn btn-info text-white" @onclick="EjecutarCopiaAsync"
                            disabled="@(copiarOrigenId == 0 || copiarDestinoId == 0 || copiarOrigenId == copiarDestinoId || copiando)">
                        @if (copiando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <i class="fas fa-copy me-1"></i>Copiar Permisos
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (usuarios == null)
{
    <p>Cargando...</p>
}
else if (!usuarios.Any())
{
    <p>No hay usuarios registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Perfil</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in usuarios)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(usuario.FotoUrl))
                            {
                                <img src="@usuario.FotoUrl" alt="@usuario.NombreUsuario" style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%;" />
                            }
                            else
                            {
                                <img src="/images/default-user.png" alt="Default" style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%;" />
                            }
                        </td>
                        <td>@usuario.NombreUsuario</td>
                        <td>@usuario.Email</td>
                        <td>
                            @{
                                var perfil = perfiles.FirstOrDefault(p => p.Id == usuario.PerfilId);
                            }
                            @(perfil != null ? perfil.Nombre : "Sin perfil")
                        </td>
                        <td>
                            <span class="badge @(usuario.Activo ? "bg-success" : "bg-danger")">
                                @(usuario.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-primary me-2" @onclick="() => EditarUsuario(usuario.Id)">
                                <i class="fas fa-edit"></i> Editar
                            </button>
                            <button class="btn btn-sm @(usuario.Activo ? "btn-danger" : "btn-success")" @onclick="() => ToggleEstadoUsuario(usuario.Id)">
                                <i class="fas @(usuario.Activo ? "fa-user-times" : "fa-user-check")"></i>
                                @(usuario.Activo ? "Dar de Baja" : "Activar")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Usuario>? usuarios;
    private List<Perfil> perfiles = new();
    private string? mensajeError;

    private bool mostrarModalCopiar = false;
    private bool copiando = false;
    private int copiarOrigenId = 0;
    private int copiarDestinoId = 0;
    private List<Usuario> usuariosParaCombos = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarPerfiles();
        await CargarUsuarios();
    }

    private async Task CargarPerfiles()
    {
        var resp = await repository.Get<List<Perfil>>("api/Perfiles");
        if (!resp.Error)
            perfiles = resp.Response ?? new();
    }

    private async Task CargarUsuarios()
    {
        var resp = await repository.Get<List<Usuario>>("api/Usuarios");
        if (resp.Error)
        {
            var msg = await resp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
            usuarios = new();
            return;
        }
        usuarios = resp.Response ?? new();
    }

    private void EditarUsuario(int id)
    {
        NavigationManager.NavigateTo($"/usuarios/editar/{id}");
    }

    private void AbrirModalCopiar()
    {
        copiarOrigenId  = 0;
        copiarDestinoId = 0;
        usuariosParaCombos = usuarios?
            .Where(u => !string.Equals(
                perfiles.FirstOrDefault(p => p.Id == u.PerfilId)?.Nombre?.Trim(),
                "SUPERADMIN", StringComparison.OrdinalIgnoreCase))
            .OrderBy(u => u.NombreUsuario)
            .ToList() ?? new();
        mostrarModalCopiar = true;
    }

    private void CerrarModalCopiar() => mostrarModalCopiar = false;

    private async Task EjecutarCopiaAsync()
    {
        if (copiarOrigenId == 0 || copiarDestinoId == 0 || copiarOrigenId == copiarDestinoId) return;

        var origen  = usuariosParaCombos.FirstOrDefault(u => u.Id == copiarOrigenId);
        var destino = usuariosParaCombos.FirstOrDefault(u => u.Id == copiarDestinoId);

        var confirm = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¿Confirmar copia de permisos?",
            Html  = $"Se copiarán los permisos de <b>{origen?.NombreUsuario}</b> hacia <b>{destino?.NombreUsuario}</b>.<br/>" +
                    $"Los permisos actuales de <b>{destino?.NombreUsuario}</b> serán <strong>reemplazados</strong>.",
            Icon  = SweetAlertIcon.Warning,
            ShowCancelButton  = true,
            ConfirmButtonText = "Sí, copiar",
            CancelButtonText  = "Cancelar",
            ConfirmButtonColor = "#0dcaf0"
        });

        if (!confirm.IsConfirmed) return;

        copiando = true;
        var resp = await repository.Post<object>(
            $"api/seguridad-rutas/usuarios/{copiarOrigenId}/copiar-permisos/{copiarDestinoId}", new {});
        copiando = false;

        if (resp.Error)
        {
            var msg = await resp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
            return;
        }

        CerrarModalCopiar();
        await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Icon  = SweetAlertIcon.Success,
            Title = "Permisos copiados",
            Text  = $"Los permisos de {origen?.NombreUsuario} fueron copiados a {destino?.NombreUsuario}.",
            Timer = 2500,
            ShowConfirmButton = false
        });
    }

    private async Task ToggleEstadoUsuario(int id)
    {
        try
        {
            var response = await repository.Put($"api/Usuarios/toggle-estado/{id}", (object?)null);
            if (!response.Error)
            {
                await CargarUsuarios();
            }
            else
            {
                var msg = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al cambiar el estado del usuario";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
