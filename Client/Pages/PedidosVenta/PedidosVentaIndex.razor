    /// <summary>
    /// Carga el detalle de ítems pendientes del pedido seleccionado replicando la
    /// query del VB6 (SELITPED):
    ///   PEDDETA.Status &lt; 8               -- no anulada ni cumplida
    ///   PEDDETA.Status &lt;&gt; 3           -- el VB6 excluye además el estado 3
    ///   PEDDETA.CantEnt &lt; CanPed - 0.005 -- con saldo pendiente
    ///   PEDENCA.Status &lt; 9               -- pedido no anulado (ya garantizado por la lista)
    /// Y como en el VB6 (CAN = CanPed - CantEnt; solo se lista si CAN &gt;= 0.05),
    /// se descartan los ítems con saldo menor a 0.05.
    /// </summary>
    private async Task SeleccionarPedidoAnulacionAsync(PedidoConItemsPendientesDTO pedido)
    {
        pedidoAnulSeleccionado = pedido;
        itemsAnulables = null;
        itemsAnulSeleccionados.Clear();
        cargandoItemsAnul = true;
        StateHasChanged();

        try
        {
            var resp = await repository.Get<List<Peddeta>>($"api/pedenca/detalle/{pedido.NroPed}");
            itemsAnulables = (resp.Response ?? new List<Peddeta>())
                .Where(d => d.Status < 8
                         && d.Status != 3
                         && (d.CantEnt ?? 0m) < (d.CanPed ?? 0m) - 0.005m
                         && (d.CanPed ?? 0m) - (d.CantEnt ?? 0m) >= 0.05m)
                .OrderBy(d => d.NuOrItem)
                .ToList();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar ítems del pedido: {ex.Message}", SweetAlertIcon.Error);
            itemsAnulables = new List<Peddeta>();
        }
        finally
        {
            cargandoItemsAnul = false;
            StateHasChanged();
        }
    }

    /// <summary>Indica si todos los ítems pendientes mostrados están tildados.</summary>
    private bool TodosItemsAnulSeleccionados =>
        itemsAnulables != null && itemsAnulables.Any() &&
        itemsAnulables.All(i => itemsAnulSeleccionados.Contains(i.NuOrItem ?? 0));

    /// <summary>Tilda/destilda un ítem individual de la grilla de pendientes.</summary>
    private void ToggleItemAnul(Peddeta item, ChangeEventArgs e)
    {
        var nuOrItem = item.NuOrItem ?? 0;
        if ((bool)(e.Value ?? false))
        {
            itemsAnulSeleccionados.Add(nuOrItem);
        }
        else
        {
            itemsAnulSeleccionados.Remove(nuOrItem);
        }
    }

    /// <summary>Tilda/destilda todos los ítems pendientes mostrados (check del encabezado).</summary>
    private void SeleccionarTodosItemsAnul(ChangeEventArgs e)
    {
        itemsAnulSeleccionados.Clear();
        if ((bool)(e.Value ?? false) && itemsAnulables != null)
        {
            foreach (var item in itemsAnulables)
            {
                itemsAnulSeleccionados.Add(item.NuOrItem ?? 0);
            }
        }
    }

    /// <summary>
    /// Botón "Marcar Cumplidos": pone PEDDETA.Status = 8 en los ítems tildados del
    /// pedido seleccionado (endpoint api/pedenca/marcar-items-cumplidos) y refresca
    /// el detalle y la lista de pedidos. Si el pedido se queda sin ítems pendientes,
    /// desaparece de la lista (ya no cumple el WHERE del recordset VB6).
    /// </summary>
    private async Task MarcarItemsCumplidosAsync()
    {
        if (pedidoAnulSeleccionado == null || !itemsAnulSeleccionados.Any())
        {
            return;
        }

        var confirmacion = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Marcar ítems como cumplidos",
            Text = $"Se marcarán {itemsAnulSeleccionados.Count} ítem(s) del pedido N° {pedidoAnulSeleccionado.NroPed} como cumplidos (Status = 8).\n¿Desea continuar?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, marcar",
            CancelButtonText = "Cancelar"
        });

        if (!confirmacion.IsConfirmed)
        {
            return;
        }

        cargandoItemsAnul = true;
        StateHasChanged();

        try
        {
            var dto = new MarcarItemsCumplidosDTO
            {
                NroPed = pedidoAnulSeleccionado.NroPed,
                NuOrItems = itemsAnulSeleccionados.ToList()
            };

            var resp = await repository.Post<MarcarItemsCumplidosDTO, object>("api/pedenca/marcar-items-cumplidos", dto);
            if (resp.Error)
            {
                var mensaje = await resp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Éxito", "Ítems marcados como cumplidos", SweetAlertIcon.Success);

            itemsAnulSeleccionados.Clear();

            // Recargar el detalle del pedido (los ítems cumplidos ya no aparecen)
            await SeleccionarPedidoAnulacionAsync(pedidoAnulSeleccionado);

            // Refrescar la lista de pedidos sin perder la selección actual
            var nroPedSeleccionado = pedidoAnulSeleccionado?.NroPed;
            await CargarPedidosAnulablesAsync(mantenerSeleccion: true);
            if (nroPedSeleccionado.HasValue
                && pedidosAnulables?.All(p => p.NroPed != nroPedSeleccionado.Value) == true)
            {
                // El pedido ya no tiene ítems pendientes: sale de la lista y se limpia el detalle
                pedidoAnulSeleccionado = null;
                itemsAnulables = null;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al marcar ítems: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            cargandoItemsAnul = false;
            StateHasChanged();
        }
    }

