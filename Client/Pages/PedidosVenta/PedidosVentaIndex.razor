    /// <summary>
    /// Abre la vista impresa del remito clickeado en la columna "N° Remito" del
    /// reporte Entregas de Pedidos. Genera el PDF con la plantilla REMITOCLIENTE
    /// (igual que el link/botón Imprimir de /remitos) y lo abre en una pestaña
    /// nueva. Se envían Doprilar + Nume_Clie + Fechmov (fecha real de la entrega
    /// en MOVISTO) para filtrar correctamente los datos de la plantilla.
    /// </summary>
    private async Task ImprimirRemitoEntregaAsync(PedidoVentaEntregaDetalleDTO fila, RemitoEntregaDTO remito)
    {
        if (imprimiendoRemitoEntrega || string.IsNullOrWhiteSpace(remito.Remito)) return;

        imprimiendoRemitoEntrega = true;
        remitoEntregaImprimiendo = remito.Remito;
        try
        {
            var plantillaId = await GetPlantillaRemitoClienteIdAsync();
            if (!plantillaId.HasValue) return;

            var queryParams = new List<string>
            {
                $"Doprilar={Uri.EscapeDataString(remito.Remito.Trim())}"
            };
            if (fila.NroClie.GetValueOrDefault() > 0)
            {
                queryParams.Add($"Nume_Clie={fila.NroClie.Value}");
            }
            if (remito.FechaRemito.HasValue && remito.FechaRemito.Value > DateTime.MinValue)
            {
                queryParams.Add($"Fechmov={Uri.EscapeDataString(remito.FechaRemito.Value.ToString("yyyy-MM-dd"))}");
            }

            var endpoint = $"api/impresiones/remito-plantillas/{plantillaId.Value}/pdf?{string.Join("&", queryParams)}";
            var responsePdf = await Http.GetAsync(endpoint);
            if (!responsePdf.IsSuccessStatusCode)
            {
                var message = await responsePdf.Content.ReadAsStringAsync();
                await sweetAlertService.FireAsync("Error", $"No se pudo generar el PDF del remito: {message}", SweetAlertIcon.Error);
                return;
            }

            var pdfBytes = await responsePdf.Content.ReadAsByteArrayAsync();
            if (pdfBytes.Length == 0)
            {
                await sweetAlertService.FireAsync("Error", "El PDF generado está vacío.", SweetAlertIcon.Error);
                return;
            }

            var base64 = Convert.ToBase64String(pdfBytes);
            var opened = await JS.InvokeAsync<bool>("openPdfInNewTab", base64);
            if (!opened)
            {
                await sweetAlertService.FireAsync("Atención", "No se pudo abrir el PDF en una nueva pestaña. Verificá el bloqueador de pop-ups.", SweetAlertIcon.Warning);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al imprimir el remito: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            imprimiendoRemitoEntrega = false;
            remitoEntregaImprimiendo = null;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Busca el Id de la plantilla REMITOCLIENTE en ReportePersonalizado
    /// (mismo criterio que /remitos).
    /// </summary>
    private async Task<int?> GetPlantillaRemitoClienteIdAsync()
    {
        if (plantillaRemitoClienteId.HasValue)
        {
            return plantillaRemitoClienteId;
        }

        var response = await repository.Get<List<RemitoPlantillaItemDto>>("api/impresiones/remito-plantillas");
        if (response.Error || response.Response == null)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo obtener el listado de plantillas de remito: {message}", SweetAlertIcon.Error);
            return null;
        }

        var plantilla = response.Response
            .FirstOrDefault(x => string.Equals(x.Nombre?.Trim(), NombrePlantillaRemitoCliente, StringComparison.OrdinalIgnoreCase));
        if (plantilla == null)
        {
            await sweetAlertService.FireAsync("Atención", $"No se encontró la plantilla '{NombrePlantillaRemitoCliente}'.", SweetAlertIcon.Warning);
            return null;
        }

        plantillaRemitoClienteId = plantilla.Id;
        return plantillaRemitoClienteId;
    }

