                    @if (cargandoAnularItems)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="fas fa-tools"></i> Utilidades
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button class="dropdown-item" @onclick="AbrirAnularItemsAsync">
                            <i class="fas fa-ban me-2"></i>Anular Items de Pedido
                        </button>
                    </li>
                </ul>
            </div>
            <div class="btn-group">
                <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" disabled="@(cargandoPendientes || cargandoEntregas || cargandoOcom)">
                    @if (cargandoPendientes || cargandoEntregas || cargandoOcom)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="fas fa-chart-pie"></i> Reportes
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <button class="dropdown-item" @onclick="AbrirPedidosPendientesAsync">
                            <i class="fas fa-clock me-2"></i>Pedidos Pendientes
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" @onclick="AbrirEntregasPedidosAsync">
                            <i class="fas fa-truck-loading me-2"></i>Entregas de Pedidos
                        </button>
                    </li>
                    <li>
                        <button class="dropdown-item" @onclick="AbrirPedidosConOcomAsync">
                            <i class="fas fa-file-contract me-2"></i>Pedidos C/O.Compra x Fechas
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Filtros de búsqueda -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Buscar Cliente:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="clienteSeleccionado" @bind:event="oninput" placeholder="Cliente seleccionado..." readonly />
                        <button class="btn btn-outline-secondary" @onclick="LimpiarCliente">
                            <i class="fas fa-times"></i>
                        </button>
                        <button class="btn btn-outline-primary" @onclick="AbrirSelectorClientes" title="Seleccionar Cliente">
                            <i class="fas fa-users"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">N° Pedido:</label>
                    <InputNumeroLimpio TValue="int?" @bind-Value="filtroNroPed" Class="form-control" Placeholder="Todos" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Buscar:</label>
                    <input type="text" class="form-control" @bind="Filter" @bind:event="oninput" placeholder="N° OC, Referencia..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Estado:</label>
                    <select class="form-select" @bind="filtroEstado" @bind:event="oninput">
                        <option value="">Todos</option>
                        <option value="0">Activos</option>
                        <option value="-1">Pendientes</option>
                        <option value="9">Anulados</option>
                    </select>
                </div>
            </div>
            <div class="row mt-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Fecha Desde:</label>
                    <input type="date" class="form-control" @bind="fechaDesde" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha Hasta:</label>
                    <input type="date" class="form-control" @bind="fechaHasta" @bind:event="oninput" />
                </div>
                <div class="col-md-8 text-end">
                    <button class="btn btn-primary" @onclick="ApplyFilterAsync">
                        <i class="fas fa-filter"></i> Filtrar
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="CleanFilterAsync">
                        <i class="fas fa-eraser"></i> Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Paginación estándar -->
    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />

    <!-- Tabla de pedidos -->
    <div class="card">
        <div class="card-body">
            @if (pedidos == null)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (!pedidos.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> No se encontraron pedidos de venta.
                </div>
            }
            else
            {
                <!-- Botón de impresión -->
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-outline-success" @onclick="ConfirmarImpresionAsync" disabled="@isPrinting">
                        <i class="oi oi-print"></i> Imprimir/Exp.Excel
                    </button>
                    @if (isPrinting)
                    {
                        <div class="ms-2 d-flex align-items-center">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Preparando impresión...</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>N° Pedido</th>
                                <th>Fecha Emisión</th>
                                <th>Cliente</th>
                                <th>N° OC</th>
                                <th>Estado</th>
                                <th>Fecha Entrega</th>
                                <th>Vendedor</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pedido in pedidos)
                            {
                                <tr>
                                    <td>
                                        <strong>@pedido.NroPed</strong>
                                        @if (!string.IsNullOrEmpty(pedido.Referencia))
                                        {
                                            <br><small class="text-muted">@pedido.Referencia</small>
                                        }
                                    </td>
                                    <td>@pedido.FechEmis?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <strong>@pedido.RasoClie</strong>
                                        @if (pedido.NroClie.HasValue)
                                        {
                                            <br><small class="text-muted">Cliente: @pedido.NroClie</small>
                                        }
                                    </td>
                                    <td>@pedido.NroOcom</td>
                                    <td>
                                        @if (pedido.Status == 1)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else if (pedido.Status == -1)
                                        {
                                            <span class="badge bg-warning">Pend. de aprobar</span>
                                        }
                                        else if (pedido.Status == 9)
                                        {
                                            <span class="badge bg-danger">Anulado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@pedido.Status</span>
                                        }
                                    </td>
                                    <td>@pedido.FeSolEnt?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @pedido.VenRep
                                        @if (pedido.Vended.HasValue)
                                        {
                                            <br><small class="text-muted">Cod: @pedido.Vended</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="(() => EditarPedido(pedido.NroPed ?? 0))" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-info" @onclick="(() => VerAnotaciones(pedido.NroPed ?? 0))" title="Anotador de Pedidos">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" @onclick="(() => VerAuditoria(pedido.NroPed ?? 0))" title="Auditoría del Pedido">
                                                <i class="fas fa-history"></i>
                                            </button>
                                            @if (pedido.Status != -8)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="(() => AnularPedido(pedido))" title="Anular">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            }
        </div>
    </div>
</div>
}

