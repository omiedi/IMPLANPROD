@page "/pedidos-venta"
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Shared.Components
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Client.Pages.Reportes
@using Microsoft.AspNetCore.Components.Web
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject FiltrosPedidosService filtrosService
@inject IJSRuntime JS
@inject PageAccessService PageAccess

<PageTitle>Pedidos de Venta</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
<div class="container-fluid">
    <!-- Título de la página -->
    <div class="mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="fas fa-file-invoice-dollar me-2"></i>
            PEDIDOS DE VENTA
        </h2>
    </div>
    <hr class="border-primary border-2 opacity-50" />

@if (mostrarModalPendientes)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" style="width: 80vw; max-width: 80vw;">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-clock"></i> Pedidos Pendientes
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalPendientes"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-12 text-end d-flex align-items-end justify-content-end gap-2">
                            <button class="btn btn-primary" @onclick="AplicarFiltroPendientesAsync" disabled="@cargandoPendientes">
                                <i class="fas fa-search"></i> Aplicar filtros
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltroPendientesAsync" disabled="@cargandoPendientes">
                                <i class="fas fa-eraser"></i> Limpiar
                            </button>
                            <button class="btn btn-outline-success" @onclick="ConfirmarImpresionPendientesAsync" disabled="@isPrintingPendientes">
                                <i class="oi oi-print"></i> Imprimir/Exp.Excel
                            </button>
                        </div>
                    </div>

                    @if (cargandoPendientes)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (pendientesDetalle == null || !pendientesDetalle.Any())
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i> No se encontraron pedidos pendientes.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.NroPed)))">
                                            N° Pedido <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.NroPed))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.Codigo)))">
                                            Código <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.Codigo))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.Descripcion)))">
                                            Descripción <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.Descripcion))</span>
                                        </th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.CantSolicitada)))">
                                            Cant. Sol. <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.CantSolicitada))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.UMedida)))">
                                            U. Medida <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.UMedida))</span>
                                        </th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.CantEntregada)))">
                                            Cant. Ent. <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.CantEntregada))</span>
                                        </th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.Saldo)))">
                                            Saldo <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.Saldo))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.FechaEntrega)))">
                                            Fecha Entrega <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.FechaEntrega))</span>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th>
                                            <input type="number" class="form-control form-control-sm" @bind="filtroPendNroPed" placeholder="N°" />
                                        </th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroPendCodigo" placeholder="Código" />
                                        </th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroPendDescripcion" placeholder="Descripción" />
                                        </th>
                                        <th>
                                            <div class="d-flex gap-1">
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendCantSolMin" placeholder="Min" />
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendCantSolMax" placeholder="Max" />
                                            </div>
                                        </th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroPendUMedida" placeholder="U.M." />
                                        </th>
                                        <th>
                                            <div class="d-flex gap-1">
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendCantEntMin" placeholder="Min" />
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendCantEntMax" placeholder="Max" />
                                            </div>
                                        </th>
                                        <th>
                                            <div class="d-flex gap-1">
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendSaldoMin" placeholder="Min" />
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendSaldoMax" placeholder="Max" />
                                            </div>
                                        </th>
                                        <th>
                                            <div class="d-flex gap-1">
                                                <input type="date" class="form-control form-control-sm" @bind="filtroPendFechaDesde" />
                                                <input type="date" class="form-control form-control-sm" @bind="filtroPendFechaHasta" />
                                            </div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var it in pendientesDetalle)
                                    {
                                        <tr>
                                            <td><strong>@it.NroPed</strong></td>
                                            <td>@it.Codigo</td>
                                            <td>@it.Descripcion</td>
                                            <td class="text-end">@it.CantSolicitada.ToString("N2")</td>
                                            <td>@it.UMedida</td>
                                            <td class="text-end">@it.CantEntregada.ToString("N2")</td>
                                            <td class="text-end"><strong>@it.Saldo.ToString("N2")</strong></td>
                                            <td>@(it.FechaEntrega?.ToString("dd/MM/yyyy") ?? "")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light sticky-bottom">
                                    <tr>
                                        <th colspan="3" class="text-end">Totales:</th>
                                        <th class="text-end">@TotalCantSolicitada.ToString("N2")</th>
                                        <th></th>
                                        <th class="text-end">@TotalCantEntregada.ToString("N2")</th>
                                        <th class="text-end">@TotalSaldo.ToString("N2")</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalPendientes">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (pendientesDetalle != null && pendientesDetalle.Any())
{
    <ImpresionLista TItem="PedidoVentaPendienteDetalleDTO"
                    Datos="pendientesDetalle"
                    Titulo="@TituloReportePendientes"
                    UrlExportarExcel="api/excel/exportar-pedidos-pendientes-detalle"
                    Encabezados="encabezadosPendientes"
                    ModoDirecto="false"
                    MostrarModal="mostrarModalImpresionPendientes"
                    OnCerrar="ResetearImpresionPendientes" />
}

    <div class="row mb-3">
        <div class="col-auto">
            <button class="btn btn-info me-2" @onclick="AbrirGraficos">
                <i class="fas fa-chart-bar"></i> Reportes y Gráficos
            </button>
            <button class="btn btn-primary" @onclick="CrearNuevoPedido">
                <i class="fas fa-plus"></i> Nuevo Pedido
            </button>
        </div>
        <div class="col text-end">
            <button class="btn btn-outline-primary" @onclick="AbrirPedidosPendientesAsync" disabled="@cargandoPendientes">
                @if (cargandoPendientes)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                <i class="fas fa-clock"></i> Pedidos Pendientes
            </button>
        </div>
    </div>

    <!-- Filtros de búsqueda -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Buscar Cliente:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="clienteSeleccionado" @bind:event="oninput" placeholder="Cliente seleccionado..." readonly />
                        <button class="btn btn-outline-secondary" @onclick="LimpiarCliente">
                            <i class="fas fa-times"></i>
                        </button>
                        <button class="btn btn-outline-primary" @onclick="AbrirSelectorClientes" title="Seleccionar Cliente">
                            <i class="fas fa-users"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Buscar:</label>
                    <input type="text" class="form-control" @bind="Filter" @bind:event="oninput" placeholder="N° OC, Referencia..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Estado:</label>
                    <select class="form-select" @bind="filtroEstado" @bind:event="oninput">
                        <option value="">Todos</option>
                        <option value="0">Activos</option>
                        <option value="-1">Pendientes</option>
                        <option value="9">Anulados</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha Desde:</label>
                    <input type="date" class="form-control" @bind="fechaDesde" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha Hasta:</label>
                    <input type="date" class="form-control" @bind="fechaHasta" @bind:event="oninput" />
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12 text-end">
                    <button class="btn btn-primary" @onclick="ApplyFilterAsync">
                        <i class="fas fa-filter"></i> Filtrar
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="CleanFilterAsync">
                        <i class="fas fa-eraser"></i> Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Paginación estándar -->
    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />

    <!-- Tabla de pedidos -->
    <div class="card">
        <div class="card-body">
            @if (pedidos == null)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (!pedidos.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> No se encontraron pedidos de venta.
                </div>
            }
            else
            {
                <!-- Botón de impresión -->
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-outline-success" @onclick="ConfirmarImpresionAsync" disabled="@isPrinting">
                        <i class="oi oi-print"></i> Imprimir/Exp.Excel
                    </button>
                    @if (isPrinting)
                    {
                        <div class="ms-2 d-flex align-items-center">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Preparando impresión...</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>N° Pedido</th>
                                <th>Fecha Emisión</th>
                                <th>Cliente</th>
                                <th>N° OC</th>
                                <th>Estado</th>
                                <th>Fecha Entrega</th>
                                <th>Vendedor</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pedido in pedidos)
                            {
                                <tr>
                                    <td>
                                        <strong>@pedido.NroPed</strong>
                                        @if (!string.IsNullOrEmpty(pedido.Referencia))
                                        {
                                            <br><small class="text-muted">@pedido.Referencia</small>
                                        }
                                    </td>
                                    <td>@pedido.FechEmis?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <strong>@pedido.RasoClie</strong>
                                        @if (pedido.NroClie.HasValue)
                                        {
                                            <br><small class="text-muted">Cliente: @pedido.NroClie</small>
                                        }
                                    </td>
                                    <td>@pedido.NroOcom</td>
                                    <td>
                                        @if (pedido.Status == 1)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else if (pedido.Status == -1)
                                        {
                                            <span class="badge bg-warning">Pend. de aprobar</span>
                                        }
                                        else if (pedido.Status == 9)
                                        {
                                            <span class="badge bg-danger">Anulado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@pedido.Status</span>
                                        }
                                    </td>
                                    <td>@pedido.FeSolEnt?.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @pedido.VenRep
                                        @if (pedido.Vended.HasValue)
                                        {
                                            <br><small class="text-muted">Cod: @pedido.Vended</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="(() => EditarPedido(pedido.NroPed ?? 0))" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-info" @onclick="(() => VerAnotaciones(pedido.NroPed ?? 0))" title="Anotador de Pedidos">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" @onclick="(() => VerAuditoria(pedido.NroPed ?? 0))" title="Auditoría del Pedido">
                                                <i class="fas fa-history"></i>
                                            </button>
                                            @if (pedido.Status != -8)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="(() => AnularPedido(pedido))" title="Anular">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            }
        </div>
    </div>
</div>
}

<!-- Componente de impresión -->
@if (pedidos != null && pedidos.Any())
{
    <ImpresionLista TItem="Pedenca"
                    Datos="pedidos"
                    Titulo="@TituloReporte"
                    UrlExportarExcel="api/excel/exportar-pedidos"
                    Encabezados="encabezadosPedidos"
                    ModoDirecto="false"
                    MostrarModal="mostrarModalImpresion"
                    OnCerrar="ResetearImpresion" />
}

<!-- Componente selector de clientes -->
<SelectorClientes @ref="selectorClientes" OnClienteSeleccionado="OnClienteSeleccionado" />

@code {
    private List<Pedenca>? pedidos;
    private string filtroEstado = string.Empty;
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string clienteSeleccionado = string.Empty;
    private int? clienteSeleccionadoId;
    private bool validando = true;
    
    // Variables para impresión
    private bool isPrinting = false;
    private bool mostrarModalImpresion = false;
    private string TituloReporte => "Listado de Pedidos de Venta";

    private bool mostrarModalPendientes = false;
    private bool cargandoPendientes = false;
    private List<PedidoVentaPendienteDetalleDTO>? pendientesDetalle;
    private string ordenarPendientesPor = nameof(PedidoVentaPendienteDetalleDTO.NroPed);
    private bool ordenarPendientesAsc = true;

    private int? filtroPendNroPed;
    private string filtroPendCodigo = string.Empty;
    private string filtroPendDescripcion = string.Empty;
    private string filtroPendUMedida = string.Empty;
    private DateTime? filtroPendFechaDesde;
    private DateTime? filtroPendFechaHasta;
    private decimal? filtroPendCantSolMin;
    private decimal? filtroPendCantSolMax;
    private decimal? filtroPendCantEntMin;
    private decimal? filtroPendCantEntMax;
    private decimal? filtroPendSaldoMin;
    private decimal? filtroPendSaldoMax;

    private bool isPrintingPendientes = false;
    private bool mostrarModalImpresionPendientes = false;
    private string TituloReportePendientes => "Pedidos Pendientes (Detalle)";

    private decimal TotalCantSolicitada => pendientesDetalle?.Sum(x => x.CantSolicitada) ?? 0m;
    private decimal TotalCantEntregada => pendientesDetalle?.Sum(x => x.CantEntregada) ?? 0m;
    private decimal TotalSaldo => pendientesDetalle?.Sum(x => x.Saldo) ?? 0m;

    /// <summary>
    /// Referencia al componente selector de clientes
    /// </summary>
    private SelectorClientes? selectorClientes;
    
    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages;

    /// <summary>
    /// Método que se ejecuta al inicializar el componente
    /// Restaura filtros guardados o configura filtros por defecto
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
        await PageAccess.RequiereAccesoAsync("/pedidos-venta");
        validando = false;
        
        // Restaurar filtros guardados
        RestaurarFiltros();
        
        // Si no hay filtros guardados, configurar fechas por defecto: últimos 15 días
        if (fechaDesde == null && fechaHasta == null && !filtrosService.TieneFiltrosActivos())
        {
            fechaHasta = DateTime.Today;
            fechaDesde = DateTime.Today.AddDays(-15);
        }
        
        await LoadAsync();
    }

    /// <summary>
    /// Carga la lista de pedidos desde el backend siguiendo el patrón estándar
    /// Incluye filtros de fecha por defecto
    /// </summary>
    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        // Construir parámetros de filtro incluyendo fechas y cliente
        var parametros = new List<string>();
        
        if (!string.IsNullOrEmpty(Filter))
        {
            parametros.Add($"filter={Filter}");
        }
        
        if (clienteSeleccionadoId.HasValue)
        {
            parametros.Add($"clienteId={clienteSeleccionadoId.Value}");
        }
        
        if (!string.IsNullOrEmpty(filtroEstado))
        {
            parametros.Add($"estado={filtroEstado}");
        }
        
        if (fechaDesde.HasValue)
        {
            parametros.Add($"fechaDesde={fechaDesde.Value:yyyy-MM-dd}");
        }
        
        if (fechaHasta.HasValue)
        {
            parametros.Add($"fechaHasta={fechaHasta.Value:yyyy-MM-dd}");
        }

        string queryParams = parametros.Count > 0 ? "&" + string.Join("&", parametros) : "";

        url1 = $"api/pedenca?page={page}{queryParams}";
        url2 = $"api/pedenca/totalPages?{string.Join("&", parametros)}".TrimEnd('?');

        var responseHttp = await repository.Get<List<Pedenca>>(url1);
        var responseHttp2 = await repository.Get<int>(url2);
        pedidos = responseHttp.Response!;
        totalPages = responseHttp2.Response!;
    }

    /// <summary>
    /// Limpia los filtros de búsqueda y restablece fechas por defecto
    /// </summary>
    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        filtroEstado = string.Empty;
        clienteSeleccionado = string.Empty;
        clienteSeleccionadoId = null;
        // Restablecer fechas por defecto: últimos 15 días
        fechaHasta = DateTime.Today;
        fechaDesde = DateTime.Today.AddDays(-15);
        await ApplyFilterAsync();
    }

    /// <summary>
    /// Aplica los filtros de búsqueda
    /// </summary>
    private async Task ApplyFilterAsync()
    {
        currentPage = 1;
        await LoadAsync(currentPage);
        await SelectedPageAsync(currentPage);
    }

    /// <summary>
    /// Cambia la página actual de la paginación
    /// </summary>
    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    /// <summary>
    /// Navega a la página de creación de nuevo pedido
    /// </summary>
    private void CrearNuevoPedido()
    {
        navigationManager.NavigateTo("/pedidos-venta/crear");
    }

    /// <summary>
    /// Navega a la página de edición de pedido
    /// Guarda los filtros actuales antes de navegar
    /// </summary>
    private void EditarPedido(int nroPedido)
    {
        GuardarFiltros();
        navigationManager.NavigateTo($"/pedidos-venta/editar/{nroPedido}");
    }

    /// <summary>
    /// Navega a la página de anotaciones del pedido
    /// Guarda los filtros actuales antes de navegar
    /// </summary>
    private void VerAnotaciones(int nroPedido)
    {
        GuardarFiltros();
        navigationManager.NavigateTo($"/anotaciones-pedido/{nroPedido}");
    }

    /// <summary>
    /// Anula un pedido existente
    /// </summary>
    private async Task AnularPedido(Pedenca pedido)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar Anulación",
            Text = $"¿Está seguro que desea anular el pedido {pedido.NroPed}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, anular",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            var responseHttp = await repository.Delete($"api/pedenca/{pedido.NroPed}");
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Anulado", "El pedido ha sido anulado exitosamente.", SweetAlertIcon.Success);
            await LoadAsync();
        }
    }

