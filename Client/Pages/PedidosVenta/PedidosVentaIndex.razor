<!-- Componente selector de clientes para el filtro de Entregas de Pedidos -->
<SelectorClientes @ref="selectorClientesEntregas" OnClienteSeleccionado="OnClienteSeleccionadoEntregas" />

    <div class="row mb-3">
        <div class="col-auto">
            <button class="btn btn-info me-2" @onclick="AbrirGraficos">
                <i class="fas fa-chart-bar"></i> Reportes y Gráficos
            </button>
            <button class="btn btn-primary" @onclick="CrearNuevoPedido">
                <i class="fas fa-plus"></i> Nuevo Pedido
            </button>
        </div>
        <div class="col text-end">
            <div class="btn-group me-2">
