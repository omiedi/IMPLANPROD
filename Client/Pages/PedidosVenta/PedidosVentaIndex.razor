    // Utilidad "Anular Items de Pedido" (menú Utilidades)
    // Replica el selector de pedidos del VB6 (recordset Pedianuittemp):
    // pedidos con al menos un ítem pendiente de entrega. La transacción de
    // anulación de ítems se implementa en el paso siguiente.
    // ═══════════════════════════════════════════════════════════════════
    private bool mostrarModalAnularItems = false;
    private bool cargandoAnularItems = false;
    private List<PedidoConItemsPendientesDTO>? pedidosAnulables;
    private PedidoConItemsPendientesDTO? pedidoAnulSeleccionado;
    private List<Peddeta>? itemsAnulables;
    private bool cargandoItemsAnul = false;

    /// <summary>
    /// NuOrItem de los ítems tildados en la grilla de pendientes del pedido.
    /// Por defecto ninguno seleccionado (como el List2 del VB6).
    /// </summary>
    private HashSet<int> itemsAnulSeleccionados = new();

    private int? filtroAnuNroPed;
    private string filtroAnuTexto = string.Empty;

    private async Task AbrirAnularItemsAsync()
