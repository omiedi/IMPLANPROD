    /// <summary>
    /// Método que se ejecuta al inicializar el componente
    /// Restaura filtros guardados o configura filtros por defecto
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
        await PageAccess.RequiereAccesoAsync("/pedidos-venta");
        validando = false;
        
        // Restaurar filtros guardados
        RestaurarFiltros();
        
        // Si no hay filtros guardados, configurar fechas por defecto: últimos 15 días
        if (fechaDesde == null && fechaHasta == null && !filtrosService.TieneFiltrosActivos())
        {
            fechaHasta = DateTime.Today;
            fechaDesde = DateTime.Today.AddDays(-15);
        }
        
        await LoadAsync();
    }

    /// <summary>
    /// Carga la lista de pedidos desde el backend siguiendo el patrón estándar
    /// Incluye filtros de fecha por defecto
    /// </summary>
    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        // Construir parámetros de filtro incluyendo fechas y cliente
        var parametros = new List<string>();
        
        if (!string.IsNullOrEmpty(Filter))
        {
            parametros.Add($"filter={Filter}");
        }
        
        if (clienteSeleccionadoId.HasValue)
        {
            parametros.Add($"clienteId={clienteSeleccionadoId.Value}");
        }
        
        if (filtroNroPed.HasValue)
        {
            parametros.Add($"nroPed={filtroNroPed.Value}");
        }
        
        if (!string.IsNullOrEmpty(filtroEstado))
        {
            parametros.Add($"estado={filtroEstado}");
        }
        
        if (fechaDesde.HasValue)
        {
            parametros.Add($"fechaDesde={fechaDesde.Value:yyyy-MM-dd}");
        }
        
        if (fechaHasta.HasValue)
        {
            parametros.Add($"fechaHasta={fechaHasta.Value:yyyy-MM-dd}");
        }

        string queryParams = parametros.Count > 0 ? "&" + string.Join("&", parametros) : "";

        url1 = $"api/pedenca?page={page}{queryParams}";
        url2 = $"api/pedenca/totalPages?{string.Join("&", parametros)}".TrimEnd('?');

        var responseHttp = await repository.Get<List<Pedenca>>(url1);
        var responseHttp2 = await repository.Get<int>(url2);
        pedidos = responseHttp.Response!;
        totalPages = responseHttp2.Response!;
    }

    /// <summary>
