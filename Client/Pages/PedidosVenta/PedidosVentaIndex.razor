@* ═══════════════════════════════════════════════════════════════════════
   Utilidad "Anular Items de Pedido" (menú Utilidades).
   Lista los pedidos que tienen al menos un ítem de PEDDETA pendiente de
   entrega (regla VB6: PEDDETA.Status < 8, CantEnt < CanPed - 0.005 y
   PEDENCA.Status < 9). Filtros: N° de pedido exacto o texto libre sobre la
   referencia compuesta (N° pedido / N° OC / razón social).
   Al seleccionar un pedido se muestran sus ítems pendientes (solo lectura);
   la transacción de anulación se implementa en el paso siguiente.
   ═══════════════════════════════════════════════════════════════════════ *@
@if (mostrarModalAnularItems)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" style="width: 85vw; max-width: 85vw;">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-ban"></i> Anular Items de Pedido
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalAnularItems"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-2">
                            <label class="form-label">N° Pedido:</label>
                            <InputNumeroLimpio TValue="int?" @bind-Value="filtroAnuNroPed" Class="form-control" Placeholder="Todos" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Referencia:</label>
                            <input type="text" class="form-control" @bind="filtroAnuTexto" placeholder="N° pedido, N° OC o razón social..." />
                        </div>
                        <div class="col-md-6 d-flex align-items-end justify-content-end gap-2">
                            <button class="btn btn-primary" @onclick="(() => CargarPedidosAnulablesAsync())" disabled="@cargandoAnularItems">
                                <i class="fas fa-search"></i> Aplicar
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltroAnularItemsAsync" disabled="@cargandoAnularItems">
                                <i class="fas fa-eraser"></i> Limpiar
                            </button>
                        </div>
                    </div>

                    @if (cargandoAnularItems)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted">Cargando pedidos...</p>
                        </div>
                    }
                    else if (pedidosAnulables == null || !pedidosAnulables.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No se encontraron pedidos con ítems pendientes.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 40vh; overflow-y: auto;">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="table-dark">
                                    <tr>
                                        <th>N° Pedido</th>
                                        <th>N° O.C.</th>
                                        <th>Fecha Emisión</th>
                                        <th>N° Cliente</th>
                                        <th>Razón Social</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in pedidosAnulables)
                                    {
                                        <tr class="@(pedidoAnulSeleccionado?.NroPed == p.NroPed ? "table-primary" : "")">
                                            <td><strong>@p.NroPed</strong></td>
                                            <td>@p.NroOcom</td>
                                            <td>@p.FechEmis?.ToString("dd/MM/yyyy")</td>
                                            <td>@p.NroClie</td>
                                            <td>@p.RasoClie</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm @(pedidoAnulSeleccionado?.NroPed == p.NroPed ? "btn-primary" : "btn-outline-primary")"
                                                        @onclick="(() => SeleccionarPedidoAnulacionAsync(p))">
                                                    <i class="fas fa-check"></i> Seleccionar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @* Ítems pendientes del pedido seleccionado (misma query VB6 del
                       SELITPED: Status < 8, Status <> 3, CantEnt < CanPed - 0.005
                       y saldo >= 0.05). Cada fila tiene check para seleccionar y el
                       encabezado permite marcar todos; "Marcar Cumplidos" pone
                       PEDDETA.Status = 8 en los ítems tildados. *@
                    @if (pedidoAnulSeleccionado != null)
                    {
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="text-primary mb-0">
                                <i class="fas fa-list-ul me-2"></i>
                                Ítems pendientes del pedido N° @pedidoAnulSeleccionado.NroPed
                            </h6>
                            <button class="btn btn-danger btn-sm" @onclick="MarcarItemsCumplidosAsync"
                                    disabled="@(!itemsAnulSeleccionados.Any() || cargandoItemsAnul)"
                                    title="Marcar los ítems seleccionados como cumplidos (Status = 8)">
                                <i class="fas fa-check-double"></i> Marcar Cumplidos
                            </button>
                        </div>

                        @if (cargandoItemsAnul)
                        {
                            <div class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            </div>
                        }
                        else if (itemsAnulables == null || !itemsAnulables.Any())
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> El pedido no tiene ítems pendientes.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height: 30vh; overflow-y: auto;">
                                <table class="table table-striped table-sm">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 40px;">
                                                <input type="checkbox" class="form-check-input"
                                                       checked="@TodosItemsAnulSeleccionados"
                                                       @onchange="SeleccionarTodosItemsAnul"
                                                       title="Seleccionar todos" />
                                            </th>
                                            <th>Ítem</th>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            <th class="text-end">Cant. Pedida</th>
                                            <th class="text-end">Cant. Entregada</th>
                                            <th class="text-end">Saldo</th>
                                            <th>Fecha Entrega</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var it in itemsAnulables)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="form-check-input"
                                                           checked="@itemsAnulSeleccionados.Contains(it.NuOrItem ?? 0)"
                                                           @onchange="(e => ToggleItemAnul(it, e))" />
                                                </td>
                                                <td>@it.NuOrItem</td>
                                                <td>@it.CodiExt</td>
                                                <td>@it.Descrip</td>
                                                <td class="text-end">@((it.CanPed ?? 0m).ToString("N2"))</td>
                                                <td class="text-end">@((it.CantEnt ?? 0m).ToString("N2"))</td>
                                                <td class="text-end"><strong>@(((it.CanPed ?? 0m) - (it.CantEnt ?? 0m)).ToString("N2"))</strong></td>
                                                <td>@it.FeSolEnt?.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalAnularItems">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

