    /// <summary>
    /// Obtiene TODOS los pedidos que coincidan con los filtros actuales, sin paginación
    /// Utiliza los mismos filtros que LoadAsync pero sin límite de página
    /// </summary>
    private async Task<List<Pedenca>?> ObtenerTodosLosPedidosFiltrados()
    {
        try
        {
            // Construir parámetros de filtro idénticos a LoadAsync pero sin paginación
            var parametros = new List<string>();
            
            if (!string.IsNullOrEmpty(Filter))
            {
                parametros.Add($"filter={Filter}");
            }
            
            if (clienteSeleccionadoId.HasValue)
            {
                parametros.Add($"clienteId={clienteSeleccionadoId.Value}");
            }
            
            if (filtroNroPed.HasValue)
            {
                parametros.Add($"nroPed={filtroNroPed.Value}");
            }
            
            if (!string.IsNullOrEmpty(filtroEstado))
            {
                parametros.Add($"estado={filtroEstado}");
            }
            
            if (fechaDesde.HasValue)
            {
                parametros.Add($"fechaDesde={fechaDesde.Value:yyyy-MM-dd}");
            }
            
            if (fechaHasta.HasValue)
            {
                parametros.Add($"fechaHasta={fechaHasta.Value:yyyy-MM-dd}");
            }

            // Agregar parámetro para obtener todos los registros (sin paginación)
            parametros.Add("page=1");
            parametros.Add("recordsNumber=999999"); // Número muy alto para obtener todos los registros

            string queryParams = parametros.Count > 0 ? "&" + string.Join("&", parametros) : "";
            string url = $"api/pedenca?{queryParams.TrimStart('&')}";

            var responseHttp = await repository.Get<List<Pedenca>>(url);
            
            if (!responseHttp.Error)
            {
                return responseHttp.Response;
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron obtener los pedidos para impresión", SweetAlertIcon.Error);
                return new List<Pedenca>();
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al obtener pedidos: {ex.Message}", SweetAlertIcon.Error);
            return new List<Pedenca>();
        }
    }

    /// <summary>
    /// Confirma la impresión del listado de pedidos respetando filtros activos
    /// Obtiene TODOS los registros que coincidan con los filtros, no solo la página actual
    /// </summary>
    private async Task ConfirmarImpresionAsync()
    {
        isPrinting = true;
        StateHasChanged();

        try
        {
            // Obtener TODOS los pedidos que coincidan con los filtros actuales (sin paginación)
            var pedidosCompletos = await ObtenerTodosLosPedidosFiltrados();
            int cantidadTotal = pedidosCompletos?.Count ?? 0;

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmar impresión",
                Text = $"Se van a imprimir {cantidadTotal} registros que coinciden con los filtros aplicados (todas las páginas).\n¿Desea continuar?",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, imprimir",
                CancelButtonText = "Cancelar"
            });

            if (result.IsConfirmed)
            {
                // Actualizar la lista de pedidos para impresión con todos los registros
                pedidos = pedidosCompletos;
                mostrarModalImpresion = true;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Resetea el estado de impresión y cierra el modal
    /// Restaura la lista de pedidos original (paginada) después de la impresión
    /// </summary>
    private async void ResetearImpresion()
    {
        mostrarModalImpresion = false;
        
        // Restaurar la vista paginada original después de cerrar el modal de impresión
        await LoadAsync(currentPage);
        
        StateHasChanged();
    }

    /// <summary>
    /// Navega a la página de auditoría del pedido seleccionado
    /// Guarda los filtros actuales antes de navegar
    /// </summary>
    private void VerAuditoria(int nroPedido)
    {
        GuardarFiltros();
        navigationManager.NavigateTo($"/pedidos/auditoria/{nroPedido}");
    }

    /// <summary>
    /// Navega a la página de estadísticas de pedidos de venta
    /// Guarda los filtros actuales antes de navegar
    /// </summary>
    private void AbrirGraficos()
    {
        GuardarFiltros();
        navigationManager.NavigateTo("/estadisticas/pedidos");
    }

}
