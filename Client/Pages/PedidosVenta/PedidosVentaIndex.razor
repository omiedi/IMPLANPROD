    private async Task AbrirPedidosPendientesAsync()
    {
        mostrarModalPendientes = true;
        filtroPendFechaDesde = DateTime.Today.AddYears(-1);
        filtroPendFechaHasta = DateTime.Today;
        await CargarPendientesDetalleAsync();
    }

    private void CerrarModalPendientes()
    {
        mostrarModalPendientes = false;
    }

    private async Task CargarPendientesDetalleAsync()
    {
        cargandoPendientes = true;
        StateHasChanged();

        try
        {
            var parametros = new List<string>();

            if (filtroPendNroPed.HasValue)
            {
                parametros.Add($"nroPed={filtroPendNroPed.Value}");
            }

            if (!string.IsNullOrWhiteSpace(filtroPendCodigo))
            {
                parametros.Add($"codigo={Uri.EscapeDataString(filtroPendCodigo)}");
            }

            if (!string.IsNullOrWhiteSpace(filtroPendDescripcion))
            {
                parametros.Add($"descripcion={Uri.EscapeDataString(filtroPendDescripcion)}");
            }

            if (!string.IsNullOrWhiteSpace(filtroPendUMedida))
            {
                parametros.Add($"uMedida={Uri.EscapeDataString(filtroPendUMedida)}");
            }

            if (filtroPendFechaDesde.HasValue)
            {
                parametros.Add($"fechaEmisDesde={Uri.EscapeDataString(filtroPendFechaDesde.Value.ToString("yyyy-MM-dd"))}");
            }

            if (filtroPendFechaHasta.HasValue)
            {
                parametros.Add($"fechaEmisHasta={Uri.EscapeDataString(filtroPendFechaHasta.Value.ToString("yyyy-MM-dd"))}");
            }

            if (filtroPendCantSolMin.HasValue)
            {
                parametros.Add($"cantSolicitadaMin={Uri.EscapeDataString(filtroPendCantSolMin.Value.ToString())}");
            }

            if (filtroPendCantSolMax.HasValue)
            {
                parametros.Add($"cantSolicitadaMax={Uri.EscapeDataString(filtroPendCantSolMax.Value.ToString())}");
            }

            if (filtroPendCantEntMin.HasValue)
            {
                parametros.Add($"cantEntregadaMin={Uri.EscapeDataString(filtroPendCantEntMin.Value.ToString())}");
            }

            if (filtroPendCantEntMax.HasValue)
            {
                parametros.Add($"cantEntregadaMax={Uri.EscapeDataString(filtroPendCantEntMax.Value.ToString())}");
            }

            if (filtroPendSaldoMin.HasValue)
            {
                parametros.Add($"saldoMin={Uri.EscapeDataString(filtroPendSaldoMin.Value.ToString())}");
            }

            if (filtroPendSaldoMax.HasValue)
            {
                parametros.Add($"saldoMax={Uri.EscapeDataString(filtroPendSaldoMax.Value.ToString())}");
            }

            parametros.Add($"orderBy={Uri.EscapeDataString(ordenarPendientesPor)}");
            parametros.Add($"asc={(ordenarPendientesAsc ? "true" : "false")}");

            var url = "api/peddeta/pendientes-detalle";
            if (parametros.Any())
            {
                url += "?" + string.Join("&", parametros);
            }

            var resp = await repository.Get<List<PedidoVentaPendienteDetalleDTO>>(url);
            pendientesDetalle = resp.Response ?? new List<PedidoVentaPendienteDetalleDTO>();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar pedidos pendientes: {ex.Message}", SweetAlertIcon.Error);
            pendientesDetalle = new List<PedidoVentaPendienteDetalleDTO>();
        }
        finally
        {
            cargandoPendientes = false;
            StateHasChanged();
        }
    }

    private async Task OrdenarPendientesAsync(string campo)
    {
        if (ordenarPendientesPor == campo)
        {
            ordenarPendientesAsc = !ordenarPendientesAsc;
        }
        else
        {
            ordenarPendientesPor = campo;
            ordenarPendientesAsc = true;
        }

        await CargarPendientesDetalleAsync();
    }

    private async Task LimpiarFiltroPendientesAsync()
    {
        filtroPendNroPed = null;
        filtroPendCodigo = string.Empty;
        filtroPendDescripcion = string.Empty;
        filtroPendUMedida = string.Empty;
        filtroPendCantSolMin = null;
        filtroPendCantSolMax = null;
        filtroPendCantEntMin = null;
        filtroPendCantEntMax = null;
        filtroPendSaldoMin = null;
        filtroPendSaldoMax = null;
        await CargarPendientesDetalleAsync();
    }

    private async Task AplicarFiltroPendientesAsync()
    {
        await CargarPendientesDetalleAsync();
    }

    private string GetOrdenIcono(string campo)
    {
        if (ordenarPendientesPor != campo)
        {
            return "↕";
        }

        return ordenarPendientesAsc ? "▲" : "▼";
    }

