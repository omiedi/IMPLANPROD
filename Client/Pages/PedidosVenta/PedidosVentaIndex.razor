@page "/pedidos-venta"
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.DTOs.Impresiones
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Shared.Components
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Client.Pages.Reportes
@using Microsoft.AspNetCore.Components.Web
@inject IRepository repository
@inject HttpClient Http
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject FiltrosPedidosService filtrosService
@inject IJSRuntime JS
@inject PageAccessService PageAccess

<PageTitle>Pedidos de Venta</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
<div class="container-fluid">
    <!-- Título de la página -->
    <div class="mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="fas fa-file-invoice-dollar me-2"></i>
            PEDIDOS DE VENTA
        </h2>
    </div>
    <hr class="border-primary border-2 opacity-50" />

@if (mostrarModalPendientes)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" style="width: 80vw; max-width: 80vw;">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-clock"></i> Pedidos Pendientes
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalPendientes"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-12 text-end d-flex align-items-end justify-content-end gap-2">
                            @* Filtro por exclusión: si el N° de Cliente es > 0 se envía
                               excluirNroClie al backend (nroclie <> @n). Vacío o <= 0
                               no filtra (comportamiento anterior). *@
                            <div class="d-flex align-items-center gap-2 me-auto">
                                <label class="form-label mb-0 text-nowrap">No Mostrar pedidos de Cliente N°:</label>
                                <InputNumeroLimpio TValue="int?" @bind-Value="filtroPendExcluirNroClie"
                                                   Class="form-control form-control-sm" style="max-width: 120px;"
                                                   Placeholder="N° Cliente" />
                            </div>
                            <button class="btn btn-primary" @onclick="AplicarFiltroPendientesAsync" disabled="@cargandoPendientes">
                                <i class="fas fa-search"></i> Aplicar filtros
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltroPendientesAsync" disabled="@cargandoPendientes">
                                <i class="fas fa-eraser"></i> Limpiar
                            </button>
                            <button class="btn btn-outline-success" @onclick="ConfirmarImpresionPendientesAsync" disabled="@isPrintingPendientes">
                                <i class="oi oi-print"></i> Imprimir/Exp.Excel
                            </button>
                        </div>
                    </div>

                    @if (cargandoPendientes)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (pendientesDetalle == null || !pendientesDetalle.Any())
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i> No se encontraron pedidos pendientes.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.NroClie)))">
                                            N° Cliente <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.NroClie))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.Rasoclie)))">
                                            Razón Social <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.Rasoclie))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.Codigo)))">
                                            Código <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.Codigo))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.Descripcion)))">
                                            Descripción <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.Descripcion))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.NroPed)))">
                                            N° Pedido <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.NroPed))</span>
                                        </th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.CantSolicitada)))">
                                            Cant. Sol. <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.CantSolicitada))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.UMedida)))">
                                            U. Medida <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.UMedida))</span>
                                        </th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.CantEntregada)))">
                                            Cant. Ent. <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.CantEntregada))</span>
                                        </th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.Saldo)))">
                                            Saldo <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.Saldo))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarPendientesAsync(nameof(PedidoVentaPendienteDetalleDTO.FechaEntrega)))">
                                            Fecha Entrega <span class="ms-1">@GetOrdenIcono(nameof(PedidoVentaPendienteDetalleDTO.FechaEntrega))</span>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th>
                                            <input type="number" class="form-control form-control-sm" @bind="filtroPendNroClie" placeholder="N°" />
                                        </th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroPendRasoclie" placeholder="Razón Social" />
                                        </th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroPendCodigo" placeholder="Código" />
                                        </th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroPendDescripcion" placeholder="Descripción" />
                                        </th>
                                        <th>
                                            <input type="number" class="form-control form-control-sm" @bind="filtroPendNroPed" placeholder="N°" />
                                        </th>
                                        <th>
                                            <div class="d-flex gap-1">
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendCantSolMin" placeholder="Min" />
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendCantSolMax" placeholder="Max" />
                                            </div>
                                        </th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroPendUMedida" placeholder="U.M." />
                                        </th>
                                        <th>
                                            <div class="d-flex gap-1">
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendCantEntMin" placeholder="Min" />
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendCantEntMax" placeholder="Max" />
                                            </div>
                                        </th>
                                        <th>
                                            <div class="d-flex gap-1">
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendSaldoMin" placeholder="Min" />
                                                <input type="number" step="0.01" class="form-control form-control-sm" @bind="filtroPendSaldoMax" placeholder="Max" />
                                            </div>
                                        </th>
                                        <th>
                                            <div class="d-flex gap-1">
                                                <input type="date" class="form-control form-control-sm" @bind="filtroPendFechaDesde" />
                                                <input type="date" class="form-control form-control-sm" @bind="filtroPendFechaHasta" />
                                            </div>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var it in pendientesDetalle)
                                    {
                                        <tr>
                                            <td>@it.NroClie</td>
                                            <td>@it.Rasoclie</td>
                                            <td>@it.Codigo</td>
                                            <td>@it.Descripcion</td>
                                            <td><strong>@it.NroPed</strong></td>
                                            <td class="text-end">@it.CantSolicitada.ToString("N2")</td>
                                            <td>@it.UMedida</td>
                                            <td class="text-end">@it.CantEntregada.ToString("N2")</td>
                                            <td class="text-end"><strong>@it.Saldo.ToString("N2")</strong></td>
                                            <td>@(it.FechaEntrega?.ToString("dd/MM/yyyy") ?? "")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light sticky-bottom">
                                    <tr>
                                        <th colspan="5" class="text-end">Totales:</th>
                                        <th class="text-end">@TotalCantSolicitada.ToString("N2")</th>
                                        <th></th>
                                        <th class="text-end">@TotalCantEntregada.ToString("N2")</th>
                                        <th class="text-end">@TotalSaldo.ToString("N2")</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalPendientes">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (pendientesDetalle != null && pendientesDetalle.Any())
{
    <ImpresionLista TItem="PedidoVentaPendienteDetalleDTO"
                    Datos="pendientesDetalle"
                    Titulo="@TituloReportePendientes"
                    UrlExportarExcel="api/excel/exportar-pedidos-pendientes-detalle"
                    Encabezados="encabezadosPendientes"
                    ModoDirecto="false"
                    MostrarModal="mostrarModalImpresionPendientes"
                    OnCerrar="ResetearImpresionPendientes" />
}

@* ═══════════════════════════════════════════════════════════════════════
   Reporte "Entregas de Pedidos" (PEDDETA.CantEnt), opción del botón "Reportes".
   Mismo criterio de tabla/filtros/ordenamiento que "Pedidos Pendientes", pero
   mostrando ítems que tuvieron alguna entrega registrada, con Fecha, Código,
   Descripción, Cant. Pedida, Cant. Entregada y Saldo. Filtros: cliente, pedido
   y rango de fechas del pedido.
   ═══════════════════════════════════════════════════════════════════════ *@
@if (mostrarModalEntregas)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" style="width: 85vw; max-width: 85vw;">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-truck-loading"></i> Entregas de Pedidos
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEntregas"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Cliente:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" value="@filtroEntCliente" readonly placeholder="Todos los clientes" />
                                <button class="btn btn-outline-secondary" @onclick="LimpiarClienteEntregas">
                                    <i class="fas fa-times"></i>
                                </button>
                                <button class="btn btn-outline-primary" @onclick="AbrirSelectorClientesEntregas" title="Seleccionar Cliente">
                                    <i class="fas fa-users"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">N° Pedido:</label>
                            <input type="number" class="form-control" @bind="filtroEntNroPed" placeholder="N° Pedido" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Fecha Pedido Desde:</label>
                            <input type="date" class="form-control" @bind="filtroEntFechaDesde" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Fecha Pedido Hasta:</label>
                            <input type="date" class="form-control" @bind="filtroEntFechaHasta" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end gap-2">
                            <button class="btn btn-primary w-100" @onclick="AplicarFiltroEntregasAsync" disabled="@cargandoEntregas">
                                <i class="fas fa-search"></i> Aplicar
                            </button>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-12 text-end d-flex align-items-end justify-content-end gap-2">
                            @* Filtro por exclusión: si el N° de Cliente es > 0 se envía
                               excluirNroClie al backend (nroclie <> @n). Vacío o <= 0
                               no filtra (comportamiento anterior). *@
                            <div class="d-flex align-items-center gap-2 me-auto">
                                <label class="form-label mb-0 text-nowrap">No Mostrar pedidos de Cliente N°:</label>
                                <InputNumeroLimpio TValue="int?" @bind-Value="filtroEntExcluirNroClie"
                                                   Class="form-control form-control-sm" style="max-width: 120px;"
                                                   Placeholder="N° Cliente" />
                            </div>
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltroEntregasAsync" disabled="@cargandoEntregas">
                                <i class="fas fa-eraser"></i> Limpiar
                            </button>
                            <button class="btn btn-outline-success" @onclick="ConfirmarImpresionEntregasAsync" disabled="@isPrintingEntregas">
                                <i class="oi oi-print"></i> Imprimir/Exp.Excel
                            </button>
                        </div>
                    </div>

                    @if (cargandoEntregas)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (entregasDetalle == null || !entregasDetalle.Any())
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i> No se encontraron entregas de pedidos.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 60vh; overflow-y: auto;">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="table-dark sticky-top">
                                    <tr>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarEntregasAsync(nameof(PedidoVentaEntregaDetalleDTO.NroPed)))">
                                            N° Pedido <span class="ms-1">@GetOrdenIconoEntregas(nameof(PedidoVentaEntregaDetalleDTO.NroPed))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarEntregasAsync(nameof(PedidoVentaEntregaDetalleDTO.Fecha)))">
                                            Fecha <span class="ms-1">@GetOrdenIconoEntregas(nameof(PedidoVentaEntregaDetalleDTO.Fecha))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarEntregasAsync(nameof(PedidoVentaEntregaDetalleDTO.Cliente)))">
                                            Cliente <span class="ms-1">@GetOrdenIconoEntregas(nameof(PedidoVentaEntregaDetalleDTO.Cliente))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarEntregasAsync(nameof(PedidoVentaEntregaDetalleDTO.Codigo)))">
                                            Código <span class="ms-1">@GetOrdenIconoEntregas(nameof(PedidoVentaEntregaDetalleDTO.Codigo))</span>
                                        </th>
                                        <th style="cursor:pointer" @onclick="(() => OrdenarEntregasAsync(nameof(PedidoVentaEntregaDetalleDTO.Descripcion)))">
                                            Descripción <span class="ms-1">@GetOrdenIconoEntregas(nameof(PedidoVentaEntregaDetalleDTO.Descripcion))</span>
                                        </th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarEntregasAsync(nameof(PedidoVentaEntregaDetalleDTO.CanPed)))">
                                            Cant. Pedida <span class="ms-1">@GetOrdenIconoEntregas(nameof(PedidoVentaEntregaDetalleDTO.CanPed))</span>
                                        </th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarEntregasAsync(nameof(PedidoVentaEntregaDetalleDTO.CantEnt)))">
                                            Cant. Entregada <span class="ms-1">@GetOrdenIconoEntregas(nameof(PedidoVentaEntregaDetalleDTO.CantEnt))</span>
                                        </th>
                                        <th>N° Remito</th>
                                        <th class="text-end" style="cursor:pointer" @onclick="(() => OrdenarEntregasAsync(nameof(PedidoVentaEntregaDetalleDTO.Saldo)))">
                                            Saldo <span class="ms-1">@GetOrdenIconoEntregas(nameof(PedidoVentaEntregaDetalleDTO.Saldo))</span>
                                        </th>
                                    </tr>
                                    <tr>
                                        <th>
                                            <input type="number" class="form-control form-control-sm" @bind="filtroEntNroPed" placeholder="N°" />
                                        </th>
                                        <th></th>
                                        <th></th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroEntCodigo" placeholder="Código" />
                                        </th>
                                        <th>
                                            <input type="text" class="form-control form-control-sm" @bind="filtroEntDescripcion" placeholder="Descripción" />
                                        </th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var it in entregasDetalle)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@it.NroPed</strong>
                                                @* Pedido anulado (PEDENCA.Status >= 9): la fila se marca
                                                   con la etiqueta ANULADO *@
                                                @if (it.Anulado)
                                                {
                                                    <span class="badge bg-danger ms-1">ANULADO</span>
                                                }
                                            </td>
                                            <td>@(it.Fecha?.ToString("dd/MM/yyyy") ?? "")</td>
                                            <td>@it.Cliente</td>
                                            <td>@it.Codigo</td>
                                            <td>@it.Descripcion</td>
                                            <td class="text-end">@it.CanPed.ToString("N2")</td>
                                            <td class="text-end">@it.CantEnt.ToString("N2")</td>
                                            <td>
                                                @* Cada remito funciona como link: abre la vista impresa
                                                   del remito (PDF por plantilla REMITOCLIENTE) *@
                                                @if (it.RemitosDetalle?.Any() == true)
                                                {
                                                    @for (var i = 0; i < it.RemitosDetalle.Count; i++)
                                                    {
                                                        var r = it.RemitosDetalle[i];
                                                        <a href="javascript:void(0)" title="Ver remito impreso"
                                                           @onclick="() => ImprimirRemitoEntregaAsync(it, r)" @onclick:preventDefault>@r.Remito</a>@(i < it.RemitosDetalle.Count - 1 ? ", " : "")
                                                        @if (remitoEntregaImprimiendo == r.Remito)
                                                        {
                                                            <span class="spinner-border spinner-border-sm ms-1"></span>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    @it.Remito
                                                }
                                            </td>
                                            <td class="text-end"><strong>@it.Saldo.ToString("N2")</strong></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light sticky-bottom">
                                    <tr>
                                        <th colspan="5" class="text-end">Totales:</th>
                                        <th class="text-end">@TotalCanPedEntregas.ToString("N2")</th>
                                        <th class="text-end">@TotalCantEntEntregas.ToString("N2")</th>
                                        <th></th>
                                        <th class="text-end">@TotalSaldoEntregas.ToString("N2")</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEntregas">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (entregasDetalle != null && entregasDetalle.Any())
{
    <ImpresionLista TItem="PedidoVentaEntregaDetalleDTO"
                    Datos="entregasDetalle"
                    Titulo="@TituloReporteEntregas"
                    UrlExportarExcel="api/excel/exportar-pedidos-entregas-detalle"
                    Encabezados="encabezadosEntregas"
                    ModoDirecto="false"
                    MostrarModal="mostrarModalImpresionEntregas"
                    OnCerrar="ResetearImpresionEntregas" />
}

@* ═══════════════════════════════════════════════════════════════════════
   Reporte "PEDIDOS C/O.Compra x Fechas", opción del botón "Reportes".
   Lee directamente el encabezado PEDENCA (sin ir al detalle), filtrando por
   rango de fecha de emisión. Excluye siempre el cliente "998" (venta
   mostrador / genérico). Mismo criterio de modal/filtros/ordenamiento que
   "Pedidos Pendientes" y "Entregas de Pedidos".
   ═══════════════════════════════════════════════════════════════════════ *@
@if (mostrarModalOcom)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog" style="width: 80vw; max-width: 80vw;">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-file-contract"></i> Pedidos C/O.Compra x Fechas
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalOcom"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Cliente:</label>
                            <div class="input-group">
                                <input type="text" class="form-control" value="@filtroOcomCliente" readonly placeholder="Todos los clientes" />
                                <button class="btn btn-outline-secondary" @onclick="LimpiarClienteOcom">
                                    <i class="fas fa-times"></i>
                                </button>
                                <button class="btn btn-outline-primary" @onclick="AbrirSelectorClientesOcom" title="Seleccionar Cliente">
                                    <i class="fas fa-users"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">N° Pedido:</label>
                            <input type="number" class="form-control" @bind="filtroOcomNroPed" placeholder="N° Pedido" />
                        </div>
                        <div class="col-md-2">
