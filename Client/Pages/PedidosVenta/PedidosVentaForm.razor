    // ===== Resumen y Descuentos =====
    // Monto de descuento editable en $ y % (sincronizados)
    private decimal descuentoMonto = 0m;
    private decimal descuentoPorcentaje = 0m;

    // Total Neto calculado como suma(Cantidad * Precio)
    private decimal TotalNeto => productosPedido.Sum(p => p.Cantidad * p.Precio);

    // Total con descuento aplicado, no menor que 0
    private decimal TotalConDescuento => Math.Max(0m, TotalNeto - descuentoMonto);

    /// <summary>
    /// Propiedad intermediaria para el campo de texto de descuento.
    /// Cuando se modifica, actualiza pedido.TDescApli y recalcula automáticamente
    /// los valores de descuentoPorcentaje y descuentoMonto.
    /// </summary>
    private string DescuentoTexto
    {
        get => pedido.TDescApli ?? string.Empty;
        set
        {
            pedido.TDescApli = value;
            RecalcularDescuentoDesdeTexto();
        }
    }


    /// <summary>
    /// Handler cuando cambia el porcentaje de descuento. Actualiza el monto en $ en base al TotalNeto.
    /// </summary>
    private void ActualizarDesdePorcentaje(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var valor))
        {
            return;
        }
        // Limitar rango 0..100
        if (valor < 0) valor = 0;
        if (valor > 100) valor = 100;
        descuentoPorcentaje = valor;
        descuentoMonto = Math.Round(TotalNeto * (descuentoPorcentaje / 100m), 4);
        StateHasChanged();
    }

    /// <summary>
    /// Handler cuando cambia el monto de descuento. Actualiza el % en base al TotalNeto.
    /// </summary>
    private void ActualizarDesdeMonto(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var valor))
        {
            return;
        }
        // Limitar entre 0 y TotalNeto
        if (valor < 0) valor = 0;
        var total = TotalNeto;
        if (valor > total) valor = total;
        descuentoMonto = Math.Round(valor, 4);
        descuentoPorcentaje = total == 0m ? 0m : Math.Round((descuentoMonto / total) * 100m, 4);
        StateHasChanged();
    }

    /// <summary>
    /// Interpreta el texto de descuento ingresado en PEDENCA.TDescApli y recalcula
    /// descuentoPorcentaje y descuentoMonto sobre el TotalNeto actual.
    /// Reglas:
    /// - Si es vacío o texto no numérico: 0%.
    /// - Si es número (entero/decimal): se toma literal como %.
    /// - Si tiene forma "a + b + c": aplica descuentos sucesivos: base*(1-a%)*(1-b%)*(1-c%).
    /// </summary>
    private void RecalcularDescuentoDesdeTexto(ChangeEventArgs? e = null)
    {
        try
        {
            var texto = pedido.TDescApli?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(texto))
            {
                descuentoPorcentaje = 0m;
                descuentoMonto = 0m;
                StateHasChanged();
                return;
            }

            decimal baseNeto = TotalNeto;
            if (baseNeto <= 0m)
            {
                descuentoPorcentaje = 0m;
                descuentoMonto = 0m;
                StateHasChanged();
                return;
            }

            // Intentar número simple primero
            if (decimal.TryParse(texto, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var porcSimple))
            {
                if (porcSimple < 0) porcSimple = 0;
                if (porcSimple > 100) porcSimple = 100;
                descuentoPorcentaje = Math.Round(porcSimple, 4);
                descuentoMonto = Math.Round(baseNeto * (descuentoPorcentaje / 100m), 4);
                StateHasChanged();
                return;
            }

            // Intentar con expresiones separadas por '+'
            var partes = texto.Split('+', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (partes.Length > 1)
            {
                decimal acumulado = baseNeto;
                bool algunaParteValida = false;
                foreach (var parte in partes)
                {
                    var ptxt = parte.Replace(',', '.');
                    if (decimal.TryParse(ptxt, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var p))
                    {
                        if (p < 0) p = 0;
                        if (p > 100) p = 100;
                        acumulado = Math.Round(acumulado * (1m - (p / 100m)), 4);
                        algunaParteValida = true;
                    }
                }

                if (algunaParteValida)
                {
                    descuentoMonto = Math.Max(0m, baseNeto - acumulado);
                    descuentoPorcentaje = baseNeto == 0m ? 0m : Math.Round((descuentoMonto / baseNeto) * 100m, 4);
                    StateHasChanged();
                    return;
                }
            }

            // Si no se pudo interpretar: descuento 0
            descuentoPorcentaje = 0m;
            descuentoMonto = 0m;
            StateHasChanged();
        }
        catch
        {
            // En cualquier error, evitar lanzar excepciones a la UI y dejar descuento en 0
            descuentoPorcentaje = 0m;
            descuentoMonto = 0m;
            StateHasChanged();
        }
    }

