        localidadCliente = string.Empty;
        codigoPostalCliente = string.Empty;

        StateHasChanged();
    }

    /// <summary>
    /// Carga datos adicionales del cliente desde la tabla Deudor12
    /// </summary>
    private async Task CargarDatosCliente(int numeroCliente)
    {
        try
        {
            var responseHttp = await repository.Get<Deudor12>($"api/deudor12/numero/{numeroCliente}");

            if (!responseHttp.Error && responseHttp.Response != null)
            {
                var cliente = responseHttp.Response;

                // Cargar datos de Deudor12 para nuevos pedidos
                if (!IsEdit)
                {
                    domicilioCliente = cliente.Domi_Cli ?? string.Empty;
                    localidadCliente = cliente.Loca_Cli ?? string.Empty;
                    codigoPostalCliente = cliente.Cpos_Cli ?? string.Empty;
                }

                // Siempre actualizar el código de cliente (visible y readonly en UI)
                codigoCliente = cliente.Codi_Cli ?? string.Empty;
            }
            else
            {
                // Si no se encuentran datos del cliente, limpiar todos los casilleros
                if (!IsEdit)
                {
                    domicilioCliente = string.Empty;
                    localidadCliente = string.Empty;
                    codigoPostalCliente = string.Empty;

                    await sweetAlertService.FireAsync("Información", "No se encontraron datos adicionales para este cliente.", SweetAlertIcon.Info);
                }
            }
        }
        catch (Exception ex)
        {
            // En caso de error, limpiar los casilleros para nuevos pedidos
            if (!IsEdit)
            {
                domicilioCliente = string.Empty;
                localidadCliente = string.Empty;
                codigoPostalCliente = string.Empty;
            }

            await sweetAlertService.FireAsync("Error", $"Error al cargar datos del cliente: {ex.Message}", SweetAlertIcon.Error);
        }
    }


    /// <summary>
