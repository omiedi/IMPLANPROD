    /// <summary>
    /// Asigna VenRep según el motivo seleccionado: V para Venta (1), R para Reparación (2)
    /// </summary>
    private void AsignarVenRepSegunMotivo()
    {
        if (pedido.OV_Motivo.HasValue)
        {
            switch (pedido.OV_Motivo.Value)
            {
                case 1: // Venta
                    pedido.VenRep = "V";
                    break;
                case 2: // Reparación
                    pedido.VenRep = "R";
                    break;
                default:
                    pedido.VenRep = string.Empty;
                    break;
            }
        }
        else
        {
            pedido.VenRep = string.Empty;
        }
    }

