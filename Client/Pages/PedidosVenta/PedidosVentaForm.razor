    /// <summary>
    /// Evento que recibe el Master seleccionado desde el modal y lo agrega a la lista local
    /// </summary>
    private async void OnProductoSeleccionado(Master master)
    {
        // Mapeo básico: se pueden agregar más campos según necesidad
        productosPedido.Add(new ProductoPedido
        {
            CodInt = master.Codint,
            Codigo = master.Codigo,
            Descripcion = master.Descripcion,
            Unidad = master.Umedida ?? string.Empty,
            Cantidad = 1
        });
        StateHasChanged();

        // Recalcular descuento al cambiar el total neto
        RecalcularDescuentoDesdeTexto();

        // Si el ciclo sigue activo, reabrimos el modal para permitir agregar otro producto
        if (cicloSeleccionProductos && selectorProductosProd != null)
        {
            // Espera corta para permitir cerrar y re-renderizar antes de reabrir
            await Task.Delay(100);
            await selectorProductosProd.AbrirModal();
        }
    }

    /// <summary>
    /// Evento que recibe un producto con cantidad desde el SelectorProductos y lo agrega al detalle
    /// </summary>
    private async void OnProductoSeleccionadoCantidad(SelectorProductos.SeleccionProducto sel)
    {
        var p = sel.Producto;
        var cantidad = sel.Cantidad <= 0 ? 1 : sel.Cantidad;

        productosPedido.Add(new ProductoPedido
        {
            CodInt = p.Codint,
            Codigo = p.Codigo,
            Descripcion = p.Descripcion,
            Unidad = p.Umedida ?? string.Empty,
            Cantidad = cantidad,
            Precio = sel.Precio,
            CantidadEntregada = 0, // Productos nuevos no tienen entregas
            FechaEntrega = fechaEntrega, // Usar la fecha de entrega del encabezado por defecto
            EsItemNuevo = IsEdit // Si estamos en edición, es un item nuevo
        });

        StateHasChanged();

        // Recalcular descuento al cambiar el total neto
        RecalcularDescuentoDesdeTexto();

        if (cicloSeleccionProductos && selectorProductosProd != null)
        {
            await Task.Delay(100);
            await selectorProductosProd.AbrirModal();
        }
    }

