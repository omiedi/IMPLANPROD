    /// <summary>
    /// Maneja el cambio de transporte y actualiza TranspEnt automáticamente
    /// </summary>
    private void OnTransporteChanged()
    {
        if (pedido.NTranspo.HasValue)
        {
            // Buscar el transporte seleccionado y asignar su denominación a TranspEnt
            var transporteSeleccionado = transportes?.FirstOrDefault(t => t.Codi_Tra == pedido.NTranspo.Value);
            pedido.TranspEnt = transporteSeleccionado?.Deno_Tra ?? string.Empty;
        }
        else
        {
            pedido.TranspEnt = string.Empty;
        }
    }

