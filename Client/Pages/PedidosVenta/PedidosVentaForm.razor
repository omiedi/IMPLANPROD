    /// <summary>
    /// Convierte los precios de todos los items cuando se cambia la moneda
    /// </summary>
    /// <param name="monedaOrigen">Código de moneda origen</param>
    /// <param name="monedaDestino">Código de moneda destino</param>
    private async Task ConvertirPreciosMonedaAsync(int monedaOrigen, int monedaDestino)
    {
        try
        {
            if (monedaOrigen == monedaDestino || !productosPedido.Any())
                return;

            // Obtener cotizaciones
            var cotizacionOrigen = await ObtenerCotizacionMonedaAsync(monedaOrigen);
            var cotizacionDestino = await ObtenerCotizacionMonedaAsync(monedaDestino);

            // Convertir precios de cada item
            foreach (var item in productosPedido)
            {
                // Convertir precio
                if (item.Precio > 0)
                {
                    // Convertir a pesos (moneda base) y luego a la moneda destino
                    var precioEnPesos = item.Precio * cotizacionOrigen;
                    item.Precio = Math.Round(precioEnPesos / cotizacionDestino, 4);
                }

                // Recalcular importe total (se calcula automáticamente por la propiedad ImporteTotal)
                // No es necesario asignar manualmente ya que es una propiedad calculada
            }

            // Recalcular descuentos basados en el nuevo total
            RecalcularDescuentoDesdeTexto();

            // Marcar cambios
            cambiosService.MarcarCambios();
            StateHasChanged();

            // Mostrar mensaje de confirmación
            var monedaOrigenNombre = monedas?.FirstOrDefault(m => m.CodigoMoneda == monedaOrigen)?.Descripcion ?? "Desconocida";
            var monedaDestinoNombre = monedas?.FirstOrDefault(m => m.CodigoMoneda == monedaDestino)?.Descripcion ?? "Desconocida";

            await sweetAlertService.FireAsync(
                "Conversión Realizada", 
                $"Los precios han sido convertidos de {monedaOrigenNombre} a {monedaDestinoNombre}", 
                SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al convertir precios: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Obtiene la cotización de una moneda específica
    /// </summary>
    /// <param name="codigoMoneda">Código de la moneda</param>
    /// <returns>Cotización de la moneda</returns>
    private async Task<decimal> ObtenerCotizacionMonedaAsync(int codigoMoneda)
    {
        try
        {
            var moneda = monedas?.FirstOrDefault(m => m.CodigoMoneda == codigoMoneda);
            return moneda?.Cotizacion ?? 1;
        }
        catch
        {
            return 1; // Cotización por defecto
        }
    }

    /// <summary>
    /// Inicialización del componente
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Limpiar estado de cambios al inicializar
        cambiosService.LimpiarEstado();

        // Cargar condiciones de pago y vendedores
        await CargarCondicionesPago();
        await CargarVendedores();
        await CargarMonedas();
        await CargarTransportes();

        // Configurar fechas
        fechaEmision = pedido.FechEmis ?? DateTime.Now;
        fechaEntrega = pedido.FeSolEnt;

        // Si es un nuevo pedido, establecer valores por defecto
        if (!IsEdit)
        {
            pedido.FechEmis = DateTime.Now;
            pedido.Status = 1; // Estado activo
                               // pedido.CodiEmpr = 1; // Empresa por defecto
            pedido.OV_Motivo = 1; // Motivo por defecto: Venta

            // Asignar VenRep según el motivo seleccionado
            AsignarVenRepSegunMotivo();

            // Establecer moneda por defecto solo para pedidos nuevos
            await EstablecerMonedaPorDefecto();

            // En nuevos pedidos, los campos de cliente están vacíos
            domicilioCliente = string.Empty;
            localidadCliente = string.Empty;
            codigoPostalCliente = string.Empty;
        }
        else
        {
            // En edición, cargar datos desde el pedido existente
            if (!string.IsNullOrEmpty(pedido.RasoClie))
            {
                clienteSeleccionado = $"{pedido.NroClie} - {pedido.RasoClie}";
            }

            // Cargar domicilio y localidad desde el pedido
            domicilioCliente = pedido.DomiEnt ?? string.Empty;
            localidadCliente = pedido.LocaEnt ?? string.Empty;
            codigoPostalCliente = string.Empty; // Código postal vacío en edición como solicitado



            // Además, si tenemos NroClie en edición, obtener el código de cliente desde Deudor12
            if (pedido.NroClie.HasValue)
            {
                _ = CargarDatosCliente(pedido.NroClie.Value);
            }

            // Cargar detalle desde PEDDETA para mostrarlo como en creación
            await CargarDetalleEdicionAsync();
        }
    }

