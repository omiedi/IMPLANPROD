    /// <summary>
    /// Quita un producto del detalle local con validaciones para edición
    /// </summary>
    private async Task QuitarProducto(ProductoPedido det)
    {
        // Validar si tiene cantidad entregada en modo edición
        if (IsEdit && det.CantidadEntregada > 0)
        {
            await sweetAlertService.FireAsync(
                "No se puede eliminar", 
                $"Este item tiene {det.CantidadEntregada:F4} unidades entregadas. No se puede eliminar.\n\nSugerencia: Marque el item como cumplido en lugar de eliminarlo.", 
                SweetAlertIcon.Warning);
            return;
        }

        // Confirmar eliminación
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar eliminación",
            Text = $"¿Está seguro de eliminar el item {det.Codigo} - {det.Descripcion}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            productosPedido.Remove(det);
            // Recalcular descuento al cambiar el total neto
            RecalcularDescuentoDesdeTexto();
            StateHasChanged();
        }
    }

