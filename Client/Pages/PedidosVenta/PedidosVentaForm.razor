    /// <summary>
    /// Carga el detalle del pedido desde PEDDETA cuando el formulario está en modo edición.
    /// Mapea los ítems a la lista local productosPedido para que el usuario pueda modificar cantidades/precios.
    /// </summary>
    private async Task CargarDetalleEdicionAsync()
    {   
        try
        {
            if (pedido.NroPed is null || pedido.NroPed <= 0)
            {
                return;
            }

            var responseHttp = await repository.Get<List<Peddeta>?>($"api/pedenca/detalle/{pedido.NroPed}");
            if (!responseHttp.Error && responseHttp.Response != null)
            {    

                productosPedido.Clear();
                foreach (var d in responseHttp.Response)
                {
                    productosPedido.Add(new ProductoPedido
                    {
                        CodInt = d.CodiInt ?? 0,
                        Codigo = d.CodiExt ?? string.Empty,
                        Descripcion = d.Descrip ?? string.Empty,
                        Cantidad = d.CanPed ?? 0,
                        Precio = d.PreUnid ?? 0,
                        Unidad = string.Empty,
                        CantidadEntregada = d.CantEnt ?? 0,
                        FechaEntrega = d.FeSolEnt,
                        EsItemNuevo = false, // Items existentes
                        });
                }
                
                // Recalcular descuento según el texto literal cargado en el encabezado
                RecalcularDescuentoDesdeTexto();
                
                // Establecer TranspEnt basado en NTranspo si no está ya establecido
                if (pedido.NTranspo.HasValue && string.IsNullOrEmpty(pedido.TranspEnt))
                {
                    var transporteSeleccionado = transportes?.FirstOrDefault(t => t.Codi_Tra == pedido.NTranspo.Value);
                    pedido.TranspEnt = transporteSeleccionado?.Deno_Tra ?? string.Empty;
                }
                // Verificar y mantener la moneda del pedido existente desde el primer item del detalle
                if (responseHttp.Response.Any())
                {
                    var primerItem = responseHttp.Response.First();
                    
                    // Tomar la moneda y tipo de cambio del primer item del detalle (todos son iguales en un pedido)
                    if (primerItem.MoneEmis.HasValue && primerItem.MoneEmis > 0)
                    {
                        pedido.MoneEmis = primerItem.MoneEmis;
                        pedido.TipoCam = primerItem.TipoCam ?? 1;
                        Console.WriteLine($"Pedido en edición - Moneda cargada desde PEDDETA: {pedido.MoneEmis}, TipoCam: {pedido.TipoCam}");
                    }
                    else
                    {
                        // Si no tiene moneda en el detalle, usar pesos por defecto
                        await EstablecerMonedaPorDefecto();
                        Console.WriteLine($"Moneda no establecida en PEDDETA, usando por defecto: {pedido.MoneEmis}");
                    }
                }
                else
                {
                    // Si no hay items en el detalle, usar pesos por defecto
                    await EstablecerMonedaPorDefecto();
                    Console.WriteLine($"Sin items en detalle, usando moneda por defecto: {pedido.MoneEmis}");
                }
            }
            else if (responseHttp.Error)
            {
                var msg = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"No se pudo cargar el detalle del pedido: {msg}", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar el detalle del pedido: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Construye el DTO PedidoVentaUpdateDTO y envía la actualización completa (encabezado + detalle)
    /// al endpoint api/pedenca/editar-con-detalle.
    /// </summary>
    private async Task EditarPedidoConDetalleAsync()
    {
        try
        {
            if (pedido.NroPed is null || pedido.NroPed <= 0)
            {
                await sweetAlertService.FireAsync("Datos inválidos", "El número de pedido es inválido.", SweetAlertIcon.Warning);
                return;
            }

            if (pedido.NroClie is null || string.IsNullOrWhiteSpace(pedido.RasoClie))
            {
                await sweetAlertService.FireAsync("Datos incompletos", "Debe seleccionar un cliente.", SweetAlertIcon.Warning);
                return;
            }
            if (pedido.CondPag is null || pedido.Vended is null)
            {
                await sweetAlertService.FireAsync("Datos incompletos", "Condición de pago y vendedor son obligatorios.", SweetAlertIcon.Warning);
                return;
            }
            if (productosPedido.Count == 0)
            {
                await sweetAlertService.FireAsync("Detalle vacío", "Debe existir al menos un producto en el pedido.", SweetAlertIcon.Warning);
                return;
            }

            // Validar cantidades en edición: no pueden ser menores a las entregadas
            foreach (var item in productosPedido)
            {
                if (item.Cantidad < item.CantidadEntregada)
                {
                    await sweetAlertService.FireAsync(
                        "Cantidad inválida", 
                        $"El item {item.Codigo} - {item.Descripcion} tiene una cantidad ({item.Cantidad:F4}) menor a la cantidad ya entregada ({item.CantidadEntregada:F4}).\n\nDebe ingresar una cantidad igual o mayor a la entregada.", 
                        SweetAlertIcon.Warning);
                    return;
                }
            }

            // Determinar motivo (VenRep) desde encabezado
            string? motivoTexto = pedido.OV_Motivo switch
            {
                1 => "V",
                2 => "R",
                _ => pedido.VenRep
            };

            var dto = new PedidoVentaUpdateDTO
            {
                NroPed = pedido.NroPed.Value,
                FeSolEnt = fechaEntrega,
                NroClie = pedido.NroClie!.Value,
                RasoClie = pedido.RasoClie ?? string.Empty,
                NroOcom = pedido.NroOcom,
                CondPag = pedido.CondPag!.Value,
                Vended = pedido.Vended!.Value,
                PorComVend = pedido.PorComVend,
                ListPre = (short)(pedido.ListPre ?? 1),
                // Guardamos literal lo ingresado por el usuario en PEDENCA.TDescApli
                TDescApli = pedido.TDescApli?.Trim(),
                Motivo = motivoTexto,
                MoneEmis = pedido.MoneEmis,
                TipoCam = pedido.TipoCam,
                NTranspo = pedido.NTranspo,
                TranspEnt = pedido.TranspEnt,
                Items = new()
            };

            short orden = 1;
            foreach (var det in productosPedido)
            {
                dto.Items.Add(new PedidoVentaItemDTO
                {
                    NuOrItem = orden++,
                    CodiInt = det.CodInt,
                    CodiExt = det.Codigo,
                    SubCod = string.Empty,
                    Descrip = det.Descripcion,
                    TColor = string.Empty,
                    TTalle = string.Empty,
                    TLargo = 0,
                    TAncho = 0,
                    TEspesor = 0,
                    VenRep = motivoTexto,
                    MoneEmis = pedido.MoneEmis,
                    TipoCam = pedido.TipoCam,
                    ListaDeItem = 1,
                    PreList = det.Precio,
                    CanAsig = det.Cantidad,
                    CanPed = det.Cantidad,
                    PreUnid = det.Precio,
                    ImpoTot = det.Cantidad * det.Precio,
                    NumeroSerie = string.Empty,
                    ObservaItem = string.Empty,
                    SinCargo = 0,
                    FeSolEnt = det.FechaEntrega
                });
            }

            var response = await repository.Put("api/pedenca/editar-con-detalle", dto);
            if (response.Error)
            {
                var msg = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                return;
            }

            // Éxito - marcar como guardado
            cambiosService.MarcarGuardado();
            await sweetAlertService.FireAsync("Confirmación", "Pedido actualizado exitosamente.", SweetAlertIcon.Success);
            NavigationManager.NavigateTo("/pedidos-venta");
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error inesperado", ex.Message, SweetAlertIcon.Error);
        }
    }
    /// <summary>
    /// Establece la moneda por defecto (PESOS con código 1 y tipo de cambio 1)
    /// </summary>
    private async Task EstablecerMonedaPorDefecto()
    {
        try
        {
            // Buscar la moneda PESOS (código 1) en la lista de monedas
            var monedaPesos = monedas?.FirstOrDefault(m => m.CodigoMoneda == 1);

            if (monedaPesos != null)
            {
                // Establecer PESOS como moneda por defecto
                pedido.MoneEmis = Convert.ToInt16(monedaPesos.CodigoMoneda);
                pedido.TipoCam = monedaPesos.Cotizacion;
            }
            else
            {
                // Si no se encuentra PESOS, establecer valores por defecto
                pedido.MoneEmis = 1; // Código 1 para PESOS
                pedido.TipoCam = 1; // Tipo de cambio 1
            }
        }
        catch (Exception ex)
        {
            // En caso de error, establecer valores por defecto
            pedido.MoneEmis = 1;
            pedido.TipoCam = 1;
            await sweetAlertService.FireAsync("Advertencia", $"Se estableció la moneda por defecto debido a un error: {ex.Message}", SweetAlertIcon.Warning);
        }
    }
    /// <summary>
    /// Propiedad que maneja la selección de moneda en el combo desplegable.
    /// Actúa como intermediario entre el InputSelect y el modelo pedido.
    /// Cuando se selecciona una moneda, automáticamente actualiza el tipo de cambio correspondiente.
    /// </summary>
    private int CodigoMonedaSeleccionado
    {
        // Getter: Devuelve el código de moneda actualmente seleccionado
        get => pedido.MoneEmis ?? 0;
        set
        {
            // Guardar moneda anterior para conversión
            var monedaAnterior = pedido.MoneEmis ?? 1;
            
            // Setter: Actualiza el código de moneda en el modelo
            pedido.MoneEmis = checked((short)value);

            // Si se seleccionó una moneda válida (mayor a 0)
            if (value > 0)
            {
                // Busca la moneda completa en la lista para obtener su cotización
                var moneda = monedas?.FirstOrDefault(m => m.CodigoMoneda == value);
                // Actualiza el tipo de cambio en el modelo
                pedido.TipoCam = moneda?.Cotizacion ?? 1;
                
                // Si es un pedido existente y cambió la moneda, convertir precios
                if (IsEdit && monedaAnterior != value && productosPedido.Any())
                {
                    _ = ConvertirPreciosMonedaAsync(monedaAnterior, value);
                }
            }
            else
            {
                // Si no se seleccionó ninguna moneda válida, establece tipo de cambio en 1
                pedido.TipoCam = 1;
            }
        }
    }
    /// <summary>
    /// Carga las monedas activas desde la API usando el patrón repository
    /// </summary>
    private async Task CargarMonedas()
    {
        try
        {
            var responseHttp = await repository.Get<List<Tamoned>>("/api/tamoneds/combo");
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                monedas = responseHttp.Response;
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "Error al cargar las monedas disponibles.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar monedas: {ex.Message}", SweetAlertIcon.Error);
        }
    }
    /// <summary>
    /// Carga las monedas activas desde la API usando el patrón repository
    /// </summary>
    private async Task CargarTransportes()
    {
        try
