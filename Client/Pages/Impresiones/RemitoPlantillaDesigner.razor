@code {
    private readonly RemitoPlantillaUpsertDto modelo = new();
    private readonly List<RemitoPlantillaItemDto> plantillas = new();

    private List<DatasetItemDto> datasetItems = CreateDefaultDatasetItems();
    private readonly List<ParameterItemDto> parameters = new() { new() { Name = "Doprilar", Value = "rt-x-0001-0002020" } };
    private static readonly string[] FontOptions = { "Arial", "Calibri", "Courier New", "Times New Roman", "Verdana", "Tahoma", "Segoe UI" };
    private readonly JsonSerializerOptions jsonOptions = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    private LienzoDesignDto design = CreateDefaultDesign();
    private string? selectedElementId;
    private readonly HashSet<string> selectedElementIds = new(StringComparer.Ordinal);
    private const string CodePresetCodigoLoteVencimiento = "COD: {{HeaderMovisto.CODIGO}} | LOTE: {{HeaderMovisto.LOTE}} | VTO: {{HeaderMovisto.VENCIMIENTO}}";
    private readonly HashSet<string> dragSelectionIds = new(StringComparer.Ordinal);
    private bool isDragging;
    private double lastClientX;
    private double lastClientY;
    private double pxPerMm = 3;
    private bool showPropertiesModal;
    private LienzoElementDto? copiedElement;
    private bool showPdfOverlay;
    private string? pdfPreviewDataUrl;
    private double pdfPreviewPxPerMm = 3;

    private bool cargandoListado;
    private bool guardando;
    private string? errorPreview;
    private RemitoPlantillaPreviewResultDto? preview;
    private int selectedTemplateCopyId;

    protected override async Task OnInitializedAsync()
    {
        LoadDesignFromModelo();

        await CargarListado();
    }

    private async Task CargarListado()
    {
        cargandoListado = true;
        try
        {
            var response = await repository.Get<List<RemitoPlantillaItemDto>>("api/impresiones/remito-plantillas");
            plantillas.Clear();
            if (!response.Error && response.Response != null)
            {
                plantillas.AddRange(response.Response);
                if (selectedTemplateCopyId > 0 && !plantillas.Any(x => x.Id == selectedTemplateCopyId))
                {
                    selectedTemplateCopyId = 0;
                }
            }
        }
        finally
        {
            cargandoListado = false;
        }
    }

    private async Task VerPdfConReglaAsync()
    {
        var (ok, response) = await ObtenerPdfResponseAsync();
        if (!ok || response?.Response == null)
        {
            return;
        }

        pdfPreviewPxPerMm = pxPerMm;
        var base64 = Convert.ToBase64String(response.Response);
        pdfPreviewDataUrl = $"data:application/pdf;base64,{base64}#toolbar=0&navpanes=0&scrollbar=0&zoom=page-width";
        showPdfOverlay = true;
    }

    private void ClosePdfOverlay()
    {
        showPdfOverlay = false;
        pdfPreviewDataUrl = null;
    }

    private async Task CargarPlantilla(int id)
    {
        var response = await repository.Get<RemitoPlantillaDetailDto>($"api/impresiones/remito-plantillas/{id}");
        if (response.Error || response.Response == null)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        var data = response.Response;
        selectedTemplateCopyId = data.Id;
        ApplyLoadedTemplate(data);
    }

    private async Task NuevaPlantillaPorCopiaAsync()
    {
        if (selectedTemplateCopyId <= 0)
        {
            await sweetAlertService.FireAsync("Atención", "Selecciona una plantilla para copiar.", SweetAlertIcon.Warning);
            return;
        }

        var selectedName = plantillas.FirstOrDefault(x => x.Id == selectedTemplateCopyId)?.Nombre ?? "plantilla";
        var confirmResult = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = $"Se creará y guardará automáticamente una copia de '{selectedName}'. ¿Deseas continuar?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, crear copia",
            CancelButtonText = "Cancelar"
        });

        var confirm = !string.IsNullOrEmpty(confirmResult.Value);
        if (!confirm)
        {
            return;
        }

        guardando = true;
        try
        {
            var sourceResponse = await repository.Get<RemitoPlantillaDetailDto>($"api/impresiones/remito-plantillas/{selectedTemplateCopyId}");
            if (sourceResponse.Error || sourceResponse.Response == null)
            {
                var message = await sourceResponse.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            var source = sourceResponse.Response;
            var copyName = $"Copia de {source.Nombre}";
            var copyDto = new RemitoPlantillaUpsertDto
            {
                Id = 0,
                Nombre = copyName,
                LienzoJson = source.LienzoJson,
                Datasets = (source.Datasets ?? new List<RemitoPlantillaDatasetDto>())
                    .Select(x => new RemitoPlantillaDatasetDto
                    {
                        Key = x.Key,
                        Sql = x.Sql,
                        MaxRows = x.MaxRows > 0 ? x.MaxRows : 500
                    })
                    .ToList(),
                Parameters = (source.Parameters ?? new List<RemitoPlantillaParameterDto>())
                    .Select(x => new RemitoPlantillaParameterDto { Name = x.Name, Value = x.Value })
                    .ToList()
            };

            var saveResponse = await repository.Post<RemitoPlantillaUpsertDto, int>("api/impresiones/remito-plantillas", copyDto);
            if (saveResponse.Error)
            {
                var message = await saveResponse.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            var newTemplateData = new RemitoPlantillaDetailDto
            {
                Id = saveResponse.Response,
                Nombre = copyName,
                LienzoJson = source.LienzoJson,
                Datasets = copyDto.Datasets,
                Parameters = copyDto.Parameters
            };

            ApplyLoadedTemplate(newTemplateData);
            selectedTemplateCopyId = newTemplateData.Id;
            await CargarListado();
            await sweetAlertService.FireAsync("Ok", $"Copia creada: {copyName}", SweetAlertIcon.Success);
        }
        finally
        {
            guardando = false;
        }
    }

    private void NuevaPlantilla()
    {
        modelo.Id = 0;
        modelo.Nombre = string.Empty;
        datasetItems = CreateDefaultDatasetItems();
        parameters.Clear();
        parameters.Add(new ParameterItemDto { Name = "Doprilar", Value = "rt-x-0001-0002020" });
        design = CreateDefaultDesign();
        SelectOnly(design.Elements.FirstOrDefault()?.Id);
        SyncModelLienzoJson();
        preview = null;
        errorPreview = null;
    }

    private void ApplyLoadedTemplate(RemitoPlantillaDetailDto data)
    {
        modelo.Id = data.Id;
        modelo.Nombre = data.Nombre;
        modelo.LienzoJson = data.LienzoJson;
        LoadDesignFromModelo();

        datasetItems = (data.Datasets ?? new List<RemitoPlantillaDatasetDto>())
            .Select(x => new DatasetItemDto
            {
                Key = x.Key,
                Sql = x.Sql,
                MaxRows = x.MaxRows > 0 ? x.MaxRows : 500
            })
            .ToList();

        if (datasetItems.Count == 0)
        {
            datasetItems = CreateDefaultDatasetItems();
        }

        parameters.Clear();
        if (data.Parameters?.Any() == true)
        {
            parameters.AddRange(data.Parameters.Select(p => new ParameterItemDto { Name = p.Name, Value = p.Value }));
        }
        else
        {
            parameters.Add(new ParameterItemDto { Name = "Doprilar", Value = "rt-x-0001-0002020" });
        }
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        try
        {
            if (!TryBuildDatasets(out var datasets, out var datasetError))
            {
                await sweetAlertService.FireAsync("Atención", datasetError, SweetAlertIcon.Warning);
                return;
            }

            SyncModelLienzoJson();
            modelo.Datasets = datasets;
            modelo.Parameters = BuildParameters();
            var response = await repository.Post<RemitoPlantillaUpsertDto, int>("api/impresiones/remito-plantillas", modelo);
            if (response.Error)
            {
                var message = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            modelo.Id = response.Response;
            await CargarListado();
            await sweetAlertService.FireAsync("Ok", "Plantilla guardada correctamente", SweetAlertIcon.Success);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task PreviewAsync()
    {
        guardando = true;
        errorPreview = null;
        preview = null;

        try
        {
            if (!TryBuildDatasets(out var datasets, out var datasetError))
            {
                errorPreview = datasetError;
                return;
            }

            var request = new RemitoPlantillaPreviewRequestDto
            {
                LienzoJson = JsonSerializer.Serialize(design, jsonOptions),
                Datasets = datasets,
                Parameters = BuildParameters()
            };

            var response = await repository.Post<RemitoPlantillaPreviewRequestDto, RemitoPlantillaPreviewResultDto>(
                "api/impresiones/remito-plantillas/preview",
                request);

            if (response.Error)
            {
                errorPreview = await response.GetErrorMessageAsync();
                return;
            }

            preview = response.Response;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GenerarPdfAsync()
    {
        var (ok, response) = await ObtenerPdfResponseAsync();
        if (!ok || response?.Response == null)
        {
            return;
        }

        var fileName = response.HttpResponseMessage.Content.Headers.ContentDisposition?.FileNameStar
                       ?? response.HttpResponseMessage.Content.Headers.ContentDisposition?.FileName
                       ?? $"Remito_{GetParameterValue("Doprilar") ?? "sin-numero"}.pdf";
        fileName = fileName.Replace("\"", string.Empty);

        var base64 = Convert.ToBase64String(response.Response);
        var okJs = await JSRuntime.InvokeAsync<bool>("saveAsFile", fileName, base64);
        if (!okJs)
        {
            await sweetAlertService.FireAsync("Atención", "No se pudo iniciar la descarga del PDF.", SweetAlertIcon.Warning);
        }
    }

    private async Task VerPdfAsync()
    {
        var (ok, response) = await ObtenerPdfResponseAsync();
        if (!ok || response?.Response == null)
        {
            return;
        }

        var base64 = Convert.ToBase64String(response.Response);
        var okJs = await JSRuntime.InvokeAsync<bool>("openPdfInNewTab", base64);
        if (!okJs)
        {
            await sweetAlertService.FireAsync("Atención", "No se pudo abrir el PDF en una nueva pestaña. Verificá el bloqueador de pop-ups.", SweetAlertIcon.Warning);
        }
    }

    private async Task ImprimirPaginaMilimetradaAsync()
    {
        guardando = true;
        try
        {
            var orientation = string.Equals(design.Orientation, "Landscape", StringComparison.OrdinalIgnoreCase)
                ? "Landscape"
                : "Portrait";

            var response = await repository.GetBytes($"api/impresiones/remito-plantillas/pdf/milimetrada?orientation={Uri.EscapeDataString(orientation)}");
            if (response.Error || response.Response == null)
            {
                var message = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            var base64 = Convert.ToBase64String(response.Response);
            var okJs = await JSRuntime.InvokeAsync<bool>("openPdfInNewTab", base64);
            if (!okJs)
            {
                await sweetAlertService.FireAsync("Atención", "No se pudo abrir la página milimetrada. Verificá el bloqueador de pop-ups.", SweetAlertIcon.Warning);
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task<(bool Ok, HttpResponseWrapper<byte[]>? Response)> ObtenerPdfResponseAsync()
    {
        if (modelo.Id <= 0)
        {
            await sweetAlertService.FireAsync("Atención", "Primero debes guardar la plantilla.", SweetAlertIcon.Warning);
            return (false, null);
        }

        var doprilar = GetParameterValue("Doprilar");
        if (string.IsNullOrWhiteSpace(doprilar))
        {
            await sweetAlertService.FireAsync("Atención", "El parámetro Doprilar es obligatorio.", SweetAlertIcon.Warning);
            return (false, null);
        }

        guardando = true;
        try
        {
            var queryParams = BuildParameters();
            var query = string.Join("&", queryParams
                .Where(x => !string.IsNullOrWhiteSpace(x.Name))
                .Select(x => $"{Uri.EscapeDataString(x.Name)}={Uri.EscapeDataString(x.Value ?? string.Empty)}"));

            var url = $"api/impresiones/remito-plantillas/{modelo.Id}/pdf";
            if (!string.IsNullOrWhiteSpace(query))
            {
                url += $"?{query}";
            }

            var response = await repository.GetBytes(url);
            if (response.Error || response.Response == null)
            {
                var message = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return (false, response);
            }

            return (true, response);
        }
        finally
        {
            guardando = false;
        }
    }

    private bool TryBuildDatasets(out List<RemitoPlantillaDatasetDto> datasets, out string error)
    {
        // Reglas claras para evitar errores de backend:
        // - al menos un dataset
        // - key y sql obligatorios
        // - key único (case-insensitive)
        datasets = datasetItems
            .Where(x => !string.IsNullOrWhiteSpace(x.Key) || !string.IsNullOrWhiteSpace(x.Sql))
            .Select(x => new RemitoPlantillaDatasetDto
            {
                Key = x.Key.Trim(),
                Sql = x.Sql,
                MaxRows = x.MaxRows > 0 ? x.MaxRows : 500
            })
            .ToList();

        if (datasets.Count == 0)
        {
            error = "Debes indicar al menos un dataset con Key y SQL.";
            return false;
        }

        if (datasets.Any(x => string.IsNullOrWhiteSpace(x.Key) || string.IsNullOrWhiteSpace(x.Sql)))
        {
            error = "Todos los datasets deben tener Key y SQL.";
            return false;
        }

        var duplicate = datasets
            .GroupBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
            .FirstOrDefault(g => g.Count() > 1);

        if (duplicate != null)
        {
            error = $"La Key '{duplicate.Key}' está repetida. Cada dataset debe tener una Key única.";
            return false;
        }

        error = string.Empty;
        return true;
    }

    private bool IsDatasetKeyDuplicated(DatasetItemDto current)
    {
        if (current == null || string.IsNullOrWhiteSpace(current.Key))
        {
            return false;
        }

        var normalized = current.Key.Trim();
        return datasetItems.Count(x => string.Equals(x.Key?.Trim(), normalized, StringComparison.OrdinalIgnoreCase)) > 1;
    }

    private void AddDataset()
    {
        datasetItems.Add(new DatasetItemDto
        {
            Key = $"Dataset{datasetItems.Count + 1}",
            Sql = "SELECT TOP 1 1 AS Valor",
            MaxRows = 1
        });
    }

    private void RemoveDataset(DatasetItemDto dataset)
    {
        if (dataset == null)
        {
            return;
        }

        datasetItems.Remove(dataset);
        if (datasetItems.Count == 0)
        {
            datasetItems.Add(new DatasetItemDto { Key = string.Empty, Sql = string.Empty, MaxRows = 500 });
        }
    }

    private static List<DatasetItemDto> CreateDefaultDatasetItems()
    {
        return new List<DatasetItemDto>
        {
            new()
            {
                Key = "HeaderMovisto",
                Sql = "SELECT TOP 1 M.*, M.NUME_CLI FROM MOVISTO M WHERE M.DOPRILAR = @Doprilar",
                MaxRows = 1
            },
            new()
            {
                Key = "HeaderCliente",
                Sql = "SELECT TOP 1 D.* FROM DEUDOR12 D INNER JOIN MOVISTO M ON M.NUME_CLI = D.NUME_CLI WHERE M.DOPRILAR = @Doprilar",
                MaxRows = 1
            },
            new()
            {
                Key = "DetalleMovisto",
                Sql = "SELECT M.* FROM MOVISTO M WHERE M.DOPRILAR = @Doprilar ORDER BY M.Id",
                MaxRows = 500
            }
        };
    }

    private static LienzoDesignDto CreateDefaultDesign()
    {
        return new LienzoDesignDto
        {
            Orientation = "Portrait",
            MarginLeftMm = 0,
            MarginTopMm = 0,
            ShowPageNumbers = true,
            PageNumberAlign = "Right",
            Elements = new List<LienzoElementDto>
            {
                new() { Id = Guid.NewGuid().ToString("N"), Type = "field", Label = "{{HeaderMovisto.DOPRILAR}}", XMm = 8, YMm = 8, WidthMm = 70, HeightMm = 8 },
                new() { Id = Guid.NewGuid().ToString("N"), Type = "field", Label = "{{HeaderCliente.RAZON_SOCIAL}}", XMm = 8, YMm = 18, WidthMm = 110, HeightMm = 8 }
            }
        };
    }

    private void LoadDesignFromModelo()
    {
        if (string.IsNullOrWhiteSpace(modelo.LienzoJson))
        {
            design = CreateDefaultDesign();
            SelectOnly(design.Elements.FirstOrDefault()?.Id);
            SyncModelLienzoJson();
            return;
        }

        try
        {
            design = JsonSerializer.Deserialize<LienzoDesignDto>(modelo.LienzoJson, jsonOptions) ?? CreateDefaultDesign();
            design.Elements ??= new List<LienzoElementDto>();
            if (string.IsNullOrWhiteSpace(design.Orientation))
            {
                design.Orientation = "Portrait";
            }

            if (string.IsNullOrWhiteSpace(design.PageNumberAlign))
            {
                design.PageNumberAlign = "Right";
            }

            if (design.MarginLeftMm < 0)
            {
                design.MarginLeftMm = 0;
            }

            if (design.MarginTopMm < 0)
            {
                design.MarginTopMm = 0;
            }

            foreach (var el in design.Elements)
            {
                if (string.IsNullOrWhiteSpace(el.Id))
                {
                    el.Id = Guid.NewGuid().ToString("N");
                }

                if (el.WidthMm <= 0)
                {
                    el.WidthMm = 50;
                }

                if (el.HeightMm <= 0)
                {
                    el.HeightMm = 8;
                }

                if (el.DetailRowHeightMm <= 0)
                {
                    el.DetailRowHeightMm = 6;
                }

                if (el.DetailMaxRows <= 0)
                {
                    el.DetailMaxRows = 15;
                }

                if (el.StrokeWidth <= 0)
                {
                    el.StrokeWidth = 0.4;
                }

                if (string.IsNullOrWhiteSpace(el.StrokeStyle))
                {
                    el.StrokeStyle = "Solid";
                }

                if (string.IsNullOrWhiteSpace(el.StrokeColor))
                {
                    el.StrokeColor = "#000000";
                }
            }

            SelectOnly(design.Elements.FirstOrDefault()?.Id);
        }
        catch
        {
            design = CreateDefaultDesign();
            SelectOnly(design.Elements.FirstOrDefault()?.Id);
            SyncModelLienzoJson();
        }
    }

