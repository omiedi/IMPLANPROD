@page "/impresiones/remitos/disenador"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@using IMPLANPROD.Shared.DTOs.Impresiones
@using System.Globalization
@using System.Text.Json
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JSRuntime

<PageTitle>Diseñador Plantilla Remito</PageTitle>

<h3>Diseñador de Plantillas - Remito</h3>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Plantillas guardadas</span>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-success" @onclick="GuardarAsync" disabled="@guardando">Guardar plantilla</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="NuevaPlantilla">Nueva</button>
                    <button class="btn btn-sm btn-outline-warning" @onclick="NuevaPlantillaPorCopiaAsync" disabled="@(guardando || selectedTemplateCopyId <= 0)">Nueva x copia</button>
                </div>
            </div>
            <div class="card-body" style="max-height: 280px; overflow-y: auto;">
                <div class="mb-2">
                    <label class="form-label small mb-1">Seleccionar existente para copiar</label>
                    <select class="form-select form-select-sm" @bind="selectedTemplateCopyId" disabled="@(cargandoListado || plantillas.Count == 0)">
                        <option value="0">Seleccionar plantilla...</option>
                        @foreach (var item in plantillas)
                        {
                            <option value="@item.Id">@item.Nombre</option>
                        }
                    </select>
                </div>
                @if (cargandoListado)
                {
                    <div class="text-muted">Cargando...</div>
                }
                else if (plantillas.Count == 0)
                {
                    <div class="text-muted">No hay plantillas de remito.</div>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var item in plantillas)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <button class="btn btn-link p-0 text-start" @onclick="() => CargarPlantilla(item.Id)">@item.Nombre</button>
                                <small class="text-muted">@item.FechaModificacion.ToString("dd/MM HH:mm")</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        @if (showPropertiesModal && SelectedElement != null)
        {
            <div class="designer-modal-backdrop" @onclick="CloseElementProperties"></div>
            <div class="designer-modal">
                <div class="designer-modal-header d-flex justify-content-between align-items-center">
                    <h6 class="m-0">Propiedades del objeto</h6>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseElementProperties"></button>
                </div>
                <div class="designer-modal-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" @bind="SelectedElement.Type">
                                <option value="text">Texto</option>
                                <option value="field">Campo</option>
                                <option value="qrcode">Código QR</option>
                                <option value="barcode">Código de barras</option>
                                <option value="detailTable">Tabla detalle</option>
                                <option value="image">Imagen / Logo</option>
                                <option value="hline">Línea horizontal</option>
                                <option value="vline">Línea vertical</option>
                                <option value="rectangle">Rectángulo / Cuadrado</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Etiqueta / Texto</label>
                            <input class="form-control" @bind="SelectedElement.Label" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">X (mm)</label>
                            <input type="number" step="1" class="form-control" @bind="SelectedElement.XMm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Y (mm)</label>
                            <input type="number" step="1" class="form-control" @bind="SelectedElement.YMm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ancho (mm)</label>
                            <input type="number" step="1" class="form-control" @bind="SelectedElement.WidthMm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Alto (mm)</label>
                            <input type="number" step="1" class="form-control" @bind="SelectedElement.HeightMm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fuente</label>
                            <select class="form-select" @bind="SelectedElement.FontName">
                                @foreach (var font in FontOptions)
                                {
                                    <option value="@font">@font</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Tamaño</label>
                            <input type="number" step="1" min="6" max="40" class="form-control" @bind="SelectedElement.FontSize" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Alineación</label>
                            <select class="form-select" @bind="SelectedElement.Align">
                                <option value="Left">Izquierda</option>
                                <option value="Center">Centro</option>
                                <option value="Right">Derecha</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Largo máximo</label>
                            <input type="number" step="1" min="0" class="form-control" @bind="SelectedElement.MaxLength" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Binding de datos</label>
                            <input class="form-control" @bind="SelectedElement.Binding" placeholder="HeaderMovisto.DOPRILAR" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="SelectedElement.NumericOverflowAsterisks" id="chkAsteriscos" />
                                <label class="form-check-label" for="chkAsteriscos">Numérico: excede => *****</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">SQL del objeto (opcional)</label>
                            <textarea rows="3" class="form-control font-monospace" @bind="SelectedElement.SqlQuery" placeholder="SELECT ..."></textarea>
                        </div>
                        @if (IsCodeElement(SelectedElement))
                        {
                            <div class="col-md-6">
                                <label class="form-label">Contenido para código</label>
                                <input class="form-control" @bind="SelectedElement.Label" placeholder="COD: {{HeaderMovisto.CODIGO}} | LOTE: {{HeaderMovisto.LOTE}} | VTO: {{HeaderMovisto.VENCIMIENTO}}" />
                                <small class="text-muted">Podés combinar varios campos usando tokens {{Dataset.Campo}}.</small>
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ApplyCodePresetCodigoLoteVencimiento">Preset COD + LOTE + VTO</button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Simbología de barras</label>
                                <select class="form-select" @bind="SelectedElement.BarcodeSymbology" disabled="@(!string.Equals(SelectedElement.Type, "barcode", StringComparison.OrdinalIgnoreCase))">
                                    <option value="Code128">Code128</option>
                                    <option value="Ean13">EAN-13</option>
                                </select>
                            </div>
                        }
                        @if (string.Equals(SelectedElement.Type, "image", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="col-md-12">
                                <label class="form-label">Ruta imagen</label>
                                <input class="form-control" @bind="SelectedElement.ImagePath" placeholder="images/logo.png o C:\\...\\Client\\wwwroot\\images\\logo.png" />
                            </div>
                        }
                        @if (IsShapeElement(SelectedElement))
                        {
                            <div class="col-md-4">
                                <label class="form-label">Trazo</label>
                                <select class="form-select" @bind="SelectedElement.StrokeStyle">
                                    <option value="Solid">Sólido</option>
                                    <option value="Dash">Guiones</option>
                                    <option value="Dot">Punteado</option>
                                    <option value="DashDot">Guión-punto</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Espesor (mm)</label>
                                <input type="number" min="0.2" step="0.1" class="form-control" @bind="SelectedElement.StrokeWidth" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Color (hex)</label>
                                <input class="form-control" @bind="SelectedElement.StrokeColor" placeholder="#000000" />
                            </div>
                        }
                        @if (string.Equals(SelectedElement.Type, "detailTable", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="col-md-4">
                                <label class="form-label">Dataset detalle</label>
                                <input class="form-control" @bind="SelectedElement.Binding" placeholder="DetalleMovisto" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Columnas (coma separadas)</label>
                                <input class="form-control" @bind="SelectedElement.DetailColumnsCsv" placeholder="CODI_ARTI,DESCRI_ARTI,CANTI" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Alto de fila (mm)</label>
                                <input type="number" min="1" step="1" class="form-control" @bind="SelectedElement.DetailRowHeightMm" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Máx. filas</label>
                                <input type="number" min="1" step="1" class="form-control" @bind="SelectedElement.DetailMaxRows" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="SelectedElement.DetailShowHeader" id="chkDetailHeader" />
                                    <label class="form-check-label" for="chkDetailHeader">Mostrar cabecera</label>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="SelectedElement.DetailAutoAlign" id="chkDetailAutoAlign" />
                                    <label class="form-check-label" for="chkDetailAutoAlign">Auto: número derecha / texto izquierda</label>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="SelectedElement.DetailRowLines" id="chkDetailRowLines" />
                                    <label class="form-check-label" for="chkDetailRowLines">Líneas entre filas</label>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="SelectedElement.DetailColumnLines" id="chkDetailColumnLines" />
                                    <label class="form-check-label" for="chkDetailColumnLines">Líneas verticales entre columnas</label>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Alineación por columna (opcional)</label>
                                <input class="form-control" @bind="SelectedElement.DetailColumnAlignCsv" placeholder="CANTI:right,DESCRI_ARTI:left,PRECIO:right" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Anchos por columna en mm (opcional)</label>
                                <input class="form-control" @bind="SelectedElement.DetailColumnWidthsCsv" placeholder="20,90,20" />
                                <small class="text-muted">Ordenado igual que Columnas. Si la suma no coincide con el ancho total, se ajusta automáticamente.</small>
                            </div>
                        }
                        @if (HasBindingValidationWarning)
                        {
                            <div class="col-md-12">
                                <div class="alert alert-warning py-2 mb-0">@BindingValidationWarning</div>
                            </div>
                        }
                    </div>
                </div>
                <div class="designer-modal-footer text-end">
                    <button type="button" class="btn btn-secondary" @onclick="CloseElementProperties">Cerrar</button>
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-header">Parámetros</div>
            <div class="card-body">
                @foreach (var parameter in parameters)
                {
                    <div class="row g-2 mb-2">
                        <div class="col-md-5">
                            <input class="form-control" @bind="parameter.Name" placeholder="Nombre (ej: Doprilar, NumeCli)" />
                        </div>
                        <div class="col-md-5">
                            <input class="form-control" @bind="parameter.Value" placeholder="Valor" />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="button" class="btn btn-outline-danger" @onclick="(() => RemoveParameter(parameter))">Quitar</button>
                        </div>
                    </div>
                }
                <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="AddParameter">+ Parámetro</button>
                <button class="btn btn-outline-secondary w-100" @onclick="PreviewAsync" disabled="@guardando">Previsualizar datasets</button>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Configuración de plantilla</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="modelo.Nombre" placeholder="Remito estándar" />
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Datasets (dinámicos e ilimitados)</label>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddDataset">+ Dataset</button>
                    </div>
                    @foreach (var dataset in datasetItems)
                    {
                        var hasEmptyKey = string.IsNullOrWhiteSpace(dataset.Key);
                        var hasDuplicateKey = IsDatasetKeyDuplicated(dataset);
                        <div class="border rounded p-2 mb-2 @(hasEmptyKey || hasDuplicateKey ? "border-danger bg-white" : "bg-light")">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label">Key</label>
                                    <input class="form-control @(hasEmptyKey || hasDuplicateKey ? "is-invalid" : string.Empty)" @bind="dataset.Key" placeholder="HeaderMovisto" />
                                    @if (hasEmptyKey)
                                    {
                                        <div class="invalid-feedback d-block">La Key es obligatoria.</div>
                                    }
                                    else if (hasDuplicateKey)
                                    {
                                        <div class="invalid-feedback d-block">La Key está repetida.</div>
                                    }
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Máx. filas</label>
                                    <input type="number" min="1" class="form-control" @bind="dataset.MaxRows" />
                                </div>
                                <div class="col-md-6 d-grid">
                                    <button type="button" class="btn btn-outline-danger" @onclick="(() => RemoveDataset(dataset))">Quitar dataset</button>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">SQL</label>
                                    <textarea class="form-control font-monospace" rows="4" @bind="dataset.Sql" placeholder="SELECT ..."></textarea>
                                </div>
                            </div>
                        </div>
                    }
                    <small class="text-muted">Sugeridos: HeaderMovisto (1), HeaderCliente (1), DetalleMovisto (500).</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Diseñador de lienzo (milimetrado)</label>
                    <div class="d-flex gap-2 flex-wrap mb-2">
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddTexto">+ Texto</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddCampo">+ Campo</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddCodigoQr">+ QR</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddCodigoBarra">+ Código barra</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddImagen">+ Imagen / logo</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddLineaHorizontal">+ Línea H</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddLineaVertical">+ Línea V</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddRectangulo">+ Rectángulo</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="AddDetalle">+ Tabla detalle</button>
                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="DuplicateSeleccionado" disabled="@(SelectedElement == null)">Copiar seleccionado</button>
                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="BringSelectedToFront" disabled="@(SelectedElement == null)">Traer al frente</button>
                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="SendSelectedToBack" disabled="@(SelectedElement == null)">Enviar al fondo</button>
                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="RemoveSeleccionado" disabled="@(SelectedElement == null)">Quitar seleccionado</button>
                    </div>
                    <small class="text-muted">Atajos en lienzo: Ctrl/Cmd + click selección múltiple, Ctrl+C copiar, Ctrl+V pegar.</small>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Orientación</label>
                            <select class="form-select" @bind="design.Orientation">
                                <option value="Portrait">Retrato</option>
                                <option value="Landscape">Paisaje</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Escala (px por mm)</label>
                            <input type="number" step="0.1" min="1" max="8" class="form-control" @bind="pxPerMm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Margen lateral (mm)</label>
                            <input type="number" step="1" min="0" class="form-control" @bind="design.MarginLeftMm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Margen vertical (mm)</label>
                            <input type="number" step="1" min="0" class="form-control" @bind="design.MarginTopMm" />
                        </div>
                        <div class="col-md-8 d-flex align-items-end gap-2 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetMargins">Reset márgenes</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="(() => ApplyMarginPreset(5))">Preset 5 mm</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="(() => ApplyMarginPreset(10))">Preset 10 mm</button>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="design.ShowPageNumbers" id="chkShowPageNumbers" />
                                <label class="form-check-label" for="chkShowPageNumbers">Mostrar numeración de páginas</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Posición numeración</label>
                            <select class="form-select" @bind="design.PageNumberAlign" disabled="@(!design.ShowPageNumbers)">
                                <option value="Left">Izquierda</option>
                                <option value="Center">Centro</option>
                                <option value="Right">Derecha</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="GuardarAsync" disabled="@guardando">Guardar cambios</button>
                    <button class="btn btn-outline-secondary" @onclick="PreviewAsync" disabled="@guardando">Previsualizar</button>
                    <button class="btn btn-outline-dark" @onclick="ImprimirPaginaMilimetradaAsync" disabled="@guardando">Imprimir página milimetrada</button>
                    <button class="btn btn-outline-info" @onclick="VerPdfAsync" disabled="@(guardando || modelo.Id <= 0)">Ver PDF</button>
                    <button class="btn btn-outline-info" @onclick="VerPdfConReglaAsync" disabled="@(guardando || modelo.Id <= 0)">Ver PDF + regla</button>
                    <button class="btn btn-outline-danger" @onclick="GenerarPdfAsync" disabled="@(guardando || modelo.Id <= 0)">Generar PDF</button>
                </div>
                <small class="text-muted d-block mt-1">Los dos botones de guardar persisten exactamente lo mismo (plantilla + diseño). Si cerrás sin guardar, se mantiene la última versión guardada.</small>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">Lienzo (drag & drop con grilla mm)</div>
            <div class="card-body">
                <div class="lienzo-wrapper">
                    <div class="lienzo-ruler-layout">
                        <div class="lienzo-ruler-corner"></div>
                        <div class="lienzo-ruler-top" style="@RulerTopStyle">
                            @foreach (var tick in HorizontalRuleTicks)
                            {
                                <span class="ruler-tick-label" style="left:@(tick * pxPerMm)px">@tick</span>
                            }
                        </div>
                        <div class="lienzo-ruler-left" style="@RulerLeftStyle">
                            @foreach (var tick in VerticalRuleTicks)
                            {
                                <span class="ruler-tick-label-y" style="top:@(tick * pxPerMm)px">@tick</span>
                            }
                        </div>
                        <div class="lienzo-grid"
                             style="@CanvasStyle"
                             tabindex="0"
                             @onmousedown="OnCanvasMouseDown"
                             @onmousemove="OnCanvasMouseMove"
                             @onkeydown="OnLienzoKeyDown"
                             @onmouseup="StopDrag"
                             @onmouseleave="StopDrag">
                            @foreach (var el in design.Elements)
                            {
                                <div class="bloque-diseno @(IsElementSelected(el.Id) ? "seleccionado" : string.Empty)"
                                     style="@BuildElementStyle(el)"
                                     @onmousedown="(e => StartDrag(el, e))"
                                     @onmousedown:stopPropagation="true"
                                     @oncontextmenu="(e => OpenElementProperties(el))"
                                     @oncontextmenu:preventDefault="true"
                                     @onmouseup="StopDrag">
                                    @if (string.Equals(el.Type, "image", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <img src="@ResolveImageUrl(el)" alt="@el.Label" class="designer-image-preview" />
                                    }
                                    else if (IsShapeElement(el))
                                    {
                                        <div style="@BuildShapeInnerStyle(el)"></div>
                                    }
                                    else if (IsCodeElement(el))
                                    {
                                        <div class="text-center text-success small fw-semibold">@GetCodePreviewLabel(el)</div>
                                    }
                                    else
                                    {
                                        @el.Label
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @if (SelectedElement != null)
                {
                    <div class="row g-2 mt-2">
                        <div class="col-md-2">
                            <label class="form-label">X (mm)</label>
                            <input type="number" step="1" class="form-control" @bind="SelectedElement.XMm" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Y (mm)</label>
                            <input type="number" step="1" class="form-control" @bind="SelectedElement.YMm" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Ancho</label>
                            <input type="number" step="1" class="form-control" @bind="SelectedElement.WidthMm" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Alto</label>
                            <input type="number" step="1" class="form-control" @bind="SelectedElement.HeightMm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Etiqueta</label>
                            <input class="form-control" @bind="SelectedElement.Label" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorPreview))
        {
            <div class="alert alert-danger mt-3">@errorPreview</div>
        }

        @if (preview?.Results?.Any() == true)
        {
            @foreach (var dataset in preview.Results)
            {
                <div class="card mt-3">
                    <div class="card-header">Preview @dataset.Key (@dataset.Value.Count filas)</div>
                    <div class="card-body" style="max-height: 260px; overflow-y: auto;">
                        @if (dataset.Value.Count == 0)
                        {
                            <span class="text-muted">Sin datos</span>
                        }
                        else
                        {
                            var cols = dataset.Value.First().Keys.ToList();
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        @foreach (var c in cols)
                                        {
                                            <th>@c</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in dataset.Value.Take(25))
                                    {
                                        <tr>
                                            @foreach (var c in cols)
                                            {
                                                <td>@(row[c]?.ToString())</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
        }

        @if (showPdfOverlay && !string.IsNullOrWhiteSpace(pdfPreviewDataUrl))
        {
            <div class="designer-modal-backdrop" @onclick="ClosePdfOverlay"></div>
            <div class="designer-modal designer-modal-wide">
                <div class="designer-modal-header d-flex justify-content-between align-items-center">
                    <h6 class="m-0">Vista PDF con regla y grilla</h6>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="ClosePdfOverlay"></button>
                </div>
                <div class="designer-modal-body">
                    <div class="text-muted small mb-2">La grilla y las reglas son una guía visual sobre el PDF; no modifican el archivo generado.</div>
                    <div class="lienzo-wrapper">
                        <div class="lienzo-ruler-layout">
                            <div class="lienzo-ruler-corner"></div>
                            <div class="lienzo-ruler-top" style="@PdfRulerTopStyle">
                                @foreach (var tick in PdfHorizontalRuleTicks)
                                {
                                    <span class="ruler-tick-label" style="left:@(tick * pdfPreviewPxPerMm)px">@tick</span>
                                }
                            </div>
                            <div class="lienzo-ruler-left" style="@PdfRulerLeftStyle">
                                @foreach (var tick in PdfVerticalRuleTicks)
                                {
                                    <span class="ruler-tick-label-y" style="top:@(tick * pdfPreviewPxPerMm)px">@tick</span>
                                }
                            </div>
                            <div class="pdf-preview-page" style="@PdfPreviewPageStyle">
                                <iframe src="@pdfPreviewDataUrl" title="Preview PDF" class="pdf-preview-frame"></iframe>
                                <div class="pdf-preview-grid" style="@PdfPreviewGridStyle"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

