    private void StartDrag(LienzoElementDto element, Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (args.Button != 0)
        {
            return;
        }

        if (args.CtrlKey || args.MetaKey)
        {
            ToggleSelection(element.Id);
            isDragging = false;
            dragSelectionIds.Clear();
            showPropertiesModal = false;
            return;
        }

        if (!IsElementSelected(element.Id))
        {
            SelectOnly(element.Id);
        }

        dragSelectionIds.Clear();
        if (selectedElementIds.Count > 1)
        {
            foreach (var selectedId in selectedElementIds)
            {
                dragSelectionIds.Add(selectedId);
            }
        }
        else
        {
            dragSelectionIds.Add(element.Id);
        }

        isDragging = true;
        lastClientX = args.ClientX;
        lastClientY = args.ClientY;
        showPropertiesModal = false;
    }

    private void OpenElementProperties(LienzoElementDto element)
    {
        SelectOnly(element.Id);
        showPropertiesModal = true;
    }

