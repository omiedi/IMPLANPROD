    {
        showPropertiesModal = false;
    }

    private void OnCanvasMouseMove(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (!isDragging)
        {
            return;
        }

        var dragTargets = design.Elements
            .Where(x => dragSelectionIds.Contains(x.Id))
            .ToList();

        if (dragTargets.Count == 0 && SelectedElement != null)
        {
            dragTargets.Add(SelectedElement);
        }

        if (dragTargets.Count == 0)
        {
            return;
        }

        var dxPx = args.ClientX - lastClientX;
        var dyPx = args.ClientY - lastClientY;

        lastClientX = args.ClientX;
        lastClientY = args.ClientY;

        var dxMm = dxPx / pxPerMm;
        var dyMm = dyPx / pxPerMm;

        var minDxAllowed = dragTargets.Max(x => -x.XMm);
        var maxDxAllowed = dragTargets.Min(x => Math.Max(0, CanvasWidthMm - x.WidthMm - CanvasOffsetXMm) - x.XMm);
        var minDyAllowed = dragTargets.Max(x => -x.YMm);
        var maxDyAllowed = dragTargets.Min(x => Math.Max(0, CanvasHeightMm - x.HeightMm - CanvasOffsetYMm) - x.YMm);

        var appliedDx = Math.Clamp(dxMm, minDxAllowed, maxDxAllowed);
        var appliedDy = Math.Clamp(dyMm, minDyAllowed, maxDyAllowed);

        foreach (var target in dragTargets)
        {
            target.XMm += appliedDx;
            target.YMm += appliedDy;
        }
    }

    private void StopDrag()
    {
        isDragging = false;
        dragSelectionIds.Clear();
    }

