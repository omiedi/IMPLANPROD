    private void OnLienzoKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.ShiftKey)
        {
            var stepMm = 1d;
            var key = args.Key ?? string.Empty;

            if (string.Equals(key, "ArrowLeft", StringComparison.OrdinalIgnoreCase))
            {
                MoveSelectedElements(-stepMm, 0);
                return;
            }

            if (string.Equals(key, "ArrowRight", StringComparison.OrdinalIgnoreCase))
            {
                MoveSelectedElements(stepMm, 0);
                return;
            }

            if (string.Equals(key, "ArrowUp", StringComparison.OrdinalIgnoreCase))
            {
                MoveSelectedElements(0, -stepMm);
                return;
            }

            if (string.Equals(key, "ArrowDown", StringComparison.OrdinalIgnoreCase))
            {
                MoveSelectedElements(0, stepMm);
                return;
            }
        }

        if (!args.CtrlKey && !args.MetaKey)
        {
            return;
        }

        if (string.Equals(args.Key, "c", StringComparison.OrdinalIgnoreCase))
        {
            var current = SelectedElement;
            if (current != null)
            {
                CopyToClipboard(current);
            }

            return;
        }

        if (string.Equals(args.Key, "v", StringComparison.OrdinalIgnoreCase))
        {
            PasteFromClipboard();
        }
    }

    private void CopyToClipboard(LienzoElementDto source)
    {
        copiedElement = CloneElement(source, 0, keepId: false);
