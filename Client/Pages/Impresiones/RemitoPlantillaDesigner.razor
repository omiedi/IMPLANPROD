    private bool HasBindingValidationWarning => !string.IsNullOrWhiteSpace(BindingValidationWarning);

    private string? BindingValidationWarning
    {
        get
        {
            var el = SelectedElement;
            if (el == null || string.IsNullOrWhiteSpace(el.Binding))
            {
                return null;
            }

            if (preview?.Results == null || preview.Results.Count == 0)
            {
                return "No hay previsualización cargada. Ejecutá 'Previsualizar' para validar el binding.";
            }

            var binding = el.Binding.Trim();
            var bindingParts = binding.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            if (bindingParts.Length >= 2)
            {
                var dataset = bindingParts[0];
                var field = bindingParts[1];
                if (!preview.Results.TryGetValue(dataset, out var rows) || rows == null || rows.Count == 0)
                {
                    return $"El dataset '{dataset}' no devolvió filas en la previsualización.";
                }

                return ExistsField(rows[0], field)
                    ? null
                    : $"El campo '{field}' no existe en el dataset '{dataset}'.";
            }

            if (!TryFindFieldInAnyDataset(preview.Results, binding, out var foundDataset))
            {
                return $"El campo '{binding}' no existe en ningún dataset previsualizado.";
            }

            return $"Binding corto válido en '{foundDataset}'. Si hay más de un dataset con ese campo, usá formato Dataset.Campo.";
        }
    }

    private static bool TryFindFieldInAnyDataset(
        Dictionary<string, List<Dictionary<string, object?>>> results,
        string fieldName,
        out string datasetName)
    {
        foreach (var item in results)
        {
            if (item.Value == null || item.Value.Count == 0)
            {
                continue;
            }

            if (ExistsField(item.Value[0], fieldName))
            {
                datasetName = item.Key;
                return true;
            }
        }

        datasetName = string.Empty;
        return false;
    }

    private static bool ExistsField(Dictionary<string, object?> row, string fieldName)
    {
        return row.ContainsKey(fieldName)
               || row.Keys.Any(k => string.Equals(k, fieldName, StringComparison.OrdinalIgnoreCase));
    }

    private void MoveSelectedElements(double dxMm, double dyMm)
    {
        var targets = design.Elements
            .Where(x => selectedElementIds.Contains(x.Id))
            .ToList();

        if (targets.Count == 0 && SelectedElement != null)
        {
            targets.Add(SelectedElement);
        }

        if (targets.Count == 0)
        {
            return;
        }

        var minDxAllowed = targets.Max(x => -x.XMm);
        var maxDxAllowed = targets.Min(x => Math.Max(0, CanvasWidthMm - x.WidthMm - CanvasOffsetXMm) - x.XMm);
        var minDyAllowed = targets.Max(x => -x.YMm);
        var maxDyAllowed = targets.Min(x => Math.Max(0, CanvasHeightMm - x.HeightMm - CanvasOffsetYMm) - x.YMm);

        var appliedDx = Math.Clamp(dxMm, minDxAllowed, maxDxAllowed);
        var appliedDy = Math.Clamp(dyMm, minDyAllowed, maxDyAllowed);

        foreach (var target in targets)
        {
            target.XMm += appliedDx;
            target.YMm += appliedDy;
        }
    }

    private bool IsElementSelected(string? elementId)
    {
        return !string.IsNullOrWhiteSpace(elementId)
               && selectedElementIds.Contains(elementId);
    }

    private void SelectOnly(string? elementId)
    {
        selectedElementIds.Clear();
        selectedElementId = null;

        if (string.IsNullOrWhiteSpace(elementId))
        {
            return;
        }

        selectedElementId = elementId;
        selectedElementIds.Add(elementId);
    }

    private void ToggleSelection(string? elementId)
    {
        if (string.IsNullOrWhiteSpace(elementId))
        {
            return;
        }

        if (!selectedElementIds.Add(elementId))
        {
            selectedElementIds.Remove(elementId);
        }

        if (selectedElementIds.Count == 0)
        {
            selectedElementId = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(selectedElementId) && selectedElementIds.Contains(selectedElementId))
        {
            return;
        }

        selectedElementId = selectedElementIds.First();
    }

    private LienzoElementDto? SelectedElement => design.Elements.FirstOrDefault(x => x.Id == selectedElementId);

    private double CanvasWidthMm => string.Equals(design.Orientation, "Landscape", StringComparison.OrdinalIgnoreCase) ? 297 : 210;

    private double CanvasHeightMm => string.Equals(design.Orientation, "Landscape", StringComparison.OrdinalIgnoreCase) ? 210 : 297;

    private double CanvasOffsetXMm => Math.Max(0, design.MarginLeftMm);

    private double CanvasOffsetYMm => Math.Max(0, design.MarginTopMm);

    private string CanvasStyle => $"width: {CanvasWidthMm * pxPerMm:0}px; height: {CanvasHeightMm * pxPerMm:0}px;";

    private string RulerTopStyle => BuildHorizontalRulerStyle(CanvasWidthMm, pxPerMm);

    private string RulerLeftStyle => BuildVerticalRulerStyle(CanvasHeightMm, pxPerMm);

    private string PdfRulerTopStyle => BuildHorizontalRulerStyle(CanvasWidthMm, pdfPreviewPxPerMm);

    private string PdfRulerLeftStyle => BuildVerticalRulerStyle(CanvasHeightMm, pdfPreviewPxPerMm);

    private string PdfPreviewPageStyle => $"width: {CanvasWidthMm * pdfPreviewPxPerMm:0}px; height: {CanvasHeightMm * pdfPreviewPxPerMm:0}px;";

    private string PdfPreviewGridStyle => $"background-size: {pdfPreviewPxPerMm:0.###}px {pdfPreviewPxPerMm:0.###}px; background-image: linear-gradient(to right, rgba(108,117,125,0.16) 1px, transparent 1px), linear-gradient(to bottom, rgba(108,117,125,0.16) 1px, transparent 1px);";

    private IEnumerable<int> HorizontalRuleTicks => Enumerable.Range(0, (int)(CanvasWidthMm / 10) + 1).Select(i => i * 10);

    private IEnumerable<int> VerticalRuleTicks => Enumerable.Range(0, (int)(CanvasHeightMm / 10) + 1).Select(i => i * 10);

    private IEnumerable<int> PdfHorizontalRuleTicks => Enumerable.Range(0, (int)(CanvasWidthMm / 10) + 1).Select(i => i * 10);

    private IEnumerable<int> PdfVerticalRuleTicks => Enumerable.Range(0, (int)(CanvasHeightMm / 10) + 1).Select(i => i * 10);

    private static string BuildHorizontalRulerStyle(double widthMm, double scalePxPerMm)
    {
        var widthPx = Math.Max(1, widthMm * scalePxPerMm);
        var minorStepPx = Math.Max(1, scalePxPerMm);
        var majorStepPx = Math.Max(minorStepPx, scalePxPerMm * 10);

        var widthCss = widthPx.ToString("0.###", CultureInfo.InvariantCulture);
        var minorStepCss = minorStepPx.ToString("0.###", CultureInfo.InvariantCulture);
        var majorStepCss = majorStepPx.ToString("0.###", CultureInfo.InvariantCulture);

        return $"width:{widthCss}px;background-image:repeating-linear-gradient(to right, rgba(108,117,125,0.16) 0, rgba(108,117,125,0.16) 1px, transparent 1px, transparent {minorStepCss}px),repeating-linear-gradient(to right, rgba(73,80,87,0.38) 0, rgba(73,80,87,0.38) 1.4px, transparent 1.4px, transparent {majorStepCss}px);";
    }

    private static string BuildVerticalRulerStyle(double heightMm, double scalePxPerMm)
    {
        var heightPx = Math.Max(1, heightMm * scalePxPerMm);
        var minorStepPx = Math.Max(1, scalePxPerMm);
        var majorStepPx = Math.Max(minorStepPx, scalePxPerMm * 10);

        var heightCss = heightPx.ToString("0.###", CultureInfo.InvariantCulture);
        var minorStepCss = minorStepPx.ToString("0.###", CultureInfo.InvariantCulture);
        var majorStepCss = majorStepPx.ToString("0.###", CultureInfo.InvariantCulture);

        return $"height:{heightCss}px;background-image:repeating-linear-gradient(to bottom, rgba(108,117,125,0.16) 0, rgba(108,117,125,0.16) 1px, transparent 1px, transparent {minorStepCss}px),repeating-linear-gradient(to bottom, rgba(73,80,87,0.38) 0, rgba(73,80,87,0.38) 1.4px, transparent 1.4px, transparent {majorStepCss}px);";
    }

    private string BuildElementStyle(LienzoElementDto element)
    {
        var style = $"left:{(element.XMm + CanvasOffsetXMm) * pxPerMm:0}px; top:{(element.YMm + CanvasOffsetYMm) * pxPerMm:0}px; width:{element.WidthMm * pxPerMm:0}px; height:{element.HeightMm * pxPerMm:0}px;";
        style += $"z-index:{ResolveElementZIndex(element)};";
        if (IsShapeElement(element))
        {
            var hitAreaMm = 2d;
            if (string.Equals(element.Type, "hline", StringComparison.OrdinalIgnoreCase) && element.HeightMm < hitAreaMm)
            {
                style += $"height:{hitAreaMm * pxPerMm:0}px;";
            }

            if (string.Equals(element.Type, "vline", StringComparison.OrdinalIgnoreCase) && element.WidthMm < hitAreaMm)
            {
                style += $"width:{hitAreaMm * pxPerMm:0}px;";
            }

            style += "border:1px dashed rgba(13,110,253,0.45);background:rgba(13,110,253,0.05);padding:0;overflow:visible;";
        }

        if (IsElementSelected(element.Id))
        {
            style += "outline:2px solid #0d6efd;outline-offset:0;";
        }

        if (string.Equals(element.Type, "image", StringComparison.OrdinalIgnoreCase))
        {
            style += "border:1px solid #adb5bd;background:#fff;padding:0;";
        }

        if (IsCodeElement(element))
        {
            style += "border:1px dashed #198754;background:#f5fff8;color:#198754;display:flex;align-items:center;justify-content:center;text-align:center;padding:2px;";
        }

        return style;
    }

    private int ResolveElementZIndex(LienzoElementDto element)
    {
        if (IsElementSelected(element.Id))
        {
            return IsShapeElement(element) ? 10 : 30;
        }

        if (IsShapeElement(element))
        {
            return 5;
        }

        return 20;
    }

    private static bool IsShapeElement(LienzoElementDto element)
    {
        return string.Equals(element.Type, "hline", StringComparison.OrdinalIgnoreCase)
               || string.Equals(element.Type, "vline", StringComparison.OrdinalIgnoreCase)
               || string.Equals(element.Type, "rectangle", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsCodeElement(LienzoElementDto element)
    {
        return string.Equals(element.Type, "qrcode", StringComparison.OrdinalIgnoreCase)
               || string.Equals(element.Type, "barcode", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetCodePreviewLabel(LienzoElementDto element)
    {
        if (string.Equals(element.Type, "qrcode", StringComparison.OrdinalIgnoreCase))
        {
            return "QR";
        }

        var symbology = string.IsNullOrWhiteSpace(element.BarcodeSymbology)
            ? "Code128"
            : element.BarcodeSymbology;
        return $"BAR ({symbology})";
    }

    private string BuildShapeInnerStyle(LienzoElementDto element)
    {
        var stroke = Math.Max(0.2, element.StrokeWidth);
        var color = string.IsNullOrWhiteSpace(element.StrokeColor) ? "#000000" : element.StrokeColor;
        var borderStyle = MapStrokeCss(element.StrokeStyle);

        if (string.Equals(element.Type, "hline", StringComparison.OrdinalIgnoreCase))
        {
            return $"position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);border-top:{stroke}mm {borderStyle} {color};";
        }

        if (string.Equals(element.Type, "vline", StringComparison.OrdinalIgnoreCase))
        {
            return $"position:absolute;top:0;bottom:0;left:50%;transform:translateX(-50%);border-left:{stroke}mm {borderStyle} {color};";
        }

        return $"width:100%;height:100%;border:{stroke}mm {borderStyle} {color};box-sizing:border-box;background:transparent;";
    }

    private static string MapStrokeCss(string? strokeStyle)
    {
        if (string.Equals(strokeStyle, "Dot", StringComparison.OrdinalIgnoreCase))
        {
            return "dotted";
        }

        if (string.Equals(strokeStyle, "Dash", StringComparison.OrdinalIgnoreCase)
            || string.Equals(strokeStyle, "DashDot", StringComparison.OrdinalIgnoreCase))
        {
            return "dashed";
        }

        return "solid";
    }

    private static string ResolveImageUrl(LienzoElementDto element)
    {
        if (string.IsNullOrWhiteSpace(element.ImagePath))
        {
            return string.Empty;
        }

        var raw = element.ImagePath.Trim().Replace('\\', '/');
        var marker = "/wwwroot/";
        var markerIndex = raw.LastIndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex >= 0)
        {
            return "/" + raw[(markerIndex + marker.Length)..].TrimStart('/');
        }

        if (raw.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || raw.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || raw.StartsWith("/", StringComparison.OrdinalIgnoreCase))
        {
            return raw;
        }

        return "/" + raw.TrimStart('/');
    }

