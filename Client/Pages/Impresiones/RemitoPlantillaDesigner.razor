        }

        var paste = CloneElement(copiedElement, 5, keepId: false);
        design.Elements.Add(paste);
        SelectOnly(paste.Id);
    }

    private LienzoElementDto CloneElement(LienzoElementDto source, double offsetMm, bool keepId)
    {
        return new LienzoElementDto
        {
            Id = keepId ? source.Id : Guid.NewGuid().ToString("N"),
            Type = source.Type,
            Label = source.Label,
            Binding = source.Binding,
            SqlQuery = source.SqlQuery,
            XMm = Math.Min(source.XMm + offsetMm, Math.Max(0, CanvasWidthMm - source.WidthMm - CanvasOffsetXMm)),
            YMm = Math.Min(source.YMm + offsetMm, Math.Max(0, CanvasHeightMm - source.HeightMm - CanvasOffsetYMm)),
            WidthMm = source.WidthMm,
            HeightMm = source.HeightMm,
            FontName = source.FontName,
            FontSize = source.FontSize,
            Align = source.Align,
            MaxLength = source.MaxLength,
            NumericOverflowAsterisks = source.NumericOverflowAsterisks,
            DetailColumnsCsv = source.DetailColumnsCsv,
            DetailRowHeightMm = source.DetailRowHeightMm,
            DetailMaxRows = source.DetailMaxRows,
            DetailShowHeader = source.DetailShowHeader,
            DetailAutoAlign = source.DetailAutoAlign,
            DetailRowLines = source.DetailRowLines,
            DetailColumnLines = source.DetailColumnLines,
            DetailColumnAlignCsv = source.DetailColumnAlignCsv,
            DetailColumnWidthsCsv = source.DetailColumnWidthsCsv,
            ImagePath = source.ImagePath,
            BarcodeSymbology = source.BarcodeSymbology,
            StrokeStyle = source.StrokeStyle,
            StrokeWidth = source.StrokeWidth,
            StrokeColor = source.StrokeColor
        };
    }

