@page "/seguimiento-solicitudes"
@page "/admin/seguimiento-solicitudes"
@implements IDisposable
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Client.Shared.Components
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccess
@inject CurrentUserService CurrentUserService

<PageTitle>@(esAdmin ? "Seguimiento de Solicitudes (Admin)" : "Seguimiento de Solicitudes")</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
    <div class="container-fluid">
        <div class="mb-4">
            <h2 class="text-center fw-bold text-primary">
                <i class="fas fa-tasks me-2"></i>
                @(esAdmin ? "SEGUIMIENTO DE SOLICITUDES - ADMINISTRACION" : "SEGUIMIENTO DE SOLICITUDES")
            </h2>
            <hr class="border-primary border-2 opacity-50" />
        </div>

        <div class="mb-3">
            <button class="btn btn-primary" @onclick="AbrirCrear">
                <i class="fas fa-plus me-1"></i> Nueva Solicitud
            </button>
        </div>

        <!-- Filtros -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-filter"></i> Filtros</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Desde</label>
                        <input type="date" class="form-control" @bind="fechaDesde" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Hasta</label>
                        <input type="date" class="form-control" @bind="fechaHasta" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Módulo</label>
                        <select class="form-select" @bind="moduloFiltro">
                            <option value="">Todos</option>
                            @foreach (var m in modulos)
                            {
                                <option value="@m.Codigo">@m.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" @bind="tipoFiltro">
                            <option value="">Todos</option>
                            @foreach (var t in tiposSolicitud)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Nivel</label>
                        <select class="form-select" @bind="nivelFiltro">
                            <option value="">Todos</option>
                            @foreach (var n in niveles)
                            {
                                <option value="@n">@n</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="estadoFiltro">
                            <option value="">Todos</option>
                            @foreach (var e in estados)
                            {
                                <option value="@e">@e</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Nº Solicitud</label>
                        <InputNumeroLimpio @bind-Value="numeroFiltro" TValue="int?" Class="form-control" Placeholder="Nº" />
                    </div>
                    @if (esAdmin)
                    {
                        <div class="col-md-2">
                            <label class="form-label">Usuario</label>
                            <select class="form-select" @bind="usuarioFiltro">
                                <option value="">Todos</option>
                                @foreach (var u in usuariosCombo)
                                {
                                    <option value="@u.Key">@u.Value</option>
                                }
                            </select>
                        </div>
                        @if (esSuperAdmin)
                        {
                            <div class="col-md-2 d-flex align-items-end">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="verTodos" @bind="verTodos" />
                                    <label class="form-check-label" for="verTodos">Ver todas las empresas</label>
                                </div>
                            </div>
                        }
                    }
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary w-100" @onclick="AplicarFiltros">
                            <i class="fas fa-search me-1"></i> Buscar
                        </button>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-outline-secondary w-100" @onclick="LimpiarFiltros">
                            <i class="fas fa-eraser me-1"></i> Limpiar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        @if (cargando)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-3 text-muted">Cargando...</p>
            </div>
        }
        else if (solicitudes == null || solicitudes.Count == 0)
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle me-2"></i> No hay solicitudes para mostrar
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-end">Nº</th>
                            <th>Fecha</th>
                            <th>Título</th>
                            <th>Módulo</th>
                            <th>Tipo</th>
                            <th>Nivel</th>
                            <th>Estado</th>
                            <th>Últ. Actualización</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in solicitudes)
                        {
                            <tr>
                                <td class="text-end">@s.Id</td>
                                <td>@s.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                <td>@s.Titulo</td>
                                <td>@s.Modulo</td>
                                <td>@s.TipoSolicitud</td>
                                <td>
                                    <span class="badge @ClaseNivel(s.Nivel)">@s.Nivel</span>
                                </td>
                                <td>
                                    <span class="badge @ClaseEstado(s.Estado)">@s.Estado</span>
                                </td>
                                <td>@s.FechaUltimaActualizacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <button class="btn btn-sm btn-info" @onclick="() => AbrirDetalle(s.Id)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    @if (esAdmin && s.Estado != "Cerrado" && s.Estado != "Cancelado")
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => AbrirAvance(s)" title="Avance">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pagination CurrentPage="currentPage"
                        TotalPages="totalPages"
                        SelectedPage="SelectedPageAsync" />
        }
    </div>
}

<!-- Modal Detalle -->
@if (mostrarDetalle && solicitudSeleccionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Solicitud Nº @solicitudSeleccionada.Id</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarDetalle = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-3"><strong>Fecha ingreso:</strong> @solicitudSeleccionada.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-md-3"><strong>Solicitante:</strong> @(solicitudSeleccionada.NombreSolicitante ?? $"Usuario {solicitudSeleccionada.UsuarioSolicitante}")</div>
                        <div class="col-md-3"><strong>Módulo:</strong> @solicitudSeleccionada.Modulo</div>
                        <div class="col-md-3"><strong>Tipo:</strong> @solicitudSeleccionada.TipoSolicitud</div>
                        <div class="col-md-3"><strong>Nivel:</strong> <span class="badge @ClaseNivel(solicitudSeleccionada.Nivel)">@solicitudSeleccionada.Nivel</span></div>
                        <div class="col-md-3"><strong>Estado:</strong> <span class="badge @ClaseEstado(solicitudSeleccionada.Estado)">@solicitudSeleccionada.Estado</span></div>
                        @if (solicitudSeleccionada.FechaCierre.HasValue)
                        {
                            <div class="col-md-3"><strong>Fecha cierre:</strong> @solicitudSeleccionada.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        }
                    </div>

                    <h6 class="fw-bold text-primary">@solicitudSeleccionada.Titulo</h6>
                    <div class="card mb-3">
                        <div class="card-body" style="white-space: pre-line;">
                            @solicitudSeleccionada.Detalle
                        </div>
                    </div>

                    <h6 class="fw-bold">Historial de avances</h6>
                    @if (solicitudSeleccionada.Avances.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Estado</th>
                                        <th>Comentario</th>
                                        <th>Usuario</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in solicitudSeleccionada.Avances)
                                    {
                                        <tr>
                                            <td>@a.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><span class="badge @ClaseEstado(a.Estado)">@a.Estado</span></td>
                                            <td style="white-space: pre-line;">@a.Comentario</td>
                                            <td>@(a.NombreUsuario ?? $"Usuario {a.Usuario}")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Sin avances registrados.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => mostrarDetalle = false">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Crear -->
@if (mostrarCrear)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Nueva Solicitud</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarCrear = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="nuevaSolicitud" OnValidSubmit="CrearSolicitudAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Módulo *</label>
                                <select class="form-select" @bind="nuevaSolicitud.Modulo" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var m in modulos)
                                    {
                                        <option value="@m.Codigo">@m.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tipo *</label>
                                <select class="form-select" @bind="nuevaSolicitud.TipoSolicitud" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var t in tiposSolicitud)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Nivel *</label>
                                <select class="form-select" @bind="nuevaSolicitud.Nivel" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var n in niveles)
                                    {
                                        <option value="@n">@n</option>
                                    }
                                </select>
                            </div>
                            @if (esAdmin)
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Usuario solicitante</label>
                                    <select class="form-select" @bind="nuevaSolicitud.UsuarioSolicitante">
                                        <option value="">Yo (usuario actual)</option>
                                        @foreach (var u in usuariosCombo)
                                        {
                                            <option value="@u.Key">@u.Value</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="col-12">
                                <label class="form-label">Título *</label>
                                <input type="text" class="form-control" @bind="nuevaSolicitud.Titulo" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Detalle *</label>
                                <textarea class="form-control" rows="6" @bind="nuevaSolicitud.Detalle" required></textarea>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Guardar
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="() => mostrarCrear = false">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Avance -->
@if (mostrarAvance && solicitudSeleccionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Agregar Avance - Solicitud Nº @solicitudSeleccionada.Id</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarAvance = false"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="nuevoAvance" OnValidSubmit="GuardarAvanceAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nuevo estado *</label>
                                <select class="form-select" @bind="nuevoAvance.Estado" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var e in estados)
                                    {
                                        <option value="@e">@e</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Comentario *</label>
                                <textarea class="form-control" rows="4" @bind="nuevoAvance.Comentario" required></textarea>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i> Guardar Avance
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="() => mostrarAvance = false">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool validando = true;
    private bool esAdmin = false;
    private bool esSuperAdmin = false;
    private short currentUserId = 0;

    private List<SolicitudListadoDTO>? solicitudes;
    private SolicitudDetalleDTO? solicitudSeleccionada;
    private bool cargando = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private const int recordsNumber = 15;

    // Filtros
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string moduloFiltro = string.Empty;
    private string tipoFiltro = string.Empty;
    private string nivelFiltro = string.Empty;
    private string estadoFiltro = string.Empty;
    private int? numeroFiltro;
    private int? usuarioFiltro;
    private bool verTodos = false;

    // Combos
    private List<SegModulo> modulos = new();
    private List<string> tiposSolicitud = new() { "Nuevo", "Modificación", "Corrección / Error", "Consulta" };
    private List<string> niveles = new() { "Urgente", "En corto período", "Sin urgencia" };
    private List<string> estados = new() { "Ingresado", "En desarrollo", "Instalado", "En prueba", "Usuario aprobó", "Cerrado", "Pausado", "Cancelado" };
    private Dictionary<int, string> usuariosCombo = new();

    // Modales
    private bool mostrarCrear = false;
    private bool mostrarDetalle = false;
    private bool mostrarAvance = false;
    private CrearSolicitudDTO nuevaSolicitud = new();
    private CrearSolicitudAvanceDTO nuevoAvance = new();

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        esAdmin = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).LocalPath.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase);
        var rutaAcceso = esAdmin ? "/admin/seguimiento-solicitudes" : "/seguimiento-solicitudes";

        await PageAccess.RequiereAccesoAsync(rutaAcceso);
        validando = false;

        currentUserId = await CurrentUserService.GetIdFlexoftAsync();
        esSuperAdmin = await CurrentUserService.EsSuperAdminAsync();

        if (!esAdmin)
            usuarioFiltro = currentUserId;

        await CargarCombos();
        await LoadAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (e.Location.Contains("seguimiento-solicitudes", StringComparison.OrdinalIgnoreCase))
        {
            _ = InvokeAsync(RecargarAsync);
        }
    }

    private async Task RecargarAsync()
    {
        var nuevoEsAdmin = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).LocalPath.StartsWith("/admin/", StringComparison.OrdinalIgnoreCase);
        if (nuevoEsAdmin == esAdmin)
            return;

        esAdmin = nuevoEsAdmin;
        usuarioFiltro = esAdmin ? null : currentUserId;
        currentPage = 1;

        if (esAdmin && usuariosCombo.Count == 0)
            await CargarCombos();

        await LoadAsync();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task CargarCombos()
    {
        var modResponse = await repository.Get<List<SegModulo>>("api/segmodulos");
        if (!modResponse.Error && modResponse.Response != null)
            modulos = modResponse.Response;

        if (esAdmin)
        {
            var userResponse = await repository.Get<Dictionary<int, string>>("api/Usuarios/combo");
            if (!userResponse.Error && userResponse.Response != null)
                usuariosCombo = userResponse.Response;
        }
    }

    private string ConstruirQueryString(string urlBase, bool esTotalPages)
    {
        var qs = new List<string>();
        qs.Add($"page={currentPage}");
        qs.Add($"recordsNumber={recordsNumber}");

        if (fechaDesde.HasValue)
            qs.Add($"fechaDesde={fechaDesde.Value:yyyy-MM-dd}");
        if (fechaHasta.HasValue)
            qs.Add($"fechaHasta={fechaHasta.Value:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(moduloFiltro))
            qs.Add($"modulo={Uri.EscapeDataString(moduloFiltro)}");
        if (!string.IsNullOrWhiteSpace(tipoFiltro))
            qs.Add($"tipoSolicitud={Uri.EscapeDataString(tipoFiltro)}");
        if (!string.IsNullOrWhiteSpace(nivelFiltro))
            qs.Add($"nivel={Uri.EscapeDataString(nivelFiltro)}");
        if (!string.IsNullOrWhiteSpace(estadoFiltro))
            qs.Add($"estado={Uri.EscapeDataString(estadoFiltro)}");
        if (numeroFiltro.HasValue)
            qs.Add($"numero={numeroFiltro.Value}");
        if (esAdmin && usuarioFiltro.HasValue)
            qs.Add($"usuarioFiltro={usuarioFiltro.Value}");
        if (esAdmin && esSuperAdmin)
            qs.Add($"verTodos={verTodos.ToString().ToLowerInvariant()}");

        return qs.Count > 0 ? $"?{string.Join("&", qs)}" : string.Empty;
    }

    private async Task LoadAsync(int page = 1)
    {
        cargando = true;
        currentPage = page;

        var urlBase = esAdmin ? "api/solicitudes/admin" : "api/solicitudes";
        var query = ConstruirQueryString(urlBase, false);
        var totalQuery = ConstruirQueryString(urlBase + "/totalPages", true);

        var response = await repository.Get<List<SolicitudListadoDTO>>($"{urlBase}{query}");
        if (!response.Error && response.Response != null)
        {
            solicitudes = response.Response;
        }
        else if (response.Error)
        {
            await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
        }

        var totalResponse = await repository.Get<double>($"{urlBase}/totalPages{totalQuery}");
        if (!totalResponse.Error && totalResponse.Response != null)
            totalPages = (int)totalResponse.Response;

        cargando = false;
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(currentPage);
    }

    private async Task AplicarFiltros()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LimpiarFiltros()
    {
        fechaDesde = null;
        fechaHasta = null;
        moduloFiltro = string.Empty;
        tipoFiltro = string.Empty;
        nivelFiltro = string.Empty;
        estadoFiltro = string.Empty;
        numeroFiltro = null;
        if (esAdmin)
            usuarioFiltro = null;
        else
            usuarioFiltro = currentUserId;
        verTodos = false;
        currentPage = 1;
        await LoadAsync();
    }

    private async Task AbrirDetalle(int id)
    {
        var response = await repository.Get<SolicitudDetalleDTO>($"api/solicitudes/{id}");
        if (!response.Error && response.Response != null)
        {
            solicitudSeleccionada = response.Response;
            mostrarDetalle = true;
        }
        else
        {
            await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
        }
    }

    private void AbrirCrear()
    {
        nuevaSolicitud = new CrearSolicitudDTO();
        mostrarCrear = true;
    }

    private async Task CrearSolicitudAsync()
    {
        var response = await repository.Post<CrearSolicitudDTO, SolicitudDetalleDTO>("api/solicitudes", nuevaSolicitud);
        if (!response.Error && response.Response != null)
        {
            mostrarCrear = false;
            await sweetAlertService.FireAsync("Confirmación", "Solicitud creada correctamente.", SweetAlertIcon.Success);
            await LoadAsync(currentPage);
        }
        else
        {
            await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
        }
    }

    private void AbrirAvance(SolicitudListadoDTO s)
    {
        solicitudSeleccionada = new SolicitudDetalleDTO
        {
            Id = s.Id,
            Titulo = s.Titulo,
            Estado = s.Estado
        };
        nuevoAvance = new CrearSolicitudAvanceDTO { SolicitudId = s.Id };
        mostrarAvance = true;
    }

    private async Task GuardarAvanceAsync()
    {
        var response = await repository.Post<CrearSolicitudAvanceDTO, SolicitudDetalleDTO>("api/solicitudes/avance", nuevoAvance);
        if (!response.Error && response.Response != null)
        {
            mostrarAvance = false;
            await sweetAlertService.FireAsync("Confirmación", "Avance registrado correctamente.", SweetAlertIcon.Success);
            await LoadAsync(currentPage);
        }
        else
        {
            await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
        }
    }

    private async Task CerrarSolicitudAsync(int id)
    {
        var confirmar = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Cerrar solicitud",
            Text = "¿Confirma que desea cerrar la solicitud?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, cerrar",
            CancelButtonText = "Cancelar"
        });

        if (!confirmar.IsConfirmed)
            return;

        var response = await repository.Post<string, SolicitudDetalleDTO>($"api/solicitudes/{id}/cerrar", "Solicitud cerrada.");
        if (!response.Error && response.Response != null)
        {
            await sweetAlertService.FireAsync("Confirmación", "Solicitud cerrada correctamente.", SweetAlertIcon.Success);
            await LoadAsync(currentPage);
        }
        else
        {
            await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
        }
    }

    private async Task CancelarSolicitudAsync(int id)
    {
        var confirmar = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Cancelar solicitud",
            Text = "¿Confirma que desea cancelar la solicitud?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, cancelar",
            CancelButtonText = "No"
        });

        if (!confirmar.IsConfirmed)
            return;

        var response = await repository.Post<object, SolicitudDetalleDTO>($"api/solicitudes/{id}/cancelar", new { });
        if (!response.Error && response.Response != null)
        {
            await sweetAlertService.FireAsync("Confirmación", "Solicitud cancelada correctamente.", SweetAlertIcon.Success);
            await LoadAsync(currentPage);
        }
        else
        {
            await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
        }
    }

    private string ClaseNivel(string nivel) => nivel switch
    {
        "Urgente" => "bg-danger",
        "En corto período" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string ClaseEstado(string estado) => estado switch
    {
        "Ingresado" => "bg-secondary",
        "En desarrollo" => "bg-primary",
        "Instalado" => "bg-info text-dark",
        "En prueba" => "bg-warning text-dark",
        "Usuario aprobó" => "bg-success",
        "Cerrado" => "bg-success",
        "Pausado" => "bg-dark",
        "Cancelado" => "bg-danger",
        _ => "bg-secondary"
    };
}
