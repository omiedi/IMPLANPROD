@page "/notificaciones/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@using Microsoft.AspNetCore.Components
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Shared.Components
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.DTOs.Notificaciones
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<PageTitle>Notificaciones (Admin)</PageTitle>

<h3>Notificaciones (Admin)</h3>

<div class="mb-3">
    <div class="card mb-2">
        <div class="card-header bg-info text-white p-2">
            <button class="btn btn-link text-white text-decoration-none w-100 text-start p-0"
                    type="button"
                    @onclick="() => mostrarInstructivoUsuario = !mostrarInstructivoUsuario">
                <i class="fas @(mostrarInstructivoUsuario ? "fa-chevron-down" : "fa-chevron-right") me-2"></i>
                <strong>Instructivo para el Usuario</strong>
            </button>
        </div>
        @if (mostrarInstructivoUsuario)
        {
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> ¿Para qué sirve esta pantalla?</h6>
                <p class="mb-2">
                    Desde acá podés administrar notificaciones manuales (crear, editar y eliminar) y definir a quién le aparece.
                </p>

                <h6 class="text-primary"><i class="fas fa-list-check"></i> Acciones</h6>
                <ul class="mb-0">
                    <li><strong>Nueva:</strong> crea una notificación manual.</li>
                    <li><strong>Editar:</strong> cambia título, texto, vencimiento o destinatarios.</li>
                    <li><strong>Borrar:</strong> elimina la notificación (deja de mostrarse a todos los usuarios).</li>
                </ul>
            </div>
        }
    </div>

    <InstructivoDesarrollador>
        <h6 class="text-info"><i class="fas fa-code"></i> API</h6>
        <ul>
            <li><code>GET api/notificaciones/admin</code></li>
            <li><code>GET api/notificaciones/admin/{id}</code></li>
            <li><code>POST api/notificaciones/admin</code></li>
            <li><code>PUT api/notificaciones/admin/{id}</code></li>
            <li><code>DELETE api/notificaciones/admin/{id}</code></li>
        </ul>

        <h6 class="text-info mt-3"><i class="fas fa-sitemap"></i> Servicios involucrados</h6>
        <ul>
            <li><strong>Client:</strong> <code>IRepository</code>, <code>SweetAlertService</code></li>
            <li><strong>Server:</strong> <code>NotificacionesService</code> (métodos Admin), <code>DataContext</code></li>
        </ul>

        <h6 class="text-info mt-3"><i class="fas fa-project-diagram"></i> Flujo (alto nivel)</h6>
        <pre class="bg-light p-2 rounded"><code>OnInitialized
  ↓
GET api/notificaciones/admin
  ↓
Render tabla

Click "Borrar"
  ↓
Confirm SweetAlert
  ↓
DELETE api/notificaciones/admin/{id}
  ↓
GET api/notificaciones/admin (reload)</code></pre>

        <h6 class="text-info mt-3"><i class="fas fa-shield-alt"></i> Validaciones / reglas</h6>
        <ul>
            <li><strong>Listado:</strong> devuelve ítems con <code>DestinatariosResumen</code> (calculado en server).</li>
            <li><strong>Borrado:</strong> elimina notificación y destinatarios asociados (deja de mostrarse).</li>
        </ul>
        <h6 class="text-info mt-3"><i class="fas fa-folder-open"></i> Archivos</h6>
        <ul class="mb-0">
            <li><code>Client/Pages/Notificaciones/AdminIndex.razor</code></li>
            <li><code>Server/Controllers/NotificacionesAdminController.cs</code></li>
            <li><code>Server/Services/NotificacionesService.cs</code></li>
        </ul>
    </InstructivoDesarrollador>
</div>

@if (items is null)
{
    <div class="spinner" />
}
else
{
    <div class="card">
        <div class="card-header">
            <span>
                Notificaciones
                <a class="btn btn-sm btn-primary float-end" href="/notificaciones/admin/create">Nueva</a>
            </span>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th style="width: 80px;">Id</th>
                        <th>Título</th>
                        <th>Resumen</th>
                        <th style="width: 260px;">Destinatarios</th>
                        <th style="width: 180px;">Vence</th>
                        <th style="width: 160px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in items)
                    {
                        <tr>
                            <td>@n.Id</td>
                            <td>@n.Titulo</td>
                            <td>@n.Resumen</td>
                            <td>@n.DestinatariosResumen</td>
                            <td>@(n.FechaExpiracion?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>
                                <a class="btn btn-warning btn-sm" href="/notificaciones/admin/edit/@n.Id">Editar</a>
                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(n.Id)">Borrar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<NotificacionAdminItemDTO>? items;

    private bool mostrarInstructivoUsuario;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var pagination = new PaginationDTO { Page = 1, RecordsNumber = 200 };
        var url = $"api/notificaciones/admin?Page={pagination.Page}&RecordsNumber={pagination.RecordsNumber}&Filter=";

        var response = await repository.Get<List<NotificacionAdminItemDTO>>(url);
        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            items = new List<NotificacionAdminItemDTO>();
            return;
        }

        items = response.Response ?? new List<NotificacionAdminItemDTO>();
    }

    private async Task DeleteAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Realmente deseas eliminar la notificación?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si"
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.Delete($"api/notificaciones/admin/{id}");
        if (responseHTTP.Error)
        {
            var mensajeError = await responseHTTP.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        await LoadAsync();
    }
}
