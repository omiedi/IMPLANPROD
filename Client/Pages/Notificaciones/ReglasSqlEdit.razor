@page "/notificaciones/reglas-sql/edit/{Id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using IMPLANPROD.Client.Shared.Components
@using IMPLANPROD.Shared.DTOs.Notificaciones
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<PageTitle>Editar regla SQL</PageTitle>

<h3>Editar regla SQL</h3>

<div class="mb-3">
    <div class="card mb-2">
        <div class="card-header bg-info text-white p-2">
            <button class="btn btn-link text-white text-decoration-none w-100 text-start p-0"
                    type="button"
                    @onclick="() => mostrarInstructivoUsuario = !mostrarInstructivoUsuario">
                <i class="fas @(mostrarInstructivoUsuario ? "fa-chevron-down" : "fa-chevron-right") me-2"></i>
                <strong>Instructivo para el Usuario</strong>
            </button>
        </div>
        @if (mostrarInstructivoUsuario)
        {
            <div class="card-body">
                <h6 class="text-primary"><i class="fas fa-info-circle"></i> Edición de regla</h6>
                <ul>
                    <li><strong>SQL:</strong> debe seguir siendo un <code>SELECT</code>.</li>
                    <li><strong>Intervalo:</strong> ajusta la frecuencia de ejecución.</li>
                    <li><strong>Max filas detalle:</strong> reduce el tamaño del detalle de la notificación.</li>
                    <li><strong>Activa:</strong> podés activarla/desactivarla desde el listado.</li>
                    <li><strong>Modo de seguimiento:</strong>
                        <ul>
                            <li><strong>Hash (0):</strong> genera notificación si el resultado cambia.</li>
                            <li><strong>Incremental (1):</strong> genera notificación por cada nuevo registro.</li>
                        </ul>
                    </li>
                    <li><strong>Campo de seguimiento:</strong> campo incremental (ej: NroPed, IdOrden) solo requerido en modo Incremental.</li>
                </ul>

                <h6 class="text-primary mt-3"><i class="fas fa-lightbulb"></i> Consejo</h6>
                <p class="mb-0">
                    Si cambiás el SQL, validá que corra rápido en la base antes de dejar la regla activa.
                </p>
            </div>
        }
    </div>

    <InstructivoDesarrollador>
        <h6 class="text-info"><i class="fas fa-code"></i> API</h6>
        <ul class="mb-0">
            <li><code>GET api/notificaciones/reglas-sql/{id}</code></li>
            <li><code>PUT api/notificaciones/reglas-sql/{id}</code></li>
        </ul>

        <h6 class="text-info mt-3"><i class="fas fa-sitemap"></i> Servicios involucrados</h6>
        <ul>
            <li><strong>Client:</strong> <code>IRepository</code>, <code>SweetAlertService</code></li>
            <li><strong>Server:</strong> <code>NotificacionReglasSqlService</code>, <code>DataContext</code></li>
        </ul>

        <h6 class="text-info mt-3"><i class="fas fa-project-diagram"></i> Flujo (alto nivel)</h6>
        <pre class="bg-light p-2 rounded"><code>OnInitialized
  ↓
GET api/notificaciones/reglas-sql/{id}
  ↓
Render form

Submit
  ↓
PUT api/notificaciones/reglas-sql/{id}
  ↓
Server valida SQL (solo SELECT)
  ↓
NavigateTo /notificaciones/reglas-sql</code></pre>

        <h6 class="text-info mt-3"><i class="fas fa-shield-alt"></i> Validaciones / reglas</h6>
        <ul class="mb-0">
            <li><strong>SQL:</strong> el server valida que sea <code>SELECT</code>.</li>
            <li><strong>Carga:</strong> evitar consultas pesadas; limitar con <code>MaxFilasDetalle</code>.</li>
        </ul>
    </InstructivoDesarrollador>
</div>

@if (model is null)
{
    <div class="spinner" />
}
else
{
    <EditForm Model="model" OnValidSubmit="UpdateAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Título</label>
            <InputText class="form-control" @bind-Value="model.Titulo" />
            <ValidationMessage For="() => model.Titulo" />
        </div>

        <div class="mb-3">
            <label class="form-label">Resumen</label>
            <InputText class="form-control" @bind-Value="model.Resumen" />
        </div>

        <div class="row">
            <div class="col-md-3 mb-3">
                <label class="form-label">Activa</label>
                <InputCheckbox class="form-check-input ms-2" @bind-Value="model.Activa" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Intervalo (min)</label>
                <InputNumber class="form-control" @bind-Value="model.IntervaloMinutos" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Max filas detalle</label>
                <InputNumber class="form-control" @bind-Value="model.MaxFilasDetalle" />
            </div>
            <div class="col-md-3 mb-3">
                <label class="form-label">Para todos</label>
                <InputCheckbox class="form-check-input ms-2" @bind-Value="model.EsParaTodos" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Modo de seguimiento</label>
                <InputSelect class="form-select" @bind-Value="model.ModoSeguimiento">
                    <option value="0">Hash (cambios en resultado)</option>
                    <option value="1">Incremental (nuevos registros)</option>
                </InputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Campo de seguimiento</label>
                <InputText class="form-control" @bind-Value="model.CampoSeguimiento" placeholder="Ej: NroPed, IdOrden" disabled="@EsModoHash" />
                <small class="text-muted">Solo para modo Incremental. Campo incremental del SQL.</small>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">SQL (solo SELECT)</label>
            <InputTextArea class="form-control" @bind-Value="model.SqlQuery" rows="12" />
            <ValidationMessage For="() => model.SqlQuery" />
            @if (model.ModoSeguimiento == 1)
            {
                <small class="text-info">
                    <i class="fas fa-info-circle"></i> En modo Incremental, usa <code>@@UltimoValorProcesado</code> en el WHERE (ej: WHERE NroPed > @@UltimoValorProcesado)
                </small>
            }
        </div>

        @if (!model.EsParaTodos)
        {
            <div class="mb-3">
                <label class="form-label">Destinatarios</label>
                <div style="max-height: 260px; overflow-y: auto;" class="border rounded p-2">
                    @if (usuarios != null)
                    {
                        @foreach (var u in usuarios)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="usr_@u.Id" @bind="selected[u.Id]" />
                                <label class="form-check-label" for="usr_@u.Id">@u.NombreUsuario (Id: @u.Id)</label>
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-muted">Cargando usuarios...</small>
                    }
                </div>
            </div>
        }

        <button class="btn btn-primary" type="submit">Guardar</button>
        <button class="btn btn-secondary" type="button" @onclick="Return">Volver</button>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private NotificacionReglaSqlUpsertDTO? model;
    private List<Usuario>? usuarios;
    private Dictionary<int, bool> selected = new();

    private bool mostrarInstructivoUsuario;

    private bool EsModoHash()
    {
        return model?.ModoSeguimiento == 0;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsuariosAsync();
        await LoadAsync();
    }

    private async Task LoadUsuariosAsync()
    {
        var response = await repository.Get<List<Usuario>>("/api/Usuarios/activos");
        if (!response.Error)
        {
            usuarios = response.Response;
            // Inicializar selected con todos los usuarios en false
            foreach (var u in usuarios)
            {
                selected[u.Id] = false;
            }
        }
    }

    private async Task LoadAsync()
    {
        var response = await repository.Get<NotificacionReglaSqlUpsertDTO>($"api/notificaciones/reglas-sql/{Id}");
        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            navigationManager.NavigateTo("/notificaciones/reglas-sql");
            return;
        }

        model = response.Response;
        if (model is null)
        {
            navigationManager.NavigateTo("/notificaciones/reglas-sql");
            return;
        }

        // Inicializar selected basado en DestinatariosIds
        if (!string.IsNullOrWhiteSpace(model.DestinatariosIds))
        {
            var ids = model.DestinatariosIds.Split(',', StringSplitOptions.RemoveEmptyEntries);
            foreach (var idStr in ids)
            {
                if (int.TryParse(idStr.Trim(), out int usuarioId))
                {
                    selected[usuarioId] = true;
                }
            }
        }
    }

    private async Task UpdateAsync()
    {
        if (model is null)
        {
            return;
        }

        // Validación: si es modo incremental, debe tener CampoSeguimiento
        if (model.ModoSeguimiento == 1 && string.IsNullOrWhiteSpace(model.CampoSeguimiento))
        {
            await sweetAlertService.FireAsync("Validación", "En modo Incremental debe especificar el Campo de seguimiento (ej: NroPed, IdOrden)", SweetAlertIcon.Warning);
            return;
        }

        // Validación: si no es para todos, debe haber al menos un destinatario
        if (!model.EsParaTodos)
        {
            var selectedIds = selected.Where(x => x.Value).Select(x => x.Key).ToList();
            if (selectedIds.Count == 0)
            {
                await sweetAlertService.FireAsync("Validación", "Si no es para todos, debe seleccionar al menos un destinatario", SweetAlertIcon.Warning);
                return;
            }
            model.DestinatariosIds = string.Join(",", selectedIds);
        }
        else
        {
            model.DestinatariosIds = null;
        }

        var httpResponse = await repository.Put($"api/notificaciones/reglas-sql/{Id}", model);
        if (httpResponse.Error)
        {
            var message = await httpResponse.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        Return();
    }

    private void Return()
    {
        navigationManager.NavigateTo("/notificaciones/reglas-sql");
    }
}
