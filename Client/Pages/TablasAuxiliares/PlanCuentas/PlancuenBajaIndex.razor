@page "/TablasAuxiliares/PlanCuentas/PlancuenBaja"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS

@using System.Net.Http
@using CurrieTechnologies.Razor.SweetAlert2

<div class="bg-warning text-dark text-center p-3 mb-4">
    <h1>Cuentas Dadas de Baja</h1>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center">
        <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar cuenta..." @bind-value="Filter" />
        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>
    
    <div>
        <a href="/TablasAuxiliares/PlanCuentas/Plancuen" class="btn btn-sm btn-primary">
            <i class="fas fa-arrow-left"></i> Volver a Cuentas Activas
        </a>
    </div>
</div>

<Pagination CurrentPage="currentPage"
            TotalPages="totalPages"
            SelectedPage="SelectedPageAsync" />

<GenericList MyList="cuentas">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Código Externo</th>
                    <th>Código Interno</th>
                    <th>Denominación</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cuenta in cuentas!)
                {
                    <tr>
                        <td>@cuenta.Id</td>
                        <td>@cuenta.CodExCue</td>
                        <td>@cuenta.CodInCue</td>
                        <td>@cuenta.Denocue</td>
                        <td>@cuenta.TipoCue</td>
                        <td>
                            <span class="badge bg-danger">Inactivo</span>
                        </td>
                        <td>
                            <button class="btn btn-success btn-sm" @onclick=@(() => RestoreAsync(cuenta.Id))>
                                <i class="fas fa-undo"></i> Restaurar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick=@(() => DeletePermanentlyAsync(cuenta.Id))>
                                <i class="fas fa-trash"></i> Eliminar Definitivamente
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@code {
    public List<Plancuen>? cuentas { get; set; } = new();

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages;

    protected async override Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int page = 1)
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(Page))
            {
                page = Convert.ToInt32(Page);
            }

            string url1 = string.Empty;
            string url2 = string.Empty;

            if (string.IsNullOrEmpty(Filter))
            {
                url1 = $"api/plancuen?page={page}&estado=-1";
                url2 = $"api/plancuen/totalPages?estado=-1";
            }
            else
            {
                url1 = $"api/plancuen?page={page}&filter={Filter}&estado=-1";
                url2 = $"api/plancuen/totalPages?filter={Filter}&estado=-1";
            }

            var responseHppt = await repository.Get<List<Plancuen>>(url1);
            var responseHppt2 = await repository.Get<int>(url2);
            
            // Inicializar la lista aunque esté vacía para evitar el spinner infinito
            cuentas = responseHppt.Response ?? new List<Plancuen>();
            totalPages = responseHppt2.Response;
            
            Console.WriteLine($"Cuentas inactivas cargadas: {cuentas.Count}, Total páginas: {totalPages}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar cuentas inactivas: {ex.Message}");
            // Inicializar lista vacía en caso de error
            cuentas = new List<Plancuen>();
            totalPages = 0;
        }
    }

    private async Task RestoreAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Realmente deseas restaurar esta cuenta?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si"
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.Put($"api/plancuen/Restaura/{id}", new { });
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await sweetAlertService.FireAsync("Éxito", "La cuenta ha sido restaurada correctamente.", SweetAlertIcon.Success);
            await LoadAsync();
        }
    }

    private async Task DeletePermanentlyAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¡ATENCIÓN!",
            Text = "¿Realmente deseas ELIMINAR DEFINITIVAMENTE esta cuenta? Esta acción NO se puede deshacer.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si, eliminar definitivamente",
            ConfirmButtonColor = "#d33"
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHTTP = await repository.Delete($"api/plancuen/{id}");

        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await sweetAlertService.FireAsync("Éxito", "La cuenta ha sido eliminada definitivamente.", SweetAlertIcon.Success);
            await LoadAsync();
        }
    }

    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }
}
