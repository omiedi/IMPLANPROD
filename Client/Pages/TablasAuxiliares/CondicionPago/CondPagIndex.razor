@page "/TablasAuxiliares/CondicionPago/CondPag"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS

@using System.Net.Http
@using CurrieTechnologies.Razor.SweetAlert2
@using Blazored.Modal
@using Blazored.Modal.Services

<div class="bg-primary text-white text-center p-3 mb-4">
    <h1>Condiciones de Pago</h1>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center">
        <div class="me-2">
            <a class="btn btn-sm btn-primary" @onclick=@(() => ShowModal())><i class="oi oi-plus"></i> Nueva Condición de Pago</a>
        </div>

        <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar condición de pago..." @bind-value="Filter" />
        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>
    
    <div>
        <a href="/TablasAuxiliares/CondicionPago/CondPagBaja" class="btn btn-sm btn-warning">
            <i class="fas fa-trash-restore"></i> Restaurar Condición de Pago de Baja
        </a>
    </div>
</div>

<Pagination CurrentPage="currentPage"
            TotalPages="totalPages"
            SelectedPage="SelectedPageAsync" />

<GenericList MyList="condPags">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Número</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var condPag in condPags!)
                {
                    <tr>
                        <td>@condPag.Id</td>
                        <td>@condPag.NumCondPag</td>
                        <td>@condPag.DescCondPag</td>
                        <td>
                            <a @onclick=@(() => ShowModalEdit(condPag.Id)) class="btn btn-warning btn-sm">
                                <i class="oi oi-pencil"></i> Editar
                            </a>
                            <button class="btn btn-danger btn-sm" @onclick=@(() => DeleteAsync(condPag))>
                                <i class="oi oi-trash"></i> Borrar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@code {
    private List<CondPag>? condPags;
    private int currentPage = 1;
    private int totalPages;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = "";

    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task ShowModal()
    {
        var modalResult = await Modal.Show<CondPagCreate>().Result;
        if (modalResult.Confirmed)
        {
            await LoadAsync();
            await sweetAlertService.FireAsync("Confirmado", "Condición de pago creada exitosamente.", SweetAlertIcon.Success);
        }
    }

    private async Task ShowModalEdit(int id)
    {
        var parameters = new ModalParameters();
        parameters.Add("Id", id);
        var modalResult = await Modal.Show<CondPagEdit>("", parameters).Result;
        if (modalResult.Confirmed)
        {
            await LoadAsync();
            await sweetAlertService.FireAsync("Confirmado", "Condición de pago modificada exitosamente.", SweetAlertIcon.Success);
        }
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/condpag?page={page}&estado=0";
            url2 = $"api/condpag/totalPages?page={page}&estado=0";
        }
        else
        {
            url1 = $"api/condpag?page={page}&filter={Filter}&estado=0";
            url2 = $"api/condpag/totalPages?page={page}&filter={Filter}&estado=0";
        }

        var responseHppt = await repository.Get<List<CondPag>>(url1);
        var responseHppt2 = await repository.Get<int>(url2);
        condPags = responseHppt.Response ?? new List<CondPag>();
        totalPages = responseHppt2.Response!;
    }

    private async Task DeleteAsync(CondPag condPag)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = $"¿Realmente deseas eliminar la condición de pago '{condPag.DescCondPag}'?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si"
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHttp = await repository.Delete($"/api/condpag/cambiaStatus/{condPag.Id}/-1");
        if (responseHttp.Error)
        {
            if (responseHttp.HttpResponseMessage.StatusCode != HttpStatusCode.NotFound)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }
        }

        await LoadAsync();
        await sweetAlertService.FireAsync("Confirmado", $"La condición de pago '{condPag.DescCondPag}' ha sido dada de baja exitosamente.", SweetAlertIcon.Success);
    }

    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
        await SelectedPageAsync(page);
    }
}
