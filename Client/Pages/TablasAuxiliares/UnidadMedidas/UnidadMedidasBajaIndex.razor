@page "/TablasAuxiliares/Umedida/UmedidaBaja"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS

@using System.Net.Http
@using CurrieTechnologies.Razor.SweetAlert2

<!-- Componente para listar y gestionar familias inactivas -->
<div class="bg-primary text-white text-center p-3 mb-4">
    <h1>Unidad de medidas inactivas</h1>
</div>
<div class="mb-3">
    <a class="btn btn-success" href="/TablasAuxiliares/Umedida/Umedida">Volver</a>
</div>

<div class="d-flex align-items-center mb-3">
    <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar unidad de m..." @bind-value="Filter" />
    <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
    <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
</div>

<Pagination CurrentPage="currentPage"
            TotalPages="totalPages"
            SelectedPage="SelectedPageAsync" />

<GenericList MyList="umedida">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in umedida!)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.DescripcionAbreviada</td>
                        <td>@item.Descripcion</td>
                        <td>
                            <button class="btn btn-success" @onclick=@(() => Activar(item))>Activar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@code {
    public List<UnidadMedidas>? umedida { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages;

    protected async override Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/umedidas?page={page}&estado=-1";
            url2 = $"api/umedidas/totalPages?estado=-1";
        }
        else
        {
            url1 = $"api/umedidas?page={page}&filter={Filter}&estado=-1";
            url2 = $"api/umedidas/totalPages?filter={Filter}&estado=-1";
        }

        var responseHppt = await repository.Get<List<UnidadMedidas>>(url1);
        var responseHppt2 = await repository.Get<int>(url2);
        umedida = responseHppt.Response!;
        totalPages = responseHppt2.Response!;
    }

    private async Task Activar(UnidadMedidas Unimedida)
    {
        var confirm = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
                Text = $"¿Está seguro que quiere activar la unidad de medida: {Unimedida.Descripcion}?",
                Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        if (string.IsNullOrEmpty(confirm.Value)) { return; }

        Unimedida.status = 0;
        var responseHttp = await repository.Put($"api/umedidas", Unimedida);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        await LoadAsync();
        var toast = sweetAlertService.Mixin(new SweetAlertOptions
        {
            Toast = true,
            Position = SweetAlertPosition.BottomEnd,
            ShowConfirmButton = false,
            Timer = 3000
        });
        await toast.FireAsync(icon: SweetAlertIcon.Success, message: "Unidad de medida activada con éxito.");
    }

    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }
}
