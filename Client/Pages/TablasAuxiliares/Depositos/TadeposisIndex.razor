@page "/TablasAuxiliares/Depositos/Tadeposi"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS

@using System.Net.Http
@using CurrieTechnologies.Razor.SweetAlert2

<div class="bg-primary text-white text-center p-3 mb-4">
    <h1>Depósitos</h1>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center">
        <div class="me-2">
            <button class="btn btn-sm btn-primary" @onclick="() => ShowModal()">
                <i class="fas fa-plus"></i> Nuevo Depósito
            </button>
        </div>

    <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar depósito..." @bind-value="Filter" />
    <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
    <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>
    <div>
        <a href="/TablasAuxiliares/Depositos/TadeposiBaja" class="btn btn-sm btn-warning">
            <i class="fas fa-trash-restore"></i> Restaurar Depósitos de Baja
        </a>
    </div>
</div>

<Pagination CurrentPage="currentPage"
            TotalPages="totalPages"
            SelectedPage="SelectedPageAsync" />

<GenericList MyList="depositos">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var deposito in depositos!)
                {
                    <tr>
                        <td>@deposito.Id</td>
                        <td>@deposito.CodigoDepo</td>
                        <td>@deposito.Descripcion</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-2" @onclick="() => ShowModal(deposito.Id,true)">
                                <i class="fas fa-edit"></i> Editar
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(deposito.Id)">
                                <i class="fas fa-trash"></i> Borrar
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@code {

    public List<Tadeposi>? depositos { get; set; }

    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages;

    protected async override Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        string estado = "0";
        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/tadeposi?page={page}&estado={estado}"; // Agregar estado a la URL X DEFECTO TOMA 0
            url2 = $"api/tadeposi/totalPages?estado={estado}"; // Agregar estado a la URL
        }
        else
        {
            url1 = $"api/tadeposi?page={page}&filter={Filter}&estado={estado}"; // Agregar estado a la URL
            url2 = $"api/tadeposi/totalPages?filter={Filter}&estado={estado}"; // Agregar estado a la URL

        }

        var responseHppt = await repository.Get<List<Tadeposi>>(url1);
        var responseHppt2 = await repository.Get<int>(url2);
        depositos = responseHppt.Response!;
        totalPages = responseHppt2.Response!;
    }

    private async Task DeleteAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmación",
                Text = "¿Realmente deseas eliminar el registro?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                CancelButtonText = "No",
                ConfirmButtonText = "Si"
            });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        int status = -1;
        var responseHTTP = await repository.Delete($"api/tadeposi/cambiaStatus/{id}/{status}");
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await LoadAsync();
        }
    }

    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private async Task ShowModal(int id = 0, bool isEdit = false)
    {
        IModalReference modalReference;

        if (isEdit)
        {
            modalReference = Modal.Show<TadeposiEdit>(string.Empty, new ModalParameters().Add("Id", id));
        }
        else
        {
            modalReference = Modal.Show<TadeposiCreate>();
        }

        var result = await modalReference.Result;
        if (result.Confirmed)
        {
            await LoadAsync();
        }
    }
}
