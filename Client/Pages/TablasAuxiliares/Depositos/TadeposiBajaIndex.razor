@page "/TablasAuxiliares/Depositos/TadeposiBaja"
@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService sweetAlertService

<h3>Depositos Dados de Baja</h3>

<div class="mb-3">
    <a class="btn btn-success" href="/TablasAuxiliares/Depositos/Tadeposi">Volver</a>
</div>

<GenericList MyList="Tadeposis">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    @* <th>Estado</th> *@
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Tadeposis!)
                {
                    <tr>
                        <td>@item.CodigoDepo</td>
                        <td>@item.Descripcion</td>
                        @* <td>@item.Status</td> *@
                        <td>
                            <button class="btn btn-success" @onclick=@(() => Activar(item))>Activar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@code {

    public List<Tadeposi>? Tadeposis { get; set; }
    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;
    private int currentPage = 1;
    private int totalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        string estado = "-1";
        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/tadeposi?page={page}&estado={estado}"; // Agregar estado a la URL X DEFECTO TOMA 0
            url2 = $"api/tadeposi/totalPages?estado={estado}"; // Agregar estado a la URL
        }
        else
        {
            url1 = $"api/tadeposi?page={page}&filter={Filter}&estado={estado}"; // Agregar estado a la URL
            url2 = $"api/tadeposi/totalPages?filter={Filter}&estado={estado}"; // Agregar estado a la URL

        }

        var responseHppt = await repository.Get<List<Tadeposi>>(url1);
        var responseHppt2 = await repository.Get<int>(url2);
        Tadeposis = responseHppt.Response!;
        totalPages = responseHppt2.Response!;
    }


    private async Task Activar(Tadeposi tadeposi)
    {
        var confirm = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmación",
                Text = $"¿Está seguro que quiere activar el depósito: {tadeposi.Descripcion}?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true
            });

        if (string.IsNullOrEmpty(confirm.Value)) { return; }

        int status = 0;
        int Id = tadeposi.Id;
        var responseHTTP = await repository.Delete($"api/tadeposi/cambiaStatus/{Id}/{status}");


        if (responseHTTP.Error)
        {
            var message = await responseHTTP.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        await LoadAsync();

    }
    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }
}
