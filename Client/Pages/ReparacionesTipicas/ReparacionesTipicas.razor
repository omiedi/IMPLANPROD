    private async Task EliminarRepuesto(RepuestoReparacionDTO repuesto)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¿Confirmar eliminación?",
            Text = $"¿Está seguro de eliminar el material {repuesto.CodigoExterno} - {repuesto.Descripcion}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            try
            {
                var responseHttp = await repository.Delete($"api/repuesre/{repuesto.Id}");
                
                if (responseHttp.Error)
                {
                    var message = await responseHttp.GetErrorMessageAsync();
                    await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                    return;
                }

                // Eliminar de la lista local
                repuestos?.Remove(repuesto);

                await sweetAlertService.FireAsync("Eliminado", "Material eliminado correctamente", SweetAlertIcon.Success);
            }
            catch (Exception ex)
            {
                await sweetAlertService.FireAsync("Error", $"Error al eliminar: {ex.Message}", SweetAlertIcon.Error);
            }
        }
    }

