            guardandoObservacion = false;
        }
    }

    private async Task GuardarHorasOperacion()
    {
        if (operacionSeleccionada == null)
            return;

        try
        {
            // Convertir el formato hh:mm:ss a horas decimales
            var horasDecimales = ConvertirHorasFormatoADecimal(horasFormateadas);
            
            if (horasDecimales < 0)
            {
                await sweetAlertService.FireAsync("Error", "Formato de horas inválido. Use el formato hh:mm:ss (ejemplo: 02:30:00)", SweetAlertIcon.Error);
                // Restaurar el valor anterior
                horasFormateadas = FormatearHoras(operacionSeleccionada.Horas);
                return;
            }

            operacionSeleccionada.Horas = horasDecimales;

            var responseHttp = await repository.Put($"api/secoprep/{operacionSeleccionada.Id}", operacionSeleccionada);
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                // Restaurar el valor anterior
                horasFormateadas = FormatearHoras(operacionSeleccionada.Horas);
            }
            else
            {
                await sweetAlertService.FireAsync("Éxito", "Horas actualizadas correctamente", SweetAlertIcon.Success);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al guardar horas: {ex.Message}", SweetAlertIcon.Error);
            // Restaurar el valor anterior
            horasFormateadas = FormatearHoras(operacionSeleccionada.Horas);
        }
    }

    private double ConvertirHorasFormatoADecimal(string horasFormato)
    {
        try
        {
            // Validar formato hh:mm:ss
            if (string.IsNullOrWhiteSpace(horasFormato))
                return 0;

            var partes = horasFormato.Split(':');
            if (partes.Length != 3)
                return -1;

            if (!int.TryParse(partes[0], out int horas) || 
                !int.TryParse(partes[1], out int minutos) || 
                !int.TryParse(partes[2], out int segundos))
                return -1;

            // Validar rangos
            if (horas < 0 || minutos < 0 || minutos > 59 || segundos < 0 || segundos > 59)
                return -1;

            // Convertir a horas decimales
            double totalHoras = horas + (minutos / 60.0) + (segundos / 3600.0);
            return totalHoras;
        }
        catch
        {
            return -1;
        }
    }

