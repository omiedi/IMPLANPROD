@page "/presupuestos-reparacion"
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Services
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject PageAccessService PageAccess

<PageTitle>Presupuestos de Reparación</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
<div class="container-fluid">
    <!-- Título de la página -->
    <div class="mb-4">
        <h2 class="text-center fw-bold text-primary">
            <i class="fas fa-file-invoice-dollar me-2"></i>
            PRESUPUESTOS DE REPARACIÓN
        </h2>
        <hr class="border-primary border-2 opacity-50" />
    </div>

    <!-- Botones de acción -->
    <div class="mb-3">
        <div class="d-flex gap-2">
            <button class="btn btn-success" @onclick="NuevoPresupuesto">
                <i class="fas fa-plus"></i> Nuevo Presupuesto
            </button>
        </div>
    </div>

    <!-- Filtros de búsqueda -->
    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0">
                <i class="fas fa-filter"></i> Filtros de Búsqueda
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-2">
                    <label class="form-label fw-bold">ID:</label>
                    <input type="number" class="form-control" @bind="filtroId" @bind:event="oninput" placeholder="ID..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">N° Reparación:</label>
                    <input type="number" class="form-control" @bind="filtroNumRepa" @bind:event="oninput" placeholder="N° Repa..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">N° Pedido:</label>
                    <input type="number" class="form-control" @bind="filtroNroPed" @bind:event="oninput" placeholder="N° Pedido..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Fecha Desde:</label>
                    <input type="date" class="form-control" @bind="filtroFechaDesde" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Fecha Hasta:</label>
                    <input type="date" class="form-control" @bind="filtroFechaHasta" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">N° Cliente:</label>
                    <input type="number" class="form-control" @bind="filtroNumeCli" @bind:event="oninput" placeholder="N° Cliente..." />
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Razón Social:</label>
                    <input type="text" class="form-control" @bind="filtroRasoCli" @bind:event="oninput" placeholder="Razón Social..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Código Reparación:</label>
                    <input type="text" class="form-control" @bind="filtroCodRepa" @bind:event="oninput" placeholder="Código..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">N° Orden Rep.:</label>
                    <input type="text" class="form-control" @bind="filtroNuOrdRep" @bind:event="oninput" placeholder="N° Orden..." />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="ApplyFilterAsync">
                        <i class="fas fa-filter"></i> Filtrar
                    </button>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12 text-end">
                    <button class="btn btn-outline-secondary" @onclick="CleanFilterAsync">
                        <i class="fas fa-eraser"></i> Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Paginación superior -->
    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />

    <!-- Tabla de presupuestos -->
    <div class="card">
        <div class="card-body">
            @if (presupuestos == null)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (!presupuestos.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> No se encontraron presupuestos de reparación.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>N° Repa</th>
                                <th>Referencia</th>
                                <th>Fecha Recep.</th>
                                <th>N° Cliente</th>
                                <th>Razón Social</th>
                                <th>N° Pedido</th>
                                <th>Cód. Repa</th>
                                <th>N° Ord. Rep.</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var presupuesto in presupuestos)
                            {
                                <tr>
                                    <td>@presupuesto.Id</td>
                                    <td><strong>@presupuesto.NumRepa</strong></td>
                                    <td>@presupuesto.Referen2</td>
                                    <td>@presupuesto.FechRecep?.ToString("dd/MM/yyyy")</td>
                                    <td>@presupuesto.Nume_Cli</td>
                                    <td>@presupuesto.Raso_Cli</td>
                                    <td>@presupuesto.NroPed</td>
                                    <td>@presupuesto.CodRepa</td>
                                    <td>@presupuesto.NuOrdRep</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-info" 
                                                    @onclick="(() => VerPresupuesto(presupuesto.NumRepa))" 
                                                    title="Ver">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary" 
                                                    @onclick="(() => EditarPresupuesto(presupuesto.NumRepa))" 
                                                    title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Paginación inferior -->
    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />
</div>
}

@code {
    private List<Repara>? presupuestos;
    private int currentPage = 1;
    private int totalPages;
    private bool validando = true;

    // Filtros
    private int? filtroId;
    private int? filtroNumRepa;
    private int? filtroNroPed;
    private DateTime? filtroFechaDesde;
    private DateTime? filtroFechaHasta;
    private int? filtroNumeCli;
    private string filtroRasoCli = string.Empty;
    private string filtroCodRepa = string.Empty;
    private string filtroNuOrdRep = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
        await PageAccess.RequiereAccesoAsync("/presupuestos-reparacion");
        validando = false;
        
        await LoadAsync();
    }

    private async Task LoadAsync(int page = 1)
    {
        try
        {
            // Construir URL con parámetros de consulta
            var url = $"api/repara/presupuestos?page={page}&recordsNumber=10";

            // Agregar filtros solo si tienen valores válidos
            if (filtroId.HasValue && filtroId > 0)
            {
                url += $"&filtroId={filtroId}";
            }

            if (filtroNumRepa.HasValue && filtroNumRepa > 0)
            {
                url += $"&filtroNumRepa={filtroNumRepa}";
            }

            if (filtroNroPed.HasValue && filtroNroPed > 0)
            {
                url += $"&filtroNroPed={filtroNroPed}";
            }

            if (filtroFechaDesde.HasValue)
            {
                url += $"&filtroFechaDesde={filtroFechaDesde.Value:yyyy-MM-dd}";
            }

            if (filtroFechaHasta.HasValue)
            {
                url += $"&filtroFechaHasta={filtroFechaHasta.Value:yyyy-MM-dd}";
            }

            if (filtroNumeCli.HasValue && filtroNumeCli > 0)
            {
                url += $"&filtroNumeCli={filtroNumeCli}";
            }

            if (!string.IsNullOrWhiteSpace(filtroRasoCli))
            {
                url += $"&filtroRasoCli={Uri.EscapeDataString(filtroRasoCli)}";
            }

            if (!string.IsNullOrWhiteSpace(filtroCodRepa))
            {
                url += $"&filtroCodRepa={Uri.EscapeDataString(filtroCodRepa)}";
            }

            if (!string.IsNullOrWhiteSpace(filtroNuOrdRep))
            {
                url += $"&filtroNuOrdRep={Uri.EscapeDataString(filtroNuOrdRep)}";
            }

            Console.WriteLine($"Cargando presupuestos desde: {url}");

            var responseHttp = await repository.Get<List<Repara>>(url);
            
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar presupuestos: {message}", SweetAlertIcon.Error);
                return;
            }

            presupuestos = responseHttp.Response;
            Console.WriteLine($"Se cargaron {presupuestos?.Count ?? 0} presupuestos");

            await LoadTotalPagesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inesperado: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error inesperado: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private async Task LoadTotalPagesAsync()
    {
        try
        {
            var url = $"api/repara/presupuestos/totalPages?recordsNumber=10";

            // Aplicar los mismos filtros que en LoadAsync
            if (filtroId.HasValue && filtroId > 0)
            {
                url += $"&filtroId={filtroId}";
            }

            if (filtroNumRepa.HasValue && filtroNumRepa > 0)
            {
                url += $"&filtroNumRepa={filtroNumRepa}";
            }

            if (filtroNroPed.HasValue && filtroNroPed > 0)
            {
                url += $"&filtroNroPed={filtroNroPed}";
            }

            if (filtroFechaDesde.HasValue)
            {
                url += $"&filtroFechaDesde={filtroFechaDesde.Value:yyyy-MM-dd}";
            }

            if (filtroFechaHasta.HasValue)
            {
                url += $"&filtroFechaHasta={filtroFechaHasta.Value:yyyy-MM-dd}";
            }

            if (filtroNumeCli.HasValue && filtroNumeCli > 0)
            {
                url += $"&filtroNumeCli={filtroNumeCli}";
            }

            if (!string.IsNullOrWhiteSpace(filtroRasoCli))
            {
                url += $"&filtroRasoCli={Uri.EscapeDataString(filtroRasoCli)}";
            }

            if (!string.IsNullOrWhiteSpace(filtroCodRepa))
            {
                url += $"&filtroCodRepa={Uri.EscapeDataString(filtroCodRepa)}";
            }

            if (!string.IsNullOrWhiteSpace(filtroNuOrdRep))
            {
                url += $"&filtroNuOrdRep={Uri.EscapeDataString(filtroNuOrdRep)}";
            }

            var responseHttp = await repository.Get<int>(url);
            if (responseHttp.Error)
            {
                totalPages = 1;
                return;
            }

            totalPages = responseHttp.Response;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en LoadTotalPagesAsync: {ex.Message}");
            totalPages = 1;
        }
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private async Task ApplyFilterAsync()
    {
        currentPage = 1;
        await LoadAsync(1);
    }

    private async Task CleanFilterAsync()
    {
        filtroId = null;
        filtroNumRepa = null;
        filtroNroPed = null;
        filtroFechaDesde = null;
        filtroFechaHasta = null;
        filtroNumeCli = null;
        filtroRasoCli = string.Empty;
        filtroCodRepa = string.Empty;
        filtroNuOrdRep = string.Empty;
        currentPage = 1;
        await LoadAsync(1);
    }

    private void NuevoPresupuesto()
    {
        navigationManager.NavigateTo("/presupuesto-reparacion/crear");
    }

    private void VerPresupuesto(int numRepa)
    {
        navigationManager.NavigateTo($"/presupuesto-reparacion/ver/{numRepa}");
    }

    private void EditarPresupuesto(int numRepa)
    {
        navigationManager.NavigateTo($"/presupuesto-reparacion/editar/{numRepa}");
    }
}
