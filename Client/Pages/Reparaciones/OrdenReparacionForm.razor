@page "/orden-reparacion/{NumRepa:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using IMPLANPROD.Client.Shared.Components
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Orden de Reparación</h3>

@if (cargando)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-2">Cargando datos de la reparación...</p>
    </div>
}
else if (reparacion == null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> No se encontró la reparación especificada.
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Datos de la Reparación</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label fw-bold">N° Reparación:</label>
                    <input type="text" class="form-control" value="@reparacion.NumRepa" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">N° Orden Reparación:</label>
                    <input type="text" class="form-control" value="@numeroOrdenReparacion" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">N° Pedido:</label>
                    <input type="text" class="form-control" value="@(reparacion.NroPed ?? 0)" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Fecha:</label>
                    <input type="date" class="form-control" @bind="fechaOrdenGeneracion" />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">N° Cliente:</label>
                    <input type="text" class="form-control" value="@(reparacion.Nume_Cli ?? 0)" readonly />
                </div>
                <div class="col-md-9">
                    <label class="form-label fw-bold">Razón Social:</label>
                    <input type="text" class="form-control" value="@reparacion.Raso_Cli" readonly />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Código Reparación:</label>
                    <input type="text" class="form-control" value="@reparacion.CodRepa" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Número de Serie:</label>
                    <input type="text" class="form-control" @bind="reparacion.NumeroSerie" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Referencia 2:</label>
                    <input type="text" class="form-control" @bind="reparacion.Referen2" />
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-8">
                    <label class="form-label fw-bold">Observaciones:</label>
                    <textarea class="form-control" rows="3" @bind="reparacion.Observa"></textarea>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Horas Mano de Obra:</label>
                    <input type="text" class="form-control text-end" value="@(reparacion.HoraMObra?.ToString("N2") ?? "0.00")" readonly />

                    <label class="form-label fw-bold mt-3">Importe Total:</label>
                    <input type="text" class="form-control text-end fw-bold" value="@(reparacion.Imp_Tot?.ToString("N2") ?? "0.00")" readonly />
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Repuestos Presupuestados</h5>
            <button class="btn btn-success btn-sm" @onclick="AbrirSelectorProductos">
                <i class="bi bi-plus-circle"></i> Agregar Repuesto
            </button>
        </div>
        <div class="card-body">
            @if (repuestos == null || !repuestos.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No hay repuestos registrados para esta reparación.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 13%">Cód.Int</th>
                                <th style="width: 13%">Código</th>
                                <th style="width: 30%">Descripción</th>
                                <th style="width: 9%" class="text-end">Cantidad</th>
                                <th style="width: 9%" class="text-end">Stock Disp.</th>
                                <th style="width: 9%" class="text-end">Falta</th>
                                <th style="width: 10%" class="text-end">Precio Unit.</th>
                                <th style="width: 10%" class="text-end">Importe</th>
                                <th style="width: 10%" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in repuestos)
                            {
                                <tr>
                                    <td>@item.CodigoInterno</td>
                                    <td>@item.CodigoExterno</td>
                                    <td>@item.Descripcion</td>
                                    <td class="text-end">@item.Cantidad.ToString("N2")</td>
                                    <td class="text-end">@item.StockDisponible.ToString("N2")</td>
                                    <td class="text-end">@item.Falta.ToString("N2")</td>
                                    <td class="text-end">@(item.PrecioUnitario?.ToString("N2") ?? "0.00")</td>
                                    <td class="text-end">@(item.Importe?.ToString("N2") ?? "0.00")</td>
                                    <td class="text-center">
                                        <button class="btn btn-danger btn-sm" @onclick="() => EliminarRepuesto(item)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary fw-bold">
                                <td colspan="6" class="text-end">Total Repuestos:</td>
                                <td class="text-end">@totalRepuestos.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-success" @onclick="GenerarOrdenReparacion" disabled="@guardando">
            @if (guardando)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            <i class="bi bi-check-circle"></i> Generar Orden de Reparación
        </button>
        <button class="btn btn-secondary ms-2" @onclick="Cancelar">
            <i class="bi bi-x-circle"></i> Cancelar
        </button>
    </div>
}

<!-- Selector de productos para agregar repuestos -->
<SelectorProductos @ref="selectorProductosRef"
PermitirCantidad="true"
PermitirPrecio="true"
CantidadDefault="1"
OnProductoSeleccionadoCantidad="OnProductoSeleccionado"
OnClose="OnCloseSelectorProductos" />

@code {
    [Parameter]
    public int NumRepa { get; set; }

    private Repara? reparacion;
    private List<RepuestoOrdenReparacion>? repuestos;
    private int numeroOrdenReparacion;
    private bool cargando = true;
    private bool guardando = false;
    private decimal totalRepuestos = 0;
    private SelectorProductos? selectorProductosRef;
    private DateTime fechaOrdenGeneracion = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosReparacion();
    }

    private async Task CargarDatosReparacion()
    {
        try
        {
            cargando = true;

            // Cargar datos de la reparación
            var responseRepara = await repository.Get<Repara>($"api/repara/{NumRepa}");
            if (responseRepara.Error || responseRepara.Response == null)
            {
                await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "No se pudo cargar la reparación",
                    Icon = SweetAlertIcon.Error
                });
                return;
            }

            reparacion = responseRepara.Response;
            fechaOrdenGeneracion = reparacion.FechOrdRep?.Date ?? DateTime.Today;

            // Obtener el próximo número de orden de reparación
            numeroOrdenReparacion = await ObtenerProximoNumeroOrden();

            // Cargar repuestos
            await CargarRepuestos();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos: {ex.Message}");
            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Error al cargar datos: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task<int> ObtenerProximoNumeroOrden()
    {
        try
        {
            var response = await repository.Get<int>("api/repara/proximo-numero-orden");
            if (!response.Error)
            {
                return response.Response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener próximo número: {ex.Message}");
        }
        return 1;
    }

    private async Task CargarRepuestos()
    {
        try
        {
            // Cargar repuestos desde REPUREPA con ORIGEN = 1
            var responseRepuestos = await repository.Get<List<Repurepa>>($"api/repurepa/por-reparacion/{NumRepa}");
            if (!responseRepuestos.Error && responseRepuestos.Response != null)
            {
                repuestos = new List<RepuestoOrdenReparacion>();

                foreach (var repuesto in responseRepuestos.Response)
                {
                    // Obtener datos del producto desde MASTER
                    int resul = repuesto.Cod_Inte;
                    // var responseProducto = await repository.Get<Master>($"api/master/xCodint/{repuesto.Cod_Inte}");
                    var responseProducto = await repository.Get<Master>($"api/master/xCodint{resul}");
                    if (!responseProducto.Error && responseProducto.Response != null)
                    {
                        var producto = responseProducto.Response;

                        // Obtener stock disponible
                        var stockDisponible = await ObtenerStockDisponible(repuesto.Cod_Inte);

                        var cantidad = repuesto.Cant_Sol ?? 0;
                        var falta = cantidad - stockDisponible;
                        if (falta < 0) falta = 0;

                        var item = new RepuestoOrdenReparacion
                        {
                            NumRepa = repuesto.NumRepa,
                            CodigoInterno = repuesto.Cod_Inte,
                            CodigoExterno = producto.Codigo ?? "",
                            Descripcion = producto.Descripcion ?? "",
                            Cantidad = cantidad,
                            StockDisponible = stockDisponible,
                            Falta = falta,
                            PrecioUnitario = repuesto.PrUn_Neto,
                            Importe = repuesto.Impo_Neto
                        };

                        repuestos.Add(item);
                    }
                }

                // Ordenar por NumRepa en forma descendente
                repuestos = repuestos.OrderByDescending(r => r.NumRepa).ToList();

                totalRepuestos = repuestos.Sum(r => r.Importe ?? 0);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar repuestos: {ex.Message}");
        }
    }

    private async Task<decimal> ObtenerStockDisponible(int codigoInterno)
    {
        try
        {
            Console.WriteLine($"[ObtenerStockDisponible] Consultando stock para Cod_Inte: {codigoInterno}");
           // var response = await repository.Get<decimal>($"api/stock/disponible/{codigoInterno}");
            var response = await repository.Get<decimal>($"/api/Movisto/stock/total/{codigoInterno}");
            //decimal resul = response.Response;

            Console.WriteLine($"[ObtenerStockDisponible] Response.Error: {response.Error}");
            
            if (!response.Error)
            {
                Console.WriteLine($"[ObtenerStockDisponible] Stock disponible: {response.Response}");
                return response.Response;
            }
            else
            {
                Console.WriteLine($"[ObtenerStockDisponible] Error en respuesta - HttpResponseMessage: {response.HttpResponseMessage?.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ObtenerStockDisponible] ERROR: {ex.Message}");
            Console.WriteLine($"[ObtenerStockDisponible] StackTrace: {ex.StackTrace}");
        }
        
        Console.WriteLine($"[ObtenerStockDisponible] Retornando 0 por defecto");
        return 0;
    }

    private async Task GenerarOrdenReparacion()
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar Generación",
            Html = $"¿Desea generar la Orden de Reparación N° {numeroOrdenReparacion}<br/>" +
                   $"para la Reparación N° {NumRepa}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, generar",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            try
            {
                guardando = true;

                var requestData = new GenerarOrdenReparacionRequest
                {
                    NumRepa = NumRepa,
                    Referen2 = reparacion?.Referen2,
                    NumeroSerie = reparacion?.NumeroSerie,
                    FechOrdRep = fechaOrdenGeneracion,
                    Observa = reparacion?.Observa
                };

                var response = await repository.Post<GenerarOrdenReparacionRequest, GenerarOrdenReparacionResponse>(
                    "api/repara/generar-orden",
                    requestData);

                if (response.Error || response.Response == null)
                {
                    var errorMessage = await response.GetErrorMessageAsync();
                    await sweetAlertService.FireAsync("Error", errorMessage, SweetAlertIcon.Error);
                    return;
                }

                numeroOrdenReparacion = response.Response.NuOrdRep;
                if (reparacion != null)
                {
                    reparacion.NuOrdRep = response.Response.NuOrdRep;
                    reparacion.RefOrdRep = response.Response.RefOrdRep;
                    reparacion.FechOrdRep = response.Response.FechOrdRep;
                }

                await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Éxito",
                    Text = $"Orden de Reparación N° {response.Response.NuOrdRep} generada correctamente",
                    Icon = SweetAlertIcon.Success
                });

                navigationManager.NavigateTo("/generar-orden-reparacion");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al generar O.R.: {ex.Message}");
                await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = $"Error al generar orden: {ex.Message}",
                    Icon = SweetAlertIcon.Error
                });
            }
            finally
            {
                guardando = false;
            }
        }
    }

    private void Cancelar()
    {
        navigationManager.NavigateTo("/generar-orden-reparacion");
    }

    private async Task AbrirSelectorProductos()
    {
        if (selectorProductosRef != null)
        {
            await selectorProductosRef.AbrirModal();
        }
    }

    private async Task OnProductoSeleccionado(SelectorProductos.SeleccionProducto seleccion)
    {
        try
        {
            if (repuestos == null)
            {
                repuestos = new List<RepuestoOrdenReparacion>();
            }

            // Obtener stock disponible
            var stockDisponible = await ObtenerStockDisponible(seleccion.Producto.Codint);
            
            var cantidad = seleccion.Cantidad;
            var falta = cantidad - stockDisponible;
            if (falta < 0) falta = 0;

            //var precioUnitario = seleccion.Precio ?? seleccion.Producto.Cosuni; de esta forma daba error
            var precioUnitario = seleccion.Precio > 0
            ? seleccion.Precio
            : seleccion.Producto.Cosuni;

            var importe = cantidad * precioUnitario;

            var nuevoItem = new RepuestoOrdenReparacion
            {
                NumRepa = NumRepa,
                CodigoInterno = seleccion.Producto.Codint,
                CodigoExterno = seleccion.Producto.Codigo ?? "",
                Descripcion = seleccion.Producto.Descripcion ?? "",
                Cantidad = cantidad,
                StockDisponible = stockDisponible,
                Falta = falta,
                PrecioUnitario = precioUnitario,
                Importe = importe
            };

            repuestos.Add(nuevoItem);
            
            // Ordenar por NumRepa en forma descendente
            repuestos = repuestos.OrderByDescending(r => r.NumRepa).ToList();
            
            // Recalcular total
            totalRepuestos = repuestos.Sum(r => r.Importe ?? 0);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al agregar repuesto: {ex.Message}");
            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Error al agregar repuesto: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
    }

    private void OnCloseSelectorProductos()
    {
        // Callback para cuando se cierra el selector
    }

    private async Task EliminarRepuesto(RepuestoOrdenReparacion item)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar Eliminación",
            Html = $"¿Desea eliminar el repuesto <strong>{item.CodigoExterno} - {item.Descripcion}</strong>?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            repuestos?.Remove(item);
            
            // Recalcular total
            totalRepuestos = repuestos?.Sum(r => r.Importe ?? 0) ?? 0;
            
            StateHasChanged();
            
            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Eliminado",
                Text = "El repuesto ha sido eliminado de la lista",
                Icon = SweetAlertIcon.Success,
                Timer = 1500,
                ShowConfirmButton = false
            });
        }
    }

    private class RepuestoOrdenReparacion
    {
        public int NumRepa { get; set; }
        public int CodigoInterno { get; set; }
        public string CodigoExterno { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public decimal Cantidad { get; set; }
        public decimal StockDisponible { get; set; }
        public decimal Falta { get; set; }
        public decimal? PrecioUnitario { get; set; }
        public decimal? Importe { get; set; }
    }

    private class GenerarOrdenReparacionRequest
    {
        public int NumRepa { get; set; }
        public string? Referen2 { get; set; }
        public string? NumeroSerie { get; set; }
        public DateTime? FechOrdRep { get; set; }
        public string? Observa { get; set; }
    }

    private class GenerarOrdenReparacionResponse
    {
        public int NumRepa { get; set; }
        public int NuOrdRep { get; set; }
        public string RefOrdRep { get; set; } = string.Empty;
        public DateTime? FechOrdRep { get; set; }
        public int? NroPed { get; set; }
        public int? NumeCli { get; set; }
        public string? RasoCli { get; set; }
        public decimal? ImpTot { get; set; }
    }
}
