    private List<DetamasuResumenDTO> OrdenarMateriales(List<DetamasuResumenDTO> lista)
    {
        return ordenMateriales switch
        {
            "codigo" => lista
                .OrderBy(x => x.Codigo ?? x.Cod_Exte ?? string.Empty)
                .ThenBy(x => x.Descripcion ?? string.Empty)
                .ThenBy(x => x.Cod_Inte)
                .ToList(),
            "fecha" => lista
                .OrderByDescending(x => x.FechaUltMov)
                .ThenBy(x => x.Descripcion ?? string.Empty)
                .ThenBy(x => x.Cod_Inte)
                .ToList(),
            _ => lista
                .OrderBy(x => x.Descripcion ?? string.Empty)
                .ThenBy(x => x.Cod_Inte)
                .ToList()
        };
    }

    private async Task CargarMateriales()
    {
        try
        {
            if (numRepaSeleccionado <= 0)
