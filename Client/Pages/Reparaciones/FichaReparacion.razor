@if (mostrarModalOFLimpieza)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generar O.F. Limpieza</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CerrarModalOFLimpieza" disabled="@generandoOFLimpieza"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <strong>Nota seleccionada:</strong> @numRepaSeleccionado
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Mano de obra</label>
                            <input type="number" class="form-control text-end" step="0.0001" @bind-value="manoDeObraOFLimpieza" @bind-value:event="oninput" />
                        </div>

                        <div class="col-md-8 d-flex align-items-end justify-content-end">
                            <button class="btn btn-outline-primary" type="button" @onclick="AbrirSelectorProductoOFLimpieza" disabled="@generandoOFLimpieza">
                                <i class="fas fa-plus"></i> Agregar producto
                            </button>
                        </div>

                        <div class="col-12">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped align-middle">
                                    <thead class="table-dark">
                                        <tr>
                                            <th style="width: 140px;">Código</th>
                                            <th>Descripción</th>
                                            <th class="text-end" style="width: 140px;">Cantidad</th>
                                            <th class="text-center" style="width: 90px;">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!itemsOFLimpieza.Any())
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-muted">No hay productos agregados</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in itemsOFLimpieza)
                                            {
                                                <tr>
                                                    <td><strong>@item.Codigo</strong></td>
                                                    <td>@item.Descripcion</td>
                                                    <td class="text-end">
                                                        <input type="number" class="form-control form-control-sm text-end" step="0.0001" @bind-value="item.Cantidad" @bind-value:event="oninput" />
                                                    </td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="(() => QuitarItemOFLimpieza(item.CodInte))" disabled="@generandoOFLimpieza">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalOFLimpieza" disabled="@generandoOFLimpieza">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GenerarOFLimpiezaAsync" disabled="@generandoOFLimpieza">
                        @if (generandoOFLimpieza)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-1">Generando...</span>
                        }
                        else
                        {
                            <i class="fas fa-magic"></i>
                            <span class="ms-1">Generar</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* IMPORTANTE (Performance):
   - No pasamos Items al modal para evitar traer cientos/miles de nota de reparación al iniciar.
   - SelectorReparaciones ahora pagina contra el backend (api/repara + totalPages) y trae solo la página requerida.
   - Esto reduce significativamente la demora al abrir el modal.
*@
<SelectorReparaciones @ref="selectorReparaciones" OnSeleccionado="OnReparacionSeleccionadaDesdeSelector" />

<!-- Selector reutilizable de productos para agregar repuestos desde MASTER -->
<SelectorProductos @ref="selectorProductosRef"
                   PermitirCantidad="true"
                   PermitirPrecio="false"
                   CantidadDefault="1"
                   OnProductoSeleccionadoCantidad="OnProductoSeleccionado"
                   OnClose="OnCloseSelectorProductos" />

<SelectorProductos @ref="selectorProductosMaterialesRef"
                   PermitirCantidad="true"
                   PermitirPrecio="false"
                   CantidadDefault="1"
                   OnProductoSeleccionadoCantidad="OnProductoSeleccionadoMateriales"
                   OnClose="OnCloseSelectorProductos" />

<SelectorProductos @ref="selectorProductosOFLimpiezaRef"
                  PermitirCantidad="true"
                  PermitirPrecio="false"
                  CantidadDefault="1"
                  OnProductoSeleccionadoCantidad="OnProductoSeleccionadoOFLimpieza"
                  OnClose="OnCloseSelectorProductosOFLimpieza" />

@code {
    private List<Repara>? listaReparaciones;
    private int numRepaSeleccionado = 0;
    private Repara? reparacionSeleccionada;
    private Deudor12? clienteActual;
    private List<GalimRep>? imagenes;
    private bool cargandoImagenes = false;

    private List<Docanre>? documentos;
    private bool cargandoDocumentos = false;
    private string solapaActiva = "imagenes";

    // Repuestos (REPUREPA)
    // - Se cargan por NUMREPA y ORIGEN=0 (según VB6)
    // - Se guardan de forma independiente (cada acción pega a su endpoint)
    private List<IMPLANPROD.Shared.DTOs.RepurepaDTO>? repuestos;
    private bool cargandoRepuestos = false;
    private SelectorProductos? selectorProductosRef;
    private HashSet<int> repuestosConCambios = new HashSet<int>();
    private int siguienteIdTemporalRepuesto = -1;
    private bool hayCambiosPendientesRepuestos => repuestosConCambios.Count > 0 || (repuestos?.Any(r => r.Id < 0) ?? false);

    // Materiales suministrados por el cliente (DETAMASU)
    private List<DetamasuResumenDTO>? materialesResumen;
    private List<DetamasuResumenDTO>? materialesAgregados;
    private bool cargandoMateriales = false;
    private SelectorProductos? selectorProductosMaterialesRef;

    private bool mostrarModalOFLimpieza = false;
    private bool generandoOFLimpieza = false;
    private decimal manoDeObraOFLimpieza = 0m;
    private SelectorProductos? selectorProductosOFLimpiezaRef;
    private List<ItemOFLimpieza> itemsOFLimpieza = new List<ItemOFLimpieza>();
    private HashSet<int> materialesConCambios = new HashSet<int>();
    private HashSet<int> materialesAgregadosConCambios = new HashSet<int>();
    private List<DetamasuResumenDTO>? materialesConsumos;
    private List<DetamasuResumenDTO>? materialesDevoluciones;
    private HashSet<int> materialesConsumosConCambios = new HashSet<int>();
    private HashSet<int> materialesDevolucionesConCambios = new HashSet<int>();
    private int codInteSeleccionadoConsumo = 0;
    private decimal cantidadConsumo = 1m;
    private int codInteSeleccionadoDevolucion = 0;
    private decimal cantidadDevolucion = 1m;
    private bool hayCambiosPendientesMateriales => materialesConCambios.Count > 0
        || (materialesAgregados?.Any() ?? false)
        || (materialesConsumos?.Any() ?? false)
        || (materialesDevoluciones?.Any() ?? false);
    private string ordenMateriales = "fecha";

    private SelectorReparaciones? selectorReparaciones;
    private string textoReparacionSeleccionada = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // IMPORTANTE (Performance):
        // - Ya NO precargamos la lista de nota de reparación. al iniciar (era lento).
        // - El modal SelectorReparaciones realiza paginado server-side y carga bajo demanda.
        
        // Si se recibe NumRepa como parámetro, cargar automáticamente esa reparación
        if (NumRepa.HasValue && NumRepa.Value > 0)
        {
            await CargarReparacionPorNumero(NumRepa.Value);
        }
    }
    
    private async Task CargarReparacionPorNumero(int numRepa)
    {
        try
        {
            // Cargar datos de la reparación
            var responseHttp = await repository.Get<Repara>($"api/repara/{numRepa}");
            
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                var reparacion = responseHttp.Response;
                
                // Asignar la reparación seleccionada
                numRepaSeleccionado = reparacion.NumRepa;
                reparacionSeleccionada = reparacion;
                textoReparacionSeleccionada = $"{reparacion.NumRepa} - {reparacion.Raso_Cli ?? ""}";
                
                // Cargar datos del cliente
                if (reparacion.Nume_Cli.HasValue && reparacion.Nume_Cli.Value > 0)
                {
                    await CargarDatosCliente(reparacion.Nume_Cli.Value);
                }
                
                // Cargar datos de la solapa activa
                await CambiarSolapaAsync(solapaActiva);
                
                StateHasChanged();
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "No se pudo cargar la reparación", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar reparación: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private void AbrirOrdenFabricacion()
    {
        navigationManager.NavigateTo("/ofabricacion-limpieza");
    }

    private async Task AbrirModalOFLimpieza()
    {
        if (numRepaSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Error", "Primero debe seleccionar una nota de reparación.", SweetAlertIcon.Error);
            return;
        }

        mostrarModalOFLimpieza = true;
        generandoOFLimpieza = false;
        manoDeObraOFLimpieza = 0m;
        itemsOFLimpieza = new List<ItemOFLimpieza>();
    }

    private void CerrarModalOFLimpieza()
    {
        mostrarModalOFLimpieza = false;
    }

    private async Task AbrirSelectorProductoOFLimpieza()
    {
        if (selectorProductosOFLimpiezaRef == null)
        {
            await sweetAlertService.FireAsync("Error", "No se pudo abrir el selector de productos.", SweetAlertIcon.Error);
            return;
        }

        await selectorProductosOFLimpiezaRef.AbrirModal();
    }

    private async Task OnProductoSeleccionadoOFLimpieza(SelectorProductos.SeleccionProducto seleccion)
    {
        try
        {
            if (seleccion?.Producto == null)
            {
                return;
            }

            if (seleccion.Producto.Codint <= 0)
            {
                await sweetAlertService.FireAsync("Error", "Producto inválido (CODINT).", SweetAlertIcon.Error);
                return;
            }

            var cantidad = seleccion.Cantidad;
            if (cantidad <= 0)
            {
                cantidad = 1m;
            }

            var existente = itemsOFLimpieza.FirstOrDefault(x => x.CodInte == seleccion.Producto.Codint);
            if (existente != null)
            {
                existente.Cantidad += cantidad;
            }
            else
            {
                itemsOFLimpieza.Add(new ItemOFLimpieza
                {
                    CodInte = seleccion.Producto.Codint,
                    Codigo = seleccion.Producto.Codigo ?? string.Empty,
                    Descripcion = seleccion.Producto.Descripcion ?? string.Empty,
                    Cantidad = cantidad
                });
            }
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void OnCloseSelectorProductosOFLimpieza()
    {
    }

    private async Task GenerarOFLimpiezaAsync()
    {
        if (numRepaSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Error", "Primero debe seleccionar una nota de reparación.", SweetAlertIcon.Error);
            return;
        }

        if (itemsOFLimpieza == null || !itemsOFLimpieza.Any())
        {
            await sweetAlertService.FireAsync("Error", "Debe agregar al menos un producto.", SweetAlertIcon.Error);
            return;
        }

        foreach (var it in itemsOFLimpieza)
        {
            if (it.CodInte <= 0)
            {
                await sweetAlertService.FireAsync("Error", "Hay productos inválidos (CODINT).", SweetAlertIcon.Error);
                return;
            }

            if (it.Cantidad <= 0)
            {
                it.Cantidad = 1m;
            }
        }

        try
        {
            generandoOFLimpieza = true;
            StateHasChanged();

            var request = new GenerarOFLimpiezaRequest
            {
                NumeroReparacion = numRepaSeleccionado,
                ManoDeObra = manoDeObraOFLimpieza,
                Items = itemsOFLimpieza
                    .Where(x => x.CodInte > 0)
                    .Select(x => new GenerarOFLimpiezaItemRequest { CodInte = x.CodInte, Cantidad = x.Cantidad })
                    .ToList()
            };

            var responseHttp = await repository.Post<GenerarOFLimpiezaRequest, OrdeFabr>("api/ordefabr/generar-limpieza", request);
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            var orden = responseHttp.Response;
            await sweetAlertService.FireAsync("Éxito", $"O.F. de Limpieza generada: {orden?.IdSubOr}", SweetAlertIcon.Success);
            mostrarModalOFLimpieza = false;
        }
