    private async Task CambiarSolapaAsync(string solapa)
    {
        if (solapaActiva == solapa)
        {
            return;
        }

        if (hayCambiosPendientesRepuestos && solapaActiva == "repuestos")
        {
            var confirmar = await ConfirmarDescartarCambiosRepuestosAsync();
            if (!confirmar)
            {
                return;
            }
        }

        if (hayCambiosPendientesMateriales && solapaActiva == "materiales")
        {
            var confirmar = await ConfirmarDescartarCambiosMaterialesAsync();
            if (!confirmar)
            {
                return;
            }
        }

        solapaActiva = solapa;

        // Si el usuario entra a la solapa de repuestos, cargamos automáticamente.
        // Esto replica la idea VB6 de "refrescar lista" cuando se abre el módulo.
        if (solapaActiva == "repuestos" && numRepaSeleccionado > 0)
        {
            _ = CargarRepuestos();
        }

        if (solapaActiva == "materiales" && numRepaSeleccionado > 0)
        {
            _ = CargarMateriales();
        }
    }

