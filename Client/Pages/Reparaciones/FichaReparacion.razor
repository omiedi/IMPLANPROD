    private async Task CargarReparacion()
    {
        if (numRepaSeleccionado <= 0)
        {
            reparacionSeleccionada = null;
            clienteActual = null;
            imagenes = null;
            return;
        }

        try
        {
            // Cargar datos de la reparación
            var responseHttp = await repository.Get<Repara>($"api/repara/{numRepaSeleccionado}");
            
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                reparacionSeleccionada = responseHttp.Response;

                textoReparacionSeleccionada = $"{reparacionSeleccionada.NumRepa} - {reparacionSeleccionada.Referen}";
                
                // Cargar datos del cliente desde Deudor12
                if (reparacionSeleccionada.Nume_Cli.HasValue && reparacionSeleccionada.Nume_Cli.Value > 0)
                {
                    await CargarDatosCliente(reparacionSeleccionada.Nume_Cli.Value);
                }
                
                await CargarImagenes();
                await CargarDocumentos();

                // Si el usuario ya está parado en "Repuestos", refrescamos esa solapa.
                if (solapaActiva == "repuestos")
                {
                    // Si hay cambios pendientes, no refrescamos para evitar perder lo que está en memoria.
                    if (!hayCambiosPendientesRepuestos)
                    {
                        await CargarRepuestos();
                    }
                }

                if (solapaActiva == "materiales")
                {
                    if (!hayCambiosPendientesMateriales)
                    {
                        await CargarMateriales();
                    }
                }
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "No se pudo cargar la reparación", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar reparación: {ex.Message}", SweetAlertIcon.Error);
        }
    }

