                materialesResumen = new List<DetamasuResumenDTO>();
                var msg = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            materialesResumen = new List<DetamasuResumenDTO>();
            await sweetAlertService.FireAsync("Error", $"Error al cargar materiales: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            cargandoMateriales = false;
            StateHasChanged();
        }
    }

    private async Task GuardarMateriales()
    {
        try
        {
            if (numRepaSeleccionado <= 0)
            {
                return;
            }

            var numeClie = reparacionSeleccionada?.Nume_Cli;

            // 1) Guardar agregados (BR)
            if (materialesAgregados != null && materialesAgregados.Any())
            {
                foreach (var item in materialesAgregados)
                {
                    var dto = new DetamasuMovimientoCreateDTO
                    {
                        CodiMovi = "BR",
                        Cod_Inte = item.Cod_Inte,
                        Talon = numRepaSeleccionado,
                        Nume_Clie = numeClie,
                        Cantidad = item.Cantidad,
                        FechMov = DateTime.Now,
                        Referencia = "Agregado Posterior"
                    };

                    var resp = await repository.Post("api/detamasu/movimiento", dto);
                    if (resp.Error)
                    {
                        var msg = await resp.GetErrorMessageAsync();
                        await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                        return;
                    }
                }
            }

            // 2) Guardar ajustes de cantidad (AJ)
            if (materialesResumen != null && materialesConCambios.Any())
            {
                foreach (var codInte in materialesConCambios.ToList())
                {
                    var item = materialesResumen.FirstOrDefault(x => x.Cod_Inte == codInte);
                    if (item == null)
                    {
                        continue;
                    }

                    var dto = new DetamasuAjusteCantidadDTO
                    {
                        CodiMovi = "AJ",
                        Talon = numRepaSeleccionado,
                        Cod_Inte = item.Cod_Inte,
                        Nume_Clie = numeClie,
                        NuevaCantidad = item.Resul,
                        Referencia = "Ajuste manual",
                        FechMov = DateTime.Now
                    };

                    var resp = await repository.Put("api/detamasu/ajustar-cantidad", dto);
                    if (resp.Error)
                    {
                        var msg = await resp.GetErrorMessageAsync();
                        await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                        return;
                    }
                }
            }

            // 3) Guardar consumos (CF)
            if (materialesConsumos != null && materialesConsumos.Any())
            {
                foreach (var item in materialesConsumos)
                {
                    var dto = new DetamasuSalidaCreateDTO
                    {
                        CodiMovi = "CF",
                        Talon = numRepaSeleccionado,
                        Cod_Inte = item.Cod_Inte,
                        Nume_Clie = numeClie,
                        Cantidad = item.Cantidad,
                        FechMov = DateTime.Now,
                        Referencia = "Consumo"
                    };

                    var resp = await repository.Post("api/detamasu/salida", dto);
                    if (resp.Error)
                    {
                        var msg = await resp.GetErrorMessageAsync();
                        await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                        return;
                    }
                }
            }

            // 4) Guardar devoluciones (DV)
            if (materialesDevoluciones != null && materialesDevoluciones.Any())
            {
                foreach (var item in materialesDevoluciones)
                {
                    var dto = new DetamasuSalidaCreateDTO
                    {
                        CodiMovi = "DV",
                        Talon = numRepaSeleccionado,
                        Cod_Inte = item.Cod_Inte,
                        Nume_Clie = numeClie,
                        Cantidad = item.Cantidad,
                        FechMov = DateTime.Now,
                        Referencia = "Devolución al cliente"
                    };

                    var resp = await repository.Post("api/detamasu/salida", dto);
                    if (resp.Error)
                    {
                        var msg = await resp.GetErrorMessageAsync();
                        await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                        return;
                    }
                }
            }

            materialesConCambios.Clear();
            materialesAgregadosConCambios.Clear();
            materialesAgregados = new List<DetamasuResumenDTO>();
            materialesConsumosConCambios.Clear();
            materialesDevolucionesConCambios.Clear();
            materialesConsumos = new List<DetamasuResumenDTO>();
            materialesDevoluciones = new List<DetamasuResumenDTO>();
            await sweetAlertService.FireAsync("Éxito", "Materiales guardados correctamente", SweetAlertIcon.Success);
            await CargarMateriales();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al guardar materiales: {ex.Message}", SweetAlertIcon.Error);
        }
    }

