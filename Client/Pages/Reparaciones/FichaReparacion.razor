    private async Task OnProductoSeleccionado(SelectorProductos.SeleccionProducto seleccion)
    {
        // Alta en memoria: el ítem se agrega a la grilla pero NO se persiste hasta presionar "Guardar repuestos".

        try
        {
            if (seleccion?.Producto == null)
            {
                return;
            }

            if (numRepaSeleccionado <= 0)
            {
                await sweetAlertService.FireAsync("Error", "Primero debe seleccionar una nota de reparación..", SweetAlertIcon.Error);
                return;
            }

            if (repuestos == null)
            {
                repuestos = new List<IMPLANPROD.Shared.DTOs.RepurepaDTO>();
            }

            var cantidadInicial = (seleccion.Cantidad <= 0 ? 1 : seleccion.Cantidad);
            cantidadInicial = Math.Round(cantidadInicial, 4);

            var nuevoDto = new IMPLANPROD.Shared.DTOs.RepurepaDTO
            {
                Id = siguienteIdTemporalRepuesto,
                NumRepa = numRepaSeleccionado,
                Cod_Inte = seleccion.Producto.Codint,
                Cant_Sol = cantidadInicial,
                CodigoExterno = seleccion.Producto.Codigo,
                Descripcion = seleccion.Producto.Descripcion,
                UnidadMedida = seleccion.Producto.Umedida,
                Origen = 0
            };

            siguienteIdTemporalRepuesto--;
            repuestos.Insert(0, nuevoDto);
            repuestosConCambios.Add(nuevoDto.Id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al agregar repuesto: {ex.Message}", SweetAlertIcon.Error);
        }
    }

