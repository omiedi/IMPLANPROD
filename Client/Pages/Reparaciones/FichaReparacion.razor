    private async Task ActualizarCantidadRepuesto(IMPLANPROD.Shared.DTOs.RepurepaDTO item, ChangeEventArgs e)
    {
        // Guardado independiente al cambiar el valor.
        // Nota: el value viene como string en el input, lo parseamos robustamente.
        try
        {
            if (item == null)
            {
                return;
            }

            // Capturar el valor ingresado por el usuario.
            var valueString = e?.Value?.ToString();
            if (string.IsNullOrWhiteSpace(valueString))
            {
                return;
            }

            if (!decimal.TryParse(valueString, out var nuevaCantidad))
            {
                await sweetAlertService.FireAsync("Error", "Cantidad inválida.", SweetAlertIcon.Error);
                await CargarRepuestos();
                return;
            }

            // Evitar llamadas inútiles
            if (Math.Abs(nuevaCantidad - item.Cant_Sol) < 0.0001m)
            {
                return;
            }

            var response = await repository.Put($"api/repurepa/{item.Id}/cantidad", nuevaCantidad);
            if (!response.Error)
            {
                // Actualizamos en memoria para que la UI quede consistente sin esperar otro refresh.
                item.Cant_Sol = Math.Round(nuevaCantidad, 4);
            }
            else
            {
                var msg = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                await CargarRepuestos();
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al actualizar cantidad: {ex.Message}", SweetAlertIcon.Error);
            await CargarRepuestos();
        }
    }

    private async Task EliminarRepuesto(IMPLANPROD.Shared.DTOs.RepurepaDTO item)
    {
        // Borrado con confirmación (según requerimiento)
        if (item == null)
        {
            return;
        }

        // Si el ítem todavía está en memoria (Id temporal), se elimina localmente sin llamar a la API.
        if (item.Id < 0)
        {
            repuestos?.Remove(item);
            repuestosConCambios.Remove(item.Id);
            StateHasChanged();
            return;
        }

        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¿Eliminar repuesto?",
            Text = "Esta acción marcará el ítem como borrado.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (!result.IsConfirmed)
        {
            return;
        }

        try
        {
            var response = await repository.Delete($"api/repurepa/{item.Id}");
            if (!response.Error)
            {
                repuestosConCambios.Remove(item.Id);
                await CargarRepuestos();
            }
            else
            {
                var msg = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al eliminar repuesto: {ex.Message}", SweetAlertIcon.Error);
        }
    }

