@page "/ficha-reparacion"
@page "/ficha-reparacion/{NumRepa:int}"
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Client.Shared.Components
@using System.Globalization
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime

<PageTitle>Ficha de Reparación</PageTitle>

@code {
    [Parameter] public int? NumRepa { get; set; }
}

<div class="container-fluid">
    <h3><i class="fas fa-file-medical"></i> Ficha de Reparación</h3>

    <!-- INSTRUCTIVO DESPLEGABLE -->
    <InstructivoPanel Titulo="📖 Instructivo - Ficha de Reparación" MostrarPorDefecto="false">
        <div class="row">
            <div class="col-md-12">
                <h5 class="text-info"><i class="fas fa-clipboard-check"></i> ¿Qué es la Ficha de Reparación?</h5>
                <p>La <strong>Ficha de Reparación</strong> es el documento central donde se registra todo el diagnóstico, trabajo realizado, repuestos utilizados y materiales del cliente. Es el paso 2 del proceso de reparaciones.</p>
                <hr />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card border-info h-100">
                    <div class="card-header bg-info text-white">
                        <strong>📋 Funcionalidades Principales</strong>
                    </div>
                    <div class="card-body">
                        <ul class="small">
                            <li><strong>📸 Galería de Imágenes:</strong> Suba fotos del equipo antes, durante y después de la reparación</li>
                            <li><strong>📎 Archivos Adjuntos:</strong> Adjunte documentos técnicos, manuales, planos, etc.</li>
                            <li><strong>📋 Inspección/Reparación:</strong> Registre el diagnóstico y detalles del trabajo realizado</li>
                            <li><strong>🔧 Repuestos (ORIGEN=0):</strong> Liste los repuestos necesarios para la reparación</li>
                            <li><strong>📦 Material del Cliente:</strong> Registre materiales suministrados por el cliente (BR, CF, DV, AJ)</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-success h-100">
                    <div class="card-header bg-success text-white">
                        <strong>🔄 Flujo de Trabajo</strong>
                    </div>
                    <div class="card-body">
                        <ol class="small">
                            <li><strong>Seleccionar Talón:</strong> Busque la recepción por N° o referencia</li>
                            <li><strong>Documentar con Imágenes:</strong> Suba fotos del estado del equipo</li>
                            <li><strong>Adjuntar Documentos:</strong> Agregue archivos técnicos si es necesario</li>
                            <li><strong>Agregar Repuestos:</strong> Indique qué repuestos se necesitan (ORIGEN=0)</li>
                            <li><strong>Registrar Material Cliente:</strong> Si el cliente suministró materiales, regístrelos</li>
                            <li><strong>Generar Presupuesto:</strong> Una vez completada la ficha, genere el presupuesto</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-md-12">
                <div class="alert alert-warning">
                    <h6><i class="fas fa-lightbulb"></i> Consejos Importantes:</h6>
                    <ul class="mb-0 small">
                        <li><strong>Repuestos ORIGEN=0:</strong> Los repuestos agregados aquí son para la reparación actual (no para stock)</li>
                        <li><strong>Material del Cliente:</strong> Use BR (bruto), CF (consumo final), DV (devolución), AJ (ajuste) para control de inventario</li>
                        <li><strong>Imágenes:</strong> Las fotos son muy útiles para documentar el estado del equipo y justificar el presupuesto</li>
                        <li><strong>Guardado Independiente:</strong> Cada solapa (Imágenes, Documentos, Repuestos, Materiales) se guarda por separado</li>
                        <li><strong>O.F. Limpieza:</strong> Puede generar una Orden de Fabricación para limpieza del equipo desde esta pantalla</li>
                    </ul>
                </div>
            </div>
        </div>
    </InstructivoPanel>

    <!-- Selector de nota de reparación. -->
    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-file-invoice"></i> Seleccionar nota de reparación.</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <label class="form-label">Talón N°:</label>
                    <div class="input-group">
                        <button type="button" class="btn btn-outline-primary" @onclick="AbrirSelectorReparaciones">
                            <i class="fas fa-search"></i>
                        </button>
                        <input type="text" class="form-control" value="@textoReparacionSeleccionada" readonly />
                        @if (numRepaSeleccionado > 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarSeleccionReparacion">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                    </div>
                    <small class="text-muted">Buscar por N° o referencia</small>
                </div>
                <div class="col-md-4 d-flex align-items-end justify-content-end mt-2 mt-md-0">
                    <button type="button" class="btn btn-outline-success" @onclick="AbrirOrdenFabricacion">
                        Lista O.Fabricación
                    </button>
                    <button type="button" class="btn btn-outline-primary ms-2" @onclick="AbrirModalOFLimpieza" disabled="@(numRepaSeleccionado <= 0)">
                        GENERAR O.F. LIMPIEZA
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (reparacionSeleccionada != null)
    {
        <!-- Datos del Cliente -->
        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-user"></i> Datos del Cliente</h5>
            </div>
            <div class="card-body">
                @if (clienteActual != null)
                {
                    <div class="row">
                        <div class="col-md-4">
                            <p><strong>Razón Social:</strong> @clienteActual.Raso_Cli</p>
                            <p><strong>N° Cuenta:</strong> @clienteActual.Nume_Cli</p>
                        </div>
                        <div class="col-md-4">
                            <p><strong>Teléfono:</strong> @clienteActual.Tele_Cli</p>
                            <p><strong>Fax:</strong> @clienteActual.Faxi_Cli</p>
                        </div>
                        <div class="col-md-4">
                            <div class="row">
                                <div class="col-8">
                                    <p><strong>Domicilio:</strong> @clienteActual.Domi_Cli</p>
                                </div>
                                <div class="col-4">
                                    <p><strong>CP:</strong> @clienteActual.Cpos_Cli</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-8">
                                    <p><strong>Localidad:</strong> @clienteActual.Loca_Cli</p>
                                </div>
                                <div class="col-4">
                                    <p><strong>Fecha:</strong> @reparacionSeleccionada.FechRecep?.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i> No se pudieron cargar los datos del cliente.
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="d-flex gap-2 mb-4 flex-wrap">
                    <button class="btn @(solapaActiva == "imagenes" ? "btn-primary" : "btn-outline-primary") flex-fill py-3 rounded-3 shadow-sm"
                            @onclick='@(() => CambiarSolapaAsync("imagenes"))'
                            style="transition: all 0.3s ease; min-width: 260px;">
                        <i class="fas fa-images me-2"></i>
                        <strong>Galería de Imágenes</strong>
                    </button>
                    <button class="btn @(solapaActiva == "documentos" ? "btn-primary" : "btn-outline-primary") flex-fill py-3 rounded-3 shadow-sm"
                            @onclick='@(() => CambiarSolapaAsync("documentos"))'
                            style="transition: all 0.3s ease; min-width: 260px;">
                        <i class="fas fa-paperclip me-2"></i>
                        <strong>Archivos Adjuntos</strong>
                    </button>
                    <button class="btn @(solapaActiva == "detalle" ? "btn-primary" : "btn-outline-primary") flex-fill py-3 rounded-3 shadow-sm"
                            @onclick='@(() => CambiarSolapaAsync("detalle"))'
                            style="transition: all 0.3s ease; min-width: 260px;">
                        <i class="fas fa-clipboard-list me-2"></i>
                        <strong>Inspección / Reparación</strong>
                    </button>
                    <button class="btn @(solapaActiva == "repuestos" ? "btn-primary" : "btn-outline-primary") flex-fill py-3 rounded-3 shadow-sm"
                            @onclick='@(() => CambiarSolapaAsync("repuestos"))'
                            style="transition: all 0.3s ease; min-width: 260px;">
                        <i class="fas fa-cogs me-2"></i>
                        <strong>Repuestos</strong>
                    </button>
                    <button class="btn @(solapaActiva == "materiales" ? "btn-primary" : "btn-outline-primary") flex-fill py-3 rounded-3 shadow-sm"
                            @onclick='@(() => CambiarSolapaAsync("materiales"))'
                            style="transition: all 0.3s ease; min-width: 260px;">
                        <i class="fas fa-boxes-stacked me-2"></i>
                        <strong>Material suministrado por el cliente</strong>
                    </button>
                </div>

                @if (solapaActiva == "imagenes")
                {
                    <div class="mb-3">
                        <label for="fileUpload" class="btn btn-primary">
                            <i class="fas fa-upload"></i> Subir Imagen
                        </label>
                        <InputFile id="fileUpload" OnChange="SubirImagen" accept="image/*" style="display: none;" />
                    </div>

                    @if (cargandoImagenes)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (imagenes == null || !imagenes.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No hay imágenes cargadas para esta reparación.
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var imagen in imagenes)
                            {
                                <div class="col-md-6 mb-4">
                                    <div class="card h-100">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <span><strong>Imagen @imagen.Norit_Imag</strong></span>
                                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarImagen(imagen.Id)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <img src="@imagen.RutaImagen" class="img-fluid rounded" alt="Imagen @imagen.Norit_Imag" style="max-height: 300px; object-fit: contain;" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold">Observaciones:</label>
                                                    <textarea class="form-control" 
                                                              rows="8" 
                                                              @bind="imagen.Descripcion"
                                                              @bind:after="() => ActualizarDescripcion(imagen)"
                                                              placeholder="Ingrese observaciones...">
                                                    </textarea>
                                                    <small class="text-muted">Guardado automático.</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else if (solapaActiva == "documentos")
                {
                    <div class="mb-3">
                        <label for="docUpload" class="btn btn-primary" disabled="@(numRepaSeleccionado <= 0)">
                            <i class="fas fa-upload"></i> Subir Documento
                        </label>
                        <InputFile id="docUpload" OnChange="SubirDocumento" style="display: none;" />
                        <small class="text-muted d-block mt-1">Se admiten .pdf, .doc, .docx, .txt, .xls, .xlsx, .csv, .png, .jpg</small>
                    </div>

                    @if (cargandoDocumentos)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (documentos == null || !documentos.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No hay documentos adjuntos para esta reparación.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Archivo</th>
                                        <th class="text-end">Tamaño</th>
                                        <th class="text-center">Fecha</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in documentos)
                                    {
                                        <tr>
                                            <td>@(doc.NomOriginal ?? doc.NomAsignado)</td>
                                            <td class="text-end">@FormatoTamano(doc.TamanoBytes)</td>
                                            <td class="text-center">@(doc.AddRecord?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-secondary me-2" href="@($"api/docanre/view/{doc.Id}")" target="_blank" title="Ver">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a class="btn btn-sm btn-outline-primary me-2" href="@($"api/docanre/download/{doc.Id}")" target="_blank" title="Descargar">
                                                    <i class="fas fa-download"></i>
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarDocumento(doc.Id)" title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else if (solapaActiva == "repuestos")
                {
                    <!--
                        Solapa REPUESTOS
                        - Muestra items de REPUREPA filtrando por NUMREPA (reparación activa) y ORIGEN=0 (según VB6)
                        - Guardado independiente: cada acción (agregar, editar cantidad, borrar) llama a su endpoint
                        - Permite agregar repuestos desde MASTER usando el componente reutilizable SelectorProductos
                    -->

                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="mb-0"><i class="fas fa-cogs"></i> Repuestos</h5>
                            <small class="text-muted">Reparación activa: <strong>@numRepaSeleccionado</strong> (Origen=0)</small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" @onclick="GuardarRepuestos" disabled="@(numRepaSeleccionado <= 0 || !hayCambiosPendientesRepuestos)">
                                <i class="fas fa-save"></i> Guardar repuestos
                            </button>
                            <button class="btn btn-success" @onclick="AbrirSelectorProductos" disabled="@(numRepaSeleccionado <= 0)">
                                <i class="fas fa-plus"></i> Agregar repuesto
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CargarRepuestos" disabled="@(numRepaSeleccionado <= 0 || hayCambiosPendientesRepuestos)">
                                <i class="fas fa-sync"></i> Refrescar
                            </button>
                        </div>
                    </div>

                    @if (numRepaSeleccionado <= 0)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i> Primero debe seleccionar una nota de reparación.
                        </div>
                    }
                    else if (cargandoRepuestos)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else if (repuestos == null || !repuestos.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No hay repuestos cargados para esta reparación.
                        </div>
                    }
                    else
                    {
                        var repuestosOrdenados = repuestos
                            .OrderBy(x => x.Descripcion ?? string.Empty)
                            .ThenBy(x => x.Cod_Inte)
                            .ToList();

                        var estiloScrollRepuestos = repuestosOrdenados.Count > 10
                            ? "max-height: 520px; overflow-y: auto;"
                            : string.Empty;

                        <div class="table-responsive" style="@estiloScrollRepuestos">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th class="text-end" style="width: 120px;">Cód.Int.</th>
                                        <th style="width: 180px;">Código</th>
                                        <th>Descripción</th>
                                        <th style="width: 90px;">U.M.</th>
                                        <th class="text-end" style="width: 140px;">Cantidad</th>
                                        <th class="text-end" style="width: 120px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in repuestosOrdenados)
                                    {
                                        <tr>
                                            <td class="text-end">@item.Cod_Inte</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.CodigoExterno) ? "-" : item.CodigoExterno)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "(sin descripción)" : item.Descripcion)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.UnidadMedida) ? "-" : item.UnidadMedida)</td>
                                            <td class="text-end">
                                                <!--
                                                    Edición directa de la cantidad:
                                                    - Guardado independiente del resto
                                                    - Al cambiar el valor (onchange) NO se persiste automáticamente, queda pendiente
                                                    - Se muestra con 1 decimal (como VB6), pero se guarda con 4 decimales
                                                -->
                                                <input type="number"
                                                       class="form-control form-control-sm text-end"
                                                       step="0.0001"
                                                       @bind-value="item.Cant_Sol"
                                                       @bind-value:culture="CultureInfo.InvariantCulture"
                                                       @bind-value:event="onchange"
                                                       @bind-value:after="() => MarcarRepuestoPendiente(item)" />
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarRepuesto(item)" title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else if (solapaActiva == "materiales")
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="mb-0"><i class="fas fa-boxes-stacked"></i> Material suministrado por el cliente</h5>
                            <small class="text-muted">Talón: <strong>@numRepaSeleccionado</strong></small>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" @onclick="GuardarMateriales" disabled="@(numRepaSeleccionado <= 0 || !hayCambiosPendientesMateriales)">
                                <i class="fas fa-save"></i> Guardar
                            </button>
                            <button class="btn btn-success" @onclick="AbrirSelectorProductosMateriales" disabled="@(numRepaSeleccionado <= 0)">
                                <i class="fas fa-plus"></i> Agregar item
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CargarMateriales" disabled="@(numRepaSeleccionado <= 0 || hayCambiosPendientesMateriales)">
                                <i class="fas fa-sync"></i> Refrescar
                            </button>
                        </div>
                    </div>

                    @if (numRepaSeleccionado <= 0)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i> Primero debe seleccionar un nota de recepción.
                        </div>
                    }
                    else if (cargandoMateriales)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-12 col-xxl-6 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <h6 class="mb-0">Items existentes</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <label class="form-label mb-0">Ordenar por</label>
                                        <select class="form-select form-select-sm" style="width: 220px;" @bind="ordenMateriales">
                                            <option value="descripcion">Descripción</option>
                                            <option value="codigo">Código</option>
                                            <option value="fecha">Fecha ingreso</option>
                                        </select>
                                    </div>
                                </div>

                                @if (materialesResumen == null || !materialesResumen.Any())
                                {
                                    <div class="alert alert-info">
                                        <i class="fas fa-info-circle"></i> No hay materiales con saldo para este talón.
                                    </div>
                                }
                                else
                                {
                                    var materialesOrdenados = OrdenarMateriales(materialesResumen);
                                    var estiloScrollMateriales = materialesOrdenados.Count > 10
                                        ? "max-height: 520px; overflow-y: auto;"
                                        : string.Empty;

                                    <div class="table-responsive" style="@estiloScrollMateriales">
                                        <table class="table table-striped table-hover table-sm">
                                            <thead class="table-dark sticky-top">
                                                <tr>
                                                    <th style="width: 110px;" class="text-end">Cód.Int.</th>
                                                    <th style="width: 140px;">Código</th>
                                                    <th>Descripción</th>
                                                    <th style="width: 160px;">Fecha ingreso</th>
                                                    <th style="width: 90px;" class="text-end">BR</th>
                                                    <th style="width: 90px;" class="text-end">CF</th>
                                                    <th style="width: 90px;" class="text-end">DV</th>
                                                    <th style="width: 90px;" class="text-end">AJ</th>
                                                    <th style="width: 150px;" class="text-end">RESUL</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in materialesOrdenados)
                                                {
                                                    <tr>
                                                        <td class="text-end"><strong>@item.Cod_Inte</strong></td>
                                                        <td>@(string.IsNullOrWhiteSpace(item.Codigo) ? item.Cod_Exte : item.Codigo)</td>
                                                        <td>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "(sin descripción)" : item.Descripcion)</td>
                                                        <td>@(item.FechaUltMov.HasValue ? item.FechaUltMov.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty)</td>
                                                        <td class="text-end">@item.Br.ToString("0.####", CultureInfo.InvariantCulture)</td>
                                                        <td class="text-end">@item.Cf.ToString("0.####", CultureInfo.InvariantCulture)</td>
                                                        <td class="text-end">@item.Dv.ToString("0.####", CultureInfo.InvariantCulture)</td>
                                                        <td class="text-end">@item.Aj.ToString("0.####", CultureInfo.InvariantCulture)</td>
                                                        <td class="text-end">
                                                            <input type="number"
                                                                   class="form-control form-control-sm text-end"
                                                                   step="0.0001"
                                                                   @bind-value="item.Resul"
                                                                   @bind-value:culture="CultureInfo.InvariantCulture"
                                                                   @bind-value:event="onchange"
                                                                   @bind-value:after="() => MarcarMaterialPendiente(item)" />
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            <div class="col-12 col-xxl-6 mb-3">
