    private async Task GuardarRepuestos()
    {
        try
        {
            if (numRepaSeleccionado <= 0)
            {
                return;
            }

            if (repuestos == null || (!repuestosConCambios.Any() && !repuestos.Any(r => r.Id < 0)))
            {
                return;
            }

            // 1) Guardar altas pendientes (Id temporal < 0)
            var nuevos = repuestos.Where(r => r.Id < 0).ToList();
            foreach (var nuevoDto in nuevos)
            {
                var nuevo = new IMPLANPROD.Shared.Entities.Repurepa
                {
                    NumRepa = numRepaSeleccionado,
                    Cod_Inte = nuevoDto.Cod_Inte,
                    Cant_Sol = (nuevoDto.Cant_Sol <= 0 ? 1 : nuevoDto.Cant_Sol),
                    Origen = 0,
                    MarcaItemAgregado = 1,
                    MarBorra = 0
                };

                var responseAlta = await repository.Post("api/repurepa", nuevo);
                if (responseAlta.Error)
                {
                    var msg = await responseAlta.GetErrorMessageAsync();
                    await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                    return;
                }
            }

            // 2) Guardar modificaciones de cantidad (solo ítems ya existentes en BD)
            foreach (var id in repuestosConCambios.Where(x => x > 0).ToList())
            {
                var item = repuestos.FirstOrDefault(r => r.Id == id);
                if (item == null)
                {
                    continue;
                }

                var response = await repository.Put($"api/repurepa/{item.Id}/cantidad", item.Cant_Sol);
                if (response.Error)
                {
                    var msg = await response.GetErrorMessageAsync();
                    await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                    return;
                }
            }

            repuestosConCambios.Clear();
            await sweetAlertService.FireAsync("Éxito", "Repuestos guardados correctamente", SweetAlertIcon.Success);
            await CargarRepuestos();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al guardar repuestos: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private void MarcarRepuestoPendiente(IMPLANPROD.Shared.DTOs.RepurepaDTO item)
    {
        if (item == null)
        {
            return;
        }

        item.Cant_Sol = Math.Round(item.Cant_Sol, 4);
        repuestosConCambios.Add(item.Id);
    }

    private async Task SubirDocumento(InputFileChangeEventArgs e)
    {
        try
        {
            if (numRepaSeleccionado <= 0)
            {
                await sweetAlertService.FireAsync("Error", "Primero debe seleccionar una nota de reparación.", SweetAlertIcon.Error);
                return;
            }

            var archivo = e.File;
            if (archivo == null)
            {
                return;
            }

            const long maxFileSize = 20 * 1024 * 1024;
            if (archivo.Size > maxFileSize)
            {
                await sweetAlertService.FireAsync("Error", "El archivo es demasiado grande. Tamaño máximo: 20MB", SweetAlertIcon.Error);
                return;
            }

            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(archivo.OpenReadStream(maxFileSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(archivo.ContentType);

            content.Add(fileContent, "file", archivo.Name);
            content.Add(new StringContent(numRepaSeleccionado.ToString()), "numRepa");

            var response = await repository.PostFormData<Docanre>("api/docanre/upload", content);

            if (!response.Error)
            {
                await sweetAlertService.FireAsync("Éxito", "Documento subido correctamente", SweetAlertIcon.Success);
                await CargarDocumentos();
            }
            else
            {
                var message = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al subir documento: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private async Task EliminarDocumento(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¿Eliminar documento?",
            Text = "Esta acción no se puede deshacer",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
