    private async Task SubirImagen(InputFileChangeEventArgs e)
    {
        try
        {
            var archivo = e.File;
            
            if (archivo == null)
            {
                return;
            }

            // Validar tamaño (máximo 5MB)
            const long maxFileSize = 5 * 1024 * 1024;
            if (archivo.Size > maxFileSize)
            {
                await sweetAlertService.FireAsync("Error", "El archivo es demasiado grande. Tamaño máximo: 5MB", SweetAlertIcon.Error);
                return;
            }

            // Crear FormData
            using var content = new MultipartFormDataContent();
            
            var fileContent = new StreamContent(archivo.OpenReadStream(maxFileSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(archivo.ContentType);
            
            content.Add(fileContent, "file", archivo.Name);
            content.Add(new StringContent(numRepaSeleccionado.ToString()), "numRepa");
            content.Add(new StringContent(""), "descripcion");

            // Subir archivo
            var response = await repository.PostFormData<GalimRep>("api/galimrep/upload", content);
            
            if (!response.Error)
            {
                await sweetAlertService.FireAsync("Éxito", "Imagen subida correctamente", SweetAlertIcon.Success);
                await CargarImagenes();
            }
            else
            {
                var message = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al subir imagen: {ex.Message}", SweetAlertIcon.Error);
        }
    }

