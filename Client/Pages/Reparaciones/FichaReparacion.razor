    private decimal GetDisponibleActual(int codInte)
    {
        var baseItem = materialesResumen?.FirstOrDefault(x => x.Cod_Inte == codInte);
        var baseDisponible = baseItem?.Cantidad ?? 0m;

        var consumosPend = materialesConsumos?.Where(x => x.Cod_Inte == codInte).Sum(x => x.Cantidad) ?? 0m;
        var devolPend = materialesDevoluciones?.Where(x => x.Cod_Inte == codInte).Sum(x => x.Cantidad) ?? 0m;

        return Math.Round(baseDisponible - consumosPend - devolPend, 4);
    }

    private async Task AgregarConsumo()
    {
        if (codInteSeleccionadoConsumo <= 0)
        {
            await sweetAlertService.FireAsync("Error", "Seleccione un item ingresado.", SweetAlertIcon.Error);
            return;
        }

        var cant = Math.Round(cantidadConsumo, 4);
        if (cant <= 0)
        {
            await sweetAlertService.FireAsync("Error", "La cantidad debe ser mayor a 0.", SweetAlertIcon.Error);
            return;
        }

        var disponible = GetDisponibleActual(codInteSeleccionadoConsumo);
        if (cant > disponible)
        {
            await sweetAlertService.FireAsync("Error", $"Cantidad inválida. Disponible: {disponible:0.####}", SweetAlertIcon.Error);
            return;
        }

        var baseItem = materialesResumen?.FirstOrDefault(x => x.Cod_Inte == codInteSeleccionadoConsumo);
        if (baseItem == null)
        {
            await sweetAlertService.FireAsync("Error", "El item seleccionado no existe en los ingresados.", SweetAlertIcon.Error);
            return;
        }

        materialesConsumos ??= new List<DetamasuResumenDTO>();
        materialesConsumos.Add(new DetamasuResumenDTO
        {
            Cod_Inte = baseItem.Cod_Inte,
            Cod_Exte = baseItem.Cod_Exte,
            Codigo = baseItem.Codigo,
            Descripcion = baseItem.Descripcion,
            Cantidad = cant,
            FechaUltMov = DateTime.Now
        });

        materialesConsumosConCambios.Add(baseItem.Cod_Inte);
        cantidadConsumo = 1m;
    }

