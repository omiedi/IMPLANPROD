@page "/presupuesto-reparacion/ver/{NumRepa:int}"
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Services
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager

<PageTitle>Ver Presupuesto de Reparación</PageTitle>

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="text-center fw-bold text-info">
            <i class="fas fa-eye me-2"></i>
            VER PRESUPUESTO DE REPARACIÓN
        </h2>
        <hr class="border-info border-2 opacity-50" />
    </div>

    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando presupuesto...</p>
        </div>
    }
    else if (repara == null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle"></i> No se pudo cargar el presupuesto.
        </div>
        <button class="btn btn-secondary" @onclick="Volver">
            <i class="fas fa-arrow-left"></i> Volver
        </button>
    }
    else
    {
        <PresrepaForm repara="@repara"
                      IsEdit="false"
                      IsReadOnly="true"
                      OnCancel="@Volver" />
    }
</div>

@code {
    [Parameter] public int NumRepa { get; set; }
    
    private Repara? repara;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarPresupuesto();
    }

    private async Task CargarPresupuesto()
    {
        try
        {
            cargando = true;
            
            var responseHttp = await repository.Get<Repara>($"api/repara/{NumRepa}");
            
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar presupuesto: {message}", SweetAlertIcon.Error);
                return;
            }

            repara = responseHttp.Response;

            // Validar que tenga presupuesto generado
            if (repara != null && (!repara.NroPed.HasValue || repara.NroPed <= 0.5m))
            {
                await sweetAlertService.FireAsync(
                    "Atención", 
                    "Esta reparación no tiene un presupuesto generado.", 
                    SweetAlertIcon.Warning);
                navigationManager.NavigateTo("/presupuestos-reparacion");
                return;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error inesperado: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            cargando = false;
        }
    }

    private void Volver()
    {
        navigationManager.NavigateTo("/presupuestos-reparacion");
    }
}
