@page "/generar-orden-reparacion"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3>Generar Orden de Reparación</h3>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Órdenes de Venta de Reparación Pendientes</h5>
    </div>
    <div class="card-body">
        @if (cargando)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-2">Cargando órdenes pendientes...</p>
            </div>
        }
        else if (ordenesPendientes == null || !ordenesPendientes.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No hay órdenes de venta pendientes para emitir orden de reparación.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>N° Reparación</th>
                            <th>Referencia</th>
                            <th>N° Pedido</th>
                            <th>Cliente</th>
                            <th>Razón Social</th>
                            <th>Fecha Recepción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var orden in ordenesPendientes)
                        {
                            <tr>
                                <td>@orden.NumRepa</td>
                                <td>@orden.Referen</td>
                                <td>@orden.NroPed</td>
                                <td>@orden.Nume_Cli</td>
                                <td>@orden.Raso_Cli</td>
                                <td>@(orden.FechRecep?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => SeleccionarOrden(orden)">
                                        <i class="bi bi-check-circle"></i> Seleccionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <p class="text-muted">
                    <strong>Total de órdenes pendientes:</strong> @ordenesPendientes.Count
                </p>
            </div>
        }
    </div>
</div>

@code {
    private List<Repara>? ordenesPendientes;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarOrdenesPendientes();
    }

    private async Task CargarOrdenesPendientes()
    {
        try
        {
            cargando = true;
            var responseHttp = await repository.Get<List<Repara>>("api/repara/pendientes-generar-or");
            
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                // Ordenar por NumRepa en forma descendente
                ordenesPendientes = responseHttp.Response.OrderByDescending(o => o.NumRepa).ToList();
                Console.WriteLine($"Órdenes pendientes cargadas: {ordenesPendientes.Count}");
            }
            else
            {
                ordenesPendientes = new List<Repara>();
                await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "No se pudieron cargar las órdenes pendientes",
                    Icon = SweetAlertIcon.Error
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar órdenes pendientes: {ex.Message}");
            ordenesPendientes = new List<Repara>();
            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Error al cargar órdenes: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task SeleccionarOrden(Repara orden)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar Selección",
            Html = $"¿Desea generar orden de reparación para:<br/>" +
                   $"<strong>N° Reparación:</strong> {orden.NumRepa}<br/>" +
                   $"<strong>Cliente:</strong> {orden.Raso_Cli}<br/>" +
                   $"<strong>N° Pedido:</strong> {orden.NroPed}",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, continuar",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            Console.WriteLine($"Navegando a orden de reparación - NumRepa: {orden.NumRepa}");
            navigationManager.NavigateTo($"/orden-reparacion/{orden.NumRepa}");
        }
    }
}
