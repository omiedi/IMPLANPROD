&lt;button class="btn btn-sm btn-outline-danger" 
        @@onclick="() =&gt; DarDeBaja(cliente.Id)" 
        disabled="@@(!tieneAccesoEscritura)"
        title="@@(tieneAccesoEscritura ? "Dar de baja cliente" : "Sin permisos de escritura")"&gt;
    &lt;i class="fas @@(tieneAccesoEscritura ? "fa-user-slash" : "fa-lock")"&gt;&lt;/i&gt;
&lt;/button&gt;</code></pre>

                    <h6 class="mt-3"><i class="fas fa-check-circle me-2"></i>Resultado del Flujo</h6>
