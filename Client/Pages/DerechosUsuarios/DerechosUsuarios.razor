        &lt;i class="fas fa-user-slash"&gt;&lt;/i&gt;
        &lt;text&gt; Ver clientes dados de baja&lt;/text&gt;
    }
    else
    {
        &lt;i class="fas fa-lock"&gt;&lt;/i&gt;
        &lt;text&gt; Ver clientes dados de baja (Sin Permisos)&lt;/text&gt;
    }
&lt;/button&gt;</code></pre>

                    <h6 class="mt-3"><i class="fas fa-table me-2"></i>5. Botones de Acción en Tabla</h6>
                    <pre class="bg-dark text-light p-3 rounded"><code>&lt;!-- Botón Editar --&gt;
&lt;button class="btn btn-sm btn-outline-primary me-1" 
        @@onclick="() =&gt; EditarCliente(cliente.Id)" 
        disabled="@@(!tieneAccesoEscritura)"
        title="@@(tieneAccesoEscritura ? "Editar cliente" : "Sin permisos de escritura")"&gt;
    &lt;i class="fas @@(tieneAccesoEscritura ? "fa-edit" : "fa-lock")"&gt;&lt;/i&gt;
&lt;/button&gt;

