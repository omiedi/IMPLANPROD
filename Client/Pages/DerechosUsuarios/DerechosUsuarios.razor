    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p>Cargando derechos...</p>
        </div>
    }
    else if (derechos == null || !derechos.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i> No hay aplicaciones configuradas en el sistema.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-list"></i> Derechos de Acceso a Aplicaciones
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Filtro de búsqueda y botón Guardar -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" 
                                           class="form-control" 
                                           placeholder="Buscar por código o descripción de aplicación..."
                                           @bind="filtroBusqueda"
                                           @bind:event="oninput" />
                                    @if (!string.IsNullOrWhiteSpace(filtroBusqueda))
                                    {
                                        <button class="btn btn-outline-secondary" @onclick="LimpiarFiltro">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </div>
                                <small class="text-muted">
                                    Mostrando @DerechosFiltrados.Count() de @derechos.Count aplicaciones
                                </small>
                            </div>
                            <div class="col-md-6 text-end">
                                <button class="btn btn-success btn-lg" @onclick="GuardarDerechos" disabled="@(!hayCambios || guardando)">
                                    @if (guardando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Guardando...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save me-2"></i>
                                        <span>Guardar Cambios</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-bordered">
                                <thead class="table-dark">
                                    <tr>
                                        <th style="width: 50%;">Aplicación</th>
                                        <th style="width: 25%; text-align: center;">
                                            <i class="fas fa-eye"></i> Lectura
                                        </th>
                                        <th style="width: 25%; text-align: center;">
                                            <i class="fas fa-edit"></i> Escritura
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var derecho in DerechosFiltrados)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@derecho.DesApli</strong>
                                                <br />
                                                <small class="text-muted">Código: @derecho.CodApli</small>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <div class="form-check d-flex justify-content-center">
                                                    <input class="form-check-input" 
                                                           type="checkbox" 
                                                           @bind="derecho.TieneLectura"
                                                           @bind:after="() => MarcarCambio()"
                                                           style="width: 20px; height: 20px; cursor: pointer;" />
                                                </div>
                                            </td>
                                            <td style="text-align: center; vertical-align: middle;">
                                                <div class="form-check d-flex justify-content-center">
                                                    <input class="form-check-input" 
                                                           type="checkbox" 
                                                           @bind="derecho.TieneEscritura"
                                                           @bind:after="() => MarcarCambio()"
                                                           style="width: 20px; height: 20px; cursor: pointer;" />
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="d-flex justify-content-between">
                                    <button class="btn btn-secondary" @onclick="Volver">
                                        <i class="fas fa-arrow-left"></i> Volver
                                    </button>
                                    <button class="btn btn-success" @onclick="GuardarDerechos" disabled="@(!hayCambios || guardando)">
                                        @if (guardando)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-save me-2"></i>
                                        }
                                        Guardar Cambios
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int UsuarioId { get; set; }
    [Parameter] public int IdFlexoft { get; set; }

    private Usuario? usuario;
    private List<DerechoUsuarioDTO>? derechos;
    private List<Perfil> perfiles = new();

    // Variable para el filtro de búsqueda
    private string filtroBusqueda = string.Empty;

    // Variables para instructivos colapsables
    private bool mostrarInstructivoUsuario = false;

    private bool cargando = true;
    private bool guardando = false;
    private bool hayCambios = false;
    private string? mensajeError;

    // Propiedad calculada para filtrar derechos por código o descripción
    private IEnumerable<DerechoUsuarioDTO> DerechosFiltrados
    {
        get
        {
            if (derechos == null) return Enumerable.Empty<DerechoUsuarioDTO>();
            
            if (string.IsNullOrWhiteSpace(filtroBusqueda))
                return derechos;

            var filtro = filtroBusqueda.Trim().ToLower();
            
            return derechos.Where(d => 
                d.CodApli.ToLower().Contains(filtro) || 
                d.DesApli.ToLower().Contains(filtro)
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosUsuario();

        await CargarDerechos();
        cargando = false;
    }

    private async Task CargarDatosUsuario()
    {
        try
        {
            var responseHttp = await repository.Get<Usuario>($"api/usuarios/{UsuarioId}");
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                usuario = responseHttp.Response;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar datos del usuario: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private async Task CargarDerechos()
    {
        try
        {
            var responseHttp = await repository.Get<List<DerechoUsuarioDTO>>($"api/DerechosUsuario/usuario/{IdFlexoft}");
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                derechos = responseHttp.Response;
                hayCambios = false;
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar los derechos del usuario", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar derechos: {ex.Message}", SweetAlertIcon.Error);
        }
    }
  
    private void MarcarCambio()
    {
        hayCambios = true;
    }

    private async Task GuardarDerechos()
    {
        if (derechos == null) return;

        guardando = true;

        try
        {
            var responseHttp = await repository.Post($"api/DerechosUsuario/usuario/{IdFlexoft}", derechos);
            
            if (!responseHttp.Error)
            {
                await sweetAlertService.FireAsync(
                    "Éxito", 
                    "Los derechos se guardaron correctamente", 
                    SweetAlertIcon.Success
                );
                hayCambios = false;
                await CargarDerechos(); // Recargar para obtener los IDs actualizados
            }
            else
            {
                await sweetAlertService.FireAsync(
                    "Error", 
                    "No se pudieron guardar los derechos", 
                    SweetAlertIcon.Error
                );
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync(
                "Error", 
                $"Error al guardar derechos: {ex.Message}", 
                SweetAlertIcon.Error
            );
        }
        finally
        {
            guardando = false;
        }
    }

    private void Volver()
    {
        navigationManager.NavigateTo("/derechos-usuarios/lista");
    }

    private void RegresarALista()
    {
        navigationManager.NavigateTo("/derechos-usuarios/lista");
    }

    private void LimpiarFiltro()
    {
        filtroBusqueda = string.Empty;
    }
}
