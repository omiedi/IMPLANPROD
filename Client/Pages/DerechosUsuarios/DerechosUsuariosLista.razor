@page "/derechos-usuarios/lista"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@using IMPLANPROD.Shared.Entities
@inject IRepository repository
@inject HttpClient Http

@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<h3><i class="fas fa-user-shield"></i> Derechos de Usuarios</h3>

<div class="mb-3">
    <p class="text-muted">Seleccione un usuario para gestionar sus derechos de acceso a las aplicaciones del sistema</p>
</div>

@if (usuarios == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p>Cargando usuarios...</p>
    </div>
}
else if (!usuarios.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No hay usuarios registrados en el sistema.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th style="width: 80px;">Foto</th>
                    <th>Usuario</th>
                    <th>Num. Usuario</th>
                    <th>ID Flexoft</th>
                    <th>Email</th>
                    <th>Perfil</th>
                    <th>Estado</th>
                    <th style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in usuarios)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(usuario.FotoUrl))
                            {
                                <img src="@usuario.FotoUrl" alt="Foto" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <i class="fas fa-user text-white"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <strong>@usuario.NombreUsuario</strong>
                        </td>
                        <td>
                            <span class="badge bg-info">@usuario.Id</span>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@usuario.IdFlexoft</span>
                        </td>
                        <td>
                            <i class="fas fa-envelope text-muted"></i> @usuario.Email
                        </td>
@*                         <td>
                            @if (usuario.Perfil != null)
                            {
                                <span class="badge bg-primary">@usuario.Perfil.Nombre</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Sin perfil</span>
                            }
                        </td> *@
                        <td>
                            @{
                                var perfil = perfiles.FirstOrDefault(p => p.Id == usuario.PerfilId);
                            }
                            @(perfil != null ? perfil.Nombre : "Sin perfil")
                        </td>
                        <td>
                            @if (usuario.Activo == true)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-primary" @onclick="() => IrADerechos(usuario)">
                                <i class="fas fa-shield-alt"></i> Derechos
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Usuario>? usuarios;
    private List<Perfil> perfiles = new();
    private string? mensajeError;


    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
        await CargarPerfiles();

    }
    private async Task CargarPerfiles()
    {
        try
        {
            perfiles = await Http.GetFromJsonAsync<List<Perfil>>("api/Perfiles") ?? new List<Perfil>();
        }
        catch (Exception ex)
        {
            mensajeError = "Error al cargar los perfiles";
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
    private async Task CargarUsuarios()
    {
        try
        {
            var responseHttp = await repository.Get<List<Usuario>>("api/usuarios");
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                usuarios = responseHttp.Response;
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar los usuarios", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar usuarios: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private void IrADerechos(Usuario usuario)
    {
        // Navegar a la página de derechos pasando NumUsuar e IdFlexoft como parámetros
        navigationManager.NavigateTo($"/derechos-usuarios/{usuario.Id}/{usuario.IdFlexoft}");
    }
}
