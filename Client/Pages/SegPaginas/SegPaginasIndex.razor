@page "/seg-paginas"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<PageTitle>Páginas de Seguridad</PageTitle>

@if (paginas is null)
{
    <div class="spinner" />
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-file-alt me-2"></i>Páginas de Seguridad (SEG_PAGINA)</span>
            <a class="btn btn-sm btn-primary" href="/seg-paginas/crear">
                <i class="fas fa-plus me-1"></i>Nueva Página
            </a>
        </div>
        <div class="card-body">
            <div class="mb-3 d-flex flex-wrap gap-2">
                <select class="form-select" style="max-width:260px;" @bind="moduloFiltroId" @bind:after="Filtrar">
                    <option value="0">-- Todos los módulos --</option>
                    @foreach (var m in modulos)
                    {
                        <option value="@m.Id">@m.Nombre</option>
                    }
                </select>
                <input type="text" class="form-control" style="max-width:300px;"
                       placeholder="Buscar por nombre o ruta..."
                       @bind="filtroTexto" @bind:event="oninput" />
            </div>

            @if (!PaginasFiltradas.Any())
            {
                <div class="alert alert-info">No hay páginas que coincidan con la búsqueda.</div>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:60px">Id</th>
                            <th>Módulo</th>
                            <th>Nombre</th>
                            <th>Ruta</th>
                            <th style="width:70px">Orden</th>
                            <th style="width:90px">Config.</th>
                            <th style="width:80px">Activo</th>
                            <th style="width:180px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in PaginasFiltradas)
                        {
                            <tr>
                                <td>@p.Id</td>
                                <td><span class="badge bg-secondary">@(p.Modulo?.Nombre ?? "-")</span></td>
                                <td>@p.Nombre</td>
                                <td><code class="small">@p.Ruta</code></td>
                                <td class="text-center">@p.Orden</td>
                                <td class="text-center">
                                    @if (p.EsConfiguracion)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-cog"></i></span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (p.Activo)
                                    {
                                        <span class="badge bg-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    <a href="/seg-paginas/editar/@p.Id" class="btn btn-warning btn-sm me-1">
                                        <i class="fas fa-pencil-alt"></i> Editar
                                    </a>
                                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(p.Id)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <small class="text-muted">@PaginasFiltradas.Count() registros</small>
            }
        </div>
    </div>
}

@code {
    private List<SegPagina>? paginas;
    private List<SegModulo> modulos = new();
    private int moduloFiltroId;
    private string filtroTexto = string.Empty;

    private IEnumerable<SegPagina> PaginasFiltradas =>
        (paginas ?? Enumerable.Empty<SegPagina>())
        .Where(p => moduloFiltroId == 0 || p.ModuloId == moduloFiltroId)
        .Where(p => string.IsNullOrWhiteSpace(filtroTexto) ||
                    p.Nombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
                    p.Ruta.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadModulosAsync(), LoadAsync());
    }

    private async Task LoadModulosAsync()
    {
        var resp = await repository.Get<List<SegModulo>>("api/SegModulos");
        if (!resp.Error) modulos = resp.Response ?? new();
    }

    private async Task LoadAsync()
    {
        var resp = await repository.Get<List<SegPagina>>("api/SegPaginas");
        if (resp.Error)
        {
            await sweetAlertService.FireAsync("Error", await resp.GetErrorMessageAsync(), SweetAlertIcon.Error);
            return;
        }
        paginas = resp.Response ?? new();
    }

    private void Filtrar() { }

    private async Task DeleteAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar eliminación",
            Text = "¿Eliminar esta página? Si tiene permisos asignados a usuarios no se podrá borrar.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (string.IsNullOrEmpty(result.Value)) return;

        var resp = await repository.Delete($"api/SegPaginas/{id}");
        if (resp.Error)
        {
            await sweetAlertService.FireAsync("Error", await resp.GetErrorMessageAsync(), SweetAlertIcon.Error);
            return;
        }

        await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Icon = SweetAlertIcon.Success,
            Title = "Eliminado",
            Timer = 1200,
            ShowConfirmButton = false
        });
        await LoadAsync();
    }
}
