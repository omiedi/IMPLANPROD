@inject IRepository repository
@inject SweetAlertService sweetAlertService

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@if (modulosCombo is null)
{
    <div class="spinner" />
}
else
{
    <EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold">Módulo <span class="text-danger">*</span></label>
                <InputSelect class="form-select" @bind-Value="Pagina.ModuloId">
                    <option value="0">-- Seleccione un módulo --</option>
                    @foreach (var m in modulosCombo)
                    {
                        <option value="@m.Id">@m.Nombre</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => Pagina.ModuloId)" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="Pagina.Nombre" placeholder="Ej: Lista Órdenes de Compra" />
                <ValidationMessage For="@(() => Pagina.Nombre)" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold">Ruta <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="Pagina.Ruta" placeholder="Ej: /ordenes-compra" />
                <small class="text-muted">La ruta debe coincidir exactamente con el @("@page") de la página Blazor.</small>
                <ValidationMessage For="@(() => Pagina.Ruta)" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Componente (opcional)</label>
                <InputText class="form-control" @bind-Value="Pagina.Componente" placeholder="Ej: OrdenesCompraIndex" />
            </div>
            <div class="col-md-2 mb-3">
                <label class="form-label fw-semibold">Orden</label>
                <InputNumber class="form-control" @bind-Value="Pagina.Orden" />
            </div>
            <div class="col-md-3 mb-3 d-flex align-items-end gap-4">
                <div class="form-check mb-2">
                    <InputCheckbox class="form-check-input" @bind-Value="Pagina.Activo" id="chkPagActivo" />
                    <label class="form-check-label fw-semibold" for="chkPagActivo">Activo</label>
                </div>
                <div class="form-check mb-2">
                    <InputCheckbox class="form-check-input" @bind-Value="Pagina.EsConfiguracion" id="chkEsConfig" />
                    <label class="form-check-label" for="chkEsConfig">
                        <i class="fas fa-cog me-1 text-warning"></i>Es Configuración
                    </label>
                </div>
            </div>
        </div>

        <button class="btn btn-primary me-2" type="submit">
            <i class="fas fa-save me-1"></i>Guardar
        </button>
        <button class="btn btn-secondary" type="button" @onclick="ReturnAction">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </button>
    </EditForm>
}

@code {
    private EditContext editContext = null!;
    private List<SegModulo>? modulosCombo;

    [Parameter, EditorRequired]
    public SegPagina Pagina { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter, EditorRequired]
    public EventCallback ReturnAction { get; set; }

    public bool FormPostedSuccessfully { get; set; }

    protected override async Task OnInitializedAsync()
    {
        editContext = new(Pagina);
        var resp = await repository.Get<List<SegModulo>>("api/SegPaginas/modulos-combo");
        modulosCombo = resp.Error ? new() : (resp.Response ?? new());
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!editContext.IsModified() || FormPostedSuccessfully) return;

        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Abandonar la página y perder los cambios?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí",
            CancelButtonText = "No"
        });

        if (string.IsNullOrEmpty(result.Value))
            context.PreventNavigation();
    }
}
