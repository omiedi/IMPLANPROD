            {
                Console.WriteLine($"Descripción actualizada para imagen {imagen.Id}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al actualizar descripción: {ex.Message}");
            await sweetAlertService.FireAsync("Error", "Error al actualizar la descripción", SweetAlertIcon.Error);
        }
    }

    private async Task EliminarImagen(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¿Eliminar imagen?",
            Text = "Esta acción no se puede deshacer",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = false,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            try
            {
                var responseHttp = await repository.Delete($"api/galimmod/{id}");
                
                if (!responseHttp.Error)
                {
                    await sweetAlertService.FireAsync("Eliminado", "Imagen eliminada correctamente", SweetAlertIcon.Success);
                    await CargarImagenes();
                }
                else
                {
                    var message = await responseHttp.GetErrorMessageAsync();
                    await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                }
            }
            catch (Exception ex)
            {
                await sweetAlertService.FireAsync("Error", $"Error al eliminar imagen: {ex.Message}", SweetAlertIcon.Error);
            }
        }
    }

    // ═══════════════════════════════════════════════════════════════════
    // Botón Proveedor (Command24 del VB6 - ALTERNA con 2 opciones)
    // Replica los circuitos REMIMO09 "Remitir Modelo a Proveedor" (DESPAMODE)
    // y RECEMO09 "Recibir Modelo de Proveedor" (RECIMODE):
    //   - Selección de proveedor por número o selector (SELECHO PROVED1).
    //     Muestra Raso_Cli, Domi_Cli, Cpos_Cli y Loca_Cli de solo lectura.
    //   - N° de remito y fecha editables (Text7 / Text9 del VB6).
    //   - Textarea precargado con los datos del modelo (Text6 del VB6):
    //       Modelo: {Cod_Mod}
    //       {Descripcion}
    //       Cantidad de Piezas: {CantPiezas}
    //       Próximo Control: {FechPro_Con}
    //       {ObservaMod}
    //   Al confirmar se graba la anotación en BADAMODE_NOTA (equivalente
    //   al anotador ANOTAMOD del VB6, que en el nuevo sistema se guarda
    //   como nota del modelo). La impresión del remito se implementa aparte.
    // ═══════════════════════════════════════════════════════════════════
    private bool mostrarModalRemitoModelo = false;
    private string modoRemitoModelo = "despacho"; // "despacho" (REMIMO09) | "recepcion" (RECEMO09)
    private SelectorProveedores? selectorProveedoresModelo;
    private SelectorProveedores.ProveedorSeleccionado? proveedorRemitoModelo;
    private int? numeroProveedorRemito;
    private int? numeroRemitoModelo;
    private DateTime fechaRemitoModelo = DateTime.Today;
    private string textoRemitoModelo = string.Empty;
    private bool procesandoRemitoModelo = false;
    private int notasVersion = 0; // fuerza recarga de NotasObservaciones tras agregar la anotación

    // Datos del transportista del remito (solo despacho - PRIREMITO del VB6):
    // DTP$ empaqueta TRANSPOR(32) + DOMI-TRA(32) + CUIT-TRA(16) + PATE-TRA(16)
    // + COND-TRA(32) + DOCUCOND(24) para la impresión del remito.
    private string transpNombre = string.Empty;    // TRANSPOR: empresa de transporte
    private string transpDomicilio = string.Empty; // DOMI-TRA
    private string transpCuit = string.Empty;      // CUIT-TRA
    private string transpPatente = string.Empty;   // PATE-TRA
    private string transpChofer = string.Empty;    // COND-TRA: nombre del chofer
    private string transpDocChofer = string.Empty; // DOCUCOND: documento del chofer

    /// <summary>
    /// Opción "Despachar Modelo A Proveedor" (DESPAMODE del VB6).
    /// Mantiene el control de derechos: DERACCE("REMIMODE", "Remitir Modelo
    /// a Proveedor") >= 2 → TieneAccesoEscrituraAsync (nivel 2).
    /// </summary>
    private async Task AbrirDespachoModeloAsync()
    {
        if (!await derechosUsuario.TieneAccesoEscrituraAsync("REMIMODE", "Remitir Modelo a Proveedor"))
            return;

        AbrirModalRemitoModelo("despacho");
    }

    /// <summary>
    /// Opción "Recibir Modelo de Proveedor" (RECIMODE → RECEMO09 del VB6).
    /// </summary>
    private void AbrirRecepcionModelo() => AbrirModalRemitoModelo("recepcion");

    /// <summary>
    /// Inicializa y abre el modal de remito/recepción del modelo.
    /// Precarga el texto del VB6 (REMIMO09.Text6) con los datos del modelo.
    /// </summary>
    /// <param name="modo">"despacho" (REMIMO09) o "recepcion" (RECEMO09)</param>
    private void AbrirModalRemitoModelo(string modo)
    {
        modoRemitoModelo = modo;
        proveedorRemitoModelo = null;
        numeroProveedorRemito = null;
        numeroRemitoModelo = null;
        fechaRemitoModelo = DateTime.Today;

        // Limpiar datos del transportista (solo se usan en despacho)
        transpNombre = transpDomicilio = transpCuit = transpPatente = transpChofer = transpDocChofer = string.Empty;

        if (modo == "despacho")
        {
            // Texto precargado = REMIMO09.Text6 del VB6:
            //   "Modelo: {cod}" + línea vacía + {descripcion} + línea vacía +
            //   "Cantidad de Piezas: {n}" + "Próximo Control: {fecha}" +
            //   línea vacía + {observaciones del modelo}
            textoRemitoModelo =
                $"Modelo: {(Modelo.Cod_Mod ?? string.Empty).Trim()}\n\n" +
                $"{Modelo.Descripcion ?? string.Empty}\n\n" +
                $"Cantidad de Piezas: {Modelo.CantPiezas}\n" +
                $"Próximo Control: {Modelo.FechPro_Con:dd/MM/yyyy}\n\n" +
                $"{(Modelo.ObservaMod ?? string.Empty).Trim()}";
        }
        else
        {
            // Recepción (RECEMO09): área de solo lectura "Recibimos de Ustedes:"
            // con solo el código del modelo y su descripción.
            textoRemitoModelo =
                $"Modelo: {(Modelo.Cod_Mod ?? string.Empty).Trim()}\n" +
                $"{Modelo.Descripcion ?? string.Empty}";
        }

        mostrarModalRemitoModelo = true;
    }

    /// <summary>
    /// Cierra el modal de remito/recepción (Command3 "Exit" del VB6).
    /// </summary>
    private void CerrarModalRemitoModelo() => mostrarModalRemitoModelo = false;

    /// <summary>
    /// Abre el selector de proveedores (botón "." → SELECHO PROVED1 del VB6).
    /// </summary>
    private async Task AbrirSelectorProveedorModeloAsync()
    {
        if (selectorProveedoresModelo != null)
            await selectorProveedoresModelo.AbrirModal();
    }

    /// <summary>
    /// Handler de OnProveedorSeleccionado del selector: asigna el proveedor
    /// elegido y su número al campo editable.
    /// </summary>
    private void OnProveedorRemitoSeleccionado(SelectorProveedores.ProveedorSeleccionado proveedor)
    {
        proveedorRemitoModelo = proveedor;
        numeroProveedorRemito = proveedor.NumeCli;
    }

    /// <summary>
    /// Carga el proveedor por su número (Nume_Cli) cuando el usuario lo tipea
    /// directamente (Text1_Change → CARDACLI del VB6, REGICLI(-NPRO)).
    /// </summary>
    private async Task BuscarProveedorPorNumeroAsync()
    {
        if (!numeroProveedorRemito.HasValue || numeroProveedorRemito.Value <= 0)
        {
            proveedorRemitoModelo = null;
            return;
        }

        var response = await repository.Get<Proved12>($"api/Proved12/numero/{numeroProveedorRemito.Value}");
        if (!response.Error && response.Response != null)
        {
            var p = response.Response;
            proveedorRemitoModelo = new SelectorProveedores.ProveedorSeleccionado
            {
                NumeCli = p.Nume_Cli,
                RazonSocial = p.Raso_Cli ?? string.Empty,
                CodigoProveedor = p.Codi_Cli ?? string.Empty,
                Domicilio = p.Domi_Cli ?? string.Empty,
                CodigoPostal = p.Cpos_Cli ?? string.Empty,
                Localidad = p.Loca_Cli ?? string.Empty,
                Cuit = p.Cuit_Cli ?? string.Empty
            };
        }
        else
        {
            // Número sin proveedor asociado: limpiar los datos mostrados
            proveedorRemitoModelo = null;
        }
    }

    /// <summary>
    /// Confirmación del modal (Command1 del VB6: "Emite Remito" /
    /// "Aprueba recepción del modelo").
    /// Valida proveedor y N° de remito como en el VB6 y graba UN REGISTRO en
    /// BADAMODE_NOTA (Cod_Mod + Observaciones) — mismo mecanismo que el botón
    /// "Guardar Nota" de la solapa (POST api/observaciones).
    /// El texto replica el bloque que el VB6 escribe en el anotador
    /// (AGREGA_ANOTAMODELO → BADAMODE.ANOTAMOD):
    ///   {fecha}  {Título} - Remito {n}              {usuario}
    ///   (línea vacía)
    ///               Destino|Origen: {razón social}
    ///                          {domicilio}
    ///                          {CP} {localidad}
    ///   ============... (88)
    /// La impresión del remito se muestra en la vista previa aparte.
    /// </summary>
    private async Task EmitirRemitoModeloAsync()
    {
        // Validaciones del VB6 (Command1_Click):
        //   REGICLI(-NPRO) < 1 → "Seleccione Proveedor"
        if (proveedorRemitoModelo == null)
        {
            await sweetAlertService.FireAsync("Atención", "Seleccione Proveedor", SweetAlertIcon.Warning);
            return;
        }

        //   Val(Text7) < 1 → "Ingrese Número de Remito"
        if (!numeroRemitoModelo.HasValue || numeroRemitoModelo.Value <= 0)
        {
            await sweetAlertService.FireAsync("Atención", "Ingrese Número de Remito", SweetAlertIcon.Warning);
            return;
        }

        procesandoRemitoModelo = true;
        try
        {
            var esDespacho = modoRemitoModelo == "despacho";
            var titulo = esDespacho ? "Despacho a Proveedor" : "Recepción de Proveedor";
            var etiqueta = esDespacho ? "Destino" : "Origen";

            // USERNAME$ del VB6: nombre del usuario activo
            var nombreUsuario = await currentUserService.GetNombreUsuarioAsync();
            if (string.IsNullOrWhiteSpace(nombreUsuario))
                nombreUsuario = "SISTEMA";

            // Línea de encabezado de 76 chars (TTXX$ del VB6):
            //   pos 1-8  : fecha (Text9, dd/MM/yy)
            //   pos 11-56: "{título} - Remito {n}"
            //   pos 69-  : usuario (USERNAME$, truncado al largo de la línea)
            var lineaHeader = new string(' ', 76).ToCharArray();
            ReemplazarEnPosicionModelo(lineaHeader, fechaRemitoModelo.ToString("dd/MM/yy"), 0, 8);
            ReemplazarEnPosicionModelo(lineaHeader, $"{titulo} - Remito {numeroRemitoModelo}", 10, 56);
            ReemplazarEnPosicionModelo(lineaHeader, nombreUsuario, 68, 24);

            // Cuerpo del bloque (AGREGA_ANOTAMODELO del VB6):
            //   línea vacía + "            Destino|Origen: " + razón social
            //   + "                     " + domicilio + "                     " + CP + localidad
            //   + separador de 88 "="
            var observacion =
                new string(lineaHeader).TrimEnd() + "\n\n" +
                $"            {etiqueta}: {proveedorRemitoModelo.RazonSocial}\n" +
                $"                     {proveedorRemitoModelo.Domicilio}\n" +
                $"                     {($"{proveedorRemitoModelo.CodigoPostal} {proveedorRemitoModelo.Localidad}").Trim()}\n" +
                new string('=', 88);

            // Nuevo registro en BADAMODE_NOTA: Cod_Mod + Observaciones
            // (equivalente a "Nueva Nota" + "Guardar Nota" de la solapa)
            var dto = new GuardarObservacionDTO
            {
                NombreTabla = "BADAMODE_NOTA",
                CampoIdentificador = "Cod_Mod",
                ValorIdentificador = Modelo.Cod_Mod ?? string.Empty,
                EsTexto = true,
                Observaciones = observacion
            };

            var response = await repository.Post<GuardarObservacionDTO, ObservacionDTO>("api/observaciones", dto);
            if (response.Error)
            {
                var message = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            // Cerrar el modal de despacho ANTES de la alerta: SweetAlert
            // (swal2-container ~1060) quedaría detrás del modal (1070) y el
            // usuario no podría confirmarla. Además así la vista previa
            // nunca queda tapada por este modal.
            CerrarModalRemitoModelo();
            notasVersion++; // recargar el historial de notas para mostrar la anotación nueva

            await sweetAlertService.FireAsync("Éxito",
                esDespacho
                    ? "Remito registrado. La anotación se agregó a las notas del modelo."
                    : "Recepción registrada. La anotación se agregó a las notas del modelo.",
                SweetAlertIcon.Success);

            // PRIREMITO / PRIRECEPMOD del VB6: abrir la vista previa imprimible
            mostrarVistaPreviaRemito = true;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al emitir remito: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            procesandoRemitoModelo = false;
        }
    }

    // ── Vista previa e impresión del remito/recepción (PRIREMITO/PRIRECEPMOD) ──
    private bool mostrarVistaPreviaRemito = false;

    /// <summary>
    /// Indica si hay datos de transportista cargados (solo despacho).
