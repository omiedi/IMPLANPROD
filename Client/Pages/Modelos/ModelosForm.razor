        !string.IsNullOrWhiteSpace(transpNombre) ||
        !string.IsNullOrWhiteSpace(transpDomicilio) ||
        !string.IsNullOrWhiteSpace(transpCuit) ||
        !string.IsNullOrWhiteSpace(transpPatente) ||
        !string.IsNullOrWhiteSpace(transpChofer) ||
        !string.IsNullOrWhiteSpace(transpDocChofer);

