    /// <summary>
    /// Replica el REPLA del VB6: ubica un texto en una posición fija dentro
    /// de un array de caracteres, truncando lo que exceda el largo.
    /// </summary>
    /// <param name="linea">Array de la línea a completar</param>
    /// <param name="texto">Texto a ubicar</param>
    /// <param name="inicio">Posición inicial (base 0)</param>
    /// <param name="largo">Largo máximo del campo</param>
    private static void ReemplazarEnPosicionModelo(char[] linea, string texto, int inicio, int largo)
    {
        var t = (texto ?? string.Empty).Trim();
        if (t.Length > largo) t = t.Substring(0, largo);
        for (int i = 0; i < largo && inicio + i < linea.Length; i++)
            linea[inicio + i] = i < t.Length ? t[i] : ' ';
    }

    // ═══════════════════════════════════════════════════════════════════
    // Botón "Transacciones de Inspección" (Command7 del VB6 → NOVMOD09)
    // Replica el circuito "Registro de Inspección de Modelos":
    //   - Abre el modal con los datos del modelo, producto asociado,
    //     fecha de hoy y usuario activo.
    //   - Al registrar (Command3 del VB6) actualiza BADAMODE.FECHULT_CON /
    //     FECHPRO_CON (CALPROCON según FRECUEN) y graba la anotación en
    //     BADAMODE_NOTA (equivalente al anotador ANOTAMOD del VB6).
    // ═══════════════════════════════════════════════════════════════════
    private bool mostrarModalInspeccion = false;
    private string tipoRegistroInspeccion = "inspeccion"; // Option1/Option2 del VB6
    private DateTime fechaInspeccion = DateTime.Today;     // Text10 = hoy
    private string detalleInspeccion = string.Empty;       // Text1 del VB6
    private string usuarioInspeccion = string.Empty;       // Label9 = USERNAME
    private bool procesandoInspeccion = false;

    /// <summary>
    /// Command7 del VB6: abre el modal NOVMOD09 con los datos del modelo.
    /// Requiere DERACCE("REGINSPE", "Registro de Inspección de Modelos") >= 2.
    /// </summary>
    private async Task AbrirInspeccionModeloAsync()
    {
        if (!await derechosUsuario.TieneAccesoEscrituraAsync("REGINSPE", "Registro de Inspección de Modelos"))
            return;

        tipoRegistroInspeccion = "inspeccion"; // Option1.Value = True (por defecto Inspección)
        fechaInspeccion = DateTime.Today;
        detalleInspeccion = string.Empty;
        usuarioInspeccion = await currentUserService.GetNombreUsuarioAsync() ?? "SISTEMA";
        if (string.IsNullOrWhiteSpace(usuarioInspeccion))
            usuarioInspeccion = "SISTEMA";

        mostrarModalInspeccion = true;
    }

    /// <summary>
    /// Cierra el modal de inspección (Exit del VB6).
    /// </summary>
    private void CerrarModalInspeccion() => mostrarModalInspeccion = false;

    /// <summary>
    /// Command3 del VB6 "Registra inspección de modelo":
    /// 1) Valida que la fecha no sea futura y que el detalle no esté vacío.
    /// 2) Actualiza BADAMODE.FECHULT_CON = fecha de inspección y FECHPRO_CON =
    ///    CALPROCON según FRECUEN (1: +7 días, 2: +30, 3: +90, 4: +180, 5: +365),
    ///    persistiendo con PUT api/badamode (ACTUREGISTRO del VB6).
    /// 3) Graba la anotación en BADAMODE_NOTA con el formato del anotador VB6:
    ///      {fecha}  Registro de Inspección:|Reparación:        {usuario}
    ///      (línea vacía)
    ///                {detalle en líneas de 56 chars desde pos 11}
    ///      (línea vacía)
    ///                Próxima Inspección: {FechPro_Con}
    ///      ============... (88)
    /// </summary>
    private async Task RegistrarInspeccionModeloAsync()
    {
        // Validaciones del VB6 (Command3_Click):
        //   FF% < 1 Or FF% > HOY(HOS$) → "Fecha de Inspección no Válida."
        if (fechaInspeccion > DateTime.Today)
        {
            await sweetAlertService.FireAsync("Atención", "Fecha de Inspección no Válida.", SweetAlertIcon.Warning);
            return;
        }

        //   TRIM$(Text1) = "" → "No se Ha Ingresado Detalle de Inspección / Reparación"
        if (string.IsNullOrWhiteSpace(detalleInspeccion))
        {
            await sweetAlertService.FireAsync("Atención", "No se Ha Ingresado\nDetalle de Inspección / Reparación", SweetAlertIcon.Warning);
            return;
        }

        procesandoInspeccion = true;
        try
        {
            // ALTMOD09.Label6 = Text10 del VB6: la fecha de inspección pasa a
            // ser el Último Control y se recalcula el Próximo Control según
            // FRECUEN (CALPROCON → CalcularProximoControl).
            Modelo.FechUlt_Con = fechaInspeccion;
            CalcularProximoControl();

            // ACTUREGISTRO del VB6: persiste FECHULT_CON / FECHPRO_CON en BADAMODE
            var putResponse = await repository.Put($"api/badamode/{Modelo.Id}", Modelo);
            if (putResponse.Error)
            {
                var msg = await putResponse.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                return;
            }

            var tipoTitulo = tipoRegistroInspeccion == "reparacion" ? "Reparación" : "Inspección";

            // Encabezado de 76 chars (TTXX$ del VB6):
            //   pos 1-8  : fecha de hoy (HOS$)
            //   pos 11-56: "Registro de Inspección:|Reparación:"
            //   pos 69-  : usuario (USERNAME$)
            var lineaHeader = new string(' ', 76).ToCharArray();
            ReemplazarEnPosicionModelo(lineaHeader, DateTime.Today.ToString("dd/MM/yy"), 0, 8);
            ReemplazarEnPosicionModelo(lineaHeader, $"Registro de {tipoTitulo}:", 10, 56);
            ReemplazarEnPosicionModelo(lineaHeader, usuarioInspeccion, 68, 24);

            var lineas = new List<string>
            {
                new string(lineaHeader).TrimEnd(),
                string.Empty
            };

            // FRATEXTO(Text1, 56) del VB6: el detalle se franquea en líneas de
            // 56 caracteres ubicadas a partir de la posición 11.
            foreach (var linea in FranquearTexto(detalleInspeccion.Trim(), 56))
                lineas.Add(new string(' ', 10) + linea);

            lineas.Add(string.Empty);
            lineas.Add(new string(' ', 10) + $"Próxima Inspección: {Modelo.FechPro_Con:dd/MM/yy}");
            lineas.Add(new string('=', 88));

            // Nuevo registro en BADAMODE_NOTA: Cod_Mod + Observaciones
            // (equivalente a "Nueva Nota" + "Guardar Nota" de la solapa)
            var dto = new GuardarObservacionDTO
            {
                NombreTabla = "BADAMODE_NOTA",
                CampoIdentificador = "Cod_Mod",
                ValorIdentificador = Modelo.Cod_Mod ?? string.Empty,
                EsTexto = true,
                Observaciones = string.Join("\n", lineas)
            };

            var response = await repository.Post<GuardarObservacionDTO, ObservacionDTO>("api/observaciones", dto);
            if (response.Error)
            {
                var msg = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                return;
            }

            detalleInspeccion = string.Empty; // Text1 = "" del VB6
            CerrarModalInspeccion();
            notasVersion++; // recargar el historial de notas

            await sweetAlertService.FireAsync("Éxito",
                $"Registro de {tipoTitulo.ToLower()} guardado correctamente.",
                SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al registrar inspección: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            procesandoInspeccion = false;
        }
    }

    /// <summary>
    /// Replica FRATEXTO del VB6: divide un texto en líneas de máximo 'ancho'
    /// caracteres, cortando preferentemente por espacios (word wrap).
    /// </summary>
    private static List<string> FranquearTexto(string texto, int ancho)
    {
        var lineas = new List<string>();
        foreach (var parrafo in (texto ?? string.Empty).Split('\n'))
        {
            var p = parrafo.Trim();
            while (p.Length > ancho)
            {
                var corte = p.LastIndexOf(' ', ancho);
                if (corte <= 0) corte = ancho;
                lineas.Add(p.Substring(0, corte).TrimEnd());
                p = p.Substring(corte).TrimStart();
            }
            lineas.Add(p);
        }
        return lineas;
    }
}
