    }

    /// <summary>
    /// Calcula automáticamente la fecha de próximo control basándose en la fecha de último control y la frecuencia
    /// </summary>
    private void CalcularProximoControl()
    {
        if (Modelo == null || !Modelo.FechUlt_Con.HasValue || string.IsNullOrWhiteSpace(Modelo.Frecuen))
        {
            return;
        }

        DateTime fechaUltimoControl = Modelo.FechUlt_Con.Value;
        DateTime fechaProximoControl;

        // Extraer el número de la frecuencia (formato: "1 - Semanal", "2 - Mensual", etc.)
        string frecuencia = Modelo.Frecuen.Trim();
        
        if (frecuencia.StartsWith("1 -") || frecuencia.Contains("Semanal"))
        {
            // Semanal: +7 días
            fechaProximoControl = fechaUltimoControl.AddDays(7);
        }
        else if (frecuencia.StartsWith("2 -") || frecuencia.Contains("Mensual"))
        {
            // Mensual: +1 mes
            fechaProximoControl = fechaUltimoControl.AddMonths(1);
        }
        else if (frecuencia.StartsWith("3 -") || frecuencia.Contains("Trimestral"))
        {
            // Trimestral: +3 meses
            fechaProximoControl = fechaUltimoControl.AddMonths(3);
        }
        else if (frecuencia.StartsWith("4 -") || frecuencia.Contains("Semestral"))
        {
            // Semestral: +6 meses
            fechaProximoControl = fechaUltimoControl.AddMonths(6);
        }
        else if (frecuencia.StartsWith("5 -") || frecuencia.Contains("Anual"))
        {
            // Anual: +12 meses
            fechaProximoControl = fechaUltimoControl.AddMonths(12);
        }
        else
        {
            // Si no se reconoce la frecuencia, no calcular
            return;
        }

        Modelo.FechPro_Con = fechaProximoControl;
        Console.WriteLine($"Fecha próximo control calculada: {fechaProximoControl:dd/MM/yyyy} (Frecuencia: {frecuencia})");
        StateHasChanged();
    }

    // ==================== MÉTODOS PARA GALERÍA DE IMÁGENES ====================

    private async Task CargarImagenes()
    {
        if (string.IsNullOrWhiteSpace(Modelo.Cod_Mod)) return;
        
        try
        {
            cargandoImagenes = true;
            var responseHttp = await repository.Get<List<GalimMod>>($"api/galimmod/modelo/{Modelo.Cod_Mod}");
            
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                imagenes = responseHttp.Response;
                Console.WriteLine($"Imágenes cargadas: {imagenes.Count}");
            }
            else
            {
                imagenes = new List<GalimMod>();
                Console.WriteLine("No se encontraron imágenes o hubo un error");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar imágenes: {ex.Message}");
            await sweetAlertService.FireAsync("Error", "Error al cargar las imágenes", SweetAlertIcon.Error);
            imagenes = new List<GalimMod>();
        }
        finally
        {
            cargandoImagenes = false;
            StateHasChanged();
        }
    }

    private async Task SubirImagen(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null)
            {
                await sweetAlertService.FireAsync("Advertencia", "No se seleccionó ningún archivo", SweetAlertIcon.Warning);
                return;
            }

            // Validar que el modelo tenga Cod_Mod
            if (string.IsNullOrWhiteSpace(Modelo?.Cod_Mod))
            {
                Console.WriteLine("ERROR: Modelo.Cod_Mod está vacío o nulo");
                await sweetAlertService.FireAsync("Error", "El modelo no tiene código asignado. Guarde el modelo primero.", SweetAlertIcon.Error);
                return;
            }

            Console.WriteLine($"SubirImagen - Cod_Mod: '{Modelo.Cod_Mod}'");

            // Validar tamaño (máximo 5MB)
            const long maxFileSize = 5 * 1024 * 1024;
            if (file.Size > maxFileSize)
            {
                await sweetAlertService.FireAsync("Error", "El archivo es demasiado grande. Tamaño máximo: 5MB", SweetAlertIcon.Error);
                return;
            }

            // Validar extensión
            var extensionesPermitidas = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp" };
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (!extensionesPermitidas.Contains(extension))
            {
                await sweetAlertService.FireAsync("Error", "Tipo de archivo no permitido. Solo se permiten imágenes (jpg, png, gif, bmp)", SweetAlertIcon.Error);
                return;
            }

            cargandoImagenes = true;
            StateHasChanged();

            // Crear contenido multipart
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);
            content.Add(new StringContent(Modelo.Cod_Mod), "codMod");
            content.Add(new StringContent(""), "descripcion");

            Console.WriteLine($"Enviando POST a api/Galimmod/upload con codMod: '{Modelo.Cod_Mod}'");

            // Enviar al servidor usando PostFormData (método correcto para multipart/form-data)
            var responseHttp = await repository.PostFormData<GalimMod>("api/Galimmod/upload", content);

            Console.WriteLine($"Respuesta recibida - Error: {responseHttp.Error}");
            
            if (responseHttp.Error)
            {
                var errorMessage = await responseHttp.GetErrorMessageAsync();
                Console.WriteLine($"Error del servidor: {errorMessage}");
                await sweetAlertService.FireAsync("Error", errorMessage, SweetAlertIcon.Error);
            }
            else
            {
                Console.WriteLine($"Imagen subida exitosamente. ID: {responseHttp.Response?.Id}");
                await sweetAlertService.FireAsync("Éxito", "Imagen subida correctamente", SweetAlertIcon.Success);
                // Recargar imágenes
                await CargarImagenes();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al subir imagen: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al subir la imagen: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            cargandoImagenes = false;
            StateHasChanged();
        }
    }

    private async Task ActualizarDescripcion(GalimMod imagen)
    {
        try
        {
            var responseHttp = await repository.Put($"api/galimmod/{imagen.Id}", imagen.Descripcion);
            
            if (responseHttp.Error)
