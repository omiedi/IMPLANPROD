    private async Task VerDetalleRecepcionCore(int numeroRecepcion, int numeroOrdenCompra)
    {
        try
        {
            numeroRecepcionSeleccionada = numeroRecepcion;
            numeroOrdenCompraSeleccionada = numeroOrdenCompra;
            // Se envía el numeroOrdenCompra para que el backend traiga SOLO los items de esta recepción
            // que corresponden a la orden de compra seleccionada en la grilla (que agrupa por recepción + OC)
            var response = await repository.Get<List<RecepcionItemDTO>>($"api/bolrecep/items/{numeroRecepcion}?numeroOrdenCompra={numeroOrdenCompra}");
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", response.HttpResponseMessage.ToString(), SweetAlertIcon.Error);
                return;
            }

            itemsRecepcion = response.Response;
            
            // Inicializar CanToApro con CantidadNominal para cada item
            foreach (var item in itemsRecepcion)
            {
                item.CanToApro = item.CantidadNominal;
            }

            // Depósito de ingreso: se toma el del primer item (todos suelen tener el mismo DepoEnt).
            // El usuario puede cambiarlo desde el modal antes de aprobar.
            var primerItem = itemsRecepcion.FirstOrDefault();
            codigoDepositoCalidad = primerItem?.CodigoDeposito ?? 0;
            nombreDepositoCalidad = !string.IsNullOrWhiteSpace(primerItem?.NombreDeposito)
                ? primerItem.NombreDeposito
                : $"{codigoDepositoCalidad} - (depósito por defecto)";
            
            mostrarModalItems = true;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

