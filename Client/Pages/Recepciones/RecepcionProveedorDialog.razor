                style="transition: all 0.3s ease;">
            <i class="oi oi-task me-2"></i>
            <strong>Aprueba Calidad</strong>
        </button>
        @if (apruebaCalidadHabilitado)
        {
            <button class="btn @(activeTab == "aprobacionCalidad" ? "btn-primary" : "btn-outline-primary") flex-fill py-3 rounded-3 shadow-sm" 
                    @onclick='() => CambiarAAprobacionCalidad()'
                    style="transition: all 0.3s ease;">
                <i class="oi oi-check me-2"></i>
                <strong>Aprueba Almacén</strong>
            </button>
        }
        <button class="btn @(activeTab == "reportes" ? "btn-primary" : "btn-outline-primary") flex-fill py-3 rounded-3 shadow-sm" 
                @onclick='() => CambiarAReportes()'
                style="transition: all 0.3s ease;">
            <i class="oi oi-bar-chart me-2"></i>
            <strong>Reportes</strong>
        </button>
    </div>
    <div style="text-align:center;">
        <strong>**** Atención: Las recepciones pendientes de aprobación deberán pasarse manualmente. Avisar a Implanprod. ****</strong>
