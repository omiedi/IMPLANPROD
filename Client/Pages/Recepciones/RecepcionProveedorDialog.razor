        if (procesandoBusquedaProveedor) return;
        if (string.IsNullOrWhiteSpace(terminoBusquedaProveedor)) return;

        procesandoBusquedaProveedor = true;
        try
        {
            var terminoEncoded = Uri.EscapeDataString(terminoBusquedaProveedor);
            var responseHttp = await repository.Get<List<ProveedorDTO>>($"api/Proved12/buscar?termino={terminoEncoded}");
            if (responseHttp.Error)
            {
                var mensaje = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
                return;
            }

            proveedoresEncontrados = responseHttp.Response;
            if (!proveedoresEncontrados.Any())
            {
                await sweetAlertService.FireAsync("", "No se encontraron proveedores", SweetAlertIcon.Info);
            }
        }
        finally
        {
            procesandoBusquedaProveedor = false;
        }
    }

