    private async Task AprobarRecepcionPendienteCore()
    {
        try
        {
            // Validar tolerancia de días para aprobar recepción
            var validacionResponse = await repository.Get<ValidacionToleranciaDTO>($"api/bolrecep/validar-tolerancia-aprobacion/{numeroRecepcionSeleccionada}");
            if (!validacionResponse.Error && validacionResponse.Response != null)
            {
                if (!validacionResponse.Response.PuedeAprobar)
                {
                    await sweetAlertService.FireAsync("Atención", validacionResponse.Response.Mensaje, SweetAlertIcon.Warning);
                    return;
                }
            }

            // Filtrar solo los items de la recepción seleccionada
            var itemsRecepcionFiltrados = itemsRecepcion
                .Where(item => item.NumeBore == numeroRecepcionSeleccionada)
                .ToList();

            if (!itemsRecepcionFiltrados.Any())
            {
                await sweetAlertService.FireAsync("Error", "No hay items para aprobar en esta recepción.", SweetAlertIcon.Warning);
                return;
            }

            // ── Aprobación parcial ──────────────────────────────────────────
            // Solo se aprueban los items donde el usuario ingresó cantidades
            // (CanToApro + CantidadRechazada + CantidadFaltante > 0).
            // Las filas sin cantidad ingresada quedan pendientes (Status = 0)
            // y podrán aprobarse en una llamada posterior.
            var itemsAEnviar = itemsRecepcionFiltrados
                .Where(item => (item.CanToApro ?? 0) + (item.CantidadRechazada ?? 0) + (item.CantidadFaltante ?? 0) > 0)
                .ToList();

            if (!itemsAEnviar.Any())
            {
                await sweetAlertService.FireAsync("Atención",
                    "No ha ingresado cantidades en ningún item.\n" +
                    "Ingrese al menos una cantidad (Aprobada, Rechazada o Faltante) en los items que desea aprobar.",
                    SweetAlertIcon.Warning);
                return;
            }

            var itemsPendientes = itemsRecepcionFiltrados.Except(itemsAEnviar).ToList();

            // Si es una aprobación parcial, informar al usuario cuántos items quedan pendientes.
            if (itemsPendientes.Any())
            {
                var confirmacionParcial = await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Aprobación Parcial",
                    Text = $"Se aprobarán {itemsAEnviar.Count} de {itemsRecepcionFiltrados.Count} items.\n" +
                           $"{itemsPendientes.Count} item(s) quedarán pendientes de aprobación.\n\n¿Desea continuar?",
                    Icon = SweetAlertIcon.Question,
                    ShowCancelButton = true,
                    ConfirmButtonText = "Sí, aprobar",
                    CancelButtonText = "Cancelar"
                });
                if (!confirmacionParcial.IsConfirmed) return;
            }

            // Validar coherencia de cantidades solo para los items a aprobar
            var itemsInvalidos = new List<string>();
            foreach (var item in itemsAEnviar)
            {
                var suma = (item.CanToApro ?? 0) + (item.CantidadRechazada ?? 0) + (item.CantidadFaltante ?? 0);
                var diferencia = Math.Abs(item.CantidadNominal - suma);
                
                if (diferencia >= 0.0001m)
                {
                    itemsInvalidos.Add($"Código {item.CodigoInterno}: Nominal={item.CantidadNominal}, Suma={suma}, Diferencia={diferencia:0.##}");
                }
            }

            if (itemsInvalidos.Any())
            {
                var mensaje = "Las siguientes líneas tienen cantidades incoherentes:\n\n" + 
                              string.Join("\n", itemsInvalidos) + 
                              "\n\nLa suma de Aprobada + Rechazada + Faltante debe ser igual a la Cantidad Nominal.";
                await sweetAlertService.FireAsync("Error de Validación", mensaje, SweetAlertIcon.Error);
                return;
            }

            // Procesar items con rechazo
            var itemsConRechazo = itemsAEnviar.Where(item => (item.CantidadRechazada ?? 0) > 0).ToList();
            
            if (itemsConRechazo.Any())
            {
                // Cerrar el modal de items primero
                CerrarModalItems();
                
                // Pequeña pausa para que el DOM se actualice
                await Task.Delay(100);
                
                // Mostrar modales de rechazo uno por uno
                foreach (var item in itemsConRechazo)
                {
                    var modalParameters = new ModalParameters();
                    modalParameters.Add(nameof(RechazoRecepcionModal.Item), item);
                    
                    var modalOptions = new ModalOptions
                    {
                        DisableBackgroundCancel = true,
                        HideCloseButton = false
                    };
                    
                    var modalReference = Modal.Show<RechazoRecepcionModal>("Información de Rechazo", modalParameters, modalOptions);
                    var result = await modalReference.Result;
                    
                    if (result.Cancelled)
                    {
                        await sweetAlertService.FireAsync("Cancelado", "Debe completar la información de rechazo para todos los items", SweetAlertIcon.Info);
                        return;
                    }
                }
            }

            // Validar que se haya seleccionado un depósito de ingreso
            if (codigoDepositoCalidad <= 0)
            {
                await sweetAlertService.FireAsync("Atención", "Debe seleccionar un depósito de ingreso antes de aprobar.", SweetAlertIcon.Warning);
                return;
            }

            // Aplicar el depósito de ingreso elegido a todos los items y marcarlos como aprobados
            itemsAEnviar.ForEach(item => {
                item.CodigoDeposito = codigoDepositoCalidad;
                item.NombreDeposito = nombreDepositoCalidad;
                item.Status = 1;
            });

            Console.WriteLine($"[RecepcionProveedorDialog] Aprobando recepción {numeroRecepcionSeleccionada} con {itemsAEnviar.Count} de {itemsRecepcionFiltrados.Count} items, depósito {codigoDepositoCalidad}");

            var response = await repository.Post($"api/BolrecepMovisto/aprobarRecepcionEingresoMovisto/{numeroRecepcionSeleccionada}?numeroOrdenCompra={numeroOrdenCompraSeleccionada}", itemsAEnviar);
            if (response.Error)
            {
                var errorMsg = await response.GetErrorMessageAsync();
                Console.WriteLine($"[RecepcionProveedorDialog] Error al aprobar: {errorMsg}");
                await sweetAlertService.FireAsync("Error", $"Error al aprobar la recepción: {errorMsg}", SweetAlertIcon.Error);
                return;
            }

            // Preparamos el Vale Interno con los items aprobados y el depósito seleccionado.
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            nombreUsuarioActualVale = authState.User.Identity?.Name ?? "Usuario";
            origenVale = $"Recepción #{numeroRecepcionSeleccionada}";
            observacionesVale = string.Empty;
            itemsVale = itemsAEnviar.Where(i => (i.CanToApro ?? 0) > 0).ToList();
            mostrarModalVistaPreviaVale = true;

            // Cerramos el modal de items y limpiamos la selección; el Vale Interno queda abierto.
            mostrarModalItems = false;
            numeroRecepcionSeleccionada = 0;
            numeroOrdenCompraSeleccionada = 0;

            await CargarRecepcionesPendientes();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RecepcionProveedorDialog] Excepción al aprobar: {ex.Message}");
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

