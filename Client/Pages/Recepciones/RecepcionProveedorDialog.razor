@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; }
    [CascadingParameter] IModalService Modal { get; set; } = default!;

    private string activeTab = "busqueda";
    private string terminoBusquedaProveedor = "";
    private List<ProveedorDTO> proveedoresEncontrados = new();
    private ProveedorDTO? proveedorSeleccionado;
    private bool tieneOrdenesPendientes;
    private bool mostrarBotonesRecepcion;
    private List<RecepcionPendienteAprobacionDTO> recepcionesPendientes;
    // private bool validando = true;

    // ── Filtros de la solapa "Aprueba Calidad" ──────────────────────────────
    private string filtroNroRecepcion = string.Empty;
    private string filtroNroOC = string.Empty;
    private string filtroRemito = string.Empty;
    private string filtroNroProveedor = string.Empty;
    private string filtroRazonSocial = string.Empty;

    /// <summary>
    /// Aplica los filtros de texto (Nro. Recepción, Nro. OC, Remito, N. Proveedor y R. Social)
    /// sobre la lista de recepciones pendientes cargada desde el servidor. Es un filtro
    /// puramente en el cliente porque la lista completa ya está en memoria.
    /// </summary>
    private IEnumerable<RecepcionPendienteAprobacionDTO> RecepcionesPendientesFiltradas =>
        (recepcionesPendientes ?? new List<RecepcionPendienteAprobacionDTO>())
            .Where(r => string.IsNullOrWhiteSpace(filtroNroRecepcion) || r.NumeroRecepcion.ToString().Contains(filtroNroRecepcion.Trim()))
            .Where(r => string.IsNullOrWhiteSpace(filtroNroOC) || r.NumeroOrdenCompra.ToString().Contains(filtroNroOC.Trim()))
            .Where(r => string.IsNullOrWhiteSpace(filtroRemito) || (r.NumeroRemito ?? string.Empty).Contains(filtroRemito.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(r => string.IsNullOrWhiteSpace(filtroNroProveedor) || r.NumeroProveedor.ToString().Contains(filtroNroProveedor.Trim()))
            .Where(r => string.IsNullOrWhiteSpace(filtroRazonSocial) || (r.RazonSocial ?? string.Empty).Contains(filtroRazonSocial.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Limpia los filtros de la grilla de recepciones pendientes ("Aprueba Calidad").</summary>
    private void LimpiarFiltrosPendientes()
    {
        filtroNroRecepcion = string.Empty;
        filtroNroOC = string.Empty;
        filtroRemito = string.Empty;
        filtroNroProveedor = string.Empty;
        filtroRazonSocial = string.Empty;
    }

    // ── Modal "Detalle por Lote" (una fila por BOLRECEP, no agrupado) ───────
    private bool mostrarModalDetalleLotes = false;
    private bool mostrarModalImpresionDetalleLotes = false;
    private bool cargandoDetalleLotes = false;
    private List<RecepcionPendienteAprobacionDetalleDTO> recepcionesPendientesDetalle = new();

    private Dictionary<string, string> encabezadosDetalleLotes = new()
    {
        { "NumeroRecepcion", "Nro. Recepción" },
        { "FechaRecepcion", "Fecha" },
        { "NumeroOrdenCompra", "Nro. OC" },
        { "NumeroRemito", "Remito" },
        { "NumeroProveedor", "N. Proveedor" },
        { "RazonSocial", "R. Social" },
        { "IdenLote", "Lote" },
        { "Codigo", "Código" },
        { "Descripcion", "Descripción" },
        { "CantidadNominal", "Cantidad" }
    };

    /// <summary>
    /// Aplica los mismos 5 filtros de la grilla agrupada (Nro. Recepción, Nro. OC, Remito,
    /// N. Proveedor y R. Social) sobre el detalle por lote, para que el modal "Detalle por
    /// Lote" respete el filtro activo en la solapa "Aprueba Calidad".
    /// </summary>
    private IEnumerable<RecepcionPendienteAprobacionDetalleDTO> RecepcionesDetalleFiltradas =>
        recepcionesPendientesDetalle
            .Where(r => string.IsNullOrWhiteSpace(filtroNroRecepcion) || r.NumeroRecepcion.ToString().Contains(filtroNroRecepcion.Trim()))
            .Where(r => string.IsNullOrWhiteSpace(filtroNroOC) || r.NumeroOrdenCompra.ToString().Contains(filtroNroOC.Trim()))
            .Where(r => string.IsNullOrWhiteSpace(filtroRemito) || (r.NumeroRemito ?? string.Empty).Contains(filtroRemito.Trim(), StringComparison.OrdinalIgnoreCase))
            .Where(r => string.IsNullOrWhiteSpace(filtroNroProveedor) || r.NumeroProveedor.ToString().Contains(filtroNroProveedor.Trim()))
            .Where(r => string.IsNullOrWhiteSpace(filtroRazonSocial) || (r.RazonSocial ?? string.Empty).Contains(filtroRazonSocial.Trim(), StringComparison.OrdinalIgnoreCase));

    /// <summary>Carga el detalle por lote desde el servidor y abre el modal.</summary>
    private async Task AbrirModalDetalleLotes()
    {
        cargandoDetalleLotes = true;
        StateHasChanged();
        try
        {
            var response = await repository.Get<List<RecepcionPendienteAprobacionDetalleDTO>>("api/bolrecep/pendientes-aprobacion-detalle");
            if (response.Error)
            {
                var mensaje = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
                return;
            }

            recepcionesPendientesDetalle = response.Response ?? new List<RecepcionPendienteAprobacionDetalleDTO>();
            mostrarModalDetalleLotes = true;
        }
        finally
        {
            cargandoDetalleLotes = false;
            StateHasChanged();
        }
    }

    private void CerrarModalDetalleLotes() => mostrarModalDetalleLotes = false;

    private bool mostrarModalItems = false;
    private int numeroRecepcionSeleccionada;
    // Orden de compra seleccionada al abrir el modal de items.
    // Se usa para que el modal solo traiga los items de la recepción Y de esa OC en particular,
    // ya que la grilla de pendientes agrupa por (recepción + orden de compra).
    private int numeroOrdenCompraSeleccionada;
    private List<RecepcionItemDTO> itemsRecepcion;

    private List<dynamic> depositos;

    private List<RecepcionItemDTO> itemsRecepcionLibre = new();

    // Variables para órdenes de compra pendientes
    private bool mostrarModalOrdenesPendientes = false;
    private List<Ocomenca>? ordenesPendientes;
    private string proveedorFiltroOrdenes = string.Empty;
    private int? numeroProveedorFiltroOrdenes;
    private SelectorProveedores selectorProveedoresOrdenes = null!;
    private bool cargandoOrdenesPendientes = false;
    
    // Variables para detalle de orden
    private bool mostrarModalDetalleOrden = false;
    private int ordenIdSeleccionadaDetalle = 0;
    
    // Variables para impresión de orden pendiente
    private bool mostrarModalImpresionOrdenPendiente = false;
    private Ocomenca? ordenParaImprimirPendiente;
    private List<Ocomdeta>? detalleParaImprimirPendiente;

    // Variables para modal de recepciones por rango de fechas
    private bool mostrarModalRecepcionesRango = false;

    // Variables para modal de recepciones con rechazos
    private bool mostrarModalRecepcionesRechazos = false;

    // Variables para modal de recepciones sin orden de compra
    private bool mostrarModalRecepcionesSinOC = false;

    private string idElementoImpresionRecepcion = $"nota-recepcion-{Guid.NewGuid()}";
    private RecepcionPendienteAprobacionDTO? recepcionParaImprimir;
    private List<RecepcionItemDTO> itemsRecepcionParaImprimir = new();

    // Modal de configuración (FLEXCRL): Aprueba Calidad
    private bool apruebaCalidadHabilitado = false;

    // Datos de la grilla de "Aprobación de Calidad" (solo visible si APRUCALI está habilitado)
    private List<BrecepenPendienteCalidadDTO>? pendientesCalidad;
    private bool cargandoPendientesCalidad = false;
    private Dictionary<string, decimal> cantidadAprobarPorFila = new();

    private const string PROBUS_RECEPCION = "RECEPCIO";
    private const string CLABUS_APRUEBA_CALIDAD = "APRUCALI";

    protected override async Task OnInitializedAsync()
    {
        // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
        // await PageAccess.RequiereAccesoAsync("/recepcion/selproveedor");
        // validando = false;
        
        await base.OnInitializedAsync();
        await CargarDepositos();
        await CargarConfiguracionApruebaCalidad();
    }

    private async Task CargarConfiguracionApruebaCalidad()
    {
        var response = await repository.Get<FLEXCRL>($"api/flexcrl/{CLABUS_APRUEBA_CALIDAD}/{PROBUS_RECEPCION}");
        if (response.Error)
        {
            apruebaCalidadHabilitado = false;
            return;
        }

        var val = (response.Response?.VALCONTROL ?? string.Empty).Trim();
        apruebaCalidadHabilitado = val == "1" || (bool.TryParse(val, out var parsed) && parsed);
    }

    private Task CerrarModalItems()
    {
        mostrarModalItems = false;
        return Task.CompletedTask;
    }

    private async Task CargarDepositos()
    {
        var response = await repository.Get<List<dynamic>>("api/bolrecep/depositos");
        if (!response.Error)
        {
            depositos = response.Response;
        }
    }

    private async Task OnCantidadRechazadaChanged(RecepcionItemDTO item, decimal? valor)
    {
        item.CantidadRechazada = valor;
        if (valor.HasValue && valor > 0 && item.CodigoDepositoRechazo <= 0)
        {
            await SeleccionarDepositoRechazo(item);
        }
        else if (!valor.HasValue || valor <= 0)
        {
            item.CodigoDepositoRechazo = 0;
            item.NombreDepositoRechazo = null;
        }
        StateHasChanged();
    }

    private async Task SeleccionarDepositoRechazo(RecepcionItemDTO item)
    {
        var parameters = new ModalParameters()
            .Add(nameof(SeleccionarDepositoDialog.CodigoSeleccionado), item.CodigoDepositoRechazo);
        
        var modal = modalService.Show<SeleccionarDepositoDialog>("Seleccionar Depósito para Rechazo", parameters);
        var result = await modal.Result;

        if (!result.Cancelled)
        {
            var deposito = (DepositoDTO)result.Data;
            item.CodigoDepositoRechazo = deposito.Id;
            item.NombreDepositoRechazo = deposito.Nombre;
