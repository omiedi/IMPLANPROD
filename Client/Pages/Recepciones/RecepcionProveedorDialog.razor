    private async Task OnCantidadRechazadaChanged(RecepcionItemDTO item, decimal? valor)
    {
        item.CantidadRechazada = valor;
        if (valor.HasValue && valor > 0 && item.CodigoDepositoRechazo <= 0)
        {
