    @if (activeTab == "busqueda")
    {
        <div class="row mb-3">
            <div class="col">
                <div class="form-group">
                    <label class="mb-2">Razón Social:</label>
                    <div class="input-group">
                        <input type="text" 
                               class="form-control" 
                               @bind-value="terminoBusquedaProveedor" 
                               @bind-value:event="oninput" 
                               @onkeyup="async (KeyboardEventArgs e) => await OnKeyPress(e)"
                               data-autofocus
                               placeholder="Buscar proveedor..." />
                        <button class="btn btn-primary" type="button" @onclick="BuscarProveedorPorRazonSocial">
                            <i class="oi oi-magnifying-glass"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (proveedoresEncontrados.Any())
        {
            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Nº Proveedor</th>
                            <th>Razón Social</th>
                            <th>CUIT</th>
                            <th>Nombre Fantasía</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proveedor in proveedoresEncontrados)
                        {
                            <tr>
                                <td>@proveedor.Id</td>
                                <td>@proveedor.NumeCli</td>
                                <td>@proveedor.RazonSocial</td>
                                <td>@proveedor.Cuit</td>
                                <td>@proveedor.Email</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => SeleccionarProveedor(proveedor)">
                                        Seleccionar
