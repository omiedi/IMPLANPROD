        }
    }
    else if (activeTab == "pendientes")
    {
        @if (recepcionesPendientes == null)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (!recepcionesPendientes.Any())
        {
            <div class="alert alert-info">
                No hay recepciones pendientes de aprobación.
            </div>
        }
        else
        {
            <div class="row g-2 mb-2">
                <div class="col-md-2">
                    <label class="form-label small mb-0">Nro. Recepción</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind-value="filtroNroRecepcion" @bind-value:event="oninput" placeholder="Nro. Recepción" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Nro. OC</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind-value="filtroNroOC" @bind-value:event="oninput" placeholder="Nro. OC" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Remito</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind-value="filtroRemito" @bind-value:event="oninput" placeholder="Remito" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">N. Proveedor</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind-value="filtroNroProveedor" @bind-value:event="oninput" placeholder="N. Proveedor" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">R. Social</label>
                    <input type="text" class="form-control form-control-sm"
                           @bind-value="filtroRazonSocial" @bind-value:event="oninput" placeholder="R. Social" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100" @onclick="LimpiarFiltrosPendientes" title="Limpiar filtros">
                        <i class="oi oi-x"></i>
                    </button>
                </div>
            </div>

            <div class="mb-2 text-end">
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AbrirModalDetalleLotes" disabled="@cargandoDetalleLotes">
                    @if (cargandoDetalleLotes)
                    { <span class="spinner-border spinner-border-sm me-1"></span> }
                    else
                    { <i class="oi oi-list-rich me-1"></i> }
                    Ver Detalle por Lote
                </button>
            </div>

            @if (!RecepcionesPendientesFiltradas.Any())
            {
                <div class="alert alert-info">
                    No hay recepciones que coincidan con los filtros aplicados.
                </div>
            }
            else
            {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr class="bg-primary text-white">
                            <th class="text-center" style="border-right: 1px solid #dee2e6;">
                                <strong>Nro. Recepción</strong>
                            </th>
                            <th class="text-center" style="border-right: 1px solid #dee2e6;">
                                <strong>Fecha</strong>
                            </th>
                            <th class="text-center" style="border-right: 1px solid #dee2e6;">
                                <strong>Nro. OC</strong>
                            </th>
                            <th class="text-center" style="border-right: 1px solid #dee2e6;">
                                <strong>Remito</strong>
                            </th>
                            <th class="text-center" style="border-right: 1px solid #dee2e6;">
                                <strong>N. Proveedor</strong>
                            </th>
                            <th class="text-center" style="border-right: 1px solid #dee2e6;">
                                <strong>R. Social</strong>
                            </th>
                            <th class="text-center">
                                <strong>Acciones</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var recepcion in RecepcionesPendientesFiltradas)
                        {
                            <tr>
                                <td class="text-center" style="border-right: 1px solid #dee2e6;">@recepcion.NumeroRecepcion</td>
                                <td class="text-center" style="border-right: 1px solid #dee2e6;">@recepcion.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center" style="border-right: 1px solid #dee2e6;">@(recepcion.NumeroOrdenCompra == 0 ? "-" : recepcion.NumeroOrdenCompra.ToString())</td>
                                <td style="border-right: 1px solid #dee2e6;">@recepcion.NumeroRemito</td>
                                <td class="text-center" style="border-right: 1px solid #dee2e6;">@recepcion.NumeroProveedor</td>
                                <td style="border-right: 1px solid #dee2e6;">@recepcion.RazonSocial</td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-primary" @onclick="() => VerDetalleRecepcion(recepcion.NumeroRecepcion, recepcion.NumeroOrdenCompra)">
                                            <i class="oi oi-list"></i> Aprobar
                                        </button>
                                        <button class="btn btn-sm btn-success ms-1" @onclick="() => ImprimirRecepcionPendienteAsync(recepcion.NumeroRecepcion)">
                                            <i class="fas fa-print"></i> Imprimir
                                        </button>
                                        <button class="btn btn-sm btn-danger ms-1" @onclick="() => ConfirmarBorrarRecepcion(recepcion.NumeroRecepcion)">
                                            <i class="oi oi-trash"></i> Borrar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
        }
    }
    else if (activeTab == "aprobacionCalidad")
    {
        @* Esta solapa solo se muestra si la configuración FLEXCRL (PROBUS=RECEPCIO, CLABUS=APRUCALI) está activa *@
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <strong>Aprobación de Almacén</strong>
            </div>
            <div class="card-body">
                @if (cargandoPendientesCalidad)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                }
                else if (pendientesCalidad == null || !pendientesCalidad.Any())
                {
                    <div class="alert alert-info mb-0">
                        No hay recepciones pendientes de aprobación de calidad.
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 40vh; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th style="width: 18%;">Recepción</th>
                                    <th style="width: 18%;">Código</th>
                                    <th>Descripción</th>
                                    <th class="text-end" style="width: 18%;">Pendiente</th>
                                    <th class="text-end" style="width: 18%;">Aprobar</th>
                                    <th style="width: 10%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in pendientesCalidad)
                                {
                                    var key = GetPendienteCalidadKey(row);
                                    <tr>
                                        <td>@row.Doprilar</td>
                                        <td>@row.Codigo</td>
                                        <td>@row.Descripcion</td>
                                        <td class="text-end"><strong>@row.CantidadPendiente</strong></td>
                                        <td class="text-end">
                                            <input type="number"
                                                   class="form-control form-control-sm text-end no-spinner"
                                                   @bind-value="cantidadAprobarPorFila[key]"
                                                   @bind-value:event="oninput"
                                                   min="0"
                                                   step="0.0001" />
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-success"
                                                    title="Aprobar"
                                                    @onclick="() => ConfirmarYAprobarPendienteCalidad(row)">
                                                Aprobar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else if (activeTab == "reportes")
    {
        <!-- Encabezado con logo de la empresa -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body text-center py-4">
                        <img src="/images/logoempresa.png" alt="Logo Empresa" style="max-height: 80px; margin-bottom: 15px;" />
                        <h4 class="mb-2">Reportes de Recepciones</h4>
                        <p class="text-muted mb-0">Seleccione el tipo de reporte que desea generar</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Botón de Gráficos -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card border-success">
                    <div class="card-body text-center py-4">
                        <h5 class="text-success mb-3">
                            <i class="fas fa-chart-line me-2"></i>
                            Análisis Gráfico de Recepciones
                        </h5>
                        <p class="text-muted mb-3">
                            Visualice gráficos interactivos de recepciones, calificación de proveedores por puntualidad y rechazos, 
                            y análisis de tendencias mensuales.
                        </p>
                        <a href="/graficos-recepciones" class="btn btn-success btn-lg">
                            <i class="fas fa-chart-bar me-2"></i>
                            Ver Gráficos y Análisis
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aquí se pueden agregar filtros y opciones de reportes -->
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <i class="fas fa-shopping-cart me-2"></i>
                        <strong>O.Compra Pendientes</strong>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Visualizar órdenes de compra pendientes con opciones de filtrado por proveedor.</p>
                        <button class="btn btn-sm btn-outline-primary" @onclick="AbrirModalOrdenesPendientes">
                            <i class="oi oi-eye me-1"></i> Ver Órdenes Pendientes
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header text-white" style="background-color: #dc3545;">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Recepciones con Rechazos</strong>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Reporte de recepciones que tienen cantidades rechazadas.</p>
                        <button class="btn btn-sm btn-outline-danger" @onclick="AbrirModalRecepcionesRechazos">
                            <i class="oi oi-document me-1"></i> Generar Reporte
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-warning text-dark">
                        <i class="fas fa-calendar-alt me-2"></i>
                        <strong>Recepciones por Rango de Fechas y Reimpresion</strong>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Reporte de recepciones filtradas por rango de fechas y códigos de productos.</p>
                        <button class="btn btn-sm btn-outline-warning" @onclick="AbrirModalRecepcionesRango">
                            <i class="oi oi-document me-1"></i> Seleccionar Recepciónes
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header text-white" style="background-color: #17a2b8;">
                        <i class="fas fa-file-invoice me-2"></i>
                        <strong>Recepciones sin Orden de Compra</strong>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Reporte de recepciones que no tienen orden de compra asociada.</p>
                        <button class="btn btn-sm btn-outline-info" @onclick="AbrirModalRecepcionesSinOC">
                            <i class="oi oi-document me-1"></i> Generar Reporte
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (proveedorSeleccionado != null && mostrarBotonesRecepcion)
    {
        <div class="row mt-3">
            <div class="col text-center">
                @if (tieneOrdenesPendientes)
                {
                    <button class="btn btn-success me-2" @onclick="RecepcionarPorOrdenCompra">
                        Recepción Provisoria por O/C
                    </button>
                }
                <button class="btn btn-primary" @onclick="RecepcionLibre">
                    Recepción Provisoria Libre
                </button>
            </div>
        </div>
    }
</div>

@* ═══════════════════════════════════════════════════════════════════════
   Modal "Detalle por Lote" (solapa Aprueba Calidad)
   ───────────────────────────────────────────────────────────────────────
   Muestra una fila por cada registro de BOLRECEP (no agrupado): una misma
   recepción puede aparecer varias veces, una por cada lote (IdenLote).
   Respeta los mismos 5 filtros de la grilla agrupada (RecepcionesDetalleFiltradas
   reutiliza los mismos campos de filtro). No tiene columna de Acción; solo
   es informativo. Incluye el botón "Imprimir/Excel" con el componente
   ImpresionLista (mismo patrón que el resto del sistema) para exportar
   exactamente la lista ya filtrada.
   ═══════════════════════════════════════════════════════════════════════ *@
<div class="modal fade @(mostrarModalDetalleLotes ? "show" : "")" style="display: @(mostrarModalDetalleLotes ? "block" : "none")" tabindex="-1">
    <div class="modal-dialog" style="max-width: 95vw;">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="oi oi-list-rich me-2"></i>Detalle por Lote - Recepciones Pendientes</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalDetalleLotes"></button>
            </div>
            <div class="modal-body">
                @if (!RecepcionesDetalleFiltradas.Any())
                {
                    <div class="alert alert-info mb-0">
                        No hay lotes que coincidan con los filtros aplicados.
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 65vh; overflow-y: auto;">
                        <table class="table table-sm table-hover table-bordered mb-0">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th class="text-center">Nro. Recepción</th>
                                    <th class="text-center">Fecha</th>
                                    <th class="text-center">Nro. OC</th>
                                    <th>Remito</th>
                                    <th class="text-center">N. Proveedor</th>
                                    <th>R. Social</th>
                                    <th>Lote</th>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in RecepcionesDetalleFiltradas)
                                {
                                    <tr>
                                        <td class="text-center">@item.NumeroRecepcion</td>
                                        <td class="text-center">@item.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center">@(item.NumeroOrdenCompra == 0 ? "-" : item.NumeroOrdenCompra.ToString())</td>
                                        <td>@item.NumeroRemito</td>
                                        <td class="text-center">@item.NumeroProveedor</td>
                                        <td>@item.RazonSocial</td>
                                        <td>@item.IdenLote</td>
                                        <td>@item.Codigo</td>
                                        <td>@item.Descripcion</td>
                                        <td class="text-end">@item.CantidadNominal.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-success" @onclick="@(() => mostrarModalImpresionDetalleLotes = true)"
                        disabled="@(!RecepcionesDetalleFiltradas.Any())">
                    <i class="fas fa-file-excel me-1"></i>Imprimir/Excel
                </button>
                <button type="button" class="btn btn-secondary" @onclick="CerrarModalDetalleLotes">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@if (mostrarModalDetalleLotes)
{
    <div class="modal-backdrop fade show"></div>
}

@* Componente estándar de impresión/exportación a Excel, reutilizando la misma lista filtrada. *@
<ImpresionLista TItem="RecepcionPendienteAprobacionDetalleDTO"
                Datos="@RecepcionesDetalleFiltradas.ToList()"
                Titulo="Detalle de Recepciones Pendientes por Lote"
                UrlExportarExcel="api/excel/exportar-recepciones-pendientes-detalle"
                Encabezados="encabezadosDetalleLotes"
                ModoDirecto="false"
                MostrarModal="mostrarModalImpresionDetalleLotes"
                OnCerrar="@(() => mostrarModalImpresionDetalleLotes = false)" />

@* Modal de Items de Recepción *@
<div class="modal fade @(mostrarModalItems ? "show" : "")" style="display: @(mostrarModalItems ? "block" : "none")" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Items de Recepción #@numeroRecepcionSeleccionada</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalItems"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-end mb-3">
                    @if (numeroRecepcionSeleccionada == 0)
                    {
                        <button type="button" class="btn btn-success" @onclick="AgregarMasRepuestos">
                            <i class="oi oi-plus"></i> Agregar Repuesto
                        </button>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr class="bg-light">
                                <th>Código Interno</th>
                                <th>Código Externo</th>
                                <th>Descripción</th>
                                <th class="text-center">Cant. Nominal</th>
                                <th>Unidad</th>
                                <th class="text-center">Cant. Aprobada</th>
                                <th class="text-center">Cant. Rechazada</th>
                                <th class="text-center">Cant. Faltante</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (itemsRecepcion != null)
                            {
                                @foreach (var item in itemsRecepcion)
                                {
                                    var diferencia = item.CantidadNominal - (item.CanToApro ?? 0) - (item.CantidadRechazada ?? 0) - (item.CantidadFaltante ?? 0);
                                    var esValido = Math.Abs(diferencia) < 0.0001m; // Tolerancia para decimales
                                    
                                    <tr class="@(esValido ? "" : "table-warning")">
                                        <td>@item.CodigoInterno</td>
                                        <td>@item.CodigoExterno</td>
                                        <td>@item.DescripcionItem</td>
                                        <td class="text-center"><strong>@item.CantidadNominal</strong></td>
                                        <td>@item.Unidad</td>
                                        <td>
                                            <input type="number" 
                                                   class="form-control form-control-sm no-spinner" 
                                                   @bind-value="item.CanToApro"
                                                   @bind-value:event="oninput"
                                                   @onchange="() => ValidarCantidades(item)"
                                                   step="0.01"
                                                   min="0" />
                                        </td>
                                        <td>
                                            <input type="number" 
                                                   class="form-control form-control-sm no-spinner" 
                                                   @bind-value="item.CantidadRechazada"
                                                   @bind-value:event="oninput"
                                                   @onchange="() => ValidarCantidades(item)"
                                                   step="0.01"
                                                   min="0" />
                                        </td>
                                        <td>
                                            <input type="number" 
                                                   class="form-control form-control-sm no-spinner" 
                                                   @bind-value="item.CantidadFaltante"
                                                   @bind-value:event="oninput"
                                                   @onchange="() => ValidarCantidades(item)"
                                                   step="0.01"
                                                   min="0" />
                                        </td>
                                        <td class="text-center">
                                            @if (esValido)
                                            {
                                                <span class="badge bg-success">✓ OK</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark" title="La suma debe ser igual a la cantidad nominal">
                                                    ⚠ Diferencia: @diferencia.ToString("0.##")
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                @if (numeroRecepcionSeleccionada == 0)
                {
                    <button type="button" class="btn btn-success" @onclick="AgregarMasRepuestos">
                        <i class="oi oi-plus"></i> Agregar Repuesto
                    </button>
                }
                <button type="button" class="btn btn-secondary" @onclick="CerrarModalItems">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="AprobarRecepcionPendiente">Aprobar Recepción</button>
            </div>
        </div>
    </div>
</div>

@if (mostrarModalItems)
