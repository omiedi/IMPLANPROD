        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
            // Asegurar que el modal de items se vuelva a mostrar incluso si hay error
            mostrarModalItems = true;
            StateHasChanged();
        }
    }

