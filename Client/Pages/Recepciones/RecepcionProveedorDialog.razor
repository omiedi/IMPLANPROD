    // Método para imprimir orden (similar al de OrdenesCompraIndex)
    private async Task ImprimirOrdenPendiente(int numeroOrden)
    {
        try
        {
            // Buscar la orden en la lista actual
            ordenParaImprimirPendiente = ordenesPendientes?.FirstOrDefault(o => o.NumeOcom == numeroOrden);
            
            if (ordenParaImprimirPendiente == null)
            {
                await sweetAlertService.FireAsync("Error", "No se encontró la orden de compra.", SweetAlertIcon.Error);
                return;
            }

            // Cargar el detalle de la orden
            var responseDetalle = await repository.Get<List<Ocomdeta>>($"api/ocomdeta/orden/{ordenParaImprimirPendiente.OCOMENCA_ID}");
            if (responseDetalle.Error)
            {
                var message = await responseDetalle.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar detalle de la orden: {message}", SweetAlertIcon.Error);
                return;
            }

            detalleParaImprimirPendiente = responseDetalle.Response ?? new List<Ocomdeta>();
            mostrarModalImpresionOrdenPendiente = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al preparar impresión: {ex.Message}");
            await sweetAlertService.FireAsync("Error", "Error al preparar la impresión.", SweetAlertIcon.Error);
        }
    }

