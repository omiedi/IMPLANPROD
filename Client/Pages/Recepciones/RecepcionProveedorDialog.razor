    private async Task ImprimirReporteOrdenesPendientes()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al imprimir reporte: {ex.Message}");
            await sweetAlertService.FireAsync("Error", "Error al imprimir el reporte", SweetAlertIcon.Error);
        }
    }

    private async Task ImprimirRecepcionPendienteAsync(int numeroRecepcion)
    {
        try
        {
            recepcionParaImprimir = recepcionesPendientes?.FirstOrDefault(r => r.NumeroRecepcion == numeroRecepcion);
            if (recepcionParaImprimir == null)
            {
                await sweetAlertService.FireAsync("Error", "No se encontró la recepción.", SweetAlertIcon.Error);
                return;
            }

            var response = await repository.Get<List<RecepcionItemDTO>>($"api/bolrecep/items/{numeroRecepcion}");
            if (response.Error)
            {
                var mensaje = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
                return;
            }

            itemsRecepcionParaImprimir = response.Response ?? new List<RecepcionItemDTO>();
            StateHasChanged();
            await Task.Delay(50);

            await JSRuntime.InvokeVoidAsync("imprimirElemento", idElementoImpresionRecepcion);
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }
