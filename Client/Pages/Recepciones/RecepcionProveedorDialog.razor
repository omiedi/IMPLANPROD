                // Resetear el estado para permitir seleccionar otro proveedor
                mostrarBotonesRecepcion = false;
                proveedorSeleccionado = null;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

