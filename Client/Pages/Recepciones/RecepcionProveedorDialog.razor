    // Carga la grilla de la solapa "Aprueba Almacén": trae los pendientes desde el backend
    // (agrupados por LOTE + producto) e inicializa el input de cada fila con el pendiente actual.
    private async Task CargarPendientesCalidad()
    {
        cargandoPendientesCalidad = true;
        try
        {
            // Pedimos al backend los grupos pendientes (SUM(CANTINGRE) - SUM(CANTSALID de 'AP') > 0).
            var response = await repository.Get<List<BrecepenPendienteCalidadDTO>>("api/brecepen/pendientes-calidad");
            if (response.Error)
            {
                // Ante error dejamos la grilla vacía para no romper el render.
                pendientesCalidad = new List<BrecepenPendienteCalidadDTO>();
                cantidadAprobarPorFila = new Dictionary<string, decimal>();
                return;
            }

            pendientesCalidad = response.Response ?? new List<BrecepenPendienteCalidadDTO>();
            // Precargamos, por cada fila, la cantidad a aprobar = pendiente completo (el usuario puede editarlo).
            // La clave del diccionario es LOTE|COD_INTE (ver GetPendienteCalidadKey).
            cantidadAprobarPorFila = pendientesCalidad.ToDictionary(
                x => GetPendienteCalidadKey(x),
                x => x.CantidadPendiente);
        }
        finally
        {
            // Pase lo que pase apagamos el spinner y refrescamos la UI.
            cargandoPendientesCalidad = false;
            StateHasChanged();
        }
    }

    // Clave única de cada fila de la grilla = LOTE + producto.
    // Se usa para mapear la fila con su cantidad a aprobar en el diccionario cantidadAprobarPorFila.
    private static string GetPendienteCalidadKey(BrecepenPendienteCalidadDTO row)
    {
        return $"{row.Idenlote}|{row.CodInte}";
    }

    // Confirma y ejecuta la aprobación de una fila de la solapa "Aprueba Calidad".
    // Valida la cantidad, permite modificar el depósito de ingreso, pide confirmación
    // al usuario, llama al endpoint POST api/brecepen/aprobar y, si todo sale bien,
    // muestra el Vale Interno listo para imprimir (mismo formato que la O.F.).
    private async Task ConfirmarYAprobarPendienteCalidad(BrecepenPendienteCalidadDTO row)
    {
        if (procesandoAprobacionCalidad != null) return;
        procesandoAprobacionCalidad = GetPendienteCalidadKey(row);
        try
        {
            await ConfirmarYAprobarPendienteCalidadCore(row);
        }
        finally
        {
            procesandoAprobacionCalidad = null;
        }
    }

    private async Task ConfirmarYAprobarPendienteCalidadCore(BrecepenPendienteCalidadDTO row)
    {
        // Validar tolerancia de días para aprobar recepción
        if (row.NumeroRecepcion.HasValue && row.NumeroRecepcion.Value > 0)
        {
            var validacionResponse = await repository.Get<ValidacionToleranciaDTO>($"api/bolrecep/validar-tolerancia-aprobacion/{row.NumeroRecepcion.Value}");
            if (!validacionResponse.Error && validacionResponse.Response != null)
            {
                if (!validacionResponse.Response.PuedeAprobar)
                {
                    await sweetAlertService.FireAsync("Atención", validacionResponse.Response.Mensaje, SweetAlertIcon.Warning);
                    return;
                }
            }
        }

        // Recuperamos la cantidad que el usuario cargó para esta fila (clave LOTE|COD_INTE).
        var key = GetPendienteCalidadKey(row);
        if (!cantidadAprobarPorFila.TryGetValue(key, out var cantidad))
        {
            await sweetAlertService.FireAsync("Error", "No se encontró la cantidad a aprobar", SweetAlertIcon.Error);
            return;
        }

        // No permitimos aprobar cantidades cero o negativas.
        if (cantidad <= 0)
        {
            await sweetAlertService.FireAsync("Atención", "La cantidad a aprobar debe ser mayor a 0", SweetAlertIcon.Warning);
            return;
        }

        // Ni más de lo que realmente está pendiente para esa fila.
        if (cantidad > row.CantidadPendiente)
        {
            await sweetAlertService.FireAsync("Atención", $"La cantidad a aprobar no puede superar el pendiente ({row.CantidadPendiente})", SweetAlertIcon.Warning);
            return;
        }

        // Armamos el request identificando el grupo por LOTE + producto y la cantidad a aprobar.
        var request = new BrecepenAprobarRequestDTO
        {
            Idenlote = row.Idenlote,   // Lote de la recepción (clave principal del grupo)
            Doprilar = row.Doprilar,   // Documento (informativo; el backend copia datos del original)
            CodInte = row.CodInte,     // Producto (código interno)
            CantidadAprobar = cantidad // Cantidad que se aprueba en esta operación
        };

        // Llamamos al backend: genera el registro de aprobación 'AP' y ajusta stock/OC.
        var response = await repository.Post("api/brecepen/aprobar", request);
        if (response.Error)
        {
            var mensaje = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
            return;
        }

        await sweetAlertService.FireAsync("OK", "Aprobado", SweetAlertIcon.Success);
        await CargarPendientesCalidad();
    }

    // ── CÓDIGO NO UTILIZADO (se mantiene activo, no eliminar) ──────────────
    // Este bloque implementaba un flujo de aprobación CON confirmación previa
    // (SweetAlert con opciones "Aprobar / Cambiar Depósito / Cancelar") para la
    // solapa "Aprueba Almacén". Hoy NO se ejecuta: el botón "Aprobar" de la
    // grilla llama directamente a ConfirmarYAprobarPendienteCalidad(), que
    // postea sin confirmación intermedia, y filaAprobacionActual nunca se
    // asigna (permanece en null, por lo que MostrarConfirmacionAprobacionCalidad
    // y EjecutarAprobacionPendienteCalidad retornan sin hacer nada).
    // Se deja el código porque el flujo con confirmación podría reactivarse
    // más adelante; si se decide reactivarlo, hay que asignar
    // filaAprobacionActual / cantidadAprobacionActual y llamar a
    // MostrarConfirmacionAprobacionCalidad() desde ConfirmarYAprobarPendienteCalidad().
    // ─────────────────────────────────────────────────────────────────────

    // Contexto de la aprobación en curso en la solapa "Aprueba Calidad" (se usa mientras
    // el usuario confirma o cambia el depósito de ingreso, antes de llamar al backend).
    private BrecepenPendienteCalidadDTO? filaAprobacionActual;
    private decimal cantidadAprobacionActual;
    private int depositoIngresoAprobacion;
    private string nombreDepositoIngresoAprobacion = string.Empty;

    // Muestra el mensaje de confirmación con los datos de la aprobación y el depósito de
    // ingreso actual, dando la opción de aprobar, cambiar el depósito o cancelar.
    private async Task MostrarConfirmacionAprobacionCalidad()
    {
        if (filaAprobacionActual == null)
        {
            return;
        }

        var row = filaAprobacionActual;
        var mensaje = $"Recepción: {row.Doprilar}\n" +
                      $"Código: {row.Codigo}\n" +
                      $"Descripción: {row.Descripcion}\n" +
                      $"Cantidad a Aprobar: {cantidadAprobacionActual}\n" +
                      $"Depósito de Ingreso: {depositoIngresoAprobacion} - {nombreDepositoIngresoAprobacion}\n\n" +
                      "Seleccione una opción:";

        var confirmacion = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar Aprobación",
            Html = mensaje.Replace("\n", "<br>"),
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ShowDenyButton = true,
            ConfirmButtonText = "✓ Aprobar",
            DenyButtonText = "🔄 Cambiar Depósito",
            CancelButtonText = "✖ Cancelar",
            ConfirmButtonColor = "#28a745",
            DenyButtonColor = "#ffc107",
            CancelButtonColor = "#6c757d"
        });

        if (confirmacion.IsConfirmed)
        {
            await EjecutarAprobacionPendienteCalidad();
        }
        else if (confirmacion.IsDenied)
        {
            await CambiarDepositoIngresoAprobacion();
        }
        // Si se cancela, no hacemos nada y se descarta el contexto en curso.
    }

    // Abre el buscador de depósitos existente (el mismo que se usa para el depósito de rechazo)
    // para permitir cambiar el depósito de ingreso antes de confirmar la aprobación.
    private async Task CambiarDepositoIngresoAprobacion()
    {
        var parameters = new ModalParameters()
            .Add(nameof(SeleccionarDepositoDialog.CodigoSeleccionado), depositoIngresoAprobacion);

        var modal = modalService.Show<SeleccionarDepositoDialog>("Seleccionar Depósito de Ingreso", parameters);
        var result = await modal.Result;

        if (!result.Cancelled && result.Data != null)
        {
            var deposito = (DepositoDTO)result.Data;
            depositoIngresoAprobacion = deposito.Id;
            nombreDepositoIngresoAprobacion = deposito.Nombre;
        }

        // Volvemos a mostrar la confirmación, con el depósito nuevo (o el mismo si se canceló el buscador).
        await MostrarConfirmacionAprobacionCalidad();
    }

    // Ejecuta la aprobación contra el backend y, si sale bien, prepara e imprime el Vale Interno
    // (mismo formato utilizado al aprobar una Orden de Fabricación).
    private async Task EjecutarAprobacionPendienteCalidad()
    {
        if (filaAprobacionActual == null)
        {
            return;
        }

        var row = filaAprobacionActual;

        // Armamos el request identificando el grupo por LOTE + producto y la cantidad a aprobar.
        var request = new BrecepenAprobarRequestDTO
        {
            Idenlote = row.Idenlote,   // Lote de la recepción (clave principal del grupo)
            Doprilar = row.Doprilar,   // Documento (informativo; el backend copia datos del original)
            CodInte = row.CodInte,     // Producto (código interno)
            CantidadAprobar = cantidadAprobacionActual, // Cantidad que se aprueba en esta operación
            DepositoIngreso = depositoIngresoAprobacion > 0 ? depositoIngresoAprobacion : null
        };

        // Llamamos al backend: genera el registro de aprobación 'AP' y ajusta stock/OC.
        var response = await repository.Post("api/brecepen/aprobar", request);
        if (response.Error)
        {
            var mensaje = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
            return;
        }

        // Preparamos los datos del Vale Interno para la vista previa/impresión.
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        nombreUsuarioActualVale = authState.User.Identity?.Name ?? "Usuario";
        origenVale = row.Doprilar ?? row.Idenlote ?? "";
        codigoVale = row.Codigo ?? "";
        descripcionVale = row.Descripcion ?? "";
        cantidadVale = cantidadAprobacionActual;
        observacionesVale = string.Empty;
        mostrarModalVistaPreviaVale = true;

        await CargarPendientesCalidad();
    }

