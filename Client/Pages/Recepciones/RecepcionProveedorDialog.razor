    private void OnProveedorSeleccionadoOrdenes(SelectorProveedores.ProveedorSeleccionado proveedor)
    {
        proveedorFiltroOrdenes = $"{proveedor.NumeCli} - {proveedor.RazonSocial}";
        numeroProveedorFiltroOrdenes = proveedor.NumeCli;
