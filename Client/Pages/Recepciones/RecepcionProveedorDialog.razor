            Text = "¿Está seguro que desea aprobar esta recepción?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, aprobar",
            CancelButtonText = "No"
        });

        if (!confirmacion.IsConfirmed) return;

        var responseHttp = await repository.Put($"api/bolrecep/aprobar/{numeroRecepcion}", recepcionesPendientes);
        if (responseHttp.Error)
        {
            var mensaje = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
            return;
        }

        await sweetAlertService.FireAsync("Éxito", "Recepción aprobada correctamente", SweetAlertIcon.Success);
        await CargarRecepcionesPendientes();
    }

