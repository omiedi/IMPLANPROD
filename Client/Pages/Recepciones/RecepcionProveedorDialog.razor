                </div>
            </div>
            <div style="font-size: 14px; font-weight: bold; margin-top: 5px;">
                Depósito: @nombreDepositoCalidad
            </div>
        </div>

        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead>
                <tr style="background-color: #212529; color: white; font-weight: bold;">
                    <th style="border: 1px solid #000; padding: 8px; text-align: left;">Código</th>
                    <th style="border: 1px solid #000; padding: 8px; text-align: left;">Descripción</th>
                    <th style="border: 1px solid #000; padding: 8px; text-align: right;">Cantidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in itemsVale)
                {
                    <tr>
                        <td style="border: 1px solid #000; padding: 8px;">@item.CodigoExterno</td>
                        <td style="border: 1px solid #000; padding: 8px;">@item.DescripcionItem</td>
                        <td style="border: 1px solid #000; padding: 8px; text-align: right;">@FormatDecimalVale(item.CanToApro ?? 0)</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!string.IsNullOrWhiteSpace(observacionesVale))
        {
            <div style="margin-top: 20px;">
                <strong>Observaciones:</strong>
                <div style="white-space: pre-wrap; margin-top: 10px;">@observacionesVale</div>
            </div>
        }

        <div style="margin-top: 30px; text-align: right;">
            <strong>Cerró: @nombreUsuarioActualVale</strong>
        </div>
    </div>
</div>

