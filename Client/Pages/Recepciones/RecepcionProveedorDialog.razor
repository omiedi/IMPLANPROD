    {
        mostrarModalOrdenesPendientes = false;
        ordenesPendientes = null;
        proveedorFiltroOrdenes = string.Empty;
        numeroProveedorFiltroOrdenes = null;
    }

    private async Task CargarOrdenesPendientes()
    {
        cargandoOrdenesPendientes = true;
        StateHasChanged();
        
        try
        {
            // Validar que haya un proveedor seleccionado
            if (!numeroProveedorFiltroOrdenes.HasValue || numeroProveedorFiltroOrdenes <= 0)
            {
                ordenesPendientes = new List<Ocomenca>();
                return;
            }

            // Usar endpoint optimizado que devuelve directamente los encabezados
            var url = $"api/ocomenca/pendientes-recepcion/{numeroProveedorFiltroOrdenes}";
            var responseHttp = await repository.Get<List<Ocomenca>>(url);
            
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar órdenes pendientes: {message}", SweetAlertIcon.Error);
                ordenesPendientes = new List<Ocomenca>();
                return;
            }

            ordenesPendientes = responseHttp.Response ?? new List<Ocomenca>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar órdenes pendientes: {ex.Message}");
            await sweetAlertService.FireAsync("Error", "Error al cargar órdenes pendientes", SweetAlertIcon.Error);
            ordenesPendientes = new List<Ocomenca>();
        }
        finally
        {
            cargandoOrdenesPendientes = false;
            StateHasChanged();
        }
    }

