    private async Task RecepcionLibreCore()
    {
        try
        {
            var recepcionLibre = new RecepcionLibreDTO
            {
                NumeroProveedor = proveedorSeleccionado.NumeCli ?? proveedorSeleccionado.Id,
                RazonSocialProveedor = proveedorSeleccionado.RazonSocial
            };

            var parameters = new ModalParameters()
                .Add(nameof(RecepcionLibreDialog.RecepcionLibre), recepcionLibre)
                .Add(nameof(RecepcionLibreDialog.Items), new List<RecepcionLibreDTO>());

            var modal = modalService.Show<RecepcionLibreDialog>("Recepción Libre", parameters);
            var result = await modal.Result;

            if (!result.Cancelled)
            {
                var items = (List<RecepcionLibreDTO>)result.Data;
                var response = await repository.Post<List<RecepcionLibreDTO>, List<BolrecepResponseDTO>>("api/BolRecep/recibir-libre", items);

                if (response.Error)
                {
                    var mensajeError = await response.GetErrorMessageAsync();
                    await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
                    return;
                }

                await sweetAlertService.FireAsync("Éxito", "Recepción registrada correctamente", SweetAlertIcon.Success);

                // Mostrar vista previa de la recepción recién generada
                var numeroBoleta = response.Response?.FirstOrDefault()?.Numebore ?? 0;
                if (numeroBoleta > 0)
                {
                    await CambiarAPendientes();
                    await ImprimirRecepcionPendienteAsync(numeroBoleta);
                }
                else
                {
                    await CambiarAPendientes();
