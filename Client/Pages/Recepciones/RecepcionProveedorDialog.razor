@* Modal de Items de Recepción *@
<div class="modal fade @(mostrarModalItems ? "show" : "")" style="display: @(mostrarModalItems ? "block" : "none")" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Items de Recepción #@numeroRecepcionSeleccionada</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalItems"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold">Depósito de Ingreso:</span>
                        <span class="badge bg-info text-dark fs-6">@nombreDepositoCalidad</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="SeleccionarDepositoCalidad" disabled="@(procesandoCambioDeposito || procesandoAprobacionRecepcion)">
                            @if (procesandoCambioDeposito)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="oi oi-pencil me-1"></i><text>Cambiar</text>
                            }
                        </button>
                    </div>
                    @if (numeroRecepcionSeleccionada == 0)
                    {
                        <button type="button" class="btn btn-success" @onclick="AgregarMasRepuestos" disabled="@(procesandoAgregarRepuesto || procesandoAprobacionRecepcion)">
                            @if (procesandoAgregarRepuesto)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <text>Agregando...</text>
                            }
                            else
                            {
                                <i class="oi oi-plus"></i>
                                <text> Agregar Repuesto</text>
                            }
                        </button>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr class="bg-light">
                                <th>Código Interno</th>
                                <th>Código Externo</th>
                                <th>Descripción</th>
                                <th class="text-center">Cant. Nominal</th>
                                <th>Unidad</th>
                                <th class="text-center">Cant. Aprobada</th>
                                <th class="text-center">Cant. Rechazada</th>
                                <th class="text-center">Cant. Faltante</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (itemsRecepcion != null)
                            {
                                @foreach (var item in itemsRecepcion)
                                {
                                    var diferencia = item.CantidadNominal - (item.CanToApro ?? 0) - (item.CantidadRechazada ?? 0) - (item.CantidadFaltante ?? 0);
                                    var esValido = Math.Abs(diferencia) < 0.0001m; // Tolerancia para decimales
                                    
                                    <tr class="@(esValido ? "" : "table-warning")">
                                        <td>@item.CodigoInterno</td>
                                        <td>@item.CodigoExterno</td>
                                        <td>@item.DescripcionItem</td>
                                        <td class="text-center"><strong>@item.CantidadNominal</strong></td>
                                        <td>@item.Unidad</td>
                                        <td>
                                            <input type="number" 
                                                   class="form-control form-control-sm no-spinner" 
                                                   @bind-value="item.CanToApro"
                                                   @bind-value:event="oninput"
                                                   @onchange="() => ValidarCantidades(item)"
                                                   step="0.01"
                                                   min="0" />
                                        </td>
                                        <td>
                                            <input type="number" 
                                                   class="form-control form-control-sm no-spinner" 
                                                   @bind-value="item.CantidadRechazada"
                                                   @bind-value:event="oninput"
                                                   @onchange="() => ValidarCantidades(item)"
                                                   step="0.01"
                                                   min="0" />
                                        </td>
                                        <td>
                                            <input type="number" 
                                                   class="form-control form-control-sm no-spinner" 
                                                   @bind-value="item.CantidadFaltante"
                                                   @bind-value:event="oninput"
                                                   @onchange="() => ValidarCantidades(item)"
                                                   step="0.01"
                                                   min="0" />
                                        </td>
                                        <td class="text-center">
                                            @if (esValido)
                                            {
                                                <span class="badge bg-success">✓ OK</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark" title="La suma debe ser igual a la cantidad nominal">
                                                    ⚠ Diferencia: @diferencia.ToString("0.##")
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                @if (numeroRecepcionSeleccionada == 0)
                {
                    <button type="button" class="btn btn-success" @onclick="AgregarMasRepuestos" disabled="@(procesandoAgregarRepuesto || procesandoAprobacionRecepcion)">
                        @if (procesandoAgregarRepuesto)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <text>Agregando...</text>
                        }
                        else
                        {
                            <i class="oi oi-plus"></i>
                            <text> Agregar Repuesto</text>
                        }
                    </button>
                }
                <button type="button" class="btn btn-secondary" @onclick="CerrarModalItems" disabled="@procesandoAprobacionRecepcion">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="AprobarRecepcionPendiente" disabled="@procesandoAprobacionRecepcion">
                    @if (procesandoAprobacionRecepcion)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <text>Procesando...</text>
                    }
                    else
                    {
                        <text>Aprobar Recepción</text>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@if (mostrarModalItems)
{
    <div class="modal-backdrop fade show"></div>
}

@* Modal de Órdenes de Compra Pendientes *@
<div class="modal fade @(mostrarModalOrdenesPendientes ? "show" : "")" style="display: @(mostrarModalOrdenesPendientes ? "block" : "none")" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-shopping-cart me-2"></i>
                    Órdenes de Compra Pendientes
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalOrdenesPendientes"></button>
            </div>
            <div class="modal-body">
                <!-- Encabezado con logo para impresión -->
                <div class="text-center mb-3 reporte-header">
                    <img src="/images/logoempresa.png" alt="Logo Empresa" style="max-height: 60px; margin-bottom: 10px;" />
                    <h5 class="mb-1">Reporte de Órdenes de Compra Pendientes</h5>
                    @if (!string.IsNullOrEmpty(proveedorFiltroOrdenes))
                    {
                        <p class="mb-1"><strong>Proveedor:</strong> @proveedorFiltroOrdenes</p>
                    }
                    <p class="text-muted small mb-3">Fecha: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <!-- Filtro por proveedor -->
                <div class="row mb-3 no-print">
                    <div class="col-md-4">
                        <label class="form-label"><strong class="text-danger">*</strong> Seleccionar Proveedor:</label>
                        <div class="input-group">
                            <input type="text" class="form-control" @bind="proveedorFiltroOrdenes" readonly placeholder="Debe seleccionar un proveedor..." />
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltroProveedorOrdenes" disabled="@(string.IsNullOrEmpty(proveedorFiltroOrdenes))">
                                <i class="fas fa-times"></i>
                            </button>
                            <button class="btn btn-outline-primary" @onclick="AbrirSelectorProveedorOrdenes" title="Seleccionar Proveedor">
                                <i class="fas fa-truck"></i>
                            </button>
                        </div>
                        <small class="text-muted">Seleccione un proveedor para ver sus órdenes pendientes</small>
                    </div>
                    <div class="col-md-8 d-flex align-items-end justify-content-end gap-2">
                        <button class="btn btn-primary" @onclick="FiltrarOrdenesPendientes" disabled="@(!numeroProveedorFiltroOrdenes.HasValue || cargandoOrdenesPendientes)">
                            @if (cargandoOrdenesPendientes)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <text>Buscando...</text>
                            }
                            else
                            {
                                <i class="fas fa-filter"></i>
                                <text> Buscar Órdenes</text>
                            }
                        </button>
                        <button class="btn btn-success" @onclick="ImprimirReporteOrdenesPendientes" disabled="@(ordenesPendientes == null || !ordenesPendientes.Any() || procesandoImpresionReporte)">
                            @if (procesandoImpresionReporte)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="fas fa-print"></i>
                            }
                            Imprimir Reporte
                        </button>
                    </div>
                </div>

                <!-- Tabla de órdenes pendientes -->
                @if (!numeroProveedorFiltroOrdenes.HasValue)
                {
                    <div class="alert alert-warning text-center">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Seleccione un proveedor</strong>
                        <p class="mb-0 mt-2">Debe seleccionar un proveedor para visualizar sus órdenes de compra pendientes.</p>
                    </div>
                }
                else if (cargandoOrdenesPendientes)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-2 text-muted">Buscando órdenes pendientes...</p>
                    </div>
                }
                else if (ordenesPendientes == null)
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-search me-2"></i>
                        <strong>Proveedor seleccionado</strong>
                        <p class="mb-0 mt-2">Haga clic en "Buscar Órdenes" para ver las órdenes pendientes de este proveedor.</p>
                    </div>
                }
                else if (!ordenesPendientes.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> No se encontraron órdenes de compra pendientes.
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-sm table-hover">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th>N° Orden</th>
                                    <th>Fecha Emisión</th>
                                    <th>Proveedor</th>
                                    <th>Razón Social</th>
                                    <th>Referencia</th>
                                    <th>Total</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var orden in ordenesPendientes)
                                {
                                    <tr>
                                        <td><strong>@orden.NumeOcom</strong></td>
                                        <td>@orden.FemiOcom?.ToString("dd/MM/yyyy")</td>
                                        <td>@orden.NproOcom</td>
                                        <td>@orden.RaSoProv</td>
                                        <td>@orden.RefeOcom</td>
                                        <td>@orden.TotalOcom?.ToString("C2")</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <button class="btn btn-sm btn-outline-info" @onclick="(() => VerDetalleOrden(orden.OCOMENCA_ID))" title="Ver Detalle">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-success" @onclick="(() => ImprimirOrdenPendiente(orden.NumeOcom ?? 0))" title="Imprimir" disabled="@(procesandoImpresionOrden != null)">
                                                    @if (procesandoImpresionOrden == orden.NumeOcom)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-print"></i>
                                                    }
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModalOrdenesPendientes">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@if (mostrarModalOrdenesPendientes)
{
    <div class="modal-backdrop fade show"></div>
}

