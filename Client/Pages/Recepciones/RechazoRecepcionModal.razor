@inject IRepository repository
@inject SweetAlertService sweetAlertService

<style>
    .blazored-modal-container {
        z-index: 2000 !important;
    }
    
    .blazored-modal {
        z-index: 2001 !important;
    }
</style>

<div class="modal-header bg-warning text-dark">
    <h4 class="modal-title">
        <i class="fas fa-exclamation-triangle"></i> Información de Rechazo
    </h4>
</div>

<div class="modal-body">
    <div class="alert alert-warning mb-3">
        <h6 class="mb-2"><strong>Producto:</strong></h6>
        <div class="mb-1">@Item.DescripcionItem</div>
        <div class="mt-2">
            <span class="badge bg-danger fs-6">
                <i class="fas fa-times-circle"></i> Cantidad Rechazada: @Item.CantidadRechazada @Item.Unidad
            </span>
        </div>
    </div>

<EditForm Model="Item" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Destino del Rechazo: <span class="text-danger">*</span></label>
        <InputSelect class="form-control" @bind-Value="Item.DestinoRechazo">
            <option value="">-- Seleccione un destino --</option>
            @if (destinos != null)
            {
                @foreach (var destino in destinos)
                {
                    <option value="@destino.Key">@destino.Value</option>
                }
            }
        </InputSelect>
        @if (Item.DestinoRechazo == null || Item.DestinoRechazo == 0)
        {
            <div class="text-danger small">El destino es obligatorio</div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label">Motivo del Rechazo: <span class="text-danger">*</span></label>
        <InputSelect class="form-control" @bind-Value="Item.MotivoRechazo">
            <option value="">-- Seleccione un motivo --</option>
            @if (motivos != null)
            {
                @foreach (var motivo in motivos)
                {
                    <option value="@motivo.Key">@motivo.Value</option>
                }
            }
        </InputSelect>
        @if (Item.MotivoRechazo == null || Item.MotivoRechazo == 0)
        {
            <div class="text-danger small">El motivo es obligatorio</div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label">Observaciones:</label>
        <InputTextArea class="form-control" @bind-Value="Item.ObservacionesRechazo" rows="3" 
                       placeholder="Ingrese observaciones adicionales sobre el rechazo..." />
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-secondary" @onclick="Cancel">
            <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="submit" class="btn btn-success" disabled="@(!IsValid())">
            <i class="fas fa-check"></i> Guardar
        </button>
    </div>
</EditForm>
</div>

@code {
    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = default!;

    [Parameter]
    public RecepcionItemDTO Item { get; set; } = null!;

    private Dictionary<int, string>? destinos;
    private Dictionary<int, string>? motivos;

    protected override async Task OnInitializedAsync()
    {
        await CargarDestinos();
        await CargarMotivos();
    }

    private async Task CargarDestinos()
    {
        var response = await repository.Get<Dictionary<int, string>>("api/destinorechazorecepcion/combo");
        if (response.Error)
        {
            await sweetAlertService.FireAsync("Error", "No se pudieron cargar los destinos de rechazo", SweetAlertIcon.Error);
            return;
        }
        destinos = response.Response;
    }

    private async Task CargarMotivos()
    {
        var response = await repository.Get<Dictionary<int, string>>("api/motivosrechazorecepcion/combo");
        if (response.Error)
        {
            await sweetAlertService.FireAsync("Error", "No se pudieron cargar los motivos de rechazo", SweetAlertIcon.Error);
            return;
        }
        motivos = response.Response;
    }

    private bool IsValid()
    {
        return Item.DestinoRechazo.HasValue && Item.DestinoRechazo > 0 &&
               Item.MotivoRechazo.HasValue && Item.MotivoRechazo > 0;
    }

    private async Task HandleValidSubmit()
    {
        if (!IsValid())
        {
            await sweetAlertService.FireAsync("Validación", "Debe seleccionar un destino y un motivo de rechazo", SweetAlertIcon.Warning);
            return;
        }

        await BlazoredModal.CloseAsync(ModalResult.Ok(Item));
    }

    private async Task Cancel()
    {
        await BlazoredModal.CloseAsync(ModalResult.Cancel());
    }
}
