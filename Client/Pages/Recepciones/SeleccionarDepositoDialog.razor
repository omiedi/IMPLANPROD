@using IMPLANPROD.Shared.DTOs
@inject IRepository repository
@inject SweetAlertService sweetAlertService

<div class="container">
    <div class="row">
        <div class="col">
            <div class="form-group">
                <input type="text" 
                       class="form-control" 
                       @bind-value="terminoBusqueda" 
                       @bind-value:event="oninput"
                       placeholder="Buscar depósito..." />
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col">
            @if (cargando)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando depósitos...</span>
                    </div>
                </div>
            }
            else if (DepositosFiltrados.Any())
            {
                <div style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-hover">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deposito in DepositosFiltrados)
                            {
                                <tr class="@(deposito.Id == CodigoSeleccionado ? "table-primary" : "")">
                                    <td>@deposito.Id</td>
                                    <td>@deposito.Nombre</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" @onclick="() => SeleccionarDeposito(deposito)">
                                            Seleccionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">No se encontraron depósitos.</div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance Modal { get; set; }
    [Parameter] public int CodigoSeleccionado { get; set; }

    private List<DepositoDTO> depositos = new();
    private string terminoBusqueda = string.Empty;
    private bool cargando = false;

    private IEnumerable<DepositoDTO> DepositosFiltrados =>
        string.IsNullOrWhiteSpace(terminoBusqueda)
            ? depositos
            : depositos.Where(d =>
                (d.Nombre ?? string.Empty).Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                d.Id.ToString().Contains(terminoBusqueda));

    protected override async Task OnInitializedAsync()
    {
        await CargarDepositos();
    }

    // Carga los depósitos desde el endpoint correcto (api/tadeposi/combo), que devuelve
    // un diccionario CodigoDepo -> "Codigo - Descripción". Antes se llamaba a "api/tadepo",
    // una ruta que no existe en el backend, por lo que la lista nunca se cargaba.
    private async Task CargarDepositos()
    {
        try
        {
            cargando = true;
            var response = await repository.Get<Dictionary<int, string>>("api/tadeposi/combo");
            if (response.Error || response.Response == null)
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar los depósitos", SweetAlertIcon.Error);
                depositos = new();
                return;
            }

            depositos = response.Response
                .OrderBy(x => x.Value)
                .Select(x => new DepositoDTO { Id = x.Key, Nombre = x.Value })
                .ToList();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task SeleccionarDeposito(DepositoDTO deposito)
    {
        await Modal.CloseAsync(ModalResult.Ok(deposito));
    }
}
