    private async Task MostrarStockPorDeposito(ProductoConSaldoDTO repuesto)
    {
        try
        {
            repuestoSeleccionado = repuesto;

            // Primero obtenemos la lista de todos los depósitos
            var responseDepositos = await repository.Get<List<int>>("api/tadeposi/SoloCodigos");
            if (responseDepositos.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar los depósitos", SweetAlertIcon.Error);
                return;
            }

            // Luego obtenemos el stock por depósito

            int codint = 0;

            codint = repuesto.Cod_inte;

            // Obtenemos el stock por depósito para el producto seleccionado
            var responseStock = await repository.Get<List<StockDepositoDTO>>($"api/movisto/stock/{codint}");
            if (responseStock.Error)
            {
                await sweetAlertService.FireAsync("Error", responseStock.HttpResponseMessage.ReasonPhrase, SweetAlertIcon.Error);
                return;
            }

            // Obtenemos la información de todos los depósitos (incluida la descripción)
            // El endpoint devuelve un diccionario donde la clave es el código del depósito y el valor es la descripción
            var responseDepositosInfo = await repository.Get<Dictionary<int, string>>("api/tadeposi/combo");
            if (responseDepositosInfo.Error)
            {
                await sweetAlertService.FireAsync("Error", responseDepositosInfo.HttpResponseMessage.ReasonPhrase, SweetAlertIcon.Error);
                return;
            }

            // Creamos una lista con todos los depósitos, tengan o no stock
            // Incluimos la descripción del depósito y ordenamos por cantidad de stock descendente
            stocksPorDeposito = responseDepositos.Response.Select(deposito =>
            {
                // Buscamos si existe stock para este depósito
                var stockExistente = responseStock.Response?.FirstOrDefault(s => s.Deposito == deposito);

                // Obtenemos la descripción directamente del diccionario usando el código del depósito como clave
                string descripcion = "Sin descripción";
                if (responseDepositosInfo.Response != null && responseDepositosInfo.Response.TryGetValue(deposito, out string desc))
                {
                    descripcion = desc;
                }

                return new StockDepositoDTO
            {
                Deposito = deposito,
                Stock = stockExistente?.Stock ?? 0,
                Descripcion = descripcion // Asignamos la descripción obtenida del diccionario
            };
            })
            .OrderByDescending(s => s.Stock) // Ordenamos por cantidad de stock de manera descendente
            .ToList();

            // // Agregamos un log para verificar que las descripciones se están obteniendo correctamente
            // Console.WriteLine($"Se cargaron {stocksPorDeposito.Count} depósitos con sus descripciones");
            // foreach (var stock in stocksPorDeposito.Take(3)) // Mostramos los primeros 3 como ejemplo
            // {
            //     Console.WriteLine($"Depósito: {stock.Deposito}, Descripción: {stock.Descripcion}, Stock: {stock.Stock}");
            // }

            mostrarDetalleDeposito = true;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", "No se pudo cargar el stock por depósito", SweetAlertIcon.Error);
        }
    }
    private async Task GuardarAjuste()
    {
        // await CargarRepuestos();
        await LoadAsync();
        await MostrarStockPorDeposito(repuestoSeleccionado);
        CerrarModalAjuste();
    }

    private void AbrirTransferencias(ProductoConSaldoDTO repuesto)
    {
        repuestoSeleccionado = repuesto;
        mostrarModalTransferencia = true;
    }
    private void AbrirTransferencias()
    {
        mostrarModalTransferencia = false;
    }
    private void CerrarDetalleDeposito()
    {
        mostrarDetalleDeposito = false;
        repuestoSeleccionado = null;
        stocksPorDeposito = null;
    }
    private void CerrarModalTransferencia()
    {
        mostrarModalTransferencia = false;
    }
    private async Task GuardarTransferencia()
    {
        CerrarModalTransferencia();
    }
    private void AbrirHistorico(ProductoConSaldoDTO repuesto)
    {
        repuestoSeleccionado = repuesto;
        mostrarModalHistorico = true;
    }

    private void CerrarHistorico()
    {
        mostrarModalHistorico = false;
    }

    private void AbrirModalAjuste(StockDepositoDTO stockDeposito)
    {
        stockDepositoSeleccionado = stockDeposito;
        mostrarModalAjuste = true;
    }

    private void CerrarModalAjuste()
    {
        mostrarModalAjuste = false;
        stockDepositoSeleccionado = null;
    }


    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }
    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilterAsync();
        }
    }
}
