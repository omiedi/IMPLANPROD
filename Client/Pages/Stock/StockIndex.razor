@page "/Stock-index"
@attribute [Authorize]
@using IMPLANPROD.Shared.Services
@using IMPLANPROD.Shared.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using IMPLANPROD.Client.Pages.StockAjustes
@using IMPLANPROD.Shared.DTOs
@inject IRepository repository
@inject NavigationManager NavigationManager
@inject SweetAlertService sweetAlertService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http

<PageTitle>Stocks</PageTitle>

<div class="container-fluid">
    <!-- Título de la página -->
    <div class="mb-4">
        <h2 class="text-center fw-bold text-primary">
            <i class="fas fa-boxes me-2"></i>
            STOCK DE PRODUCTOS
        </h2>
        <hr class="border-primary border-2 opacity-50" />
    </div>

<div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-3 d-flex justify-content-end align-items-center">
    <div class="dropdown">
        <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
            Informes
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <NavLink class="dropdown-item" href="/stock/consultaStockComponentes">
                    Consulta de Stocks de Componentes
                </NavLink>
            </li>
            @* <li>
                <NavLink class="dropdown-item" href="/ajuste-stock">
                    Ajuste de Stock
                </NavLink>
            </li> *@
            @* <li>
                <NavLink class="dropdown-item" href="/movimientos-stock">
                    Movimientos Históricos
                </NavLink>
            </li> *@
        </ul>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <input type="text" class="form-control" style="min-width: 10cm; width: 10cm;" placeholder="Buscar x código y/o descrip..." @bind-value="Filter" @onkeyup="HandleKeyPress" />
        <button type="button" class="btn btn-outline-primary" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>
</div>

<Pagination CurrentPage="currentPage"
TotalPages="totalPages"
SelectedPage="SelectedPageAsync" />

@if (isLoading)
{
    <div class="spinner-border text-primary" role="status">
        <span class="sr-only">Cargando...</span>
    </div>
}
else
{
    @if (Productos.Count == 0 && !string.IsNullOrEmpty(Filter))
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i> No se encontraron coincidencias para el filtro "@Filter".
        </div>
    }
    <GenericList MyList="Productos">
        <Body>
            <table class="table table-striped">
                <thead>            <tr>
                        <th>Cód.Interno</th>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th class="text-end">Saldo</th>
                        <th>U.Med.</th>
                        <th>X Depósito</th>
                        <th>Transferenrir</th>
                        <th>Mov.Históricos</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Productos.Count > 0)
                    {
                        @foreach (var item in Productos)
                        {
                            <tr>
                                <td>@item.Cod_inte</td>
                                <td>@item.Codigo</td>
                                <td>@item.Descripcion</td>
                                <td class="text-end">@item.Saldo.ToString("N2")</td>
                                <td>@item.UnidadMedida</td>
                                <td>
                                    <button class="btn btn-warning" @onclick="() => MostrarStockPorDeposito(item)">
                                        <i class="oi oi-eye"></i> X Depósito + Ajustes
                                    </button>
                                </td>
                                <td>
                                    <button class="btn btn-info" @onclick="() => AbrirTransferencias(item)">
                                        <i class="oi oi-transfer"></i> Transferencias
                                    </button>
                                </td>
                                <td>
                                    <button class="btn btn-secondary" @onclick="() => AbrirHistorico(item)">
                                        <i class="oi oi-clock"></i> Histórico
                                    </button>


                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3">No hay productos con saldo.</td></tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>
}
@if (mostrarDetalleDeposito)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">Stock por Depósito - @repuestoSeleccionado?.Codigo</h5>
                    <button type="button" class="btn-close" @onclick="CerrarDetalleDeposito"></button>
                </div>
                <div class="modal-body">
                    @if (stocksPorDeposito == null)
                    {
                        <div class="spinner-border text-primary" role="status">
                            <span class="sr-only">Cargando...</span>
                        </div>
                    }
                    else if (!stocksPorDeposito.Any())
                    {
                        <div class="alert alert-info">
                            No hay stock registrado en ningún depósito.
                        </div>
                    }
                    else
                    {
                        <div id="tablaScroll" class="table-container" style="max-height: 15cm; overflow-y: auto;">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Depósito</th>
                                            <th>Descripción</th>
                                            <th class="text-end">Stock</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var stock in stocksPorDeposito)
                                        {
                                            <tr>
                                                <td>@stock.Deposito</td>
                                                <td>@stock.Descripcion</td>
                                                <td class="text-end">@stock.Stock.ToString("N2")</td>
                                                <td class="text-end">
                                                   @*  <button class="btn btn-primary btn-sm" @onclick="() => AbrirModalAjuste(stock)">
                                                        <i class="oi oi-pencil"></i> Ajustar
                                                    </button *@>
                                                    <button class="btn btn-primary btn-sm" @onclick="async () => await PrepararAjuste(stock)">
                                                        <i class="oi oi-pencil"></i> Ajustar
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarDetalleDeposito">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>

}
@if (mostrarModalAjuste && repuestoSeleccionado != null && stockDepositoSeleccionado != null)
{
    @if (NivelTrazable == 1)
    {
        <StockAjustesTrazablesFormModal
            Repuesto="repuestoSeleccionado"
            StockDeposito="stockDepositoSeleccionado"
            Visible="true"
            OnClose="CerrarModalAjuste"
            OnSave="GuardarAjuste" />
    }
    else
    {
        <StockAjustesFormModal
            Repuesto="repuestoSeleccionado"
            StockDeposito="stockDepositoSeleccionado"
            Visible="true"
            OnClose="CerrarModalAjuste"
            OnSave="GuardarAjuste" />
    }
}
@if (mostrarModalTransferencia)
{
    <StockTransferenciaModal
    Repuesto="repuestoSeleccionado" 
    Visible="mostrarModalTransferencia"
    OnClose="CerrarModalTransferencia"
    OnSave="GuardarTransferencia" />
}
@if (mostrarModalHistorico)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title">Histórico de Movimientos</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarHistorico"></button>
                </div>
                <div class="modal-body p-0">
                    <HistoricoMovimientosComponent Repuesto="repuestoSeleccionado"
                    ShowInModal="true"
                    HeaderClass="bg-secondary"
                    HeaderStyle="margin: -1px;" />
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
</div>

