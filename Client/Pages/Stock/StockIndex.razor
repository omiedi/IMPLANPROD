    /// <summary>
    /// Carga los productos con saldo paginados desde el backend
    /// </summary>
    private async Task LoadAsync(int page = 1)
    {
        if (isProcessing) return;

        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        try
        {
            isLoading = true;
            isProcessing = true;

            // Construir URLs con parámetros de paginación correctos
            string url1 = $"api/movisto?page={page}&recordsNumber=10";
            string url2 = $"api/movisto/totalPages?page={page}&recordsNumber=10";

            // Agregar filtro si existe
            if (!string.IsNullOrEmpty(Filter))
            {
                url1 += $"&filter={Uri.EscapeDataString(Filter)}";
                url2 += $"&filter={Uri.EscapeDataString(Filter)}";
            }

            var responseHppt = await repository.Get<List<ProductoConSaldoDTO>>(url1);
            var responseHppt2 = await repository.Get<int>(url2);
            
            Productos = responseHppt.Response!;
            totalPages = responseHppt2.Response!;
            currentPage = page;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isProcessing = false;
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task PrepararAjuste(StockDepositoDTO stockDeposito)
    {
        try
        {
            Console.WriteLine($"[PrepararAjuste] Iniciando ajuste para depósito: {stockDeposito.Deposito}");
            Console.WriteLine($"[PrepararAjuste] Repuesto seleccionado: {repuestoSeleccionado?.Codigo ?? "NULL"}");
            
            if (repuestoSeleccionado == null)
            {
                await sweetAlertService.FireAsync("Error", "No hay un producto seleccionado", SweetAlertIcon.Error);
                return;
            }

            stockDepositoSeleccionado = stockDeposito;
            
            Console.WriteLine($"[PrepararAjuste] Leyendo trazabilidad para Cod_inte: {repuestoSeleccionado.Cod_inte}");
            await LeerTrazabilidad(repuestoSeleccionado);

            Console.WriteLine($"[PrepararAjuste] Nivel trazable: {NivelTrazable}");
            Console.WriteLine($"[PrepararAjuste] Abriendo modal de ajuste");
            
            mostrarModalAjuste = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PrepararAjuste] ERROR: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al preparar ajuste: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private async Task LeerTrazabilidad(ProductoConSaldoDTO repuesto)
    {
        var funcionesMaster = await repository.Get<MasterFuncionesDTO>($"api/masterfunciones/funcionesAtributos/{repuesto.Cod_inte}");

        if (funcionesMaster?.Response != null)
        {
            NivelTrazable = funcionesMaster.Response.Trazable;
        }
        else
        {
            NivelTrazable = 0; // Valor por defecto si el producto no tiene datos o hubo error
        }
    }


