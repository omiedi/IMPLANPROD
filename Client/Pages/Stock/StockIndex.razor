<SyncModal MostrarModal="mostrarModalSync" OnCerrar="CerrarModalSync" />

@if (mostrarModalReimpresiones)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 90%;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Re-Impresiones de Transferencias</h5>
                    <button type="button" class="btn-close" @onclick="CerrarReimpresionesTransferencias"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Desde</label>
                            <input type="date" class="form-control" @bind="fechaDesde" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Hasta</label>
                            <input type="date" class="form-control" @bind="fechaHasta" />
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-primary" @onclick="BuscarTransferencias">
                                <i class="fas fa-search"></i> Ver
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-striped table-hover table-sm">
                            <thead class="table-primary sticky-top">
                                <tr>
                                    <th>Nro. Transferencia</th>
                                    <th>Fecha</th>
                                    <th>Producto</th>
                                    <th>Dep. Origen</th>
                                    <th>Dep. Ingreso</th>
                                    <th>Usuario</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (transferencias.Any())
                                {
                                    @foreach (var item in transferencias)
                                    {
                                        <tr>
                                            <td>@item.Numero</td>
                                            <td>@item.Fecha.ToString("dd/MM/yy")</td>
                                            <td>
                                                @if (item.EsMultiple)
                                                {
                                                    <span class="badge bg-info text-dark">Múltiple</span>
                                                }
                                                else
                                                {
                                                    <span>@item.CodigoExterno - @item.Descripcion</span>
                                                }
                                            </td>
                                            <td>@item.DepositoOrigenNombre</td>
                                            <td>@item.DepositoDestinoNombre</td>
                                            <td>@item.UsuarioNombre</td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => ReimprimirTransferencia(item)">
                                                        <i class="fas fa-print"></i> Re-imprimir
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => AnularTransferencia(item)">
                                                        <i class="fas fa-trash"></i> Anular
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">
                                            Seleccione un rango de fechas y presione Ver para buscar transferencias.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarReimpresionesTransferencias">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<ValeTransferenciaModal Vale="valeTransferencia"
                         @bind-Mostrar="mostrarValeTransferencia"
                         OnCerrar="() => mostrarValeTransferencia = false" />
