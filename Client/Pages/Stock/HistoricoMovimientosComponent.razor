@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Pages.Reportes

@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS


<div class="container-fluid">
    <div class="card">
        <div class="card-header @(ShowInModal ? HeaderClass : "")" style="@HeaderStyle">
            <h4 class="@(ShowInModal ? "text-white" : "")">Histórico de Movimientos - @Repuesto?.Codigo</h4>
            <div class="@(ShowInModal ? "text-white-50" : "text-muted") small">Código: @Repuesto?.Cod_inte - @Repuesto?.Codigo</div>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Depósito</label>
                        <select class="form-select" @onchange="DepositoSeleccionado">
                            <option value="">Todos los depósitos</option>
                            @foreach (var deposito in depositos)
                            {
                                <option value="@deposito.Key">@deposito.Value</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Fecha Desde</label>
                        <input type="date" class="form-control" @onchange="FechaDesdeSeleccionada" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Fecha Hasta</label>
                        <input type="date" class="form-control" @onchange="FechaHastaSeleccionada" />
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary" @onclick="Buscar">
                        <i class="oi oi-magnifying-glass"></i> Buscar
                    </button>
                </div>
               @*  <!-- Botón Imprimir alineado a la derecha -->
                <div class="d-flex justify-content-end mb-3">
                    <div>
                        <button id="btnImprimirMaster" class="btn btn-outline-success" @onclick="ConfirmarImpresionAsync" disabled="@isPrinting">
                            <i class="oi oi-print"></i> Imprimir/Exp.Excel
                        </button>
                    </div>

                    @if (isPrinting)
                    {
                        <div class="ms-2 d-flex align-items-center">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Preparando impresión...</span>
                            </div>
                        </div>
                    }
                </div> *@

            </div>
            @if (isPrinting)
            {
            <div class="spinner-border text-success ms-2" role="status">
                <span class="visually-hidden">Preparando impresión...</span>
            </div>
            }
            @if (movimientos != null && movimientos.Any())
            {
                <ImpresionLista TItem="MovimientoHistoricoDTO"
                                Datos="movimientos"
                                Titulo="@TituloReporte"
                                UrlExportarExcel="api/excel/exportar-movimientosKardex"
                                Encabezados="encabezadosProductos"
                                ModoDirecto="false"
                                MostrarModal="mostrarModalImpresion"
                                OnCerrar="ResetearImpresion" />

            }
            <div id="tablaScroll" class="table-container" style="max-height: 15cm; overflow-y: auto;">

                <table class="table table-striped table-hover">
                    <thead class="sticky-top bg-white">
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Documento</th>
                            <th>Transacción</th>
                            <th>Depósito</th>
                            <th>ID Bulto</th>
                            <th>Referencia</th>
                            <th>Entrada</th>
                            <th>Salida</th>
                            <th>Saldo</th> 
                       </tr>
                    </thead>
                    <tbody>

                        @if (movimientos != null)
                        {
                            @foreach (var movimiento in movimientos)
                            {
                                <tr>
                                    <td>@movimiento.Fecha.ToShortDateString()</td>
                                    <td>@movimiento.TipoMovimiento</td>
                                    <td>@movimiento.DocumentoNumero</td>
                                    <td>@movimiento.Transaccion</td>
                                    <td>@movimiento.Deposito</td>
                                    <td>@movimiento.IdBulto</td>
                                    <td>@movimiento.Referencia</td>
                                    <td>@(movimiento.Entrada?.ToString("N2") ?? "")</td>
                                    <td>@(movimiento.Salida?.ToString("N2") ?? "")</td>
                                    <td>@movimiento.Saldo.ToString("N2")</td> 
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (movimientos != null && movimientos.Any())
            {
                <div class="mt-3 p-3 bg-secondary rounded d-flex justify-content-end align-items-center gap-3">
                    <!-- Botón Imprimir a la izquierda del saldo -->
                    <button id="btnImprimirMaster" class="btn btn-outline-light" @onclick="ConfirmarImpresionAsync" disabled="@isPrinting">
                        <i class="oi oi-print"></i> Imprimir/Exp.Excel
                    </button>

                    @if (isPrinting)
                    {
                        <div class="ms-2">
                            <div class="spinner-border text-light" role="status">
                                <span class="visually-hidden">Preparando impresión...</span>
                            </div>
                        </div>
                    }

                    <!-- Saldo alineado a la derecha -->
                    <h5 class="mb-0 text-white">
                        Saldo: <span class="fw-bold">@movimientos.Last().Saldo.ToString("N2")</span>
                    </h5>
                </div>
            }
        </div>
    </div>
</div>

@code {

    // [Parameter] public Master? Repuesto { get; set; }
    [Parameter] public ProductoConSaldoDTO? Repuesto { get; set; }

    [Parameter] public bool ShowInModal { get; set; }
    [Parameter] public string? HeaderClass { get; set; }
    [Parameter] public string? HeaderStyle { get; set; }
    [Parameter] public EventCallback OnMovimientoRevertido { get; set; }

    private FiltroMovimientosDTO filtro = new();
    private List<MovimientoHistoricoDTO> movimientos = new();
    private Dictionary<int, string> depositos = new();
    private int currentPage = 1;
    private int totalPages;
    private readonly int recordsPerPage = 10;
    private string TituloReporte => $"Histórico de Código: {Repuesto?.Codigo} - {Repuesto.Descripcion}";



    protected override async Task OnInitializedAsync()
    {
        await CargarDepositos();
        if (Repuesto != null)
        {
            Console.WriteLine($"Repuesto seleccionado - C.I.: {Repuesto.Cod_inte}, Parte: {Repuesto.Codigo}");

            // No es necesario verificar nullabilidad si Repuesto.Id es int
            int codigoRepuesto = Repuesto.Cod_inte;

            filtro.CodigoRepuesto = codigoRepuesto;
            Console.WriteLine($"Filtro CodigoRepuesto: {filtro.CodigoRepuesto}");
            await CargarMovimientos();
        }


    }

    private async Task CargarDepositos()
    {
        try
        {
            var response = await repository.Get<Dictionary<int, string>>("api/tadeposi/combo");
            if (!response.Error)
            {
                depositos = response.Response;
            }
            else
            {
                depositos = new Dictionary<int, string>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar depósitos: {ex.Message}");
            depositos = new Dictionary<int, string>();
        }
    }

    private async Task CargarMovimientos()
    {
        try
        {
            var queryParams = new List<string>();
            
            if (filtro.Deposito.HasValue)
            {
                queryParams.Add($"deposito={filtro.Deposito.Value}");
            }
            
            if (filtro.FechaDesde.HasValue)
            {
                queryParams.Add($"fechaDesde={filtro.FechaDesde.Value:yyyy-MM-dd}");
            }
            
            if (filtro.FechaHasta.HasValue)
            {
                queryParams.Add($"fechaHasta={filtro.FechaHasta.Value:yyyy-MM-dd}");
            }

            int idRepuesto = Repuesto?.Cod_inte ?? 0; // Asigna 0 si Repuesto o Repuesto.Id son nulos
            if (idRepuesto != 0)
            {
                queryParams.Add($"repuestoId={idRepuesto}");
            }


            var url = "api/stockhistorico/historicosimple";
            if (queryParams.Any())
            {
                url += "?" + string.Join("&", queryParams);
            }
                
            var response = await repository.Get<List<MovimientoHistoricoDTO>>(url);
            
            if (!response.Error)
            {
                movimientos = response.Response!;
                totalRegistros = movimientos!.Count;


                totalPages = 1;
            }
            else
            {
                movimientos = new List<MovimientoHistoricoDTO>();
                totalPages = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar movimientos: {ex.Message}");
            movimientos = new List<MovimientoHistoricoDTO>();
            totalPages = 0;
        }
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await CargarMovimientos();
    }

    private void DepositoSeleccionado(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int depositoId))
        {
            filtro.Deposito = depositoId;
        }
        else
        {
            filtro.Deposito = null;
        }
    }

    private void FechaDesdeSeleccionada(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out DateTime fecha))
        {
            filtro.FechaDesde = fecha;
        }
        else
        {
            filtro.FechaDesde = null;
        }
    }

    private void FechaHastaSeleccionada(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out DateTime fecha))
        {
            filtro.FechaHasta = fecha;
        }
        else
        {
            filtro.FechaHasta = null;
        }
    }

    private async Task Buscar()
    {
        currentPage = 1;
        await CargarMovimientos();
    }

    private async Task RevertirMovimiento(MovimientoHistoricoDTO movimiento)
    {
        var confirmResult = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¿Confirma la reversión?",
            Text = "Esta acción no se puede deshacer",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, revertir",
            CancelButtonText = "Cancelar"
        });

        if (!confirmResult.IsConfirmed) return;

        var response = await repository.Post<MovimientoHistoricoDTO>("api/stockajustes/revertir", movimiento);
        if (response.Error)
        {
            await sweetAlertService.FireAsync("Error", "No se pudo revertir el movimiento", SweetAlertIcon.Error);
            return;
        }

        await sweetAlertService.FireAsync("Éxito", "Movimiento revertido correctamente", SweetAlertIcon.Success);
        await CargarMovimientos();
        await OnMovimientoRevertido.InvokeAsync();
    }

    /// <summary>
    /// IMPRESION
    /// </summary>

    // private List<MovimientoHistoricoDTO>? movimientos;
    private int totalRegistros;
    private bool isPrinting = false;
    private bool mostrarModalImpresion = false;


    Dictionary<string, string> encabezadosProductos = new()

 {
     { "Fecha", "Fecha" },
     { "TipoMovimiento", "Tipo" },
     { "DocumentoNumero", "Documento" },
     { "Transaccion", "Transaccion" },
     { "Deposito", "Deposito" },
     { "IdBulto", "IdBulto" },
     { "Referencia", "Referencia" },

     { "Entrada", "Entrada" },
     { "Salida", "Salida" },
     { "Saldo", "Saldo" },
     { "CodInte", "CodInte" }
    };

    private async Task ConfirmarImpresionAsync()
    {
        isPrinting = true;
        StateHasChanged();

        try
        {


            int cantidad = totalRegistros;

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Confirmar impresión",
                    Text = $"Se van a imprimir {cantidad} registros. Podés aplicar un filtro para reducir la cantidad.\n¿Deseás continuar?",
                    Icon = SweetAlertIcon.Warning,
                    ShowCancelButton = true,
                    ConfirmButtonText = "Sí, imprimir",
                    CancelButtonText = "Cancelar"
                });


            if (result.IsConfirmed)
            {
                // var responseDTO = await repository.Get<List<MasterListadoIndexDTO>>($"api/master/GetMasterListado?filter={Filter}");
                // masterListadoIndexDTO = responseDTO.Response!;
                mostrarModalImpresion = true; // 👈 Mostramos el modal
            }

        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    private void ResetearImpresion()
    {
        // movimientos = null;
        mostrarModalImpresion = false;
        StateHasChanged();
    }

}
