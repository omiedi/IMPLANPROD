@code {
    [Parameter]
    public int Codint { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    /// <summary>
    /// Indica si se debe reabrir el modal de Accesos Directos al cargar la página.
    /// Se usa cuando se regresa desde el anotador de pedidos para elegir otro pedido.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "abrirAccesosDirectos")]
    public bool ReabrirAccesosDirectos { get; set; }

    // Variables para Accesos Directos (Anotador de Pedidos)
    private bool mostrarModalAccesosDirectos = false;
    private string filtroPedidosAccesosDirectos = string.Empty;
    private List<Pedenca> pedidosAccesosDirectos = new();
    private bool cargandoPedidosAccesosDirectos = false;
    // Trackea el Codint para el cual ya se procesó la reapertura del modal,
    // evitando un bucle infinito de renders en OnParametersSetAsync.
    private int? _codintReaperturaProcesada = null;

    private bool isLoading = true;
    private List<ExistenciaRow>? existencias;
    private Master? producto;
    private List<StockProyectadoRow>? stockProyectado;
    private ProductoConSaldoDTO? repuestoSeleccionado;
    private StockDepositoDTO? stockDepositoSeleccionado;
    private List<StockDepositoDTO>? stocksPorDeposito;
    private bool mostrarDetalleDeposito;
    private bool mostrarModalTransferencia;
    private bool mostrarModalHistorico;
    private bool mostrarModalAjuste;
    private int? NivelTrazable;
    private bool mostrarInstructivoUsuario = false;
    private const string InstructivoDevKey = "instructivo-dev";
    private decimal SALSTO;
    private decimal TORECEP;
    private decimal TOPEDID;
    private decimal TOCOMPR;
    private decimal TOFABRI;
    private decimal TORESER;
    private decimal TORESER_TERC;
    private decimal STOTER;

    // Bandera para mostrar/ocultar el modal de búsqueda de productos.
    private bool mostrarBuscador = false;

    // Valor editable del campo "Código" en el card de producto.
    // Permite al usuario escribir un código y buscar coincidencias en master.
    private string codigoManual = string.Empty;

    // Referencia al input de código para gestionar el foco y el cursor.
    private ElementReference inputCodigoRef;

    // Timer para debounce: espera 200ms tras la última tecla antes de buscar.
    private CancellationTokenSource? debounceCts;

    // Flag para enfocar el input de código después de seleccionar del buscador.
    private bool focoPendiente = false;

    private List<UbicacionProductoDTO>? ubicacionesProducto;
    private bool mostrarModalNuevaUbicacion;
    private string nuevaUbicacionTexto = string.Empty;

    private bool mostrarModalEditarUbicacion;
    private UbicacionProductoDTO? ubicacionEditando;
    private string editarUbicacionTexto = string.Empty;

    private List<UbicacionProductoDTO>? ubicacionesProductoBaja;
    private bool mostrarModalUbicacionesBaja;

    private decimal Stomin => producto?.Stomin ?? 0m;
    private decimal Leconom => producto?.Lorepos ?? 0m;

    // =====================================================================
    // MÉTRICAS PRINCIPALES (cálculos derivados de lo cargado en la pantalla)
    // =====================================================================
    // Stock Propio:
    // - Se calcula a partir de la lista de existencias por depósito.
    // - IMPORTANTÍSIMO: solo se suma el stock de los depósitos marcados como "disponibles".
    //   Esa disponibilidad se determina en CargarExistenciasAsync() consultando Tadeposi.disponible.
    private decimal StoProp => (existencias ?? new List<ExistenciaRow>())
        .Where(x => !x.NoDisponible)
        .Sum(x => x.Stock);

    private decimal StoRemo => 0m;
    private decimal StoTot => StoProp + StoRemo;
    private decimal TotalStockDepositos => (existencias ?? new List<ExistenciaRow>()).Sum(x => x.Stock);

    private decimal ToPedid => TOPEDID;
    private decimal ToReser => TORESER + TORESER_TERC;
    private decimal ToCompr => ToPedid + ToReser;

    private decimal ToSumin => TORECEP + TOCOMPR;
    private decimal ToFabri => TOFABRI;
    private decimal ToInPre => ToSumin + ToFabri;

    private decimal StoNet
    {
        get
        {
            var value = StoTot - ToCompr;
            return value < 0m ? 0m : value;
        }
    }

    private async Task RestaurarUbicacionAsync(UbicacionProductoDTO ubicacion)
    {
        if (ubicacion == null || ubicacion.Id <= 0)
        {
            return;
        }

        try
        {
            var response = await repository.Put<object>($"api/ubicasql/restaurar/{ubicacion.Id}", new { });
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo restaurar la ubicación", SweetAlertIcon.Error);
                return;
            }

            await CargarUbicacionesProductoAsync();
            await CargarUbicacionesProductoBajaAsync();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

    private async Task CargarTercerosPendientesAsync()
    {
        tercerosPendientes = new List<StockTercerosPendienteDTO>();
        STOTER = 0m;
        TORESER_TERC = 0m;

        if (Codint <= 0)
        {
            return;
        }

        try
        {
            var response = await repository.Get<List<StockTercerosPendienteDTO>>($"api/Maconsig/terceros-pendientes-por-producto/{Codint}");
            if (response.Error || response.Response == null)
            {
                return;
            }

            tercerosPendientes = response.Response.ToList();

            STOTER = tercerosPendientes.Sum(x => x.CapenRendir);
            TORESER_TERC = tercerosPendientes
                .Where(x => x.CapenEntregar >= 0.05m && (x.StatOcom ?? -1) < 8 && (x.StatOcom ?? -1) >= 0)
                .Sum(x => x.CapenEntregar);
        }
        catch
        {
            tercerosPendientes = new List<StockTercerosPendienteDTO>();
            STOTER = 0m;
            TORESER_TERC = 0m;
        }
    }

    private async Task CargarReservasPendientesAsync()
    {
        reservasPendientes = new List<StockReservaPendienteDTO>();
        TORESER = 0m;

        if (Codint <= 0)
        {
            return;
        }

        try
        {
            var response = await repository.Get<List<StockReservaPendienteDTO>>($"api/reservas/pendientes-por-producto/{Codint}");
            if (response.Error || response.Response == null)
            {
                return;
            }

            reservasPendientes = response.Response
                .Where(x => x.CantPendiente > 0m)
                .OrderBy(x => x.IdSubOr)
                .ToList();

            var esGk = string.Equals(producto?.Umedida, "GK", StringComparison.OrdinalIgnoreCase);
            TORESER = reservasPendientes.Sum(x => esGk ? (x.CantPendiente / 1000m) : x.CantPendiente);
        }
        catch
        {
            reservasPendientes = new List<StockReservaPendienteDTO>();
            TORESER = 0m;
        }
    }

    private async Task CargarFabricacionPendienteAsync()
    {
        fabricacionPendiente = new List<StockFabricacionPendienteDTO>();
        TOFABRI = 0m;

        if (Codint <= 0)
        {
            return;
        }

        try
        {
            var response = await repository.Get<List<StockFabricacionPendienteDTO>>($"api/ordefabr/pendientes-por-producto/{Codint}");
            if (response.Error || response.Response == null)
            {
                return;
            }

            fabricacionPendiente = response.Response
                .Where(x => x.CantPendiente > 0m)
                .OrderBy(x => x.NumeOrfa)
                .ToList();

            TOFABRI = fabricacionPendiente.Sum(x => x.CantPendiente);
        }
        catch
        {
            fabricacionPendiente = new List<StockFabricacionPendienteDTO>();
            TOFABRI = 0m;
        }
    }

    private async Task CargarFabricacionPendienteAprobacionAsync()
    {
        fabricacionPendienteAprobacion = new List<StockFabricacionPendienteAprobacionDTO>();

        if (Codint <= 0)
        {
            return;
        }

        try
        {
            var response = await repository.Get<List<StockFabricacionPendienteAprobacionDTO>>($"api/orfapen/pendientes-aprobacion-por-producto/{Codint}");
            if (response.Error || response.Response == null)
            {
                return;
            }

            fabricacionPendienteAprobacion = response.Response
                .Where(x => x.CantPendiente > 0m)
                .OrderBy(x => x.DoPriCor)
                .ToList();

            // Sumar a TOFABRI (fabricaciones proyectadas) igual que en VB6: TOFABRI = TOFABRI + CAPEN
            TOFABRI += fabricacionPendienteAprobacion.Sum(x => x.CantPendiente);
        }
        catch
        {
            fabricacionPendienteAprobacion = new List<StockFabricacionPendienteAprobacionDTO>();
        }
    }

