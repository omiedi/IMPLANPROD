    private async Task MostrarStockPorDepositoAsync()
    {
        try
        {
            repuestoSeleccionado = BuildRepuestoSeleccionado();
            if (repuestoSeleccionado == null)
            {
                await sweetAlertService.FireAsync("Error", "No hay un producto seleccionado", SweetAlertIcon.Error);
                return;
            }

            stocksPorDeposito = null;
            mostrarDetalleDeposito = true;

            var responseDepositos = await repository.Get<List<int>>("api/tadeposi/SoloCodigos");
            if (responseDepositos.Error || responseDepositos.Response == null)
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar los depósitos", SweetAlertIcon.Error);
                stocksPorDeposito = new List<StockDepositoDTO>();
                return;
            }

            var responseStock = await repository.Get<List<StockDepositoDTO>>($"api/movisto/stock/{Codint}");
            if (responseStock.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo cargar el stock por depósito", SweetAlertIcon.Error);
                stocksPorDeposito = new List<StockDepositoDTO>();
                return;
            }

            var responseDepositosInfo = await repository.Get<Dictionary<int, string>>("api/tadeposi/combo");
            if (responseDepositosInfo.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar las descripciones de depósitos", SweetAlertIcon.Error);
                stocksPorDeposito = new List<StockDepositoDTO>();
                return;
            }

            var depositosConMovimientos = (responseStock.Response ?? new List<StockDepositoDTO>())
                .Select(s => s.Deposito ?? 0)
                .Distinct();

            var universoDepositos = responseDepositos.Response
                .Union(depositosConMovimientos)
                .Distinct()
                .OrderBy(d => d)
                .ToList();

            stocksPorDeposito = universoDepositos
                .Select(deposito =>
                {
                    var stockExistente = responseStock.Response?.FirstOrDefault(s => s.Deposito == deposito);
                    var descripcion = deposito == 0 ? "Sin depósito" : "Sin descripción";
                    if (responseDepositosInfo.Response != null && responseDepositosInfo.Response.TryGetValue(deposito, out var desc))
                    {
                        descripcion = desc;
                    }

                    return new StockDepositoDTO
                    {
                        Deposito = deposito,
                        Stock = stockExistente?.Stock ?? 0m,
                        Descripcion = descripcion
                    };
                })
                .OrderByDescending(s => s.Stock)
                .ToList();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"No se pudo cargar el stock por depósito: {ex.Message}", SweetAlertIcon.Error);
            stocksPorDeposito = new List<StockDepositoDTO>();
        }
    }

