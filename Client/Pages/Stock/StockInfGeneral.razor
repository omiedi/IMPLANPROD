    private async Task CargarProductoAsync()
    {
        producto = null;

        if (Codint <= 0)
        {
            codigoManual = string.Empty;
            return;
        }

        try
        {
            var responseProducto = await repository.Get<Master>($"api/master/xCodint{Codint}");
