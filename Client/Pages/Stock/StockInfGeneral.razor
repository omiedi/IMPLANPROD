    /// <summary>
    /// Se ejecuta cuando el usuario selecciona un producto del buscador.
    /// Navega a /StockInfGeneral con el nuevo Codint, manteniendo el returnUrl
    /// original para que el botón "Regresar" siga funcionando.
    /// </summary>
    /// <param name="master">Producto seleccionado en el buscador</param>
    private void OnProductoBuscadoSelected(Master master)
    {
        if (master == null || master.Codint <= 0) return;

        // Si es el mismo producto, no recargar
        if (master.Codint == Codint)
        {
            // Aun siendo el mismo, enfocar el input
            focoPendiente = true;
            return;
        }

        // Marcar que después de cargar, el foco debe ir al input de código.
        focoPendiente = true;

        // Preservar returnUrl si existe
        var url = !string.IsNullOrWhiteSpace(returnUrl)
            ? $"/StockInfGeneral/{master.Codint}?returnUrl={Uri.EscapeDataString(returnUrl)}"
            : $"/StockInfGeneral/{master.Codint}";

        NavigationManager.NavigateTo(url, forceLoad: false);
    }

    /// <summary>
    /// Se ejecuta al soltar una tecla en el input de Código (onkeyup).
    /// Implementa un debounce de 200ms: si el usuario sigue escribiendo, se cancela
    /// la búsqueda anterior y se reinicia la espera. Solo se ejecuta la búsqueda
    /// cuando el usuario hace una pausa (supuestamente terminó de escribir).
    /// El valor del input ya está sincronizado con codigoManual gracias a
    /// @bind:event="oninput", por lo que aquí solo gestionamos el debounce.
    /// </summary>
    private void OnCodigoManualKeyUp(KeyboardEventArgs e)
    {
        // Cancelar búsqueda pendiente anterior.
        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                // Esperar 200ms (dos décimas de segundo) antes de buscar.
                // Si el usuario sigue escribiendo, se cancela y reinicia la espera.
                await Task.Delay(200, token);

                // Si no fue cancelado, ejecutar la búsqueda.
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(async () =>
                    {
                        await BuscarPorCodigoManualAsync();
                    });
                }
            }
            catch (TaskCanceledException)
            {
                // Ignorar: el debounce fue cancelado porque el usuario siguió escribiendo.
            }
        });
    }

    /// <summary>
    /// Busca el producto por el código externo escrito manualmente.
    /// Consulta el endpoint por-codigo para coincidencia exacta.
    /// Si encuentra coincidencia:
    ///   - Si el Codint es diferente al de la página actual, navega a la nueva URL.
    ///   - Si el Codint es el mismo (ej: se borró y se volvió a escribir), recarga todos los datos.
    /// Si no encuentra coincidencia, limpia todos los casilleros de información.
    /// </summary>
    private async Task BuscarPorCodigoManualAsync()
    {
        var codigo = (codigoManual ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(codigo))
        {
            LimpiarInformacionProducto();
            // No forzar foco ni cursor aquí: el usuario está editando el input
            // y forzar el cursor al final provocaría que se "adelante".
            return;
        }

        // Si tiene 3 caracteres o menos, no buscar todavía
        if (codigo.Length <= 3)
        {
            return;
        }

        try
        {
            var response = await repository.Get<Master>($"api/master/por-codigo/{Uri.EscapeDataString(codigo)}");

            if (!response.Error && response.Response != null)
            {
                var master = response.Response;

                // No sobrescribir codigoManual con el código canónico del producto:
                // hacerlo re-renderiza el input con un valor distinto al que el
                // usuario está escribiendo y el navegador reposiciona el cursor.
                // Se respeta exactamente lo que el usuario tipeó.

                if (master.Codint == Codint)
                {
                    // Mismo Codint de la página actual: los datos pueden haber sido
                    // limpiados previamente (ej: 123456 → 12345 → 123456).
                    // Recargar toda la información sin navegar.
                    isLoading = true;
                    StateHasChanged();

                    try
                    {
                        await RecargarTodoAsync();
                    }
                    finally
                    {
                        // Asegurar que el spinner se oculte siempre, incluso si
                        // RecargarTodoAsync lanza una excepción o muestra un SweetAlert.
                        isLoading = false;
                        StateHasChanged();
                    }

                    // No forzar foco/cursor: el usuario sigue editando el input.
                }
                else
                {
                    // Codint diferente: navegar al nuevo producto preservando returnUrl.
                    var url = !string.IsNullOrWhiteSpace(returnUrl)
                        ? $"/StockInfGeneral/{master.Codint}?returnUrl={Uri.EscapeDataString(returnUrl)}"
                        : $"/StockInfGeneral/{master.Codint}";

                    NavigationManager.NavigateTo(url, forceLoad: false);
                }
            }
            else
            {
                // No se encontró el código: limpiar toda la información
                LimpiarInformacionProducto();
                StateHasChanged();
            }
        }
        catch
        {
            // En caso de error, asegurar que el spinner se oculte y limpiar.
            isLoading = false;
            LimpiarInformacionProducto();
            // No forzar foco/cursor: el usuario sigue editando el input.
        }
    }

    /// <summary>
    /// Limpia todos los casilleros de información del producto cuando el código
    /// ingresado no coincide con ningún producto existente.
    /// </summary>
