    private async Task GuardarEdicionUbicacionAsync()
    {
        if (ubicacionEditando == null || ubicacionEditando.Id <= 0)
        {
            return;
        }

        var texto = (editarUbicacionTexto ?? string.Empty).Trim();
        if (Codint <= 0 || string.IsNullOrWhiteSpace(texto))
        {
            return;
        }

        try
        {
            var dto = new UbicacionProductoUpdateDTO
            {
                Codiubica = texto
            };

            var response = await repository.Put<UbicacionProductoUpdateDTO>($"api/ubicasql/actualizar/{ubicacionEditando.Id}", dto);
            if (response.Error)
            {
