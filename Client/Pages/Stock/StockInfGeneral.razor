        }
    }

    private async Task CargarExistenciasAsync()
    {
        if (Codint <= 0)
        {
            existencias = new List<ExistenciaRow>();
            isLoading = false;
            return;
        }

        try
        {
            isLoading = true;

            // 1) Lista de depósitos existentes (solo códigos).
            //    Esto nos da el universo de depósitos a considerar en la grilla.
            var responseDepositos = await repository.Get<List<int>>("api/tadeposi/SoloCodigos");
            if (responseDepositos.Error || responseDepositos.Response == null)
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar los depósitos", SweetAlertIcon.Error);
                existencias = new List<ExistenciaRow>();
                return;
            }

            // 2) Info de depósitos activos (descripción + flag 'disponible').
            //    NOTA: no usamos el endpoint 'combo' porque ese arma un diccionario para UI,
            //    pero no nos asegura el flag de disponibilidad.
            var responseDepositosInfo = await repository.Get<List<Tadeposi>>("api/tadeposi/activos");
            if (responseDepositosInfo.Error || responseDepositosInfo.Response == null)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo cargar el combo de depósitos", SweetAlertIcon.Error);
                existencias = new List<ExistenciaRow>();
                return;
            }

            // 3) Normalizamos la info en un diccionario por código:
            //    - Descripcion: texto a mostrar en grilla.
            //    - Disponible: bool real del depósito.
            var depositosInfo = responseDepositosInfo.Response
                .Where(x => x.CodigoDepo > 0)
                .ToDictionary(
                    x => x.CodigoDepo,
                    x => new { Descripcion = $"{x.CodigoDepo} - {x.Descripcion}", Disponible = x.disponible });

            // 4) Stock por depósito para el producto.
            //    El backend devuelve movimientos agregados por depósito; aquí los consolidamos en un diccionario.
            var responseStock = await repository.Get<List<StockDepositoDTO>>($"api/movisto/stock/{Codint}");
            if (responseStock.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo cargar el stock por depósito", SweetAlertIcon.Error);
                existencias = new List<ExistenciaRow>();
                return;
            }

            // 4.1) Consolidamos la respuesta del backend en un diccionario:
            //      Depósito -> Stock (sumado)
            //      Esto simplifica el armado de la grilla.
            var stocksByDeposito = (responseStock.Response ?? new List<StockDepositoDTO>())
                .GroupBy(x => x.Deposito ?? 0)
                .ToDictionary(g => g.Key, g => g.Sum(x => x.Stock));

            var universoDepositos = responseDepositos.Response
                .Union(stocksByDeposito.Keys)
                .Distinct()
                .OrderBy(d => d)
                .ToList();

            // 5) Armamos filas para la grilla de existencias.
            //    - Recorremos todos los depósitos.
            //    - Solo mostramos depósitos con stock "significativo" para no llenar de ceros la grilla.
            //    - Marcamos NoDisponible según Tadeposi.disponible, porque esto impacta en StoProp.
            var rows = new List<ExistenciaRow>();
            foreach (var deposito in universoDepositos)
            {
                stocksByDeposito.TryGetValue(deposito, out var stock);
                if (Math.Abs(stock) < 0.05m)
                {
                    continue;
                }

                // Por defecto: si no encontramos el depósito en el diccionario de activos,
                // lo marcamos como no disponible y mostramos "Sin descripción".
                var noDisponible = true;
                var descripcion = deposito == 0 ? "Sin depósito" : "Sin descripción";
                if (depositosInfo.TryGetValue(deposito, out var info))
                {
                    descripcion = info.Descripcion;

                    // Punto clave del negocio:
                    // - Si Tadeposi.disponible es false => NoDisponible=true.
                    // - StoProp (Stock Propio) suma solamente depósitos con NoDisponible=false.
                    noDisponible = !info.Disponible;
                }

                rows.Add(new ExistenciaRow
                {
                    Deposito = deposito,
                    Descripcion = descripcion,
                    Stock = stock,
                    NoDisponible = noDisponible
                });
            }

            existencias = rows
                .OrderByDescending(x => x.Stock)
                .ToList();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
            existencias = new List<ExistenciaRow>();
        }
        finally
        {
            isLoading = false;
        }
    }

