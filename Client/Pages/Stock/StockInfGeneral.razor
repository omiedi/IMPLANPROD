    protected override async Task OnParametersSetAsync()
    {
        // Activar spinner al inicio de la carga para que el usuario vea feedback
        // inmediato al cambiar de producto desde el buscador.
        isLoading = true;
        StateHasChanged();

        try
        {
            await RecargarTodoAsync();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }

        // Si se regresa desde el anotador de pedidos, reabrir el modal para seleccionar otro pedido.
        // Se procesa una sola vez por Codint para evitar un bucle de renders (OnParametersSetAsync
        // se ejecuta en cada render, y ReabrirAccesosDirectos viene del query string que no cambia).
        if (ReabrirAccesosDirectos && _codintReaperturaProcesada != Codint)
        {
            _codintReaperturaProcesada = Codint;
            AbrirAccesosDirectos();
            await BuscarPedidosAccesosDirectos();
        }
    }

    /// <summary>
    /// Ejecuta la secuencia completa de carga de datos del producto:
    /// producto, ubicaciones, existencias, pendientes y stock proyectado.
    /// Se reutiliza tanto en OnParametersSetAsync como cuando el usuario
    /// vuelve a escribir un código que corresponde al mismo Codint de la página.
    /// </summary>
    private async Task RecargarTodoAsync()
    {
        mostrarInstructivoUsuario = false;
        await CargarProductoAsync();
        repuestoSeleccionado = BuildRepuestoSeleccionado();
        await CargarUbicacionesProductoAsync();
        await CargarExistenciasAsync();
        await CargarRecepcionesPendientesAsync();
        await CargarRecepcionesPendientesAprobacionAsync();
        await CargarPedidosPendientesAsync();
        await CargarComprasPendientesAsync();
        await CargarFabricacionPendienteAsync();
        await CargarFabricacionPendienteAprobacionAsync();
        await CargarReservasPendientesAsync();
        await CargarTercerosPendientesAsync();
        RecalcularStockProyectado();
    }

    /// <summary>
    /// Después de cada render, si hay un foco pendiente (por ejemplo, tras
    /// seleccionar un producto del buscador), coloca el foco y el cursor
    /// al final del input de código editable.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focoPendiente)
        {
            focoPendiente = false;
            await FocusCodigoInputAsync();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

