@page "/StockInfGeneral/{Codint:int}"
@using Microsoft.AspNetCore.Authorization
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Shared.Components
@using System.Web
@using IMPLANPROD.Client.Pages.StockAjustes

@attribute [Authorize]
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Stock - Inf.General</PageTitle>

<div class="container-fluid">
    <div class="mb-2 d-flex align-items-center flex-wrap gap-2">
        <h2 class="fw-bold text-primary mb-0 me-3">
            <i class="fas fa-info-circle me-2"></i>INF. DE STOCK
        </h2>

        <button type="button" class="btn btn-secondary btn-sm" @onclick="Regresar">
            <i class="oi oi-arrow-left"></i> Regresar
        </button>

        <div class="d-flex align-items-center flex-wrap gap-2 ms-auto">
            <button type="button" class="btn btn-warning btn-sm" @onclick="MostrarStockPorDepositoAsync" disabled="@(producto == null || Codint <= 0)">
                <i class="oi oi-eye"></i> X Depósito + Ajustes
            </button>

            <button type="button" class="btn btn-info btn-sm" @onclick="AbrirTransferencias" disabled="@(producto == null || Codint <= 0)">
                <i class="oi oi-transfer"></i> Transferencia Item
            </button>

            <button type="button" class="btn btn-success btn-sm" @onclick="AbrirTransferenciaMultiple">
                <i class="oi oi-list"></i> Transf. Múltiple
            </button>

            <button type="button" class="btn btn-secondary btn-sm" @onclick="AbrirHistorico" disabled="@(producto == null || Codint <= 0)">
                <i class="oi oi-clock"></i> Histórico
            </button>
        </div>
    </div>
    <hr class="border-primary border-2 opacity-50 mt-0 mb-2" />

    @* Buscador de productos con búsqueda combinada por '+' *@
    <MasterSearchModal IsVisible="@mostrarBuscador"
                       OnRepuestoSelected="OnProductoBuscadoSelected"
                       OnCloseRequested="@(() => mostrarBuscador = false)" />

    <div class="card shadow-sm border border-2 bg-light mb-2 py-1">
        <div class="card-body p-2">
            @* Fila única: Código + input + lupa + descripción + Accesos Directos (derecha) *@
            <div class="d-flex align-items-center gap-2 flex-wrap mb-0">
                @* Rótulo "Código:" al margen izquierdo *@
                <span class="fw-bold text-primary" style="font-size: 1.1rem;">Código:</span>

                @* Input de código editable, a la derecha del rótulo *@
                <input type="text"
                       class="form-control"
                       style="width: 200px; font-size: 1.1rem; font-weight: bold;"
                       @bind="codigoManual"
                       @bind:event="oninput"
                       @onkeyup="OnCodigoManualKeyUp"
                       placeholder="Código..."
                       @ref="inputCodigoRef" />

                @* Botón lupa (solo ícono, sin texto) *@
                <button type="button" class="btn btn-outline-primary btn-sm p-1" @onclick="AbrirBuscador" title="Buscar producto">
                    <i class="oi oi-magnifying-glass" style="font-size: 1.1rem;"></i>
                </button>

                @* Descripción a la derecha del botón lupa *@
                <span class="fw-bold text-dark" style="font-size: 1.1rem;">
                    @(producto?.Descripcion ?? string.Empty)
                </span>

                @* "Accesos Directos" empujado al extremo derecho de la fila *@
                <div class="ms-auto">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="oi oi-external-link me-1"></i> Accesos Directos
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button type="button" class="dropdown-item" @onclick="AbrirAccesosDirectos">
                                    <i class="fas fa-eye me-1"></i> Anotador de Pedidos
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Spinner overlay mientras se cargan los datos del producto *@
    @if (isLoading)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center"
             style="background-color: rgba(255,255,255,0.7); z-index: 1050;">
            <div class="text-center">
                <div class="spinner-border text-primary mb-2" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <div class="fw-semibold text-primary">Cargando información del producto...</div>
            </div>
        </div>
    }

    @* Existencias a ancho completo *@
    <div class="row g-2 mb-2">
        @* 
           Existencias: tabla con stock por depósito.
           Nota de UI: usamos borde oscuro y más grueso para que el marco sea "notorio" y consistente con el resto de la pantalla.
        *@
        <div class="col-12">
            <div class="card shadow-sm border border-dark" style="border-width: 2px;">
                <div class="card-header bg-primary text-white border-bottom border-2 py-1">
                    Existencias
                </div>
                <div class="card-body bg-white p-2">
                    @if (isLoading)
                    {
                        <div class="spinner-border text-primary" role="status">
                            <span class="sr-only">Cargando...</span>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 230px; overflow-y: auto;">
                            <table class="table table-striped table-hover table-bordered align-middle mb-0">
                                <thead class="sticky-top" style="background-color: #000; color: #fff;">
                                    <tr>
                                        <th style="background-color: #000; color: #fff;">Depósito</th>
                                        <th style="background-color: #000; color: #fff;">Descripción</th>
                                        <th class="text-end" style="background-color: #000; color: #fff;">Stock</th>
                                        <th style="background-color: #000; color: #fff;">No Disponible</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (existencias == null || existencias.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="4">Sin existencias para mostrar.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in existencias)
                                        {
                                            <tr>
                                                <td>@row.Deposito</td>
                                                <td>@row.Descripcion</td>
                                                <td class="text-end">@row.Stock.ToString("N2")</td>
                                                <td>@(row.NoDisponible ? "(x)" : string.Empty)</td>
                                            </tr>
                                        }

                                        @if (TORECEP > 0.05m)
                                        {
                                            <tr class="table-info">
                                                <td colspan="2">RECEPC.</td>
                                                <td class="text-end">@TORECEP.ToString("N2")</td>
                                                <td></td>
                                            </tr>
                                        }

                                        @if (Math.Abs(STOTER) >= 0.005m)
                                        {
                                            <tr class="table-info">
                                                <td colspan="2">TERCEROS</td>
                                                <td class="text-end">@STOTER.ToString("N2")</td>
                                                <td></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-1 d-flex justify-content-end">
                            <span class="badge bg-secondary" style="font-size: 0.95rem;">
                                Total depósitos: @TotalStockDepositos.ToString("N2")
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @*
       Stock Proyectado: grilla cronológica con los movimientos pendientes y el acumulado proyectado.
       Nota de UI: borde destacado para que el usuario identifique el bloque rápidamente.
    *@
    <div class="card shadow-sm border border-dark mb-3" style="border-width: 3px;">
        <div class="card-header bg-primary text-white border-bottom border-2">
            Stock Proyectado
        </div>
        <div class="card-body bg-white">
            <div class="table-responsive" style="max-height: 230px; overflow-y: auto;">
                <table class="table table-striped table-hover table-bordered align-middle mb-0">
                    <thead class="sticky-top" style="background-color: #000; color: #fff;">
                        <tr>
                            <th style="background-color: #000; color: #fff;">Comprobante</th>
                            <th style="background-color: #000; color: #fff;">Referencia</th>
                            <th class="text-end" style="background-color: #000; color: #fff;">Entra</th>
                            <th class="text-end" style="background-color: #000; color: #fff;">Sale</th>
                            <th class="text-end" style="background-color: #000; color: #fff;">Proyectado</th>
                            <th style="background-color: #000; color: #fff;">Fecha</th>
                            <th style="background-color: #000; color: #fff;">Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (stockProyectado == null || stockProyectado.Count == 0)
                        {
                            <tr>
                                <td colspan="7">Sin datos para mostrar.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in stockProyectado)
                            {
                                <tr>
                                    <td>@row.Comprobante</td>
                                    <td>@row.Referencia</td>
                                    <td class="text-end">@row.Entra.ToString("N1")</td>
                                    <td class="text-end">@row.Sale.ToString("N1")</td>
                                    <td class="text-end">@row.Proyectado.ToString("N1")</td>
                                    <td>@row.Fecha</td>
                                    <td>@row.Observaciones</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Métricas resumidas en 6 columnas (Parámetros, Stock, Comprometido, Ingresar, Situación, Ubicaciones) *@
    <div class="row g-1 mb-2">
        @* Parámetros *@
        <div class="col-12 col-md-6 col-xl">
            <div class="border border-dark rounded p-2 h-100" style="border-width: 2px;">
                <div class="fw-bold mb-1">Parámetros</div>
                <div class="row g-1 align-items-center">
                    <div class="col-7">
                        <label class="form-label mb-0">Mínimo</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{Stomin:N2}")" />
                    </div>
                    <div class="col-7">
                        <label class="form-label mb-0">Económico</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{Leconom:N2}")" />
                    </div>
                </div>
            </div>
        </div>

        @* Stock *@
        <div class="col-12 col-md-6 col-xl">
            <div class="border border-dark rounded p-2 h-100" style="border-width: 2px;">
                <div class="fw-bold mb-1">Stock</div>
                <div class="row g-1 align-items-center">
                    <div class="col-7">
                        <label class="form-label mb-0">Propio</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{StoProp:N2}")" />
                    </div>
                    <div class="col-7">
                        <label class="form-label mb-0">Remoto</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{StoRemo:N2}")" />
                    </div>
                    <div class="col-7">
                        <label class="form-label mb-0">Total</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{StoTot:N2}")" />
                    </div>
                </div>
            </div>
        </div>

        @* Comprometido *@
        <div class="col-12 col-md-6 col-xl">
            <div class="border border-dark rounded p-2 h-100" style="border-width: 2px;">
                <div class="fw-bold mb-1">Comprometido</div>
                <div class="row g-1 align-items-center">
                    <div class="col-7">
                        <label class="form-label mb-0">Pedidos</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{ToPedid:N2}")" />
                    </div>
                    <div class="col-7">
                        <label class="form-label mb-0">Asign. y Reservas</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{ToReser:N2}")" />
                    </div>
                    <div class="col-7">
                        <label class="form-label mb-0">Total</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{ToCompr:N2}")" />
                    </div>
                </div>
            </div>
        </div>

        @* Ingresar *@
        <div class="col-12 col-md-6 col-xl">
            <div class="border border-dark rounded p-2 h-100" style="border-width: 2px;">
                <div class="fw-bold mb-1">Ingresar</div>
                <div class="row g-1 align-items-center">
                    <div class="col-7">
                        <label class="form-label mb-0">Compras</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{ToSumin:N2}")" />
                    </div>
                    <div class="col-7">
                        <label class="form-label mb-0">Fabricación</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{ToFabri:N2}")" />
                    </div>
                    <div class="col-7">
                        <label class="form-label mb-0">Total</label>
                    </div>
                    <div class="col-5">
                        <input class="form-control form-control-sm text-end" readonly value="@($"{ToInPre:N2}")" />
                    </div>
                </div>
            </div>
        </div>

        @* Situación: inputs apilados verticalmente *@
        <div class="col-12 col-md-6 col-xl">
            <div class="border border-dark rounded p-2 h-100" style="border-width: 2px;">
                <div class="fw-bold mb-1">Situación</div>
                <div class="d-flex flex-column gap-1">
                    <div>
                        <label class="form-label mb-0">Neto</label>
                        <input class="form-control form-control-sm text-end" readonly value="@($"{StoNet:N2}")" />
                    </div>
                    <div>
                        <label class="form-label mb-0">Disponible</label>
                        <input class="form-control form-control-sm text-end" readonly value="@($"{StoDis:N2}")" />
                    </div>
                    <div>
                        <label class="form-label mb-0">Faltantes</label>
                        <input class="form-control form-control-sm text-end" readonly value="@($"{StoFal:N2}")" />
                    </div>
                    <div>
                        <label class="form-label mb-0">No Reservado</label>
                        <input class="form-control form-control-sm text-end" readonly value="@($"{NoReservado:N2}")" />
                    </div>
                </div>
            </div>
        </div>

        @* Ubicaciones: lista compacta con scroll si supera 5 registros *@
        <div class="col-12 col-md-6 col-xl">
            <div class="border border-dark rounded p-2 h-100" style="border-width: 2px;">
                <div class="d-flex justify-content-between mb-1">
                    <div class="fw-bold">Ubicaciones</div>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-danger py-0 px-1" @onclick="AbrirModalUbicacionesBaja" disabled="@(Codint <= 0)"
                                title="Ubicaciones del código activo dadas de baja" data-bs-toggle="tooltip" data-bs-placement="top">
                            Bajas
                        </button>
                        <button type="button" class="btn btn-sm btn-success py-0 px-1" @onclick="AbrirModalNuevaUbicacion" disabled="@(Codint <= 0)">
                            <i class="oi oi-plus"></i>
                        </button>
                    </div>
                </div>

                <div class="overflow-auto" style="max-height: 180px;">
                    <table class="table table-sm table-striped mb-0">
                        <tbody>
                            @if (ubicacionesProducto == null)
                            {
                                <tr><td class="text-muted">Cargando...</td></tr>
                            }
                            else if (!ubicacionesProducto.Any())
                            {
                                <tr><td class="text-muted">(Sin ubicaciones)</td></tr>
                            }
                            else
                            {
                                @foreach (var u in ubicacionesProducto)
                                {
                                    <tr>
                                        <td class="py-0">@u.Codiubica</td>
                                        <td class="text-end py-0" style="white-space: nowrap;">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1" @onclick="() => AbrirModalEditarUbicacion(u)">
                                                    <i class="oi oi-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" @onclick="async () => await EliminarUbicacionAsync(u)">
                                                    <i class="oi oi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Instructivos colapsables (al final de la página, en dos columnas) -->
    <div class="row mb-3">
        @* Columna izquierda: Instructivo para el Usuario *@
        <div class="col-12 col-lg-6">
            <div class="card mb-2">
                <div class="card-header bg-info text-white p-2">
                    <button class="btn btn-link text-white text-decoration-none w-100 text-start p-0"
                            type="button"
                            @onclick="() => mostrarInstructivoUsuario = !mostrarInstructivoUsuario">
                        <i class="fas @(mostrarInstructivoUsuario ? "fa-chevron-down" : "fa-chevron-right") me-2"></i>
                        <strong>Instructivo para el Usuario</strong>
                    </button>
                </div>
                @if (mostrarInstructivoUsuario)
                {
                    <div class="card-body">
                        <h6 class="text-primary"><i class="fas fa-info-circle"></i> Objetivo</h6>
                        <p>
                            Esta pantalla muestra la <strong>situación general de stock</strong> del producto seleccionado y un detalle de
                            <strong>movimientos pendientes</strong> (pedidos, reservas, compras, fabricación, recepciones, terceros) que
                            afectan el stock disponible.
                        </p>

                        <h6 class="text-primary mt-3"><i class="fas fa-hand-pointer"></i> Botones de Acción</h6>
                        <ul>
                            <li><strong>Regresar:</strong> vuelve a la pantalla desde la que ingresaste (si corresponde) o a la lista de stock.</li>
                            <li><strong>X Depósito + Ajustes:</strong> muestra el stock por depósito y permite registrar un ajuste en el depósito elegido.</li>
                            <li><strong>Transferencias:</strong> permite transferir stock entre depósitos. El botón "Transferencia Item" ofrece "Item único" (mismo código entre depósitos) o "Transf. C/Transformación de Código" (sale el código actual e ingresa otro código por la misma cantidad).</li>
                            <li><strong>Histórico:</strong> permite consultar movimientos históricos filtrando por depósito y rango de fechas.</li>
                        </ul>

                        <h6 class="text-primary mt-3"><i class="fas fa-chart-line"></i> Métricas (cómo leerlas)</h6>
                        <ul>
                            <li><strong>Mínimo:</strong> stock mínimo definido para el producto.</li>
                            <li><strong>Económico:</strong> lote económico (reposición sugerida) definido para el producto.</li>
                            <li><strong>Stock Propio:</strong> suma del stock existente en depósitos marcados como disponibles en la grilla de Existencias.</li>
                            <li><strong>Stock Total:</strong> por el momento coincide con Stock Propio (si hubiera stock remoto se sumaría aquí).</li>
                            <li><strong>Pedidos:</strong> cantidad comprometida por pedidos pendientes del producto.</li>
                            <li><strong>Asignados y Reservas:</strong> stock comprometido por reservas internas y/o terceros (según corresponda).</li>
                            <li><strong>Comprometido:</strong> total comprometido = Pedidos + Asignados y Reservas.</li>
                            <li><strong>Compras:</strong> total a ingresar por compras pendientes.</li>
                            <li><strong>Fabricación:</strong> total a ingresar por órdenes de fabricación pendientes.</li>
                            <li><strong>Ingresar:</strong> total a ingresar = Compras + Fabricación.</li>
                            <li><strong>Neto:</strong> stock total menos comprometido (nunca baja de 0).</li>
                            <li><strong>Disponible:</strong> stock neto menos mínimo (nunca baja de 0).</li>
                            <li><strong>Faltantes:</strong> faltante = mínimo menos stock neto (nunca baja de 0).</li>
                            <li><strong>No Reservado:</strong> stock total menos reservas (nunca baja de 0).</li>
                        </ul>

                        <h6 class="text-primary mt-3"><i class="fas fa-table"></i> Stock Proyectado</h6>
                        <p>
                            La tabla <strong>Stock Proyectado</strong> muestra, en forma cronológica, los movimientos pendientes que
                            <strong>entran</strong> o <strong>salen</strong> del stock, y el acumulado proyectado.
                        </p>

                        <h6 class="text-primary mt-3"><i class="fas fa-warehouse"></i> Existencias</h6>
                        <p>
                            La tabla <strong>Existencias</strong> muestra el stock por depósito. Además, puede incluir filas informativas de
                            <strong>Recepciones</strong> y <strong>Terceros</strong> (si existen), como resumen adicional.
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Columna derecha: Instructivo para el Desarrollador *@
        <div class="col-12 col-lg-6">
            <InstructivoDesarrollador @key="InstructivoDevKey">
                <h6 class="text-info"><i class="fas fa-code"></i> Objetivo técnico</h6>
                <p>
                    <strong>StockInfGeneral</strong> concentra la visualización de métricas y movimientos pendientes de un producto.
                    Se diseñó para mantener el listado de productos (<code>StockIndex</code>) liviano y mover aquí las consultas
                    pesadas y acciones (depósitos/ajustes, transferencias, histórico).
                </p>

                <h6 class="text-info mt-3"><i class="fas fa-route"></i> Parámetros de ruta / navegación</h6>
                <ul>
                    <li><strong>Route:</strong> <code>/StockInfGeneral/{Codint:int}</code></li>
                    <li><strong>Querystring:</strong> <code>returnUrl</code> (opcional). Se usa para volver a la pantalla anterior.</li>
                    <li><strong>Método:</strong> <code>Regresar()</code> decodifica <code>returnUrl</code> y navega; si no existe, vuelve a <code>/Stock-index</code>.</li>
                </ul>

                <h6 class="text-info mt-3"><i class="fas fa-arrows-alt-h"></i> Acciones UI (Front → Componentes)</h6>
                <ul>
                    <li><strong>X Depósito + Ajustes:</strong> abre modal local (tabla de depósitos) y desde allí dispara <code>StockAjustesFormModal</code> / <code>StockAjustesTrazablesFormModal</code>.</li>
                    <li><strong>Transferencias:</strong> abre <code>StockTransferenciaModal</code> (componente Blazor).</li>
                    <li><strong>Histórico:</strong> abre modal con <code>HistoricoMovimientosComponent</code>.</li>
                </ul>

                <h6 class="text-info mt-3"><i class="fas fa-database"></i> Carga de datos principal (Front)</h6>
                <p>
                    El método <code>OnParametersSetAsync()</code> es el orquestador principal. Flujo:
                </p>
                <ol>
                    <li><strong>Producto:</strong> <code>CargarProductoAsync()</code> (obtiene datos base de <code>Master</code> y asigna <code>producto</code>).</li>
                    <li><strong>DTO para acciones:</strong> <code>repuestoSeleccionado = BuildRepuestoSeleccionado()</code> (arma <code>ProductoConSaldoDTO</code> con cod/descr/umed).</li>
                    <li><strong>Existencias:</strong> <code>CargarExistenciasAsync()</code> (depósitos + stock por depósito) y calcula <code>SALSTO</code>.</li>
                    <li><strong>Bloques pendientes:</strong>
                        <ul>
                            <li><code>CargarRecepcionesPendientesAsync()</code> → acumula <code>TORECEP</code></li>
                            <li><code>CargarPedidosPendientesAsync()</code> → acumula <code>TOPEDID</code></li>
                            <li><code>CargarComprasPendientesAsync()</code> → acumula <code>TOCOMPR</code></li>
                            <li><code>CargarFabricacionPendienteAsync()</code> → acumula <code>TOFABRI</code></li>
                            <li><code>CargarReservasPendientesAsync()</code> → acumula <code>TORESER</code> (con conversión GK/1000 cuando aplica)</li>
                            <li><code>CargarTercerosPendientesAsync()</code> → acumula <code>STOTER</code> y <code>TORESER_TERC</code></li>
                        </ul>
                    </li>
                    <li><strong>Stock Proyectado:</strong> <code>RecalcularStockProyectado()</code> arma filas y recalcula acumulado proyectado.</li>
                </ol>

                <h6 class="text-info mt-3"><i class="fas fa-sitemap"></i> Endpoints utilizados (Front → API)</h6>
                <ul>
                    <li><strong>Producto (Master):</strong> <code>GET api/master/{Codint}</code> (ver método de carga en este Razor).</li>
                    <li><strong>Ubicaciones del producto (UBICASQL):</strong> <code>GET api/ubicasql/por-producto/{Codint}</code> → <code>List&lt;string&gt;</code></li>
                    <li><strong>Existencias por depósito:</strong>
                        <ul>
                            <li><code>GET api/tadeposi/SoloCodigos</code> (lista de depósitos)</li>
                            <li><code>GET api/tadeposi/combo</code> (descripción de depósitos)</li>
                            <li><code>GET api/movisto/stock/{Codint}</code> (stock por depósito)</li>
                        </ul>
                    </li>
                    <li><strong>Reservas:</strong> <code>GET api/reservas/pendientes-por-producto/{Codint}</code> → DTO <code>StockReservaPendienteDTO</code></li>
                    <li><strong>Terceros/Consignación:</strong> <code>GET api/maconsig/terceros-pendientes-por-producto/{Codint}</code> → DTO <code>StockTercerosPendienteDTO</code></li>
                    <li><strong>Órdenes de fabricación:</strong> <code>GET api/ordefabr/pendientes-por-producto/{Codint}</code> → DTO <code>StockFabricacionPendienteDTO</code></li>
                    <li><strong>Pedidos de venta:</strong> <code>GET api/peddeta/pendientes-por-producto/{Codint}</code> → DTO <code>StockPedidoPendienteDTO</code></li>
                    <li><strong>Recepciones pendientes:</strong> <code>GET api/bolrecep/pendientes-por-producto/{Codint}</code> → DTO <code>StockRecepcionPendienteDTO</code></li>
                    <li><strong>Compras pendientes:</strong> <code>GET api/ocomdeta/pendientes-por-producto/{Codint}</code> → DTO <code>StockCompraPendienteDTO</code></li>
                    <li><strong>Trazabilidad (para ajuste):</strong> <code>GET api/masterfunciones/funcionesAtributos/{Codint}</code> → DTO <code>MasterFuncionesDTO</code></li>
                </ul>

                <h6 class="text-info mt-3"><i class="fas fa-wrench"></i> Puntos de intervención (mantenimiento futuro)</h6>
                <ul>
                    <li><strong>Modificar métricas:</strong> revisar propiedades calculadas en este Razor (<code>StoProp</code>, <code>StoNet</code>, <code>StoDis</code>, <code>StoFal</code>, etc.).</li>
                    <li><strong>Modificar grilla Stock Proyectado:</strong> revisar <code>RecalcularStockProyectado()</code> y los métodos <code>Cargar*</code> que agregan filas.</li>
                    <li><strong>Modificar origen de datos de un bloque:</strong> revisar el endpoint del controller correspondiente (Server/Controllers) y el DTO (Shared/DTOs).</li>
                    <li><strong>Ajustes/Transferencias/Histórico:</strong> revisar componentes en <code>Client/Pages/Stock</code>:
                        <ul>
                            <li><code>StockTransferenciaModal.razor</code></li>
                            <li><code>HistoricoMovimientosComponent.razor</code></li>
                            <li><code>Client/Pages/StockAjustes/*</code> (formularios de ajuste)</li>
                        </ul>
                    </li>
                </ul>
            </InstructivoDesarrollador>
        </div>
    </div>

</div>

