        producto = null;
        existencias = new List<ExistenciaRow>();
        stockProyectado = new List<StockProyectadoRow>();
        ubicacionesProducto = new List<UbicacionProductoDTO>();
        repuestoSeleccionado = null;
        SALSTO = 0;
        TORECEP = 0;
        TOPEDID = 0;
        TOCOMPR = 0;
        TOFABRI = 0;
        TORESER = 0;
        TORESER_TERC = 0;
        STOTER = 0;
       
    }

