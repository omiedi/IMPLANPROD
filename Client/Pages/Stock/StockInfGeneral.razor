    // ===================================================================
    // MÉTODOS PARA ACCESOS DIRECTOS (ANOTADOR DE PEDIDOS)
    // Replica la misma funcionalidad que /Stock-index: abre un modal con
    // buscador de pedidos (PEDENCA), y al seleccionar uno navega al
    // anotador de pedidos (/anotaciones-pedido/{nroPedido}).
    // Al volver, reabre el modal automáticamente gracias al query param
    // abrirAccesosDirectos=true.
    // ===================================================================

    private void AbrirAccesosDirectos()
    {
        mostrarModalAccesosDirectos = true;
        filtroPedidosAccesosDirectos = string.Empty;
        pedidosAccesosDirectos = new List<Pedenca>();
    }

    private void CerrarAccesosDirectos()
    {
        mostrarModalAccesosDirectos = false;
        filtroPedidosAccesosDirectos = string.Empty;
        pedidosAccesosDirectos = new List<Pedenca>();
    }

    private async Task BuscarPedidosAccesosDirectos()
    {
        try
        {
            cargandoPedidosAccesosDirectos = true;

            var filtro = Uri.EscapeDataString(filtroPedidosAccesosDirectos ?? string.Empty);
            var url = $"api/pedenca?page=1&recordsNumber=50&filter={filtro}";

            var response = await repository.Get<List<Pedenca>>(url);
            if (!response.Error && response.Response != null)
            {
                pedidosAccesosDirectos = response.Response;
            }
            else
            {
                pedidosAccesosDirectos = new List<Pedenca>();
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al buscar pedidos: {ex.Message}", SweetAlertIcon.Error);
            pedidosAccesosDirectos = new List<Pedenca>();
        }
        finally
        {
            cargandoPedidosAccesosDirectos = false;
        }
    }

    private void VerAnotadorPedido(int nroPedido)
    {
        CerrarAccesosDirectos();

        // Construir la URL de retorno a /StockInfGeneral preservando el Codint y el returnUrl original.
        var urlVolver = $"/StockInfGeneral/{Codint}?abrirAccesosDirectos=true";
        if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            urlVolver += $"&returnUrl={Uri.EscapeDataString(returnUrl)}";
        }
        var encodedReturnUrl = Uri.EscapeDataString(urlVolver);
        NavigationManager.NavigateTo($"/anotaciones-pedido/{nroPedido}?returnUrl={encodedReturnUrl}");
    }
