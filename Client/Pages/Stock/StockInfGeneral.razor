    private async Task GuardarNuevaUbicacionAsync()
    {
        var texto = (nuevaUbicacionTexto ?? string.Empty).Trim();
        if (Codint <= 0 || string.IsNullOrWhiteSpace(texto))
        {
            return;
        }

        var textoNormalized = texto.Trim().ToUpperInvariant();
        var existenteActiva = (ubicacionesProducto ?? new List<UbicacionProductoDTO>())
            .FirstOrDefault(x => (x.Codiubica ?? string.Empty).Trim().ToUpperInvariant() == textoNormalized);
        if (existenteActiva != null)
        {
            await sweetAlertService.FireAsync(
                "Atención",
                $"La ubicación '{texto}' ya existe para este código.",
                SweetAlertIcon.Warning);
            return;
        }

        if (ubicacionesProductoBaja == null)
        {
            await CargarUbicacionesProductoBajaAsync();
        }

        var existenteBaja = (ubicacionesProductoBaja ?? new List<UbicacionProductoDTO>())
            .FirstOrDefault(x => (x.Codiubica ?? string.Empty).Trim().ToUpperInvariant() == textoNormalized);
        if (existenteBaja != null)
        {
            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Ubicación existente",
                Text = $"La ubicación '{texto}' ya existe pero está dada de baja. ¿Desea restaurarla?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                CancelButtonText = "No",
                ConfirmButtonText = "Si"
            });

            var confirm = string.IsNullOrEmpty(result.Value);
            if (confirm)
            {
                return;
            }

            await RestaurarUbicacionAsync(existenteBaja);
            CerrarModalNuevaUbicacion();
            return;
        }

        try
        {
            var dto = new UbicacionProductoCreateDTO
            {
                CodInte = Codint,
                Codiubica = texto
            };

            var response = await repository.Post<UbicacionProductoCreateDTO, UbicacionProductoDTO>("api/ubicasql", dto);
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo agregar la ubicación", SweetAlertIcon.Error);
                return;
            }

            CerrarModalNuevaUbicacion();
            await CargarUbicacionesProductoAsync();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

