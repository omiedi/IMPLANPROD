    private async Task GuardarNuevaUbicacionAsync()
    {
        var texto = (nuevaUbicacionTexto ?? string.Empty).Trim();
        if (Codint <= 0 || string.IsNullOrWhiteSpace(texto))
        {
            return;
        }

        var textoNormalized = texto.Trim().ToUpperInvariant();
        var existenteActiva = (ubicacionesProducto ?? new List<UbicacionProductoDTO>())
            .FirstOrDefault(x => (x.Codiubica ?? string.Empty).Trim().ToUpperInvariant() == textoNormalized);
        if (existenteActiva != null)
        {
            await sweetAlertService.FireAsync(
                "Atención",
                $"La ubicación '{texto}' ya existe para este código.",
                SweetAlertIcon.Warning);
            return;
        }

        if (ubicacionesProductoBaja == null)
        {
            await CargarUbicacionesProductoBajaAsync();
        }

        var existenteBaja = (ubicacionesProductoBaja ?? new List<UbicacionProductoDTO>())
            .FirstOrDefault(x => (x.Codiubica ?? string.Empty).Trim().ToUpperInvariant() == textoNormalized);
        if (existenteBaja != null)
        {
            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Ubicación existente",
                Text = $"La ubicación '{texto}' ya existe pero está dada de baja. ¿Desea restaurarla?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                CancelButtonText = "No",
                ConfirmButtonText = "Si"
            });

            var confirm = string.IsNullOrEmpty(result.Value);
            if (confirm)
            {
                return;
            }

            await RestaurarUbicacionAsync(existenteBaja);
            CerrarModalNuevaUbicacion();
            return;
        }

        try
        {
            var dto = new UbicacionProductoCreateDTO
            {
                CodInte = Codint,
                Codiubica = texto
            };

            var response = await repository.Post<UbicacionProductoCreateDTO, UbicacionProductoDTO>("api/ubicasql", dto);
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo agregar la ubicación", SweetAlertIcon.Error);
                return;
            }

            CerrarModalNuevaUbicacion();
            await CargarUbicacionesProductoAsync();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

    private async Task EliminarUbicacionAsync(UbicacionProductoDTO ubicacion)
    {
        if (ubicacion == null || ubicacion.Id <= 0)
        {
            return;
        }

        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = $"¿Realmente deseas eliminar la ubicación '{ubicacion.Codiubica}'?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si"
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        try
        {
            var response = await repository.Put<object>($"api/ubicasql/baja/{ubicacion.Id}", new { });
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo eliminar la ubicación", SweetAlertIcon.Error);
                return;
            }

            await CargarUbicacionesProductoAsync();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

    private void RecalcularStockProyectado()
    {
        var ho = DateTime.Now.ToString("dd/MM/yy");

        stockProyectado ??= new List<StockProyectadoRow>();
        stockProyectado.Clear();

        var obser = string.Empty;
        if (StoProp < 0m)
        {
            obser = "!!! Negativo !!!";
        }
        else if (StoProp < Stomin)
        {
            obser = "Sub-Mínimo";
        }

        stockProyectado.Add(new StockProyectadoRow
        {
            Comprobante = string.Empty,
            Referencia = $"Stock Propio al {ho}",
            Entra = 0m,
            Sale = 0m,
            Proyectado = StoProp,
            Fecha = ho,
            Observaciones = obser,
            FechaOrden = "19800101"
        });

        SALSTO = StoTot;

        foreach (var recep in (recepcionesPendientes ?? new List<StockRecepcionPendienteDTO>()))
        {
            var fecha = recep.FechaRecepcion == DateTime.MinValue
                ? string.Empty
                : recep.FechaRecepcion.ToString("dd/MM/yy");
            var fechaOrden = recep.FechaRecepcion == DateTime.MinValue
                ? string.Empty
                : recep.FechaRecepcion.ToString("yyyyMMdd");

            stockProyectado.Add(new StockProyectadoRow
            {
                Comprobante = $"BR.{recep.Numebore:000000}",
                Referencia = recep.Proveedor,
                Entra = recep.CantPendiente,
                Sale = 0m,
                Proyectado = 0m,
                Fecha = fecha,
                Observaciones = $"RT.{recep.RemitoProveedor}",
                FechaOrden = fechaOrden
            });
        }

        // Recepciones pendientes de aprobación (BRECEPEN)
        foreach (var recepAprob in (recepcionesPendientesAprobacion ?? new List<StockRecepcionPendienteAprobacionDTO>()))
        {
            var fecha = recepAprob.FechaRecepcion == DateTime.MinValue
                ? string.Empty
                : recepAprob.FechaRecepcion.ToString("dd/MM/yy");
            var fechaOrden = recepAprob.FechaRecepcion == DateTime.MinValue
                ? string.Empty
                : recepAprob.FechaRecepcion.ToString("yyyyMMdd");

            var observaciones = $"RT.{recepAprob.RemitoProveedor}";
            if (!string.IsNullOrWhiteSpace(recepAprob.Lote))
            {
                observaciones += $" | Lote: {recepAprob.Lote}";
            }

            stockProyectado.Add(new StockProyectadoRow
            {
                Comprobante = $"PA.{recepAprob.Numebore}",
                Referencia = $"{recepAprob.Proveedor} (Pend. Aprob.)",
                Entra = recepAprob.CantPendiente,
                Sale = 0m,
                Proyectado = 0m,
                Fecha = fecha,
                Observaciones = observaciones,
                FechaOrden = fechaOrden
            });
        }

        foreach (var ter in (tercerosPendientes ?? new List<StockTercerosPendienteDTO>()))
        {
            if (ter.CapenRendir > 0m)
            {
                var refe = $"Pendiente de rendir por {ter.Proveedor}";
                stockProyectado.Add(new StockProyectadoRow
                {
                    Comprobante = "RC",
                    Referencia = refe,
                    Entra = ter.CapenRendir,
                    Sale = 0m,
                    Proyectado = 0m,
                    Fecha = DateTime.Today.ToString("dd/MM/yy"),
                    Observaciones = string.Empty,
                    FechaOrden = DateTime.Today.ToString("yyyyMMdd")
                });
            }

            if (ter.CapenEntregar >= 0.05m)
            {
                if ((ter.StatOcom ?? -1) < 8 && (ter.StatOcom ?? -1) >= 0)
                {
                    var refe = ter.Proveedor;
                    var fex = ter.FechaEmisionOcom?.Date;
                    var fecha = fex.HasValue ? fex.Value.ToString("dd/MM/yy") : string.Empty;
                    var fechaOrden = fex.HasValue ? fex.Value.ToString("yyyyMMdd") : string.Empty;
                    var ocom = (ter.Ocom ?? string.Empty);
                    stockProyectado!.Add(new StockProyectadoRow
                    {
                        Comprobante = ocom.Length > 12 ? ocom.Substring(0, 12) : ocom,
                        Referencia = refe,
                        Entra = 0m,
                        Sale = ter.CapenEntregar,
                        Proyectado = 0m,
                        Fecha = fecha,
                        Observaciones = string.Empty,
                        FechaOrden = fechaOrden
                    });
                }
            }
        }

        var hoy = DateTime.Today;
        foreach (var pedido in (pedidosPendientes ?? new List<StockPedidoPendienteDTO>()))
        {
            var fechaSolEnt = pedido.FechaSolEnt?.Date;
            var fecha = fechaSolEnt.HasValue
                ? fechaSolEnt.Value.ToString("dd/MM/yy")
                : string.Empty;
            var fechaOrden = fechaSolEnt.HasValue
                ? fechaSolEnt.Value.ToString("yyyyMMdd")
                : string.Empty;

            var obserPed = string.Empty;
            if (fechaSolEnt.HasValue && fechaSolEnt.Value < hoy)
            {
                var atras = (hoy - fechaSolEnt.Value).Days;
                obserPed = $"Atr.{atras} Ds.";
            }
            if (pedido.SalPreparado > 0m)
            {
                if (!string.IsNullOrWhiteSpace(obserPed))
                {
                    obserPed += "/ ";
                }
                obserPed += $"Pr.{pedido.SalPreparado:N0}";
            }

            stockProyectado.Add(new StockProyectadoRow
            {
                Comprobante = $"PD.{pedido.NroPed:000000}",
                Referencia = pedido.Cliente,
                Entra = 0m,
                Sale = pedido.CantPendiente,
                Proyectado = 0m,
                Fecha = fecha,
                Observaciones = obserPed,
                FechaOrden = fechaOrden
            });
        }

        foreach (var compra in (comprasPendientes ?? new List<StockCompraPendienteDTO>()))
        {
            var fechaEnt = compra.FechaEntregaSolicitada?.Date;
            var fecha = fechaEnt.HasValue
                ? fechaEnt.Value.ToString("dd/MM/yy")
                : string.Empty;
            var fechaOrden = fechaEnt.HasValue
                ? fechaEnt.Value.ToString("yyyyMMdd")
                : string.Empty;

            var obserOc = string.Empty;
            if (fechaEnt.HasValue && fechaEnt.Value < hoy)
            {
                var atras = (hoy - fechaEnt.Value).Days;
                obserOc = $"Atr.{atras} Ds.";
            }

            stockProyectado.Add(new StockProyectadoRow
            {
                Comprobante = $"OC.{compra.NumeOcom:000000}",
                Referencia = compra.Proveedor,
                Entra = compra.CantPendiente,
                Sale = 0m,
                Proyectado = 0m,
                Fecha = fecha,
                Observaciones = obserOc,
                FechaOrden = fechaOrden
            });
        }

        foreach (var of in (fabricacionPendiente ?? new List<StockFabricacionPendienteDTO>()))
        {
            var fechaBase = of.FechaEntregaSolicitada?.Date;
            var fechaMostrar = fechaBase;
            var obserOf = string.Empty;

            if (of.FechaProyectadaEntrega.HasValue)
            {
                fechaMostrar = of.FechaProyectadaEntrega.Value.Date;

                if (of.FechaRecalculo.HasValue)
                {
                    obserOf = $"Calc.{of.FechaRecalculo.Value:dd/MM/yy}";
                }
            }
            else if (fechaBase.HasValue && fechaBase.Value < hoy)
            {
                var atras = (hoy - fechaBase.Value).Days;
                obserOf = $"Atr.{atras} Ds.";
            }

            var fecha = fechaMostrar.HasValue
                ? fechaMostrar.Value.ToString("dd/MM/yy")
                : string.Empty;
            var fechaOrden = fechaMostrar.HasValue
                ? fechaMostrar.Value.ToString("yyyyMMdd")
                : string.Empty;

            stockProyectado.Add(new StockProyectadoRow
            {
                Comprobante = $"OF.{of.NumeOrfa:000000}",
                Referencia = of.Referencia,
                Entra = of.CantPendiente,
                Sale = 0m,
                Proyectado = 0m,
                Fecha = fecha,
                Observaciones = obserOf,
                FechaOrden = fechaOrden
            });
        }

        // FABRICACIONES PENDIENTES DE APROBACION (ORFAPEN, CodiMovi = 'OF')
        foreach (var ofPend in (fabricacionPendienteAprobacion ?? new List<StockFabricacionPendienteAprobacionDTO>()))
        {
            var dopri = ofPend.DoPriCor ?? string.Empty;
            var comprobante = dopri.Length > 12 ? dopri.Substring(0, 12) : dopri;

            stockProyectado.Add(new StockProyectadoRow
            {
                Comprobante = comprobante,
                Referencia = ofPend.Referencia,
                Entra = ofPend.CantPendiente,
                Sale = 0m,
                Proyectado = 0m,
                Fecha = DateTime.Today.ToString("dd/MM/yy"),
                Observaciones = "PEND. APROBACION",
                FechaOrden = DateTime.Today.ToString("yyyyMMdd")
            });
        }

        var esGk = string.Equals(producto?.Umedida, "GK", StringComparison.OrdinalIgnoreCase);
        foreach (var res in (reservasPendientes ?? new List<StockReservaPendienteDTO>()))
        {
            var capen = res.CantPendiente;
            if (esGk)
            {
                capen = capen / 1000m;
            }

            if (Math.Abs(capen) <= 0m)
            {
                continue;
            }

            var fechaEnt = res.FechaEntregaSolicitada?.Date;
            var fecha = fechaEnt.HasValue
                ? fechaEnt.Value.ToString("dd/MM/yy")
                : string.Empty;
            var fechaOrden = fechaEnt.HasValue
                ? fechaEnt.Value.ToString("yyyyMMdd")
                : string.Empty;

            var obserRes = string.Empty;
            if (!string.IsNullOrWhiteSpace(res.IdenLote))
            {
                obserRes = $"Lote {res.IdenLote}";
            }

            if (fechaEnt.HasValue && fechaEnt.Value < hoy)
            {
                var atras = (hoy - fechaEnt.Value).Days;
                obserRes = $"Atr.{atras} Ds.";
            }

            var destin = res.IdSubOr;
            if (!string.IsNullOrWhiteSpace(res.CodExteDestino) || !string.IsNullOrWhiteSpace(res.DescripDestino))
            {
                destin = $"{res.CodExteDestino} - {res.DescripDestino}".Trim();
            }

            var refe = $"Reserva p/{destin}";
            if ((res.IdSubOr ?? string.Empty).StartsWith("OR", StringComparison.OrdinalIgnoreCase))
            {
                refe = "Reserva p/Reparación";
            }

            stockProyectado.Add(new StockProyectadoRow
            {
                Comprobante = (res.IdSubOr ?? string.Empty).Length > 12 ? (res.IdSubOr ?? string.Empty).Substring(0, 12) : (res.IdSubOr ?? string.Empty),
                Referencia = refe,
                Entra = 0m,
                Sale = capen,
                Proyectado = 0m,
                Fecha = fecha,
                Observaciones = obserRes,
                FechaOrden = fechaOrden
            });
        }

        if (stockProyectado.Count > 1)
        {
            var firstRow = stockProyectado[0];
            var rest = stockProyectado
                .Skip(1)
                .OrderBy(r => string.IsNullOrWhiteSpace(r.FechaOrden) ? "99999999" : r.FechaOrden)
                .ThenBy(r => r.Comprobante)
                .ToList();

            stockProyectado.Clear();
            stockProyectado.Add(firstRow);
            stockProyectado.AddRange(rest);
        }

        if (stockProyectado.Count > 0)
        {
            var stopro = stockProyectado[0].Proyectado;
            stockProyectado[0].Proyectado = stopro;

            for (var i = 1; i < stockProyectado.Count; i++)
            {
                stopro += stockProyectado[i].Entra - stockProyectado[i].Sale;
                stockProyectado[i].Proyectado = stopro;
            }
        }
    }

