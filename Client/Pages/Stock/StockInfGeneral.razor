    private async Task CargarRecepcionesPendientesAsync()
    {
        recepcionesPendientes = new List<StockRecepcionPendienteDTO>();
        TORECEP = 0m;

        if (Codint <= 0)
        {
            return;
        }

        try
        {
            var response = await repository.Get<List<StockRecepcionPendienteDTO>>($"api/BolRecep/pendientes-por-producto/{Codint}");
            if (response.Error || response.Response == null)
            {
                return;
            }

            recepcionesPendientes = response.Response
                .Where(x => x.CantPendiente > 0m)
                .OrderBy(x => x.Numebore)
                .ToList();

            TORECEP = recepcionesPendientes.Sum(x => x.CantPendiente);
        }
        catch
        {
            recepcionesPendientes = new List<StockRecepcionPendienteDTO>();
            TORECEP = 0m;
        }
    }

    private async Task CargarRecepcionesPendientesAprobacionAsync()
    {
        recepcionesPendientesAprobacion = new List<StockRecepcionPendienteAprobacionDTO>();

        if (Codint <= 0)
        {
