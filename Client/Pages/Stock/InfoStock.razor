@page "/info-stock"
@attribute [Authorize]
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Client.Pages.Reportes
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@inject IRepository repository
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject SweetAlertService sweetAlertService

<PageTitle>InfoStock</PageTitle>

@*
    Reporte de Stock (InfoStock)
    - Stock por depósito: MOVISTO filtrado por DepoMovi = depósito elegido.
    - Inventario General: todos los depósitos, opcionalmente excluyendo los
      no disponibles (TADEPOSI.Disponible = 0) vía NOT IN.
    - Saldo = Σ(CantIngre − CantSalid). Fuente: GET api/movisto/stock-deposito/{depo}
      y GET api/movisto/inventario-general?incluirNoDisponibles={bool}.
    - "Detener consulta" aborta el request con CancellationToken.
*@

<div class="container-fluid">
    <div class="mb-3">
        <h3 class="text-center fw-bold text-primary">
            <i class="fas fa-chart-bar me-2"></i>
            REPORTE DE STOCK
        </h3>
        <hr class="border-primary border-2 opacity-50" />
    </div>

    @* Barra de acciones *@
    <div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-3 d-flex flex-wrap gap-2 align-items-center">
        <button type="button" class="btn btn-primary" @onclick="AbrirSelectorDepositos" disabled="@consultando">
            <i class="fas fa-warehouse me-1"></i> Depósito: @(depositoSeleccionado > 0 ? $"{depositoSeleccionado} - {descripcionDeposito}" : "Seleccionar")
        </button>

        <button type="button" class="btn btn-outline-primary" title="Repetir la última consulta"
                @onclick="RefrescarReporte" disabled="@(consultando || string.IsNullOrEmpty(ultimaUrlConsulta))">
            <i class="oi oi-reload"></i> Refrescar
        </button>

        <button type="button" class="btn btn-secondary" title="stock de todos los depositos"
                @onclick="ConsultarInventarioGeneral" disabled="@consultando">
            <i class="fas fa-globe me-1"></i> Inventario General
        </button>

        @* Reporte "Stock < 0": códigos con saldo negativo en MOVISTO
           (Σ CantIngre − CantSalid, nulos como 0). General = todos los
           depósitos; Por Depósito = MOVISTO.DepoMovi = depósito elegido. *@
        <div class="dropdown">
            <button type="button" class="btn btn-danger dropdown-toggle" data-bs-toggle="dropdown"
                    title="reportes con stock negativo" disabled="@consultando">
                <i class="fas fa-exclamation-triangle me-1"></i> Stock &lt; 0
            </button>
            <ul class="dropdown-menu">
                <li>
                    <button type="button" class="dropdown-item" @onclick="ConsultarStockNegativoGeneral">
                        <i class="fas fa-globe me-1"></i> General
                    </button>
                </li>
                <li>
                    <button type="button" class="dropdown-item" @onclick="AbrirSelectorDepositosNegativo">
                        <i class="fas fa-warehouse me-1"></i> Por Depósito
                    </button>
                </li>
            </ul>
        </div>

        @if (consultando)
        {
            <button type="button" class="btn btn-danger" @onclick="DetenerConsulta">
                <i class="oi oi-media-stop"></i> Detener consulta
            </button>
        }

        <button type="button" class="btn btn-success ms-auto" @onclick="MostrarImpresion"
                disabled="@(consultando || items.Count == 0)">
            <i class="oi oi-print"></i> Imprimir/Exp. Excel
        </button>
    </div>

    @* Filtro código/descripción combinado con '+' (mismo criterio que /Stock-index) *@
    <div class="d-flex align-items-center gap-2 mb-2">
        <input type="text" class="form-control" style="min-width: 10cm; width: 10cm;"
               placeholder="Filtrar x código y/o descrip..."
               @bind-value="filtroTexto" @bind-value:event="oninput" @onkeyup="AlFiltrar" />
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LimpiarFiltro">Limpiar</button>
    </div>
    <div class="text-muted" style="font-size: 0.8rem;">
        Podés combinar términos con <b>+</b> para exigir coincidencia de ambos (AND). Ej: <code>858 + ADAPTADOR</code>
    </div>

    @* Título del reporte generado *@
    @if (!string.IsNullOrEmpty(tituloReporte))
    {
        <div class="alert alert-info py-2 mt-2 mb-2">
            <strong>@tituloReporte</strong>
            <span class="ms-2 text-muted">(@itemsFiltrados.Count() ítems)</span>
        </div>
    }

    @if (consultando)
    {
        <div class="d-flex align-items-center gap-2 my-3">
            <div class="spinner-border text-primary" role="status"></div>
            <span class="text-muted">Consultando MOVISTO... puede tardar en bases grandes.</span>
        </div>
    }

    @* Tabla de resultados: fuente reducida, 20 registros por página *@
    @if (items.Count > 0)
    {
        <Pagination CurrentPage="paginaActual" TotalPages="TotalPaginas" SelectedPage="SeleccionarPagina" />

        <table class="table table-striped table-bordered table-sm" style="font-size: 0.75rem;">
            <thead class="table-dark">
                <tr>
                    <th style="width: 2.5cm;">Código</th>
                    <th>Descripción</th>
                    <th style="width: 1.5cm;">U.Med.</th>
                    <th style="width: 3cm;">T.Material</th>
                    <th class="text-end" style="width: 2.5cm;">Saldo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in itemsFiltrados.Skip((paginaActual - 1) * RegistrosPorPagina).Take(RegistrosPorPagina))
                {
                    <tr>
                        @* CodigoInterno (movisto.cod_inte) sigue en el DTO y se usa
                           en el filtro, pero no se muestra en la grilla *@
                        <td>@item.Codigo</td>
                        <td>@item.Descripcion</td>
                        <td>@item.UMedida</td>
                        <td>@item.TMaterial</td>
                        <td class="text-end">@item.Saldo.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (consultaEjecutada && !consultando)
    {
        <div class="alert alert-warning mt-3">
            <i class="fas fa-info-circle me-2"></i> La consulta no devolvió movimientos.
        </div>
    }
</div>

@* ── Modal selector de depósitos (filtro por nro o descripción) ────────── *@
@if (mostrarSelectorDepositos)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary bg-opacity-10">
                    <h5 class="modal-title text-primary m-0">Seleccionar Depósito</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarSelectorDepositos = false"></button>
                </div>
                <div class="modal-body">
                    <input type="text" class="form-control mb-2" placeholder="Filtrar por nro de depósito o descripción..."
                           @bind-value="filtroDeposito" @bind-value:event="oninput" />
                    <div style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover table-sm">
                            <thead class="table-light" style="position: sticky; top: 0;">
                                <tr>
                                    <th style="width: 2cm;">Nro</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var depo in DepositosFiltrados)
                                {
                                    <tr style="cursor: pointer;" @onclick="() => SeleccionarDeposito(depo)">
                                        <td>@depo.CodigoDepo</td>
                                        <td>@depo.Descripcion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* Modal de impresión/exportación (patrón ImpresionLista) *@
@if (mostrarImpresion)
{
    <ImpresionLista TItem="InfoStockDTO"
                    Datos="itemsFiltrados.ToList()"
                    Encabezados="encabezadosImpresion"
                    Titulo="@tituloReporte"
                    UrlExportarExcel="api/excel/exportar-info-stock"
                    MostrarModal="true"
                    OnCerrar="() => mostrarImpresion = false" />
}

@code {
    // ── Estado del reporte ──────────────────────────────────────────────
    private List<InfoStockDTO> items = new();
    private List<InfoStockDTO> itemsFiltrados = new();
    private string tituloReporte = string.Empty;
    private string ultimaUrlConsulta = string.Empty;
    private string ultimoTitulo = string.Empty;
    private bool consultaEjecutada = false;

    // Filtro código/descripción y paginación (20 por página)
    private string filtroTexto = string.Empty;
    private int paginaActual = 1;
    private const int RegistrosPorPagina = 20;
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(itemsFiltrados.Count / (double)RegistrosPorPagina));

    // Selector de depósitos
    private bool mostrarSelectorDepositos = false;
    private List<DepositoItem> depositos = new();
    private string filtroDeposito = string.Empty;
    private int depositoSeleccionado = 0;
    private string descripcionDeposito = string.Empty;
    // true = el selector se abrió desde "Stock < 0 / Por Depósito" (endpoint stock-negativo-deposito)
    private bool selectorParaStockNegativo = false;

    // Anti doble-clic + cancelación de la consulta
    private bool consultando = false;
    private CancellationTokenSource? consultaCts;

    // Impresión
    private bool mostrarImpresion = false;
    private Dictionary<string, string> encabezadosImpresion = new()
    {
        { "CodigoInterno", "Cód.Int." },
        { "Codigo", "Código" },
        { "Descripcion", "Descripción" },
        { "UMedida", "U.Med." },
        { "TMaterial", "T.Material" },
        { "Saldo", "Saldo" }
    };

    /// <summary>Depósito simple para el selector (nro + descripción)</summary>
    private class DepositoItem
    {
        public int CodigoDepo { get; set; }
        public string Descripcion { get; set; } = string.Empty;
    }

    /// <summary>Depósitos filtrados por nro o descripción</summary>
    private IEnumerable<DepositoItem> DepositosFiltrados
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filtroDeposito))
            {
                return depositos;
            }
            var term = filtroDeposito.Trim().ToLower();
            return depositos.Where(d =>
                d.CodigoDepo.ToString().Contains(term) ||
                d.Descripcion.ToLower().Contains(term));
        }
    }

    /// <summary>Carga inicial: lista de depósitos activos para el selector</summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await repository.Get<Dictionary<int, string>>("api/tadeposi/combo");
            if (!response.Error && response.Response != null)
            {
                depositos = response.Response
                    .Select(kv => new DepositoItem
                    {
                        CodigoDepo = kv.Key,
                        // El combo devuelve "N - Descripción"; se quita el prefijo
                        Descripcion = kv.Value.Contains('-') ? kv.Value[(kv.Value.IndexOf('-') + 1)..].Trim() : kv.Value
                    })
                    .OrderBy(d => d.CodigoDepo)
                    .ToList();
            }
        }
        catch
        {
            // El selector vuelve a intentar cargar al abrirse
        }
    }

    /// <summary>Abre el selector de depósitos (reporte de stock por depósito)</summary>
    private void AbrirSelectorDepositos()
    {
        selectorParaStockNegativo = false;
        filtroDeposito = string.Empty;
        mostrarSelectorDepositos = true;
    }

    /// <summary>Abre el selector de depósitos para el reporte "Stock &lt; 0"</summary>
    private void AbrirSelectorDepositosNegativo()
    {
        selectorParaStockNegativo = true;
        filtroDeposito = string.Empty;
        mostrarSelectorDepositos = true;
    }

    /// <summary>Stock &lt; 0 general: saldo negativo sumando todos los depósitos</summary>
    private async Task ConsultarStockNegativoGeneral()
    {
        depositoSeleccionado = 0;
        descripcionDeposito = string.Empty;

        await EjecutarConsulta(
            "api/movisto/stock-negativo-general",
            "Stock Negativo - General (todos los depósitos)");
    }

    /// <summary>
    /// Al elegir depósito se pide confirmación (Generar Reporte / Cancelar)
    /// y se ejecuta la consulta filtrada por MOVISTO.DepoMovi.
    /// </summary>
    private async Task SeleccionarDeposito(DepositoItem depo)
    {
        mostrarSelectorDepositos = false;

        var conf = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = $"Depósito {depo.CodigoDepo} - {depo.Descripcion}",
            Text = selectorParaStockNegativo
                ? "¿Generar el reporte de stock NEGATIVO para este depósito?"
                : "¿Generar el reporte de stock para este depósito?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Generar Reporte",
            CancelButtonText = "Cancelar",
            ConfirmButtonColor = "#198754",
            CancelButtonColor = "#6c757d"
        });

        if (!conf.IsConfirmed)
        {
            return;
        }

        depositoSeleccionado = depo.CodigoDepo;
        descripcionDeposito = depo.Descripcion;

        if (selectorParaStockNegativo)
        {
            await EjecutarConsulta(
                $"api/movisto/stock-negativo-deposito/{depo.CodigoDepo}",
                $"Stock Negativo del depósito {depo.CodigoDepo} - {depo.Descripcion}");
        }
        else
        {
            await EjecutarConsulta(
                $"api/movisto/stock-deposito/{depo.CodigoDepo}",
                $"Stock del depósito {depo.CodigoDepo} - {depo.Descripcion}");
        }
    }

    /// <summary>
    /// Repite la última consulta ejecutada (depósito o inventario general),
    /// pidiendo nuevamente confirmación.
    /// </summary>
    private async Task RefrescarReporte()
    {
        if (string.IsNullOrEmpty(ultimaUrlConsulta))
        {
            return;
        }

        var conf = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Refrescar Reporte",
            Text = $"¿Generar nuevamente \"{ultimoTitulo}\"?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Generar Reporte",
            CancelButtonText = "Cancelar",
            ConfirmButtonColor = "#198754",
            CancelButtonColor = "#6c757d"
        });

        if (conf.IsConfirmed)
        {
            await EjecutarConsulta(ultimaUrlConsulta, ultimoTitulo);
        }
    }

    /// <summary>
    /// Inventario general: pregunta si incluir depósitos no disponibles.
    /// Incluir → sin filtro de DepoMovi; Solo disponibles → NOT IN(no disponibles).
    /// </summary>
    private async Task ConsultarInventarioGeneral()
    {
        var conf = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Inventario General",
            Text = "¿Incluir los depósitos NO disponibles en el reporte?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ShowDenyButton = true,
            ConfirmButtonText = "Incluir No Disponibles",
            DenyButtonText = "Solo Disponibles",
            CancelButtonText = "Cancelar",
            ConfirmButtonColor = "#198754",
            DenyButtonColor = "#0d6efd",
            CancelButtonColor = "#6c757d"
        });

        // Solo continúa si eligió alguna de las dos opciones de generación
        // (confirmar = incluir no disponibles, deny = solo disponibles, cancelar = abortar)
        if (!conf.IsConfirmed && !conf.IsDenied)
        {
            return;
        }

        bool incluirNoDisponibles = conf.IsConfirmed;
        depositoSeleccionado = 0;
        descripcionDeposito = string.Empty;

        await EjecutarConsulta(
            $"api/movisto/inventario-general?incluirNoDisponibles={incluirNoDisponibles.ToString().ToLower()}",
            incluirNoDisponibles
                ? "Inventario General (incluye Depósitos No Disponibles)"
                : "Inventario General (no incluye Depósitos No Disponibles)");
    }

    /// <summary>
    /// Ejecuta el GET del reporte. Anti doble-clic: si ya hay una consulta en
    /// curso se ignora; el flag + StateHasChanged/Task.Yield bloquean los botones
    /// antes de empezar el request.
    /// </summary>
    private async Task EjecutarConsulta(string url, string titulo)
    {
        if (consultando)
        {
            return;
        }

        consultando = true;
        consultaCts = new CancellationTokenSource();
        StateHasChanged();
        await Task.Yield();

        try
        {
            // GetAsync + lectura del body para mostrar el mensaje real del servidor
            // (GetFromJsonAsync descarta el body del error y solo informa el status)
            var response = await Http.GetAsync(url, consultaCts.Token);
            if (!response.IsSuccessStatusCode)
            {
                var detalle = await response.Content.ReadAsStringAsync();
                throw new Exception($"El servidor respondió {(int)response.StatusCode}: {detalle}");
            }

            var datos = await response.Content.ReadFromJsonAsync<List<InfoStockDTO>>();
            items = datos ?? new List<InfoStockDTO>();
            ultimaUrlConsulta = url;
            ultimoTitulo = titulo;
            tituloReporte = titulo;
            consultaEjecutada = true;
            paginaActual = 1;
            AplicarFiltro();
        }
        catch (OperationCanceledException)
        {
            // Usuario presionó "Detener consulta"
            await sweetAlertService.FireAsync("Consulta detenida", "La consulta fue cancelada.", SweetAlertIcon.Info);
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"No se pudo generar el reporte: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            consultando = false;
            consultaCts?.Dispose();
            consultaCts = null;
        }
    }

    /// <summary>Cancela la consulta en curso</summary>
    private void DetenerConsulta()
    {
        consultaCts?.Cancel();
    }

    /// <summary>Aplica el filtro código/descripción con combinación '+' (AND)</summary>
    private void AplicarFiltro()
    {
        IEnumerable<InfoStockDTO> query = items;

        if (!string.IsNullOrWhiteSpace(filtroTexto))
        {
            foreach (var term in filtroTexto.Split('+', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var t = term.ToLower();
                query = query.Where(x =>
                    (x.Codigo ?? string.Empty).ToLower().Contains(t) ||
                    (x.Descripcion ?? string.Empty).ToLower().Contains(t) ||
                    (x.CodigoInterno?.ToString() ?? string.Empty).Contains(t));
            }
        }

        itemsFiltrados = query.ToList();

        if (paginaActual > TotalPaginas)
        {
            paginaActual = TotalPaginas;
        }
    }

    private void AlFiltrar()
    {
        paginaActual = 1;
        AplicarFiltro();
    }

    private void LimpiarFiltro()
    {
        filtroTexto = string.Empty;
        paginaActual = 1;
        AplicarFiltro();
    }

    private void SeleccionarPagina(int pagina)
    {
        paginaActual = pagina;
    }

    private void MostrarImpresion()
    {
        mostrarImpresion = true;
    }
}
