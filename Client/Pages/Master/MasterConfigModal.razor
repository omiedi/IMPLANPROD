@using IMPLANPROD.Shared.Entities
@inject IRepository repository
@inject SweetAlertService sweetAlertService

@* Modal de configuración de Master *@
@if (IsVisible)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="oi oi-cog me-2"></i>Configuración de Master
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (cargandoConfiguracion)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 100px;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando configuración...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="card-title mb-0">
                                    <i class="oi oi-calculator me-2"></i>Configuración de Cálculos
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" 
                                           type="checkbox" 
                                           id="habilitarPorMiles"
                                           @bind="habilitarPorMiles" />
                                    <label class="form-check-label" for="habilitarPorMiles">
                                        <strong>Habilitar Por Miles</strong>
                                    </label>
                                    <div class="form-text">
                                        Cuando está habilitado, permite trabajar con cálculos por milésimas en los productos.
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        <i class="oi oi-x me-1"></i>Cancelar
                    </button>
                    <button type="button" 
                            class="btn btn-primary" 
                            @onclick="GuardarConfiguracion"
                            disabled="@(cargandoConfiguracion || guardandoConfiguracion)">
                        @if (guardandoConfiguracion)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        else
                        {
                            <i class="oi oi-check me-1"></i>
                        }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    /// <summary>
    /// Parámetros del componente
    /// </summary>
    [Parameter] public bool IsVisible { get; set; } = false;
    [Parameter] public EventCallback OnCloseRequested { get; set; }
    [Parameter] public EventCallback OnConfigurationSaved { get; set; }

    /// <summary>
    /// Variables de estado del componente
    /// </summary>
    private bool cargandoConfiguracion = false;
    private bool guardandoConfiguracion = false;
    private bool habilitarPorMiles = false;

    // Constantes para los parámetros de FLEXCRL según la lógica VB6
    // Equivalente a: Call GRACONTROL("AMASTO", "PORMILES", HABIPORMI%)
    private const string CLABUS_PARAM = "AMASTO";
    private const string PROBUS_PARAM = "PORMILES";

    /// <summary>
    /// Se ejecuta cuando el componente se inicializa
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await CargarConfiguracion();
    }

    /// <summary>
    /// Se ejecuta cuando los parámetros cambian
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Cargar configuración cuando el modal se abre
        if (IsVisible && !cargandoConfiguracion)
        {
            await CargarConfiguracion();
        }
    }

    /// <summary>
    /// Carga la configuración actual desde FLEXCRL
    /// Equivalente a: HABIPORMI% = XVALO(Control$("AMASTO", "PORMILES"))
    /// </summary>
    private async Task CargarConfiguracion()
    {
        try
        {
            cargandoConfiguracion = true;
            StateHasChanged();

            // Llamar al endpoint para obtener el control específico
            // Usar CLABUS y PROBUS según la lógica VB6
            var response = await repository.Get<FLEXCRL>($"api/flexcrl/{CLABUS_PARAM}/{PROBUS_PARAM}");

            if (response.Error)
            {
                // Si no existe el registro, se considera como "NO" (false)
                habilitarPorMiles = false;
            }
            else
            {
                var control = response.Response;
                // Verificar si el valor es "1" para establecer el checkbox
                // Equivalente a: If Check1.Value = 1 Then HABIPORMI% = 1
                var valor = control?.VALCONTROL?.Trim();
                habilitarPorMiles = valor == "1" || valor?.ToUpper() == "SI";
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar la configuración: {ex.Message}", SweetAlertIcon.Error);
            habilitarPorMiles = false;
        }
        finally
        {
            cargandoConfiguracion = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Guarda la configuración usando FLEXCRL
    /// Equivalente a la lógica VB6:
    /// HABIPORMI% = 0
    /// If Check1.Value = 1 Then HABIPORMI% = 1
    /// Call GRACONTROL("AMASTO", "PORMILES", HABIPORMI%)
    /// </summary>
    private async Task GuardarConfiguracion()
    {
        try
        {
            guardandoConfiguracion = true;
            StateHasChanged();

            // Determinar el valor a guardar según la lógica VB6
            // Equivalente a: HABIPORMI% = 0: If Check1.Value = 1 Then HABIPORMI% = 1
            string valorControl = habilitarPorMiles ? "1" : "0";

            // Crear el objeto para enviar al endpoint
            var configData = new
            {
                clabus = CLABUS_PARAM,
                probus = PROBUS_PARAM,
                valcontrol = valorControl
            };

            // Llamar al endpoint para actualizar o crear el control
            // Equivalente a: Call GRACONTROL("AMASTO", "PORMILES", HABIPORMI%)
            var response = await repository.Put("api/flexcrl", configData);

            if (response.Error)
            {
                var errorMessage = await response.GetErrorMessageAsync();
                throw new Exception($"Error al guardar configuración: {errorMessage}");
            }

            // Si llegamos aquí, la configuración se guardó exitosamente
            await sweetAlertService.FireAsync("Éxito", "Configuración guardada exitosamente.", SweetAlertIcon.Success);

            // Notificar que se guardó la configuración
            await OnConfigurationSaved.InvokeAsync();

            // Cerrar el modal
            await CerrarModal();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error inesperado al guardar la configuración: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            guardandoConfiguracion = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Cierra el modal y notifica al componente padre
    /// </summary>
    private async Task CerrarModal()
    {
        await OnCloseRequested.InvokeAsync();
    }
}
