@page "/master-index"
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Client.Pages.Reportes
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Shared.Components
@using Microsoft.AspNetCore.Components.Web
@inject IRepository repository
@using IMPLANPROD.Shared.DTOs
@inject NavigationManager NavigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS
@inject PageAccessService PageAccess

<PageTitle>Ficha de Productos</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
<!--
Componente: MasterIndex.razor
Descripción: Listado paginado de productos (Master) con opciones de edición y gestión.
Autor: IA Cascade (solicitud de Omar)
Fecha: 29/05/2025

Este componente sigue el estándar de páginas ABM definido en el proyecto.
Se muestran las columnas: Id, Código Interno, Código, Descripción, Unidad de Medida, Tipo Material.
Incluye paginación y botones para editar y crear nuevo producto.
Implementa el modelo de carga y paginación LoadAsync como el resto del sistema.
-->

<div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-3">
    <div class="d-flex align-items-center justify-content-between">
        <h3 class="m-0 text-primary">Lista de Productos</h3>
        <button type="button"
                class="btn btn-sm btn-outline-primary"
                title="Configuración de Master"
                @onclick="AbrirConfiguracionMaster">
            <i class="oi oi-cog"></i>
        </button>
    </div>
</div>

<div class="row mb-3">
    <div class="col">
        <button class="btn btn-primary" @onclick="NuevoProducto">
            <i class="oi oi-plus"></i> Nuevo Producto
        </button>
        <button class="btn btn-secondary" @onclick="ProductosBaja">
            <i class="oi oi-trash"></i> Productos dados de baja
        </button>
        <button class="btn btn-info" @onclick="AbrirConfiguracionSync">
            <i class="oi oi-cog"></i> Configuración Sincronización
        </button>
        @if (configSync != null && configSync.ProcesaRemitos && configSync.GeneraScriptSync)
        {
            <button class="btn btn-success me-2" @onclick="ProcesarSincronizacion" disabled="@isProcesandoSync">
                <i class="oi oi-reload"></i> Sincronizar Remitos
            </button>
        }
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Buscar por código o descripción..." @bind-value="Filter" @onkeyup="HandleKeyPress" />
            <button class="btn btn-outline-secondary" type="button" @onclick="ApplyFilterAsync">
                <i class="oi oi-magnifying-glass"></i> Buscar
            </button>
            <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
        </div>
    </div>
</div>

<div class="text-muted" style="font-size: 0.85rem; margin-top: -0.5rem;">
    Podés combinar términos con <b>+</b> para exigir coincidencia de ambos (AND). Ej: <code>TORN + acero</code>
</div>
<!-- Botón Imprimir alineado a la derecha -->
<div class="d-flex justify-content-end mb-3">
    <div>
        <button id="btnImprimirMaster" class="btn btn-outline-success" @onclick="ConfirmarImpresionAsync" disabled="@isPrinting">
            <i class="oi oi-print"></i> Imprimir/Exp.Excel
        </button>
    </div>

    @if (isPrinting)
    {
        <div class="ms-2 d-flex align-items-center">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Preparando impresión...</span>
            </div>
        </div>
    }
</div>

@if (isPrinting)
{
    <div class="spinner-border text-success ms-2" role="status">
        <span class="visually-hidden">Preparando impresión...</span>
    </div>
}

<SyncConfigModal MostrarModal="mostrarModalSync"
                 OnCerrar="CerrarModalSync"
                 OnGuardado="OnConfigSyncGuardada" />

<MasterConfigModal IsVisible="@mostrarModalConfigMaster"
                   OnCloseRequested="CerrarModalConfigMaster"
                   OnConfigurationSaved="OnConfigMasterGuardada" />

@if (masterListadoIndexDTO != null && masterListadoIndexDTO.Any())
{
    <ImpresionLista TItem="MasterListadoIndexDTO"
                    Datos="masterListadoIndexDTO"
                    Titulo="Reporte de Productos"
                    UrlExportarExcel="api/excel/exportar-masterlistado"
                    Encabezados="encabezadosProductos"
                    ModoDirecto="false"
                    MostrarModal="mostrarModalImpresion"
                    OnCerrar="ResetearImpresion" />

}


@if (Productos is null)
{
    <div class="spinner-border text-primary" role="status">
        <span class="sr-only">Cargando...</span>
    </div>
}
else
{
    <Pagination CurrentPage="currentPage"
    TotalPages="totalPages"
    SelectedPage="SelectedPageAsync" />


    <GenericList MyList="Productos">
        <Body>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Cód.Interno</th>
                        <th>Código</th>
                        <th>Descripción</th>
                        <th>U.Med.</th>
                        <th>T.Material</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in Productos!)
                    {
                        <tr>
                            <td>@producto.Id</td>
                            <td>@producto.Codint</td>
                            <td>@producto.Codigo</td>
                            <td>@producto.Descripcion</td>
                            <td>@producto.Umedida</td>
                            <td>@(TiposMaterial.FirstOrDefault(t => t.CodigoTatimat == producto.Timate)?.Descripcion ?? "-")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarProducto(producto.Id)">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarBajaProducto(producto)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>
    }
    }

@code {

    private List<Master> Productos = new();
    private List<Tatimat> TiposMaterial = new();
    private bool isLoading = true;
    private bool validando = true;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages;

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilterAsync();
        }
    }

    // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
    protected override async Task OnInitializedAsync()
    {
        await PageAccess.RequiereAccesoAsync("/master-index");
        validando = false;
        
        await LoadAsync();
    }

    private async Task LoadAsync(int page = 1)
    {
        try
        {
            isLoading = true;

            // Cargar tipos de material si no están cargados
            if (TiposMaterial.Count == 0)
            {
                var responseTatimat = await repository.Get<List<Tatimat>>("api/tipomaterial");
                if (responseTatimat.Response != null)
                {
                    TiposMaterial = responseTatimat.Response;
                }
            }

            if (!string.IsNullOrWhiteSpace(Page))
            {
                page = Convert.ToInt32(Page);
            }

            currentPage = page;
            string url1 = string.Empty;
            string url2 = string.Empty;
            if (string.IsNullOrEmpty(Filter))
            {
                url1 = $"api/master?page={page}";
                url2 = $"api/master/totalPages";
            }
            else
            {
                var encodedFilter = Uri.EscapeDataString(Filter);
                url1 = $"api/master?page={page}&filter={encodedFilter}";
                url2 = $"api/master/totalPages?filter={encodedFilter}";
            }
            var responseHttp = await repository.Get<List<Master>>(url1);
            var responseHttp2 = await repository.Get<int>(url2);

            if (responseHttp.Error)
            {
                await sweetAlertService.FireAsync("Error", await responseHttp.GetErrorMessageAsync(), SweetAlertIcon.Error);
            }
            else
            {
                Productos = responseHttp.Response!;
                totalPages = responseHttp2.Response!;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private void ProductosBaja()
    {
        NavigationManager.NavigateTo("/master-baja");
    }

    private async Task ApplyFilterAsync()
    {
        currentPage = 1;
        await LoadAsync(currentPage);
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private void NuevoProducto()
    {
        NavigationManager.NavigateTo("/master-create");
    }

    private void EditarProducto(int id)
    {
        NavigationManager.NavigateTo($"/master/edit/{id}");
    }

    /// <summary>
    /// Confirma la baja de un producto con validación de fórmulas
    /// </summary>
    private async Task ConfirmarBajaProducto(Master producto)
    {
        try
        {
            // Mostrar mensaje de confirmación inicial
            var confirmacionInicial = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Baja Lógica del Código",
                Text = $"Baja Lógica del Código '{producto.Codigo}' {producto.Descripcion}\n\nCancelar\nConfirmar",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Confirmar",
                CancelButtonText = "Cancelar"
            });

            if (!confirmacionInicial.IsConfirmed)
            {
                return;
            }

            // Validar si el producto está en fórmulas
            var responseValidacion = await repository.Get<ValidacionBajaMasterDTO>($"api/master/validar-baja/{producto.Codint}");

            if (responseValidacion.Error)
            {
                await sweetAlertService.FireAsync("Error", await responseValidacion.GetErrorMessageAsync(), SweetAlertIcon.Error);
                return;
            }

            var validacion = responseValidacion.Response!;

            if (!validacion.PuedeDarDeBaja)
            {
                // El producto está en fórmulas, mostrar lista de códigos padres
                string listaCodigos = string.Join("; ", validacion.CodigosPadres);
                var confirmacionConAdvertencia = await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Imposible Baja de este Código",
                    Text = $"El Código que Intenta dar de Baja\nEs Componente de la Fórmula de Producto (Activo o de Baja)\nDe los Productos Padre Correspondientes:\n\n{listaCodigos}\n\n¿Desea dar de baja de todas formas?",
                    Icon = SweetAlertIcon.Warning,
                    ShowCancelButton = true,
                    ConfirmButtonText = "Sí, dar de baja",
                    CancelButtonText = "Cancelar"
                });

                if (!confirmacionConAdvertencia.IsConfirmed)
                {
                    return;
                }
            }

            // Realizar baja lógica
            var responseBaja = await repository.Put<object>($"api/master/baja-logica/{producto.Codint}", null);

            if (responseBaja.Error)
            {
                await sweetAlertService.FireAsync("Error", await responseBaja.GetErrorMessageAsync(), SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Éxito", "Producto dado de baja exitosamente", SweetAlertIcon.Success);

            // Refrescar la pantalla
            await LoadAsync(currentPage);
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al dar de baja: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// IMPRESION
    /// </summary>

    private int totalRegistros;
    private bool isPrinting = false;
    private bool mostrarModalImpresion = false;
    private List<MasterListadoIndexDTO>? masterListadoIndexDTO;
    

    Dictionary<string, string> encabezadosProductos = new()

    {
        { "Id", "Id" },
        { "Codint", "CódigoInt" },
        { "Codigo", "Código" },
        { "Descripcion", "Descripción" },
        { "Umedida", "Unidad" },
        { "Timate", "numMaterial" },
        { "TipoMaterialDescripcion", "TipoMaterialDescripcion" }

   };
    private async Task ConfirmarImpresionAsync()
    {
        isPrinting = true;
        StateHasChanged();

        try
        {
            var encodedFilter = Uri.EscapeDataString(Filter ?? string.Empty);
            var response = await repository.Get<int>($"api/master/cantidad-registros?filter={encodedFilter}");
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo obtener la cantidad de registros.", SweetAlertIcon.Error);
                return;
            }

            int cantidad = response.Response;

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Confirmar impresión",
                    Text = $"Se van a imprimir {cantidad} registros. Podés aplicar un filtro para reducir la cantidad.\n¿Deseás continuar?",
                    Icon = SweetAlertIcon.Warning,
                    ShowCancelButton = true,
                    ConfirmButtonText = "Sí, imprimir",
                    CancelButtonText = "Cancelar"
                });


            if (result.IsConfirmed)
            {
                var encodedFilter1 = Uri.EscapeDataString(Filter ?? string.Empty);
                var responseDTO = await repository.Get<List<MasterListadoIndexDTO>>($"api/master/GetMasterListado?filter={encodedFilter1}");
                masterListadoIndexDTO = responseDTO.Response!;
                mostrarModalImpresion = true; // 👈 Mostramos el modal
            }
            
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    private void ResetearImpresion()
    {
        masterListadoIndexDTO = null;
        mostrarModalImpresion = false;
        StateHasChanged();
    }

    /// <summary>
    /// SINCRONIZACIÓN CENTRAL-SUCURSAL
    /// </summary>
    private bool mostrarModalSync = false;
    private bool isProcesandoSync = false;
    private SyncConfigDTO? configSync = null;

    /// <summary>
    /// CONFIGURACIÓN DE MASTER
    /// </summary>
    private bool mostrarModalConfigMaster = false;

    private void AbrirConfiguracionMaster()
    {
        mostrarModalConfigMaster = true;
    }

    private void CerrarModalConfigMaster()
    {
        mostrarModalConfigMaster = false;
        StateHasChanged();
    }

    private Task OnConfigMasterGuardada()
    {
        // Por ahora no es necesario recargar nada en esta pantalla,
        // pero dejamos el hook para que en el futuro se puedan refrescar comportamientos
        // dependientes de la configuración.
        return Task.CompletedTask;
    }

    private async Task AbrirConfiguracionSync()
    {
        await CargarConfigSync();
        mostrarModalSync = true;
    }

    private void CerrarModalSync()
    {
        mostrarModalSync = false;
        StateHasChanged();
    }

    private async Task OnConfigSyncGuardada()
    {
        await CargarConfigSync();
        StateHasChanged();
    }

    private async Task CargarConfigSync()
    {
        try
        {
            var response = await repository.Get<SyncConfigDTO>("api/sync/config");
            if (!response.Error && response.Response != null)
            {
                configSync = response.Response;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar configuración: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Procesa manualmente la sincronización de remitos (Solo Central)
    /// 
    /// Este botón solo se muestra cuando:
    /// - La sincronización está habilitada (GeneraScriptSync = true)
    /// - El equipo procesa archivos de remitos (ProcesaRemitos = true)
    /// 
    /// Flujo:
    /// 1. Valida que haya configuración de sincronización de remitos
    /// 2. Envía la ruta de intercambio de remitos al backend
    /// 3. El backend busca archivos JSON pendientes de remitos en la carpeta configurada
    /// 4. Procesa cada archivo y actualiza la base de datos
    /// 5. Recarga la grilla para mostrar los datos actualizados
    /// 
    /// Nota: Este botón permite a la Central procesar manualmente los archivos de remitos
    /// generados por la Sucursal de Neuquén en la carpeta de intercambio compartida.
    /// </summary>
    private async Task ProcesarSincronizacion()
    {
        if (configSync == null || string.IsNullOrWhiteSpace(configSync.RutaIntercambioRemitos))
        {
            await sweetAlertService.FireAsync("Error", "No hay configuración de sincronización de remitos", SweetAlertIcon.Error);
            return;
        }

        try
        {
            isProcesandoSync = true;
            StateHasChanged();

            var request = new ValidarRutaDTO { Ruta = configSync.RutaIntercambioRemitos };
            var response = await repository.Post<ValidarRutaDTO, SyncResultDTO>("api/sync/procesar-remitos", request);
            
            if (!response.Error && response.Response != null)
            {
                var resultado = response.Response;
                
                if (resultado.Exitoso)
                {
                    await sweetAlertService.FireAsync(
                        "Sincronización Exitosa", 
                        resultado.Mensaje, 
                        SweetAlertIcon.Success);
                    
                    await LoadAsync(currentPage);
                }
                else
                {
                    var detalles = resultado.DetalleErrores.Count > 0 
                        ? string.Join("<br>", resultado.DetalleErrores.Take(5))
                        : resultado.Mensaje;
                    
                    await sweetAlertService.FireAsync(
                        "Sincronización con Errores", 
                        $"{resultado.Mensaje}<br><br>{detalles}", 
                        SweetAlertIcon.Warning);
                }
            }
            else
            {
                await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al procesar sincronización: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            isProcesandoSync = false;
            StateHasChanged();
        }
    }

}
