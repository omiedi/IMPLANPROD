@page "/FichaProductosForm"
@page "/FichaProductosForm/{Id:int}"
@using IMPLANPROD.Shared.Entities
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<!--
    Componente: MasterForm.razor
    Descripción: Formulario maestro de Ítems de Stock (Productos) siguiendo el estilo de la ficha de proveedor y solapas funcionales.
    Incluye solapas: Datos, Componentes, Elaboración, Especificación.
    Autor: IA Cascade (solicitud de Omar)
    Fecha: 30/04/2025
-->

<!-- Solapas funcionales -->
<div class="d-flex border-bottom mb-3" style="background:#f8f9fa;">
    <button class="tab-btn @(activeTab == 0 ? "active" : "")" @onclick="() => CambiarTab(0)">Datos</button>
    <button class="tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => CambiarTab(1)">Componentes</button>
    <button class="tab-btn @(activeTab == 2 ? "active" : "")" @onclick="() => CambiarTab(2)">Elaboración</button>
    <button class="tab-btn @(activeTab == 3 ? "active" : "")" @onclick="() => CambiarTab(3)">Especificación</button>
</div>

<div class="tab-content-custom">
    @if (activeTab == 0)
    {
        <EditForm Model="masterItem" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label>Código:</label>
                <div>
                    <InputText class="form-control" @bind-Value="masterItem.Codigo" disabled="@(Id != 0)" />
                    <ValidationMessage For="@((Expression<Func<string>>)(() => masterItem.Codigo))" />
                </div>
            </div>

            <div class="mb-3">
                <label>Descripción:</label>
                <div>
                    <InputText class="form-control" @bind-Value="masterItem.Descripcion" />
                    <ValidationMessage For="@((Expression<Func<string>>)(() => masterItem.Descripcion))" />
                </div>
            </div>

            <div class="mb-3">
                <label>Tipo de Material:</label>
                <div>
                    <InputSelect class="form-control" @bind-Value="masterItem.Timate">
                        <option value="0">Seleccione un tipo...</option>
                        @if (tiposMaterial != null)
                        {
                            @foreach (var tipo in tiposMaterial)
                            {
                                <option value="@tipo.Id">@tipo.Descripcion</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@((Expression<Func<int>>)(() => masterItem.Timate))" />
                </div>
            </div>

            <div class="mb-3">
                <label>Unidad de Medida:</label>
                <div>
                    <InputText class="form-control" @bind-Value="masterItem.Umedida" />
                    <ValidationMessage For="@((Expression<Func<string>>)(() => masterItem.Umedida))" />
                </div>
            </div>

            <div class="mb-3">
                <label>Grupo I.V.A.:</label>
                <div>
                    <InputSelect class="form-control" @bind-Value="masterItem.Grupiva">
                        <option value="0">Seleccione un grupo...</option>
                        @if (gruposIva != null)
                        {
                            @foreach (var grupo in gruposIva)
                            {
                                <option value="@grupo.Id">@grupo.Descripcion</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@((Expression<Func<int>>)(() => masterItem.Grupiva))" />
                </div>
            </div>

            <div class="mb-3">
                <label>N° Plano:</label>
                <div>
                    <InputText class="form-control" @bind-Value="masterItem.NPlano" />
                    <ValidationMessage For="@((Expression<Func<string>>)(() => masterItem.NPlano))" />
                </div>
            </div>

            <div class="mb-3">
                <label>Ancho:</label>
                <div>
                    <InputNumber class="form-control" @bind-Value="masterItem.ANCHO" />
                    <ValidationMessage For="@((Expression<Func<decimal>>)(() => masterItem.ANCHO))" />
                </div>
            </div>

            <div class="mb-3">
                <label>Stock Mínimo:</label>
                <div>
                    <InputNumber class="form-control" @bind-Value="masterItem.Stomin" />
                </div>
            </div>

            <div class="mb-3">
                <label>Stock Máximo:</label>
                <div>
                    <InputNumber class="form-control" @bind-Value="masterItem.Stomax" />
                </div>
            </div>

            <div class="mb-3">
                <label>Fecha de Revisión:</label>
                <div>
                    <InputDate class="form-control" @bind-Value="masterItem.Ferevis" />
                    <ValidationMessage For="@((Expression<Func<DateTime>>)(() => masterItem.Ferevis))" />
                </div>
            </div>

            <div class="mb-3">
                <label>Familia:</label>
                <div>
                    <InputSelect class="form-control" @bind-Value="masterItem.Familia">
                        <option value="">Seleccione una familia...</option>
                        @if (familias != null)
                        {
                            @foreach (var familia in familias)
                            {
                                <option value="@familia.Id">@familia.Descripcion</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="@((Expression<Func<string>>)(() => masterItem.Familia))" />
                </div>
            </div>

            <div class="mb-3">
                <label>Proveedor Habitual:</label>
                <div>
                    <InputSelect class="form-control" @bind-Value="masterItem.Provhabi">
                        <option value="0">Seleccione un proveedor...</option>
                        @if (proveedores != null)
                        {
                            @foreach (var proveedor in proveedores)
                            {
                                <option value="@proveedor.Id">@proveedor.Nombre</option>
                            }
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary me-2">Guardar</button>
                <button type="button" class="btn btn-secondary" @onclick="Volver">Volver</button>
            </div>
        </EditForm>
    }
    else if (activeTab == 1)
    {
        <div class="alert alert-info">
            Componentes en desarrollo...
        </div>
    }
    else if (activeTab == 2)
    {
        <EditForm Model="masterItem" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <div class="container-fluid">
                <div class="row gx-2 mb-1">
                    <div class="col-3 mb-1">
                        <label class="form-label small">CADENCIA</label>
                        <input type="text" class="form-control form-control-sm" />
                    </div>
                    <div class="col-3 mb-1">
                        <label class="form-label small">TIEMPO PREPARACIÓN</label>
                        <input type="text" class="form-control form-control-sm" />
                    </div>
                    <div class="col-3 mb-1">
                        <label class="form-label small">TIEMPO FABRICACIÓN</label>
                        <input type="text" class="form-control form-control-sm" />
                    </div>
                    <div class="col-3 mb-1">
                        <label class="form-label small">Ciclo Mant.Herr.</label>
                        <input type="text" class="form-control form-control-sm" />
                    </div>
                </div>

                <!-- Checkboxes y Equipos auxiliares -->
                <div class="row gx-2 mb-1 align-items-center">
                    <div class="col-auto">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="secFabUnidad" />
                            <label class="form-check-label small" for="secFabUnidad">Secuencia Fabricación por Unidad</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="operTercerizada" />
                            <label class="form-check-label small" for="operTercerizada">Operación Tercerizada</label>
                        </div>
                    </div>
                </div>

                <div class="row gx-2 mb-1">
                    <div class="col-12">
                        <label class="form-label small">EQUIPOS AUXILIARES</label>
                        <div class="row gx-1">
                            <div class="col-2 mb-1">
                                <input type="text" class="form-control form-control-sm" placeholder="Eq.Aux (1)" />
                            </div>
                            <div class="col-2 mb-1">
                                <input type="text" class="form-control form-control-sm" placeholder="Eq.Aux (2)" />
                            </div>
                            <div class="col-2 mb-1">
                                <input type="text" class="form-control form-control-sm" placeholder="Eq.Aux (3)" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    }
    else if (activeTab == 3)
    {
        <EditForm Model="masterItem" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <div class="alert alert-info">
                Especificación en desarrollo...
            </div>
        </EditForm>
    }
</div>

<style>
    .tab-btn {
        border: none;
        background: none;
        padding: 10px 20px;
        cursor: pointer;
        border-bottom: 3px solid transparent;
    }

    .tab-btn.active {
        border-bottom-color: #007bff;
        color: #007bff;
    }

    .tab-content-custom {
        padding: 20px;
        min-height: 350px;
    }
</style>

@code {
    private int activeTab = 0;
    private void CambiarTab(int idx) => activeTab = idx;

    [Parameter]
    public int Id { get; set; }

    private Master masterItem = new()
    {
        // Inicializar valores por defecto para evitar nulos
        Codigo = string.Empty,
        Descripcion = string.Empty,
        NPlano = string.Empty,
        Umedida = "U.",
        Timate = 0,
        Familia = string.Empty,
        Grupiva = 0,
        Provhabi = 0
    };
    private List<Tatimat> tiposMaterial = new();
    private List<Familia> familias = new();
    private List<Grupiva> gruposIva = new();
    private List<Proved12> proveedores = new();
    private string unidadMedida = "U.";

    private async Task Guardar()
    {
        var responseHttp = await repository.Post("/api/master", masterItem);
        if (responseHttp.Error)
        {
            await sweetAlertService.FireAsync("Error", responseHttp.HttpResponseMessage.ReasonPhrase, SweetAlertIcon.Error);
            return;
        }

        await sweetAlertService.FireAsync("Éxito", "Registro guardado correctamente", SweetAlertIcon.Success);
        Volver();
    }

    private void Volver()
    {
        navigationManager.NavigateTo("/FichaProductos");
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarCombos();

        if (Id != 0)
        {
            // Modo Edición: Cargar datos del Master
            var responseMaster = await repository.Get<Master>($"/api/master/{Id}");
            if (responseMaster.Error)
            {
                await sweetAlertService.FireAsync("Error", responseMaster.HttpResponseMessage.ReasonPhrase, SweetAlertIcon.Error);
                return;
            }
            masterItem = responseMaster.Response ?? new()
            {
                // Inicializar valores por defecto si la respuesta es nula
                Codigo = string.Empty,
                Descripcion = string.Empty,
                NPlano = string.Empty,
                Umedida = "U.",
                Timate = 0,
                Familia = string.Empty,
                Grupiva = 0,
                Provhabi = 0
            };

            // Obtener la unidad de medida usando la función
            if (masterItem.Codint > 0)
            {
                var responseUnimed = await repository.Get<string>($"/api/masterfunciones/unimed/{masterItem.Codint}");
                if (!responseUnimed.Error)
                {
                    unidadMedida = responseUnimed.Response;
                }
            }
        }
    }

    private async Task CargarCombos()
    {
        var responseTipos = await repository.Get<List<Tatimat>>("/api/tipomaterial/combo");
        if (responseTipos.Error)
        {
            await sweetAlertService.FireAsync("Error", responseTipos.HttpResponseMessage.ReasonPhrase, SweetAlertIcon.Error);
            return;
        }
        tiposMaterial = responseTipos.Response ?? new();

        var responseFamilias = await repository.Get<List<Familia>>("/api/familias/combo");
        if (responseFamilias.Error)
        {
            await sweetAlertService.FireAsync("Error", responseFamilias.HttpResponseMessage.ReasonPhrase, SweetAlertIcon.Error);
            return;
        }
        familias = responseFamilias.Response ?? new();

        var responseGruposIva = await repository.Get<List<Grupiva>>("/api/grupivas/combo");
        if (responseGruposIva.Error)
        {
            await sweetAlertService.FireAsync("Error", responseGruposIva.HttpResponseMessage.ReasonPhrase, SweetAlertIcon.Error);
            return;
        }
        gruposIva = responseGruposIva.Response ?? new();

        var responseProveedores = await repository.Get<List<Proved12>>("/api/Proved12/combo");
        if (responseProveedores.Error)
        {
            await sweetAlertService.FireAsync("Error", responseProveedores.HttpResponseMessage.ReasonPhrase, SweetAlertIcon.Error);
            return;
        }
        proveedores = responseProveedores.Response ?? new();
    }
}
