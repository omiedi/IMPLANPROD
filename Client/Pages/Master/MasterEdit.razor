@page "/master/edit/{Id:int}"
@using IMPLANPROD.Client.Services
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IModalService Modal
@inject PageAccessService PageAccess

<PageTitle>Editar Producto</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else if (master is null)
{
    <div class="align-items-center">
        <img src="https://media0.giphy.com/media/3oEjI6SIIHBdRxXI40/giphy.gif?cid=ecf05e47q4b7z67j4s1jr2t1uymf1mh3kq8sxpgmj89wf4xg&rid=giphy.gif&ct=g" />
    </div>
}
else
{
    <MasterForm @ref="masterForm" Master="master" OnValidSubmit="Edit" ReturnAction="Return" IsEdit="true"
               VolverImplosion="@(volverImplosion ?? false)"
               CodintOrigenImplosion="@(codintOrigen ?? 0)"
               AbrirImplosionAutomatico="@(abrirImplosion ?? false)" />
}

@code {
    private Master? master;
    private MasterForm? masterForm;
    private bool validando = true;
    public bool FormPostedSuccessfully { get; set; }
    [Parameter]
    public int Id { get; set; }

    // Query params para el flujo de implosión
    [Parameter]
    [SupplyParameterFromQuery]
    public bool? volverImplosion { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public int? codintOrigen { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public bool? abrirImplosion { get; set; }

    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = default!;

    // Track del último Id cargado para detectar cambios de parámetro de ruta
    // cuando se navega de /master/edit/{Id1} a /master/edit/{Id2} sin salir de la página.
    private int _ultimoIdCargado = 0;

    // Validar acceso solo la primera vez
    protected override async Task OnInitializedAsync()
    {
        await PageAccess.RequiereAccesoAsync("/master/edit/{Id}");
        validando = false;
        await CargarMasterAsync();
    }

    /// <summary>
    /// Se ejecuta cuando cambian los parámetros (incluyendo el Id de la ruta).
    /// Si el Id cambió, recarga el producto. Esto es necesario porque Blazor
    /// reutiliza la misma instancia de la página cuando solo cambia el parámetro de ruta.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        // Solo recargar si el Id cambió y ya pasamos la validación inicial
        if (Id != _ultimoIdCargado && !validando)
        {
            await CargarMasterAsync();
        }
    }

    /// <summary>
    /// Carga el producto Master desde el API por su Id.
    /// </summary>
    private async Task CargarMasterAsync()
    {
        var responseHttp = await repository.Get<Master>($"/api/master/{Id}");
        if (responseHttp.Error)
        {
            if (responseHttp.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/master");
                return;
            }

            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }
        master = responseHttp.Response;
        _ultimoIdCargado = Id;
    }

    private async Task Edit()
    {
        var responseHttp = await repository.Put("/api/master", master);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        // await BlazoredModal.CloseAsync(ModalResult.Ok());
        Return();
    }

    private void Return()
    {
        masterForm!.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/master-index");
    }
}
