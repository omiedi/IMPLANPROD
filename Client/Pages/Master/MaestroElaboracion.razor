    /// <summary>
    /// Guarda los cambios realizados en la operación seleccionada
    /// </summary>
    /// <summary>
    /// Elimina una operación de manera irreversible
    /// </summary>
    private async Task EliminarOperacion(Secoper operacion)
    {
        if (operacion == null)
        {
            await sweetAlertService.FireAsync("Error", "No se ha seleccionado una operación para eliminar", SweetAlertIcon.Error);
            return;
        }

        // Confirmar la eliminación
        var confirmacion = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "¿Eliminar operación?",
            Text = $"¿Está seguro que desea eliminar la operación {operacion.NumeOper}? Esta acción es irreversible.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "No, cancelar",
            ConfirmButtonColor = "#dc3545"
        });

        if (!confirmacion.IsConfirmed) return;

        try
        {
            // Eliminar la operación
            var responseHttp = await repository.Delete($"/api/secoper/{operacion.Id}");

            if (responseHttp.Error)
            {
                var mensajeError = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
                return;
            }

            // Eliminar de la lista local
            operaciones.Remove(operacion);
            if (operacionSeleccionada?.Id == operacion.Id)
            {
                operacionSeleccionada = null;
            }

            await sweetAlertService.FireAsync("Éxito", "La operación ha sido eliminada correctamente", SweetAlertIcon.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al eliminar la operación: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private async Task GuardarCambios()
    {
        if (operacionSeleccionada == null)
        {
            await sweetAlertService.FireAsync("Error", "No hay operación seleccionada para guardar", SweetAlertIcon.Error);
            return;
        }

        try
        {
            operacionSeleccionada.MinuStan = minutosEstandar;

            HttpResponseWrapper<object> responseHttp;
            if (operacionSeleccionada.EsNueva)
            {
                // Si es una operación nueva, usar POST
                responseHttp = await repository.Post("/api/secoper", operacionSeleccionada);
                operacionSeleccionada.EsNueva= false;

                await CargarOperaciones();
            }
            else
            {
                // Si es una operación existente, usar PUT
                responseHttp = await repository.Put($"/api/secoper/{operacionSeleccionada.Id}", operacionSeleccionada);
            }

            if (responseHttp.Error)
            {
                var mensajeError = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Éxito", "Los cambios se han guardado correctamente", SweetAlertIcon.Success);
            await CargarOperaciones(); // Recargamos las operaciones para reflejar los cambios
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al guardar los cambios: {ex.Message}", SweetAlertIcon.Error);
        }
    }
