    private async Task CargarProductoTerminado()
    {
        if (string.IsNullOrEmpty(Id))
        {
            await sweetAlertService.FireAsync("Error", "No se ha especificado el código del producto", SweetAlertIcon.Error);
            return;
        }

        var responseHttp = await repository.Get<Master>($"/api/master/{Id}");

        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        productoTerminado = responseHttp.Response;
        resultado = $"{productoTerminado!.Codigo} - {productoTerminado.Descripcion}";
    }

    private async Task CargarOperaciones()
    {
        var responseHttp = await repository.Get<List<Secoper>>($"/api/secoper/producto/{productoTerminado!.Codint}");

        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        operaciones = responseHttp.Response;
        // Ordenar operaciones por número de operación para asegurar el orden correcto
        operaciones = operaciones.OrderBy(o => o.NumeOper).ToList();
    }

    /// <summary>
    /// Agrega una nueva operación a la lista con número de operación múltiplo de 10
    /// </summary>
    /// <summary>
    /// Inserta una nueva operación con número intermedio entre operaciones existentes
    /// </summary>
    private async Task InsertarOperacion(int numeroOperacion)
    {
        if (productoTerminado == null)
        {
            await sweetAlertService.FireAsync("Error", "No hay un producto seleccionado", SweetAlertIcon.Error);
            return;
        }

        if (operaciones == null)
        {
            operaciones = new List<Secoper>();
            return;
        }

        // Obtener todas las operaciones existentes ordenadas y convertir a int para facilitar operaciones
        var operacionesOrdenadas = operaciones.Where(o => o.NumeOper.HasValue)
                                            .Select(o => Convert.ToInt32(o.NumeOper.Value))
                                            .OrderBy(o => o)
                                            .ToList();

        // Encontrar la operación anterior más cercana
        int operacionAnterior = operacionesOrdenadas
            .Where(o => o < numeroOperacion)
            .DefaultIfEmpty(0)
            .Max();

        // Si no hay espacio para insertar nuevas operaciones
        if (numeroOperacion - operacionAnterior <= 1)
        {
            await sweetAlertService.FireAsync("Error", 
                "No hay espacio disponible para insertar una nueva operación entre los números existentes", 
                SweetAlertIcon.Error);
            return;
        }

        // Buscar el primer número disponible entre operacionAnterior y numeroOperacion
        int? nuevoNumero = null;
        var numerosExistentes = new HashSet<int>(operacionesOrdenadas);

        // Comenzar desde el punto medio
        int intentoInicial = (operacionAnterior + numeroOperacion) / 2;
        
        // Buscar hacia arriba y hacia abajo desde el punto medio
        for (int i = 0; i <= (numeroOperacion - operacionAnterior) / 2; i++)
        {
            int intentoArriba = intentoInicial + i;
            int intentoAbajo = intentoInicial - i;

            if (intentoArriba < numeroOperacion && !numerosExistentes.Contains(intentoArriba))
            {
                nuevoNumero = intentoArriba;
                break;
            }
            if (intentoAbajo > operacionAnterior && !numerosExistentes.Contains(intentoAbajo))
            {
                nuevoNumero = intentoAbajo;
                break;
            }
        }

        if (!nuevoNumero.HasValue || nuevoNumero.Value <= 0)
        {
            await sweetAlertService.FireAsync("Error", 
                "No se encontró un número disponible para la nueva operación", 
                SweetAlertIcon.Error);
            return;
        }

        // Validar que el nuevo número esté en el rango válido de short
        if (nuevoNumero.Value > short.MaxValue)
        {
            await sweetAlertService.FireAsync("Error", 
                "El número de operación es demasiado grande", 
                SweetAlertIcon.Error);
            return;
        }

        // Preguntar si desea crear la operación
        var confirmacion = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Nueva Operación",
            Text = $"¿Desea crear la operación {nuevoNumero}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, crear",
            CancelButtonText = "No, cancelar"
        });

        if (!confirmacion.IsConfirmed) return;

        var nuevaOperacion = new Secoper
        {
            CodIConj = productoTerminado.Codint,
            CodXConj = productoTerminado.Codigo,
            NumeOper = (short)nuevoNumero.Value,
            DescOper = $"Operación agregada ({nuevoNumero.Value})",
            LoteStan = 1,
            Fech_Revis = DateTime.Now,
            StatOper = 1,
            CodiEmpr = 0,
            EsNueva = true
        };

        operaciones.Add(nuevaOperacion);
        operaciones = operaciones.OrderBy(o => o.NumeOper).ToList();

        await SeleccionarOperacion(nuevaOperacion);
        await GuardarCambios();
        navigation.NavigateTo(navigation.Uri, forceLoad: true);
    }

    private async Task AgregarNuevaOperacion()
    {
        short signumeroCorto = 10;//lo uso para pasarlo a short 
        if (productoTerminado == null)
        {
            await sweetAlertService.FireAsync("Error", "No hay un producto seleccionado", SweetAlertIcon.Error);
            return;
        }

        if (operaciones == null)
        {
            operaciones = new List<Secoper>();
        }

        // Encontrar el siguiente número de operación (múltiplo de 10)
        int siguienteNumero = 10;
        if (operaciones.Any())
        {
            siguienteNumero = ((operaciones.Max(o => o.NumeOper ?? 0) / 10) + 1) * 10;
            signumeroCorto = (short)siguienteNumero;
        }

        var nuevaOperacion = new Secoper
        {
            CodIConj = productoTerminado.Codint,
            CodXConj = productoTerminado.Codigo,
            NumeOper = signumeroCorto,
            DescOper = $"Operación agregada ({siguienteNumero})",
            LoteStan = 1, // Valor por defecto
            Fech_Revis = DateTime.Now,
            StatOper=1,
            CodiEmpr=0,
            EsNueva = true // Marcador para identificar operaciones nuevas no guardadas
            };

        operaciones.Add(nuevaOperacion);
        operaciones = operaciones.OrderBy(o => o.NumeOper).ToList(); // Reordenar la lista

        // Seleccionar automáticamente la nueva operación
        await SeleccionarOperacion(nuevaOperacion);

        // Preguntar si desea guardar la nueva operación
        var confirmacion = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Nueva Operación",
            Text = $"¿Desea guardar la operación {signumeroCorto}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, guardar",
            CancelButtonText = "No, descartar"
        });

        if (confirmacion.IsConfirmed)
        {
            await GuardarCambios();
            navigation.NavigateTo(navigation.Uri, forceLoad: true);


        }
        else
        {
            // Si no se confirma, eliminar la operación de la lista
            operaciones.Remove(nuevaOperacion);
            operacionSeleccionada = null;
            StateHasChanged();
        }
    }
