    /// <summary>
    /// Formatea el tiempo herramental de centecimal a formato HH:MM:SS
    /// </summary>
    private string FormatearTiempoHerramental(decimal? horasCentecimal)
    {
        if (!horasCentecimal.HasValue) return "00:00:00";

        decimal totalHoras = horasCentecimal.Value;
        int horas = (int)Math.Floor(totalHoras);
        int minutos = (int)Math.Floor((totalHoras - horas) * 60);
        int segundos = (int)Math.Floor(((totalHoras - horas) * 60 - minutos) * 60);

        return $"{horas:00}:{minutos:00}:{segundos:00}";
    }

    /// <summary>
    /// Actualiza el campo HorsMHer con el tiempo herramental convertido a centecimal
    /// </summary>
    private void ActualizarTiempoHerramental(string tiempo)
    {
        if (operacionSeleccionada != null && !string.IsNullOrEmpty(tiempo))
        {
            // Validar formato HH:MM:SS
            var partes = tiempo.Split(':');
            if (partes.Length == 3 && 
                int.TryParse(partes[0], out int horas) && 
                int.TryParse(partes[1], out int minutos) && 
                int.TryParse(partes[2], out int segundos))
            {
                // Convertir a centecimal
                decimal totalHoras = horas + (minutos / 60.0m) + (segundos / 3600.0m);
                operacionSeleccionada.HorsMHer = totalHoras;
            }
        }
    }

