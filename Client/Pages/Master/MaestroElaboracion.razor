        tiempoVariableHoras = Convert.ToString( Math.Floor(tiempoTotalMinutos / 60));
        tiempoVariableMinutos =  Convert.ToString(Math.Floor(tiempoTotalMinutos % 60));
        tiempoVariableSegundos =  Convert.ToString(Math.Floor((tiempoTotalMinutos * 60) % 60));
        StateHasChanged();

    }

    private async Task CambiaTiempoVariable()
