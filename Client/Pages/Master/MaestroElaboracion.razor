        if (int.TryParse(tiempoVariableHoras, out int horas) && horas > 999) 
        {
            tiempoVariableHoras = "999";// Aquí asignamos el valor maximo
        }
        if (int.TryParse(tiempoVariableMinutos, out int minutos) && minutos > 59)
        {
            tiempoVariableMinutos = "59";// Aquí asignamos el valor maximo
        }
        if (int.TryParse(tiempoVariableSegundos, out int segundos) && segundos > 59)
        {
            tiempoVariableSegundos = "59";// Aquí asignamos el valor maximo
        }
        TSTANBA = Convert.ToDecimal(tiempoVariableHoras) + Convert.ToDecimal(tiempoVariableMinutos) / 60 + Convert.ToDecimal(tiempoVariableSegundos) / 3600;



        if(loteEstandar > 0.5m) // Agregar 'm' para asegurarse de que 0.5 es un decimal
        {
            TSTANBA = TSTANBA / loteEstandar; // Aquí asignamos el resultado de la división
        }
        if (TSTANBA > 0.0m)
        {
            cadencia = 1 / TSTANBA;
        }
        if (cadencia >= 1000m)
        {
            cadencia = cadencia + 0.5m;
            cadencia = (int)Math.Round(cadencia);
        }
        minutosEstandar = 60 * TSTANBA / loteEstandar;

        // operacionSeleccionada!.MinuStan = 60 * TSTANBA / loteEstandar;
        operacionSeleccionada!.Cadencia = Math.Round(cadencia,1);
        StateHasChanged();

    }

