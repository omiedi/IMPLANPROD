    private string FormatearDecimal(decimal? valor)
    {
        if (valor == null) return string.Empty;
        return valor.Value.ToString("N2");
    }

    private string FormatearTiempo(decimal? horas)
    {
        if (horas == null) return string.Empty;

        var totalMinutos = horas.Value * 60;
        var h = Math.Floor(totalMinutos / 60);
        var m = Math.Floor(totalMinutos % 60);
        var s = Math.Floor((totalMinutos * 60) % 60);

        return $"{h:00}:{m:00}:{s:00}";
    }
    private async Task CambiaLoteVariable()
    {

        decimal loteEstandar = Convert.ToDecimal(operacionSeleccionada?.LoteStan ?? 0);
        decimal tiempoTotalMinutos = loteEstandar * Convert.ToDecimal(minutosEstandar); //cuando cambia el lote standar toma el valor de minutosEstandar ultimo que se modfiico en CambiaTiempoVariable
