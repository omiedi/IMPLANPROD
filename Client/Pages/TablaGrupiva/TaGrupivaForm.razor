@inject SweetAlertService sweetAlertService

@using CurrieTechnologies.Razor.SweetAlert2

<!-- Formulario para crear/editar una moneda -->
<EditForm Model="grupiva" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Código:</label>
        <div>
            <InputNumber class="form-control" @bind-Value="@grupiva.CodigoID" disabled="@IsEdit" />
            <ValidationMessage For="@(() => grupiva.CodigoID)" />
        </div>
    </div>
    <div class="mb-3">
        <label>Descripción:</label>
        <div>
            <InputText class="form-control" @bind-Value="@grupiva.Referencia" />
            <ValidationMessage For="@(() => grupiva.Referencia)" />
        </div>
    </div>
    <div class="mb-3">
        <label>Cotización:</label>
        <div>
            <InputNumber class="form-control" @bind-Value="@grupiva.tasa" />
            <ValidationMessage For="@(() => grupiva.tasa)" />
        </div>
    </div>

    <button class="btn btn-primary" type="submit">Guardar Cambios</button>
    <button class="btn btn-success" type="button" @onclick="ReturnAction">Regresar</button>

</EditForm>

@code {
    [EditorRequired]
    [Parameter]
    public Grupiva grupiva { get; set; } = null!;

    [EditorRequired]
    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [EditorRequired]
    [Parameter]
    public EventCallback ReturnAction { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    public bool FormPostedSuccessfully { get; set; }
}
