@page "/TaGrupiva/Index"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS

@using System.Net.Http
@using CurrieTechnologies.Razor.SweetAlert2
@using Blazored.Modal
@using Blazored.Modal.Services

<div class="bg-primary text-white text-center p-3 mb-4">
    <h1>Tasas de Iva</h1>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center">
        <div class="me-2">
            <a class="btn btn-sm btn-primary" @onclick=@(() => ShowModal())><i class="oi oi-plus"></i> Nueva Tasa de iva</a>
        </div>

        <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar tasas de iva..." @bind-value="Filter" />
        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>
    
    <div>
        <a href="/TaGrupiva/BajaIndex"class="btn btn-sm btn-warning">
            <i class="fas fa-trash-restore"></i> Restaurar tasa de iva de Baja
        </a>
    </div>
</div>

<Pagination CurrentPage="currentPage"
            TotalPages="totalPages"
            SelectedPage="SelectedPageAsync" />

<GenericList MyList="grupiva">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Tasa</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in grupiva!)
                {
                    <tr>
                        <td>@item.CodigoID</td>
                        <td>@item.Referencia</td>
                        <td>@item.tasa</td>
                        <td>
                            <a class="btn btn-warning btn-sm" @onclick=@(() => ShowModal(item.Id, true))><i class="oi oi-pencil" /> Editar</a>
@*                             <button class="btn btn-danger btn-sm" @onclick=@(() => DeleteAsync(item.Id))><i class="oi oi-trash" /> Borrar</button>
 *@                            @if (item.Status == 0)
                            {
                                <button class="btn btn-info btn-sm" @onclick=@(() => CambiaStatusAsync(item.Id, -1))><i class="oi oi-ban" /> Desactivar</button>
                            }
                            else
                            {
                                <button class="btn btn-success btn-sm" @onclick=@(() => CambiaStatusAsync(item.Id, 0))><i class="oi oi-check" /> Activar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@code {
    // Lista de monedas
    public List<Grupiva>? grupiva { get; set; }
    
    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = "";

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = "";

    private int currentPage = 1;
    private int totalPages;

    // Método que se ejecuta al iniciar el componente
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // Método para cargar los datos de monedas
    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/grupivas?page={page}";
            url2 = $"api/grupivas/totalPages";
        }
        else
        {
            url1 = $"api/grupivas?page={page}&filter={Filter}";
            url2 = $"api/grupivas/totalPages?filter={Filter}";
        }

        var responseHppt = await repository.Get<List<Grupiva>>(url1);
        var responseHppt2 = await repository.Get<int>(url2);
        grupiva = responseHppt.Response!;
        totalPages = responseHppt2.Response!;
    }

    // Método para mostrar el modal de creación o edición
    private async Task ShowModal(int id = 0, bool isEdit = false)
    {
        IModalReference modalReference;

        if (isEdit)
        {
            modalReference = Modal.Show<TaGrupivaEdit>(string.Empty, new ModalParameters().Add("Id", id));
        }
        else
        {
            modalReference = Modal.Show<TaGrupivaCreate>();
        }

        var result = await modalReference.Result;
        if (result.Confirmed)
        {
            await LoadAsync();
        }
    }

    // Método para eliminar una moneda
    private async Task DeleteAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Realmente deseas eliminar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Sí"
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        var responseHttp = await repository.Delete($"api/grupivas/{id}");
        if (responseHttp.Error)
        {
            if (responseHttp.HttpResponseMessage.StatusCode != System.Net.HttpStatusCode.NotFound)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }
        }

        await LoadAsync();
    }

    // Método para cambiar el estado de una tasa iva
    private async Task CambiaStatusAsync(int id, int status)
    {
        var responseHttp = await repository.Put($"api/grupivas/cambiaStatus/{id}/{status}", "");
        if (responseHttp.Error)
        {
            if (responseHttp.HttpResponseMessage.StatusCode != System.Net.HttpStatusCode.NotFound)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }
        }
        await LoadAsync();
    }

    // Método para aplicar el filtro de búsqueda
    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
        await SelectedPageAsync(page);
    }

    // Método para limpiar el filtro de búsqueda
    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    // Método para seleccionar una página
    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }
}
