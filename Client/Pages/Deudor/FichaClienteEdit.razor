@page "/ficha-cliente-edit/{Id:int}"
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Shared.Entities
@inject IRepository repository
@inject NavigationManager NavigationManager
@inject PageAccessService PageAccess
@inject IModalService modalService

<PageTitle>Editar Cliente</PageTitle>

<!--
    Componente: FichaClienteEdit.razor
    Descripción: Edición de un cliente existente usando el formulario reutilizable FichaClienteForm.razor
    Autor: IA Cascade (solicitud de Omar)
    Fecha: 22/04/2025
    
    Este componente sigue el estándar de páginas ABM definido en el proyecto.
-->

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
    <h3>
        Editar Cliente
        @* Acceso al ABM de países/provincias en modal (componente reutilizable
           PaisesProvinciasModal): mismo circuito que /countries y
           /countries/details, para dar de alta el país/provincia que falte
           sin salir de la edición del cliente. *@
        <button type="button" class="btn btn-sm btn-outline-primary float-end" @onclick="AbrirPaisesProvincias">
            <i class="oi oi-globe"></i> Países / Provincias
        </button>
    </h3>
    @if (isLoading)
    {
        <p>Cargando datos del cliente...</p>
    }
    else if (cliente != null)
    {
        <FichaClienteForm @ref="fichaClienteForm" Id="@Id" />
    }
    else
    {
        <div class="alert alert-danger">No se encontró el cliente solicitado.</div>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Deudor12? cliente;
    private bool isLoading = true;
    private bool validando = true;

    // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
    protected override async Task OnInitializedAsync()
    {
        await PageAccess.RequiereAccesoAsync("/ficha-cliente-edit");
        validando = false;
        
        var response = await repository.Get<Deudor12>($"/api/deudor12/{Id}");
        cliente = response.Response;
        isLoading = false;
    }

    private FichaClienteForm? fichaClienteForm;

    /// <summary>
    /// Abre el ABM de países y provincias en modal. Al cerrar, se recargan los
    /// combos del formulario por si se dieron de alta países o provincias.
    /// </summary>
    private async Task AbrirPaisesProvincias()
    {
        var modal = modalService.Show<PaisesProvinciasModal>("Países y Provincias", new ModalOptions
        {
            Size = ModalSize.ExtraLarge,
            DisableBackgroundCancel = true
        });

        await modal.Result;

        if (fichaClienteForm != null)
        {
            await fichaClienteForm.RecargarPaisesProvinciasAsync();
        }
    }
}
