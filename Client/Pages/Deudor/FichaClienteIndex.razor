@page "/ficha-cliente-index"
@using IMPLANPROD.Shared.Entities
@inject IRepository repository
@using IMPLANPROD.Shared.DTOs
@inject NavigationManager NavigationManager
@inject SweetAlertService sweetAlertService
@using IMPLANPROD.Client.Services
@inject DerechosUsuarioClientService derechosService

<PageTitle>Ficha de Clientes</PageTitle>

<!--
    Componente: FichaClienteIndex.razor
    Descripción: Listado paginado de clientes (Deudor12) con opciones de edición, baja y alta de nuevos clientes.
    Autor: IA Cascade (solicitud de Omar)
    Fecha: 22/04/2025
    
    Este componente sigue el estándar de páginas ABM definido en el proyecto.
    Se muestran las columnas: Nro de cliente, Razón social, Domicilio, Teléfono, Mail.
    Incluye paginación y botones para editar, dar de baja (status = -1) y crear nuevo cliente.
    Implementa el modelo de carga y paginación LoadAsync como el resto del sistema.
-->

<div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-3">
    <h3 class="m-0 text-primary">Lista de Clientes</h3>
</div>

@if (verificandoPermisos)
{
    <div class="alert alert-info">
        <div class="spinner-border spinner-border-sm me-2" role="status">
            <span class="visually-hidden">Verificando permisos...</span>
        </div>
        <span>Verificando permisos de acceso...</span>
    </div>
}
else if (!tieneAccesoEscritura)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Modo Solo Lectura:</strong> Usted tiene permisos de solo lectura. No puede crear, editar o dar de baja clientes.
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NuevoCliente" disabled="@(!tieneAccesoEscritura)">
        @if (tieneAccesoEscritura)
        {
            <i class="fas fa-user-plus"></i>
            <text> Nuevo Cliente</text>
        }
        else
        {
            <i class="fas fa-lock"></i>
            <text> Nuevo Cliente (Sin Permisos)</text>
        }
    </button>
    <button class="btn btn-secondary ms-2" @onclick="IrAClientesDadosDeBaja" disabled="@(!tieneAccesoEscritura)">
        @if (tieneAccesoEscritura)
        {
            <i class="fas fa-user-slash"></i>
            <text> Ver clientes dados de baja</text>
        }
        else
        {
            <i class="fas fa-lock"></i>
            <text> Ver clientes dados de baja (Sin Permisos)</text>
        }
    </button>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <input class="form-control" placeholder="Buscar por Razón Social..." @bind="Filter" @bind:event="oninput" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-secondary" @onclick="()=>LoadAsync(1)"><i class="fas fa-search"></i> Buscar</button>
    </div>
</div>

@if (isLoading)
{
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Cargando...</span>
        </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nro Cliente</th>
                <th>Razón Social</th>
                <th>Domicilio</th>
                <th>Teléfono</th>
                <th>Mail</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Clientes != null && Clientes.Count > 0)
            {
                @foreach (var cliente in Clientes)
                {
                    <tr>
                        <td>@cliente.Nume_Cli</td>
                        <td>@cliente.Raso_Cli</td>
                        <td>@cliente.Domi_Cli</td>
                        <td>@cliente.Tele_Cli</td>
                        <td>@cliente.Mail_Cli</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" 
                                    @onclick="() => EditarCliente(cliente.Id)" 
                                    disabled="@(!tieneAccesoEscritura)"
                                    title="@(tieneAccesoEscritura ? "Editar cliente" : "Sin permisos de escritura")">
                                <i class="fas @(tieneAccesoEscritura ? "fa-edit" : "fa-lock")"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" 
                                    @onclick="() => DarDeBaja(cliente.Id)" 
                                    disabled="@(!tieneAccesoEscritura)"
                                    title="@(tieneAccesoEscritura ? "Dar de baja cliente" : "Sin permisos de escritura")">
                                <i class="fas @(tieneAccesoEscritura ? "fa-user-slash" : "fa-lock")"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6">No hay clientes para mostrar.</td></tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center">
        <button class="btn btn-outline-secondary" @onclick="()=>LoadAsync(PaginaActual-1)" disabled="@(PaginaActual == 1)">Anterior</button>
        <span>Página @PaginaActual de @TotalPaginas</span>
        <button class="btn btn-outline-secondary" @onclick="()=>LoadAsync(PaginaActual+1)" disabled="@(PaginaActual == TotalPaginas)">Siguiente</button>
    </div>
}

@code {
    // Lista de clientes para mostrar
    private List<Deudor12> Clientes = new();
    private int PaginaActual = 1;
    private int TotalPaginas = 10;
    private int RegistrosPorPagina = 10;
    private bool isLoading = true;
    private string? Filter = string.Empty;
    private string? Page = string.Empty;

    // Variables de control de permisos
    private bool tieneAccesoEscritura = false;
    private bool verificandoPermisos = true;
    private const string COD_APLI = "CLIENTES";
    private const string DES_APLI = "ACCESO A LISTA DE CLIENTES";

    /// <summary>
    /// Carga los clientes paginados desde el backend usando el patrón LoadAsync
    /// </summary>
    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }
        PaginaActual = page;
        string url1 = string.Empty;
        string url2 = string.Empty;
        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/deudor12?page={page}&recordsNumber={RegistrosPorPagina}";
            url2 = $"api/deudor12/totalPages?recordsNumber={RegistrosPorPagina}";
        }
        else
        {
            url1 = $"api/deudor12?page={page}&recordsNumber={RegistrosPorPagina}&filter={Filter}";
            url2 = $"api/deudor12/totalPages?recordsNumber={RegistrosPorPagina}&filter={Filter}";
        }
        try
        {
            isLoading = true;
            var responseHttp = await repository.Get<List<Deudor12>>(url1);
            var responseHttp2 = await repository.Get<int>(url2);
            Clientes = responseHttp.Response!;
            TotalPaginas = responseHttp2.Response!;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        isLoading = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // Verificar derechos de acceso del usuario
        verificandoPermisos = true;
        
        // Verificar si el usuario tiene acceso de lectura mínimo
        var nivelAcceso = await derechosService.VerificarDerechoAsync(
            COD_APLI,
            DES_APLI,
            mostrarMensaje: true // Mostrar mensaje si no tiene acceso
        );

        // Si no tiene acceso (nivel 0), redirigir al inicio
        if (nivelAcceso == 0)
        {
            Console.WriteLine($"Usuario sin acceso a {COD_APLI}. Redirigiendo...");
            await Task.Delay(2000); // Esperar 2 segundos para que vea el mensaje
            NavigationManager.NavigateTo("/");
            return;
        }

        // Determinar si tiene permisos de escritura (nivel 2)
        tieneAccesoEscritura = nivelAcceso >= 2;
        
        Console.WriteLine($"Acceso a {COD_APLI}: Nivel {nivelAcceso} - Escritura: {tieneAccesoEscritura}");
        
        verificandoPermisos = false;
        
        // Cargar datos solo si tiene acceso
        await LoadAsync();
    }

    private void NuevoCliente()
    {
        NavigationManager.NavigateTo("/ficha-cliente-create");
    }

    private void EditarCliente(int id)
    {
        NavigationManager.NavigateTo($"/ficha-cliente-edit/{id}");
    }

    private async Task DarDeBaja(int id)
    {
        var cliente = await repository.Get<Deudor12>($"/api/deudor12/{id}");
        if (cliente.Response != null)
        {
            cliente.Response.Stat_Cli = -1;
            await repository.Put("/api/deudor12", cliente.Response);
            await LoadAsync(PaginaActual);
        }
    }

    private void IrAClientesDadosDeBaja()
    {
        NavigationManager.NavigateTo("/ficha-cliente-baja");
    }
}
