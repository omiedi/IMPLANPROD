@page "/reset-password"
@inject IRepository repository
@inject NavigationManager navigationManager

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header" style="background-color:#1F7246; color:white;">
                <h5 class="mb-0"><i class="oi oi-lock-unlocked me-2"></i>Nueva Contraseña</h5>
            </div>
            <div class="card-body">

                @if (tokenInvalido)
                {
                    <div class="alert alert-danger">
                        <i class="oi oi-warning me-2"></i>
                        El enlace de recuperación es <strong>inválido o ha expirado</strong>.<br />
                        <small>Los enlaces tienen una vigencia de 30 minutos.</small>
                    </div>
                    <div class="text-center mt-3">
                        <a href="/recuperar-password" class="btn btn-warning btn-sm me-2">
                            Solicitar nuevo enlace
                        </a>
                        <a href="/login" class="btn btn-outline-secondary btn-sm">Ir al login</a>
                    </div>
                }
                else if (exitoso)
                {
                    <div class="alert alert-success">
                        <i class="oi oi-check me-2"></i>
                        <strong>¡Contraseña actualizada!</strong><br />
                        Ya podés iniciar sesión con tu nueva contraseña.
                    </div>
                    <div class="text-center mt-3">
                        <a href="/login" class="btn btn-primary btn-sm">
                            <i class="oi oi-arrow-right me-1"></i>Ir al login
                        </a>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger py-2">@mensajeError</div>
                    }

                    <div class="mb-3">
                        <label for="nueva" class="form-label">Nueva contraseña</label>
                        <div class="input-group">
                            <input type="@(mostrarPassword ? "text" : "password")"
                                   id="nueva"
                                   class="form-control @(mostrarValidacion && string.IsNullOrWhiteSpace(nuevaPassword) ? "is-invalid" : "")"
                                   @bind="nuevaPassword"
                                   @bind:event="oninput"
                                   autocomplete="new-password"
                                   disabled="@cargando" />
                            <button type="button" class="btn btn-outline-secondary"
                                    @onclick="() => mostrarPassword = !mostrarPassword">
                                <i class="@(mostrarPassword ? "oi oi-eye-closed" : "oi oi-eye")"></i>
                            </button>
                        </div>
                        @if (mostrarValidacion && string.IsNullOrWhiteSpace(nuevaPassword))
                        {
                            <div class="text-danger small mt-1">Ingresá la nueva contraseña.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="confirmar" class="form-label">Confirmar contraseña</label>
                        <input type="@(mostrarPassword ? "text" : "password")"
                               id="confirmar"
                               class="form-control @(mostrarValidacion && nuevaPassword != confirmarPassword ? "is-invalid" : "")"
                               @bind="confirmarPassword"
                               @bind:event="oninput"
                               autocomplete="new-password"
                               disabled="@cargando" />
                        @if (mostrarValidacion && nuevaPassword != confirmarPassword)
                        {
                            <div class="invalid-feedback">Las contraseñas no coinciden.</div>
                        }
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary" @onclick="Confirmar" disabled="@cargando">
                            @if (cargando)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="oi oi-check me-1"></i>
                                <span>Guardar contraseña</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string token = "";
    private string nuevaPassword = "";
    private string confirmarPassword = "";
    private bool mostrarPassword = false;
    private bool cargando = false;
    private bool exitoso = false;
    private bool tokenInvalido = false;
    private bool mostrarValidacion = false;
    private string? mensajeError;

    protected override void OnInitialized()
    {
        var uri = new Uri(navigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        token = query["token"] ?? "";

        if (string.IsNullOrWhiteSpace(token))
            tokenInvalido = true;
    }

    private async Task Confirmar()
    {
        mostrarValidacion = true;
        mensajeError = null;

        if (string.IsNullOrWhiteSpace(nuevaPassword) || nuevaPassword != confirmarPassword)
            return;

        cargando = true;
        try
        {
            var response = await repository.Post<object, string>(
                "api/auth/reset-password",
                new { Token = token, NuevaPassword = nuevaPassword });

            if (response.Error)
            {
                var errorMsg = await response.GetErrorMessageAsync();
                if (errorMsg?.Contains("inválido") == true || errorMsg?.Contains("expirado") == true)
                    tokenInvalido = true;
                else
                    mensajeError = errorMsg ?? "Error al actualizar la contraseña.";
            }
            else
            {
                exitoso = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ResetPassword] Error: {ex.Message}");
            mensajeError = "Ocurrió un error. Intentá nuevamente o solicitá un nuevo enlace.";
        }
        finally
        {
            cargando = false;
        }
    }
}
