@page "/materiales-consignacion"
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Services
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Materiales en Consignación</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h3><i class="fas fa-boxes"></i> Materiales en Consignación</h3>
        </div>
    </div>

    <!-- Filtros de búsqueda -->
    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0">
                <i class="fas fa-filter"></i> Filtros de Búsqueda
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Buscar Proveedor:</label>
                    <input type="text" class="form-control" @bind="filtroProveedor" @bind:event="oninput" placeholder="Razón social..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">N° Orden Compra:</label>
                    <input type="text" class="form-control" @bind="filtroOrdenCompra" @bind:event="oninput" placeholder="N° Orden..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Código/Descripción:</label>
                    <input type="text" class="form-control" @bind="filtroArticulo" @bind:event="oninput" placeholder="Código o descripción..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">N° Orden Fabricación:</label>
                    <input type="text" class="form-control" @bind="filtroOrdenFab" @bind:event="oninput" placeholder="N° Orden Fab..." />
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12 text-end">
                    <button class="btn btn-primary" @onclick="CargarDatosAsync">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="LimpiarFiltrosAsync">
                        <i class="fas fa-eraser"></i> Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de materiales en consignación -->
    <div class="card">
        <div class="card-body">
            @if (materiales == null)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (!MaterialesFiltrados.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> No se encontraron materiales en consignación con saldo pendiente.
                </div>
            }
            else
            {
                <!-- Botones de acción -->
                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <span class="badge bg-primary fs-6">
                            Total: @MaterialesFiltrados.Count() registros
                        </span>
                        <span class="badge bg-success fs-6 ms-2">
                            Saldo Total: @MaterialesFiltrados.Sum(m => m.SaldoPend ?? 0).ToString("N2")
                        </span>
                    </div>
                    <div>
                        <button class="btn btn-outline-success" @onclick="ImprimirReporteAsync" disabled="@imprimiendo">
                            @if (imprimiendo)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="fas fa-print"></i> Imprimir
                        </button>
                        <button class="btn btn-success ms-2" @onclick="ExportarExcelAsync" disabled="@exportando">
                            @if (exportando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <i class="fas fa-file-excel"></i> Exportar a Excel
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover table-sm">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha Emisión</th>
                                <th>N° Prov.</th>
                                <th>Razón Social</th>
                                <th>N° Orden Fab.</th>
                                <th>N° Orden Compra</th>
                                <th>Cód. Int.</th>
                                <th>Código Ext.</th>
                                <th>Descripción</th>
                                <th>Unidad</th>
                                <th class="text-end">Cant. Asignada</th>
                                <th class="text-end">Cant. Entregada</th>
                                <th>Fecha Entrega</th>
                                <th class="text-end">Cant. Rendida</th>
                                <th class="text-end">Saldo Pend.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var material in MaterialesFiltrados)
                            {
                                <tr>
                                    <td>@material.FemiOcom?.ToString("dd/MM/yyyy")</td>
                                    <td>@material.NproOcom</td>
                                    <td>@material.RaSoProv</td>
                                    <td>@material.NroOrfa</td>
                                    <td>@material.NroOcom</td>
                                    <td>@material.CodInte</td>
                                    <td>@material.CodExte</td>
                                    <td>@material.Descritem</td>
                                    <td>@material.Unidad</td>
                                    <td class="text-end">@material.CantAsig?.ToString("N2")</td>
                                    <td class="text-end">@material.CantEntreg?.ToString("N2")</td>
                                    <td>@material.FechaEntreg?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@material.CantRendid?.ToString("N2")</td>
                                    <td class="text-end"><strong>@material.SaldoPend?.ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <th colspan="9" class="text-end">TOTALES:</th>
                                <th class="text-end">@MaterialesFiltrados.Sum(m => m.CantAsig ?? 0).ToString("N2")</th>
                                <th class="text-end">@MaterialesFiltrados.Sum(m => m.CantEntreg ?? 0).ToString("N2")</th>
                                <th></th>
                                <th class="text-end">@MaterialesFiltrados.Sum(m => m.CantRendid ?? 0).ToString("N2")</th>
                                <th class="text-end"><strong>@MaterialesFiltrados.Sum(m => m.SaldoPend ?? 0).ToString("N2")</strong></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Área de impresión (oculta en pantalla) -->
<div id="areaImpresion" style="display: none;">
    <div style="padding: 20px; font-family: Arial, sans-serif;">
        <div style="text-align: center; margin-bottom: 20px;">
            <img src="/Images/logoempresa.png" alt="Logo Empresa" style="max-height: 60px; margin-bottom: 10px;" />
            <h3>MATERIALES EN CONSIGNACIÓN</h3>
            <p>Fecha: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        @if (materiales != null && MaterialesFiltrados.Any())
        {
            <table style="width: 100%; border-collapse: collapse; font-size: 10px;">
                <thead>
                    <tr style="background-color: #333; color: white;">
                        <th style="border: 1px solid #000; padding: 5px;">F. Emisión</th>
                        <th style="border: 1px solid #000; padding: 5px;">Prov.</th>
                        <th style="border: 1px solid #000; padding: 5px;">Razón Social</th>
                        <th style="border: 1px solid #000; padding: 5px;">O. Fab.</th>
                        <th style="border: 1px solid #000; padding: 5px;">O. Compra</th>
                        <th style="border: 1px solid #000; padding: 5px;">Cód.</th>
                        <th style="border: 1px solid #000; padding: 5px;">Descripción</th>
                        <th style="border: 1px solid #000; padding: 5px;">UM</th>
                        <th style="border: 1px solid #000; padding: 5px; text-align: right;">Asignada</th>
                        <th style="border: 1px solid #000; padding: 5px; text-align: right;">Entregada</th>
                        <th style="border: 1px solid #000; padding: 5px;">F. Entrega</th>
                        <th style="border: 1px solid #000; padding: 5px; text-align: right;">Rendida</th>
                        <th style="border: 1px solid #000; padding: 5px; text-align: right;">Saldo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var material in MaterialesFiltrados)
                    {
                        <tr>
                            <td style="border: 1px solid #000; padding: 3px;">@material.FemiOcom?.ToString("dd/MM/yyyy")</td>
                            <td style="border: 1px solid #000; padding: 3px;">@material.NproOcom</td>
                            <td style="border: 1px solid #000; padding: 3px;">@material.RaSoProv</td>
                            <td style="border: 1px solid #000; padding: 3px;">@material.NroOrfa</td>
                            <td style="border: 1px solid #000; padding: 3px;">@material.NroOcom</td>
                            <td style="border: 1px solid #000; padding: 3px;">@material.CodExte</td>
                            <td style="border: 1px solid #000; padding: 3px;">@material.Descritem</td>
                            <td style="border: 1px solid #000; padding: 3px;">@material.Unidad</td>
                            <td style="border: 1px solid #000; padding: 3px; text-align: right;">@material.CantAsig?.ToString("N2")</td>
                            <td style="border: 1px solid #000; padding: 3px; text-align: right;">@material.CantEntreg?.ToString("N2")</td>
                            <td style="border: 1px solid #000; padding: 3px;">@material.FechaEntreg?.ToString("dd/MM/yyyy")</td>
                            <td style="border: 1px solid #000; padding: 3px; text-align: right;">@material.CantRendid?.ToString("N2")</td>
                            <td style="border: 1px solid #000; padding: 3px; text-align: right;"><strong>@material.SaldoPend?.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="background-color: #f0f0f0; font-weight: bold;">
                        <td colspan="8" style="border: 1px solid #000; padding: 5px; text-align: right;">TOTALES:</td>
                        <td style="border: 1px solid #000; padding: 5px; text-align: right;">@MaterialesFiltrados.Sum(m => m.CantAsig ?? 0).ToString("N2")</td>
                        <td style="border: 1px solid #000; padding: 5px; text-align: right;">@MaterialesFiltrados.Sum(m => m.CantEntreg ?? 0).ToString("N2")</td>
                        <td style="border: 1px solid #000; padding: 5px;"></td>
                        <td style="border: 1px solid #000; padding: 5px; text-align: right;">@MaterialesFiltrados.Sum(m => m.CantRendid ?? 0).ToString("N2")</td>
                        <td style="border: 1px solid #000; padding: 5px; text-align: right;"><strong>@MaterialesFiltrados.Sum(m => m.SaldoPend ?? 0).ToString("N2")</strong></td>
                    </tr>
                </tfoot>
            </table>
        }
    </div>
</div>

@code {
    private List<Maconsig>? materiales;
    private string filtroProveedor = string.Empty;
    private string filtroOrdenCompra = string.Empty;
    private string filtroArticulo = string.Empty;
    private string filtroOrdenFab = string.Empty;
    private bool imprimiendo = false;
    private bool exportando = false;

    private IEnumerable<Maconsig> MaterialesFiltrados
    {
        get
        {
            if (materiales == null) return Enumerable.Empty<Maconsig>();

            var resultado = materiales.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtroProveedor))
            {
                resultado = resultado.Where(m => 
                    m.RaSoProv?.Contains(filtroProveedor, StringComparison.OrdinalIgnoreCase) == true);
            }

            if (!string.IsNullOrWhiteSpace(filtroOrdenCompra))
            {
                resultado = resultado.Where(m => 
                    m.NroOcom?.Contains(filtroOrdenCompra, StringComparison.OrdinalIgnoreCase) == true);
            }

            if (!string.IsNullOrWhiteSpace(filtroArticulo))
            {
                resultado = resultado.Where(m => 
                    m.CodExte?.Contains(filtroArticulo, StringComparison.OrdinalIgnoreCase) == true ||
                    m.Descritem?.Contains(filtroArticulo, StringComparison.OrdinalIgnoreCase) == true);
            }

            if (!string.IsNullOrWhiteSpace(filtroOrdenFab))
            {
                resultado = resultado.Where(m => 
                    m.NroOrfa?.Contains(filtroOrdenFab, StringComparison.OrdinalIgnoreCase) == true);
            }

            return resultado;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        try
        {
            var response = await repository.Get<List<Maconsig>>("api/maconsig/materiales-consignacion");
            if (!response.Error)
            {
                materiales = response.Response;
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "Error al cargar los materiales en consignación", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar datos: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    private async Task LimpiarFiltrosAsync()
    {
        filtroProveedor = string.Empty;
        filtroOrdenCompra = string.Empty;
        filtroArticulo = string.Empty;
        filtroOrdenFab = string.Empty;
        await CargarDatosAsync();
    }

    private async Task ImprimirReporteAsync()
    {
        try
        {
            imprimiendo = true;
            StateHasChanged();

            await Task.Delay(100); // Dar tiempo para que se actualice el DOM

            await JS.InvokeVoidAsync("imprimirElemento", "areaImpresion");
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al imprimir: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            imprimiendo = false;
            StateHasChanged();
        }
    }

    private async Task ExportarExcelAsync()
    {
        try
        {
            exportando = true;
            StateHasChanged();

            Console.WriteLine($"[ExportarExcel] Iniciando exportación de {MaterialesFiltrados.Count()} registros");

            var response = await Http.PostAsJsonAsync("api/excel/exportar-materiales-consignacion", MaterialesFiltrados.ToList());

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"[ExportarExcel] Error en respuesta: {errorContent}");
                await sweetAlertService.FireAsync("Error", $"Error al generar el archivo: {response.StatusCode}", SweetAlertIcon.Error);
                return;
            }

            var fileBytes = await response.Content.ReadAsByteArrayAsync();
            Console.WriteLine($"[ExportarExcel] Archivo recibido: {fileBytes.Length} bytes");

            var nombreArchivo = $"Materiales_Consignacion_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await JS.InvokeVoidAsync("descargarArchivo", nombreArchivo, Convert.ToBase64String(fileBytes));

            Console.WriteLine($"[ExportarExcel] Exportación completada exitosamente");
            await sweetAlertService.FireAsync("Éxito", "Archivo Excel generado correctamente", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ExportarExcel] Error: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al exportar: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            exportando = false;
            StateHasChanged();
        }
    }
}
