@page "/MotivosRechazoRecepcion/create"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IModalService Modal

<h3>Nuevo Motivo de Rechazo</h3>

<MotivosRechazoRecepcionForm @ref="motivoForm" Motivo="motivo" OnValidSubmit="Create" ReturnAction="Return" IsEdit="false" />

@code {
    private MotivosRechazoRecepcion motivo = new();
    private MotivosRechazoRecepcionForm? motivoForm;
    [CascadingParameter]
    BlazoredModalInstance BlazoredModal { get; set; } = default!;

    private async Task Create()
    {
        var responseHttp = await repository.Post("/api/motivosrechazorecepcion", motivo);
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        await BlazoredModal.CloseAsync(ModalResult.Ok());
        Return();
    }

    private void Return()
    {
        motivoForm!.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/MotivosRechazoRecepcion");
    }
}
