@page "/MotivosRechazoRecepcion"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS

@using System.Net.Http
@using CurrieTechnologies.Razor.SweetAlert2

<PageTitle>Motivos de Rechazo - Recepción</PageTitle>

<div class="bg-primary text-white text-center p-3 mb-4">
    <h1>Motivos de Rechazo de Recepción</h1>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center">
        <div class="me-2">
            <a class="btn btn-sm btn-primary" @onclick=@(() => ShowModal())><i class="oi oi-plus"></i> Nuevo Motivo</a>
        </div>

        <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar motivo..." @bind-value="Filter" />
        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>

    <div>
        <a href="/MotivosRechazoRecepcion/Baja" class="btn btn-sm btn-warning">
            <i class="fas fa-trash-restore"></i> Restaurar Motivos de Baja
        </a>
    </div>
</div>

<Pagination CurrentPage="currentPage"
TotalPages="totalPages"
 SelectedPage="SelectedPageAsync" />

<GenericList MyList="motivos">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in motivos!)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.CodigoMotivo</td>
                        <td>@item.Descripcion</td>
                        <td>
                            @if (item.Status >= 0)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </td>
                        <td>
                            <a @onclick=@(() => ShowModal(@item.Id,true)) class="btn btn-warning btn-sm flex-fill"><i class="oi oi-pencil" /> Editar</a>
                            <button class="btn btn-danger btn-sm" @onclick=@(() => DeleteAsync(item.Id))>Borrar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
</GenericList>

@code {

    public List<MotivosRechazoRecepcion>? motivos { get; set; }
    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages;

    protected async override Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/motivosrechazorecepcion?page={page}";
            url2 = $"api/motivosrechazorecepcion/totalPages";
        }
        else
        {
            url1 = $"api/motivosrechazorecepcion?page={page}&filter={Filter}";
            url2 = $"api/motivosrechazorecepcion/totalPages?filter={Filter}";
        }

        var responseHppt = await repository.Get<List<MotivosRechazoRecepcion>>(url1);
        var responseHppt2 = await repository.Get<int>(url2);
        motivos = responseHppt.Response!;
        totalPages = responseHppt2.Response!;
    }

    private async Task DeleteAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Realmente deseas eliminar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si"
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        int status = -1;
        var responseHTTP = await repository.Delete($"api/motivosrechazorecepcion/cambiaStatus/{id}/{status}");
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await LoadAsync();
        }
    }

    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
    }

    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    private async Task ShowModal(int id = 0, bool isEdit = false)
    {
        IModalReference modalReference;

        if (isEdit)
        {
            modalReference = Modal.Show<MotivosRechazoRecepcionEdit>(string.Empty, new ModalParameters().Add("Id", id));
        }
        else
        {
            modalReference = Modal.Show<MotivosRechazoRecepcionCreate>();
        }

        var result = await modalReference.Result;
        if (result.Confirmed)
        {
            await LoadAsync();
        }
    }
}
