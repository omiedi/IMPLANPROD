@page "/dependencias/edit/{DependenciaId:int}"
@using IMPLANPROD.Client.Services
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject PageAccessService PageAccess

<PageTitle>Editar Filial</PageTitle>

<h3>Editar Filial</h3>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
    @if (dependencia is null)
    {
        <div class="spinner" />
    }
    else
    {
        <DependenciaForm @ref="dependenciaForm" Dependencia="dependencia" OnValidSubmit="EditAsync" ReturnAction="Return" />
    }
}

@code {
    private Dependencia? dependencia;
    private DependenciaForm? dependenciaForm;
    private bool validando = true;

    [Parameter]
    public int DependenciaId { get; set; }

    // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
    protected override async Task OnInitializedAsync()
    {
        await PageAccess.RequiereAccesoAsync("/dependencias/edit");
        validando = false;
        
        var responseHttp = await repository.Get<Dependencia>($"/api/dependencias/{DependenciaId}");
        if (responseHttp.Error)
        {
            if (responseHttp.HttpResponseMessage.StatusCode == HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/empresas");
                return;
            }

            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        dependencia = responseHttp.Response;
    }

    private async Task EditAsync()
    {
        var responseHttp = await repository.Put("/api/dependencias", dependencia);
        if (responseHttp.Error)
        {
            var message = await responseHttp.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        Return();
    }

    private void Return()
    {
        dependenciaForm!.FormPostedSuccessfully = true;
        navigationManager.NavigateTo($"/empresas/detalles/{dependencia!.EmpresaId}");
    }
}
