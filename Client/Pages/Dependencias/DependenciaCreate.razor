@page "/dependencias/create/{EmpresaId:int}"
@inject NavigationManager navigationManager
@inject IRepository repository
@inject SweetAlertService sweetAlertService
<h3>Crear Filial</h3>

<DependenciaForm @ref="dependenciaForm" Dependencia="dependencia" OnValidSubmit="CreateAsync" ReturnAction="Volver" />

@code {
    private Dependencia dependencia = new();
    private DependenciaForm? dependenciaForm;

    [Parameter]
    public int EmpresaId { get; set; }

    private async Task CreateAsync()
    {
        dependencia.EmpresaId = EmpresaId;
        
        var httpResponse = await repository.Post("api/dependencias", dependencia);

        if (httpResponse.Error)
        {
            var mensajeError = await httpResponse.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }
        Volver();
    }


    private void Volver()
    {
        dependenciaForm!.FormPostedSuccessfully = true;
        navigationManager.NavigateTo($"/empresas/detalles/{EmpresaId}");
    }
}
