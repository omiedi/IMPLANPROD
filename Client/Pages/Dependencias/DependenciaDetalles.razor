@page "/dependencias/detalles/{DependenciaId:int}"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService


@if (dependencia is null)
{
    <div class="spinner" />
}
else
{

    <div class="bg-primary text-white text-center p-3 mb-4">
        <!-- Añadido mb-4 para margen inferior -->
        <h1>Sectores de Filial: @dependencia.dependencia</h1>
    </div>

    <div class="d-flex align-items-center mb-3">
        <div class="me-2">
            <a class="btn btn-primary btn-sm" href="/sectores/create/@dependencia.Id">Nuevo sector</a>
            <a class="btn btn-success btn-sm" href="/empresas/detalles/@dependencia.EmpresaId">Regresar</a>

            @*             <a class="btn btn-sm btn-primary float-end" href="/sectores/create/@dependencia.Id" "><i class="oi oi-plus"></i> Nuevo sector</a>
        <a class="btn btn-sm btn-success float-end mx-2 href="/empresas/detalles/@dependencia.EmpresaId"><i class="oi oi-arrow-thick-left"></i> Regresar</a>
        *@
        </div>

        <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar Sector..." @bind-value="Filter" />

        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>


    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />

    <GenericList MyList="sector">
        <Body>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th> Sectores</th>
                        <th style="width:180px"></th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var sector in sector!)
                    {
                        <tr>

                            <td>
                                @sector.sector
                            </td>

                            <td>
                                <a href="/sectores/edit/@sector.Id" class="btn btn-warning btn-sm"><i class="oi oi-pencil" /> Editar</a>
@*                                 <button class="btn btn-danger btn-sm" @onclick=@(() => DeleteAsync(sector.Id))><i class="oi oi-trash" /> Borrar</button>
 *@                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>
}
@code {
