@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@inject IRepository repository
@inject SweetAlertService sweetAlertService

@* Modal de selección de lotes para productos trazables *@
@if (IsVisible)
{
    <div class="modal fade show" style="display: block" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">
                        <i class="fas fa-barcode me-2"></i>Seleccionar Lotes - @ProductoDescripcion
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (cargandoLotes)
                    {
                        <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
                            <div class="spinner-border text-warning" role="status">
                                <span class="visually-hidden">Cargando lotes...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Producto:</strong> @ProductoCodigo - @ProductoDescripcion<br />
                                    <strong>Depósito:</strong> @DepositoNombre<br />
                                    <strong>Cantidad solicitada:</strong> @CantidadSolicitada.ToString("N4")
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="alert @(CantidadTotalSeleccionada == CantidadSolicitada ? "alert-success" : CantidadTotalSeleccionada > CantidadSolicitada ? "alert-danger" : "alert-warning")">
                                    <i class="fas fa-calculator me-2"></i>
                                    <strong>Total seleccionado:</strong> @CantidadTotalSeleccionada.ToString("N4")<br />
                                    <strong>Pendiente:</strong> @((CantidadSolicitada - CantidadTotalSeleccionada).ToString("N4"))
                                </div>
                            </div>
                        </div>

                        @if (!lotesDisponibles.Any())
                        {
                            <div class="alert alert-warning text-center">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                <strong>No hay lotes disponibles con stock en este depósito.</strong>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-sm table-striped table-hover align-middle mb-0">
                                    <thead class="table-dark sticky-top">
                                        <tr>
                                            <th style="width: 200px;">Lote</th>
                                            <th style="width: 120px;" class="text-end">Saldo Disponible</th>
                                            <th style="width: 150px;" class="text-end">Cantidad a Remitir</th>
                                            <th style="width: 100px;" class="text-center">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var lote in lotesDisponibles)
                                        {
                                            var loteSeleccionado = lotesSeleccionados.FirstOrDefault(l => l.Lote == lote.Lote);
                                            var cantidadSeleccionada = loteSeleccionado?.Cantidad ?? 0;

                                            <tr class="@(cantidadSeleccionada > 0 ? "table-success" : "")">
                                                <td>
                                                    <strong>@lote.Lote</strong>
                                                </td>
                                                <td class="text-end">
                                                    <span class="badge bg-info">@lote.Saldo.ToString("N4")</span>
                                                </td>
                                                <td>
                                                    <input type="number" 
                                                           class="form-control form-control-sm text-end" 
                                                           step="0.0001"
                                                           min="0"
                                                           max="@lote.Saldo"
                                                           value="@cantidadSeleccionada"
                                                           @oninput="@(e => ActualizarCantidadLote(lote.Lote, lote.Saldo, e.Value?.ToString() ?? "0"))" />
                                                </td>
                                                <td class="text-center">
                                                    @if (cantidadSeleccionada > 0)
                                                    {
                                                        <button type="button" 
                                                                class="btn btn-sm btn-danger" 
                                                                @onclick="() => QuitarLote(lote.Lote)"
                                                                title="Quitar lote">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" 
                                                                class="btn btn-sm btn-success" 
                                                                @onclick="() => AgregarLoteCompleto(lote.Lote, lote.Saldo)"
                                                                title="Agregar todo el saldo">
                                                            <i class="fas fa-plus"></i> Todo
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-3">
                                <button type="button" 
                                        class="btn btn-sm btn-outline-primary" 
                                        @onclick="DistribuirAutomaticamente">
                                    <i class="fas fa-magic me-1"></i>Distribuir Automáticamente
                                </button>
                                <small class="text-muted ms-2">
                                    Distribuye la cantidad solicitada automáticamente entre los lotes disponibles (FIFO)
                                </small>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </button>
                    <button type="button" 
                            class="btn btn-success" 
                            @onclick="ConfirmarSeleccion"
                            disabled="@(!lotesSeleccionados.Any() || CantidadTotalSeleccionada != CantidadSolicitada)">
                        <i class="fas fa-check me-1"></i>Confirmar Selección
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public int ProductoCodInt { get; set; }
    [Parameter] public string ProductoCodigo { get; set; } = string.Empty;
    [Parameter] public string ProductoDescripcion { get; set; } = string.Empty;
    [Parameter] public int DepositoId { get; set; }
    [Parameter] public string DepositoNombre { get; set; } = string.Empty;
    [Parameter] public decimal CantidadSolicitada { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<List<LoteSeleccionado>> OnLotesConfirmados { get; set; }

    private bool cargandoLotes = false;
    private List<LoteDisponible> lotesDisponibles = new();
    private List<LoteSeleccionado> lotesSeleccionados = new();

    private decimal CantidadTotalSeleccionada => lotesSeleccionados.Sum(l => l.Cantidad);

    public class LoteDisponible
    {
        public string Lote { get; set; } = string.Empty;
        public decimal Saldo { get; set; }
    }

    public class LoteSeleccionado
    {
        public string Lote { get; set; } = string.Empty;
        public decimal Cantidad { get; set; }
        public decimal SaldoDisponible { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && ProductoCodInt > 0 && DepositoId > 0)
        {
            await CargarLotesDisponibles();
        }
    }

    private async Task CargarLotesDisponibles()
    {
        try
        {
            cargandoLotes = true;
            lotesDisponibles.Clear();
            lotesSeleccionados.Clear();
            StateHasChanged();

            Console.WriteLine($"[SeleccionLotesModal] Cargando lotes para CodInt: {ProductoCodInt}, Depósito: {DepositoId}");

            // Llamar al endpoint que devuelve los lotes con saldo
            var response = await repository.Get<List<LoteDisponible>>($"api/stock/lotes/{ProductoCodInt}/{DepositoId}");

            if (!response.Error && response.Response != null)
            {
                lotesDisponibles = response.Response.Where(l => l.Saldo > 0).OrderBy(l => l.Lote).ToList();
                Console.WriteLine($"[SeleccionLotesModal] Lotes cargados: {lotesDisponibles.Count}");
            }
            else
            {
                Console.WriteLine($"[SeleccionLotesModal] Error al cargar lotes: {await response.GetErrorMessageAsync()}");
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar los lotes disponibles.", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SeleccionLotesModal] Excepción al cargar lotes: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al cargar lotes: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            cargandoLotes = false;
            StateHasChanged();
        }
    }

    private void ActualizarCantidadLote(string lote, decimal saldoDisponible, string cantidadStr)
    {
        if (!decimal.TryParse(cantidadStr, out var cantidad))
        {
            cantidad = 0;
        }

        // Validar que no exceda el saldo disponible
        if (cantidad > saldoDisponible)
        {
            cantidad = saldoDisponible;
        }

        // Validar que no sea negativo
        if (cantidad < 0)
        {
            cantidad = 0;
        }

        var loteExistente = lotesSeleccionados.FirstOrDefault(l => l.Lote == lote);

        if (cantidad > 0)
        {
            if (loteExistente != null)
            {
                loteExistente.Cantidad = cantidad;
            }
            else
            {
                lotesSeleccionados.Add(new LoteSeleccionado
                {
                    Lote = lote,
                    Cantidad = cantidad,
                    SaldoDisponible = saldoDisponible
                });
            }
        }
        else
        {
            if (loteExistente != null)
            {
                lotesSeleccionados.Remove(loteExistente);
            }
        }

        StateHasChanged();
    }

    private void AgregarLoteCompleto(string lote, decimal saldo)
    {
        var loteExistente = lotesSeleccionados.FirstOrDefault(l => l.Lote == lote);

        if (loteExistente != null)
        {
            loteExistente.Cantidad = saldo;
        }
        else
        {
            lotesSeleccionados.Add(new LoteSeleccionado
            {
                Lote = lote,
                Cantidad = saldo,
                SaldoDisponible = saldo
            });
        }

        StateHasChanged();
    }

    private void QuitarLote(string lote)
    {
        var loteExistente = lotesSeleccionados.FirstOrDefault(l => l.Lote == lote);
        if (loteExistente != null)
        {
            lotesSeleccionados.Remove(loteExistente);
            StateHasChanged();
        }
    }

    private void DistribuirAutomaticamente()
    {
        lotesSeleccionados.Clear();
        decimal cantidadPendiente = CantidadSolicitada;

        foreach (var lote in lotesDisponibles.OrderBy(l => l.Lote))
        {
            if (cantidadPendiente <= 0) break;

            var cantidadAAsignar = Math.Min(cantidadPendiente, lote.Saldo);

            lotesSeleccionados.Add(new LoteSeleccionado
            {
                Lote = lote.Lote,
                Cantidad = cantidadAAsignar,
                SaldoDisponible = lote.Saldo
            });

            cantidadPendiente -= cantidadAAsignar;
        }

        StateHasChanged();
    }

    private async Task ConfirmarSeleccion()
    {
        if (CantidadTotalSeleccionada != CantidadSolicitada)
        {
            await sweetAlertService.FireAsync(
                "Cantidad incorrecta",
                $"La cantidad total seleccionada ({CantidadTotalSeleccionada:N4}) debe ser igual a la cantidad solicitada ({CantidadSolicitada:N4}).",
                SweetAlertIcon.Warning
            );
            return;
        }

        Console.WriteLine($"[SeleccionLotesModal] Confirmando selección de {lotesSeleccionados.Count} lotes");
        await OnLotesConfirmados.InvokeAsync(lotesSeleccionados);
        await CerrarModal();
    }

    private async Task CerrarModal()
    {
        lotesDisponibles.Clear();
        lotesSeleccionados.Clear();
        await OnClose.InvokeAsync();
    }
}
