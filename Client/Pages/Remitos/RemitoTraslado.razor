    /// <summary>
    /// Formatea el CUIT con guiones (XX-XXXXXXXX-X)
    /// </summary>
    private string FormatearCUIT(string cuit)
    {
        if (string.IsNullOrWhiteSpace(cuit) || cuit.Length != 11)
        {
            return cuit ?? "";
        }
        
        return $"{cuit.Substring(0, 2)}-{cuit.Substring(2, 8)}-{cuit.Substring(10, 1)}";
    }

    /// <summary>
    /// Cancela el formulario
    /// </summary>
    private void Cancelar()
    {
        productosRemito.Clear();
        referencia = string.Empty;
        observaciones = string.Empty;
        StateHasChanged();
    }

    /// <summary>
    /// Maneja el envío del formulario
    /// </summary>
    private async Task HandleValidSubmit()
    {
        // Evitar doble clic: si ya está guardando, ignorar el submit
        if (guardando) return;

        guardando = true;

        try
        {
            if (productosRemito.Count == 0)
            {
                await sweetAlertService.FireAsync("Error", "Debe agregar al menos un producto al remito", SweetAlertIcon.Error);
                return;
            }

            if (depositoOrigenSeleccionado == 0)
            {
                await sweetAlertService.FireAsync("Error", "Debe seleccionar un depósito de origen", SweetAlertIcon.Error);
                return;
            }

            if (depositoDestinoSeleccionado == 0)
            {
                await sweetAlertService.FireAsync("Error", "Debe seleccionar un depósito de destino", SweetAlertIcon.Error);
                return;
            }

            if (depositoOrigenSeleccionado == depositoDestinoSeleccionado)
            {
                await sweetAlertService.FireAsync("Error", "El depósito de origen y destino no pueden ser el mismo", SweetAlertIcon.Error);
                return;
            }

            // Crear DTO para enviar al backend
            var remitoTrasladoDTO = new RemitoTrasladoDTO
            {
                Prefijo = short.TryParse(prefijoRemito, out var prefijoInt) ? prefijoInt : (short)1,
                Numero = numeroRemito,
                Fecha = fechaRemito,
                NumeroCliente = numeroCliente,
                DepositoOrigen = depositoOrigenSeleccionado,
                DepositoDestino = depositoDestinoSeleccionado,
                Referencia = referencia,
                Observaciones = observaciones,
                Items = productosRemito.Select(p => new RemitoTrasladoItemDTO
                {
                    CodInt = p.CodInt,
                    Codigo = p.Codigo,
                    Descripcion = p.Descripcion,
                    Trazable = p.Trazable,
                    Cantidad = p.Cantidad,
                    Unidad = p.Unidad,
                    NroPedido = p.NroPedido,
                    NuOrItemPedido = p.NuOrItemPedido,
                    Lotes = p.Lotes.Select(l => new LoteDTO
                    {
                        Lote = l.Lote,
                        Cantidad = l.Cantidad
                    }).ToList()
                }).ToList()
            };

            var response = await repository.Post("api/remitotraslado", remitoTrasladoDTO);

            if (response.Error)
            {
                var errorMessage = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al guardar el remito: {errorMessage}", SweetAlertIcon.Error);
            }
            else
            {
                // Si el backend devolvió un número diferente (porque estaba duplicado y se recalculó), actualizarlo
                if (response.Response != null)
                {
                    var resultado = response.Response as dynamic;
                    if (resultado != null && resultado.prefijo != null && resultado.numero != null)
                    {
                        prefijoRemito = resultado.prefijo.ToString();
                        numeroRemito = Convert.ToInt32(resultado.numero);
                        Console.WriteLine($"[RemitoTraslado] Número actualizado por backend: {prefijoRemito}-{numeroRemito}");
                        StateHasChanged();
                    }
                }

                await sweetAlertService.FireAsync("Éxito", "Remito de traslado guardado correctamente", SweetAlertIcon.Success);

                // Preparar e imprimir el remito
                await PrepararEImprimirRemito();

                // Limpiar el detalle del formulario y recalcular el siguiente número de autonumeración
                // para que el próximo remito proponga el siguiente libre.
                Cancelar();
                await CalcularNumeroRemitoAutonumeracion();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoTraslado] Error al guardar remito: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al guardar el remito: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            // Liberar el bloqueo siempre, incluso si hubo error o validación fallida
            guardando = false;
        }
    }

    /// <summary>
    /// Abre el selector de clientes
    /// </summary>
    private async Task AbrirSelectorClientes()
    {
        await selectorClientes.AbrirModal();
    }

    /// <summary>
    /// Maneja la selección de un cliente
    /// </summary>
    private async Task OnClienteSeleccionado(SelectorClientes.ClienteSeleccionado cliente)
    {
        try
        {
            Console.WriteLine($"[RemitoTraslado] Cliente seleccionado: {cliente.NumeCli} - {cliente.RazonSocial}");

            // Cargar datos completos del cliente
            var response = await repository.Get<Deudor12>($"api/deudor12/numero/{cliente.NumeCli}");

            if (response.Error || response.Response == null)
            {
                Console.WriteLine($"[RemitoTraslado] Error al cargar datos del cliente: {response.Error}");
                await sweetAlertService.FireAsync("Error", "Error al cargar datos del cliente", SweetAlertIcon.Error);
                return;
            }

            var clienteData = response.Response;

            // Asignar datos del cliente
            // Se usa Raso_Cli (razón social) en lugar de Fant_Cli (nombre de fantasía),
            // que puede estar vacío o no corresponder a la razón social real del cliente.
            numeroCliente = clienteData.Nume_Cli;
            clienteSeleccionado = $"{clienteData.Nume_Cli} - {clienteData.Raso_Cli}";
            razonSocial = clienteData.Raso_Cli ?? "";
            domicilioCliente = clienteData.Domi_Cli ?? "";
            localidadCliente = clienteData.Loca_Cli ?? "";
            codigoPostalCliente = clienteData.Cpos_Cli ?? "";
            cuitCliente = clienteData.Cuit_Cli ?? "";

            Console.WriteLine($"[RemitoTraslado] Datos del cliente cargados: {razonSocial}");

            // Cerrar el modal
            selectorClientes.CerrarModal();

            // Los pedidos pendientes se muestran a pedido del usuario mediante el
            // botón "Mostrar Pedidos Pendientes", que requiere además un depósito
            // de origen seleccionado para poder consultar el stock de cada producto.

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoTraslado] Error al cargar datos del cliente: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al cargar datos del cliente: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Limpia los datos del cliente seleccionado
    /// </summary>
    private void LimpiarCliente()
    {
        clienteSeleccionado = string.Empty;
        razonSocial = string.Empty;
        domicilioCliente = string.Empty;
        localidadCliente = string.Empty;
        codigoPostalCliente = string.Empty;
        cuitCliente = string.Empty;
        numeroCliente = 0;
        StateHasChanged();
    }

    /// <summary>
    /// Pasa los archivos de la ruta temporal a la ruta definitiva
    /// </summary>
    private async Task PasarArchivosASucursal()
    {
        try
        {
            Console.WriteLine("[RemitoTraslado] Iniciando proceso de pasar archivos a sucursal");

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Pasar archivos a sucursal",
                Text = "¿Desea pasar los archivos de la ruta temporal a la ruta definitiva?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, pasar",
                CancelButtonText = "Cancelar",
                ConfirmButtonColor = "#28a745",
                CancelButtonColor = "#dc3545"
            });

            if (!result.IsConfirmed)
            {
                Console.WriteLine("[RemitoTraslado] Operación cancelada por el usuario");
                return;
            }

            var response = await repository.Post<object>("api/remitotraslado/mover-archivos", null);

            if (response.Error)
            {
                var errorMessage = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al pasar archivos: {errorMessage}", SweetAlertIcon.Error);
            }
            else
            {
                await sweetAlertService.FireAsync("Éxito", "Archivos pasados a sucursal correctamente", SweetAlertIcon.Success);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoTraslado] Error al pasar archivos: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al pasar archivos: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Recepción de Materiales de Central
    /// Lee los archivos de la ruta definitiva configurada
    /// </summary>
    private async Task RecepcionMaterialesCentral()
    {
        try
        {
            Console.WriteLine("[RemitoTraslado] Iniciando recepción de materiales de central");

            if (string.IsNullOrWhiteSpace(rutaDefinitiva))
            {
                await sweetAlertService.FireAsync("Error", "La ruta definitiva no está configurada. Por favor, configure la ruta en el modal de configuración.", SweetAlertIcon.Error);
                return;
            }

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Recepción de Materiales de Central",
                Text = $"¿Desea procesar los archivos de la ruta definitiva?\n\nRuta: {rutaDefinitiva}",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, procesar",
                CancelButtonText = "Cancelar",
                ConfirmButtonColor = "#17a2b8",
                CancelButtonColor = "#dc3545"
            });

            if (!result.IsConfirmed)
            {
                Console.WriteLine("[RemitoTraslado] Operación cancelada por el usuario");
                return;
            }

            // Llamar al endpoint API para procesar archivos
            var response = await repository.Post<object, RecepcionMaterialesResult>("api/remitotraslado/recepcion-materiales", null);

            if (response.Error)
            {
                var errorMessage = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al procesar recepción: {errorMessage}", SweetAlertIcon.Error);
            }
            else
            {
                var resultado = response.Response as RecepcionMaterialesResult;
                if (resultado != null)
                {
                    string mensaje = resultado.Mensaje;

                    if (resultado.Errores.Any())
                    {
                        mensaje += $"\n\nErrores: {string.Join("\n", resultado.Errores.Take(3))}";
                        if (resultado.Errores.Count > 3)
                        {
                            mensaje += $"\n... y {resultado.Errores.Count - 3} errores más";
                        }
                    }

                    // Si no se procesaron archivos, mostrar como información
                    var icono = resultado.ArchivosProcesados > 0 ? SweetAlertIcon.Success : SweetAlertIcon.Info;
                    var titulo = resultado.ArchivosProcesados > 0 ? "Éxito" : "Información";

                    await sweetAlertService.FireAsync(
                        titulo,
                        mensaje,
                        icono);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoTraslado] Error en recepción de materiales: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error en recepción de materiales: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Punto de entrada del botón "Mostrar Pedidos Pendientes".
    /// Valida que haya un cliente y un depósito de origen seleccionados antes de abrir el modal.
    /// </summary>
    private async Task MostrarPedidosPendientesAsync()
    {
        if (numeroCliente == 0)
        {
            await sweetAlertService.FireAsync("Atención", "Debe seleccionar un cliente antes de ver los pedidos pendientes.", SweetAlertIcon.Warning);
            return;
        }

        if (depositoOrigenSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Atención", "Debe seleccionar un depósito de origen antes de ver los pedidos pendientes.", SweetAlertIcon.Warning);
            return;
        }

        await VerificarPedidosPendientes(numeroCliente);
    }

    /// <summary>
    /// Verifica si el cliente tiene pedidos pendientes y muestra el modal
    /// </summary>
    private async Task VerificarPedidosPendientes(int numeroCliente)
    {
        try
        {
            Console.WriteLine($"[RemitoTraslado] Verificando pedidos pendientes para cliente {numeroCliente}");

            // Consultar pedidos pendientes del cliente
            var response = await repository.Get<List<Peddeta>>($"api/peddeta/pendientes/{numeroCliente}");

            if (response.Error)
            {
                Console.WriteLine($"[RemitoTraslado] Error al consultar pedidos pendientes: {response.Error}");
                return;
            }

            var pedidosPendientes = response.Response ?? new List<Peddeta>();

            if (pedidosPendientes.Any())
            {
                Console.WriteLine($"[RemitoTraslado] Se encontraron {pedidosPendientes.Count} items pendientes");

                // Convertir a PeddetaConCantidad y cargar el stock del depósito de origen seleccionado
                var pedidosConCantidad = new List<PeddetaConCantidad>();
                foreach (var p in pedidosPendientes)
                {
                    var item = new PeddetaConCantidad
                    {
                        PeddetaId = p.PeddetaId,
                        NroPed = p.NroPed,
                        FeSolEnt = p.FeSolEnt,
                        CodiInt = p.CodiInt,
                        CodiExt = p.CodiExt,
                        Descrip = p.Descrip,
                        CanSaldo = p.CanSaldo,
                        CanPed = p.CanPed,
                        CantEnt = p.CantEnt,
                        NroClie = p.NroClie,
                        TipoPed = p.TipoPed,
                        NroOcom = p.NroOcom,
                        NuOrItem = p.NuOrItem,
                        CantidadARemitir = 0
                    };

                    // Cargar stock del producto en el depósito de origen seleccionado
                    if (p.CodiInt.HasValue && p.CodiInt.Value > 0 && depositoOrigenSeleccionado > 0)
                    {
                        try
                        {
                            var respStock = await repository.Get<decimal>($"api/stock/stockdeposito/{p.CodiInt.Value}/{depositoOrigenSeleccionado}");
                            if (!respStock.Error)
                            {
                                item.StockDeposito = respStock.Response;
                            }
                        }
                        catch (Exception exStock)
                        {
                            Console.WriteLine($"[RemitoTraslado] Error al cargar stock para producto {p.CodiInt}: {exStock.Message}");
                        }
                    }

                    pedidosConCantidad.Add(item);
                }

                // Obtener nombres para mostrar en el encabezado del modal
                var nombreCliente = razonSocial;
                var nombreDeposito = ObtenerNombreDepositoOrigen();

                // Mostrar modal con pedidos pendientes
                var parameters = new ModalParameters();
                parameters.Add(nameof(PedidosPendientesModal.pedidosPendientes), pedidosConCantidad);
                parameters.Add(nameof(PedidosPendientesModal.NombreCliente), nombreCliente);
                parameters.Add(nameof(PedidosPendientesModal.NombreDeposito), nombreDeposito);

                var modal = modalService.Show<PedidosPendientesModal>("Pedidos Pendientes", parameters, new ModalOptions
                {
                    Size = ModalSize.ExtraLarge,
                    DisableBackgroundCancel = true,
                    HideCloseButton = false
                });

                var result = await modal.Result;

                if (!result.Cancelled && result.Data != null)
                {
                    var itemsSeleccionados = (List<PeddetaConCantidad>)result.Data;
                    Console.WriteLine($"[RemitoTraslado] Items seleccionados: {itemsSeleccionados.Count}");

                    // Agregar los items seleccionados al remito
                    await AgregarItemsDesdePedidos(itemsSeleccionados);
                }
            }
            else
            {
                await sweetAlertService.FireAsync("Información", "No se encontraron pedidos pendientes para este cliente.", SweetAlertIcon.Info);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoTraslado] Error al verificar pedidos pendientes: {ex.Message}");
        }
    }

    /// <summary>
    /// Agrega items al remito desde los pedidos seleccionados
    /// </summary>
    private async Task AgregarItemsDesdePedidos(List<PeddetaConCantidad> items)
    {
        try
        {
            foreach (var item in items)
            {
                if (item.CodiInt.HasValue && item.CantidadARemitir > 0)
                {
                    // Buscar el producto en Master
                    var responseProducto = await repository.Get<Master>($"api/master/xCodint{item.CodiInt.Value}");

                    if (responseProducto.Error || responseProducto.Response == null)
                    {
                        Console.WriteLine($"[RemitoTraslado] Error al buscar producto {item.CodiInt.Value}");
                        continue;
                    }

                    var producto = responseProducto.Response;

                    // Verificar si el producto es trazable
                    if (producto.Trazable == 1)
                    {
                        // Abrir modal de selección de lotes
                        productoTrazableSeleccionado = producto;
                        cantidadSolicitadaTrazable = item.CantidadARemitir;
                        mostrarModalLotes = true;
                        StateHasChanged();
                    }
                    else
                    {
                        // Producto no trazable, agregar directamente con datos de pedido
                        AgregarProductoARemito(producto.Codint, producto.Codigo ?? "", producto.Descripcion ?? "", producto.Trazable ?? 0, item.CantidadARemitir, producto.Umedida ?? "", item.NroPed, item.NuOrItem);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoTraslado] Error al agregar items desde pedidos: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al agregar items desde pedidos: {ex.Message}", SweetAlertIcon.Error);
        }
    }
}
