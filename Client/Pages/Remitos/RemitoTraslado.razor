    /// <summary>
    /// Agrega un producto al remito
    /// </summary>
    private void AgregarProductoARemito(int codInt, string codigo, string descripcion, short trazable, decimal cantidad, string unidad, long? nroPedido = null, int? nuOrItemPedido = null)
    {
        // Verificar si el producto ya está en el remito
        var productoExistente = productosRemito.FirstOrDefault(p => p.CodInt == codInt);

        if (productoExistente != null)
        {
            // Sumar la cantidad
            productoExistente.Cantidad += cantidad;
        }
        else
        {
            // Agregar nuevo producto
            var nuevoProducto = new ProductoRemito
            {
                CodInt = codInt,
                Codigo = codigo,
                Descripcion = descripcion,
                Trazable = trazable,
                Cantidad = cantidad,
                Unidad = unidad,
                NroPedido = nroPedido,
                NuOrItemPedido = nuOrItemPedido
            };

            productosRemito.Add(nuevoProducto);
        }

        Console.WriteLine($"[RemitoTraslado] Producto agregado: {codigo} - Cantidad: {cantidad}");
        StateHasChanged();
    }

