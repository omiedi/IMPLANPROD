    /// <summary>
    /// Prepara los datos e imprime el remito
    /// </summary>
    private async Task PrepararEImprimirRemito()
    {
        try
        {
            Console.WriteLine("[RemitoTraslado] Preparando impresión del remito...");

            // Limpiar todas las variables antes de preparar la impresión
            LimpiarVariablesImpresion();

            // Obtener código de movimiento (usando el mismo servicio que RemitoCliente)
            var codigoMovimiento = await remitosConfigService.ObtenerCodigoMovimientoAsync();

            // Preparar número de remito completo (formato igual que RemitoCliente)
            numeroRemitoImpresion = $"{codigoMovimiento}-X-{ObtenerPrefijoFormateado()}-{numeroRemito.ToString("D8")}";
            
            // Preparar fecha
            fechaImpresion = fechaRemito.ToString("dd/MM/yy");
            
            // Preparar datos del cliente
            razonSocialImpresion = razonSocial;
            domicilioImpresion = domicilioCliente;
            
            // Formatear CUIT con guiones (XX-XXXXXXXX-X)
            cuitImpresion = FormatearCUIT(cuitCliente);
            
            localidadImpresion = localidadCliente;
            
            // Obtener condición de IVA del cliente desde TipoIvaEnum
            if (numeroCliente > 0)
            {
                var responseCliente = await repository.Get<Deudor12>($"api/Deudor12/numero/{numeroCliente}");
                if (!responseCliente.Error && responseCliente.Response != null)
                {
                    var cliente = responseCliente.Response;
                    
                    // Obtener la descripción de IVA desde TipoIvaEnum usando Piva_Cli
                    condicionIVAImpresion = TipoIvaHelper.ObtenerDescripcionIvaPorCodigo(cliente.Piva_Cli);
                    Console.WriteLine($"[RemitoTraslado] Condición IVA: Código={cliente.Piva_Cli}, Descripción={condicionIVAImpresion}");
                }
            }
            
            // Preparar orden de compra (referencia)
            ordenCompraImpresion = referencia;
            
            // Obtener orden de venta del primer producto que tenga pedido
            var primerProductoConPedido = productosRemito.FirstOrDefault(p => p.NroPedido.HasValue);
            if (primerProductoConPedido != null)
            {
                ordenVentaImpresion = primerProductoConPedido.NroPedido.ToString() ?? "";
            }
            else
            {
                ordenVentaImpresion = "";
            }
            
            // Preparar items del remito
            itemsImpresion = productosRemito.Select(p => new ImpresionRemito.ItemRemito
            {
                Cantidad = p.Cantidad,
                Codigo = p.Codigo,
                Descripcion = p.Descripcion
            }).ToList();
            
            // Preparar observaciones
            observacionesImpresion = observaciones;
            
            // Valor declarado vacío (no se usa en traslado)
            valorDeclaradoImpresion = "";
            
            // Bultos por defecto 1 (no se usa en traslado)
            bultosImpresion = 1;
            
            // NCI vacío (no se usa en traslado)
            nciImpresion = "";
            
            Console.WriteLine($"[RemitoTraslado] Datos preparados para impresión: {numeroRemitoImpresion}");

            // Forzar actualización del componente
            StateHasChanged();

            // Imprimir usando la plantilla "RemitoConsignacion2" del Diseñador de Plantillas.
            // Se pasan 3 parámetros de MOVISTO: DoPriLar (RC.{numero}), Nume_Clie y Fechmov.
            // El DoPriLar se construye igual que en el servidor (RemitoTrasladoController línea 139):
            //   string documentoRemito = $"RC.{request.Numero}";
            var doPriLar = $"RC.{numeroRemito}";
            await ImprimirRemitoConsignacionPorPlantillaAsync(doPriLar, numeroCliente, fechaRemito);

            Console.WriteLine("[RemitoTraslado] Impresión por plantilla iniciada");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoTraslado] Error al preparar impresión: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al preparar la impresión: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Imprime un remito de traslado usando la plantilla "RemitoConsignacion2"
    /// del Diseñador de Plantillas de impresión.
    /// Parámetros que se le pasan a la plantilla (todos de MOVISTO):
    ///   - Doprilar: documento primario largo (ej. "RC.1234")
    ///   - Nume_Clie: número de cliente
    ///   - Fechmov: fecha del movimiento
    /// </summary>
    private async Task ImprimirRemitoConsignacionPorPlantillaAsync(string doPriLar, int numeClie, DateTime fechMov)
    {
        if (string.IsNullOrWhiteSpace(doPriLar))
        {
            await sweetAlertService.FireAsync("Atención", "El remito no tiene número para imprimir.", SweetAlertIcon.Warning);
            return;
        }

        var plantillaId = await GetPlantillaRemitoConsignacionIdAsync();
        if (!plantillaId.HasValue)
        {
            return;
        }

        var queryParams = new List<string>
        {
            $"Doprilar={Uri.EscapeDataString(doPriLar.Trim())}",
            $"Nume_Clie={numeClie}"
        };

        if (fechMov > DateTime.MinValue)
        {
            queryParams.Add($"Fechmov={Uri.EscapeDataString(fechMov.ToString("yyyy-MM-dd"))}");
        }

        var endpoint = $"api/impresiones/remito-plantillas/{plantillaId.Value}/pdf?{string.Join("&", queryParams)}";
        var responsePdf = await Http.GetAsync(endpoint);

        if (!responsePdf.IsSuccessStatusCode)
        {
            var message = await responsePdf.Content.ReadAsStringAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo generar el PDF del remito: {message}", SweetAlertIcon.Error);
            return;
        }

        var pdfBytes = await responsePdf.Content.ReadAsByteArrayAsync();
        if (pdfBytes.Length == 0)
        {
            await sweetAlertService.FireAsync("Error", "El PDF generado está vacío.", SweetAlertIcon.Error);
            return;
        }

        var base64 = Convert.ToBase64String(pdfBytes);
        var opened = await JS.InvokeAsync<bool>("openPdfInNewTab", base64);
        if (!opened)
        {
            await sweetAlertService.FireAsync("Atención", "No se pudo abrir el PDF en una nueva pestaña. Verificá el bloqueador de pop-ups.", SweetAlertIcon.Warning);
        }
    }

    /// <summary>
    /// Busca el Id de la plantilla "RemitoConsignacion2" en el listado de plantillas
    /// guardadas por el Diseñador de Plantillas.
    /// </summary>
    private async Task<int?> GetPlantillaRemitoConsignacionIdAsync()
    {
        if (plantillaRemitoConsignacionId.HasValue)
        {
            return plantillaRemitoConsignacionId;
        }

        var response = await repository.Get<List<RemitoPlantillaItemDto>>("api/impresiones/remito-plantillas");
        if (response.Error || response.Response == null)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo obtener el listado de plantillas de remito: {message}", SweetAlertIcon.Error);
            return null;
        }

        var plantilla = response.Response
            .FirstOrDefault(x => string.Equals(x.Nombre?.Trim(), NombrePlantillaRemitoConsignacion, StringComparison.OrdinalIgnoreCase));

        if (plantilla == null)
        {
            await sweetAlertService.FireAsync("Atención", $"No se encontró la plantilla '{NombrePlantillaRemitoConsignacion}'.", SweetAlertIcon.Warning);
            return null;
        }

        plantillaRemitoConsignacionId = plantilla.Id;
        return plantillaRemitoConsignacionId;
    }

