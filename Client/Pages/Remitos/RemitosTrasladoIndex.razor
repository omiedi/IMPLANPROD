@page "/remitos/traslado-index"
<PageTitle>Consulta de Remitos de Traslado</PageTitle>
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.DTOs.Impresiones
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Shared.Components
@using IMPLANPROD.Client.Pages.Reportes
@using IMPLANPROD.Client.Helpers
@using IMPLANPROD.Client.Services
@inject IRepository repository
@inject HttpClient Http
@inject IJSRuntime JS
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager
@inject PageAccessService PageAccess

<PageTitle>Consulta de Remitos de Traslado</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
<div class="container-fluid">
    <!-- Título de la página -->
    <div class="mb-4">
        <h2 class="text-center fw-bold text-primary">
            <i class="fas fa-exchange-alt me-2"></i>
            REMITOS DE TRASLADO
        </h2>
        <hr class="border-primary border-2 opacity-50" />
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-search me-2"></i>Consulta de Remitos de Traslado
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Mes:</label>
                            <select class="form-select" @bind="mesSeleccionado">
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Año:</label>
                            <input type="number" class="form-control" @bind="anioSeleccionado" min="2000" max="2099" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Cliente (Opcional):</label>
                            <div class="input-group">
                                <input type="text"
                                       class="form-control"
                                       @bind="clienteSeleccionado"
                                       readonly
                                       placeholder="Todos los clientes" />
                                @if (!string.IsNullOrEmpty(clienteSeleccionado))
                                {
                                    <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarCliente" title="Limpiar Cliente">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-outline-primary" @onclick="AbrirSelectorClientes" title="Seleccionar Cliente">
                                    <i class="fas fa-users"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-primary w-100" @onclick="CargarRemitos" disabled="@cargandoRemitos">
                                @if (cargandoRemitos)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="fas fa-search me-2"></i>Buscar
                            </button>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-secondary w-100" @onclick="Volver">
                                <i class="fas fa-arrow-left me-2"></i>Volver
                            </button>
                        </div>
                    </div>

                    @if (remitos.Any())
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Período:</strong> @ObtenerNombreMes(mesSeleccionado) de @anioSeleccionado
                            <span class="ms-3">
                                <strong>Remitos encontrados:</strong> @remitos.Count
                            </span>
                        </div>
                    }

                    @if (cargandoRemitos)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando remitos...</span>
                            </div>
                            <p class="mt-3">Cargando remitos de traslado del período seleccionado...</p>
                        </div>
                    }
                    else if (remitos.Any())
                    {
                        <div class="d-flex justify-content-end mb-3">
                            <button class="btn btn-outline-success" @onclick="ConfirmarImpresionAsync" disabled="@isPrinting">
                                <i class="oi oi-print"></i> Imprimir/Exp.Excel
                            </button>
                            @if (isPrinting)
                            {
                                <div class="ms-2 d-flex align-items-center">
                                    <div class="spinner-border text-success" role="status">
                                        <span class="visually-hidden">Preparando impresión...</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead class="table-dark">
                                <tr>
                                    <th>Remito</th>
                                    <th>Cliente</th>
                                    <th>Razón Social</th>
                                    <th>Fecha</th>
                                    <th>Referencia</th>
                                    <th>Estado</th>
                                    <th style="width: 160px;">Acciones</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var remito in remitos)
                                {
                                    var esAnulado = !string.IsNullOrEmpty(remito.ReferCor) && remito.ReferCor.StartsWith("(Anul)");
                                    <tr>
                                        <td><strong>@remito.DoPriLar</strong></td>
                                        <td>@remito.NumeClie</td>
                                        <td>@remito.RazonSocial</td>
                                        <td>@remito.FechMov.ToString("dd/MM/yyyy")</td>
                                        <td>@remito.ReferCor</td>
                                        <td>
                                            @if (esAnulado)
                                            {
                                                <span class="badge bg-danger">Anulado</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Vigente</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary"
                                                    @onclick="() => ImprimirRemito(remito)"
                                                    title="Imprimir Remito"
                                                    disabled="@imprimiendoRemito">
                                                <i class="fas fa-print"></i>
                                            </button>
                                            @if (!esAnulado)
                                            {
                                                <button class="btn btn-sm btn-outline-danger ms-1"
                                                        @onclick="() => SeleccionarRemitoParaAnular(remito)"
                                                        title="Anular Remito"
                                                        disabled="@anulandoRemito">
                                                    @if (anulandoRemitoId == remito.DoPriCor)
                                                    {
                                                        <span class="spinner-border spinner-border-sm"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-ban"></i>
                                                    }
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (!cargandoRemitos && mesSeleccionado > 0 && anioSeleccionado > 0)
                    {
                        <div class="alert alert-warning text-center">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No se encontraron remitos de traslado para el período seleccionado.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center">
                            <i class="fas fa-info-circle me-2"></i>
                            Seleccione un mes y año, luego haga clic en "Buscar" para ver los remitos de traslado disponibles.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
}

<SelectorClientes @ref="selectorClientes" OnClienteSeleccionado="OnClienteSeleccionado" />

<!-- Componente de Impresión de Remito -->
<ImpresionRemito @ref="impresionRemito"
                 NCI="@nciImpresion"
                 NumeroRemito="@numeroRemitoImpresion"
                 Fecha="@fechaImpresion"
                 RazonSocial="@razonSocialImpresion"
                 Domicilio="@domicilioImpresion"
                 CUIT="@cuitImpresion"
                 CondicionIVA="@condicionIVAImpresion"
                 Localidad="@localidadImpresion"
                 OrdenCompra="@ordenCompraImpresion"
                 OrdenVenta="@ordenVentaImpresion"
                 Items="@itemsImpresion"
                 Observaciones="@observacionesImpresion"
                 ValorDeclarado="@valorDeclaradoImpresion"
                 Bultos="@bultosImpresion" />

@if (remitos.Any())
{
    <ImpresionLista TItem="RemitoAnularDTO"
                    Datos="remitos"
                    Titulo="@TituloReporte"
                    UrlExportarExcel="api/excel/exportar-remitos"
                    Encabezados="encabezadosRemitos"
                    ModoDirecto="false"
                    MostrarModal="mostrarModalImpresion"
                    OnCerrar="ResetearImpresion" />
}

@code {
    private SelectorClientes selectorClientes = null!;
    private ImpresionRemito impresionRemito = null!;
    private int mesSeleccionado = DateTime.Now.Month;
    private int anioSeleccionado = DateTime.Now.Year;
    private bool cargandoRemitos = false;
    private List<RemitoAnularDTO> remitos = new();
    private int? numeroClienteSeleccionado = null;
    private string clienteSeleccionado = string.Empty;
    private bool isPrinting = false;
    private bool mostrarModalImpresion = false;
    private string TituloReporte => "Listado de Remitos de Traslado";
    private bool validando = true;
    
    // Variables para impresión de remito individual
    private bool imprimiendoRemito = false;

    // Variables para anulación de remito (patrón anti-doble-clic)
    private bool anulandoRemito = false;
    private string? anulandoRemitoId = null;

    // Plantilla de impresión del Diseñador de Plantillas.
    // Debe coincidir con la usada en /remitos/traslado (RemitoTraslado.razor).
    private const string NombrePlantillaRemitoConsignacion = "RemitoConsignacion2";
    private int? plantillaRemitoConsignacionId;

    private string nciImpresion = "";
    private string numeroRemitoImpresion = "";
    private string fechaImpresion = "";
    private string razonSocialImpresion = "";
    private string domicilioImpresion = "";
    private string cuitImpresion = "";
    private string condicionIVAImpresion = "";
    private string localidadImpresion = "";
    private string ordenCompraImpresion = "";
    private string ordenVentaImpresion = "";
    private List<ImpresionRemito.ItemRemito> itemsImpresion = new();
    private string observacionesImpresion = "";
    private string valorDeclaradoImpresion = "";
    private int bultosImpresion = 1;

    private Dictionary<string, string> encabezadosRemitos = new()
    {
        { "DoPriCor", "Remito" },
        { "NumeClie", "Cliente" },
        { "RazonSocial", "Razón Social" },
        { "FechMov", "Fecha" },
        { "ReferCor", "Referencia" }
    };

    protected override async Task OnInitializedAsync()
    {
        // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
        await PageAccess.RequiereAccesoAsync("/remitos/traslado-index");
        validando = false;
    }

    private async Task CargarRemitos()
    {
        try
        {
            cargandoRemitos = true;
            StateHasChanged();

            string url = $"api/movistock/remitos-traslado-mes/{anioSeleccionado}/{mesSeleccionado}";
            if (numeroClienteSeleccionado.HasValue)
            {
                url += $"?numeroCliente={numeroClienteSeleccionado.Value}";
            }

            var response = await repository.Get<List<RemitoAnularDTO>>(url);

            if (!response.Error && response.Response != null)
            {
                remitos = response.Response;
            }
            else
            {
                var errorMsg = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar remitos de traslado: {errorMsg}", SweetAlertIcon.Error);
                remitos = new List<RemitoAnularDTO>();
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al cargar remitos de traslado: {ex.Message}", SweetAlertIcon.Error);
            remitos = new List<RemitoAnularDTO>();
        }
        finally
        {
            cargandoRemitos = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmarImpresionAsync()
    {
        if (remitos == null || !remitos.Any())
        {
            await sweetAlertService.FireAsync("Información", "No hay remitos para imprimir.", SweetAlertIcon.Info);
            return;
        }

        isPrinting = true;
        StateHasChanged();

        try
        {
            var cantidadTotal = remitos.Count;

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmar impresión",
                Text = $"Se van a imprimir/exportar {cantidadTotal} remitos de traslado del período actual.\n¿Desea continuar?",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, continuar",
                CancelButtonText = "Cancelar"
            });

            if (result.IsConfirmed)
            {
                mostrarModalImpresion = true;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    private void ResetearImpresion()
    {
        mostrarModalImpresion = false;
        StateHasChanged();
    }

    private async Task AbrirSelectorClientes()
    {
        await selectorClientes.AbrirModal();
    }

    private void OnClienteSeleccionado(SelectorClientes.ClienteSeleccionado cliente)
    {
        numeroClienteSeleccionado = cliente.NumeCli;
        clienteSeleccionado = $"{cliente.NumeCli} - {cliente.RazonSocial}";
        StateHasChanged();
    }

    private void LimpiarCliente()
    {
        numeroClienteSeleccionado = null;
        clienteSeleccionado = string.Empty;
        StateHasChanged();
    }

    private string ObtenerNombreMes(int mes)
    {
        return mes switch
        {
            1 => "Enero",
            2 => "Febrero",
            3 => "Marzo",
            4 => "Abril",
            5 => "Mayo",
            6 => "Junio",
            7 => "Julio",
            8 => "Agosto",
            9 => "Septiembre",
            10 => "Octubre",
            11 => "Noviembre",
            12 => "Diciembre",
            _ => string.Empty
        };
    }

    /// <summary>
    /// Imprime un remito existente usando la plantilla "RemitoConsignacion2"
    /// del Diseñador de Plantillas, igual que al generarlo en /remitos/traslado.
    /// </summary>
    private async Task ImprimirRemito(RemitoAnularDTO remito)
    {
        try
        {
            imprimiendoRemito = true;
            StateHasChanged();

            Console.WriteLine($"[RemitosTrasladoIndex] Imprimiendo remito por plantilla: {remito.DoPriLar}");

            await ImprimirRemitoConsignacionPorPlantillaAsync(
                remito.DoPriLar ?? string.Empty,
                remito.NumeClie,
                remito.FechMov);

            Console.WriteLine("[RemitosTrasladoIndex] Impresión por plantilla iniciada");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitosTrasladoIndex] Error al preparar impresión: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al preparar la impresión: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            imprimiendoRemito = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Imprime un remito de traslado usando la plantilla "RemitoConsignacion2"
    /// del Diseñador de Plantillas de impresión.
    /// Parámetros que se le pasan a la plantilla (todos de MOVISTO):
    ///   - Doprilar: documento primario largo (ej. "RC.1234")
    ///   - Nume_Clie: número de cliente
    ///   - Fechmov: fecha del movimiento
    /// </summary>
    private async Task ImprimirRemitoConsignacionPorPlantillaAsync(string doPriLar, int numeClie, DateTime fechMov)
    {
        if (string.IsNullOrWhiteSpace(doPriLar))
        {
            await sweetAlertService.FireAsync("Atención", "El remito no tiene número para imprimir.", SweetAlertIcon.Warning);
            return;
        }

        var plantillaId = await GetPlantillaRemitoConsignacionIdAsync();
        if (!plantillaId.HasValue)
        {
            return;
        }

        var queryParams = new List<string>
        {
            $"Doprilar={Uri.EscapeDataString(doPriLar.Trim())}",
            $"Nume_Clie={numeClie}"
        };

        if (fechMov > DateTime.MinValue)
        {
            queryParams.Add($"Fechmov={Uri.EscapeDataString(fechMov.ToString("yyyy-MM-dd"))}");
        }

        var endpoint = $"api/impresiones/remito-plantillas/{plantillaId.Value}/pdf?{string.Join("&", queryParams)}";
        var responsePdf = await Http.GetAsync(endpoint);

        if (!responsePdf.IsSuccessStatusCode)
        {
            var message = await responsePdf.Content.ReadAsStringAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo generar el PDF del remito: {message}", SweetAlertIcon.Error);
            return;
        }

        var pdfBytes = await responsePdf.Content.ReadAsByteArrayAsync();
        if (pdfBytes.Length == 0)
        {
            await sweetAlertService.FireAsync("Error", "El PDF generado está vacío.", SweetAlertIcon.Error);
            return;
        }

        var base64 = Convert.ToBase64String(pdfBytes);
        var opened = await JS.InvokeAsync<bool>("openPdfInNewTab", base64);
        if (!opened)
        {
            await sweetAlertService.FireAsync("Atención", "No se pudo abrir el PDF en una nueva pestaña. Verificá el bloqueador de pop-ups.", SweetAlertIcon.Warning);
        }
    }

    /// <summary>
    /// Busca el Id de la plantilla "RemitoConsignacion2" en el listado de plantillas
    /// guardadas por el Diseñador de Plantillas.
    /// </summary>
    private async Task<int?> GetPlantillaRemitoConsignacionIdAsync()
    {
        if (plantillaRemitoConsignacionId.HasValue)
        {
            return plantillaRemitoConsignacionId;
        }

        var response = await repository.Get<List<RemitoPlantillaItemDto>>("api/impresiones/remito-plantillas");
        if (response.Error || response.Response == null)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo obtener el listado de plantillas de remito: {message}", SweetAlertIcon.Error);
            return null;
        }

        var plantilla = response.Response
            .FirstOrDefault(x => string.Equals(x.Nombre?.Trim(), NombrePlantillaRemitoConsignacion, StringComparison.OrdinalIgnoreCase));

        if (plantilla == null)
        {
            await sweetAlertService.FireAsync("Atención", $"No se encontró la plantilla '{NombrePlantillaRemitoConsignacion}'.", SweetAlertIcon.Warning);
            return null;
        }

        plantillaRemitoConsignacionId = plantilla.Id;
        return plantillaRemitoConsignacionId;
    }

    /// <summary>
    /// Limpia todas las variables de impresión para evitar que se mezclen datos entre remitos
    /// </summary>
    private void LimpiarVariablesImpresion()
    {
        nciImpresion = "";
        numeroRemitoImpresion = "";
        fechaImpresion = "";
        razonSocialImpresion = "";
        domicilioImpresion = "";
        cuitImpresion = "";
        condicionIVAImpresion = "";
        localidadImpresion = "";
        ordenCompraImpresion = "";
        ordenVentaImpresion = "";
        itemsImpresion = new List<ImpresionRemito.ItemRemito>();
        observacionesImpresion = "";
        valorDeclaradoImpresion = "";
        bultosImpresion = 1;
        
        Console.WriteLine("[RemitosTrasladoIndex] Variables de impresión limpiadas");
    }

    /// <summary>
    /// Formatea el CUIT con guiones (XX-XXXXXXXX-X)
    /// </summary>
    private string FormatearCUIT(string cuit)
    {
        if (string.IsNullOrWhiteSpace(cuit))
            return "";

        // Remover cualquier guión existente y espacios
        string cuitLimpio = cuit.Replace("-", "").Replace(" ", "").Trim();

        // Si ya tiene el formato correcto o no tiene 11 dígitos, devolver como está
        if (cuitLimpio.Length != 11 || !cuitLimpio.All(char.IsDigit))
            return cuit;

        // Formatear: XX-XXXXXXXX-X
        return $"{cuitLimpio.Substring(0, 2)}-{cuitLimpio.Substring(2, 8)}-{cuitLimpio.Substring(10, 1)}";
    }

    /// <summary>
    /// Solicita confirmación al usuario antes de anular un remito de traslado.
    /// Replica el comportamiento de VB6: DERACCE("ANUREMI", "Anulación de Remito")
    /// acá se resuelve con SweetAlert de confirmación.
    /// Antes de confirmar, consulta la cantidad de filas (items) del remito para
    /// mostrarlas en el mensaje de confirmación.
    /// </summary>
    private async Task SeleccionarRemitoParaAnular(RemitoAnularDTO remito)
    {
        // Evitar doble clic: si ya hay una anulación en curso, ignorar
        if (anulandoRemito) return;

        // Consultar la cantidad de filas del remito para mostrar en la confirmación
        int cantidadFilas = 0;
        try
        {
            var requestConsulta = new AnularRemitoRequest
            {
                NumeroRemito = remito.DoPriLar ?? "",
                NumeroCliente = remito.NumeClie,
                FechaMovimiento = remito.FechMov
            };

            var responseCantidad = await repository.Post<AnularRemitoRequest, int>(
                "api/movistock/cantidad-filas-remito",
                requestConsulta);

            if (!responseCantidad.Error && responseCantidad.Response != null)
            {
                cantidadFilas = responseCantidad.Response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitosTrasladoIndex] Error al obtener cantidad de filas: {ex.Message}");
        }

        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación de Anulación",
            Text = $"¿Está seguro de anular el remito {remito.DoPriLar}?\n\n" +
                   $"Cliente: {remito.NumeClie} - {remito.RazonSocial}\n" +
                   $"Fecha: {remito.FechMov:dd/MM/yyyy}\n" +
                   $"Cantidad de filas: {cantidadFilas} (2 x Movimiento)",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, anular",
            CancelButtonText = "Cancelar",
            ConfirmButtonColor = "#d33"
        });

        if (result.IsConfirmed)
        {
            await AnularRemito(remito);
        }
    }

    /// <summary>
    /// Anula un remito de traslado llamando al endpoint del servidor que replica
    /// la lógica VB6 de anulación de remitos:
    ///   - Busca el código de movimiento (MOVISTO o MOVIREPA según COMOV$)
    ///   - Recorre el detalle y arma el string de trazables para ACSALOTE
    ///   - Si el remito tiene pedido asociado, actualiza PEDDETA (CantEnt, CanSaldo, Status, NroRemi)
    ///   - UPDATE MOVISTO: Cantsalid=0, Refercor='(Anul) ' + Refercor
    /// </summary>
    private async Task AnularRemito(RemitoAnularDTO remito)
    {
        // Evitar doble clic
        if (anulandoRemito) return;

        anulandoRemito = true;
        anulandoRemitoId = remito.DoPriCor;
        StateHasChanged();

        try
        {
            Console.WriteLine($"[RemitosTrasladoIndex] Anulando remito: {remito.DoPriCor}");

            // Preparar request para anulación (igual que AnulaRemito.razor)
            // La búsqueda en el backend se realiza por DoPriLar + Nume_Clie + FechMov
            var request = new AnularRemitoRequest
            {
                NumeroRemito = remito.DoPriLar ?? "",
                NumeroCliente = remito.NumeClie,
                FechaMovimiento = remito.FechMov
            };

            // Llamar al endpoint de anulación que replica la lógica VB6
            var response = await repository.Post<AnularRemitoRequest, AnularRemitoResponse>(
                "api/movistock/anular-remito",
                request);

            if (!response.Error && response.Response != null)
            {
                var resultado = response.Response;

                if (resultado.Exitoso)
                {
                    await sweetAlertService.FireAsync(new SweetAlertOptions
                    {
                        Title = "Remito Anulado",
                        Html = $"<div style='text-align: left;'>" +
                               $"<p><strong>Remito:</strong> {remito.DoPriLar}</p>" +
                               $"<p><strong>Cliente:</strong> {remito.NumeClie} - {remito.RazonSocial}</p>" +
                               $"<p><strong>Tabla utilizada:</strong> {resultado.TablaUtilizada}</p>" +
                               $"<p><strong>Registros afectados:</strong> {resultado.RegistrosMovimientosAfectados}</p>" +
                               $"<p><strong>Pedidos actualizados:</strong> {resultado.PedidosActualizados}</p>" +
                               $"</div>",
                        Icon = SweetAlertIcon.Success
                    });

                    Console.WriteLine($"[RemitosTrasladoIndex] Anulación exitosa: {resultado.Mensaje}");

                    // Recargar la lista de remitos para reflejar el estado Anulado
                    await CargarRemitos();
                }
                else
                {
                    await sweetAlertService.FireAsync("Error", resultado.Mensaje, SweetAlertIcon.Error);
                    Console.WriteLine($"[RemitosTrasladoIndex] Error en anulación: {resultado.Mensaje}");
                }
            }
            else
            {
                var errorMsg = await response.GetErrorMessageAsync();
                Console.WriteLine($"[RemitosTrasladoIndex] Error al anular remito: {errorMsg}");
                await sweetAlertService.FireAsync("Error", $"Error al anular remito: {errorMsg}", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitosTrasladoIndex] Excepción al anular remito: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al anular remito: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            anulandoRemito = false;
            anulandoRemitoId = null;
            StateHasChanged();
        }
    }

    private void Volver()
    {
        navigationManager.NavigateTo("/remitos/traslado");
    }
}
