@using IMPLANPROD.Shared.Entities
@using Blazored.Modal
@using Blazored.Modal.Services

<style>
    .blazored-modal-container {
        z-index: 2000 !important;
    }
    
    .blazored-modal {
        z-index: 2001 !important;
    }

    .stock-dot {
        display: inline-block;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        box-shadow: 0 0 2px rgba(0,0,0,0.3);
    }

    .stock-dot-ok {
        background-color: #28a745;
    }

    .stock-dot-fail {
        background-color: #dc3545;
    }
</style>

<div class="modal-content" style="z-index: 2002;">
    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
            <i class="fas fa-clipboard-list"></i> Pedidos Pendientes de Entrega
        </h5>
    </div>

    @* Encabezado con cliente y depósito seleccionados *@
    <div class="px-3 pt-2 pb-1 bg-light border-bottom">
        <div class="row">
            <div class="col-md-6">
                <strong>Cliente:</strong> <span class="text-primary">@NombreCliente</span>
            </div>
            <div class="col-md-6">
                <strong>Depósito:</strong> <span class="text-primary">@NombreDeposito</span>
            </div>
        </div>
    </div>

    <div class="modal-body" style="max-height: 600px; overflow-y: auto;">
        @if (pedidosPendientes == null || !pedidosPendientes.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No hay pedidos pendientes para este cliente.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Pedido</th>
                            <th>Orden</th>
                            <th>Fecha Entrega</th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th class="text-end">Stock</th>
                            <th class="text-center" title="Indica si el stock alcanza para cubrir lo pendiente o a remitir">¿Alcanza?</th>
                            <th class="text-end">Pendiente</th>
                            <th class="text-end">A Remitir</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pedidosPendientes.OrderBy(p => p.NroPed).ThenBy(p => p.FeSolEnt))
                        {
                            // Cantidad efectiva a evaluar: si el usuario ingresó "A Remitir" > 0
                            // se compara contra esa; si no, se compara contra el pendiente.
                            var cantidadEvaluar = item.CantidadARemitir > 0 ? item.CantidadARemitir : (item.CanSaldo ?? 0m);
                            var stockAlcanza = item.StockDeposito >= cantidadEvaluar;

                            <tr>
                                <td>@item.NroPed</td>
                                <td>
                                    @if (item.NuOrItem.HasValue)
                                    {
                                        <span class="badge bg-success">@item.NuOrItem</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(item.FeSolEnt?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@item.CodiExt</td>
                                <td>@item.Descrip</td>
                                <td class="text-end">@item.StockDeposito.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="stock-dot @(stockAlcanza ? "stock-dot-ok" : "stock-dot-fail")"
                                          title="@(stockAlcanza ? "El stock alcanza" : "El stock NO alcanza")"></span>
                                </td>
                                <td class="text-end">@item.CanSaldo</td>
                                <td class="text-end">
                                    <input type="number" 
                                           class="form-control form-control-sm text-end" 
                                           style="width: 100px;"
                                           min="0" 
                                           max="@item.CanSaldo" 
                                           step="0.01"
                                           @bind="item.CantidadARemitir"
                                           @bind:event="oninput" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" @onclick="Cancelar">
            <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="button" class="btn btn-primary" @onclick="Confirmar">
            <i class="fas fa-check"></i> Confirmar
        </button>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance Modal { get; set; } = default!;
    [Parameter] public List<PeddetaConCantidad> pedidosPendientes { get; set; } = new();

    /// <summary>
    /// Nombre del cliente seleccionado, mostrado en el encabezado del modal.
    /// </summary>
    [Parameter] public string NombreCliente { get; set; } = string.Empty;

    /// <summary>
    /// Nombre del depósito seleccionado, mostrado en el encabezado del modal.
    /// El stock de cada fila corresponde a este depósito.
    /// </summary>
    [Parameter] public string NombreDeposito { get; set; } = string.Empty;

    private void Cancelar()
    {
        Modal.CancelAsync();
    }

    private void Confirmar()
    {
        // Filtrar solo los items con cantidad a remitir mayor a 0
        var itemsSeleccionados = pedidosPendientes
            .Where(p => p.CantidadARemitir > 0)
            .ToList();

        Modal.CloseAsync(ModalResult.Ok(itemsSeleccionados));
    }

    /// <summary>
    /// Clase auxiliar para manejar la cantidad a remitir y el stock del depósito.
    /// Hereda de Peddeta para conservar todos los campos del pedido original.
    /// </summary>
    public class PeddetaConCantidad : Peddeta
    {
        /// <summary>Cantidad a remitir ingresada por el usuario.</summary>
        public decimal CantidadARemitir { get; set; } = 0;

        /// <summary>Stock disponible del producto en el depósito seleccionado.</summary>
        public decimal StockDeposito { get; set; } = 0;
    }
}
