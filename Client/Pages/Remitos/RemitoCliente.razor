    /// <summary>
    /// Carga la lista de depósitos activos
    /// </summary>
    private async Task CargarDepositos()
    {
        try
        {
            var response = await repository.Get<List<Tadeposi>>("api/tadeposi/activos");
            if (!response.Error && response.Response != null)
            {
                depositos = response.Response;
                Console.WriteLine($"[RemitoCliente] Depósitos cargados: {depositos.Count}");
            }
            else
            {
                Console.WriteLine("[RemitoCliente] Error al cargar depósitos");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al cargar depósitos: {ex.Message}");
        }
    }

    /// <summary>
    /// Carga el depósito de expedición por defecto desde la configuración FLEXCRL
    /// </summary>
    private async Task CargarDepositoExpedicionDefecto()
    {
        try
        {
            // Cargar configuración desde FLEXCRL (CLABUS="", PROBUS="DEPOEXPE")
            string probusParam = "DEPOEXPE";
            string clabusParam = "empty"; // Usar "empty" como placeholder cuando CLABUS está vacío
            
            var response = await repository.Get<FLEXCRL>($"api/flexcrl/{clabusParam}/{probusParam}");
            
            if (!response.Error && response.Response != null)
            {
                var config = response.Response;
                if (int.TryParse(config.VALCONTROL, out var depositoConfig) && depositoConfig > 0)
                {
                    // Verificar que el depósito existe en la lista de depósitos activos
                    var depositoExiste = depositos.Any(d => d.CodigoDepo == depositoConfig);
                    if (depositoExiste)
                    {
                        depositoSeleccionado = depositoConfig;
                        Console.WriteLine($"[RemitoCliente] Depósito de expedición por defecto cargado: {depositoSeleccionado}");
                    }
                    else
                    {
                        Console.WriteLine($"[RemitoCliente] Depósito configurado ({depositoConfig}) no existe en depósitos activos");
                        depositoSeleccionado = 0;
                    }
                }
                else
                {
                    Console.WriteLine("[RemitoCliente] No hay depósito de expedición configurado o valor inválido");
                    depositoSeleccionado = 0;
                }
            }
            else
            {
                Console.WriteLine("[RemitoCliente] No se encontró configuración de depósito de expedición");
                depositoSeleccionado = 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al cargar depósito de expedición: {ex.Message}");
            depositoSeleccionado = 0; // Valor por defecto en caso de error
        }
    }

