    private async Task OnClienteSeleccionado(SelectorClientes.ClienteSeleccionado cliente)
    {
        try
        {
            Console.WriteLine($"[RemitoCliente] Cliente seleccionado: {cliente.NumeCli} - {cliente.RazonSocial}");

            // Cerrar explícitamente el modal del selector de clientes
            selectorClientes.CerrarModal();
            
            numeroClienteSeleccionado = cliente.NumeCli;
            clienteSeleccionado = $"{cliente.NumeCli} - {cliente.RazonSocial}";
            razonSocial = cliente.RazonSocial ?? "";

            // Obtener datos completos del cliente desde Deudor12
            var responseHttp = await repository.Get<Deudor12>($"api/deudor12/numero/{cliente.NumeCli}");

            if (!responseHttp.Error && responseHttp.Response != null)
            {
                var clienteCompleto = responseHttp.Response;
                
                domicilioCliente = clienteCompleto.Domi_Cli ?? "";
                localidadCliente = clienteCompleto.Loca_Cli ?? "";
                codigoPostalCliente = clienteCompleto.Cpos_Cli ?? "";
                cuitCliente = clienteCompleto.Cuit_Cli ?? "";

                Console.WriteLine($"[RemitoCliente] Datos del cliente cargados - CUIT: {cuitCliente}");
            }
            else
            {
                await sweetAlertService.FireAsync("Advertencia", "No se pudieron cargar todos los datos del cliente", SweetAlertIcon.Warning);
            }

            // Los pedidos pendientes se muestran a pedido del usuario mediante el
            // botón "Mostrar Pedidos Pendientes", que requiere además un depósito
            // seleccionado para poder consultar el stock de cada producto.

            StateHasChanged();
