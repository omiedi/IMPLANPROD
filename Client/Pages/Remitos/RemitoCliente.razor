    /// <summary>
    /// Verifica si el cliente tiene pedidos pendientes y muestra el modal
    /// </summary>
    private async Task VerificarPedidosPendientes(int numeroCliente)
    {
        try
        {
            Console.WriteLine($"[RemitoCliente] Verificando pedidos pendientes para cliente {numeroCliente}");

            // Consultar pedidos pendientes del cliente (endpoint específico para remitos de cliente)
            var response = await repository.Get<List<Peddeta>>($"api/peddeta/pendientes-cliente/{numeroCliente}");

            if (response.Error)
            {
                Console.WriteLine($"[RemitoCliente] Error al consultar pedidos pendientes: {response.Error}");
                return;
            }

            var pedidosPendientes = response.Response ?? new List<Peddeta>();

            if (pedidosPendientes.Any())
            {
                Console.WriteLine($"[RemitoCliente] Se encontraron {pedidosPendientes.Count} items pendientes");

                // Convertir a PeddetaConCantidad
                var pedidosConCantidad = pedidosPendientes
                    .Select(p => new PeddetaConCantidad
                    {
                        PeddetaId = p.PeddetaId,
                        NroPed = p.NroPed,
                        FeSolEnt = p.FeSolEnt,
                        CodiInt = p.CodiInt,
                        CodiExt = p.CodiExt,
                        Descrip = p.Descrip,
                        CanSaldo = p.CanSaldo,
                        CanPed = p.CanPed,
                        CantEnt = p.CantEnt,
                        NroClie = p.NroClie,
                        TipoPed = p.TipoPed,
                        NroOcom = p.NroOcom,
                        NuOrItem = p.NuOrItem,
                        CantidadARemitir = 0
                    })
                    .ToList();

                // Mostrar modal con pedidos pendientes
                var parameters = new ModalParameters();
                parameters.Add(nameof(PedidosPendientesModal.pedidosPendientes), pedidosConCantidad);

                var modal = modalService.Show<PedidosPendientesModal>("Pedidos Pendientes", parameters, new ModalOptions
                {
                    Size = ModalSize.ExtraLarge,
                    DisableBackgroundCancel = true,
                    HideCloseButton = false
                });

                var result = await modal.Result;

                if (!result.Cancelled && result.Data != null)
                {
                    var itemsSeleccionados = (List<PeddetaConCantidad>)result.Data;
                    Console.WriteLine($"[RemitoCliente] Items seleccionados: {itemsSeleccionados.Count}");

                    // Agregar los items seleccionados al remito
                    await AgregarItemsDesdePedidos(itemsSeleccionados);
                }
            }
            else
            {
                Console.WriteLine($"[RemitoCliente] No se encontraron pedidos pendientes");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al verificar pedidos pendientes: {ex.Message}");
        }
    }

    /// <summary>
    /// Agrega items al remito desde los pedidos seleccionados
    /// </summary>
    private async Task AgregarItemsDesdePedidos(List<PeddetaConCantidad> items)
    {
        try
        {
            foreach (var item in items)
            {
                if (item.CodiInt.HasValue && item.CantidadARemitir > 0)
                {
                    // Buscar el producto en Master
                    var responseProducto = await repository.Get<Master>($"api/master/xCodint{item.CodiInt.Value}");

                    if (!responseProducto.Error && responseProducto.Response != null)
                    {
                        var producto = responseProducto.Response;

                        // Verificar si el producto ya está en el remito con el mismo pedido y mismo NuOrItem
                        var productoExistente = productosRemito.FirstOrDefault(p => 
                            p.CodInt == producto.Codint && 
                            p.NroPedido == item.NroPed &&
                            p.NuOrItemPedido == item.NuOrItem);

                        if (productoExistente != null)
                        {
                            // Sumar la cantidad
                            productoExistente.Cantidad += item.CantidadARemitir;
                        }
                        else
                        {
                            // Agregar nuevo producto
                            var nuevoProducto = new ProductoRemito
                            {
                                CodInt = producto.Codint,
                                Codigo = producto.Codigo ?? "",
                                Descripcion = producto.Descripcion ?? "",
                                Trazable = producto.Trazable ?? 0,
                                Cantidad = item.CantidadARemitir,
                                Unidad = producto.Umedida ?? "",
                                NroPedido = item.NroPed,
                                NuOrItemPedido = item.NuOrItem
                            };

                            productosRemito.Add(nuevoProducto);
                        }

                        Console.WriteLine($"[RemitoCliente] Producto agregado desde pedido {item.NroPed}, NuOrItem: {item.NuOrItem}: {producto.Codigo} - Cantidad: {item.CantidadARemitir}");
                    }
                }
            }

            StateHasChanged();
            await sweetAlertService.FireAsync("Éxito", $"Se agregaron {items.Count} productos desde pedidos pendientes", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al agregar items desde pedidos: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al agregar productos: {ex.Message}", SweetAlertIcon.Error);
        }
    }

