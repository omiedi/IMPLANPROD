    /// <summary>
    /// Evento que recibe un producto con cantidad desde el SelectorProductos y lo agrega al detalle
    /// </summary>
    private async void OnProductoSeleccionadoCantidad(SelectorProductos.SeleccionProducto sel)
    {
        var p = sel.Producto;
        var cantidad = sel.Cantidad <= 0 ? 1 : sel.Cantidad;

        // Validar que se haya seleccionado un depósito
        if (depositoSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Depósito requerido", "Debe seleccionar un depósito antes de agregar productos.", SweetAlertIcon.Warning);
            return;
        }

        // Verificar si el producto es trazable
        Console.WriteLine($"[RemitoCliente] Producto seleccionado: {p.Codigo}, Trazable: {p.Trazable}");
        
        if (p.Trazable == 1)
        {
            Console.WriteLine($"[RemitoCliente] Producto trazable detectado: {p.Codigo}");
            
            // Guardar el producto y cantidad para el modal de lotes
            productoTrazableSeleccionado = p;
            cantidadSolicitadaTrazable = cantidad;
            
            // Abrir modal de selección de lotes
            mostrarModalLotes = true;
            StateHasChanged();
        }
        else
        {
            // Producto no trazable, agregar directamente
            Console.WriteLine($"[RemitoCliente] Producto no trazable: {p.Codigo}");
            
            productosRemito.Add(new ProductoRemito
            {
                CodInt = p.Codint,
                Codigo = p.Codigo ?? string.Empty,
                Descripcion = p.Descripcion ?? string.Empty,
                Trazable = p.Trazable ?? 0,
                Unidad = p.Umedida ?? string.Empty,
                Cantidad = cantidad
            });

            StateHasChanged();

            // Si el ciclo sigue activo, reabrimos el modal para permitir agregar otro producto
            if (cicloSeleccionProductos && selectorProductos != null)
            {
                await Task.Delay(100);
                await selectorProductos.AbrirModal();
            }
        }
    }

