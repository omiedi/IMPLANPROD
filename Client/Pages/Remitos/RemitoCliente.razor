    private int ObtenerCodIntProductoTrazable() => productoTrazableSeleccionado?.Codint ?? 0;
    private string ObtenerCodigoProductoTrazable() => productoTrazableSeleccionado?.Codigo ?? string.Empty;
    private string ObtenerDescripcionProductoTrazable() => productoTrazableSeleccionado?.Descripcion ?? string.Empty;
    private string ObtenerNombreDeposito() => depositos.FirstOrDefault(d => d.Id == depositoSeleccionado)?.Descripcion ?? string.Empty;

    /// <summary>
    /// Obtiene el prefijo formateado con 4 dígitos completados con ceros a la izquierda
    /// </summary>
    private string ObtenerPrefijoFormateado()
    {
        return prefijoRemito.ToString("D4");
    }

    /// <summary>
    /// Obtiene el número de remito formateado con 8 dígitos completados con ceros a la izquierda
    /// </summary>
    private string ObtenerNumeroFormateado()
    {
        return numeroRemito.ToString("D8");
    }

    /// <summary>
    /// Obtiene el número de remito completo (prefijo + número)
    /// </summary>
    private string ObtenerRemitoCompleto()
    {
        return $"{ObtenerPrefijoFormateado()}-{ObtenerNumeroFormateado()}";
    }

    /// <summary>
    /// Actualiza la vista cuando cambia el prefijo
    /// </summary>
    private void ActualizarPrefijoFormateado()
    {
        // Validar rango
        if (prefijoRemito < 0) prefijoRemito = 0;
        if (prefijoRemito > 9999) prefijoRemito = 9999;
        
        StateHasChanged();
    }

    /// <summary>
    /// Actualiza la vista cuando cambia el número de remito
    /// </summary>
    private void ActualizarNumeroFormateado()
    {
        // Validar rango
        if (numeroRemito < 0) numeroRemito = 0;
        if (numeroRemito > 99999999) numeroRemito = 99999999;
        
        StateHasChanged();
    }

    /// <summary>
    /// Abre el modal de numeración con el punto de venta y número sugeridos.
    /// Permite al usuario confirmar o modificar ambos valores antes de guardar.
    /// </summary>
    private async Task AbrirModalNumeracionAsync()
    {
        try
        {
            // Cargar el prefijo por defecto si no está cargado
            if (prefijoRemito <= 0)
            {
                await CargarPrefijoDefecto();
            }

            var tipoNumeracion = await remitosConfigService.ObtenerTipoNumeracionRemitosAsync();
            Console.WriteLine($"[RemitoCliente] Tipo de numeración: {tipoNumeracion}");

            if (numeroRemito <= 0 || tipoNumeracion == "AUTONUME")
            {
                // Obtener el siguiente número libre según el tipo de numeración
                var ultimoNumero = await remitosConfigService.ObtenerUltimoNumeroRemitoAsync();
                numeroModal = ultimoNumero + 1;
            }
            else
            {
                numeroModal = numeroRemito;
            }

            // El punto de venta inicial es el prefijo del formulario
            prefijoModal = prefijoRemito > 0 ? prefijoRemito : 0;
            if (prefijoModal <= 0)
            {
                await CargarPrefijoDefecto();
                prefijoModal = prefijoRemito;
            }

            // Limitar el número dentro del rango válido
            if (numeroModal > 99999999) numeroModal = 99999999;
            if (numeroModal < 0) numeroModal = 0;

            mostrarModalNumeracion = true;
            StateHasChanged();
            Console.WriteLine($"[RemitoCliente] Modal de numeración abierto: prefijo={prefijoModal}, numero={numeroModal}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al abrir modal de numeración: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al preparar numeración: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Cierra el modal de numeración sin guardar.
    /// Libera el flag guardando para permitir un nuevo intento.
    /// </summary>
    private void CerrarModalNumeracion()
    {
        mostrarModalNumeracion = false;
        validandoNumeracion = false;
        guardando = false;
        StateHasChanged();
        Console.WriteLine("[RemitoCliente] Modal de numeración cerrado");
    }

    /// <summary>
    /// Valida el prefijo y número del modal. Si están ocupados, propone el siguiente libre.
    /// Si están libres, guarda el remito con la numeración seleccionada.
    /// </summary>
    private async Task ConfirmarNumeracionAsync()
    {
        try
        {
            // Validar rango de los campos
            if (prefijoModal < 0 || prefijoModal > 9999)
            {
                await sweetAlertService.FireAsync("Error", "El punto de venta debe estar entre 0 y 9999", SweetAlertIcon.Error);
                return;
            }

            if (numeroModal <= 0 || numeroModal > 99999999)
            {
                await sweetAlertService.FireAsync("Error", "El número de remito debe estar entre 1 y 99999999", SweetAlertIcon.Error);
                return;
            }

            validandoNumeracion = true;
            StateHasChanged();

            // Verificar si el par prefijo/número está ocupado
            var responseValidacion = await repository.Get<bool>($"api/movistock/validar-remito/{prefijoModal}/{numeroModal}");
            if (responseValidacion.Error)
            {
                var error = await responseValidacion.GetErrorMessageAsync();
                throw new Exception($"Error al validar remito: {error}");
            }

            if (responseValidacion.Response)
            {
                // El remito está ocupado: obtener el último número para ese prefijo y proponer el siguiente
                var responseUltimo = await repository.Get<int>($"api/movistock/ultimo-numero-prefijo/{prefijoModal}");
                var ultimoNumero = responseUltimo.Error ? 0 : (responseUltimo.Response <= 0 ? 0 : responseUltimo.Response);
                var sugerido = ultimoNumero + 1;
                if (sugerido > 99999999) sugerido = 99999999;

                validandoNumeracion = false;
                StateHasChanged();

                var result = await sweetAlertService.FireAsync(new SweetAlertOptions
                {
                    Title = "Remito Ocupado",
                    Html = $"El remito <strong>RT-X-{prefijoModal.ToString("D4")}-{numeroModal.ToString("D8")}</strong> ya existe para el punto de venta <strong>{prefijoModal}</strong>.<br><br>" +
                           $"Último número usado: <strong>{ultimoNumero}</strong><br>" +
                           $"Número libre sugerido: <strong>{sugerido}</strong><br><br>" +
                           $"¿Desea usar el número sugerido o modificarlo manualmente?",
                    Icon = SweetAlertIcon.Warning,
                    ShowCancelButton = true,
                    ShowConfirmButton = true,
                    ConfirmButtonText = $"Usar {sugerido}",
                    CancelButtonText = "Modificar",
                    ConfirmButtonColor = "#28a745",
                    CancelButtonColor = "#dc3545"
                });

                if (result.IsConfirmed)
                {
                    numeroModal = sugerido;
                    StateHasChanged();
                    // Reintentar confirmación con el número sugerido
                    await ConfirmarNumeracionAsync();
                }
                else
                {
                    // El usuario vuelve al modal para modificarlo manualmente
                    Console.WriteLine("[RemitoCliente] Usuario optó por modificar la numeración manualmente");
                }

                return;
            }

            // Numeración libre: aplicar al formulario y guardar
            prefijoRemito = prefijoModal;
            numeroRemito = numeroModal;
            mostrarModalNumeracion = false;
            validandoNumeracion = false;
            StateHasChanged();

            Console.WriteLine($"[RemitoCliente] Guardando remito para cliente {numeroClienteSeleccionado} con prefijo {prefijoRemito} y número {numeroRemito}");

            // Guardar el remito (incluye validación de duplicados)
            await GuardarRemito();

            await sweetAlertService.FireAsync("Éxito", "Remito guardado correctamente", SweetAlertIcon.Success);

            // Preparar e imprimir el remito
            await PrepararEImprimirRemito();

            // Limpiar formulario o navegar
            LimpiarFormulario();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al confirmar numeración: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al confirmar numeración: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            validandoNumeracion = false;
            // Liberar el bloqueo del botón Guardar: el proceso completo terminó
            // (ya sea por éxito, error o cancelación del modal de numeración).
            guardando = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Guarda el remito registrando los movimientos de stock
    /// Replica la lógica de VB6 para generar remitos de cliente
    /// </summary>
    private async Task GuardarRemito()
    {
        try
        {
            Console.WriteLine("[RemitoCliente] Iniciando guardado de remito...");

            // La numeración fue confirmada/modificada por el usuario en el modal de numeración.
            // Se realiza una validación final antes de grabar para detectar posibles duplicados concurrentes.
            if (prefijoRemito <= 0)
            {
                throw new Exception("El punto de venta (prefijo) debe ser mayor a 0");
            }

            if (numeroRemito <= 0)
            {
                throw new Exception("El número de remito debe ser mayor a 0");
            }

            Console.WriteLine($"[RemitoCliente] Validando remito {prefijoRemito}-{numeroRemito} antes de grabar...");
            var responseValidacionFinal = await repository.Get<bool>($"api/movistock/validar-remito/{prefijoRemito}/{numeroRemito}");
            if (responseValidacionFinal.Error)
            {
                var error = await responseValidacionFinal.GetErrorMessageAsync();
                throw new Exception($"Error al validar remito: {error}");
            }

            if (responseValidacionFinal.Response)
            {
                throw new Exception($"El remito RT-X-{ObtenerPrefijoFormateado()}-{numeroRemito.ToString("D8")} ya fue ocupado por otro usuario.");
            }

            Console.WriteLine($"[RemitoCliente] Numeración validada: prefijo={prefijoRemito}, número={numeroRemito}");

            // Construir el remito completo formateado: RT-X-PPPP-NNNNNNNN
            // Donde X es un separador, PPPP es el prefijo de 4 dígitos, NNNNNNNN es el número de 8 dígitos
            string remitoCorto = $"RT.{numeroRemito}"; // RT.6449
            string remitoLargo = $"RT-X-{ObtenerPrefijoFormateado()}-{ObtenerNumeroFormateado()}"; // RT-X-0001-00006449

            int nuorItem = 0; // Contador de items

            // Recorrer cada producto del detalle
            foreach (var producto in productosRemito)
            {
                // Si el producto es trazable, recorrer sus lotes
                if (producto.Trazable == 1 && producto.Lotes.Any())
                {
                    foreach (var lote in producto.Lotes)
                    {
                        if (lote.Cantidad > 0.005m)
                        {
                            nuorItem++;
                            await RegistrarMovimientoProducto(
                                producto, 
                                lote.Cantidad, 
                                lote.Lote, 
                                nuorItem, 
                                remitoCorto, 
                                remitoLargo);
                        }
                    }
                }
                else
                {
                    // Producto no trazable o sin lotes
                    if (producto.Cantidad > 0.005m)
                    {
                        nuorItem++;
                        await RegistrarMovimientoProducto(
                            producto, 
                            producto.Cantidad, 
                            "", // Sin lote
                            nuorItem, 
                            remitoCorto, 
                            remitoLargo);
                    }
                }
            }

            Console.WriteLine($"[RemitoCliente] Remito guardado exitosamente. Total items: {nuorItem}");

            // Guardar datos adicionales del remito en EXTRAS_REMITO
            await GuardarExtrasRemitoAsync(remitoLargo);

            // Registrar la anotación automática "Items Remitidos" en el anotador de
            // cada pedido asociado al remito (MOVISTO.NuPedCli > 0). Solo se anotan
            // los ítems vinculados a pedido; el resto queda excluido.
            await RegistrarAnotacionItemsRemitidosAsync(remitoLargo);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error en GuardarRemito: {ex.Message}");
            throw;
        }
    }

    /// <summary>
    /// Registra la anotación "Items Remitidos" en el anotador de los pedidos
    /// asociados al remito recién generado (solo ítems con pedido, NuPedCli &gt; 0).
    /// Si falla, se informa por consola sin interrumpir el circuito del remito.
    /// </summary>
    /// <param name="remitoLargo">Documento largo del remito (MOVISTO.DoPriLar)</param>
    private async Task RegistrarAnotacionItemsRemitidosAsync(string remitoLargo)
    {
        try
        {
            // Solo invocar si el remito tiene al menos un ítem asociado a un pedido
            if (!productosRemito.Any(p => p.NroPedido.HasValue && p.NroPedido.Value > 0))
            {
                return;
            }

            var response = await repository.Post("api/pedenca/registrar-items-remitidos",
                new RegistrarItemsRemitidosDTO { RemitoLargo = remitoLargo });

            if (response.Error)
            {
                var error = await response.GetErrorMessageAsync();
                Console.WriteLine($"[RemitoCliente] Error al registrar anotación de ítems remitidos: {error}");
            }
            else
            {
                Console.WriteLine($"[RemitoCliente] Anotación 'Items Remitidos' registrada para remito {remitoLargo}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error en RegistrarAnotacionItemsRemitidosAsync: {ex.Message}");
        }
    }

    /// <summary>
    /// Guarda los datos adicionales del remito en la tabla EXTRAS_REMITO
    /// </summary>
    private async Task GuardarExtrasRemitoAsync(string doprilar)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(doprilar) || !numeroClienteSeleccionado.HasValue || numeroClienteSeleccionado.Value <= 0)
            {
                Console.WriteLine("[RemitoCliente] No se guarda ExtrasRemito: faltan datos obligatorios");
                return;
            }

            int? bultos = null;
            if (int.TryParse(numeroBultos, out var bultosParsed))
            {
                bultos = bultosParsed;
            }

            decimal? valorDecimal = null;
            if (!string.IsNullOrWhiteSpace(valorDeclarado) &&
                decimal.TryParse(valorDeclarado, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var valorParsed))
            {
                valorDecimal = valorParsed;
            }

            var extrasRemito = new ExtrasRemito
            {
                NumeClie = numeroClienteSeleccionado.Value,
                Fechmov = fechaRemito,
                Doprilar = doprilar,
                Observaciones = observaciones ?? string.Empty,
                Bultos = bultos,
                ValorDeclarado = valorDecimal
            };

            var response = await repository.Post<ExtrasRemito>("api/ExtrasRemito", extrasRemito);
            if (response.Error)
            {
                var error = await response.GetErrorMessageAsync();
                throw new Exception($"Error al guardar datos adicionales del remito: {error}");
            }

            Console.WriteLine($"[RemitoCliente] ExtrasRemito guardado para remito {doprilar}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al guardar ExtrasRemito: {ex.Message}");
            throw;
        }
    }

    /// <summary>
    /// Registra un movimiento de stock para un producto del remito
    /// </summary>
    private async Task RegistrarMovimientoProducto(
        ProductoRemito producto, 
        decimal cantidad, 
        string lote, 
        int nuorItem, 
        string remitoCorto, 
        string remitoLargo)
    {
        try
        {
            // Construir el DTO para el movimiento de stock
            // Si el producto viene de un pedido, usar el número de pedido en DocumentoSecundario
            // Si no, usar la orden de compra del cliente
            string docSecundario = producto.NroPedido.HasValue && producto.NroPedido.Value > 0 
                ? $"PC.{producto.NroPedido.Value}" 
                : $"PC.{ordenCompra}";
            
            string docSecundarioLargo = producto.NroPedido.HasValue && producto.NroPedido.Value > 0
                ? $"P/F - Pedido {producto.NroPedido.Value}"
                : $"P/F - PC.{ordenCompra}";

            var movimiento = new MoviStockDTO
            {
                Fecha = fechaRemito,
                CodigoInterno = producto.CodInt,
                Lote = lote,
                CodigoMovimiento = "RT", // Remito de cliente
                DocumentoPrimarioCorto = remitoCorto, // RT.6449
                DocumentoPrimarioLargo = remitoLargo, // RT-X-0001-00006449
                DocumentoSecundarioLargo = docSecundarioLargo, // "P/F - Pedido 256" o "P/F - PC.123"
                DocumentoSecundarioCorto = docSecundario, // "PC.256" (nro pedido) o "PC.123" (orden compra)
                Referencia = razonSocial, // REFEMO$ = Razón social del cliente
                NumeroOrdenItem = nuorItem,
                NumeroPedidoCliente = producto.NroPedido ?? 0, // Número de pedido si proviene de uno
                NumeroOrdenPedido = producto.NuOrItemPedido ?? 0, // Número de orden del item en el pedido (PEDDETA.NuOrItem)
                Moneda = 1, // Moneda por defecto
                NumeroCliente = numeroClienteSeleccionado.Value,
                Deposito = depositoSeleccionado,
                Cantidad = -1 * cantidad, // Negativo porque es una salida de stock
                ValorUnitario = 0, // No se maneja precio en remitos
                OrdenCompraRetornoAbierto = ordenCompra,
                NumeroRemito = numeroRemito, // Campo numérico para MOVISTO.DOPRINUM (últimos 8 dígitos)
                PrefijoRemito = (short)prefijoRemito, // Campo numérico para MOVISTO.NUMPVTA (primeros 4 dígitos)
                TipoTransferencia = transportistaId > 0 ? (short?)transportistaId : null // Código del transportista (TRANSPORTES.Codi_Tra) -> MOVISTO.TipoTran
            };

            Console.WriteLine($"[RemitoCliente] Registrando movimiento: Producto {producto.Codigo}, Cantidad {cantidad}, Lote '{lote}', NroPedido: {producto.NroPedido}, NuOrItem: {producto.NuOrItemPedido}");

            // Llamar al servicio para registrar el movimiento
            var response = await repository.Post("api/movistock/registrar", movimiento);

            if (response.Error)
            {
                var errorMsg = await response.GetErrorMessageAsync();
                throw new Exception($"Error al registrar movimiento para producto {producto.Codigo}: {errorMsg}");
            }

            Console.WriteLine($"[RemitoCliente] Movimiento registrado exitosamente para producto {producto.Codigo}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error en RegistrarMovimientoProducto: {ex.Message}");
            throw;
        }
    }

    /// <summary>
    /// Carga la lista de transportistas desde la base de datos
    /// </summary>
    private async Task CargarTransportistas()
    {
        try
        {
            if (numeroClienteSeleccionado == null || numeroClienteSeleccionado <= 0)
            {
                await sweetAlertService.FireAsync("Cliente requerido", "Debe seleccionar un cliente antes de cargar transportistas.", SweetAlertIcon.Warning);
                return;
            }

            var httpResponse = await repository.Get<List<Transporte>>("api/transportes/combo");
            
            if (httpResponse.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron cargar los transportistas.", SweetAlertIcon.Error);
                return;
            }

            transportistas = httpResponse.Response ?? new List<Transporte>();
            
            StateHasChanged();
            
            Console.WriteLine($"[RemitoCliente] Transportistas cargados: {transportistas.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al cargar transportistas: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al cargar transportistas: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Maneja la selección de un transportista y completa los campos relacionados
    /// </summary>
    private void OnTransportistaSeleccionado()
    {
        if (transportistaId > 0)
        {
            var transportista = transportistas.FirstOrDefault(t => t.Codi_Tra == transportistaId);
            if (transportista != null)
            {
                cuitTransportista = transportista.Cuit_Tra ?? string.Empty;
                domicilioTransportista = transportista.Domi_Tra ?? string.Empty;
                codPostalTransportista = transportista.CodPostal_Tra ?? string.Empty;
                
                Console.WriteLine($"[RemitoCliente] Transportista seleccionado: {transportista.Deno_Tra} (Codi_Tra: {transportistaId})");
                Console.WriteLine($"[RemitoCliente] CUIT: {cuitTransportista}, Domicilio: {domicilioTransportista}, Cod Postal: {codPostalTransportista}");
            }
            else
            {
                Console.WriteLine($"[RemitoCliente] No se encontró transportista con Codi_Tra: {transportistaId}");
            }
        }
        else
        {
            // Limpiar campos si no hay selección
            cuitTransportista = string.Empty;
            domicilioTransportista = string.Empty;
            codPostalTransportista = string.Empty;
        }
    }

    /// <summary>
    /// Prepara los datos e imprime el remito
    /// </summary>
    private async Task PrepararEImprimirRemito()
    {
        try
        {
            Console.WriteLine("[RemitoCliente] Preparando impresión del remito...");

            // IMPORTANTE: Limpiar todas las variables antes de preparar la impresión
            LimpiarVariablesImpresion();

            // Obtener código de movimiento
            var codigoMovimiento = await remitosConfigService.ObtenerCodigoMovimientoAsync();

            // Preparar número de remito completo (DoPriLar)
            numeroRemitoImpresion = $"{codigoMovimiento}-X-{ObtenerPrefijoFormateado()}-{numeroRemito.ToString("D8")}";
            
            // Preparar fecha
            fechaImpresion = fechaRemito.ToString("dd/MM/yy");
            
            // Preparar datos del cliente
            razonSocialImpresion = razonSocial;
            domicilioImpresion = domicilioCliente;
            
            // Formatear CUIT con guiones (XX-XXXXXXXX-X)
            cuitImpresion = FormatearCUIT(cuitCliente);
            
            localidadImpresion = localidadCliente;
            
            // Obtener condición de IVA del cliente desde TipoIvaEnum
            if (numeroClienteSeleccionado.HasValue)
            {
                var responseCliente = await repository.Get<Deudor12>($"api/Deudor12/numero/{numeroClienteSeleccionado.Value}");
                if (!responseCliente.Error && responseCliente.Response != null)
                {
                    var cliente = responseCliente.Response;
                    
                    // Obtener la descripción de IVA desde TipoIvaEnum usando Piva_Cli
                    condicionIVAImpresion = TipoIvaHelper.ObtenerDescripcionIvaPorCodigo(cliente.Piva_Cli);
                    Console.WriteLine($"[RemitoCliente] Condición IVA: Código={cliente.Piva_Cli}, Descripción={condicionIVAImpresion}");
                }
            }
            
            // Preparar orden de compra y orden de venta
            ordenCompraImpresion = ordenCompra;
            
            // Obtener orden de venta del primer producto que tenga pedido
            var primerProductoConPedido = productosRemito.FirstOrDefault(p => p.NroPedido.HasValue);
            if (primerProductoConPedido != null)
            {
                ordenVentaImpresion = primerProductoConPedido.NroPedido.ToString() ?? "";
            }
            else
            {
                ordenVentaImpresion = "";
            }
            
            // Preparar items del remito
            itemsImpresion = productosRemito.Select(p => new ImpresionRemito.ItemRemito
            {
                Cantidad = p.Cantidad,
                Codigo = p.Codigo,
                Descripcion = p.Descripcion
            }).ToList();
            
            // Preparar observaciones (incluir destino si existe)
            observacionesImpresion = observaciones;
            
            // Preparar valor declarado
            valorDeclaradoImpresion = string.IsNullOrWhiteSpace(valorDeclarado) ? "" : $"U$S.{valorDeclarado}";
            
            // Preparar bultos
            if (int.TryParse(numeroBultos, out int bultos))
            {
                bultosImpresion = bultos;
            }
            else
            {
                bultosImpresion = 1;
            }
            
            // NCI vacío (no se usa según la imagen 2)
            nciImpresion = "";
            
            Console.WriteLine($"[RemitoCliente] Datos preparados para impresión: {numeroRemitoImpresion}");
            
            // Forzar actualización del componente
            StateHasChanged();
            
            // Esperar un momento para que se actualice el DOM
            await Task.Delay(100);
            
            // Imprimir usando la plantilla REMITOCLIENTE guardada en ReportePersonalizado
            // Se envían también Nume_Clie y Fechmov para filtrar datos de la plantilla.
            await ImprimirRemitoClientePorPlantillaAsync(
                numeroRemitoImpresion,
                numeroClienteSeleccionado,
                fechaRemito);
            
            Console.WriteLine("[RemitoCliente] Impresión por plantilla iniciada");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al preparar impresión: {ex.Message}");
            // No mostramos error al usuario para no interrumpir el flujo
        }
    }

    /// <summary>
    /// Imprime un remito de cliente usando la plantilla REMITOCLIENTE guardada en ReportePersonalizado.
    /// El parámetro doprilar corresponde al DoPriCor/DoPriLar del remito.
    /// Además se envían Nume_Clie y Fechmov para que la plantilla pueda filtrar por cliente y fecha.
    /// </summary>
    private async Task ImprimirRemitoClientePorPlantillaAsync(string? doPriCor, int? numeClie = null, DateTime? fechMov = null)
    {
        if (string.IsNullOrWhiteSpace(doPriCor))
        {
            await sweetAlertService.FireAsync("Atención", "El remito no tiene número para imprimir.", SweetAlertIcon.Warning);
            return;
        }

        var plantillaId = await GetPlantillaRemitoClienteIdAsync();
        if (!plantillaId.HasValue)
        {
            return;
        }

        var queryParams = new List<string>
        {
            $"Doprilar={Uri.EscapeDataString(doPriCor.Trim())}"
        };

        if (numeClie.HasValue)
        {
            queryParams.Add($"Nume_Clie={numeClie.Value}");
        }

        if (fechMov.HasValue && fechMov.Value > DateTime.MinValue)
        {
            queryParams.Add($"Fechmov={Uri.EscapeDataString(fechMov.Value.ToString("yyyy-MM-dd"))}");
        }

        var endpoint = $"api/impresiones/remito-plantillas/{plantillaId.Value}/pdf?{string.Join("&", queryParams)}";
        var responsePdf = await Http.GetAsync(endpoint);

        if (!responsePdf.IsSuccessStatusCode)
        {
            var message = await responsePdf.Content.ReadAsStringAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo generar el PDF del remito: {message}", SweetAlertIcon.Error);
            return;
        }

        var pdfBytes = await responsePdf.Content.ReadAsByteArrayAsync();
        if (pdfBytes.Length == 0)
        {
            await sweetAlertService.FireAsync("Error", "El PDF generado está vacío.", SweetAlertIcon.Error);
            return;
        }

        var base64 = Convert.ToBase64String(pdfBytes);
        var opened = await JS.InvokeAsync<bool>("openPdfInNewTab", base64);
        if (!opened)
        {
            await sweetAlertService.FireAsync("Atención", "No se pudo abrir el PDF en una nueva pestaña. Verificá el bloqueador de pop-ups.", SweetAlertIcon.Warning);
        }
    }

    /// <summary>
    /// Busca el Id de la plantilla REMITOCLIENTE en ReportePersonalizado.
    /// </summary>
    private async Task<int?> GetPlantillaRemitoClienteIdAsync()
    {
        if (plantillaRemitoClienteId.HasValue)
        {
            return plantillaRemitoClienteId;
        }

        var response = await repository.Get<List<RemitoPlantillaItemDto>>("api/impresiones/remito-plantillas");
        if (response.Error || response.Response == null)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo obtener el listado de plantillas de remito: {message}", SweetAlertIcon.Error);
            return null;
        }

        var plantilla = response.Response
            .FirstOrDefault(x => string.Equals(x.Nombre?.Trim(), NombrePlantillaRemitoCliente, StringComparison.OrdinalIgnoreCase));

        if (plantilla == null)
        {
            await sweetAlertService.FireAsync("Atención", $"No se encontró la plantilla '{NombrePlantillaRemitoCliente}'.", SweetAlertIcon.Warning);
            return null;
        }

        plantillaRemitoClienteId = plantilla.Id;
        return plantillaRemitoClienteId;
    }

