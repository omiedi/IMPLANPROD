    /// <summary>
    /// Se ejecuta cuando se confirman los lotes seleccionados
    /// </summary>
    private async void OnLotesConfirmados(List<SeleccionLotesModal.LoteSeleccionado> lotes)
    {
        if (productoTrazableSeleccionado == null)
        {
            Console.WriteLine("[RemitoCliente] Error: No hay producto trazable seleccionado");
            return;
        }

        Console.WriteLine($"[RemitoCliente] Lotes confirmados: {lotes.Count} lotes para {productoTrazableSeleccionado.Codigo}");

        // Crear el item del remito con los lotes seleccionados
        var nuevoItem = new ProductoRemito
        {
            CodInt = productoTrazableSeleccionado.Codint,
            Codigo = productoTrazableSeleccionado.Codigo ?? string.Empty,
            Descripcion = productoTrazableSeleccionado.Descripcion ?? string.Empty,
            Trazable = productoTrazableSeleccionado.Trazable ?? 0,
            Unidad = productoTrazableSeleccionado.Umedida ?? string.Empty,
            Cantidad = lotes.Sum(l => l.Cantidad),
            Lotes = lotes.Select(l => new LoteSeleccionado
            {
                Lote = l.Lote,
                Cantidad = l.Cantidad,
                SaldoDisponible = l.SaldoDisponible
            }).ToList()
        };

        productosRemito.Add(nuevoItem);
        StateHasChanged();

        // Si el ciclo sigue activo, reabrimos el modal de productos
        if (cicloSeleccionProductos && selectorProductos != null)
        {
            await Task.Delay(100);
            await selectorProductos.AbrirModal();
        }
    }

