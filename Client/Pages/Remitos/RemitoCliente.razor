    /// <summary>
    /// Maneja el envío del formulario
    /// </summary>
    private async Task HandleValidSubmit()
    {
        try
        {
            // Validación 1: Cliente seleccionado
            if (!numeroClienteSeleccionado.HasValue)
            {
                await sweetAlertService.FireAsync("Advertencia", "Debe seleccionar un cliente", SweetAlertIcon.Warning);
                return;
            }

            // Validación 2: Debe haber detalle
            if (productosRemito.Count == 0)
            {
                await sweetAlertService.FireAsync("Advertencia", "Debe agregar al menos un producto al remito", SweetAlertIcon.Warning);
                return;
            }

            // Validación 3: Todos los productos deben tener cantidad > 0
            var productosSinCantidad = productosRemito.Where(p => p.Cantidad <= 0).ToList();
            if (productosSinCantidad.Any())
            {
                await sweetAlertService.FireAsync("Advertencia", "Todos los productos deben tener cantidad mayor a 0", SweetAlertIcon.Warning);
                return;
            }

            // Validación 4: Productos trazables deben tener lotes asignados
            var productosTrazablesSinLotes = productosRemito.Where(p => p.Trazable == 1 && !p.Lotes.Any()).ToList();
            if (productosTrazablesSinLotes.Any())
            {
                var productos = string.Join(", ", productosTrazablesSinLotes.Select(p => p.Codigo));
                await sweetAlertService.FireAsync("Advertencia", 
                    $"Los siguientes productos trazables deben tener lotes asignados: {productos}", 
                    SweetAlertIcon.Warning);
                return;
            }

            // Obtener el tipo de numeración configurado
            var tipoNumeracion = await remitosConfigService.ObtenerTipoNumeracionRemitosAsync();
            Console.WriteLine($"[RemitoCliente] Tipo de numeración: {tipoNumeracion}");

            // Si es AUTONUME, mostrar confirmación del número que se va a usar
            if (tipoNumeracion == "AUTONUME")
            {
                // Obtener la fecha de nueva numeración configurada
                var fechaNuevaNumeracion = await remitosConfigService.ObtenerFechaNuevaNumeracionAsync();
                
                // Obtener el siguiente número disponible
                var ultimoNumero = await remitosConfigService.ObtenerUltimoNumeroRemitoAsync();
                var siguienteNumero = ultimoNumero + 1;
                
                // Obtener código de movimiento configurado
                var codigoMovimiento = await remitosConfigService.ObtenerCodigoMovimientoAsync();
                
                // Verificar si es la primera ejecución después de la fecha de nueva numeración
                // Esto ocurre cuando:
                // 1. La fecha configurada NO es la fecha por defecto (01/01/1980)
                // 2. La fecha configurada es >= hoy (fecha reciente)
                // 3. No hay remitos desde esa fecha (ultimoNumero == 0)
                bool esFechaDefecto = fechaNuevaNumeracion.Date == new DateTime(1980, 1, 1).Date;
                bool esFechaReciente = fechaNuevaNumeracion.Date >= DateTime.Now.Date;
                bool noHayRemitosDesdeEsaFecha = ultimoNumero == 0;
                
                bool esPrimeraEjecucionPostFecha = !esFechaDefecto && esFechaReciente && noHayRemitosDesdeEsaFecha;
                
                Console.WriteLine($"[RemitoCliente] Verificación primera ejecución: FechaConfig={fechaNuevaNumeracion:dd/MM/yyyy}, EsDefecto={esFechaDefecto}, EsReciente={esFechaReciente}, NoHayRemitos={noHayRemitosDesdeEsaFecha}, EsPrimera={esPrimeraEjecucionPostFecha}");
                
                if (esPrimeraEjecucionPostFecha)
                {
                    // Primera ejecución post-fecha: permitir ingreso manual del número
                    Console.WriteLine($"[RemitoCliente] Primera ejecución post-fecha {fechaNuevaNumeracion:dd/MM/yyyy}. Solicitando número de remito al usuario.");
                    
                    var remitoSugerido = $"{codigoMovimiento}-X-{ObtenerPrefijoFormateado()}-{siguienteNumero.ToString("D8")}";
                    
                    var result = await sweetAlertService.FireAsync(new SweetAlertOptions
                    {
                        Title = "Iniciar Nueva Numeración",
                        Html = $"Se ha configurado una nueva fecha de numeración: <strong>{fechaNuevaNumeracion:dd/MM/yyyy}</strong><br><br>" +
                               $"Número de remito sugerido:<br><strong style='font-size: 1.2em; color: #28a745;'>{remitoSugerido}</strong><br><br>" +
                               $"Ingrese el número de remito para iniciar la numeración:",
                        Icon = SweetAlertIcon.Question,
                        Input = SweetAlertInputType.Number,
                        InputValue = siguienteNumero.ToString(),
                        ShowCancelButton = true,
                        ConfirmButtonText = "Confirmar",
                        CancelButtonText = "Cancelar",
                        ConfirmButtonColor = "#28a745",
                        CancelButtonColor = "#dc3545"
                    });

                    if (!result.IsConfirmed || string.IsNullOrEmpty(result.Value))
                    {
                        Console.WriteLine("[RemitoCliente] Generación de remito cancelada por el usuario");
                        return;
                    }

                    // Validar y usar el número ingresado por el usuario
                    if (int.TryParse(result.Value, out int numeroIngresado) && numeroIngresado > 0)
                    {
                        numeroRemito = numeroIngresado;
                        Console.WriteLine($"[RemitoCliente] Usuario ingresó número de remito: {numeroRemito}");
                    }
                    else
                    {
                        await sweetAlertService.FireAsync("Error", "Debe ingresar un número válido mayor a 0", SweetAlertIcon.Error);
                        return;
                    }
                }
                else
                {
                    // Ejecución normal: mostrar confirmación estándar
                    var remitoCompleto = $"{codigoMovimiento}-X-{ObtenerPrefijoFormateado()}-{siguienteNumero.ToString("D8")}";
                    
                    Console.WriteLine($"[RemitoCliente] Mostrando confirmación para remito: {remitoCompleto}");
                    
                    var result = await sweetAlertService.FireAsync(new SweetAlertOptions
                    {
                        Title = "Confirmar Generación de Remito",
                        Html = $"Se va a generar el remito número:<br><br><strong style='font-size: 1.2em; color: #28a745;'>{remitoCompleto}</strong><br><br>¿Desea continuar?",
                        Icon = SweetAlertIcon.Question,
                        ShowCancelButton = true,
                        ConfirmButtonText = "Sí, continuar",
                        CancelButtonText = "Cancelar",
                        ConfirmButtonColor = "#28a745",
                        CancelButtonColor = "#dc3545"
                    });

                    if (!result.IsConfirmed)
                    {
                        Console.WriteLine("[RemitoCliente] Generación de remito cancelada por el usuario");
                        return;
                    }
                    
                    // Usar el siguiente número automático
                    numeroRemito = siguienteNumero;
                }
            }

            Console.WriteLine($"[RemitoCliente] Guardando remito para cliente {numeroClienteSeleccionado}");
            
            // Guardar el remito (incluye validación de duplicados)
            await GuardarRemito();
            
            await sweetAlertService.FireAsync("Éxito", "Remito guardado correctamente", SweetAlertIcon.Success);
            
            // Preparar e imprimir el remito
            await PrepararEImprimirRemito();
            
            // Limpiar formulario o navegar
            LimpiarFormulario();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RemitoCliente] Error al guardar: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al guardar el remito: {ex.Message}", SweetAlertIcon.Error);
        }
    }

