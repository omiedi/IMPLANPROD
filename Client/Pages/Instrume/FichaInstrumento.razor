    private async Task GuardarNuevoRegCalibracion()
    {
        if (instrumenoSeleccionado?.CodIntMedIdent is null || instrumenoSeleccionado.CodIntMedIdent <= 0)
        {
            claseMensajeModalNuevoRecalib = "alert-danger";
            mensajeModalNuevoRecalib = "No hay instrumento activo válido para guardar.";
            return;
        }

        if (!ValidarNuevoRecalib())
        {
            return;
        }

        guardandoModalNuevoRecalib = true;
        mensajeModalNuevoRecalib = string.Empty;
        StateHasChanged();

        try
        {
            nuevoRecalib.CodIntMedIdent = instrumenoSeleccionado.CodIntMedIdent;
            nuevoRecalib.Status = 0;
            nuevoRecalib.CodiEmprNet ??= 0;
            nuevoRecalib.LastUpdate = DateTime.Now;

            var responseRecalib = await repository.Post<Recalib, Recalib>("api/Recalib", nuevoRecalib);
            if (responseRecalib.Error || responseRecalib.Response == null)
            {
                var detalleError = await responseRecalib.GetErrorMessageAsync();
                claseMensajeModalNuevoRecalib = "alert-danger";
                mensajeModalNuevoRecalib = string.IsNullOrWhiteSpace(detalleError)
                    ? "No se pudo guardar el registro RECALIB."
                    : $"No se pudo guardar el registro RECALIB. {detalleError}";
                return;
            }

            var recalibCreado = responseRecalib.Response;
            var filasValidas = detallesNuevoRecalib
                .Where(d => !string.IsNullOrWhiteSpace(d.Patron) || d.Medida.HasValue || d.X1.HasValue || d.X2.HasValue || d.X3.HasValue || d.X4.HasValue || d.X5.HasValue)
                .ToList();

            foreach (var detalle in filasValidas)
            {
                RecalcularFilaDecalib(detalle);
                detalle.Status = 0;
                detalle.CodiEmprNet ??= 0;
                detalle.NumUsuar = nuevoRecalib.NumUsuar;

                var responseDecalib = await repository.Post($"api/Decalib/by-recalib/{recalibCreado.Id}", detalle);
                if (responseDecalib.Error)
                {
                    claseMensajeModalNuevoRecalib = "alert-warning";
                    mensajeModalNuevoRecalib = "RECALIB guardado, pero ocurrió un error al guardar una o más filas DECALIB.";
                    await CargarRegistrosRecalib(instrumenoSeleccionado.CodIntMedIdent.Value);
                    return;
                }
            }

            claseMensajeModalNuevoRecalib = "alert-success";
            mensajeModalNuevoRecalib = "Registro de calibración guardado correctamente.";

            await CargarRegistrosRecalib(instrumenoSeleccionado.CodIntMedIdent.Value);
            CerrarModalNuevoRecalib();
        }
        catch
        {
            claseMensajeModalNuevoRecalib = "alert-danger";
            mensajeModalNuevoRecalib = "Ocurrió un error al guardar el nuevo registro de calibración.";
        }
        finally
        {
            guardandoModalNuevoRecalib = false;
            StateHasChanged();
        }
    }

    private async Task CerrarModalDecalib()
    {
        if (modalDecalibTieneCambios)
        {
            var confirmar = await JS.InvokeAsync<bool>("confirm", "Hay cambios sin guardar. ¿Desea cerrar el modal igualmente?");
            if (!confirmar)
            {
                return;
            }
        }

        mostrarModalDecalib = false;
        mensajeModalDecalib = string.Empty;
        detallesDecalib = new List<Decalib>();
        modalDecalibTieneCambios = false;
    }

    private async Task CargarDetallesDecalib()
    {
        try
        {
            cargandoModalDecalib = true;
            StateHasChanged();

            var response = await repository.Get<List<Decalib>>($"api/Decalib/by-recalib/{recalibIdSeleccionado}");
            if (!response.Error && response.Response != null)
            {
                detallesDecalib = response.Response;
                foreach (var detalle in detallesDecalib)
                {
                    RecalcularFilaDecalib(detalle);
                }
                modalDecalibTieneCambios = false;
            }
            else
            {
                detallesDecalib = new List<Decalib>();
                modalDecalibTieneCambios = false;
            }
        }
        catch
        {
            detallesDecalib = new List<Decalib>();
            claseMensajeModalDecalib = "alert-danger";
            mensajeModalDecalib = "Ocurrió un error al consultar DECALIB.";
        }
        finally
        {
            cargandoModalDecalib = false;
            StateHasChanged();
        }
    }

    private async Task GuardarDetalleDecalib(Decalib detalle)
    {
        try
        {
            guardandoModalDecalib = true;
            mensajeModalDecalib = string.Empty;
            StateHasChanged();

            HttpResponseWrapper<object> response;
            if (detalle.Id > 0)
            {
                response = await repository.Put($"api/Decalib/{detalle.Id}", detalle);
            }
            else
            {
                response = await repository.Post($"api/Decalib/by-recalib/{recalibIdSeleccionado}", detalle);
            }

            if (!response.Error)
            {
                claseMensajeModalDecalib = "alert-success";
                mensajeModalDecalib = "Registro DECALIB guardado correctamente.";
                await CargarDetallesDecalib();
                return;
            }

            claseMensajeModalDecalib = "alert-danger";
            mensajeModalDecalib = "No se pudo guardar el registro DECALIB.";
        }
        catch
        {
            claseMensajeModalDecalib = "alert-danger";
            mensajeModalDecalib = "Error de conexión al guardar DECALIB.";
        }
        finally
        {
            guardandoModalDecalib = false;
            StateHasChanged();
        }
    }

    private async Task AceptarModalDecalib()
    {
        guardandoModalDecalib = true;
        mensajeModalDecalib = string.Empty;
        StateHasChanged();

        var guardados = 0;
        var errores = 0;

        foreach (var detalle in detallesDecalib)
        {
            RecalcularFilaDecalib(detalle);

            HttpResponseWrapper<object> response;
            if (detalle.Id > 0)
            {
                response = await repository.Put($"api/Decalib/{detalle.Id}", detalle);
            }
            else
            {
                response = await repository.Post($"api/Decalib/by-recalib/{recalibIdSeleccionado}", detalle);
            }

            if (response.Error)
            {
                errores++;
            }
            else
            {
                guardados++;
            }
        }

        guardandoModalDecalib = false;

        if (errores == 0)
        {
            claseMensajeModalDecalib = "alert-success";
            mensajeModalDecalib = $"Se guardaron correctamente {guardados} fila(s).";
            await CargarDetallesDecalib();
        }
        else
        {
            claseMensajeModalDecalib = "alert-warning";
            mensajeModalDecalib = $"Guardadas: {guardados}. Con error: {errores}. Revise e intente nuevamente.";
        }

        StateHasChanged();
    }

    private void ActualizarCampoYRecalcular(Decalib detalle, string campo, string? valorTexto)
    {
        var valor = ParseDecimal(valorTexto);

        switch (campo)
        {
            case nameof(Decalib.Medida):
                detalle.Medida = valor;
                break;
            case nameof(Decalib.X1):
                detalle.X1 = valor;
                break;
            case nameof(Decalib.X2):
                detalle.X2 = valor;
                break;
            case nameof(Decalib.X3):
                detalle.X3 = valor;
                break;
            case nameof(Decalib.X4):
                detalle.X4 = valor;
                break;
            case nameof(Decalib.X5):
                detalle.X5 = valor;
                break;
        }

        RecalcularFilaDecalib(detalle);
        modalDecalibTieneCambios = true;
    }

    private static decimal? ParseDecimal(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            return null;
        }

        if (decimal.TryParse(texto, NumberStyles.Any, CultureInfo.CurrentCulture, out var valorActual))
        {
            return valorActual;
        }

        if (decimal.TryParse(texto, NumberStyles.Any, CultureInfo.InvariantCulture, out var valorInvariante))
        {
            return valorInvariante;
        }

        return null;
    }

    private static string FormatearDecimalEditable(decimal? valor)
    {
        return valor?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    }

    private static string FormatearFechaInput(DateTime? fecha)
    {
        return fecha?.ToString("yyyy-MM-dd") ?? string.Empty;
    }

    private static DateTime? ParseFecha(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
        {
            return null;
        }

        if (DateTime.TryParse(valor, out var fecha))
        {
            return fecha;
        }

        return null;
    }

    private bool ValidarNuevoRecalib()
    {
        if (string.IsNullOrWhiteSpace(nuevoRecalib.IcNro)
            || string.IsNullOrWhiteSpace(nuevoRecalib.PatronUtilizado)
            || nuevoRecalib.FeCalibracion is null
            || string.IsNullOrWhiteSpace(nuevoRecalib.RequirioAjuste)
            || nuevoRecalib.FeProxCalibr is null
            || string.IsNullOrWhiteSpace(nuevoRecalib.Responsable)
            || nuevoRecalib.AddRecord is null)
        {
            claseMensajeModalNuevoRecalib = "alert-warning";
            mensajeModalNuevoRecalib = "Todos los datos de RECALIB son obligatorios.";
            return false;
        }

        var filasConDatos = detallesNuevoRecalib
            .Where(d => !string.IsNullOrWhiteSpace(d.Patron) || d.Medida.HasValue || d.X1.HasValue || d.X2.HasValue || d.X3.HasValue || d.X4.HasValue || d.X5.HasValue)
            .ToList();

        if (!filasConDatos.Any())
        {
            claseMensajeModalNuevoRecalib = "alert-warning";
            mensajeModalNuevoRecalib = "Debe agregar al menos una fila en DECALIB con Patrón y Medida.";
            return false;
        }

        if (filasConDatos.Any(d => string.IsNullOrWhiteSpace(d.Patron) || !d.Medida.HasValue))
        {
            claseMensajeModalNuevoRecalib = "alert-warning";
            mensajeModalNuevoRecalib = "Cada fila DECALIB con datos debe completar Patrón y Medida.";
            return false;
        }

        return true;
    }

    // ===================================================================
    // CÁLCULO AUTOMÁTICO DE E-PROM E I-ME
    // ===================================================================
    // Fórmulas solicitadas (usando MEDIDA como referencia):
    // 1) E-PROM = (|X1-MEDIDA| + |X2-MEDIDA| + |X3-MEDIDA| + |X4-MEDIDA| + |X5-MEDIDA|) / 5
    // 2) I-ME   = 1.6 * sqrt( ((X1-MEDIDA)^2 + (X2-MEDIDA)^2 + (X3-MEDIDA)^2 + (X4-MEDIDA)^2 + (X5-MEDIDA)^2) / 4 )
    //
    // Ejemplo guardado para validación:
    // MEDIDA=10, X1=1, X2=2, X3=3, X4=4, X5=5
    // Resultado esperado:
    // E-PROM = 7.000
    // I-ME   = 12.775
    private static void RecalcularFilaDecalib(Decalib detalle)
    {
        var medida = detalle.Medida ?? 0m;
        var x1 = detalle.X1 ?? 0m;
        var x2 = detalle.X2 ?? 0m;
        var x3 = detalle.X3 ?? 0m;
        var x4 = detalle.X4 ?? 0m;
        var x5 = detalle.X5 ?? 0m;

        var eProm = (Math.Abs(x1 - medida)
                   + Math.Abs(x2 - medida)
                   + Math.Abs(x3 - medida)
                   + Math.Abs(x4 - medida)
                   + Math.Abs(x5 - medida)) / 5m;

        var sumCuadrados = Math.Pow((double)(x1 - medida), 2)
                         + Math.Pow((double)(x2 - medida), 2)
                         + Math.Pow((double)(x3 - medida), 2)
                         + Math.Pow((double)(x4 - medida), 2)
                         + Math.Pow((double)(x5 - medida), 2);

        var iMe = 1.6m * (decimal)Math.Sqrt(sumCuadrados / 4d);
        var valorMaximo = 9999.999m;

        detalle.EProm = Math.Min(Math.Round(eProm, 3, MidpointRounding.AwayFromZero), valorMaximo);
        detalle.IMe = Math.Min(Math.Round(iMe, 3, MidpointRounding.AwayFromZero), valorMaximo);
    }

    private string LimpiarTexto(string? texto)
    {
        if (string.IsNullOrEmpty(texto))
            return "";
        
        return new string(texto.Where(c => c >= 32 || c == '\r' || c == '\n' || c == '\t').ToArray()).Trim();
    }
