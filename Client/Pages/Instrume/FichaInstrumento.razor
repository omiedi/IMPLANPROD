    private async Task AbrirModalNuevoRecalib()
    {
        mostrarModalNuevoRecalib = true;
        guardandoModalNuevoRecalib = false;
        mensajeModalNuevoRecalib = string.Empty;
        claseMensajeModalNuevoRecalib = "alert-info";

        var hoy = DateTime.Today;
        proximoIdRecalib = 0;

        var responseNextId = await repository.Get<int>("api/Recalib/NextId");
        if (!responseNextId.Error)
        {
            proximoIdRecalib = responseNextId.Response;
        }

        var idFlexoft = await currentUserService.GetIdFlexoftAsync();
        var userId = await currentUserService.GetUserIdAsync();
        var nombreUsuario = await currentUserService.GetNombreUsuarioAsync();
        var numUsuar = idFlexoft > 0 ? idFlexoft : userId;

        nuevoRecalib = new Recalib
        {
            CodIntMedIdent = instrumenoSeleccionado?.CodIntMedIdent,
