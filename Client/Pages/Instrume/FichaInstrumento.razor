@page "/ficha-instrumento"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject IJSRuntime JS
@inject CurrentUserService currentUserService
@inject PageAccessService PageAccess
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Services
@using Microsoft.AspNetCore.WebUtilities
@using System.Globalization

<PageTitle>Ficha de Calibración</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
    <div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-4">
    <h4 class="m-0 text-primary">
        <i class="fas fa-ruler-combined me-2"></i>
        Ficha de Calibración
    </h4>
</div>

<div class="mb-3">
    <button class="btn btn-outline-secondary" @onclick="VolverAFichaCalibracion">
        <i class="fas fa-arrow-left me-2"></i>Volver
    </button>
</div>

<!-- ===== FICHA DE DETALLE (SOLO LECTURA) ===== -->
@if (instrumenoSeleccionado != null)
{
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex align-items-center gap-2">
            <i class="fas fa-clipboard-list"></i>
            <strong>Ficha del Instrumento</strong>
            <span class="ms-auto badge bg-light text-primary">Cód. Interno: @instrumenoSeleccionado.CodIntMedIdent</span>
        </div>

        @if (cargandoDetalle)
        {
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted">Cargando...</div>
            </div>
        }
        else
        {
            <div class="card-body">
                <div class="row g-3">

                    <!-- CODIGO INTERNO (CodIntMedIdent) - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Código Interno</label>
                        <input type="text" class="form-control bg-light" readonly value="@(instrumenoSeleccionado.CodIntMedIdent?.ToString() ?? "")" />
                    </div>

                    <!-- CODIGO - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Código</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.Codigo)" />
                    </div>

                    <!-- DESCRIPCION - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Descripción</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.Descripcion)" />
                    </div>

                    <!-- TIPO - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Tipo</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.Tipo)" />
                    </div>

                    <!-- MARCA - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Marca</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.Marca)" />
                    </div>

                    <!-- MODELO - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Modelo</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.Modelo)" />
                    </div>

                    <!-- NRO SERIE - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Nro. de Serie</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.NroSerie)" />
                    </div>

                    <!-- RANGO - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Rango</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.Rango)" />
                    </div>

                    <!-- PRECISION (Posicion) - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Precisión</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.Posicion)" />
                    </div>

                    <!-- UBICACION - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Ubicación</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.Ubicacion)" />
                    </div>

                    <!-- GRUPO - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Grupo</label>
                        <input type="text" class="form-control bg-light" readonly value="@(instrumenoSeleccionado.NroGrupo?.ToString() ?? "")" />
                    </div>

                    <!-- INTERVCALIBRA - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Intervalo de Calibración</label>
                        <input type="text" class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado.IntervCalibra)" />
                    </div>

                    <!-- CodIntMedCalib - READONLY -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Cód. Interno Instrumento Calibrador</label>
                        <input type="text" class="form-control bg-light" readonly value="@(instrumenoSeleccionado.CodIntMedCalib?.ToString() ?? "")" />
                    </div>

                    <!-- OBSERVACIONES - READONLY -->
                    <div class="col-12 mt-2">
                        <label class="form-label fw-semibold">Componentes y/o Accesorios</label>
                        <textarea class="form-control bg-light" readonly rows="6">@LimpiarTexto(instrumenoSeleccionado.Observaciones)</textarea>
                    </div>

                </div>
            </div>
        }
    </div>
}

<!-- ===== TABLA DE REGISTROS DE CALIBRACIÓN ===== -->
@if (instrumenoSeleccionado != null)
{
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-success text-white d-flex align-items-center gap-2">
            <i class="fas fa-clipboard-check"></i>
            <strong>Registros de Calibración</strong>
            <button class="btn btn-light btn-sm ms-auto"
                    @onclick="AbrirModalNuevoRecalib">
                <i class="fas fa-plus me-1"></i>Nuevo Reg. Calibración
            </button>
        </div>

        @if (cargandoRecalibs)
        {
            <div class="card-body text-center py-4">
                <div class="spinner-border text-success" role="status"></div>
                <div class="mt-2 text-muted">Cargando registros...</div>
            </div>
        }
        else if (registrosRecalib == null || !registrosRecalib.Any())
        {
            <div class="card-body text-center py-4 text-muted">
                <i class="fas fa-info-circle me-2"></i>
                No hay registros de calibración para este instrumento
            </div>
        }
        else
        {
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-success">
                            <tr>
                                <th>Fecha de Calibración</th>
                                <th>IC_NRO</th>
                                <th>Patrón Utilizado</th>
                                <th>Requirió Calibración</th>
                                <th>Requirió Ajuste</th>
                                <th>Fecha de Próx. Calibr.</th>
                                <th>Responsable</th>
                                <th>ID RECALIB</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var recalib in registrosRecalib)
                            {
                                <tr>
                                    <td>@(recalib.FeCalibracion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@LimpiarTexto(recalib.IcNro)</td>
                                    <td>@LimpiarTexto(recalib.PatronUtilizado)</td>
                                    <td>@LimpiarTexto(recalib.RequirioCalib)</td>
                                    <td>@LimpiarTexto(recalib.RequirioAjuste)</td>
                                    <td>@(recalib.FeProxCalibr?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@LimpiarTexto(recalib.Responsable)</td>
                                    <td>@recalib.Id</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => AbrirModalDecalib(recalib.Id)">
                                            I. Med. Ensayo
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
}

@if (mostrarModalNuevoRecalib)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-scrollable" role="document" style="max-width:95vw; width:95vw;">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title mb-0">Nuevo Reg. Calibración</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalNuevoRecalib"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Código</label>
                            <input class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado?.Codigo)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Descripción</label>
                            <input class="form-control bg-light" readonly value="@LimpiarTexto(instrumenoSeleccionado?.Descripcion)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Código Interno</label>
                            <input class="form-control bg-light" readonly value="@(instrumenoSeleccionado?.CodIntMedIdent?.ToString() ?? "")" />
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensajeModalNuevoRecalib))
                    {
                        <div class="alert @claseMensajeModalNuevoRecalib" role="alert">@mensajeModalNuevoRecalib</div>
                    }

                    <div class="mb-2 d-flex gap-2">
                        <button class="btn btn-outline-success btn-sm" @onclick="AgregarFilaNuevoDecalib" disabled="@guardandoModalNuevoRecalib">
                            <i class="fas fa-plus me-1"></i>Agregar fila DECALIB
                        </button>
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>PATRON</th>
                                    <th>MEDIDA</th>
                                    <th>X1</th>
                                    <th>X2</th>
                                    <th>X3</th>
                                    <th>X4</th>
                                    <th>X5</th>
                                    <th>E-PROM</th>
                                    <th>I-ME</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in detallesNuevoRecalib)
                                {
                                    <tr>
                                        <td><input class="form-control form-control-sm" value="@detalle.Patron" @oninput="e => ActualizarPatronNuevo(detalle, e.Value?.ToString())" /></td>
                                        <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.Medida)" @oninput="e => ActualizarCampoYRecalcularNuevo(detalle, nameof(Decalib.Medida), e.Value?.ToString())" /></td>
                                        <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X1)" @oninput="e => ActualizarCampoYRecalcularNuevo(detalle, nameof(Decalib.X1), e.Value?.ToString())" /></td>
                                        <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X2)" @oninput="e => ActualizarCampoYRecalcularNuevo(detalle, nameof(Decalib.X2), e.Value?.ToString())" /></td>
                                        <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X3)" @oninput="e => ActualizarCampoYRecalcularNuevo(detalle, nameof(Decalib.X3), e.Value?.ToString())" /></td>
                                        <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X4)" @oninput="e => ActualizarCampoYRecalcularNuevo(detalle, nameof(Decalib.X4), e.Value?.ToString())" /></td>
                                        <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X5)" @oninput="e => ActualizarCampoYRecalcularNuevo(detalle, nameof(Decalib.X5), e.Value?.ToString())" /></td>
                                        <td><input class="form-control form-control-sm bg-light" readonly value="@(detalle.EProm?.ToString("0.000") ?? "0.000")" /></td>
                                        <td><input class="form-control form-control-sm bg-light" readonly value="@(detalle.IMe?.ToString("0.000") ?? "0.000")" /></td>
                                        <td>
                                            <button class="btn btn-danger btn-sm px-2"
                                                    @onclick="() => EliminarFilaNuevoDecalib(detalle)"
                                                    disabled="@(guardandoModalNuevoRecalib || detallesNuevoRecalib.Count == 1)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">IC-NRO *</label>
                            <input class="form-control bg-light" readonly value="@nuevoRecalib.IcNro" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Patrón Utilizado *</label>
                            <input class="form-control" @bind="nuevoRecalib.PatronUtilizado" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Req. Calibración (Fecha) *</label>
                            <input type="date" class="form-control"
                                   value="@FormatearFechaInput(nuevoRecalib.FeCalibracion)"
                                   @oninput="e => nuevoRecalib.FeCalibracion = ParseFecha(e.Value?.ToString())" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Requirió Ajuste *</label>
                            <input class="form-control" @bind="nuevoRecalib.RequirioAjuste" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Prox. Calibración (Fecha) *</label>
                            <input type="date" class="form-control"
                                   value="@FormatearFechaInput(nuevoRecalib.FeProxCalibr)"
                                   @oninput="e => nuevoRecalib.FeProxCalibr = ParseFecha(e.Value?.ToString())" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Responsable *</label>
                            <input class="form-control" @bind="nuevoRecalib.Responsable" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Fecha del día *</label>
                            <input type="date" class="form-control"
                                   value="@FormatearFechaInput(nuevoRecalib.AddRecord)"
                                   @oninput="e => nuevoRecalib.AddRecord = ParseFecha(e.Value?.ToString())" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Siguiente ID</label>
                            <input class="form-control bg-light" readonly value="@proximoIdRecalib" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success" @onclick="GuardarNuevoRegCalibracion" disabled="@guardandoModalNuevoRecalib">
                        Guardar
                    </button>
                    <button class="btn btn-secondary" @onclick="CerrarModalNuevoRecalib" disabled="@guardandoModalNuevoRecalib">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show" @onclick="CerrarModalNuevoRecalib"></div>
}

@if (mostrarModalDecalib)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-scrollable" role="document" style="max-width:95vw; width:95vw;">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title mb-0">I. Med. Ensayo</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalDecalib"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <span class="badge bg-primary">RECALIB.Id seleccionado: @recalibIdSeleccionado</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensajeModalDecalib))
                    {
                        <div class="alert @claseMensajeModalDecalib" role="alert">@mensajeModalDecalib</div>
                    }

                    <div class="mb-3">
                        <button class="btn btn-outline-primary btn-sm" @onclick="AgregarFilaDecalib">
                            <i class="fas fa-plus me-1"></i>Agregar fila
                        </button>
                    </div>

                    @if (cargandoModalDecalib)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="mt-2 text-muted">Cargando datos DECALIB...</div>
                        </div>
                    }
                    else if (detallesDecalib == null || !detallesDecalib.Any())
                    {
                        <div class="alert alert-info mb-0" role="alert">
                            No hay registros en DECALIB para este RECALIB.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle">
                                <thead>
                                    <tr>
                                        <th>PATRON</th>
                                        <th>MEDIDA</th>
                                        <th>X1</th>
                                        <th>X2</th>
                                        <th>X3</th>
                                        <th>X4</th>
                                        <th>X5</th>
                                        <th>E-PROM</th>
                                        <th>I-ME</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in detallesDecalib)
                                    {
                                        <tr>
                                            <td><input class="form-control form-control-sm" @bind="detalle.Patron" /></td>
                                            <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.Medida)" @oninput="e => ActualizarCampoYRecalcular(detalle, nameof(Decalib.Medida), e.Value?.ToString())" /></td>
                                            <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X1)" @oninput="e => ActualizarCampoYRecalcular(detalle, nameof(Decalib.X1), e.Value?.ToString())" /></td>
                                            <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X2)" @oninput="e => ActualizarCampoYRecalcular(detalle, nameof(Decalib.X2), e.Value?.ToString())" /></td>
                                            <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X3)" @oninput="e => ActualizarCampoYRecalcular(detalle, nameof(Decalib.X3), e.Value?.ToString())" /></td>
                                            <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X4)" @oninput="e => ActualizarCampoYRecalcular(detalle, nameof(Decalib.X4), e.Value?.ToString())" /></td>
                                            <td><input type="number" step="0.001" class="form-control form-control-sm" value="@FormatearDecimalEditable(detalle.X5)" @oninput="e => ActualizarCampoYRecalcular(detalle, nameof(Decalib.X5), e.Value?.ToString())" /></td>
                                            <td><input class="form-control form-control-sm bg-light" readonly value="@(detalle.EProm?.ToString("0.000") ?? "0.000")" /></td>
                                            <td><input class="form-control form-control-sm bg-light" readonly value="@(detalle.IMe?.ToString("0.000") ?? "0.000")" /></td>
                                            <td class="text-nowrap">
                                                <button class="btn btn-success btn-sm px-2"
                                                        @onclick="() => GuardarDetalleDecalib(detalle)"
                                                        disabled="@guardandoModalDecalib"
                                                        title="Guardar"
                                                        aria-label="Guardar">
                                                    <i class="fas fa-save"></i>
                                                </button>
                                                <button class="btn btn-danger btn-sm px-2 ms-1"
                                                        @onclick="() => EliminarDetalleDecalib(detalle)"
                                                        title="Eliminar"
                                                        aria-label="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="AceptarModalDecalib" disabled="@(!modalDecalibTieneCambios || guardandoModalDecalib)">Aceptar</button>
                    <button class="btn btn-secondary" @onclick="CerrarModalDecalib">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show" @onclick="CerrarModalDecalib"></div>
    }
}

@code {
    private Instrume? instrumenoSeleccionado;
    private bool cargandoDetalle = false;
    private bool validando = true;
    private List<Recalib>? registrosRecalib;
    private bool cargandoRecalibs = false;
    private int? idInstrumentoActual;
    private bool mostrarModalDecalib = false;
    private bool cargandoModalDecalib = false;
    private bool guardandoModalDecalib = false;
    private bool modalDecalibTieneCambios = false;
    private bool mostrarModalNuevoRecalib = false;
    private bool guardandoModalNuevoRecalib = false;
    private string mensajeModalNuevoRecalib = string.Empty;
    private string claseMensajeModalNuevoRecalib = "alert-info";
    private int proximoIdRecalib;
    private Recalib nuevoRecalib = new();
    private List<Decalib> detallesNuevoRecalib = new();
    private int recalibIdSeleccionado;
    private List<Decalib> detallesDecalib = new();
    private string mensajeModalDecalib = string.Empty;
    private string claseMensajeModalDecalib = "alert-info";

    // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
    protected override async Task OnInitializedAsync()
    {
        await PageAccess.RequiereAccesoAsync("/ficha-instrumento");
        validando = false;
        
        // Verificar si viene un ID por query string
        var uri = navigationManager.ToAbsoluteUri(navigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("id", out var idValue))
        {
            if (int.TryParse(idValue, out var id) && id > 0)
            {
                idInstrumentoActual = id;
                await CargarInstrumentoPorId(id);
                if (instrumenoSeleccionado?.CodIntMedIdent is int codIntMedIdent && codIntMedIdent > 0)
                {
                    await CargarRegistrosRecalib(codIntMedIdent);
                }
            }
        }
    }

    private void AgregarFilaDecalib()
    {
        var nueva = new Decalib
        {
            Status = 0,
            CodiEmprNet = 0,
            IdReCalib = 0
        };

        RecalcularFilaDecalib(nueva);
        detallesDecalib.Add(nueva);
        modalDecalibTieneCambios = true;
    }

    private async Task EliminarDetalleDecalib(Decalib detalle)
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm", "¿Confirma eliminar esta fila de DECALIB?");
        if (!confirmar)
        {
            return;
        }

        if (detalle.Id <= 0)
        {
            detallesDecalib.Remove(detalle);
            modalDecalibTieneCambios = true;
            claseMensajeModalDecalib = "alert-info";
            mensajeModalDecalib = "Fila nueva eliminada.";
            StateHasChanged();
            return;
        }

        var response = await repository.Delete($"api/Decalib/{detalle.Id}");
        if (!response.Error)
        {
            detallesDecalib.Remove(detalle);
            modalDecalibTieneCambios = true;
            claseMensajeModalDecalib = "alert-success";
            mensajeModalDecalib = "Registro DECALIB eliminado correctamente.";
            await CargarDetallesDecalib();
            return;
        }

        claseMensajeModalDecalib = "alert-danger";
        mensajeModalDecalib = "No se pudo eliminar el registro DECALIB.";
        StateHasChanged();
    }

