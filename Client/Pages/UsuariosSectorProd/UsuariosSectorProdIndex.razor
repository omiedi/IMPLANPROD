@page "/UsuariosSectorProd"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS

@using System.Net.Http
@using CurrieTechnologies.Razor.SweetAlert2

<div class="bg-primary text-white text-center p-3 mb-4">
    <h1>Usuarios - Sectores Productivos</h1>
</div>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center">
        <div class="me-2">
            <a class="btn btn-sm btn-primary" @onclick=@(() => ShowModal())><i class="oi oi-plus"></i> Nueva Asignación</a>
        </div>

        <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar por usuario o sector..." @bind-value="Filter" />
        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>

    <div>
        <a href="/UsuariosSectorProd/Baja" class="btn btn-sm btn-warning">
            <i class="fas fa-trash-restore"></i> Restaurar asignaciones de Baja
        </a>
    </div>
</div>

<Pagination CurrentPage="currentPage"
TotalPages="totalPages"
SelectedPage="SelectedPageAsync" />

<GenericList MyList="usuariosSectorProd">
    <Body>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>ID Flexoft</th>
                    <th>Nombre Usuario</th>
                    <th>Código SecProd</th>
                    <th>Descripción Sector</th>
                    <th>Fecha Creación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in usuariosSectorProd!)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.IdFlexoft</td>
                        <td>@item.NombreUsuario</td>
                        <td>@item.CodigoSecProd</td>
                        <td>@item.Descripcion</td>
                        <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a @onclick=@(() => ShowModal(@item.Id,true)) class="btn btn-warning btn-sm flex-fill"><i class="oi oi-pencil" /> Editar</a>
                            <button class="btn btn-danger btn-sm" @onclick=@(() => DeleteAsync(item.Id))>Borrar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </Body>
    <NoRecords>
        <div class="alert alert-info text-center" role="alert">
            <i class="fas fa-info-circle fa-2x mb-3"></i>
            <h5>No hay asignaciones de usuarios a sectores productivos</h5>
            <p class="mb-0">Haga clic en "Nueva Asignación" para crear la primera asignación usuario-sector productivo.</p>
        </div>
    </NoRecords>
</GenericList>

@code {

    /// <summary>
    /// Lista de asignaciones usuario-sector productivo
    /// </summary>
    public List<UsuariosSectorProd>? usuariosSectorProd { get; set; } = new();
    
    [CascadingParameter]
    IModalService Modal { get; set; } = default!;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]
    public string Filter { get; set; } = string.Empty;

    private int currentPage = 1;
    private int totalPages;

    /// <summary>
    /// Inicialización del componente - carga los datos iniciales
    /// </summary>
    protected async override Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    /// <summary>
    /// Carga los datos de asignaciones con paginación y filtros
    /// </summary>
    /// <param name="page">Número de página a cargar</param>
    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }

        string url1 = string.Empty;
        string url2 = string.Empty;

        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/usuariossectorprod?page={page}";
            url2 = $"api/usuariossectorprod/totalPages";
        }
        else
        {
            url1 = $"api/usuariossectorprod?page={page}&filter={Filter}";
            url2 = $"api/usuariossectorprod/totalPages?filter={Filter}";
        }

        var responseHppt = await repository.Get<List<UsuariosSectorProd>>(url1);
        var responseHppt2 = await repository.Get<int>(url2);
        usuariosSectorProd = responseHppt.Response!;
        totalPages = responseHppt2.Response!;
    }

    /// <summary>
    /// Elimina (cambia status a -1) una asignación usuario-sector
    /// </summary>
    /// <param name="id">ID de la asignación a eliminar</param>
    private async Task DeleteAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Realmente deseas eliminar esta asignación?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si"
        });

        var confirm = string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        int status = -1;
        var responseHTTP = await repository.Delete($"api/usuariossectorprod/cambiaStatus/{id}/{status}");
        if (responseHTTP.Error)
        {
            if (responseHTTP.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/");
            }
            else
            {
                var mensajeError = await responseHTTP.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            }
        }
        else
        {
            await LoadAsync();
        }
    }

    /// <summary>
    /// Limpia el filtro de búsqueda
    /// </summary>
    private async Task CleanFilterAsync()
    {
        Filter = string.Empty;
        await ApplyFilterAsync();
    }

    /// <summary>
    /// Aplica el filtro de búsqueda
    /// </summary>
    private async Task ApplyFilterAsync()
    {
        int page = 1;
        await LoadAsync(page);
    }

    /// <summary>
    /// Cambia a la página seleccionada
    /// </summary>
    /// <param name="page">Número de página</param>
    private async Task SelectedPageAsync(int page)
    {
        currentPage = page;
        await LoadAsync(page);
    }

    /// <summary>
    /// Muestra el modal para crear o editar una asignación
    /// </summary>
    /// <param name="id">ID de la asignación (0 para crear nueva)</param>
    /// <param name="isEdit">Indica si es modo edición</param>
    private async Task ShowModal(int id = 0, bool isEdit = false)
    {
        IModalReference modalReference;

        if (isEdit)
        {
            modalReference = Modal.Show<UsuariosSectorProdEdit>(string.Empty, new ModalParameters().Add("Id", id));
        }
        else
        {
            modalReference = Modal.Show<UsuariosSectorProdCreate>();
        }

        var result = await modalReference.Result;
        if (result.Confirmed)
        {
            await LoadAsync();
        }
    }
}
