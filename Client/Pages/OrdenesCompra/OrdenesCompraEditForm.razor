            var itemOriginal = detalleItems?.FirstOrDefault(i => i.OCOMDETA_ID == itemEnEdicion.OCOMDETA_ID);
            if (itemOriginal != null)
            {
                // Actualizar solo los campos permitidos
                itemOriginal.CantOcom = itemEnEdicion.CantOcom;
                itemOriginal.PreUnit = itemEnEdicion.PreUnit;
                itemOriginal.FentreSol = itemEnEdicion.FentreSol;
                itemOriginal.SectOcom = itemEnEdicion.SectOcom;
                itemOriginal.IContab = itemEnEdicion.IContab;

