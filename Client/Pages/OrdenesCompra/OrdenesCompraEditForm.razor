@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.DTOs.Impresiones
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Shared.Components
@using IMPLANPROD.Client.Services
@using System.ComponentModel.DataAnnotations
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager
@inject AuthErrorHandlerService authErrorHandler
@inject IJSRuntime JS
@inject HttpClient Http

<div class="container-fluid">
    <div class="row">
        <!-- Columna principal del formulario -->
        <div class="col-lg-12">
            <!-- Contenedor principal con marco grueso -->
            <div class="card" style="border: 3px solid #fd7e14; border-radius: 8px;">
                <!-- Header del formulario principal -->
                <div class="card-header" style="background-color: #fd7e14; color: white; border-bottom: 3px solid #e8590c;">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-edit"></i>
                        <span>Editar Orden de Compra N° @ordenCompra.NumeOcom</span>
                        @if (!string.IsNullOrEmpty(ordenCompra.PorcIva))
                        {
                            <span class="badge bg-light text-dark ms-2">IVA: @ordenCompra.PorcIva</span>
                        }
                    </h5>
                </div>

                <!-- Validación de Estado -->
                @if (ordenCompra.StatOcom >= 9)
                {
                    <div class="alert alert-danger m-3" role="alert">
                        <i class="fas fa-lock me-2"></i>
                        <strong>Orden Bloqueada:</strong> Esta orden de compra no se puede modificar porque su estado es @ordenCompra.StatOcom (≥ 9).
                        <br><small>Las órdenes con estado 9 o superior están cerradas y no permiten modificaciones.</small>
                    </div>
                }
                else
                {
                    <!-- Cuerpo del formulario principal -->
                    <div class="card-body" style="padding: 1.5rem;">
                        <EditForm Model="ordenCompra" OnValidSubmit="HandleValidSubmit">
                            <DataAnnotationsValidator />

                            <!-- Información del encabezado -->
                            <div class="row mb-3">
                                <div class="col-md-2">
                                    <label class="form-label">N° Orden:</label>
                                    <InputNumber class="form-control" @bind-Value="ordenCompra.NumeOcom" readonly="true" />
                                    <ValidationMessage For="@(() => ordenCompra.NumeOcom)" />
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label">Versión:</label>
                                    <input type="text" class="form-control" value="@((ordenCompra.OcomRevis ?? 0) + 1)" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Fecha Emisión:</label>
                                    <InputDate class="form-control" @bind-Value="ordenCompra.FemiOcom" />
                                    <ValidationMessage For="@(() => ordenCompra.FemiOcom)" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Destino:</label>
                                    <InputText class="form-control" @bind-Value="destinoOrdenCompra" readonly />
                                    <small class="text-muted">Destino asignado en el alta</small>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Sector:</label>
                                    <InputText class="form-control" @bind-Value="sectorOrdenCompra" readonly />
                                    <small class="text-muted">Sector asignado en el alta</small>
                                </div>
                            </div>

                            <!-- Segunda fila del encabezado -->
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label class="form-label">% IVA:</label>
                                    <input type="text" class="form-control" value="@ordenCompra.PorcIva" readonly />
                                    <small class="text-muted">Porcentaje de IVA aplicado</small>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Tipo Cambio:</label>
                                    <InputNumber class="form-control" @bind-Value="ordenCompra.TcamOcom" step="0.0001" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Referencia:</label>
                                    <InputText class="form-control" @bind-Value="ordenCompra.RefeOcom" />
                                </div>
                            </div>

                            <!-- Información del proveedor -->
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Proveedor:</label>
                                    <InputText class="form-control" 
                                    @bind-Value="proveedorSeleccionado" 
                                    readonly />
                                    <small class="text-muted">El proveedor no puede modificarse en edición</small>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label">Razón Social:</label>
                                    <InputText class="form-control" @bind-Value="ordenCompra.RaSoProv" readonly />
                                </div>
                            </div>

                            <!-- Información adicional del proveedor -->
                            @if (proveedorInfo != null && !string.IsNullOrEmpty(proveedorInfo.CodigoProveedor))
                            {
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Código Proveedor:</label>
                                        <InputText class="form-control" @bind-Value="proveedorInfo.CodigoProveedor" readonly />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Domicilio:</label>
                                        <InputText class="form-control" @bind-Value="proveedorInfo.Domicilio" readonly />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Cod.Postal:</label>
                                        <InputText class="form-control" @bind-Value="proveedorInfo.CodigoPostal" readonly />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Localidad:</label>
                                        <InputText class="form-control" @bind-Value="proveedorInfo.Localidad" readonly />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Teléfono:</label>
                                        <InputText class="form-control" @bind-Value="proveedorInfo.Contacto" readonly />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Atención:</label>
                                        <InputText class="form-control" @bind-Value="ContactoAtencion" />
                                        <small class="text-muted">Persona de contacto para esta orden</small>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">CUIT:</label>
                                        <InputText class="form-control" @bind-Value="proveedorInfo.Cuit" readonly />
                                    </div>
                                </div>
                            }

                            <!-- Información adicional -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Moneda:</label>
                                    <InputSelect class="form-select" @bind-Value="CodigoMonedaSeleccionado">
                                        <option value="0">Seleccionar...</option>
                                        @if (monedas != null)
                                        {
                                            @foreach (var moneda in monedas)
                                            {
                                                <option value="@moneda.CodigoMoneda">@moneda.Descripcion</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Cond. de Pago:</label>
                                    <InputSelect class="form-select" @bind-Value="ordenCompra.CpagOcom">
                                        <option value="">Seleccionar...</option>
                                        @if (condicionesPago != null)
                                        {
                                            @foreach (var condicion in condicionesPago)
                                            {
                                                <option value="@condicion.NumCondPag">@condicion.DescCondPag</option>
                                            }
                                        }
                                    </InputSelect>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Valorizar en:</label>
                                    <InputSelect class="form-select" @bind-Value="ordenCompra.MoneCos" title="Moneda para valorización de costos">
                                        <option value="">Seleccionar...</option>
                                        @if (monedas != null)
                                        {
                                            @foreach (var moneda in monedas)
                                            {
                                                <option value="@moneda.CodigoMoneda">@moneda.Descripcion</option>
                                            }
                                        }
                                    </InputSelect>
                                    <div class="form-text">
                                        <small class="text-muted">
                                            <i class="fas fa-info-circle me-1"></i>Moneda utilizada para valorizar los costos de los productos
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Información adicional -->
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Lugar de Entrega:</label>
                                    <InputText class="form-control" @bind-Value="ordenCompra.Lentrega" placeholder="Especificar lugar de entrega..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Solicita:</label>
                                    <InputText class="form-control" @bind-Value="ordenCompra.ResponOcompra" placeholder="Persona que solicita la orden..." />
                                </div>
                            </div>

                            <!-- Observaciones -->
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="form-label">Observaciones:</label>
                                    <InputTextArea class="form-control" @bind-Value="ordenCompra.ObseOcom" rows="3" />
                                </div>
                            </div>

                            <!-- Botones de acción -->
                            <div class="row">
                                <div class="col-12 d-flex justify-content-end gap-2">
                                    @if (ordenCompra.StatOcom == 0)
                                    {
                                        <button type="button" class="btn btn-success" @onclick="AbrirModalRemisionConsignacionesAsync" disabled="@guardando">
                                            <i class="fas fa-truck"></i> Remitir Componentes
                                        </button>
                                    }
                                    <button type="button" class="btn btn-secondary" @onclick="Cancelar" disabled="@guardando">
                                        <i class="fas fa-times"></i> Cancelar y Regresar
                                    </button>
                                    <button type="submit" class="btn btn-warning" disabled="@guardando">
                                        @if (guardando)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <i class="fas fa-save"></i> Actualizar Orden
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                }

                <!-- Detalle de la orden (igual que en OrdenesCompraForm) -->
                @if (true)
                {
                    <div class="border-top" style="border-color: #0a58ca !important; border-width: 2px !important; margin: 0 1.5rem;"></div>
                    <div class="card-body" style="padding: 1.5rem; padding-top: 1rem;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">
                                <i class="fas fa-list"></i> Detalle de la Orden
                            </h6>
                            @if (ordenCompra.StatOcom < 9)
                            {
                                <button type="button" class="btn btn-sm btn-primary" @onclick="AgregarItem">
                                    <i class="fas fa-plus"></i> Agregar Item
                                </button>
                            }
                        </div>

                        <!-- Leyenda informativa sobre eliminación de items -->
                        <div class="alert alert-warning border-0 shadow-sm mb-3" style="font-size: 0.9em;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle text-warning me-2"></i>
                                <div>
                                    <strong>Nota:</strong> No es posible eliminar items de la orden. 
                                    Para anular un item, edítelo y cambie la cantidad a <strong>0</strong>.
                                </div>
                            </div>
                        </div>
                        @if (detalleItems == null)
                        {
                            <div class="text-center">
                                <div class="spinner-border spinner-border-sm"></div>
                                <span class="ms-2">Cargando detalle...</span>
                            </div>
                        }
                        else if (!detalleItems.Any())
                        {
                            <div class="alert alert-info text-center">
                                <i class="fas fa-info-circle"></i> No hay items en esta orden.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Item</th>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            <th class="text-end">Cantidad</th>
                                            <th class="text-end">Precio Unit.</th>
                                            <th class="text-end">Total</th>
                                            <th>U.M.</th>
                                            <th>Sector</th>
                                            <th>Destino</th>
                                            <th>Fecha Entrega</th>
                                            @if (ordenCompra.StatOcom < 9)
                                            {
                                                <th>Acciones</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in detalleItems)
                                        {
                                            <tr>
                                                <td>@item.NuOrdItem</td>
                                                <td>@item.CodExte</td>
                                                <td>@item.Descritem</td>
                                                <td class="text-end">@item.CantOcom?.ToString("F2")</td>
                                                <td class="text-end">@item.PreUnit?.ToString("C4")</td>
                                                <td class="text-end">@((item.CantOcom * item.PreUnit)?.ToString("C2"))</td>
                                                <td>@item.UniMas</td>
                                                <td>@item.SectOcom</td>
                                                <td>
                                                    @if (item.IContab.HasValue && cuentasDestino != null)
                                                    {
                                                        var cuenta = cuentasDestino.FirstOrDefault(c => c.CodInCue == item.IContab.Value);
                                                        if (cuenta != null)
                                                        {
                                                            <span>@cuenta.CodExCue - @cuenta.Denocue</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Código: @item.IContab</span>
                                                        }
                                                    }
                                                </td>
                                                <td>@item.FentreSol?.ToString("dd/MM/yyyy")</td>
                                                @if (ordenCompra.StatOcom < 9)
                                                {
                                                    <td>
                                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="(() => EditarItem(item))" title="Editar item">
                                                            <i class="fas fa-edit"></i> Editar
                                                        </button>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Totales, Descuentos y Resumen -->
                            <div class="row mt-3">
                                <div class="col-md-4">
                                    <!-- Sección de Descuentos -->
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0">DESCUENTOS</h6>
                                        </div>
                                        <div class="card-body">
                                            @if (ordenCompra.StatOcom < 9)
                                            {
                                                <!-- Campo de descuento en texto -->
                                                <div class="mb-3">
                                                    <label class="form-label">Descuento (texto)</label>
                                                    <input type="text" class="form-control" @bind="DescuentoTexto" @bind:event="oninput" placeholder="Ej: 10 o 10 + 5" />
                                                    <small class="text-muted">Ingrese número o expresiones como "10 + 5" para descuentos sucesivos.</small>
                                                </div>
                                            }

                                            <!-- Descuento % y monto -->
                                            <div class="row mb-2 align-items-center">
                                                <div class="col-4">
                                                    <label class="form-label mb-0">Descuento %:</label>
                                                </div>
                                                <div class="col-8">
                                                    <input type="text" class="form-control text-end" readonly value="@descuentoPorcentaje.ToString("F2")" />
                                                </div>
                                            </div>

                                            <div class="row mb-2 align-items-center">
                                                <div class="col-4">
                                                    <label class="form-label mb-0">Descuento:</label>
                                                </div>
                                                <div class="col-8">
                                                    <input type="text" class="form-control text-end" readonly value="@descuentoMonto.ToString("F4")" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <!-- Información de la orden -->
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0">INFORMACIÓN</h6>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-sm mb-0">
                                                <tr>
                                                    <td><strong>Estado:</strong></td>
                                                    <td>
                                                        @if (ordenCompra.StatOcom >= 9)
                                                        {
                                                            <span class="badge bg-danger">Anulada</span>
                                                        }
                                                        else if (ordenCompra.StatOcom == 0)
                                                        {
                                                            <span class="badge bg-success">Activa</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning">Pendiente</span>
                                                        }
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Moneda:</strong></td>
                                                    <td>
                                                        @if (monedas != null && ordenCompra.MoneEmis.HasValue)
                                                        {
                                                            var moneda = monedas.FirstOrDefault(m => m.CodigoMoneda == ordenCompra.MoneEmis);
                                                            <span>@(moneda?.Descripcion ?? "Desconocida")</span>
                                                        }
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Tipo Cambio:</strong></td>
                                                    <td>@ordenCompra.TcamOcom?.ToString("F4")</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <!-- Resumen de Totales -->
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0">RESUMEN</h6>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-sm mb-0">
                                                <tr>
                                                    <td><strong>Total Items:</strong></td>
                                                    <td class="text-end"><strong>@detalleItems.Count</strong></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Total Neto:</strong></td>
                                                    <td class="text-end"><strong>@TotalNeto.ToString("C2")</strong></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Descuento:</strong></td>
                                                    <td class="text-end text-danger"><strong>-@descuentoMonto.ToString("C2")</strong></td>
                                                </tr>
                                                <tr class="table-success">
                                                    <td><strong>Total con Descuento:</strong></td>
                                                    <td class="text-end"><strong>@TotalConDescuento.ToString("C2")</strong></td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <label class="form-label mb-0" @ondblclick="(() => AbrirModalIva())" 
                                                        style="cursor: pointer; color: #0066cc; text-decoration: underline;" 
                                                        title="Doble clic para abrir distribución de IVA">
                                                            <i class="fas fa-calculator me-1"></i>IVA:
                                                            <small class="text-muted d-block" style="font-size: 0.7em;">
                                                                <i class="fas fa-mouse-pointer"></i> Doble clic aquí
                                                            </small>
                                                        </label>
                                                    </td>
                                                    <td class="text-end"><strong>@TotalIva.ToString("C2")</strong></td>
                                                </tr>
                                                <tr class="table-info">
                                                    <td><strong>Total Final:</strong></td>
                                                    <td class="text-end"><strong>@TotalConIva.ToString("C2")</strong></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Componentes modales -->
<!-- NOTA: Selector de proveedores deshabilitado en edición -->
<!-- <SelectorProveedores @ref="selectorProveedores" OnProveedorSeleccionado="OnProveedorSeleccionado" /> -->
<SelectorProductos @ref="selectorProductos" 
PermitirCantidad="true" 
PermitirPrecio="true" 
CantidadDefault="1" 
PrecioDefault="0" 
OnProductoSeleccionadoCantidad="OnProductoSeleccionado"
OnClose="TerminarCicloSeleccionProductos" />

@if (mostrarModalRemisionConsignaciones)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        Remitir componentes de consignación - @numeroOrdenFormateadoRemisionModal
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalRemision"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Depósito de salida:</label>
                            <select class="form-select" value="@depositoRemisionModalSeleccionado" @onchange="OnDepositoRemisionModalChanged">
                                <option value="0">Seleccionar depósito...</option>
                                @if (depositosRemision != null)
                                {
                                    @foreach (var deposito in depositosRemision)
                                    {
                                        <option value="@deposito.CodigoDepo">@deposito.CodigoDepo - @deposito.Descripcion</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    @if (cargandoPendientesRemision)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border" role="status"></div>
                            <div class="mt-2">Actualizando pendientes por depósito...</div>
                        </div>
                    }
                    else if (!pendientesRemisionModal.Any())
                    {
                        <div class="alert alert-info mb-0">
                            No hay componentes pendientes para remitir en el depósito seleccionado.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-bordered align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Cod. Inte</th>
                                        <th>Cod. Exte</th>
                                        <th>Descripción</th>
                                        <th>Unidad</th>
                                        <th class="text-end">Cant. Asig</th>
                                        <th class="text-end">Cant. Entreg</th>
                                        <th class="text-end">Falta Entregar</th>
                                        <th class="text-end">Stock</th>
                                        <th class="text-end">Remitir</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in pendientesRemisionModal)
                                    {
                                        <tr>
                                            <td>@item.CodInte</td>
                                            <td>@item.CodExte</td>
                                            <td>@item.Descripcion</td>
                                            <td>@item.Unidad</td>
                                            <td class="text-end">@item.CantAsig.ToString("N4")</td>
                                            <td class="text-end">@item.CantEntreg.ToString("N4")</td>
                                            <td class="text-end">@item.FaltaEntregar.ToString("N4")</td>
                                            <td class="text-end">@item.StockDeposito.ToString("N4")</td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm text-end input-number-sin-flechas" step="0.0001"
                                                       min="0" max="@item.MaxRemitir" @bind="item.CantidadEntregar" @bind:event="oninput"
                                                       @onblur="(() => NormalizarCantidadRemitir(item))" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalRemision">Cerrar</button>
                    <button type="button" class="btn btn-success" @onclick="ConfirmarRemisionDesdeModalAsync" disabled="@remitiendoConsignaciones">
                        @if (remitiendoConsignaciones)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Confirmar Remito
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de edición de item -->
@if (mostrarModalEdicionItem && itemEnEdicion != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h4 class="modal-title">
                        <i class="fas fa-edit me-2"></i>Editar Item - @itemEnEdicion.CodExte
                    </h4>
                    <button type="button" class="btn-close" @onclick="CerrarModalEdicionItem"></button>
                </div>
                <div class="modal-body">
                    <!-- Leyenda informativa -->
                    <div class="alert alert-info border-0 shadow-sm mb-3">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-info-circle fa-lg text-info me-3 mt-1"></i>
                            <div>
                                <h6 class="alert-heading mb-2">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Importante sobre la eliminación de items
                                </h6>
                                <p class="mb-1">
                                    <strong>No es posible eliminar items de la orden de compra.</strong> 
                                    Para que un item no quede como pendiente, puede cambiar la cantidad a <strong>0 (cero)</strong>.
                                </p>
                                <small class="text-muted">
                                    <i class="fas fa-lightbulb me-1"></i>
                                    Esto mantiene el registro completo del item en el historial de la orden.
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Información no editable -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">INFORMACIÓN DEL PRODUCTO</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <label class="form-label mb-1"><strong>Código:</strong></label>
                                        <div class="form-control-plaintext">@itemEnEdicion.CodExte</div>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label mb-1"><strong>Descripción:</strong></label>
                                        <div class="form-control-plaintext">@itemEnEdicion.Descritem</div>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label mb-1"><strong>Unidad de Medida:</strong></label>
                                        <div class="form-control-plaintext">@itemEnEdicion.UniMas</div>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label mb-1"><strong>Item N°:</strong></label>
                                        <div class="form-control-plaintext">@itemEnEdicion.NuOrdItem</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Campos editables -->
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header bg-success text-white">
                                    <h6 class="mb-0">CAMPOS EDITABLES</h6>
                                </div>
                                <div class="card-body">
                                    <!-- Cantidad -->
                                    <div class="mb-3">
                                        <label class="form-label">Cantidad <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control input-number-sin-flechas" step="0.01" min="0" 
                                        @bind="itemEnEdicion.CantOcom" />
                                        <small class="text-muted">Cantidad a solicitar (puede ser 0 para anular)</small>
                                    </div>

                                    <!-- Precio Unitario -->
                                    <div class="mb-3">
                                        <label class="form-label">Precio Unitario <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control input-number-sin-flechas" step="0.0001" min="0" 
                                        @bind="itemEnEdicion.PreUnit" />
                                        <small class="text-muted">Precio por unidad</small>
                                    </div>

                                    <!-- Fecha de Entrega -->
                                    <div class="mb-3">
                                        <label class="form-label">Fecha de Entrega</label>
                                        <input type="date" class="form-control" 
                                        @bind="itemEnEdicion.FentreSol" />
                                    </div>

                                    <!-- Sector -->
                                    <div class="mb-3">
                                        <label class="form-label">Sector</label>
                                        <input type="text" class="form-control" 
                                        @bind="itemEnEdicion.SectOcom" 
                                        placeholder="Código del sector" />
                                    </div>

                                    <!-- Destino -->
                                    <div class="mb-3">
                                        <label class="form-label">Destino</label>
                                        <select class="form-select" @bind="itemEnEdicion.IContab">
                                            <option value="">-- Seleccionar Destino --</option>
                                            @if (destinosDisponibles != null)
                                            {
                                                @foreach (var destino in destinosDisponibles)
                                                {
                                                    <option value="@destino.CodInCue">@destino.CodExCue - @destino.Denocue</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen del item -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="alert alert-info">
                                <h6><i class="fas fa-calculator me-2"></i>Resumen del Item</h6>
                                <div class="row">
                                    <div class="col-md-4">
                                        <strong>Cantidad:</strong> @(itemEnEdicion.CantOcom?.ToString("F2") ?? "0.00")
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Precio Unit.:</strong> @(itemEnEdicion.PreUnit?.ToString("C4") ?? "$0.0000")
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Total:</strong> @((itemEnEdicion.CantOcom * itemEnEdicion.PreUnit)?.ToString("C2") ?? "$0.00")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEdicionItem">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </button>
                    <button type="button" class="btn btn-success" @onclick="GuardarEdicionItem">
                        <i class="fas fa-save me-1"></i>Guardar Cambios
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de distribución de IVA -->
@if (mostrarModalIva)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h4 class="modal-title">
                        <i class="fas fa-calculator me-2"></i>Distribución de IVA - Edición
                    </h4>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalIva"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Panel de ayuda e instrucciones -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="alert alert-info border-0 shadow-sm">
                                <div class="d-flex align-items-start">
                                    <i class="fas fa-info-circle fa-2x text-info me-3 mt-1"></i>
                                    <div>
                                        <h5 class="alert-heading mb-2">
                                            <i class="fas fa-question-circle me-1"></i>¿Cómo usar esta distribución?
                                        </h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <ul class="mb-0">
                                                    <li><strong><i class="fas fa-mouse-pointer text-primary"></i> Doble clic:</strong> En cualquier campo para asignar todo el total</li>
                                                    <li><strong><i class="fas fa-edit text-warning"></i> Edición manual:</strong> Modifique los campos amarillos</li>
                                                </ul>
                                            </div>
                                            <div class="col-md-6">
                                                <ul class="mb-0">
                                                    <li><strong><i class="fas fa-calculator text-success"></i> Automático:</strong> El campo gris se calcula solo</li>
                                                    <li><strong><i class="fas fa-exclamation-triangle text-danger"></i> Validación:</strong> Alertas si hay inconsistencias</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total a distribuir - Destacado -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card border-primary shadow-sm">
                                <div class="card-header bg-primary text-white text-center">
                                    <h5 class="mb-0">
                                        <i class="fas fa-coins me-2"></i>Total a Distribuir
                                    </h5>
                                </div>
                                <div class="card-body text-center bg-light">
                                    <h2 class="text-primary mb-1">@TotalConDescuento.ToString("C2")</h2>
                                    <small class="text-muted">Subtotal con descuentos aplicados</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Grid de distribución -->
                    <div class="row g-3">
                        <!-- Exento/N/Grav (0%) -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-secondary shadow-sm">
                                <div class="card-header bg-secondary text-white text-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-ban me-1"></i>Exento/N/Grav
                                    </h6>
                                    <small>0% IVA</small>
                                </div>
                                <div class="card-body">
                                    <label class="form-label small">
                                        <i class="fas fa-info-circle text-info me-1"></i>Base Imponible:
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control form-control-lg text-end bg-light" readonly 
                                        @bind="baseImponible0" @ondblclick="(() => PonerTodoEnCampo(0))"
                                        title="Doble clic para poner todo el total aquí" 
                                        style="cursor: pointer; font-weight: bold;" />
                                    </div>
                                    <div class="mt-2 text-center">
                                        <small class="text-muted">
                                            <i class="fas fa-calculator me-1"></i>IVA: <strong>$0.00</strong>
                                        </small>
                                        <br />
                                        <small class="text-info">
                                            <i class="fas fa-mouse-pointer me-1"></i>Doble clic para usar
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 10.5% -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-warning shadow-sm">
                                <div class="card-header bg-warning text-dark text-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-percentage me-1"></i>Gravado 10.5%
                                    </h6>
                                    <small>IVA Reducido</small>
                                </div>
                                <div class="card-body">
                                    <label class="form-label small">
                                        <i class="fas fa-edit text-warning me-1"></i>Base Imponible:
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control form-control-lg text-end input-number-sin-flechas" step="0.01" 
                                        @bind="baseImponible105" @bind:after="RecalcularDistribucionIva" 
                                        @ondblclick="(() => PonerTodoEnCampo(1))" 
                                        title="Editable - Doble clic para poner todo el total aquí" 
                                        placeholder="0.00" style="font-weight: bold;" />
                                    </div>
                                    <div class="mt-2 text-center">
                                        <small class="text-success">
                                            <i class="fas fa-calculator me-1"></i>IVA: <strong>@importeIva105.ToString("C2")</strong>
                                        </small>
                                        <br />
                                        <small class="text-warning">
                                            <i class="fas fa-mouse-pointer me-1"></i>Doble clic para usar
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 21% -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-danger shadow-sm">
                                <div class="card-header bg-danger text-white text-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-percentage me-1"></i>Gravado 21%
                                    </h6>
                                    <small>IVA General</small>
                                </div>
                                <div class="card-body">
                                    <label class="form-label small">
                                        <i class="fas fa-edit text-warning me-1"></i>Base Imponible:
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control form-control-lg text-end input-number-sin-flechas" step="0.01" 
                                        @bind="baseImponible21" @bind:after="RecalcularDistribucionIva" 
                                        @ondblclick="(() => PonerTodoEnCampo(2))" 
                                        title="Editable - Doble clic para poner todo el total aquí" 
                                        placeholder="0.00" style="font-weight: bold;" />
                                    </div>
                                    <div class="mt-2 text-center">
                                        <small class="text-success">
                                            <i class="fas fa-calculator me-1"></i>IVA: <strong>@importeIva21.ToString("C2")</strong>
                                        </small>
                                        <br />
                                        <small class="text-danger">
                                            <i class="fas fa-mouse-pointer me-1"></i>Doble clic para usar
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 27% -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-dark shadow-sm">
                                <div class="card-header bg-dark text-white text-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-percentage me-1"></i>Gravado 27%
                                    </h6>
                                    <small>IVA Especial</small>
                                </div>
                                <div class="card-body">
                                    <label class="form-label small">
                                        <i class="fas fa-edit text-warning me-1"></i>Base Imponible:
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control form-control-lg text-end input-number-sin-flechas" step="0.01" 
                                        @bind="baseImponible27" @bind:after="RecalcularDistribucionIva" 
                                        @ondblclick="(() => PonerTodoEnCampo(3))" 
                                        title="Editable - Doble clic para poner todo el total aquí" 
                                        placeholder="0.00" style="font-weight: bold;" />
                                    </div>
                                    <div class="mt-2 text-center">
                                        <small class="text-success">
                                            <i class="fas fa-calculator me-1"></i>IVA: <strong>@importeIva27.ToString("C2")</strong>
                                        </small>
                                        <br />
                                        <small class="text-dark">
                                            <i class="fas fa-mouse-pointer me-1"></i>Doble clic para usar
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen y validaciones -->
                    <div class="row mt-4">
                        <div class="col-md-6">
                            @{
                                var diferencia = TotalConDescuento - TotalBaseImponible;
                                var totalGravado = baseImponible105 + baseImponible21 + baseImponible27;
                                var alertClass = totalGravado > TotalConDescuento ? "danger" : 
                                               (TotalBaseImponible == TotalConDescuento ? "success" : "warning");
                                var iconClass = totalGravado > TotalConDescuento ? "exclamation-triangle" : 
                                              (TotalBaseImponible == TotalConDescuento ? "check-circle" : "info-circle");
                            }
                            <div class="alert alert-@alertClass border-0 shadow-sm">
                                <h6 class="alert-heading">
                                    <i class="fas fa-@iconClass me-2"></i>Estado de la Distribución
                                </h6>
                                @if (totalGravado > TotalConDescuento)
                                {
                                    <p class="mb-2"><strong>¡ADVERTENCIA!</strong> Los campos editables suman más que el total disponible</p>
                                    <div class="row small">
                                        <div class="col-6"><strong>Suma editables:</strong></div>
                                        <div class="col-6 text-end">@totalGravado.ToString("C2")</div>
                                        <div class="col-6"><strong>Disponible:</strong></div>
                                        <div class="col-6 text-end">@TotalConDescuento.ToString("C2")</div>
                                        <div class="col-6"><strong>Exceso:</strong></div>
                                        <div class="col-6 text-end text-danger"><strong>@((totalGravado - TotalConDescuento).ToString("C2"))</strong></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row small">
                                        <div class="col-6"><strong>Total Base:</strong></div>
                                        <div class="col-6 text-end">@TotalBaseImponible.ToString("C2")</div>
                                        <div class="col-6"><strong>Diferencia:</strong></div>
                                        <div class="col-6 text-end">@diferencia.ToString("C2")</div>
                                    </div>
                                    @if (diferencia != 0)
                                    {
                                        <small class="text-muted d-block mt-1">
                                            <i class="fas fa-info-circle me-1"></i>La diferencia se asigna automáticamente a Exento/N/Grav
                                        </small>
                                    }
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-info border-0 shadow-sm">
                                <h6 class="alert-heading">
                                    <i class="fas fa-calculator me-2"></i>Resumen Final
                                </h6>
                                <div class="row">
                                    <div class="col-6"><strong>Total IVA:</strong></div>
                                    <div class="col-6 text-end"><strong>@TotalIva.ToString("C2")</strong></div>
                                    <div class="col-6"><strong>Total Final:</strong></div>
                                    <div class="col-6 text-end"><h5 class="text-primary mb-0">@TotalConIva.ToString("C2")</h5></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de acción rápida -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="(() => PonerTodoEnCampo(0))">
                                    <i class="fas fa-ban me-1"></i>Todo Exento
                                </button>
                                <button type="button" class="btn btn-outline-warning btn-sm" @onclick="(() => PonerTodoEnCampo(1))">
                                    <i class="fas fa-percentage me-1"></i>Todo 10.5%
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="(() => PonerTodoEnCampo(2))">
                                    <i class="fas fa-percentage me-1"></i>Todo 21%
                                </button>
                                <button type="button" class="btn btn-outline-dark btn-sm" @onclick="(() => PonerTodoEnCampo(3))">
                                    <i class="fas fa-percentage me-1"></i>Todo 27%
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LimpiarDistribucion">
                                    <i class="fas fa-eraser me-1"></i>Limpiar Todo
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalIva">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </button>
                    @{
                        var totalGravadoFooter = baseImponible105 + baseImponible21 + baseImponible27;
                        var hayExceso = totalGravadoFooter > TotalConDescuento;
                    }
                    @if (hayExceso)
                    {
                        <button type="button" class="btn btn-warning" @onclick="AceptarDistribucionIva">
                            <i class="fas fa-exclamation-triangle me-1"></i>Aceptar con Advertencia
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="AceptarDistribucionIva">
                            <i class="fas fa-check me-1"></i>Aceptar Distribución
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public int OrdenId { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // Estado del formulario
    private bool guardando = false;
    private Ocomenca ordenCompra = new();
    private string proveedorSeleccionado = string.Empty;
    private string sectorOrdenCompra = string.Empty; // Sector guardado en el alta de la O.C.
    private string destinoOrdenCompra = string.Empty; // Destino guardado en el alta de la O.C.
    private List<Ocomdeta>? detalleItems;
    private List<OcomdetaEditDTO>? detalleItemsEnriquecido; // Detalle enriquecido según lógica VB6
    private List<Tamoned>? monedas;
    private List<CondPag>? condicionesPago;
    private List<Plancuen>? cuentasDestino;
    private List<Tadeposi>? depositosRemision;
    private SelectorProveedores.ProveedorSeleccionado proveedorInfo = new();
    private int? tipoIvaProveedor; // PROVED12.Piva_Cli - Tipo de IVA del proveedor
    private bool mostrarModalRemisionConsignaciones = false;
    private bool cargandoPendientesRemision = false;
    private bool remitiendoConsignaciones = false;
    private int depositoRemisionModalSeleccionado = 0;
    private int numeroProveedorRemisionModal = 0;
    private string razonSocialProveedorRemisionModal = string.Empty;
    private string numeroOrdenFormateadoRemisionModal = string.Empty;
    private string numeroOrdenFiltroConsignacionRemisionModal = string.Empty;
    private readonly List<ConsignacionPendienteRemisionDto> pendientesRemisionModal = new();
    private const string NombrePlantillaRemitoConsignacion = "REMITO CONSIGNACION";
    private int? plantillaRemitoConsignacionId;

    // ===== Sistema de Descuentos =====
    private decimal descuentoMonto = 0m;
    private decimal descuentoPorcentaje = 0m;

    // ===== Sistema de IVA =====
    // Variables para el modal de distribución de IVA
    private bool mostrarModalIva = false;
    private decimal baseImponible0 = 0m;    // ITOGRA(0) - Exento/N/Grav (calculado automáticamente)
    private decimal baseImponible105 = 0m;  // IMPOGRA(1) - 10.5% (editable)
    private decimal baseImponible21 = 0m;   // IMPOGRA(2) - 21% (editable)
    private decimal baseImponible27 = 0m;   // IMPOGRA(3) - 27% (editable)
    private decimal importeIva0 = 0m;       // IMPOIVA(0) - IVA 0%
    private decimal importeIva105 = 0m;     // IMPOIVA(1) - IVA 10.5%
    private decimal importeIva21 = 0m;      // IMPOIVA(2) - IVA 21%
    private decimal importeIva27 = 0m;      // IMPOIVA(3) - IVA 27%

    // Propiedades calculadas para totales
    private decimal TotalNeto => detalleItems?.Sum(item => (item.CantOcom ?? 0) * (item.PreUnit ?? 0)) ?? 0m;
    private decimal TotalConDescuento => totalNetoSinDescuento; // En edición usamos el total ya calculado

    // Propiedades calculadas para el sistema de IVA
    private decimal TotalBaseImponible => baseImponible0 + baseImponible105 + baseImponible21 + baseImponible27;
    private decimal TotalIva => importeIva0 + importeIva105 + importeIva21 + importeIva27;
    private decimal TotalConIva => TotalConDescuento + TotalIva;

    /// <summary>
    /// Obtiene el porcentaje de IVA aplicado o "VAR" si hay distribución mixta
    /// </summary>
    private string PorcentajeIvaTexto
    {
        get
        {
            // Si no hay distribución de IVA, mostrar 0%
            if (TotalBaseImponible == 0) return "0%";

            // Contar cuántos campos tienen valor mayor a 0
            int camposConValor = 0;
            string porcentajeUnico = "";

            if (baseImponible0 > 0)
            {
                camposConValor++;
                porcentajeUnico = "0%";
            }

            if (baseImponible105 > 0)
            {
                camposConValor++;
                porcentajeUnico = "10.5%";
            }

            if (baseImponible21 > 0)
            {
                camposConValor++;
                porcentajeUnico = "21%";
            }

            if (baseImponible27 > 0)
            {
                camposConValor++;
                porcentajeUnico = "27%";
            }

            // Si solo hay un campo con valor, mostrar ese porcentaje
            if (camposConValor == 1)
            {
                return porcentajeUnico;
            }

            // Si hay múltiples campos con valor, mostrar "VAR"
            if (camposConValor > 1)
            {
                return "VAR";
            }

            // Por defecto, 0%
            return "0%";
        }
    }

