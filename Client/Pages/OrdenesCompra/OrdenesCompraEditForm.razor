    // Variable para manejar el contacto de atención (lógica VB6: AtSr_Ocom o Ctac_Cli)
    private string ContactoAtencion
    {
        get
        {
            // ATEN$ = !AtSr_Ocom: If TRIM$(ATEN$) = "" Then ATEN$ = !Ctac_Cli
            var atencion = ordenCompra.AtSrOcom?.Trim() ?? "";
            if (string.IsNullOrEmpty(atencion))
            {
