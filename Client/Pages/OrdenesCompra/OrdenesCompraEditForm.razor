    /// <summary>
    /// Carga el descuento existente de la orden
    /// </summary>
    private void CargarDescuentoExistente()
    {
        try
        {
            // Cargar el descuento desde los campos de la orden
            descuentoMonto = ordenCompra.IdesOcom ?? 0m;
            
            // Si hay texto de descuento, recalcular para obtener el porcentaje
            if (!string.IsNullOrEmpty(ordenCompra.PdesOcom))
            {
                RecalcularDescuentoDesdeTexto();
            }
            else if (descuentoMonto > 0 && TotalNeto > 0)
            {
                // Si no hay texto pero sí monto, calcular el porcentaje
                descuentoPorcentaje = Math.Round((descuentoMonto / TotalNeto) * 100m, 4);
            }
            else
            {
                descuentoPorcentaje = 0m;
            }
            
            Console.WriteLine($"[CargarDescuentoExistente] Descuento cargado - Texto: '{ordenCompra.PdesOcom}', Monto: {descuentoMonto:C2}, Porcentaje: {descuentoPorcentaje:F2}%");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CargarDescuentoExistente] Error: {ex.Message}");
            descuentoMonto = 0m;
            descuentoPorcentaje = 0m;
        }
    }

    /// <summary>
    /// Recalcula descuento basado en el texto ingresado.
    /// Soporta números simples (ej: "10") o descuentos sucesivos (ej: "10 + 5").
    /// - Si es número (entero/decimal): se toma literal como %.
    /// - Si tiene forma "a + b + c": aplica descuentos sucesivos: base*(1-a%)*(1-b%)*(1-c%).
    /// </summary>
    private void RecalcularDescuentoDesdeTexto()
    {
        try
        {
            var texto = ordenCompra.PdesOcom?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(texto))
            {
                descuentoPorcentaje = 0m;
                descuentoMonto = 0m;
                ActualizarTotalOrden();
                StateHasChanged();
                return;
            }

            decimal baseNeto = TotalNeto;
            if (baseNeto <= 0m)
            {
                descuentoPorcentaje = 0m;
                descuentoMonto = 0m;
                ActualizarTotalOrden();
                StateHasChanged();
                return;
            }

            // Caso 1: Número simple (ej: "10" o "15.5")
            if (decimal.TryParse(texto.Replace(",", "."), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out decimal porcSimple))
            {
                if (porcSimple < 0) porcSimple = 0;
                if (porcSimple > 100) porcSimple = 100;
                descuentoPorcentaje = Math.Round(porcSimple, 4);
                descuentoMonto = Math.Round(baseNeto * (descuentoPorcentaje / 100m), 4);
                ActualizarTotalOrden();
                StateHasChanged();
                return;
            }

            // Caso 2: Descuentos sucesivos (ej: "10 + 5" o "10+20+5")
            if (texto.Contains("+"))
            {
                var partes = texto.Split('+');
                decimal acumulado = baseNeto;
                bool algunaParteValida = false;

                foreach (var parte in partes)
                {
                    var parteTexto = parte.Trim().Replace(",", ".");
                    if (decimal.TryParse(parteTexto, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out decimal porcentajeParte))
                    {
                        if (porcentajeParte >= 0 && porcentajeParte <= 100)
                        {
                            acumulado = acumulado * (1 - (porcentajeParte / 100m));
                            algunaParteValida = true;
                        }
                    }
                }

                if (algunaParteValida)
                {
                    descuentoMonto = Math.Max(0m, baseNeto - acumulado);
                    descuentoPorcentaje = baseNeto == 0m ? 0m : Math.Round((descuentoMonto / baseNeto) * 100m, 4);
                    ActualizarTotalOrden();
                    StateHasChanged();
                    return;
                }
            }

            // Si no se pudo interpretar: descuento 0
            descuentoPorcentaje = 0m;
            descuentoMonto = 0m;
            ActualizarTotalOrden();
            StateHasChanged();
        }
        catch
        {
            // En cualquier error, evitar lanzar excepciones a la UI y dejar descuento en 0
            descuentoPorcentaje = 0m;
            descuentoMonto = 0m;
            ActualizarTotalOrden();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Actualiza los totales de la orden con el descuento aplicado
    /// </summary>
    private void ActualizarTotalOrden()
    {
        // Actualizar el campo IdesOcom con el monto del descuento
        ordenCompra.IdesOcom = descuentoMonto;
        
        // Recalcular el total neto sin descuento para el sistema de IVA
        totalNetoSinDescuento = Math.Max(0m, TotalNeto - descuentoMonto);
    }

    /// <summary>
    /// PASO 6: Procesa las consignaciones MACONSIG según la lógica VB6
    /// Recorre el detalle de la orden y verifica si los códigos poseen estructura
    /// Genera consignaciones por el remanente considerando cantidades ya asignadas
    /// </summary>
    private async Task ProcesarMaconsig(int numeroOrden)
    {
        try
        {
            Console.WriteLine($"[ProcesarMaconsig] 🔄 Iniciando procesamiento de consignaciones para O.C. {numeroOrden}");

            if (detalleItems == null || !detalleItems.Any())
            {
                Console.WriteLine($"[ProcesarMaconsig] ⚠️ No hay items para procesar consignaciones");
                return;
            }

            // Preparar datos para el procesamiento de consignaciones según VB6
            var requestData = new
            {
                NumeroOrden = numeroOrden,
                NumeroProveedor = ordenCompra.NproOcom ?? 0,
                RazonSocialProveedor = ordenCompra.RaSoProv ?? string.Empty,
                FechaEmision = ordenCompra.FemiOcom ?? DateTime.Now,
                MonedaEmision = (short)(ordenCompra.MoneEmis ?? 1)
            };

            Console.WriteLine($"[ProcesarMaconsig] 📊 Datos para procesamiento:");
            Console.WriteLine($"  - Número Orden: {requestData.NumeroOrden}");
            Console.WriteLine($"  - Proveedor: {requestData.NumeroProveedor} - {requestData.RazonSocialProveedor}");
            Console.WriteLine($"  - Fecha Emisión: {requestData.FechaEmision:yyyy-MM-dd}");
            Console.WriteLine($"  - Moneda Emisión: {requestData.MonedaEmision}");
            Console.WriteLine($"  - Items en detalle: {detalleItems.Count}");

            // Llamar al endpoint que procesa las consignaciones con lógica VB6:
            // 1. Recorre items activos de OCOMDETA (StatOcom = 0)
            // 2. Verifica estructura en tabla Formulas (LEEEXPLO)
            // 3. Para cada componente hijo (CIJ%(i%)):
            //    - Calcula CANTIASIGN# = CAUNIS * USOI(i%) (cantidad deseada)
            //    - Verifica cantidad ya asignada: CANYASIG# = SUM(CANT_ASIG)
            //    - Genera consignación por el remanente: CANTIASIGN# - CANYASIG#
            //    - Solo si remanente > 0.05 y CODEXT$(CII%) <> ""
            var response = await repository.Post("/api/maconsig/procesar-orden", requestData);

            if (response.Error)
            {
                var errorMessage = await response.GetErrorMessageAsync();
                Console.WriteLine($"[ProcesarMaconsig] ❌ Error del servidor: {errorMessage}");

                // Si el error indica que no hay items con estructura, no es crítico
                if (errorMessage.Contains("no se encontraron items con estructura") ||
                    errorMessage.Contains("No se encontraron items activos") ||
                    errorMessage.Contains("no tiene estructura") ||
                    errorMessage.Contains("no hay items"))
                {
                    Console.WriteLine($"[ProcesarMaconsig] ℹ️ No hay items con estructura - continuando");
                    return;
                }

                // Si es otro tipo de error, sí lanzar excepción
                throw new Exception($"Error al procesar consignaciones MACONSIG: {errorMessage}");
            }

            // Obtener resultado del procesamiento
            Console.WriteLine($"[ProcesarMaconsig] ✅ Consignaciones procesadas exitosamente");
            Console.WriteLine($"[ProcesarMaconsig] 📊 Respuesta del servidor: OK");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ProcesarMaconsig] ❌ Excepción: {ex.Message}");

            // Si la excepción indica que no hay estructura, no re-lanzar
            if (ex.Message.Contains("no se encontraron items con estructura") ||
                ex.Message.Contains("No se encontraron items activos") ||
                ex.Message.Contains("no tiene estructura") ||
                ex.Message.Contains("no hay items"))
            {
                Console.WriteLine($"[ProcesarMaconsig] ℹ️ Excepción manejada: no hay items con estructura");
                return;
            }

            throw; // Re-lanzar para manejo en método padre solo si es un error real
        }
    }

    private async Task AbrirModalRemisionConsignacionesAsync()
    {
        if (ordenCompra.StatOcom != 0)
        {
            await sweetAlertService.FireAsync("Atención", "Solo se puede remitir desde una O.C. activa.", SweetAlertIcon.Warning);
            return;
        }

        if (!ordenCompra.NproOcom.HasValue || ordenCompra.NproOcom <= 0 || !ordenCompra.NumeOcom.HasValue || ordenCompra.NumeOcom <= 0)
        {
            await sweetAlertService.FireAsync("Atención", "La orden no tiene datos válidos de proveedor o número de O.C.", SweetAlertIcon.Warning);
            return;
        }

        numeroProveedorRemisionModal = ordenCompra.NproOcom.Value;
        razonSocialProveedorRemisionModal = ordenCompra.RaSoProv ?? string.Empty;
        numeroOrdenFormateadoRemisionModal = $"OC.{ordenCompra.NumeOcom.Value:000000}";
        numeroOrdenFiltroConsignacionRemisionModal = $"OC-{ordenCompra.NumeOcom.Value:000000}-";

        if (depositoRemisionModalSeleccionado <= 0 && depositosRemision != null && depositosRemision.Any())
        {
            depositoRemisionModalSeleccionado = depositosRemision.First().CodigoDepo;
        }

        await CargarPendientesRemisionModalAsync();

        if (!pendientesRemisionModal.Any())
        {
            await sweetAlertService.FireAsync("Sin pendientes", "No se encontraron componentes pendientes para remitir con el depósito seleccionado.", SweetAlertIcon.Info);
            return;
        }

        mostrarModalRemisionConsignaciones = true;
        StateHasChanged();
    }

    private async Task CargarPendientesRemisionModalAsync()
    {
        if (depositoRemisionModalSeleccionado <= 0 || numeroProveedorRemisionModal <= 0)
        {
            pendientesRemisionModal.Clear();
            return;
        }

        cargandoPendientesRemision = true;
        StateHasChanged();

        try
        {
            var pendientesRequest = new PendientesRemisionRequestDto
            {
                NumeroProveedor = numeroProveedorRemisionModal,
                NumeroOrdenCompra = numeroOrdenFiltroConsignacionRemisionModal,
                Deposito = depositoRemisionModalSeleccionado
            };

            var pendientesResponse = await repository.Post<PendientesRemisionRequestDto, List<ConsignacionPendienteRemisionDto>>("api/maconsig/pendientes-remitir", pendientesRequest);
            if (pendientesResponse.Error || pendientesResponse.Response == null)
            {
                pendientesRemisionModal.Clear();
                return;
            }

            pendientesRemisionModal.Clear();
            foreach (var item in pendientesResponse.Response)
            {
                item.MaxRemitir = Math.Round(Math.Max(0m, Math.Min(item.StockDeposito, item.FaltaEntregar)), 4);
                item.CantidadEntregar = item.MaxRemitir;
                pendientesRemisionModal.Add(item);
            }
        }
        finally
        {
            cargandoPendientesRemision = false;
            StateHasChanged();
        }
    }

    private async Task OnDepositoRemisionModalChanged(ChangeEventArgs e)
    {
        if (e.Value != null && int.TryParse(e.Value.ToString(), out int deposito) && deposito > 0)
        {
            depositoRemisionModalSeleccionado = deposito;
            await CargarPendientesRemisionModalAsync();
        }
        else
        {
            depositoRemisionModalSeleccionado = 0;
            pendientesRemisionModal.Clear();
            StateHasChanged();
        }
    }

    private void NormalizarCantidadRemitir(ConsignacionPendienteRemisionDto item)
    {
        if (item.CantidadEntregar < 0)
        {
            item.CantidadEntregar = 0;
        }

        if (item.CantidadEntregar > item.MaxRemitir)
        {
            item.CantidadEntregar = item.MaxRemitir;
        }
    }

    private async Task ConfirmarRemisionDesdeModalAsync()
    {
        if (depositoRemisionModalSeleccionado <= 0)
        {
            await sweetAlertService.FireAsync("Atención", "Debe seleccionar un depósito de salida.", SweetAlertIcon.Warning);
            return;
        }

        foreach (var item in pendientesRemisionModal)
        {
            NormalizarCantidadRemitir(item);
        }

        var itemsARemitir = pendientesRemisionModal
            .Where(x => x.CantidadEntregar > 0.005m)
            .ToList();

        if (!itemsARemitir.Any())
        {
            await sweetAlertService.FireAsync("Atención", "No hay cantidades a remitir.", SweetAlertIcon.Warning);
            return;
        }

        remitiendoConsignaciones = true;
        StateHasChanged();

        try
        {
            var proximoComprobanteResponse = await repository.Get<int>("api/maconsig/proximo-comprobante-rc");
            if (proximoComprobanteResponse.Error || proximoComprobanteResponse.Response <= 0)
            {
                await sweetAlertService.FireAsync("Atención", "No se pudo obtener el próximo comprobante RC.", SweetAlertIcon.Warning);
                return;
            }

            var remitirRequest = new RemitirConsignacionesRequestDto
            {
                NumeroProveedor = numeroProveedorRemisionModal,
                RazonSocialProveedor = razonSocialProveedorRemisionModal,
                NumeroOrdenCompra = numeroOrdenFiltroConsignacionRemisionModal,
                Deposito = depositoRemisionModalSeleccionado,
                FechaRemito = DateTime.Now,
                CodigoMovimiento = "RC",
                NumeroComprobante = proximoComprobanteResponse.Response,
                Items = itemsARemitir.Select(item => new RemitirConsignacionItemRequestDto
                {
                    IdMaconsig = item.IdMaconsig,
                    CodInte = item.CodInte,
                    CodExte = item.CodExte,
                    Descripcion = item.Descripcion,
                    Unidad = item.Unidad,
                    NroOcom = item.OCompra,
                    NuOrdItem = null,
                    Lote = item.Lote,
                    CantidadEntregar = item.CantidadEntregar
                }).ToList()
            };

            var remitirResponse = await repository.Post<RemitirConsignacionesRequestDto, RemitirConsignacionesResponseDto>("api/maconsig/remitir", remitirRequest);
            if (remitirResponse.Error || remitirResponse.Response == null || !remitirResponse.Response.Success)
            {
                var mensajeError = remitirResponse.Error ? await remitirResponse.GetErrorMessageAsync() : "Respuesta inválida del servicio de remisión.";
                await sweetAlertService.FireAsync("Atención", $"Falló la remisión de consignaciones: {mensajeError}", SweetAlertIcon.Warning);
                return;
            }

            await sweetAlertService.FireAsync("Remisión realizada",
                $"Se remitieron {remitirResponse.Response.ItemsProcesados} item(s) con comprobante {remitirResponse.Response.DoPriCor}.",
                SweetAlertIcon.Success);

            await ImprimirRemitoConsignacionPorPlantillaAsync(remitirResponse.Response.DoPriCor);

            CerrarModalRemision();
            await CargarOrdenParaEdicion();
        }
        finally
        {
            remitiendoConsignaciones = false;
            StateHasChanged();
        }
    }

    private async Task ImprimirRemitoConsignacionPorPlantillaAsync(string? doPriCor)
    {
        if (string.IsNullOrWhiteSpace(doPriCor))
        {
            return;
        }

        var plantillaId = await GetPlantillaRemitoConsignacionIdAsync();
        if (!plantillaId.HasValue)
        {
            return;
        }

        var doprilar = Uri.EscapeDataString(doPriCor.Trim());
        var endpoint = $"api/impresiones/remito-plantillas/{plantillaId.Value}/pdf?Doprilar={doprilar}";
        var responsePdf = await Http.GetAsync(endpoint);
        if (!responsePdf.IsSuccessStatusCode)
        {
            var message = await responsePdf.Content.ReadAsStringAsync();
            await sweetAlertService.FireAsync("Atención", $"Se generó la remisión, pero no se pudo abrir la impresión del remito: {message}", SweetAlertIcon.Warning);
            return;
        }

        var pdfBytes = await responsePdf.Content.ReadAsByteArrayAsync();
        if (pdfBytes.Length == 0)
        {
            await sweetAlertService.FireAsync("Atención", "Se generó la remisión, pero el PDF del remito llegó vacío.", SweetAlertIcon.Warning);
            return;
        }

        var base64 = Convert.ToBase64String(pdfBytes);
        var opened = await JS.InvokeAsync<bool>("openPdfInNewTab", base64);
        if (!opened)
        {
            await sweetAlertService.FireAsync("Atención", "No se pudo abrir el PDF del remito en una nueva pestaña. Verificá el bloqueador de pop-ups.", SweetAlertIcon.Warning);
        }
    }

    private async Task<int?> GetPlantillaRemitoConsignacionIdAsync()
    {
        if (plantillaRemitoConsignacionId.HasValue)
        {
            return plantillaRemitoConsignacionId;
        }

        var response = await repository.Get<List<RemitoPlantillaItemDto>>("api/impresiones/remito-plantillas");
        if (response.Error || response.Response == null)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo obtener el listado de plantillas de remito: {message}", SweetAlertIcon.Error);
            return null;
        }

        var plantilla = response.Response
            .FirstOrDefault(x => string.Equals(x.Nombre?.Trim(), NombrePlantillaRemitoConsignacion, StringComparison.OrdinalIgnoreCase));
        if (plantilla == null)
        {
            await sweetAlertService.FireAsync("Atención", $"No se encontró la plantilla '{NombrePlantillaRemitoConsignacion}'.", SweetAlertIcon.Warning);
            return null;
        }

        plantillaRemitoConsignacionId = plantilla.Id;
        return plantillaRemitoConsignacionId;
    }

