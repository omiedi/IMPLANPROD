    /// <summary>
    /// Acepta la distribución de IVA con validaciones y confirmaciones
    /// </summary>
    private async Task AceptarDistribucionIva()
    {
        var totalGravado = baseImponible105 + baseImponible21 + baseImponible27;
        
        // Verificar si hay exceso en los campos editables
        if (totalGravado > TotalConDescuento)
        {
            var exceso = totalGravado - TotalConDescuento;
            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "¡Advertencia de Exceso!",
                Text = $"Los campos editables suman {totalGravado:C2}, pero solo hay {TotalConDescuento:C2} disponible.\n" +
                       $"Exceso: {exceso:C2}\n\n" +
                       $"El campo Exento/N/Grav quedará en {baseImponible0:C2} (negativo).\n\n" +
                       $"¿Desea continuar de todas formas?",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, continuar",
                CancelButtonText = "No, revisar"
            });

            if (!result.IsConfirmed)
            {
                return; // Usuario canceló
            }
        }

        // Cerrar modal y mostrar confirmación
        mostrarModalIva = false;
        
        if (totalGravado > TotalConDescuento)
        {
            await sweetAlertService.FireAsync("Advertencia", 
                "Distribución de IVA aplicada con advertencia de exceso", 
                SweetAlertIcon.Warning);
        }
        else
        {
            await sweetAlertService.FireAsync("Éxito", 
                "Distribución de IVA aplicada correctamente", 
                SweetAlertIcon.Success);
        }
    }

    /// <summary>
    /// Recalcula la distribución de IVA basado en las bases imponibles editables
    /// </summary>
    private void RecalcularDistribucionIva()
    {
        Console.WriteLine($"[RecalcularDistribucionIva] TotalConDescuento: {TotalConDescuento:C2}");
        Console.WriteLine($"[RecalcularDistribucionIva] baseImponible105: {baseImponible105:C2}");
        Console.WriteLine($"[RecalcularDistribucionIva] baseImponible21: {baseImponible21:C2}");
        Console.WriteLine($"[RecalcularDistribucionIva] baseImponible27: {baseImponible27:C2}");
        
        // Calcular importes de IVA para cada porcentaje
        importeIva105 = baseImponible105 * 0.105m;
        importeIva21 = baseImponible21 * 0.21m;
        importeIva27 = baseImponible27 * 0.27m;
        
        // Calcular ITOGRA(0) como el resto (lógica del VB6)
        var totalGravado = baseImponible105 + baseImponible21 + baseImponible27;
        baseImponible0 = TotalConDescuento - totalGravado;
        
        Console.WriteLine($"[RecalcularDistribucionIva] totalGravado: {totalGravado:C2}");
        Console.WriteLine($"[RecalcularDistribucionIva] baseImponible0 (calculado): {baseImponible0:C2}");
        
        StateHasChanged();
    }

    /// <summary>
    /// Pone todo el total en el campo seleccionado (funcionalidad de doble clic)
    /// </summary>
    private void PonerTodoEnCampo(int campo)
    {
        // Limpiar todos los campos primero
        LimpiarDistribucion();
        
        // Poner todo el total en el campo seleccionado
        switch (campo)
        {
            case 0: baseImponible0 = TotalConDescuento; break;   // Exento
            case 1: baseImponible105 = TotalConDescuento; break; // 10.5%
            case 2: baseImponible21 = TotalConDescuento; break;  // 21%
            case 3: baseImponible27 = TotalConDescuento; break;  // 27%
        }
        
        RecalcularDistribucionIva();
    }

