    private async Task<bool> ValidarEdicionConsignacionesAntesDeGuardar()
    {
        if (!ordenCompra.NumeOcom.HasValue || ordenCompra.NumeOcom.Value <= 0)
        {
            return false;
        }

        var itemsValidacion = detalleItems?
            .Where(x => (x.CodInte ?? 0) > 0 && (x.CantOcom ?? 0m) > 0.0001m)
            .Select(x => new ValidarEdicionConsignacionItemRequestDto
            {
                NumeroItem = x.NuOrdItem ?? 0,
                CodIntePadre = x.CodInte ?? 0,
                CodExtePadre = x.CodExte ?? string.Empty,
                DescripcionPadre = x.Descritem ?? x.Delibre ?? string.Empty,
                Cantidad = x.CantOcom ?? 0m
            })
            .ToList() ?? new List<ValidarEdicionConsignacionItemRequestDto>();

        var request = new ValidarEdicionConsignacionRequestDto
        {
            NumeroOrden = ordenCompra.NumeOcom.Value,
            Items = itemsValidacion
        };

        var response = await repository.Post<ValidarEdicionConsignacionRequestDto, ValidacionEdicionConsignacionResponseDto>("api/maconsig/validar-edicion-orden", request);
        if (response.Error)
        {
            var errorMessage = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", $"No se pudo validar consignaciones antes de guardar: {errorMessage}", SweetAlertIcon.Error);
            return false;
        }

        var data = response.Response;
        if (data == null || data.PuedeContinuar)
        {
            return true;
        }

        var conflictosAgrupadosPorItem = data.Conflictos
            .SelectMany(c => (c.ItemsAfectadosNumeros != null && c.ItemsAfectadosNumeros.Any()
                    ? c.ItemsAfectadosNumeros
                    : ParseItemsAfectados(c.ItemsAfectados))
                .Distinct()
                .Select(item => new { Item = item, Conflicto = c }))
            .GroupBy(x => x.Item)
            .OrderBy(g => g.Key)
            .ToList();

        var filasAgrupadas = string.Join("", conflictosAgrupadosPorItem.Select(g =>
        {
            var filasItem = string.Join("", g.Select(x => $@"
                <tr>
                    <td>{x.Conflicto.CodExte}</td>
                    <td>{x.Conflicto.Descripcion}</td>
                    <td class='text-end'>{x.Conflicto.CantidadNecesaria:N4}</td>
                    <td class='text-end'>{x.Conflicto.CantidadEntregada:N4}</td>
                    <td class='text-end'>{x.Conflicto.CantidadRendida:N4}</td>
                    <td class='text-end text-danger fw-bold'>{x.Conflicto.ExcesoEntregado:N4}</td>
                    <td>{x.Conflicto.ItemsAfectados}</td>
                </tr>"));

            return $@"
                <tr class='table-warning'>
                    <td colspan='7'><strong>Ítem O.C.: {g.Key:00}</strong></td>
                </tr>
                {filasItem}";
        }));

        var filas = string.IsNullOrWhiteSpace(filasAgrupadas)
            ? string.Join("", data.Conflictos.Select(c => $@"
                <tr>
                    <td>{c.CodExte}</td>
                    <td>{c.Descripcion}</td>
                    <td class='text-end'>{c.CantidadNecesaria:N4}</td>
                    <td class='text-end'>{c.CantidadEntregada:N4}</td>
                    <td class='text-end'>{c.CantidadRendida:N4}</td>
                    <td class='text-end text-danger fw-bold'>{c.ExcesoEntregado:N4}</td>
                    <td>{c.ItemsAfectados}</td>
                </tr>"))
            : filasAgrupadas;

        var cantidadItemsAfectados = conflictosAgrupadosPorItem.Count;
        var cantidadComponentesEnConflicto = data.Conflictos.Count;

        var html = $@"
            <div class='text-start' style='height:78vh; display:flex; flex-direction:column;'>
                <p><strong>No se puede continuar con la modificación.</strong></p>
                <p class='mb-2'>Hay componentes con cantidad entregada mayor a la necesaria para la nueva cantidad pedida.</p>
                <div class='alert alert-warning py-2 mb-3'>
                    <strong>Resumen:</strong> {cantidadItemsAfectados} ítem(s) de O.C. afectado(s) / {cantidadComponentesEnConflicto} componente(s) en conflicto.
                </div>
                <div class='table-responsive' style='flex:1 1 auto; min-height:0; overflow:auto; border:1px solid #dee2e6;'>
                    <table class='table table-sm table-bordered align-middle'>
                        <thead class='table-light'>
                            <tr>
                                <th style='position:sticky; top:0; z-index:2; background:#f8f9fa;'>Código</th>
                                <th style='position:sticky; top:0; z-index:2; background:#f8f9fa;'>Descripción</th>
                                <th class='text-end' style='position:sticky; top:0; z-index:2; background:#f8f9fa;'>Necesaria</th>
                                <th class='text-end' style='position:sticky; top:0; z-index:2; background:#f8f9fa;'>Entregada</th>
                                <th class='text-end' style='position:sticky; top:0; z-index:2; background:#f8f9fa;'>Rendida</th>
                                <th class='text-end' style='position:sticky; top:0; z-index:2; background:#f8f9fa;'>Exceso</th>
                                <th style='position:sticky; top:0; z-index:2; background:#f8f9fa;'>Ítems afectados</th>
                            </tr>
                        </thead>
                        <tbody>
                            {filas}
                        </tbody>
                    </table>
                </div>
                <p class='mb-0 text-muted'><small>Debe ajustar las cantidades de la O.C. para que no queden entregas superiores a la necesidad requerida.</small></p>
            </div>";

        await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Modificación bloqueada",
            Html = html,
            Icon = SweetAlertIcon.Warning,
            Width = "95vw",
            ConfirmButtonText = "Entendido"
        });

        return false;
    }

    private static List<short> ParseItemsAfectados(string? itemsAfectados)
    {
        var resultado = new List<short>();
        if (string.IsNullOrWhiteSpace(itemsAfectados))
        {
            return resultado;
        }

        var partes = itemsAfectados.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var parte in partes)
        {
            if (short.TryParse(parte, out var item))
            {
                resultado.Add(item);
            }
        }

        return resultado;
    }

