    /// <summary>
    /// Borra y regenera los datos de DETAIVA para la orden
    /// Basado en el código VB6 para guardar distribución de IVA
    /// </summary>
    private async Task BorrarYRegenerarDetaiva(int numeroOrden)
    {
        try
        {
            Console.WriteLine($"[BorrarYRegenerarDetaiva] Procesando distribución IVA para orden: {numeroOrden}");

            // PASO 1: Borrar datos existentes de DETAIVA
            await BorrarDetaiva(numeroOrden);

            // PASO 2: Regenerar datos de DETAIVA
            await RegenerarDetaiva(numeroOrden);

            Console.WriteLine($"[BorrarYRegenerarDetaiva] Distribución IVA actualizada exitosamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BorrarYRegenerarDetaiva] Excepción: {ex.Message}");
            throw; // Re-lanzar para manejo en método padre
        }
    }

    /// <summary>
    /// Borra los datos existentes de DETAIVA para la orden
    /// Equivalente a: DELETE DETAIVA where Nume_Ocom = numeroOrden
    /// </summary>
    private async Task BorrarDetaiva(int numeroOrden)
    {
        try
        {
            Console.WriteLine($"[BorrarDetaiva] Eliminando distribución IVA existente para orden: {numeroOrden}");

            var deleteRequest = new
            {
                NumeroOrden = numeroOrden,
                Condicion = $"Nume_Ocom = {numeroOrden}"
            };

            // Llamar al endpoint implementado para borrar DETAIVA (reutiliza DetaivaService existente)
            var response = await repository.Post("/api/detaiva/borrar-por-orden", deleteRequest);

            if (response.Error)
            {
                var errorMessage = await response.GetErrorMessageAsync();
                Console.WriteLine($"[BorrarDetaiva] Error del servidor: {errorMessage}");

                // Si el error indica que no hay registros, no es un error crítico
                if (errorMessage.Contains("No se encontraron registros") ||
                    errorMessage.Contains("0 registros afectados") ||
                    errorMessage.Contains("no hay registros") ||
                    errorMessage.Contains("tabla vacía"))
                {
                    Console.WriteLine($"[BorrarDetaiva] No hay registros DETAIVA para borrar - continuando");
                    return; // No es un error, simplemente no hay nada que borrar
                }

                // Si es otro tipo de error, sí lanzar excepción
                throw new Exception($"Error al borrar DETAIVA: {errorMessage}");
            }

            Console.WriteLine($"[BorrarDetaiva] DETAIVA eliminado exitosamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BorrarDetaiva] Excepción: {ex.Message}");

            // Si la excepción indica que no hay registros, no re-lanzar
            if (ex.Message.Contains("No se encontraron registros") ||
                ex.Message.Contains("0 registros afectados") ||
                ex.Message.Contains("no hay registros"))
            {
                Console.WriteLine($"[BorrarDetaiva] Excepción manejada: no hay registros DETAIVA para borrar");
                return;
            }

            throw; // Re-lanzar para manejo en método padre solo si es un error real
        }
    }

    /// <summary>
    /// Regenera los datos de DETAIVA basado en la distribución actual de IVA
    /// Basado en el código VB6 con RIVACOM07
    /// </summary>
    private async Task RegenerarDetaiva(int numeroOrden)
    {
        try
        {
            Console.WriteLine($"[RegenerarDetaiva] Regenerando distribución IVA para orden: {numeroOrden}");

            // Preparar datos de distribución IVA según el código VB6
            var distribucionIva = new List<object>();

            // KKII% = 0 To 5 (6 niveles de IVA)
            // Nivel 0: 0%
            if (baseImponible0 >= 0.005m || importeIva0 >= 0.005m)
            {
                distribucionIva.Add(new
                {
                    // CODIEMPR = CodiEmp% (se asignará en backend)
                    NumeOcom = numeroOrden,
                    Norit = 0, // KKII%
                    TasaIva = 0.0m, // .TASIVA(KKII%)
                    BaseImpo = baseImponible0, // .IMPOGRA(KKII%)
                    ImpoIva = importeIva0 // .IMPOIVA(KKII%)
                });
            }

            // Nivel 1: 10.5%
            if (baseImponible105 >= 0.005m || importeIva105 >= 0.005m)
            {
                distribucionIva.Add(new
                {
                    NumeOcom = numeroOrden,
                    Norit = 1,
                    TasaIva = 10.5m,
                    BaseImpo = baseImponible105,
                    ImpoIva = importeIva105
                });
            }

            // Nivel 2: 21%
            if (baseImponible21 >= 0.005m || importeIva21 >= 0.005m)
            {
                distribucionIva.Add(new
                {
                    NumeOcom = numeroOrden,
                    Norit = 2,
                    TasaIva = 21.0m,
                    BaseImpo = baseImponible21,
                    ImpoIva = importeIva21
                });
            }

            // Nivel 3: 27%
            if (baseImponible27 >= 0.005m || importeIva27 >= 0.005m)
            {
                distribucionIva.Add(new
                {
                    NumeOcom = numeroOrden,
                    Norit = 3,
                    TasaIva = 27.0m,
                    BaseImpo = baseImponible27,
                    ImpoIva = importeIva27
                });
            }

            // Solo proceder si hay datos para insertar
            if (distribucionIva.Any())
            {
                var insertRequest = new
                {
                    NumeroOrden = numeroOrden,
                    DistribucionIva = distribucionIva
                };

                // Llamar al endpoint implementado para insertar DETAIVA (reutiliza DetaivaService existente)
                var response = await repository.Post("/api/detaiva/insertar-distribucion", insertRequest);

                if (response.Error)
                {
                    var errorMessage = await response.GetErrorMessageAsync();
                    Console.WriteLine($"[RegenerarDetaiva] Error: {errorMessage}");
                    throw new Exception($"Error al regenerar DETAIVA: {errorMessage}");
                }

                Console.WriteLine($"[RegenerarDetaiva] Insertados {distribucionIva.Count} registros de distribución IVA");
            }
            else
            {
                Console.WriteLine($"[RegenerarDetaiva] No hay distribución IVA para insertar");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[RegenerarDetaiva] Excepción: {ex.Message}");
            throw;
        }
    }

    /// <summary>
    /// Procesa el detalle OCOMDETA insertando los items de la orden
    /// Basado en el código VB6 proporcionado
    /// </summary>
    private async Task ProcesarDetalleOcomdeta(int numeroOrden)
    {
        try
        {
            Console.WriteLine($"[ProcesarDetalleOcomdeta] Procesando detalle para orden: {numeroOrden}");

            if (detalleItems == null || !detalleItems.Any())
            {
                Console.WriteLine($"[ProcesarDetalleOcomdeta] No hay items para procesar");
                return;
            }

            // Preparar lista de items para insertar
            var itemsParaInsertar = new List<object>();

            string simboloMoneda = "$";

            string valorUnitarioFormateado;
            // Procesar cada item del detalle
            foreach (var item in detalleItems)
            {
                if (ordenCompra.MoneEmis < 2) { simboloMoneda = "$"; }
                if (ordenCompra.MoneEmis >= 2) { simboloMoneda = "DO"; }
                

                // Solo procesar items con cantidad > 0
                if (item.CantOcom <= 0) continue;

                var itemDetalle = new
                {
                    // Campos básicos de identificación
                    CodiEmpr = 0, // Se asignará en backend
                    NumeOcom = numeroOrden,
                    NuOrdItem = item.NuOrdItem, // ORDIT% - Número de orden del item
                    FemiOcom = ordenCompra.FemiOcom, // Fecha de emisión
                    MediOcom = "", // SAFETEXT$(PedInt$) - Medio/Pedido interno
                    NproOcom = ordenCompra.NproOcom, // Número de proveedor
                    RasoProv = ordenCompra.RaSoProv?.Substring(0, Math.Min(64, ordenCompra.RaSoProv?.Length ?? 0)),

                    // Códigos del producto
                    CodInte = item.CodInte, // CI0% - Código interno
                    CodExte = item.CodExte?.Substring(0, Math.Min(24, item.CodExte?.Length ?? 0)), // Código externo
                    Descritem = item.Descritem?.Substring(0, Math.Min(24, item.Descritem?.Length ?? 0)), // Descripción
                    Delibre = item.Delibre ?? "", // Descripción libre

                    // Si no hay código interno, usar descripción libre como descripción
                    DescripcionFinal = item.CodInte < 1 && !string.IsNullOrEmpty(item.Delibre) 
                        ? item.Delibre.Substring(0, Math.Min(64, item.Delibre.Length)) 
                        : item.Descritem?.Substring(0, Math.Min(64, item.Descritem?.Length ?? 0)),
                    valorUnitarioFormateado = $"{simboloMoneda} {item.PreUnit:F4}",

                    // Unidades y cantidades
                    ValoUnid = valorUnitarioFormateado = $"{simboloMoneda} {item.PreUnit:F4}",
                    // VAUNI$ - Valor unidad (string)
                    UniMas = item.UniMas, // Unidad de medida master
                    UnidsOcom = item.CantOcom, // CAUNIS - Cantidad en unidades de stock
                    CantOcom = item.CantOcom, // CANTU - Cantidad de compra
                    UniCom = item.UniCom, // Unidad de compra
                    CoefUnids = 1.0m, // COEFUNI - Coeficiente de unidades

                    // Precios y descuentos
                    PreUnit = item.PreUnit, // Precio unitario
                    DescItem = item.DescItem ?? 0, // Descuento del item
                    PrunNeto = item.PrUnNeto, // Precio unitario neto
                    INetItem = (item.CantOcom ?? 0) * (item.PrUnNeto ?? 0), // Importe neto del item
                    PrUnNetoPes = item.PreUnit, // Precio unitario neto en pesos

                    // Fechas
                    FentreSol = item.FentreSol, // Fecha de entrega solicitada

                    // Otros campos
                    Consimat = 0, // Consignación material
                    CantRec = 0m, // Cantidad recibida (se calculará)
                    
                    // Monedas
                    MoneCos = ordenCompra.MoneCos, // Moneda de costos
                    MoneEmis = ordenCompra.MoneEmis, // Moneda de emisión
                    TsumOcom = 0m, // Total suma


                    // Estado
                    StatOcom = ordenCompra.StatOcom, // Estado de la orden

                    // Imputación contable y sector
                    IContab = item.IContab, // Destino imputación contable
                    SectOcom = item.SectOcom // Sector
                };

                itemsParaInsertar.Add(itemDetalle);
            }

            if (itemsParaInsertar.Any())
            {
                var insertRequest = new
                {
                    NumeroOrden = numeroOrden,
                    Items = itemsParaInsertar
                };

                // Llamar al endpoint implementado para insertar items de detalle
                var response = await repository.Post("/api/ocomdeta/insertar-items", insertRequest);
                
                if (response.Error)
                {
                    var errorMessage = await response.GetErrorMessageAsync();
                    Console.WriteLine($"[ProcesarDetalleOcomdeta] Error: {errorMessage}");
                    throw new Exception($"Error al procesar detalle OCOMDETA: {errorMessage}");
                }

                Console.WriteLine($"[ProcesarDetalleOcomdeta] Insertados {itemsParaInsertar.Count} items de detalle");
            }
            else
            {
                Console.WriteLine($"[ProcesarDetalleOcomdeta] No hay items válidos para insertar");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ProcesarDetalleOcomdeta] Excepción: {ex.Message}");
            throw; // Re-lanzar para manejo en método padre
        }
    }

