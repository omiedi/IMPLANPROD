    /// <summary>
    /// Ejecuta el guardado de la orden de compra
    /// Implementa lógica similar al guardado de O.C. nueva según código VB6
    /// </summary>
    private async Task GuardarOrdenCompra()
    {
        try
        {
            guardando = true;
            StateHasChanged();

            Console.WriteLine($"[GuardarOrdenCompra] Iniciando guardado de orden {ordenCompra.NumeOcom}");
            Console.WriteLine($"[GuardarOrdenCompra] Estado actual: {ordenCompra.StatOcom}");
            Console.WriteLine($"[GuardarOrdenCompra] Proveedor: {ordenCompra.NproOcom} - {ordenCompra.RaSoProv}");
            Console.WriteLine($"[GuardarOrdenCompra] Items en detalle: {detalleItems?.Count ?? 0}");

            if (!await ValidarEdicionConsignacionesAntesDeGuardar())
            {
                return;
            }

            // PASO 1: Borrar consignaciones sin entregas (BORRACONSIG)
            await BorrarConsignacionesSinEntregas(ordenCompra.NumeOcom.Value);

            // PASO 2: Actualizar encabezado OCOMENCA
            await ActualizarEncabezadoOrden();

            // PASO 3: Cambiar estado de items anteriores a 10 (anulados)
            await CambiarEstadoItemsAnteriores(ordenCompra.NumeOcom.Value);

            // PASO 4: Borrar y regenerar DETAIVA
            await BorrarYRegenerarDetaiva(ordenCompra.NumeOcom.Value);

            // PASO 5: Procesar detalle OCOMDETA
            await ProcesarDetalleOcomdeta(ordenCompra.NumeOcom.Value);

            // PASO 5.1: Sincronizar consignaciones con nuevo índice de items y topes de rendido
            await SincronizarConsignacionesEdicion(ordenCompra.NumeOcom.Value);

            // PASO 6: Procesar MACONSIG según lógica VB6
            await ProcesarMaconsig(ordenCompra.NumeOcom.Value);

            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Orden Actualizada",
                Html = @"
                    <div class='text-center'>
                        <i class='fas fa-check-circle fa-3x text-success mb-3'></i>
                        <p><strong>La orden de compra ha sido actualizada exitosamente.</strong></p>
                        <hr>
                        <p class='text-muted'>
                            <i class='fas fa-info-circle me-1'></i>
                            Se ha generado una nueva versión de la orden.
                        </p>
                    </div>",
                Icon = SweetAlertIcon.Success,
                ShowCancelButton = false,
                ConfirmButtonText = "Continuar",
                ConfirmButtonColor = "#28a745"
            });

            // Recargar datos después del guardado
            await CargarOrdenParaEdicion();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[GuardarOrdenCompra] Error: {ex.Message}");
            await sweetAlertService.FireAsync("Error", 
                $"Error al guardar la orden: {ex.Message}", 
                SweetAlertIcon.Error);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Borra consignaciones sin entregas de MACONSIG
    /// Basado en Sub BORRACONSIG del código VB6
    /// </summary>
    private async Task BorrarConsignacionesSinEntregas(int numeroOrden)
    {
        try
        {
            Console.WriteLine($"[BorrarConsignacionesSinEntregas] Procesando orden: {numeroOrden}");

            // Formatear número de orden como en VB6: "OC-000001"
            string nocom = numeroOrden.ToString().PadLeft(6, '0');
            nocom = $"OC-{nocom.Substring(0, 6)}";

            Console.WriteLine($"[BorrarConsignacionesSinEntregas] Código formateado: {nocom}");

            // Preparar el DTO para la eliminación
            var deleteRequest = new
            {
                NumeroOrden = numeroOrden,
                CodigoFormateado = nocom,
                Condicion = $"NRO_OCOM LIKE '{nocom}%' and Cant_Entreg = 0"
            };

            // Llamar al endpoint implementado para borrar consignaciones
            var response = await repository.Post("/api/maconsig/borrar-consignaciones", deleteRequest);

            if (response.Error)
            {
                var errorMessage = await response.GetErrorMessageAsync();
                Console.WriteLine($"[BorrarConsignacionesSinEntregas] Error del servidor: {errorMessage}");

                // Si el error indica que no hay consignaciones, no es un error crítico
                if (errorMessage.Contains("no haya consignaciones") || 
                    errorMessage.Contains("no hay consignaciones") ||
                    errorMessage.Contains("No se encontraron registros") ||
                    errorMessage.Contains("0 registros afectados"))
                {
                    Console.WriteLine($"[BorrarConsignacionesSinEntregas] No hay consignaciones para borrar - continuando");
                    return; // No es un error, simplemente no hay nada que borrar
                }

                // Si es otro tipo de error, sí lanzar excepción
                throw new Exception($"Error al borrar consignaciones: {errorMessage}");
            }

            Console.WriteLine($"[BorrarConsignacionesSinEntregas] Consignaciones eliminadas exitosamente");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BorrarConsignacionesSinEntregas] Excepción: {ex.Message}");

            // Si la excepción indica que no hay consignaciones, no re-lanzar
            if (ex.Message.Contains("no haya consignaciones") || 
                ex.Message.Contains("no hay consignaciones") ||
                ex.Message.Contains("No se encontraron registros"))
            {
                Console.WriteLine($"[BorrarConsignacionesSinEntregas] Excepción manejada: no hay consignaciones para borrar");
                return;
            }

            throw; // Re-lanzar para manejo en método padre solo si es un error real
        }
    }

