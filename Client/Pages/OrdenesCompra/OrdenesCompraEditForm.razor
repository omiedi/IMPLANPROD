    /// <summary>
    /// Carga la orden de compra para edición
    /// </summary>
    private async Task CargarOrdenParaEdicion()
    {
        try
        {
            // Cargar encabezado
            var responseOrden = await repository.Get<Ocomenca>($"api/ocomenca/{OrdenId}");
            if (responseOrden.Error)
            {
                var message = await responseOrden.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar la orden: {message}", SweetAlertIcon.Error);
                return;
            }

            ordenCompra = responseOrden.Response!;

            // Cargar información del proveedor desde PROVED12
            if (ordenCompra.NproOcom.HasValue)
            {
                var responseProveedor = await repository.Get<Proved12>($"api/proved12/numero/{ordenCompra.NproOcom}");
                if (!responseProveedor.Error && responseProveedor.Response != null)
                {
                    var proveedor = responseProveedor.Response;
                    // Mapear a ProveedorSeleccionado
                    proveedorInfo = new SelectorProveedores.ProveedorSeleccionado
                    {
                        NumeCli = proveedor.Nume_Cli,
                        RazonSocial = proveedor.Raso_Cli ?? "",
                        CodigoProveedor = proveedor.Codi_Cli ?? "",
                        Domicilio = proveedor.Domi_Cli ?? "",
                        CodigoPostal = proveedor.Cpos_Cli ?? "",
                        Localidad = proveedor.Loca_Cli ?? "",
                        Contacto = proveedor.Tele_Cli ?? "",
                        Cuit = proveedor.Cuit_Cli ?? ""
                    };

                    // También agregar al objeto proveedorInfo
                    proveedorInfo.ContactoAtencion = proveedor.Ctac_Cli ?? "";

                    // Capturar el tipo de IVA del proveedor para validaciones futuras
                    tipoIvaProveedor = proveedor.Piva_Cli;
                    Console.WriteLine($"[CargarOrdenParaEdicion] Tipo IVA proveedor: {tipoIvaProveedor}");

                    proveedorSeleccionado = $"{proveedorInfo.NumeCli} - {proveedorInfo.RazonSocial}";

                    // También actualizar el campo RaSoProv en la orden si no está presente
                    if (string.IsNullOrEmpty(ordenCompra.RaSoProv))
                    {
                        ordenCompra.RaSoProv = proveedorInfo.RazonSocial;
                    }
                }
            }

            // Cargar detalle
            await CargarDetalle();

            // Cargar y procesar distribución de IVA existente
            await CargarDistribucionIvaExistente();

            // Cargar sector y destino después de tener todos los datos
            await CargarSectorYDestino();

            // Cargar descuento existente
            CargarDescuentoExistente();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar orden para edición: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error inesperado: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Carga el detalle de items de la orden
    /// </summary>
    private async Task CargarDetalle()
    {
        try
        {
            // Verificar si la orden está anulada antes de cargar el detalle
            if (ordenCompra != null && ordenCompra.StatOcom >= 9)
            {
                Console.WriteLine($"[CargarDetalle] Orden anulada (Estado: {ordenCompra.StatOcom})");
                await sweetAlertService.FireAsync("Orden Anulada", "O/Compra Anulada - Imposible Modificar", SweetAlertIcon.Warning);
                // Redirigir al índice o deshabilitar la edición
                navigationManager.NavigateTo("/ordenes-compra");
                return;
            }

            // Usar el número de orden (NumeOcom) para buscar el detalle enriquecido
            if (ordenCompra?.NumeOcom.HasValue == true)
            {
                var responseDetalle = await repository.Get<List<OcomdetaEditDTO>>($"api/ocomdeta/edicion/{ordenCompra.NumeOcom.Value}");
                if (!responseDetalle.Error)
                {
                    detalleItemsEnriquecido = responseDetalle.Response ?? new List<OcomdetaEditDTO>();
                    Console.WriteLine($"[CargarDetalle] Cargados {detalleItemsEnriquecido.Count} items enriquecidos para orden {ordenCompra.NumeOcom}");

                    // También mantener la lista original para compatibilidad
                    detalleItems = detalleItemsEnriquecido.Select(dto => new Ocomdeta
                    {
                        OCOMDETA_ID = dto.OCOMDETA_ID,
                        NumeOcom = dto.NumeOcom,
                        NuOrdItem = dto.NuOrdItem,
                        CodInte = dto.CodInte,
                        CodExte = dto.CodExte,
                        Descritem = dto.Descritem,
                        Delibre = dto.Delibre,
                        CantOcom = dto.CantOcom,
                        CantRec = dto.CantRec,
                        UniCom = dto.UniCom,
                        UniMas = dto.UniMas,
                        PreUnit = dto.PreUnit,
                        DescItem = dto.DescItem,
                        PrUnNeto = dto.PrUnNeto,
                        FemiOcom = dto.FemiOcom,
                        FentreSol = dto.FentreSol,
                        SectOcom = dto.SectOcom,
                        IContab = dto.IContab,
                        MediOcom = dto.MediOcom,
                        Consimat = dto.Consimat,
                        StatOcom = dto.StatOcom,
                        MoneEmis = dto.MoneEmis
                    }).ToList();
                }
                else
                {
                    Console.WriteLine($"[CargarDetalle] Error al cargar detalle: {responseDetalle.HttpResponseMessage?.StatusCode}");
                    var errorMessage = await responseDetalle.GetErrorMessageAsync();
                    Console.WriteLine($"[CargarDetalle] Mensaje de error: {errorMessage}");
                }
            }
            else
            {
                Console.WriteLine($"[CargarDetalle] No se puede cargar detalle: NumeOcom no disponible");
                detalleItems = new List<Ocomdeta>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CargarDetalle] Error al cargar detalle: {ex.Message}");
            detalleItems = new List<Ocomdeta>();
        }
    }

    /// <summary>
    /// Carga el sector y destino desde el primer item de OCOMDETA
    /// Se ejecuta después de cargar todos los datos necesarios
    /// </summary>
    private async Task CargarSectorYDestino()
    {
        try
        {
            Console.WriteLine($"[CargarSectorYDestino] Iniciando carga...");
            Console.WriteLine($"[CargarSectorYDestino] detalleItems count: {detalleItems?.Count ?? 0}");
            Console.WriteLine($"[CargarSectorYDestino] cuentasDestino count: {cuentasDestino?.Count ?? 0}");

            if (detalleItems == null || !detalleItems.Any())
            {
                sectorOrdenCompra = "Sin items";
                destinoOrdenCompra = "Sin items";
                Console.WriteLine($"[CargarSectorYDestino] No hay items de detalle");
                return;
            }

            var primerItem = detalleItems.First();
            Console.WriteLine($"[CargarSectorYDestino] Primer item - SectOcom: '{primerItem.SectOcom}', IContab: {primerItem.IContab}");

            // Sector desde OCOMDETA.SectOcom
            sectorOrdenCompra = primerItem.SectOcom ?? "Sin sector";
            Console.WriteLine($"[CargarSectorYDestino] Sector cargado: '{sectorOrdenCompra}'");

            // Destino desde OCOMDETA.IContab
            if (primerItem.IContab.HasValue)
            {
                Console.WriteLine($"[CargarSectorYDestino] Buscando cuenta destino para código: {primerItem.IContab.Value}");

                // Buscar la descripción del destino en las cuentas
                var cuentaDestino = cuentasDestino?.FirstOrDefault(c => c.CodInCue == primerItem.IContab.Value);
                if (cuentaDestino != null)
                {
                    destinoOrdenCompra = $"{cuentaDestino.CodInCue} - {cuentaDestino.CodExCue} - {cuentaDestino.Denocue}";
                    Console.WriteLine($"[CargarSectorYDestino] Cuenta encontrada: {destinoOrdenCompra}");
                }
                else
                {
                    destinoOrdenCompra = $"Código: {primerItem.IContab.Value}";
                    Console.WriteLine($"[CargarSectorYDestino] Cuenta no encontrada, usando código: {destinoOrdenCompra}");
                }
            }
            else
            {
                destinoOrdenCompra = "Sin destino";
                Console.WriteLine($"[CargarSectorYDestino] IContab es null");
            }

            Console.WriteLine($"[CargarSectorYDestino] Resultado final - Sector: '{sectorOrdenCompra}', Destino: '{destinoOrdenCompra}'");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CargarSectorYDestino] Error: {ex.Message}");
            sectorOrdenCompra = "Error al cargar";
            destinoOrdenCompra = "Error al cargar";
        }
    }

    // ===== Variables para Distribución de IVA =====
    private DistribucionIvaDTO? distribucionIvaExistente;
    private decimal totalNetoSinDescuento = 0m;
    private bool tieneDistribucionIva = false;

    /// <summary>
    /// Carga la distribución de IVA existente desde DETAIVA y la procesa
    /// Equivalente al código VB6 que carga RIVACOM07
    /// TOTANEX = TOTAL SIN DESCUENTOS Y SIN IVA - IMPORTE DESCUENTO 
    /// RIVACOM07.TONECOM = TOTANEX 
    /// </summary>
    private async Task CargarDistribucionIvaExistente()
    {
        try
        {
            // 1. Calcular TOTANEX (Total sin descuentos y sin IVA - Importe descuento)
            totalNetoSinDescuento = CalcularTotalNetoSinDescuento();

            Console.WriteLine($"[CargarDistribucionIvaExistente] TOTANEX calculado: {totalNetoSinDescuento:C2}");

            // 2. Consultar distribución de IVA usando el endpoint que convierte a DTO
            var responseDistribucion = await repository.Get<DistribucionIvaDTO>($"api/detaiva/distribucion/{OrdenId}");
            if (responseDistribucion.Error || responseDistribucion.Response == null)
            {
                Console.WriteLine("No se encontró distribución de IVA existente");
                tieneDistribucionIva = false;
                return;
            }

            distribucionIvaExistente = responseDistribucion.Response;
            tieneDistribucionIva = true;

            // Cargar también en las variables del modal para edición
            baseImponible0 = distribucionIvaExistente.BaseImponible0;
            baseImponible105 = distribucionIvaExistente.BaseImponible105;
            baseImponible21 = distribucionIvaExistente.BaseImponible21;
            baseImponible27 = distribucionIvaExistente.BaseImponible27;
            importeIva105 = distribucionIvaExistente.ImporteIva105;
            importeIva21 = distribucionIvaExistente.ImporteIva21;
            importeIva27 = distribucionIvaExistente.ImporteIva27;

            // 3. Procesar y mostrar información como en el código VB6
            Console.WriteLine($"[CargarDistribucionIvaExistente] Distribución IVA cargada:");
            Console.WriteLine($"  - BaseImponible0 (0%): {distribucionIvaExistente.BaseImponible0:C2}");
            Console.WriteLine($"  - BaseImponible105 (10.5%): {distribucionIvaExistente.BaseImponible105:C2} - IVA: {distribucionIvaExistente.ImporteIva105:C2}");
            Console.WriteLine($"  - BaseImponible21 (21%): {distribucionIvaExistente.BaseImponible21:C2} - IVA: {distribucionIvaExistente.ImporteIva21:C2}");
            Console.WriteLine($"  - BaseImponible27 (27%): {distribucionIvaExistente.BaseImponible27:C2} - IVA: {distribucionIvaExistente.ImporteIva27:C2}");
            Console.WriteLine($"  - Total Base Imponible: {distribucionIvaExistente.TotalBaseImponible:C2}");
            Console.WriteLine($"  - Total IVA: {distribucionIvaExistente.TotalIva:C2}");

            // 4. Validar consistencia (como en VB6)
            if (Math.Abs(distribucionIvaExistente.TotalBaseImponible - totalNetoSinDescuento) > 0.01m)
            {
                Console.WriteLine($"[ADVERTENCIA] Diferencia en totales - TOTANEX: {totalNetoSinDescuento:C2}, " +
                                $"Base Imponible Total: {distribucionIvaExistente.TotalBaseImponible:C2}");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar distribución de IVA: {ex.Message}");
            tieneDistribucionIva = false;
        }
    }

    /// <summary>
    /// Calcula el total neto sin descuento (equivalente a TOTANEX del VB6)
    /// TOTANEX = TOTAL SIN DESCUENTOS Y SIN IVA - IMPORTE DESCUENTO
    /// </summary>
    private decimal CalcularTotalNetoSinDescuento()
    {
        Console.WriteLine($"[CalcularTotalNetoSinDescuento] detalleItems count: {detalleItems?.Count ?? 0}");

        // En el formulario de edición, usar el total ya calculado de la orden si está disponible
        // Si hay distribución existente, usar su TotalBaseImponible (es el más confiable)
        if (distribucionIvaExistente != null && distribucionIvaExistente.TotalBaseImponible > 0)
        {
            Console.WriteLine($"[CalcularTotalNetoSinDescuento] Usando TotalBaseImponible de distribución existente: {distribucionIvaExistente.TotalBaseImponible:C2}");
            return distribucionIvaExistente.TotalBaseImponible;
        }

        // Si no hay distribución pero hay TotalOcom, usarlo
        if (ordenCompra.TotalOcom.HasValue && ordenCompra.TotalOcom.Value > 0)
        {
            Console.WriteLine($"[CalcularTotalNetoSinDescuento] Usando TotalOcom de la orden: {ordenCompra.TotalOcom.Value:C2}");
            return ordenCompra.TotalOcom.Value;
        }

        // Fallback: calcular desde detalleItems si están disponibles
        if (detalleItems == null || !detalleItems.Any())
        {
            Console.WriteLine($"[CalcularTotalNetoSinDescuento] No hay detalleItems disponibles");
            return 0m;
        }

        // Suma de todos los items (Cantidad * Precio)
        decimal totalBruto = detalleItems.Sum(item => 
            (item.CantOcom ?? 0) * (item.PreUnit ?? 0));

        // Restar descuento aplicado (IdesOcom)
        decimal descuento = ordenCompra.IdesOcom ?? 0m;

        decimal totalNeto = totalBruto - descuento;

        Console.WriteLine($"[CalcularTotalNetoSinDescuento] Calculado desde items - Total Bruto: {totalBruto:C2}, Descuento: {descuento:C2}, Total Neto: {totalNeto:C2}");

        return totalNeto;
    }

