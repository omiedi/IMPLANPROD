    private async Task OnProductoSeleccionado(SelectorProductos.SeleccionProducto seleccion)
    {
        try
        {
            if (seleccion?.Producto == null)
            {
                return;
            }

            if (detalleItems == null)
            {
                detalleItems = new List<Ocomdeta>();
            }

            var producto = seleccion.Producto;
            var itemReferencia = detalleItems.OrderBy(i => i.NuOrdItem ?? 0).FirstOrDefault();

            var siguienteNumeroItem = (short)((detalleItems
                .Select(i => (int)(i.NuOrdItem ?? 0))
                .DefaultIfEmpty(0)
                .Max()) + 1);

            var cantidad = seleccion.Cantidad > 0 ? seleccion.Cantidad : 1m;
            var precio = seleccion.Precio > 0 ? seleccion.Precio : (producto.Cosuni ?? 0m);

            var codInte = producto.Codint > 0 && producto.Codint <= short.MaxValue
                ? (short?)producto.Codint
                : (short?)0;

            var codigoExterno = producto.Codigo ?? string.Empty;
            if (codigoExterno.Length > 24)
            {
                codigoExterno = codigoExterno.Substring(0, 24);
            }

            var descripcion = producto.Descripcion ?? string.Empty;
            if (descripcion.Length > 64)
            {
                descripcion = descripcion.Substring(0, 64);
            }

            var unidad = producto.Umedida ?? string.Empty;
            if (unidad.Length > 4)
            {
                unidad = unidad.Substring(0, 4);
            }

            var nuevoItem = new Ocomdeta
            {
                OCOMDETA_ID = 0,
                CodiEmpr = 0,
                NumeOcom = ordenCompra.NumeOcom,
                NuOrdItem = siguienteNumeroItem,
                FemiOcom = ordenCompra.FemiOcom ?? DateTime.Now,
                NproOcom = ordenCompra.NproOcom.HasValue ? (short?)ordenCompra.NproOcom.Value : null,
                RaSoProv = ordenCompra.RaSoProv,
                CodInte = codInte,
                CodExte = codigoExterno,
                Descritem = descripcion,
                Delibre = codInte <= 0 ? descripcion : null,
                UniMas = unidad,
