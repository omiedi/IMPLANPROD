@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Client.Repositories
@inject IRepository repository
@inject IJSRuntime JS
@inject SweetAlertService sweetAlertService

@if (MostrarModal && OrdenCompra != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-print"></i> Vista Previa - Orden de Compra N° @OrdenCompra.NumeOcom
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-0">
                    <!-- Contenido de impresión -->
                    <div id="contenido-impresion" class="p-3" style="background: white; font-family: Arial, sans-serif; font-size: 12px; line-height: 1.3;">
                        
                        <!-- Encabezado con datos de la empresa -->
                        <div class="row encabezado-empresa" style="margin-bottom: 12px; page-break-inside: avoid;">
                            <div class="col-8">
                                @if (DatosEmpresa != null)
                                {
                                    <div style="border: 2px solid #000; padding: 12px;">
                                        <h4 style="margin: 0; font-weight: bold; color: #ff6600; font-size: 16px;">@DatosEmpresa.razon</h4>
                                        <p style="margin: 4px 0; font-size: 11px; line-height: 1.3;">
                                            Dirección: @($"{DatosEmpresa.calle} {DatosEmpresa.numero}") @DatosEmpresa.complemento<br>
                                            (@DatosEmpresa.CP) @DatosEmpresa.localidad - Argentina<br>
                                            Teléfono: @DatosEmpresa.TEL1 - Email: @DatosEmpresa.email<br>
                                            CUIT: @DatosEmpresa.CUIT
                                        </p>
                                    </div>
                                }
                            </div>
                            <div class="col-4">
                                <div style="border: 2px solid #000; padding: 12px; text-align: center;">
                                    <h5 style="margin: 0; font-weight: bold; font-size: 14px;">PEDIDO DE SUMINISTRO</h5>
                                    <div style="border: 1px solid #000; padding: 8px; margin: 8px 0;">
                                        <strong style="font-size: 13px;">Nro: @OrdenCompra.NumeOcom</strong>
                                    </div>
                                    <p style="margin: 5px 0; font-size: 12px;">
                                        <strong>Fecha: @(OrdenCompra.FemiOcom?.ToString("dd/MM/yyyy") ?? "N/A")</strong>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Datos del proveedor y condiciones -->
                        <div class="row datos-proveedor" style="margin-bottom: 12px; align-items: stretch; page-break-inside: avoid;">
                            <div class="col-8">
                                <div style="border: 1px solid #000;">
                                    <div style="background: #f0f0f0; padding: 6px; border-bottom: 1px solid #000; font-size: 12px;">
                                        <strong>Señores:</strong>
                                    </div>
                                    <div style="padding: 10px; font-size: 11px;">
                                        <strong>@OrdenCompra.RaSoProv</strong><br>
                                        Responsable/Contacto: @(OrdenCompra.ObseOcom ?? "N/A")
                                    </div>
                                </div>
                            </div>
                            <div class="col-4">
                                <table style="width: 100%; border: 1px solid #000; border-collapse: collapse;">
                                    <tr>
                                        <td style="border: 1px solid #000; padding: 5px 6px; background: #f0f0f0; font-size: 11px;"><strong>Cuenta:</strong></td>
                                        <td style="border: 1px solid #000; padding: 5px 6px; font-size: 11px;">@OrdenCompra.NproOcom</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #000; padding: 5px 6px; background: #f0f0f0; font-size: 11px;"><strong>Condición</strong></td>
                                        <td style="border: 1px solid #000; padding: 5px 6px; font-size: 11px;">@(OrdenCompra.CpagOcom?.ToString() ?? "N/A")</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #000; padding: 5px 6px; background: #f0f0f0; font-size: 11px;"><strong>Moneda</strong></td>
                                        <td style="border: 1px solid #000; padding: 5px 6px; font-size: 11px;">@DescripcionMoneda</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Tabla de items -->
                        <table class="tabla-items" style="width: 100%; border-collapse: collapse; border: 1px solid #000; margin-bottom: 15px;">
                            <thead>
                                <tr style="background: #f0f0f0;">
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 5%; font-size: 11px;">Item</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 35%; font-size: 11px;">Código / Descripción</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 8%; font-size: 11px;">UM</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 10%; font-size: 11px;">Cantidad</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 12%; font-size: 11px;">Precio</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 12%; font-size: 11px;">Importe</th>
                                    <th style="border: 1px solid #000; padding: 6px; text-align: center; width: 12%; font-size: 11px;">F. Entrega</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (DetalleItems != null)
                                {
                                    var itemsActivos = DetalleItems.Where(item => item.StatOcom < 10).ToList();
                                    @foreach (var item in itemsActivos)
                                    {
                                        <tr>
                                            <td style="border: 1px solid #000; padding: 5px; text-align: center; font-size: 10px;">@item.NuOrdItem</td>
                                            <td style="border: 1px solid #000; padding: 5px; font-size: 10px;">
                                                <strong>@item.CodExte</strong><br>
                                                @item.Descritem
                                            </td>
                                            <td style="border: 1px solid #000; padding: 5px; text-align: center; font-size: 10px;">@item.UniMas</td>
                                            <td style="border: 1px solid #000; padding: 5px; text-align: right; font-size: 10px;">@((item.CantOcom ?? 0).ToString("N1"))</td>
                                            <td style="border: 1px solid #000; padding: 5px; text-align: right; font-size: 10px;">@((item.PreUnit ?? 0).ToString("N2"))</td>
                                            <td style="border: 1px solid #000; padding: 5px; text-align: right; font-size: 10px;">@((item.INetItem ?? 0).ToString("N2"))</td>
                                            <td style="border: 1px solid #000; padding: 5px; text-align: center; font-size: 10px;">@(item.FentreSol?.ToString("dd/MM/yy") ?? "")</td>
                                        </tr>
                                    }
                                    
                                    <!-- Filas vacías para llenar la página A4 -->
                                    @for (int i = itemsActivos.Count; i < Math.Min(itemsActivos.Count + 15, 18); i++)
                                    {
                                        <tr>
                                            <td style="border: 1px solid #000; padding: 10px; font-size: 10px;">&nbsp;</td>
                                            <td style="border: 1px solid #000; padding: 10px; font-size: 10px;">&nbsp;</td>
                                            <td style="border: 1px solid #000; padding: 10px; font-size: 10px;">&nbsp;</td>
                                            <td style="border: 1px solid #000; padding: 10px; font-size: 10px;">&nbsp;</td>
                                            <td style="border: 1px solid #000; padding: 10px; font-size: 10px;">&nbsp;</td>
                                            <td style="border: 1px solid #000; padding: 10px; font-size: 10px;">&nbsp;</td>
                                            <td style="border: 1px solid #000; padding: 10px; font-size: 10px;">&nbsp;</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                        <!-- Pie con totales y observaciones -->
                        <div style="display: flex; margin-bottom: 0; page-break-inside: avoid;">
                            <!-- Columna de Observaciones (58%) - Alineada con Item+Código+UM+Cantidad -->
                            <div style="width: 58%; padding-right: 0;">
                                <div style="border: 1px solid #000; height: 140px; display: flex; flex-direction: column;">
                                    <div style="background: #f0f0f0; padding: 6px; border-bottom: 1px solid #000; font-size: 11px;">
                                        <strong>OBS:</strong>
                                    </div>
                                    <div style="padding: 10px; font-size: 10px; flex-grow: 1;">
                                        @(OrdenCompra.ObseOcom ?? "")
                                    </div>
                                    <div style="padding: 8px; font-size: 10px; border-top: 1px solid #000;">
                                        <strong>Todos los importes están Expresados en @DescripcionMoneda</strong><br>
                                        <strong>Mencionar en facturas y remitos el número de Nota de Pedido</strong>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Columna de Totales (30%) - Alineada con Precio + Importe -->
                            <div style="width: 30%; padding-left: 0; padding-right: 0;">
                                <table style="width: 100%; border-collapse: collapse; height: 140px; table-layout: fixed;">
                                    <colgroup>
                                        <col style="width: 40%;">  <!-- Alineada con columna Precio (12%) -->
                                        <col style="width: 60%;">  <!-- Alineada con columna Importe (12%) -->
                                    </colgroup>
                                    <tr>
                                        <td style="border: 1px solid #000; border-left: none; padding: 6px 8px; background: #f0f0f0; font-size: 11px; text-align: left;"><strong>SUBTOTAL</strong></td>
                                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; font-size: 11px;">@((OrdenCompra.TotalOcom ?? 0).ToString("N2"))</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #000; border-left: none; padding: 6px 8px; background: #f0f0f0; font-size: 11px; text-align: left;"><strong>DESC.</strong></td>
                                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; font-size: 11px;">0.00</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #000; border-left: none; padding: 6px 8px; background: #f0f0f0; font-size: 11px; text-align: left;"><strong>NETO</strong></td>
                                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; font-size: 11px;">@((OrdenCompra.TotalOcom ?? 0).ToString("N2"))</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #000; border-left: none; padding: 6px 8px; background: #f0f0f0; font-size: 11px; text-align: left;"><strong>IVA</strong></td>
                                        <td style="border: 1px solid #000; padding: 6px 8px; text-align: right; font-size: 11px;">%</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #000; border-left: none; padding: 8px; background: #f0f0f0; font-size: 12px; text-align: left;"><strong>TOTAL</strong></td>
                                        <td style="border: 1px solid #000; padding: 8px; text-align: right; font-size: 12px; font-weight: bold;">@((OrdenCompra.TotalOcom ?? 0).ToString("N2"))</td>
                                    </tr>
                                </table>
                            </div>
                            
                            <!-- Columna de Numeración (12%) - Alineada con F. Entrega -->
                            <div style="width: 12%; padding-left: 0;">
                                <div style="border: 1px solid #000; border-left: none; height: 140px; display: flex; flex-direction: column;">
                                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; border-bottom: 1px solid #000; padding: 5px;">
                                        <strong style="font-size: 9px; margin-bottom: 3px;">Hoja N°</strong>
                                        <span style="font-size: 16px; font-weight: bold;">1</span>
                                    </div>
                                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 5px;">
                                        <strong style="font-size: 9px; margin-bottom: 3px;">De:</strong>
                                        <span style="font-size: 16px; font-weight: bold;">1</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="ImprimirDocumento">
                        <i class="fas fa-print"></i> Imprimir
                    </button>
                    <button type="button" class="btn btn-success" @onclick="EnviarPorMail">
                        <i class="fas fa-envelope"></i> Enviar por Mail
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        <i class="fas fa-times"></i> Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Modal para envío de mail *@
<div class="modal fade @(mostrarModalEmail ? "show" : "")" tabindex="-1" style="display: @(mostrarModalEmail ? "block" : "none")" aria-hidden="@(!mostrarModalEmail)">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enviar Orden de Compra por Email</h5>
                <button type="button" class="btn-close" @onclick="CerrarModalEmail"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Proveedor:</label>
                    <input type="text" class="form-control" value="@OrdenCompra?.RaSoProv" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email:</label>
                    <input type="email" class="form-control" @bind="emailProveedor" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModalEmail">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="EnviarEmail">Enviar</button>
            </div>
        </div>
    </div>
</div>

@if (mostrarModalEmail)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private class PdfResponse
    {
        public string? Base64Content { get; set; }
    }

    [Parameter] public bool MostrarModal { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
    [Parameter] public Ocomenca? OrdenCompra { get; set; }
    [Parameter] public List<Ocomdeta>? DetalleItems { get; set; }

    private Empresa? DatosEmpresa;
    private bool mostrarModalEmail = false;
    private string emailProveedor = "";
    private string DescripcionMoneda => OrdenCompra?.MoneEmis switch
    {
        1 => "Pesos",
        2 => "Dólares",
        3 => "Euros",
        _ => "Pesos"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (MostrarModal && DatosEmpresa == null)
        {
            await CargarDatosEmpresa();
        }
    }

    private async Task CargarDatosEmpresa()
    {
        try
        {
            // Cargar datos de la empresa activa
            var response = await repository.Get<List<Empresa>>("api/empresas/combo");
            if (!response.Error && response.Response?.Any() == true)
            {
                DatosEmpresa = response.Response.FirstOrDefault(e => e.status == 1) ?? response.Response.First();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos de empresa: {ex.Message}");
        }
    }

    private async Task ImprimirDocumento()
    {
        try
        {
            // Función JavaScript personalizada para impresión
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    // Obtener el contenido a imprimir
                    var contenido = document.getElementById('contenido-impresion');
                    
                    if (contenido) {
                        // Clonar el contenido para no afectar la vista previa
                        var contenidoClonado = contenido.cloneNode(true);
                        
                        // Crear el HTML completo para impresión
                        var htmlContent = `
                            <!DOCTYPE html>
                            <html>
                            <head>
                                <meta charset='utf-8'>
                                <title>Orden de Compra</title>
                                <style>
                                    * {
                                        box-sizing: border-box;
                                        -webkit-print-color-adjust: exact;
                                        print-color-adjust: exact;
                                    }
                                    
                                    html, body { 
                                        width: 100%;
                                        height: 100%;
                                        margin: 0;
                                        padding: 0;
                                    }
                                    
                                    body { 
                                        font-family: Arial, sans-serif; 
                                        font-size: 12px; 
                                        padding: 15px;
                                        background: white;
                                        color: black !important;
                                        line-height: 1.3;
                                    }
                                    
                                    @page { 
                                        margin: 0.8cm; 
                                        size: A4 portrait; 
                                    }
                                    
                                    @media print {
                                        body {
                                            width: 100%;
                                            margin: 0;
                                            padding: 15px;
                                        }
                                    }
                                    
                                    table { 
                                        border-collapse: collapse !important; 
                                        width: 100% !important; 
                                        margin-bottom: 12px !important;
                                        border: 1px solid #000 !important;
                                        page-break-inside: auto !important;
                                    }
                                    
                                    td, th { 
                                        border: 1px solid #000 !important; 
                                        padding: 5px 8px !important;
                                        font-size: 11px !important;
                                        vertical-align: top !important;
                                        color: black !important;
                                    }
                                    
                                    .row {
                                        display: flex !important;
                                        flex-wrap: nowrap !important;
                                        margin-bottom: 12px !important;
                                        align-items: stretch !important;
                                        page-break-inside: avoid !important;
                                    }
                                    
                                    .col-8, .col-4 {
                                        flex: 0 0 auto !important;
                                        padding: 0 !important;
                                        margin: 0 !important;
                                    }
                                    
                                    .col-8 { 
                                        width: 66.666667% !important; 
                                        padding-right: 5px !important;
                                    }
                                    
                                    .col-4 { 
                                        width: 33.333333% !important; 
                                        padding-left: 5px !important;
                                    }
                                    
                                    h4, h5 {
                                        margin: 8px 0 !important;
                                        font-size: 14px !important;
                                        color: black !important;
                                    }
                                    
                                    p {
                                        margin: 4px 0 !important;
                                        font-size: 11px !important;
                                        color: black !important;
                                    }
                                    
                                    strong {
                                        color: black !important;
                                    }
                                    
                                    /* Evitar saltos en secciones críticas */
                                    .encabezado-empresa,
                                    .datos-proveedor {
                                        page-break-inside: avoid !important;
                                        page-break-after: avoid !important;
                                    }
                                    
                                    .tabla-items {
                                        page-break-before: avoid !important;
                                    }
                                    
                                    .tabla-items tbody tr {
                                        page-break-inside: avoid !important;
                                    }
                                </style>
                            </head>
                            <body>
                                ` + contenidoClonado.outerHTML + `
                            </body>
                            </html>
                        `;
                        
                        // Crear una nueva ventana para impresión
                        var printWindow = window.open('', '_blank', 'width=800,height=600');
                        
                        // Escribir el contenido
                        printWindow.document.open();
                        printWindow.document.write(htmlContent);
                        printWindow.document.close();
                        
                        // Esperar a que se cargue completamente antes de imprimir
                        setTimeout(function() {
                            printWindow.focus();
                            printWindow.print();
                            setTimeout(function() {
                                printWindow.close();
                            }, 100);
                        }, 500);
                    } else {
                        console.error('No se encontró el contenido de impresión');
                        alert('Error: No se pudo encontrar el contenido para imprimir');
                    }
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al imprimir: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Error al intentar imprimir el documento");
        }
    }

    private async Task CerrarModal()
    {
        await OnCerrar.InvokeAsync();
    }

    private void CerrarModalEmail()
    {
        mostrarModalEmail = false;
        emailProveedor = "";
    }

    private void EnviarPorMail()
    {
        // Aquí podrías cargar el email del proveedor desde la base de datos si está disponible
        emailProveedor = ""; // Inicializar vacío o con email del proveedor si existe
        mostrarModalEmail = true;
    }

    private async Task EnviarEmail()
    {
        try
        {
            if (string.IsNullOrEmpty(emailProveedor))
            {
                await sweetAlertService.FireAsync("Error", "Debe ingresar un email válido", SweetAlertIcon.Error);
                return;
            }

            // Obtener la configuración del email
            var configResponse = await repository.Get<EmailConfigDTO>("api/emailconfig");
            if (configResponse.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo obtener la configuración del email", SweetAlertIcon.Error);
                return;
            }

            // Obtener el PDF de la orden de compra
            var pdfResponse = await repository.Get<PdfResponse>($"api/ocomenca/{OrdenCompra.NumeOcom}/pdf");
            if (pdfResponse.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo generar el PDF de la orden de compra", SweetAlertIcon.Error);
                return;
            }

            // Convertir la respuesta a byte array
            byte[] pdfContent;
            if (!string.IsNullOrEmpty(pdfResponse.Response?.Base64Content))
            {
                pdfContent = Convert.FromBase64String(pdfResponse.Response.Base64Content);
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "El formato del PDF recibido no es válido", SweetAlertIcon.Error);
                return;
            }

            // Crear el objeto para enviar el email
            // El backend ahora genera PDF real usando iTextSharp
            var emailTest = new EmailTestDTO
            {
                Config = configResponse.Response,
                AttachmentContent = pdfContent,
                AttachmentName = $"OrdenCompra_{OrdenCompra.NumeOcom}.pdf",
                AttachmentContentType = "application/pdf",
                To = emailProveedor,
                Subject = $"Orden de Compra N° {OrdenCompra.NumeOcom}",
                Body = $@"<h3>Orden de Compra N° {OrdenCompra.NumeOcom}</h3>
                        <p>Estimado proveedor,</p>
                        <p>Adjunto encontrará la orden de compra correspondiente en formato PDF.</p>
                        <p>Saludos cordiales.</p>"
            };

            // Enviar el email
            var response = await repository.Post("api/emailconfig/sendorder", emailTest);
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo enviar el email", SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Éxito", "Email enviado correctamente", SweetAlertIcon.Success);
            CerrarModalEmail();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al enviar el email: {ex.Message}", SweetAlertIcon.Error);
        }
    }
}

<style>
    @@media print {
        /* Ocultar todo excepto el contenido de impresión */
        body * {
            visibility: hidden !important;
        }
        
        /* Mostrar solo el contenido de impresión */
        #contenido-impresion,
        #contenido-impresion * {
            visibility: visible !important;
        }
        
        /* Posicionar el contenido para impresión */
        #contenido-impresion {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            width: 100% !important;
            background: white !important;
            font-size: 12px !important;
            color: black !important;
        }
        
        /* Ocultar elementos del modal */
        .modal,
        .modal-backdrop,
        .modal-header,
        .modal-footer,
        .btn-close {
            display: none !important;
        }
        
        /* Configuración de página */
        @@page {
            margin: 0.5cm;
            size: A4;
        }
        
        /* Asegurar que las tablas se impriman correctamente */
        table {
            page-break-inside: avoid;
            border-collapse: collapse !important;
        }
        
        /* Evitar saltos de página en elementos importantes */
        .row {
            page-break-inside: avoid;
        }
    }
</style>
