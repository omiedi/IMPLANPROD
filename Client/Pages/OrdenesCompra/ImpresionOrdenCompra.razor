    private void EnviarPorMail()
    {
        emailProveedor = "";
        observacionEmail = "";
        mostrarModalEmail = true;
    }

    private async Task EnviarEmail()
    {
        try
        {
            if (string.IsNullOrEmpty(emailProveedor))
            {
                await sweetAlertService.FireAsync("Error", "Debe ingresar un email válido", SweetAlertIcon.Error);
                return;
            }

            // Obtener email y nombre del usuario logueado para Reply-To
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userEmail   = authState.User.FindFirst(ClaimTypes.Email)?.Value;
            var userNombre  = authState.User.FindFirst(ClaimTypes.Name)?.Value;

            // Obtener el PDF de la orden de compra
            var pdfResponse = await repository.Get<PdfResponse>($"api/ocomenca/{OrdenCompra.NumeOcom}/pdf");
            if (pdfResponse.Error)
            {
                await sweetAlertService.FireAsync("Error", "No se pudo generar el PDF de la orden de compra", SweetAlertIcon.Error);
                return;
            }

            byte[] pdfContent;
            if (!string.IsNullOrEmpty(pdfResponse.Response?.Base64Content))
            {
                pdfContent = Convert.FromBase64String(pdfResponse.Response.Base64Content);
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "El formato del PDF recibido no es válido", SweetAlertIcon.Error);
                return;
            }

            var observacionesHtml = string.IsNullOrWhiteSpace(observacionEmail)
                ? ""
                : "<p><strong>Observaciones:</strong><br/>" + observacionEmail.Replace("\r\n", "<br/>").Replace("\n", "<br/>") + "</p>";

            var contactoHtml = string.IsNullOrWhiteSpace(userEmail)
                ? $"<strong>{userNombre ?? "nuestro equipo"}</strong>"
                : $"<strong>{userNombre ?? "nuestro equipo"}</strong> (<a href=\"mailto:{userEmail}\">{userEmail}</a>)";

            var dto = new SendOrdenEmailDto
            {
                To      = emailProveedor,
                Subject = $"Orden de Compra N° {NumeroOrdenConVersion}",
                Body    = "<h3>Orden de Compra N° " + NumeroOrdenConVersion + "</h3>" +
                          "<p>Estimado proveedor,</p>" +
                          "<p>Adjunto encontrará la orden de compra correspondiente en formato PDF.</p>" +
                          observacionesHtml +
                          "<p>Para consultas relacionadas con esta orden, por favor responda este correo " +
                          "o comuníquese directamente con " + contactoHtml + ".</p>" +
                          "<p>Saludos cordiales.</p>",
                AttachmentContent = pdfContent,
                AttachmentName    = $"OrdenCompra_{NumeroOrdenConVersion}.pdf",
                ReplyTo           = userEmail,
                ReplyToName       = userNombre
            };

            var response = await repository.Post("api/email-empresa/sendorder", dto);
            if (response.Error)
            {
                var msg = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Éxito", "Email enviado correctamente", SweetAlertIcon.Success);
            CerrarModalEmail();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al enviar el email: {ex.Message}", SweetAlertIcon.Error);
        }
    }

