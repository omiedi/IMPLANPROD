    /// <summary>
    /// Obtiene TODAS las órdenes de compra que coincidan con los filtros actuales, sin paginación
    /// Utiliza los mismos filtros que LoadAsync pero sin límite de página
    /// </summary>
    private async Task<List<Ocomenca>?> ObtenerTodasLasOrdenesFiltradas()
    {
        try
        {
            // Construir URL con parámetros de filtro idénticos a LoadAsync pero sin paginación
            var url = $"api/ocomenca?page=1&recordsNumber=999999"; // Número muy alto para obtener todos los registros

            // Agregar filtros solo si tienen valores válidos
            if (!string.IsNullOrWhiteSpace(Filter))
            {
                url += $"&filter={Uri.EscapeDataString(Filter)}";
            }

            if (numeroProveedorSeleccionado.HasValue && numeroProveedorSeleccionado > 0)
            {
                url += $"&numeroProveedor={numeroProveedorSeleccionado}";
            }

            if (!string.IsNullOrWhiteSpace(filtroEstado))
            {
                url += $"&filtroEstado={Uri.EscapeDataString(filtroEstado)}";
            }

            if (fechaDesde.HasValue)
            {
                url += $"&fechaDesde={fechaDesde.Value:yyyy-MM-dd}";
            }

            if (fechaHasta.HasValue)
            {
                url += $"&fechaHasta={fechaHasta.Value:yyyy-MM-dd}";
            }

            Console.WriteLine($"Obteniendo todas las órdenes filtradas desde: {url}");

            var responseHttp = await repository.Get<List<Ocomenca>>(url);
            
            if (!responseHttp.Error)
            {
                return responseHttp.Response;
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron obtener las órdenes para impresión", SweetAlertIcon.Error);
                return new List<Ocomenca>();
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al obtener órdenes: {ex.Message}", SweetAlertIcon.Error);
            return new List<Ocomenca>();
        }
    }

    /// <summary>
    /// Confirma la impresión del listado de órdenes de compra respetando filtros activos
    /// Obtiene TODOS los registros que coincidan con los filtros, no solo la página actual
    /// </summary>
    private async Task ConfirmarImpresionAsync()
    {
        isPrinting = true;
        StateHasChanged();

        try
        {
            // Obtener TODAS las órdenes que coincidan con los filtros actuales (sin paginación)
            var ordenesCompletas = await ObtenerTodasLasOrdenesFiltradas();
            int cantidadTotal = ordenesCompletas?.Count ?? 0;

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmar impresión",
                Text = $"Se van a imprimir {cantidadTotal} registros que coinciden con los filtros aplicados (todas las páginas).\n¿Desea continuar?",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, imprimir",
                CancelButtonText = "Cancelar"
            });

            if (result.IsConfirmed)
            {
                // Actualizar la lista de órdenes para impresión con todos los registros
                ordenesCompra = ordenesCompletas;
                mostrarModalImpresion = true;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

