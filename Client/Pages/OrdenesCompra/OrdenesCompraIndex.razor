    private async Task VerTrazabilidadConsignacionesAsync(int numeroOrden)
    {
        if (numeroOrden <= 0)
        {
            await sweetAlertService.FireAsync("Atención", "Número de orden inválido.", SweetAlertIcon.Warning);
            return;
        }

        cargandoTrazabilidadConsignaciones = true;
        numeroOrdenTrazabilidadConsignaciones = numeroOrden;
        StateHasChanged();

        try
        {
            var response = await repository.Get<List<ConsignacionTrazabilidadPadreDto>>($"api/maconsig/trazabilidad-oc/{numeroOrden}");
            if (response.Error)
            {
                var message = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"No se pudo obtener la trazabilidad: {message}", SweetAlertIcon.Error);
                return;
            }

            trazabilidadConsignaciones = response.Response ?? new List<ConsignacionTrazabilidadPadreDto>();
            if (!trazabilidadConsignaciones.Any())
            {
                await sweetAlertService.FireAsync("Sin consignaciones", $"La O.C. {numeroOrden:000000} no tiene consignaciones para trazar.", SweetAlertIcon.Info);
                return;
            }

            mostrarModalTrazabilidadConsignaciones = true;
        }
        finally
        {
            cargandoTrazabilidadConsignaciones = false;
            StateHasChanged();
        }
    }

    private void CerrarModalTrazabilidadConsignaciones()
    {
        mostrarModalTrazabilidadConsignaciones = false;
        numeroOrdenTrazabilidadConsignaciones = 0;
        mostrarSoloSaldoPendiente = false;
        trazabilidadConsignaciones.Clear();
        StateHasChanged();
    }

    private async Task ImprimirOrden(int numeroOrden)
    {
        try
        {
            Console.WriteLine($"🖨️ Iniciando impresión de orden: {numeroOrden}");
            
            // Buscar la orden en la lista actual
            ordenParaImprimir = ordenesCompra?.FirstOrDefault(o => o.NumeOcom == numeroOrden);
            
            if (ordenParaImprimir == null)
            {
                Console.WriteLine($"❌ No se encontró la orden {numeroOrden} en la lista");
                await sweetAlertService.FireAsync("Error", "No se encontró la orden de compra.", SweetAlertIcon.Error);
                return;
            }

            Console.WriteLine($"✅ Orden encontrada: ID={ordenParaImprimir.OCOMENCA_ID}, Num={ordenParaImprimir.NumeOcom}");

            // Cargar el detalle de la orden por número de orden
            var responseDetalle = await repository.Get<List<Ocomdeta>>($"api/ocomdeta/por-orden/{numeroOrden}");
            if (responseDetalle.Error)
            {
                var message = await responseDetalle.GetErrorMessageAsync();
                Console.WriteLine($"❌ Error al cargar detalle: {message}");
                await sweetAlertService.FireAsync("Error", $"Error al cargar detalle de la orden: {message}", SweetAlertIcon.Error);
                return;
            }

            detalleParaImprimir = responseDetalle.Response ?? new List<Ocomdeta>();
            Console.WriteLine($"✅ Detalle cargado: {detalleParaImprimir.Count} items");
            
            mostrarModalImpresionOrden = true;
            Console.WriteLine($"✅ Modal activado: mostrarModalImpresionOrden = {mostrarModalImpresionOrden}");
            
            StateHasChanged();
            Console.WriteLine($"✅ StateHasChanged ejecutado");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error al preparar impresión: {ex.Message}");
            Console.WriteLine($"❌ Stack: {ex.StackTrace}");
            await sweetAlertService.FireAsync("Error", "Error al preparar la impresión.", SweetAlertIcon.Error);
        }
    }

    private async Task AnularOrden(Ocomenca orden)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar Anulación",
            Text = $"¿Está seguro que desea anular la orden de compra N° {orden.NumeOcom}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, Anular",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            orden.StatOcom = 9; // Estado anulado
            var responseHttp = await repository.Put($"api/ocomenca/{orden.NumeOcom}", orden);
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Anulada", "La orden de compra ha sido anulada exitosamente.", SweetAlertIcon.Success);
            await LoadAsync(currentPage);
        }
    }

    private async Task RevertirAnulacionOrden(Ocomenca orden)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar Reversión",
            Text = $"¿Está seguro que desea revertir la anulación de la orden de compra N° {orden.NumeOcom}?\nLa orden volverá al estado 'Activa'.",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, Revertir",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            orden.StatOcom = 0; // Estado activo (revertir anulación)
            var responseHttp = await repository.Put($"api/ocomenca/{orden.NumeOcom}", orden);
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            await sweetAlertService.FireAsync("Revertida", "La anulación ha sido revertida exitosamente. La orden está ahora activa.", SweetAlertIcon.Success);
            await LoadAsync(currentPage);
        }
    }

