@page "/ordenes-compra"
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Shared.Components
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Client.Pages.Reportes
@using System.Text.Json
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@inject IJSRuntime JS
@inject DerechosUsuarioClientService derechosService
@inject PageAccessService PageAccess

<PageTitle>Órdenes de Compra</PageTitle>

@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
<div class="container-fluid">
    <!-- Título de la página -->
    <div class="mb-4">
        <h2 class="text-center fw-bold text-primary">
            <i class="fas fa-shopping-cart me-2"></i>
            ÓRDENES DE COMPRA
        </h2>
        <hr class="border-primary border-2 opacity-50" />
    </div>

    @if (verificandoPermisos)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Verificando permisos...</span>
            </div>
            <p class="mt-3 text-muted">Verificando permisos de acceso...</p>
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-auto d-flex gap-2">
                <button class="btn btn-primary" @onclick="CrearNuevaOrden" disabled="@(!tieneAccesoEscritura)">
                    <i class="fas fa-plus"></i> Nueva Orden
                </button>
                <button class="btn btn-info" @onclick="IrAGraficos" title="Ver gráficos de compras">
                    <i class="fas fa-chart-bar"></i> Gráficos
                </button>
                <div class="dropdown">
                    <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-cogs"></i> Opciones
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item" type="button" @onclick="AbrirModalConfiguracion" disabled="@(!tieneAccesoEscritura)">
                                <i class="fas fa-cogs me-2"></i>Configuración
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" @onclick="IrAGraficos">
                                <i class="fas fa-chart-bar me-2"></i>Gráficos de Compras
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- Filtros de búsqueda -->
    <div class="card mb-3">
        <div class="card-header">
            <h6 class="mb-0">
                <i class="fas fa-filter"></i> Filtros de Búsqueda 
                <small class="text-muted">(Por defecto: últimos 30 días)</small>
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Buscar Proveedor:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" @bind="proveedorSeleccionado" @bind:event="oninput" placeholder="Proveedor seleccionado..." readonly />
                        <button class="btn btn-outline-secondary" @onclick="LimpiarProveedor">
                            <i class="fas fa-times"></i>
                        </button>
                        <button class="btn btn-outline-primary" @onclick="AbrirSelectorProveedores" title="Seleccionar Proveedor">
                            <i class="fas fa-truck"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Buscar:</label>
                    <input type="text" class="form-control" @bind="Filter" @bind:event="oninput" placeholder="N° Orden, Referencia..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Estado:</label>
                    <select class="form-select" @bind="filtroEstado" @bind:event="oninput">
                        <option value="">Todos</option>
                        <option value="0">Activas</option>
                        <option value="-1">Pendientes</option>
                        <option value="9">Anuladas</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha Desde:</label>
                    <input type="date" class="form-control" @bind="fechaDesde" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Fecha Hasta:</label>
                    <input type="date" class="form-control" @bind="fechaHasta" @bind:event="oninput" />
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12 text-end">
                    <button class="btn btn-primary" @onclick="ApplyFilterAsync">
                        <i class="fas fa-filter"></i> Filtrar
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="CleanFilterAsync">
                        <i class="fas fa-eraser"></i> Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Paginación estándar -->
    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />

    <!-- Tabla de órdenes de compra -->
    <div class="card">
        <div class="card-body">
            @if (ordenesCompra == null)
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (!ordenesCompra.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> No se encontraron órdenes de compra.
                </div>
            }
            else
            {
                <!-- Botón de impresión -->
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-outline-success" @onclick="ConfirmarImpresionAsync" disabled="@isPrinting">
                        <i class="oi oi-print"></i> Imprimir/Exp.Excel
                    </button>
                    @if (isPrinting)
                    {
                        <div class="ms-2 d-flex align-items-center">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Preparando impresión...</span>
                            </div>
                        </div>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>N° Orden</th>
                                <th>Fecha Emisión</th>
                                <th>Proveedor</th>
                                <th>Razón Social</th>
                                <th>Referencia</th>
                                <th>Estado</th>
                                <th>Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orden in ordenesCompra)
                            {
                                <tr>
                                    <td><strong>@orden.NumeOcom</strong></td>
                                    <td>@orden.FemiOcom?.ToString("dd/MM/yyyy")</td>
                                    <td>@orden.NproOcom</td>
                                    <td>@orden.RaSoProv</td>
                                    <td>@orden.RefeOcom</td>
                                    <td>
                                        @if (orden.StatOcom == 0)
                                        {
                                            <span class="badge bg-success">Activa</span>
                                        }
                                        else if (orden.StatOcom == -1)
                                        {
                                            <span class="badge bg-warning">Pendiente</span>
                                        }
                                        else if (orden.StatOcom == 9)
                                        {
                                            <span class="badge bg-danger">Anulada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@orden.StatOcom</span>
                                        }
                                    </td>
                                    <td>@orden.TotalOcom?.ToString("C2")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="(() => EditarOrden(orden.OCOMENCA_ID))" title="Editar" disabled="@(!tieneAccesoEscritura)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-info" @onclick="(() => VerDetalle(orden.OCOMENCA_ID))" title="Ver Detalle">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-success" @onclick="(() => ImprimirOrden(orden.NumeOcom ?? 0))" title="Imprimir">
                                                <i class="fas fa-print"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-dark" @onclick="(() => VerTrazabilidadConsignacionesAsync(orden.NumeOcom ?? 0))" title="Trazabilidad Consignaciones" disabled="@(cargandoTrazabilidadConsignaciones || !(orden.NumeOcom.HasValue && orden.NumeOcom.Value > 0))">
                                                <i class="fas fa-project-diagram"></i>
                                            </button>
                                            @if (puedeEditarCostos)
                                            {
                                                <button class="btn btn-sm btn-outline-warning" @onclick="(() => AbrirModalCostos(orden.NumeOcom ?? 0))" title="Editar Costos">
                                                    <i class="fas fa-dollar-sign"></i>
                                                </button>
                                            }
                                            @if (orden.StatOcom == 9)
                                            {
                                                <button class="btn btn-sm btn-outline-warning" @onclick="(() => RevertirAnulacionOrden(orden))" title="Revertir Anulación" disabled="@(!tieneAccesoEscritura)">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="(() => AnularOrden(orden))" title="Anular" disabled="@(!tieneAccesoEscritura)">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Paginación inferior -->
    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />
</div>
    }
}

<!-- Componente de impresión -->
@if (ordenesCompra != null && ordenesCompra.Any())
{
    <ImpresionLista TItem="Ocomenca"
                    Datos="ordenesCompra"
                    Titulo="@TituloReporte"
                    UrlExportarExcel="api/excel/exportar-ordenes-compra"
                    Encabezados="encabezadosOrdenesCompra"
                    ModoDirecto="false"
                    MostrarModal="mostrarModalImpresion"
                    OnCerrar="ResetearImpresion" />
}

<!-- Componente selector de proveedores -->
<SelectorProveedores @ref="selectorProveedores" OnProveedorSeleccionado="OnProveedorSeleccionado" />

@* Modal de configuración de Órdenes de Compra *@
<OrdenesCompraConfigModal IsVisible="@mostrarModalConfiguracion"
                         OnCloseRequested="@CerrarModalConfiguracion"
                         OnConfigurationSaved="@OnConfiguracionGuardada" />

@* Modal de detalle de orden de compra *@
<OrdenCompraDetalleModal IsVisible="@mostrarModalDetalle"
                        OrdenId="@ordenIdSeleccionada"
                        OnCerrar="@CerrarModalDetalle" />

@* Modal de impresión de orden de compra *@
<ImpresionOrdenCompra MostrarModal="@mostrarModalImpresionOrden"
                     OrdenCompra="@ordenParaImprimir"
                     DetalleItems="@detalleParaImprimir"
                     OnCerrar="@CerrarModalImpresionOrden" />

@* Modal de edición de costos *@
<OrdenCompraCostosModal MostrarModal="@mostrarModalCostos"
                       NumeroOrden="@numeroOrdenCostos"
                       OnCerrar="@CerrarModalCostos"
                       OnCostosGuardados="@OnCostosGuardados" />

@if (mostrarModalTrazabilidadConsignaciones)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-project-diagram me-2"></i>
                        Trazabilidad de Consignaciones - O.C. @numeroOrdenTrazabilidadConsignaciones
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalTrazabilidadConsignaciones"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info" role="alert">
                        <strong>Importante:</strong> En esta trazabilidad, el consumo de material consignado se toma en cuenta cuando la recepción está aprobada. Además, para evitar sobreconsumos, la cantidad rendida considerada nunca supera la cantidad entregada.
                    </div>

                    @if (trazabilidadConsignaciones == null || !trazabilidadConsignaciones.Any())
                    {
                        <div class="alert alert-info mb-0">
                            No hay consignaciones para mostrar.
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-end mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkSoloSaldoPendiente" @bind="mostrarSoloSaldoPendiente" />
                                <label class="form-check-label" for="chkSoloSaldoPendiente">
                                    Solo saldo pendiente
                                </label>
                            </div>
                        </div>

                        @foreach (var grupo in trazabilidadConsignaciones)
                        {
                            var detalleMostrar = mostrarSoloSaldoPendiente
                                ? grupo.Detalle.Where(x => x.Saldo > 0.0001m).ToList()
                                : grupo.Detalle;

                            if (!detalleMostrar.Any())
                            {
                                continue;
                            }

                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-md-8">
                                            <strong>Padre:</strong> @grupo.CodigoPadre - @grupo.DescripcionPadre
                                        </div>
                                        <div class="col-md-4 text-md-end">
                                            <span class="badge bg-secondary me-1">Item @grupo.NumeroItem</span>
                                            <span class="badge bg-primary">@grupo.NroOcom</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>N° BR</th>
                                                        <th>Fecha BR</th>
                                                        <th class="text-end">Cantidad Aprobada</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (grupo.Brs != null && grupo.Brs.Any())
                                                    {
                                                        @foreach (var br in grupo.Brs)
                                                        {
                                                            <tr>
                                                                <td>@br.NroBr</td>
                                                                <td>@(br.FechaBr?.ToString("dd/MM/yyyy") ?? string.Empty)</td>
                                                                <td class="text-end">@br.CantidadAprobada.ToString("N4")</td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="3" class="text-center text-muted">Sin BR asociados</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped table-hover mb-0">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>Código</th>
                                                    <th>Descripción</th>
                                                    <th>Unidad</th>
                                                    <th class="text-end">Cant Asig</th>
                                                    <th class="text-end">Cant Entreg</th>
                                                    <th class="text-end">Cant Rendid</th>
                                                    <th class="text-end">Saldo</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in detalleMostrar)
                                                {
                                                    <tr>
                                                        <td>@item.CodExte</td>
                                                        <td>@item.Descripcion</td>
                                                        <td>@item.Unidad</td>
                                                        <td class="text-end">@item.CantAsig.ToString("N4")</td>
                                                        <td class="text-end">@item.CantEntreg.ToString("N4")</td>
                                                        <td class="text-end">@item.CantRendid.ToString("N4")</td>
                                                        <td class="text-end">@item.Saldo.ToString("N4")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot class="table-light">
                                                <tr>
                                                    <th colspan="3" class="text-end">Totales</th>
                                                    <th class="text-end">@detalleMostrar.Sum(x => x.CantAsig).ToString("N4")</th>
                                                    <th class="text-end">@detalleMostrar.Sum(x => x.CantEntreg).ToString("N4")</th>
                                                    <th class="text-end">@detalleMostrar.Sum(x => x.CantRendid).ToString("N4")</th>
                                                    <th class="text-end">@detalleMostrar.Sum(x => x.Saldo).ToString("N4")</th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalTrazabilidadConsignaciones">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Constantes para control de acceso
    private const string COD_APLI = "InCompra";
    private const string DES_APLI = "Ingreso de Orden de Compras";
    private const string COD_APLI_COSTOS = "VerCostos";
    private const string DES_APLI_COSTOS = "Visualizar Precios y Costos";
    private const string COD_APLI_COSTOS_OC = "VerCostosOC";
    private const string DES_APLI_COSTOS_OC = "Ver y Editar Costos de Órdenes de Compra";

    // Datos
    private List<Ocomenca>? ordenesCompra;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalRecords = 0;

    // Filtros
    private string Filter = string.Empty;
    private string filtroEstado = string.Empty;
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string proveedorSeleccionado = string.Empty;
    private int? numeroProveedorSeleccionado;

    // Componentes
    private SelectorProveedores selectorProveedores = null!;

    // Variables para el modal de configuración
    private bool mostrarModalConfiguracion = false;

    // Variables para el modal de detalle
    private bool mostrarModalDetalle = false;
    private int ordenIdSeleccionada = 0;

    // Variables para impresión de listado
    private bool isPrinting = false;
    private bool mostrarModalImpresion = false;
    private string TituloReporte => "Listado de Órdenes de Compra";
    
    // Variables para impresión de orden individual
    private bool mostrarModalImpresionOrden = false;
    private Ocomenca? ordenParaImprimir;
    private List<Ocomdeta>? detalleParaImprimir;

    // Variables de control de acceso
    private bool verificandoPermisos = true;
    private bool tieneAccesoEscritura = false;
    private bool puedeVerCostos = false;
    private bool puedeEditarCostos = false;
    private bool validando = true;

    // Variables para modal de costos
    private bool mostrarModalCostos = false;
    private int numeroOrdenCostos = 0;

    // Variables para trazabilidad de consignaciones
    private bool mostrarModalTrazabilidadConsignaciones = false;
    private bool cargandoTrazabilidadConsignaciones = false;
    private int numeroOrdenTrazabilidadConsignaciones = 0;
    private bool mostrarSoloSaldoPendiente = false;
    private List<ConsignacionTrazabilidadPadreDto> trazabilidadConsignaciones = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Validar que el usuario tenga permiso para acceder a esta página antes de mostrar el contenido
            await PageAccess.RequiereAccesoAsync("/ordenes-compra");
            validando = false;
            
            // Verificar derechos de acceso del usuario
            verificandoPermisos = true;
            
            // Verificar si el usuario tiene acceso de lectura mínimo
            int nivelAcceso = await derechosService.VerificarDerechoAsync(
                COD_APLI,
                DES_APLI,
                mostrarMensaje: true // Mostrar mensaje si no tiene acceso
            );

            // Si no tiene acceso (nivel 0), redirigir al inicio
            if (nivelAcceso == 0)
            {
                Console.WriteLine($"Usuario sin acceso a {COD_APLI}. Redirigiendo...");
                await Task.Delay(2000); // Esperar 2 segundos para que vea el mensaje
                navigationManager.NavigateTo("/");
                return;
            }

            // Determinar si tiene permisos de escritura (nivel 2)
            tieneAccesoEscritura = nivelAcceso >= 2;
            
            Console.WriteLine($"Acceso a {COD_APLI}: Nivel {nivelAcceso} - Escritura: {tieneAccesoEscritura}");
            
            // Verificar si puede ver costos/precios
            var nivelAccesoCostos = await derechosService.VerificarDerechoAsync(
                COD_APLI_COSTOS,
                DES_APLI_COSTOS,
                mostrarMensaje: false
            );
            puedeVerCostos = nivelAccesoCostos >= 1;
            
            Console.WriteLine($"Acceso a {COD_APLI_COSTOS}: Nivel {nivelAccesoCostos} - Puede ver costos: {puedeVerCostos}");
            
            // Verificar si puede editar costos de órdenes de compra (botón $)
            var nivelAccesoCostosOC = await derechosService.VerificarDerechoAsync(
                COD_APLI_COSTOS_OC,
                DES_APLI_COSTOS_OC,
                mostrarMensaje: false
            );
            puedeEditarCostos = nivelAccesoCostosOC >= 2; // Requiere lectura Y escritura
            
            Console.WriteLine($"Acceso a {COD_APLI_COSTOS_OC}: Nivel {nivelAccesoCostosOC} - Puede editar costos: {puedeEditarCostos}");
            
            verificandoPermisos = false;

            // Restaurar filtros guardados o establecer valores por defecto
            await RestaurarFiltros();
            
            // Cargar datos solo si tiene acceso
            await LoadAsync(currentPage);
        }
        catch (Exception ex)
        {
            throw;
        }
    }

    /// <summary>
    /// Guarda los filtros actuales en sessionStorage para mantenerlos al volver de edición
    /// </summary>
    private async Task GuardarFiltros()
    {
        try
        {
            var filtros = new
            {
                Filter,
                filtroEstado,
                fechaDesde = fechaDesde?.ToString("yyyy-MM-dd"),
                fechaHasta = fechaHasta?.ToString("yyyy-MM-dd"),
                proveedorSeleccionado,
                numeroProveedorSeleccionado,
                currentPage
            };
            
            var filtrosJson = JsonSerializer.Serialize(filtros);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "ordenesCompra_filtros", filtrosJson);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar filtros: {ex.Message}");
        }
    }

    /// <summary>
    /// Restaura los filtros guardados en sessionStorage o establece valores por defecto
    /// </summary>
    private async Task RestaurarFiltros()
    {
        try
        {
            fechaHasta ??= DateTime.Today;
            fechaDesde ??= DateTime.Today.AddDays(-30);
            if (currentPage <= 0)
            {
                currentPage = 1;
            }

            var filtrosJson = await JS.InvokeAsync<string>("sessionStorage.getItem", "ordenesCompra_filtros");
            
            if (!string.IsNullOrEmpty(filtrosJson))
            {
                var filtrosGuardados = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(filtrosJson);
                
                if (filtrosGuardados != null)
                {
                    if (filtrosGuardados.ContainsKey("Filter") && filtrosGuardados["Filter"].ValueKind == JsonValueKind.String)
                        Filter = filtrosGuardados["Filter"].GetString() ?? string.Empty;
                    
                    if (filtrosGuardados.ContainsKey("filtroEstado") && filtrosGuardados["filtroEstado"].ValueKind == JsonValueKind.String)
                        filtroEstado = filtrosGuardados["filtroEstado"].GetString() ?? string.Empty;
                    
                    if (filtrosGuardados.ContainsKey("proveedorSeleccionado") && filtrosGuardados["proveedorSeleccionado"].ValueKind == JsonValueKind.String)
                        proveedorSeleccionado = filtrosGuardados["proveedorSeleccionado"].GetString() ?? string.Empty;
                    
                    // Restaurar fechas
                    if (filtrosGuardados.ContainsKey("fechaDesde") && filtrosGuardados["fechaDesde"].ValueKind == JsonValueKind.String)
                    {
                        var fechaStr = filtrosGuardados["fechaDesde"].GetString();
                        if (!string.IsNullOrEmpty(fechaStr))
                            fechaDesde = DateTime.Parse(fechaStr);
                    }
                    else
                    {
                        fechaDesde = DateTime.Today.AddDays(-30);
                    }
                    
                    if (filtrosGuardados.ContainsKey("fechaHasta") && filtrosGuardados["fechaHasta"].ValueKind == JsonValueKind.String)
                    {
                        var fechaStr = filtrosGuardados["fechaHasta"].GetString();
                        if (!string.IsNullOrEmpty(fechaStr))
                            fechaHasta = DateTime.Parse(fechaStr);
                    }
                    else
                    {
                        fechaHasta = DateTime.Today;
                    }
                    
                    // Restaurar proveedor
                    if (filtrosGuardados.ContainsKey("numeroProveedorSeleccionado") && filtrosGuardados["numeroProveedorSeleccionado"].ValueKind == JsonValueKind.Number)
                    {
                        numeroProveedorSeleccionado = filtrosGuardados["numeroProveedorSeleccionado"].GetInt32();
                    }
                    
                    // Restaurar página actual
                    if (filtrosGuardados.ContainsKey("currentPage") && filtrosGuardados["currentPage"].ValueKind == JsonValueKind.Number)
                    {
                        currentPage = filtrosGuardados["currentPage"].GetInt32();
                    }
                    
                    Console.WriteLine("Filtros restaurados desde sessionStorage");
                }
            }
            else
            {
                // Establecer valores por defecto si no hay filtros guardados
                fechaHasta = DateTime.Today;
                fechaDesde = DateTime.Today.AddDays(-30);
                currentPage = 1;
                Console.WriteLine("Filtros por defecto establecidos");
            }

            if (!fechaDesde.HasValue)
            {
                fechaDesde = DateTime.Today.AddDays(-30);
            }

            if (!fechaHasta.HasValue)
            {
                fechaHasta = DateTime.Today;
            }

            if (fechaDesde > fechaHasta)
            {
                var hasta = fechaHasta.Value;
                fechaHasta = fechaDesde;
                fechaDesde = hasta;
            }

            if (currentPage <= 0)
            {
                currentPage = 1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al restaurar filtros: {ex.Message}");
            // Establecer valores por defecto en caso de error
            fechaHasta = DateTime.Today;
            fechaDesde = DateTime.Today.AddDays(-30);
            currentPage = 1;
        }
    }

    private async Task LoadAsync(int page = 1)
    {
        try
        {
            // Construir URL con parámetros de consulta
            var url = $"api/ocomenca?page={page}&recordsNumber=10";

            // Agregar filtros solo si tienen valores válidos
            if (!string.IsNullOrWhiteSpace(Filter))
            {
                url += $"&filter={Uri.EscapeDataString(Filter)}";
            }

            if (numeroProveedorSeleccionado.HasValue && numeroProveedorSeleccionado > 0)
            {
                url += $"&numeroProveedor={numeroProveedorSeleccionado}";
            }

            if (!string.IsNullOrWhiteSpace(filtroEstado))
            {
                url += $"&filtroEstado={Uri.EscapeDataString(filtroEstado)}";
            }

            if (fechaDesde.HasValue)
            {
                url += $"&fechaDesde={fechaDesde.Value:yyyy-MM-dd}";
            }

            if (fechaHasta.HasValue)
            {
                url += $"&fechaHasta={fechaHasta.Value:yyyy-MM-dd}";
            }

            // Log de la URL para debugging
            Console.WriteLine($"Cargando órdenes de compra desde: {url}");

            // Realizar la consulta
            var responseHttp = await repository.Get<List<Ocomenca>>(url);
            
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                Console.WriteLine($"Error en la respuesta HTTP: {message}");
                await sweetAlertService.FireAsync("Error", $"Error al cargar órdenes de compra: {message}", SweetAlertIcon.Error);
                return;
            }

            // Verificar que la respuesta no sea null
            if (responseHttp.Response == null)
            {
                Console.WriteLine("La respuesta del servidor es null");
                await sweetAlertService.FireAsync("Error", "No se recibieron datos del servidor", SweetAlertIcon.Error);
                return;
            }

            ordenesCompra = responseHttp.Response;
            Console.WriteLine($"Se cargaron {ordenesCompra.Count} órdenes de compra");

            // Cargar total de páginas
            await LoadTotalPagesAsync();
        }
        catch (HttpRequestException httpEx)
        {
            Console.WriteLine($"Error de conexión HTTP: {httpEx.Message}");
            await sweetAlertService.FireAsync("Error de Conexión", 
                "No se pudo conectar con el servidor. Verifique su conexión.", 
                SweetAlertIcon.Error);
        }
        catch (TaskCanceledException tcEx)
        {
            Console.WriteLine($"Timeout en la consulta: {tcEx.Message}");
            await sweetAlertService.FireAsync("Timeout", 
                "La consulta tardó demasiado tiempo. Intente nuevamente.", 
                SweetAlertIcon.Warning);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inesperado: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            await sweetAlertService.FireAsync("Error", 
                $"Error inesperado: {ex.Message}", 
                SweetAlertIcon.Error);
        }
    }

    private async Task LoadTotalPagesAsync()
    {
        try
        {
            var url = $"api/ocomenca/totalPages?recordsNumber=10";

            // Aplicar los mismos filtros que en LoadAsync
            if (!string.IsNullOrWhiteSpace(Filter))
            {
                url += $"&filter={Uri.EscapeDataString(Filter)}";
            }

            if (numeroProveedorSeleccionado.HasValue && numeroProveedorSeleccionado > 0)
            {
                url += $"&numeroProveedor={numeroProveedorSeleccionado}";
            }

            if (!string.IsNullOrWhiteSpace(filtroEstado))
            {
                url += $"&filtroEstado={Uri.EscapeDataString(filtroEstado)}";
            }

            if (fechaDesde.HasValue)
            {
                url += $"&fechaDesde={fechaDesde.Value:yyyy-MM-dd}";
            }

            if (fechaHasta.HasValue)
            {
                url += $"&fechaHasta={fechaHasta.Value:yyyy-MM-dd}";
            }

            Console.WriteLine($"Cargando total de páginas desde: {url}");

            var responseHttp = await repository.Get<int>(url);
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                Console.WriteLine($"Error al obtener total de páginas: {message}");
                totalPages = 1; // Valor por defecto
                return;
            }

            totalPages = responseHttp.Response;
            Console.WriteLine($"Total de páginas: {totalPages}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en LoadTotalPagesAsync: {ex.Message}");
            totalPages = 1; // Valor por defecto en caso de error
        }
    }

