@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Pages.Reportes
@using System.Globalization
@inject IRepository repository
@inject SweetAlertService sweetAlertService

@if (MostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <!-- Header del Modal -->
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-dollar-sign"></i>
                        Costos de Orden de Compra N° @NumeroOrden
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>

                <!-- Body del Modal -->
                <div class="modal-body">
                    @if (cargando)
                    {
                        <div class="text-center p-4">
                            <div class="spinner-border text-success" role="status">
                                <span class="visually-hidden">Cargando costos...</span>
                            </div>
                            <p class="mt-2">Cargando costos de la orden...</p>
                        </div>
                    }
                    else if (costos != null && costos.Any())
                    {
                        <!-- Información de la moneda -->
                        <div class="alert alert-info mb-3">
                            <i class="fas fa-info-circle"></i>
                            <strong>Moneda:</strong> @(costos.FirstOrDefault()?.DescripcionMoneda ?? "N/D")
                        </div>

                        @* Descuento global: un solo % para toda la orden; se aplica a cada
                           ítem como Neto = Costo Bruto × (1 − %/100). El usuario puede
                           tipear punto o coma; en pantalla siempre se muestra con coma. *@
                        <div class="d-flex align-items-center mb-3">
                            <div class="input-group input-group-sm" style="width: 9cm; min-width: 9cm;">
                                <span class="input-group-text"><i class="fas fa-percent"></i>&nbsp;Descuento</span>
                                <input type="text" inputmode="decimal"
                                       class="form-control text-end fw-bold"
                                       value="@porcDescGlobalTexto"
                                       @oninput="OnPorcDescGlobalInput"
                                       @onblur="NormalizarPorcDescGlobal" />
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted ms-2">Se aplica a todos los ítems. Neto = Costo × (1 − %/100)</small>
                        </div>

                        <!-- Tabla de costos editable -->
                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-hover">
                                <thead class="table-success">
                                    <tr>
                                        <th style="width: 5%;">Item</th>
                                        <th style="width: 13%;">Código</th>
                                        <th style="width: 24%;">Descripción</th>
                                        <th style="width: 7%;" class="text-center">UM</th>
                                        <th style="width: 9%;" class="text-end">Cantidad</th>
                                        <th style="width: 11%;" class="text-end">Costo Bruto</th>
                                        <th style="width: 11%;" class="text-end">Neto</th>
                                        <th style="width: 11%;" class="text-end">Importe</th>
                                        <th style="width: 9%;" class="text-center">F. Entrega</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in costos)
                                    {
                                        <tr>
                                            <td>@item.NuOrdItem</td>
                                            <td>@item.CodExte</td>
                                            <td>@item.Descritem</td>
                                            <td class="text-center">@item.UniCom</td>
                                            <td class="text-end">@item.CantOcom?.ToString("N2")</td>
                                            <td class="text-end">
                                                <!-- Campo editable de costo bruto (precio de lista).
                                                     El neto = bruto × (1 − %desc/100) se recalcula solo. -->
                                                <input type="number"
                                                       class="form-control form-control-sm text-end input-number-sin-flechas"
                                                       step="0.0001"
                                                       min="0"
                                                       @bind="item.PreBruto"
                                                       @bind:event="oninput"
                                                       placeholder="0.0000"
                                                       style="font-weight: bold; background-color: #ffffcc;" />
                                            </td>
                                            <td class="text-end">@item.NetoCalculado.ToString("N4")</td>
                                            <td class="text-end">
                                                <strong>@item.Importe?.ToString("C2")</strong>
                                            </td>
                                            <td class="text-center">@item.FentreSol?.ToString("dd/MM/yy")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="7" class="text-end"><strong>SUBTOTAL:</strong></td>
                                        <td class="text-end"><strong>@SubtotalGeneral.ToString("C2")</strong></td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-end">
                                            <strong>DESCUENTO @porcDescGlobal.ToString("0.##")%:</strong>
                                        </td>
                                        <td class="text-end">
                                            <strong style="color: #dc3545;">@ImporteDescuento.ToString("C2")</strong>
                                        </td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td colspan="7" class="text-end"><strong>TOTAL:</strong></td>
                                        <td class="text-end">
                                            <strong style="font-size: 1.1em; color: #198754;">
                                                @TotalGeneral.ToString("C2")
                                            </strong>
                                        </td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Campo de Observaciones para impresión de O.C. con costos -->
                        <div class="card mt-3">
                            <div class="card-header bg-info text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-file-alt me-2"></i>
                                    Observaciones que se presentan en la impresión de la orden de compra con costos
                                </h6>
                            </div>
                            <div class="card-body">
                                <textarea class="form-control"
                                          rows="3"
                                          maxlength="1024"
                                          @bind="observacionesImpresion"
                                          placeholder="Ingrese observaciones para impresión (opcional, máximo 1024 caracteres)..."></textarea>
                                <small class="text-muted">
                                    <i class="fas fa-info-circle"></i>
                                    Se guarda en OCOMDETACosto.Observaciones.
                                </small>
                            </div>
                        </div>

                        <!-- Campo de Observación del cambio de precio (se mantiene igual) -->
                        @if (mostrarObservacion)
                        {
                            <div class="card mt-3">
                                <div class="card-header bg-warning text-dark">
                                    <h6 class="mb-0">
                                        <i class="fas fa-comment-alt me-2"></i>
                                        Observación del Cambio de Precio
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <textarea class="form-control" 
                                              rows="3" 
                                              maxlength="512"
                                              @bind="observacion"
                                              placeholder="Ingrese una observación sobre el cambio de precio (opcional, máximo 512 caracteres)..."></textarea>
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle"></i>
                                        Esta observación se registrará en el historial de cambios de precios (NOVEDADES).
                                    </small>
                                </div>
                            </div>
                        }

                        <!-- Ayuda -->
                        <div class="alert alert-warning mt-3">
                            <i class="fas fa-lightbulb"></i>
                            <strong>Ayuda:</strong> Los campos de costo (fondo amarillo) son editables. 
                            El importe se calcula automáticamente como Cantidad × Costo.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            No se encontraron items activos en esta orden de compra.
                        </div>
                    }
                </div>

                <!-- Footer del Modal -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                        <i class="fas fa-times"></i> Cancelar
                    </button>
                    <button type="button" 
                            class="btn btn-info" 
                            @onclick="ImprimirOrden"
                            disabled="@(costos == null || !costos.Any())">
                        <i class="fas fa-print me-2"></i>
                        Imprimir
                    </button>
                    <button type="button" 
                            class="btn btn-success" 
                            @onclick="GuardarCostos"
                            disabled="@(guardando || costos == null || !costos.Any())">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="fas fa-save me-2"></i>
                        }
                        Guardar Costos
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool MostrarModal { get; set; }
    [Parameter] public int NumeroOrden { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }
    [Parameter] public EventCallback OnCostosGuardados { get; set; }

    private List<OCOMDETACostoDto>? costos;
    private bool cargando = false;
    private bool guardando = false;
    
    // Variables para el modal de impresión
    private bool mostrarModalImpresion = false;
    private Ocomenca? ordenParaImprimir;
    private List<Ocomdeta>? detalleParaImprimir;

    // Variables para observación y configuración
    private string observacionesImpresion = string.Empty;
    private string observacion = string.Empty;
    private bool mostrarObservacion = false;
    private string configuracionACOSREP = "NUNCA";

    // ===================================================================
    // Descuento global (%): el usuario lo ingresa una sola vez y se aplica
    // a todos los ítems. Se persiste por fila en OCOMDETACosto.Porc_Desc.
    // Se tipea con punto o coma; en pantalla siempre se muestra con coma.
    // ===================================================================
    private decimal porcDescGlobal = 0m;
    private string porcDescGlobalTexto = "0";
    private static readonly CultureInfo CulturaComaDecimal = CultureInfo.GetCultureInfo("es-AR");

    /// <summary>
    /// Total general calculado sumando todos los importes (con descuento aplicado)
    /// </summary>
    private decimal TotalGeneral => costos?.Sum(c => c.Importe ?? 0) ?? 0;

    /// <summary>
    /// Subtotal sin descuento: suma de Cantidad × Costo Bruto
    /// </summary>
    private decimal SubtotalGeneral =>
        costos?.Sum(c => (c.CantOcom ?? 0) * (c.PreBruto ?? c.PrUnNeto ?? 0)) ?? 0;

    /// <summary>
    /// Importe de descuento = Subtotal (bruto) − Total (neto)
    /// </summary>
    private decimal ImporteDescuento => SubtotalGeneral - TotalGeneral;

    protected override async Task OnParametersSetAsync()
    {
        if (MostrarModal && NumeroOrden > 0 && costos == null)
        {
            // Limpiar observación al cargar nueva orden
            observacionesImpresion = string.Empty;
            observacion = string.Empty;
            await CargarCostosAsync();
        }
    }

    /// <summary>
    /// Carga los costos de la orden desde el servidor
    /// Combina datos de OCOMDETA con OCOMDETACosto
    /// También carga la configuración ACOSREP para determinar si se muestra el campo de observación
    /// </summary>
    private async Task CargarCostosAsync()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            // Cargar costos de la orden
            var url = $"api/OCOMDETACosto/orden/{NumeroOrden}";
            var response = await repository.Get<List<OCOMDETACostoDto>>(url);

            if (!response.Error)
            {
                costos = response.Response;

                // El descuento es global: todas las filas guardadas llevan el mismo %,
                // por lo que al reabrir se toma el % de la primera fila que lo tenga.
                porcDescGlobal = costos?
                    .Select(c => c.PorcDesc)
                    .FirstOrDefault(p => p.HasValue && p.Value > 0m) ?? 0m;
                porcDescGlobalTexto = porcDescGlobal.ToString("0.####", CulturaComaDecimal);

                observacionesImpresion = costos?
                    .Select(c => c.Observaciones)
                    .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                    ?? string.Empty;
                Console.WriteLine($"Costos cargados: {costos?.Count ?? 0} items");
            }
            else
            {
                var mensaje = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar costos: {mensaje}", SweetAlertIcon.Error);
                costos = new List<OCOMDETACostoDto>();
            }

            // Cargar configuración ACOSREP para determinar si se muestra observación
            await CargarConfiguracionACOSREP();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar costos: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error inesperado: {ex.Message}", SweetAlertIcon.Error);
            costos = new List<OCOMDETACostoDto>();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Carga la configuración ACOSREP desde CONTROL
    /// Si es diferente de "NUNCA", se muestra el campo de observación
    /// </summary>
    private async Task CargarConfiguracionACOSREP()
    {
        try
        {
            var urlConfig = "api/Control/OCOMPRA/ACOSREP";
            var responseConfig = await repository.Get<string>(urlConfig);

            if (!responseConfig.Error && !string.IsNullOrEmpty(responseConfig.Response))
            {
                configuracionACOSREP = responseConfig.Response.ToUpper();
                // Mostrar observación si NO es "NUNCA"
                mostrarObservacion = configuracionACOSREP != "NUNCA";
                Console.WriteLine($"Configuración ACOSREP: {configuracionACOSREP}, Mostrar observación: {mostrarObservacion}");
            }
            else
            {
                // Por defecto, si no se puede cargar, asumimos "SIEMPRE"
                configuracionACOSREP = "SIEMPRE";
                mostrarObservacion = true;
                Console.WriteLine("No se pudo cargar ACOSREP, usando valor por defecto: SIEMPRE");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar configuración ACOSREP: {ex.Message}");
            // Por defecto, mostrar observación
            configuracionACOSREP = "SIEMPRE";
            mostrarObservacion = true;
        }
    }

    /// <summary>
    /// Guarda todos los costos editados en el servidor
    /// Si la configuración ACOSREP es diferente de "NUNCA", también registra en NOVEDADES
    /// </summary>
    private async Task GuardarCostos()
    {
        if (costos == null || !costos.Any())
        {
            return;
        }

        guardando = true;
        StateHasChanged();

        try
        {
            var observacionNormalizada = string.IsNullOrWhiteSpace(observacionesImpresion)
                ? null
                : observacionesImpresion.Trim();

            foreach (var costo in costos)
            {
                costo.Observaciones = observacionNormalizada;
                // El % global se persiste en cada fila y el neto se guarda
                // ya calculado (Pre_Bruto × (1 − %/100)) — NOVEDADES usa
                // PrUn_Neto, por lo que registra siempre el precio neto.
                costo.PorcDesc = porcDescGlobal;
                costo.PrUnNeto = costo.NetoCalculado;
            }

            // Determinar qué endpoint usar según la configuración ACOSREP
            string url;
            object datosAEnviar;

            if (mostrarObservacion && configuracionACOSREP != "NUNCA")
            {
                // Usar endpoint que registra en NOVEDADES
                url = "api/OCOMDETACosto/batch-con-novedades";
                datosAEnviar = new GuardarCostosConNovedadesDto
                {
                    Costos = costos,
                    Observacion = observacion,
                    ConfiguracionACOSREP = configuracionACOSREP
                };
            }
            else
            {
                // Usar endpoint normal sin NOVEDADES
                url = "api/OCOMDETACosto/batch";
                datosAEnviar = costos;
            }

            // Guardar costos
            var response = await repository.Post<object, List<OCOMDETACostoDto>>(url, datosAEnviar);

            if (!response.Error)
            {
                var mensaje = mostrarObservacion && configuracionACOSREP != "NUNCA"
                    ? $"Se guardaron {costos.Count} costos y se registraron los cambios en el historial de precios"
                    : $"Se guardaron {costos.Count} costos correctamente";

                await sweetAlertService.FireAsync("Éxito", mensaje, SweetAlertIcon.Success);

                // Notificar que se guardaron los costos
                await OnCostosGuardados.InvokeAsync();

                // Cerrar el modal
                await CerrarModal();
            }
            else
            {
                var mensajeError = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al guardar costos: {mensajeError}", SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar costos: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error inesperado: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Cierra el modal y limpia los datos
    /// </summary>
    /// <summary>
    /// Al tipear el % global: reemplaza '.' por ',' y, si es un porcentaje
    /// válido (0-100), lo aplica a todos los ítems en tiempo real.
    /// </summary>
    private void OnPorcDescGlobalInput(ChangeEventArgs e)
    {
        var texto = (e.Value?.ToString() ?? string.Empty).Replace('.', ',');
        porcDescGlobalTexto = texto;
        if (decimal.TryParse(texto, NumberStyles.Number, CulturaComaDecimal, out var pct)
            && pct >= 0m && pct <= 100m)
        {
            AplicarPorcDescGlobal(pct);
        }
    }

    /// <summary>
    /// Al salir del campo: sanea el texto, fija el % final (vacío = 0,
    /// fuera de rango se clampea a 0-100) y lo reaplica a los ítems.
    /// </summary>
    private void NormalizarPorcDescGlobal(FocusEventArgs e)
    {
        var limpio = new string(porcDescGlobalTexto.Where(c => char.IsDigit(c) || c == ',').ToArray());
        var idx = limpio.IndexOf(',');
        if (idx >= 0)
        {
            // Deja solo la primera coma como separador decimal
            limpio = limpio[..(idx + 1)] + limpio[(idx + 1)..].Replace(",", "");
        }

        decimal pct;
        if (string.IsNullOrWhiteSpace(limpio))
        {
            pct = 0m;
        }
        else if (!decimal.TryParse(limpio, NumberStyles.Number, CulturaComaDecimal, out pct))
        {
            pct = porcDescGlobal; // texto inválido: restaura el último % válido
        }

        pct = Math.Clamp(pct, 0m, 100m);
        AplicarPorcDescGlobal(pct);
        porcDescGlobalTexto = pct.ToString("0.####", CulturaComaDecimal);
    }

    /// <summary>
    /// Asigna el % de descuento a todas las filas. El neto y el importe se
    /// recalculan solos vía NetoCalculado/Importe del DTO.
    /// </summary>
    private void AplicarPorcDescGlobal(decimal pct)
    {
        porcDescGlobal = pct;
        if (costos == null) return;
        foreach (var item in costos)
        {
            item.PorcDesc = pct;
        }
    }

    private async Task CerrarModal()
    {
        costos = null;
        observacionesImpresion = string.Empty;
        observacion = string.Empty;
        mostrarObservacion = false;
        configuracionACOSREP = "NUNCA";
        porcDescGlobal = 0m;
        porcDescGlobalTexto = "0";
        await OnCerrar.InvokeAsync();
    }

    /// <summary>
    /// Abre el modal de impresión de la orden de compra
    /// Primero pregunta si desea guardar los cambios antes de imprimir
    /// </summary>
    private async Task ImprimirOrden()
    {
        try
        {
            // Preguntar si desea guardar los cambios antes de imprimir
            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "¿Desea Guardar los Cambios realizados?",
                Icon = SweetAlertIcon.Question,
                ShowCancelButton = true,
                ShowDenyButton = true,
                ConfirmButtonText = "Guardar",
                DenyButtonText = "Imprimir",
                CancelButtonText = "Cancelar"
            });

            // Si cancela, no hacer nada
            if (result.Dismiss == DismissReason.Cancel)
            {
                return;
            }

            // Si eligió guardar, guardar primero
            if (result.IsConfirmed)
            {
                await GuardarCostos();
                // Si hubo error al guardar, no continuar con la impresión
                if (costos == null || !costos.Any())
                {
                    return;
                }
            }

            // Cargar encabezado de la orden por número de orden
            var urlEncabezado = $"api/ocomenca/por-numero/{NumeroOrden}";
            var responseEncabezado = await repository.Get<Ocomenca>(urlEncabezado);

            if (responseEncabezado.Error)
            {
                var mensaje = await responseEncabezado.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar orden: {mensaje}", SweetAlertIcon.Error);
                return;
            }

            ordenParaImprimir = responseEncabezado.Response;

            // Cargar detalle de la orden por número de orden
            var urlDetalle = $"api/ocomdeta/por-orden/{NumeroOrden}";
            var responseDetalle = await repository.Get<List<Ocomdeta>>(urlDetalle);

            if (responseDetalle.Error)
            {
                var mensaje = await responseDetalle.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", $"Error al cargar detalle: {mensaje}", SweetAlertIcon.Error);
                return;
            }

            detalleParaImprimir = responseDetalle.Response;

            // Actualizar los precios del detalle con los costos actuales de OCOMDETACosto
            if (detalleParaImprimir != null && costos != null && costos.Any())
            {
                foreach (var item in detalleParaImprimir)
                {
                    // Buscar el costo correspondiente por CodInte y NuOrdItem
                    var costo = costos.FirstOrDefault(c => 
                        c.CodInte == item.CodInte && 
                        c.NuOrdItem == item.NuOrdItem);
                    
                    // El detalle impreso muestra el PRECIO BRUTO (Pre_Bruto) y el
                    // importe = cantidad × bruto. El descuento se muestra aparte
                    // en la fila DESC. de los totales (SUBTOTAL − DESC. = NETO).
                    // Si el ítem no tiene bruto cargado, se muestra su neto.
                    if (costo != null && (costo.PreBruto ?? costo.PrUnNeto).HasValue)
                    {
                        item.PrUnNeto = costo.PreBruto ?? costo.NetoCalculado;

                        // Importe del ítem = cantidad × precio bruto
                        if (item.CantOcom.HasValue)
                        {
                            item.INetItem = item.CantOcom.Value * item.PrUnNeto.Value;
                        }
                    }
                }
            }

            // Abrir modal de impresión
            mostrarModalImpresion = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al preparar impresión: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error inesperado: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Cierra el modal de impresión
    /// </summary>
    private void CerrarModalImpresion()
    {
        mostrarModalImpresion = false;
        ordenParaImprimir = null;
        detalleParaImprimir = null;
        StateHasChanged();
    }
}

@* Modal de impresión de orden de compra *@
<ImpresionOrdenCompra MostrarModal="@mostrarModalImpresion"
                     OrdenCompra="@ordenParaImprimir"
                     DetalleItems="@detalleParaImprimir"
                     ObservacionesCostos="@observacionesImpresion"
                     TotalPersonalizado="@TotalGeneral"
                     PorcentajeDescuento="@porcDescGlobal"
                     ImporteDescuento="@ImporteDescuento"
                     OnCerrar="@CerrarModalImpresion" />

<style>
    .input-number-sin-flechas::-webkit-outer-spin-button,
    .input-number-sin-flechas::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .input-number-sin-flechas {
        -moz-appearance: textfield;
        appearance: textfield;
    }
</style>

