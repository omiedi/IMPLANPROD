    /// <summary>
    /// Guarda la orden completa usando el nuevo endpoint que maneja encabezado + detalle + IVA
    /// </summary>
    private async Task GuardarOrdenCompletaInterno()
    {
        guardando = true;
        StateHasChanged();

        try
        {
            // Actualizar el total de la orden en el encabezado antes de enviar
            ordenCompra.TotalOcom = TotalConDescuento;
            ordenCompra.IdesOcom = descuentoMonto; // Descuento aplicado
            
            Console.WriteLine($"[GuardarOrdenCompleta] TotalNeto: {TotalNeto:C2}");
            Console.WriteLine($"[GuardarOrdenCompleta] DescuentoMonto: {descuentoMonto:C2}");
            Console.WriteLine($"[GuardarOrdenCompleta] TotalConDescuento: {TotalConDescuento:C2}");
            Console.WriteLine($"[GuardarOrdenCompleta] TotalBaseImponible: {TotalBaseImponible:C2}");
            
            // ===== MAPEAR SECTOR Y DESTINO DESDE FRONTEND A CAMPOS BD =====
            // Antes de guardar, mapear los valores de SectorItem y DestinoItem 
            // a los campos reales de la base de datos
            if (detalleItems != null)
            {
                foreach (var item in detalleItems)
                {
                    // Mapear Sector (SectorItem -> SectOcom, máximo 12 caracteres)
                    if (!string.IsNullOrEmpty(item.SectorItem))
                    {
                        // Truncar a 12 caracteres si es necesario
                        item.SectOcom = item.SectorItem.Length > 12 
                            ? item.SectorItem.Substring(0, 12) 
                            : item.SectorItem;
                        
                        Console.WriteLine($"[MapeoSector] Item {item.CodExte}: Sector '{item.SectorItem}' -> SectOcom '{item.SectOcom}'");
                    }
                    
                    // Mapear Destino (DestinoItem -> IContab)
                    if (item.DestinoItem.HasValue && item.DestinoItem.Value > 0)
                    {
                        item.IContab = (short)item.DestinoItem.Value;
                        Console.WriteLine($"[MapeoDestino] Item {item.CodExte}: Destino {item.DestinoItem} -> IContab {item.IContab}");
                    }
                }
            }
            
            // Crear el DTO para la orden completa
            var ordenCompleta = new OrdenCompraCompletaDTO
            {
                Encabezado = ordenCompra,
                Detalle = detalleItems ?? new List<Ocomdeta>(),
                ActualizarIva = false // Por defecto no actualizar IVA
            };

            // Agregar distribución de IVA solo si se ha configurado explícitamente
            if (TotalBaseImponible > 0)
            {
                Console.WriteLine($"[GuardarOrdenCompleta] Distribución IVA:");
                Console.WriteLine($"  - BaseImponible0: {baseImponible0:C2}");
                Console.WriteLine($"  - BaseImponible105: {baseImponible105:C2}");
                Console.WriteLine($"  - BaseImponible21: {baseImponible21:C2}");
                Console.WriteLine($"  - BaseImponible27: {baseImponible27:C2}");
                Console.WriteLine($"  - ImporteIva105: {importeIva105:C2}");
                Console.WriteLine($"  - ImporteIva21: {importeIva21:C2}");
                Console.WriteLine($"  - ImporteIva27: {importeIva27:C2}");
                
                // Activar actualización de IVA y configurar distribución
                ordenCompleta.ActualizarIva = true;
                ordenCompleta.DistribucionIva = new DistribucionIvaDTO
                {
                    BaseImponible0 = baseImponible0,
                    BaseImponible105 = baseImponible105,
                    BaseImponible21 = baseImponible21,
                    BaseImponible27 = baseImponible27,
                    ImporteIva105 = importeIva105,
                    ImporteIva21 = importeIva21,
                    ImporteIva27 = importeIva27
                };
            }
            else
            {
                Console.WriteLine($"[GuardarOrdenCompleta] No se envía distribución IVA (TotalBaseImponible = 0)");
            }

            // Llamar al endpoint del backend
            var responseHttp = await repository.Post<OrdenCompraCompletaDTO, Ocomenca>("/api/ocomenca", ordenCompleta);

            // Manejo simple de errores de autenticación
            if (await authErrorHandler.HandleErrorAsync(responseHttp, "Error al Guardar Orden"))
            {
                return; // El AuthErrorHandlerService ya manejó el error
            }

            // Éxito - mostrar mensaje y redirigir
            await sweetAlertService.FireAsync("Éxito", 
                $"Orden de compra {(IsEdit ? "actualizada" : "creada")} exitosamente con {detalleItems?.Count ?? 0} item(s).", 
                SweetAlertIcon.Success);

            // Redirigir al índice de órdenes de compra
            navigationManager.NavigateTo("/ordenes-compra");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en GuardarOrdenCompletaInterno: {ex.Message}");
            await sweetAlertService.FireAsync("Error", 
                $"Error inesperado: {ex.Message}", 
                SweetAlertIcon.Error);
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Maneja el submit del formulario y decide si usar funcionalidad de IVA
    /// Replica la lógica del código VB6 para grabar en DETAIVA cuando corresponde
    /// </summary>
    private async Task HandleValidSubmit()
    {
        try
        {
            // Validar que se haya seleccionado un proveedor
            if (!await ValidarProveedorSeleccionado())
            {
                return; // La validación ya mostró el mensaje de error
            }

            // VALIDACIÓN OBLIGATORIA: Al menos un item en el detalle
            if (detalleItems == null || !detalleItems.Any())
            {
                await sweetAlertService.FireAsync("Validación", 
                    "Debe agregar al menos un item al detalle de la orden antes de guardar.", 
                    SweetAlertIcon.Warning);
                return;
            }

            // Validar que todos los items tengan datos válidos
            var itemsInvalidos = detalleItems.Where(item => 
                !item.CodInte.HasValue || item.CodInte <= 0 ||
                !item.CantOcom.HasValue || item.CantOcom <= 0 ||
                !item.PreUnit.HasValue || item.PreUnit <= 0 ||
                string.IsNullOrWhiteSpace(item.Descritem)
            ).ToList();

            if (itemsInvalidos.Any())
            {
                await sweetAlertService.FireAsync("Validación", 
                    $"Hay {itemsInvalidos.Count} item(s) con datos incompletos. Verifique que todos los items tengan producto, cantidad, precio y descripción.", 
                    SweetAlertIcon.Warning);
                return;
            }

            // Usar siempre el nuevo método que maneja orden completa
            Console.WriteLine("Guardando orden de compra completa con detalle");
            await GuardarOrdenCompletaInterno();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en HandleValidSubmit: {ex.Message}");
            await sweetAlertService.FireAsync("Error", 
                $"Error inesperado al procesar la orden: {ex.Message}", 
                SweetAlertIcon.Error);
        }
    }

    private async Task Cancelar()
    {
        if (guardando)
        {
            await sweetAlertService.FireAsync("Advertencia", 
                "No se puede cancelar la operación mientras se está guardando la orden.", 
                SweetAlertIcon.Warning);
            return;
        }

        await OnCancel.InvokeAsync();
    }
}
