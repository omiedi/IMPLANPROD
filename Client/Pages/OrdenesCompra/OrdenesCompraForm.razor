    /// <summary>
    /// Carga automáticamente el "Atte. Señor" para el proveedor seleccionado
    /// Primero busca en la última orden de compra (OCOMENCA.AtSr_Ocom)
    /// Si está vacío, busca en la tabla de proveedores (PROVED12.CTAC_CLI)
    /// </summary>
    /// <param name="numeroProveedor">Número del proveedor seleccionado</param>
    private async Task CargarAtteSenorProveedor(int numeroProveedor)
    {
        try
        {
            Console.WriteLine($"[CargarAtteSenorProveedor] 🔍 Buscando Atte. Señor para proveedor: {numeroProveedor}");

            using var httpClient = new HttpClient { BaseAddress = new Uri(navigationManager.BaseUri) };
            
            // Paso 1: Buscar en la última orden de compra del proveedor
            var response1 = await httpClient.GetAsync($"api/ocomenca/ultimo-atte-senor/{numeroProveedor}");
            
            if (response1.IsSuccessStatusCode)
            {
                var atteSenor = await response1.Content.ReadAsStringAsync();
                if (!string.IsNullOrWhiteSpace(atteSenor))
                {
                    // Encontrado en última orden de compra
                    ordenCompra.AtSrOcom = atteSenor;
                    Console.WriteLine($"[CargarAtteSenorProveedor] ✅ Encontrado en última O.C.: '{atteSenor}'");
                    return;
                }
            }

            Console.WriteLine($"[CargarAtteSenorProveedor] ⚠️ No encontrado en últimas órdenes, buscando en PROVED12...");

            // Paso 2: Si no se encontró o está vacío, buscar en PROVED12.CTAC_CLI
            var response2 = await httpClient.GetAsync($"api/proved12/ctac-cli/{numeroProveedor}");
            
            if (response2.IsSuccessStatusCode)
            {
                var ctacCli = await response2.Content.ReadAsStringAsync();
                if (!string.IsNullOrWhiteSpace(ctacCli))
                {
                    // Encontrado en tabla de proveedores
                    ordenCompra.AtSrOcom = ctacCli;
                    Console.WriteLine($"[CargarAtteSenorProveedor] ✅ Encontrado en PROVED12: '{ctacCli}'");
                }
            }
            else
            {
                Console.WriteLine($"[CargarAtteSenorProveedor] ⚠️ No se encontró Atte. Señor para el proveedor {numeroProveedor}");
                // Dejar el campo vacío para que el usuario lo complete manualmente
                ordenCompra.AtSrOcom = string.Empty;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CargarAtteSenorProveedor] ❌ Error al cargar Atte. Señor: {ex.Message}");
            // No mostrar error al usuario ya que es una funcionalidad auxiliar
            // El formulario debe seguir funcionando normalmente aunque falle esta carga
        }
    }

    /// <summary>
    /// Valida el campo "Atte. Señor" y lo carga desde PROVED12.CTAC_CLI si está vacío
    /// Se ejecuta al cargar órdenes existentes para completar campos faltantes
    /// </summary>
    private async Task ValidarYCargarAtteSenor()
    {
        try
        {
            // Solo procesar si hay un proveedor seleccionado y el campo AtSrOcom está vacío
            if (ordenCompra.NproOcom.HasValue && string.IsNullOrWhiteSpace(ordenCompra.AtSrOcom))
            {
                Console.WriteLine($"[ValidarYCargarAtteSenor] 🔍 Campo AtSrOcom vacío, buscando en PROVED12 para proveedor: {ordenCompra.NproOcom}");

                // Buscar directamente en PROVED12.CTAC_CLI (no en órdenes anteriores)
                using var httpClient = new HttpClient { BaseAddress = new Uri(navigationManager.BaseUri) };
                var response = await httpClient.GetAsync($"api/proved12/ctac-cli/{ordenCompra.NproOcom}");
                
                if (response.IsSuccessStatusCode)
                {
                    var ctacCli = await response.Content.ReadAsStringAsync();
                    if (!string.IsNullOrWhiteSpace(ctacCli))
                    {
                        // Encontrado en tabla de proveedores
                        ordenCompra.AtSrOcom = ctacCli;
                        Console.WriteLine($"[ValidarYCargarAtteSenor] ✅ Campo AtSrOcom completado desde PROVED12: '{ctacCli}'");
                    }
                }
                else
                {
                    Console.WriteLine($"[ValidarYCargarAtteSenor] ⚠️ No se encontró CTAC_CLI para el proveedor {ordenCompra.NproOcom}");
                }
            }
            else if (!string.IsNullOrWhiteSpace(ordenCompra.AtSrOcom))
            {
                Console.WriteLine($"[ValidarYCargarAtteSenor] ℹ️ Campo AtSrOcom ya tiene valor: '{ordenCompra.AtSrOcom}'");
            }
            else
            {
                Console.WriteLine($"[ValidarYCargarAtteSenor] ⚠️ No hay proveedor seleccionado para validar AtSrOcom");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ValidarYCargarAtteSenor] ❌ Error al validar Atte. Señor: {ex.Message}");
            // No mostrar error al usuario ya que es una funcionalidad auxiliar
        }
    }

