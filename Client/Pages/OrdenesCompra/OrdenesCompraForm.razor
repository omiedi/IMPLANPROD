    /// <summary>
    /// Acepta la distribución de IVA con validaciones y confirmaciones
    /// </summary>
    private async Task AceptarDistribucionIva()
    {
        var totalGravado = baseImponible105 + baseImponible21 + baseImponible27;
        
        // Verificar si hay exceso en los campos editables
        if (totalGravado > TotalConDescuento)
        {
            var exceso = totalGravado - TotalConDescuento;
            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "¡Advertencia de Exceso!",
                Text = $"Los campos editables suman {totalGravado:C2}, pero solo hay {TotalConDescuento:C2} disponible.\n" +
                       $"Exceso: {exceso:C2}\n\n" +
                       $"El campo Exento/N/Grav quedará en {baseImponible0:C2} (negativo).\n\n" +
                       $"¿Desea continuar de todas formas?",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, continuar",
                CancelButtonText = "No, revisar"
            });

            if (!result.IsConfirmed)
            {
                return; // Usuario canceló
            }
        }

        // Cerrar modal y mostrar confirmación
        mostrarModalIva = false;
        
        if (totalGravado > TotalConDescuento)
        {
            await sweetAlertService.FireAsync("Advertencia", 
                "Distribución de IVA aplicada con advertencia de exceso", 
                SweetAlertIcon.Warning);
        }
        else
        {
            await sweetAlertService.FireAsync("Éxito", 
                "Distribución de IVA aplicada correctamente", 
                SweetAlertIcon.Success);
        }
    }

    /// <summary>
    /// Recalcula la distribución de IVA basado en las bases imponibles editables
    /// </summary>
    private void RecalcularDistribucionIva()
    {
        // Calcular importes de IVA para cada porcentaje
        importeIva105 = baseImponible105 * 0.105m;
        importeIva21 = baseImponible21 * 0.21m;
        importeIva27 = baseImponible27 * 0.27m;
        
        // Calcular ITOGRA(0) como el resto (lógica del VB6)
        var totalGravado = baseImponible105 + baseImponible21 + baseImponible27;
        baseImponible0 = TotalConDescuento - totalGravado;
        
        StateHasChanged();
    }

    /// <summary>
    /// Pone todo el total en el campo seleccionado (funcionalidad de doble clic)
    /// </summary>
    private void PonerTodoEnCampo(int campo)
    {
        // Limpiar todos los campos primero
        LimpiarDistribucion();
        
        // Poner todo el total en el campo seleccionado
        switch (campo)
        {
            case 0: baseImponible0 = TotalConDescuento; break;   // Exento
            case 1: baseImponible105 = TotalConDescuento; break; // 10.5%
            case 2: baseImponible21 = TotalConDescuento; break;  // 21%
            case 3: baseImponible27 = TotalConDescuento; break;  // 27%
        }
        
        RecalcularDistribucionIva();
    }

    /// <summary>
    /// Limpia toda la distribución de IVA
    /// </summary>
    private void LimpiarDistribucion()
    {
        baseImponible0 = 0m;
        baseImponible105 = 0m;
        baseImponible21 = 0m;
        baseImponible27 = 0m;
        importeIva105 = 0m;
        importeIva21 = 0m;
        importeIva27 = 0m;
        StateHasChanged();
    }

    /// <summary>
    /// Actualiza automáticamente la distribución de IVA manteniendo proporciones
    /// cuando cambia el total con descuento
    /// </summary>
    private void ActualizarIvaAutomaticamente()
    {
        // Si no hay distribución previa, no hacer nada
        if (TotalBaseImponible == 0) return;

        // Calcular proporciones actuales
        var totalAnterior = TotalBaseImponible;
        var proporcion0 = totalAnterior > 0 ? baseImponible0 / totalAnterior : 0;
        var proporcion105 = totalAnterior > 0 ? baseImponible105 / totalAnterior : 0;
        var proporcion21 = totalAnterior > 0 ? baseImponible21 / totalAnterior : 0;
        var proporcion27 = totalAnterior > 0 ? baseImponible27 / totalAnterior : 0;

        // Aplicar proporciones al nuevo total
        var nuevoTotal = TotalConDescuento;
        baseImponible0 = Math.Round(nuevoTotal * proporcion0, 2);
        baseImponible105 = Math.Round(nuevoTotal * proporcion105, 2);
        baseImponible21 = Math.Round(nuevoTotal * proporcion21, 2);
        baseImponible27 = Math.Round(nuevoTotal * proporcion27, 2);

        // Ajustar diferencias por redondeo en el campo más grande
        var diferencia = nuevoTotal - (baseImponible0 + baseImponible105 + baseImponible21 + baseImponible27);
        if (diferencia != 0)
        {
            // Buscar el campo con mayor valor para ajustar la diferencia
            if (baseImponible21 >= baseImponible105 && baseImponible21 >= baseImponible27 && baseImponible21 >= baseImponible0)
                baseImponible21 += diferencia;
            else if (baseImponible105 >= baseImponible21 && baseImponible105 >= baseImponible27 && baseImponible105 >= baseImponible0)
                baseImponible105 += diferencia;
            else if (baseImponible27 >= baseImponible105 && baseImponible27 >= baseImponible21 && baseImponible27 >= baseImponible0)
                baseImponible27 += diferencia;
            else
                baseImponible0 += diferencia;
        }

        RecalcularDistribucionIva();
    }

