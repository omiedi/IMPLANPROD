    private async Task EliminarItem(Ocomdeta item)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmar Eliminación",
            Text = $"¿Está seguro que desea eliminar el item {item.CodExte} - {item.Descritem}?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, Eliminar",
            CancelButtonText = "Cancelar"
        });

        if (result.IsConfirmed)
        {
            if (IsEdit && item.OCOMDETA_ID > 0)
            {
                // Para órdenes en edición, eliminar de la base de datos
                var responseHttp = await repository.Delete($"api/ocomdeta/{item.OCOMDETA_ID}");
                if (responseHttp.Error)
                {
                    var message = await responseHttp.GetErrorMessageAsync();
                    await sweetAlertService.FireAsync("Error", $"Error al eliminar item: {message}", SweetAlertIcon.Error);
                    return;
                }
                await CargarDetalle();
            }
            else
            {
                // Para órdenes nuevas, eliminar de la lista local
                if (detalleItems != null)
                {
                    detalleItems.Remove(item);
                    StateHasChanged();
                }
            }

            // Recalcular descuento al cambiar el total neto
            RecalcularDescuentoDesdeTexto();
            await sweetAlertService.FireAsync("Eliminado", "Item eliminado correctamente", SweetAlertIcon.Success);
        }
    }

    private decimal CalcularTotal()
    {
        if (detalleItems == null) return 0;
        return detalleItems.Sum(item => (item.CantOcom ?? 0) * (item.PreUnit ?? 0));
    }

    private void ActualizarTotalOrden()
    {
        ordenCompra.TotalOcom = TotalConDescuento;
    }

    /// <summary>
    /// Interpreta el texto de descuento ingresado en OCOMENCA.PdesOcom y recalcula
    /// descuentoPorcentaje y descuentoMonto sobre el TotalNeto actual.
    /// Reglas:
    /// - Si es vacío o texto no numérico: 0%.
    /// - Si es número (entero/decimal): se toma literal como %.
    /// - Si tiene forma "a + b + c": aplica descuentos sucesivos: base*(1-a%)*(1-b%)*(1-c%).
    /// </summary>
    private void RecalcularDescuentoDesdeTexto()
    {
        try
        {
            var texto = ordenCompra.PdesOcom?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(texto))
            {
                descuentoPorcentaje = 0m;
                descuentoMonto = 0m;
                ActualizarTotalOrden();
                ActualizarIvaAutomaticamente(); // Actualizar IVA al cambiar descuentos
                StateHasChanged();
                return;
            }

            decimal baseNeto = TotalNeto;
            if (baseNeto <= 0m)
            {
                descuentoPorcentaje = 0m;
                descuentoMonto = 0m;
                ActualizarTotalOrden();
                ActualizarIvaAutomaticamente(); // Actualizar IVA al cambiar descuentos
                StateHasChanged();
                return;
            }

            // Caso 1: Número simple (ej: "10" o "15.5")
            if (decimal.TryParse(texto.Replace(",", "."), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out decimal porcSimple))
            {
                if (porcSimple < 0) porcSimple = 0;
                if (porcSimple > 100) porcSimple = 100;
                descuentoPorcentaje = Math.Round(porcSimple, 4);
                descuentoMonto = Math.Round(baseNeto * (descuentoPorcentaje / 100m), 4);
                ActualizarTotalOrden();
                ActualizarIvaAutomaticamente(); // Actualizar IVA al cambiar descuentos
                StateHasChanged();
                return;
            }

            // Caso 2: Descuentos sucesivos (ej: "10 + 5" o "10+20+5")
            if (texto.Contains("+"))
            {
                var partes = texto.Split('+');
                decimal acumulado = baseNeto;
                bool algunaParteValida = false;

                foreach (var parte in partes)
                {
                    var parteTexto = parte.Trim().Replace(",", ".");
                    if (decimal.TryParse(parteTexto, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out decimal porcentajeParte))
                    {
                        if (porcentajeParte >= 0 && porcentajeParte <= 100)
                        {
                            acumulado = acumulado * (1 - (porcentajeParte / 100m));
                            algunaParteValida = true;
                        }
                    }
                }

                if (algunaParteValida)
                {
                    descuentoMonto = Math.Max(0m, baseNeto - acumulado);
                    descuentoPorcentaje = baseNeto == 0m ? 0m : Math.Round((descuentoMonto / baseNeto) * 100m, 4);
                    ActualizarTotalOrden();
                    ActualizarIvaAutomaticamente(); // Actualizar IVA al cambiar descuentos
                    StateHasChanged();
                    return;
                }
            }

            // Si no se pudo interpretar: descuento 0
            descuentoPorcentaje = 0m;
            descuentoMonto = 0m;
            ActualizarTotalOrden();
            ActualizarIvaAutomaticamente(); // Actualizar IVA al cambiar descuentos
            StateHasChanged();
        }
        catch
        {
            // En cualquier error, evitar lanzar excepciones a la UI y dejar descuento en 0
            descuentoPorcentaje = 0m;
            descuentoMonto = 0m;
            ActualizarTotalOrden();
            ActualizarIvaAutomaticamente(); // Actualizar IVA al cambiar descuentos
            StateHasChanged();
        }
    }

