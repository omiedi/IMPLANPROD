    /// <summary>
    /// Valida que se haya seleccionado un proveedor antes de grabar la orden
    /// </summary>
    /// <returns>True si hay proveedor seleccionado, False si no</returns>
    private async Task<bool> ValidarProveedorSeleccionado()
    {
        // Verificar si hay un proveedor seleccionado
        if (!ordenCompra.NproOcom.HasValue || ordenCompra.NproOcom <= 0)
        {
            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Proveedor Requerido",
                Text = "Debe seleccionar un proveedor antes de grabar la orden de compra.\n\n" +
                       "Haga clic en el botón de búsqueda junto al campo 'Proveedor' para seleccionar uno.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "Entendido",
                ConfirmButtonColor = "#f39c12"
            });
            
            Console.WriteLine("Validación fallida: No se ha seleccionado un proveedor");
            return false;
        }

        // Verificar que la información del proveedor esté completa
        if (string.IsNullOrEmpty(ordenCompra.RaSoProv))
        {
            await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Información Incompleta",
                Text = "La información del proveedor está incompleta.\n\n" +
                       "Por favor, seleccione nuevamente el proveedor.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "Entendido",
                ConfirmButtonColor = "#f39c12"
            });
            
            Console.WriteLine("Validación fallida: Información del proveedor incompleta");
            return false;
        }

        Console.WriteLine($"Validación exitosa: Proveedor {ordenCompra.NproOcom} - {ordenCompra.RaSoProv} seleccionado");
