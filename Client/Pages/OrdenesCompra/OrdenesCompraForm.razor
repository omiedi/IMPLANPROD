@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Shared.DTOs
@using IMPLANPROD.Client.Repositories
@using IMPLANPROD.Client.Shared.Components
@using IMPLANPROD.Client.Services
@using System.ComponentModel.DataAnnotations
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager
@inject AuthErrorHandlerService authErrorHandler

<div class="container-fluid">
    <div class="row">
        <!-- Columna principal del formulario - Ancho completo -->
        <div class="col-12">
            <!-- Contenedor principal con marco grueso -->
            <div class="card" style="border: 3px solid #0d6efd; border-radius: 8px;">
                <!-- Header del formulario principal -->
                <div class="card-header" style="background-color: #0d6efd; color: white; border-bottom: 3px solid #0a58ca;">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-shopping-cart"></i>
                        @if (IsEdit)
                        {
                            <span>Editar Orden de Compra N° @ordenCompra.NumeOcom</span>
                        }
                        else
                        {
                            <span>Nueva Orden de Compra</span>
                        }
                    </h5>
                </div>
                
                <!-- Cuerpo del formulario principal -->
                <div class="card-body" style="padding: 1.5rem;">
                    <EditForm Model="ordenCompra" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        <!-- Información del encabezado -->
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label">N° Orden:</label>
                                <InputNumber class="form-control" @bind-Value="ordenCompra.NumeOcom" readonly="@IsEdit" />
                                <ValidationMessage For="@(() => ordenCompra.NumeOcom)" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Fecha Emisión:</label>
                                <InputDate class="form-control" @bind-Value="ordenCompra.FemiOcom" />
                                <ValidationMessage For="@(() => ordenCompra.FemiOcom)" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Destino:</label>
                                <InputSelect class="form-select" @bind-Value="DestinoPorDefectoSeleccionado">
                                    <option value="">Seleccionar...</option>
                                    @if (cuentasDestino != null)
                                    {
                                        @foreach (var cuenta in cuentasDestino)
                                        {
                                            <option value="@cuenta.CodInCue">@cuenta.CodInCue - @cuenta.CodExCue - @cuenta.Denocue</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Sector (por defecto):</label>
                                <InputText class="form-control" @bind-Value="sectorPorDefecto" maxlength="12" placeholder="Máx. 12 caracteres" />
                            </div>
                           @*  <div class="col-md-3">
                                <label class="form-label">Estado:</label>
                                <InputSelect class="form-select" @bind-Value="ordenCompra.StatOcom">
                                    <option value="0">Activa</option>
                                    <option value="-1">Pendiente</option>
                                    <option value="9">Anulada</option>
                                </InputSelect>
                            </div> *@
                        </div>


                        <!-- Información del proveedor -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">
                                    Proveedor: <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <InputText class="@($"form-control {(string.IsNullOrEmpty(proveedorSeleccionado) ? "is-invalid" : "")}")" 
                                               @bind-Value="proveedorSeleccionado" 
                                               placeholder="Seleccionar proveedor..." 
                                               readonly />
                                    <button type="button" class="btn btn-outline-primary" @onclick="AbrirSelectorProveedores">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                                @if (string.IsNullOrEmpty(proveedorSeleccionado))
                                {
                                    <div class="invalid-feedback d-block">
                                        <small>Debe seleccionar un proveedor</small>
                                    </div>
                                }
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Razón Social:</label>
                                <InputText class="form-control" @bind-Value="ordenCompra.RaSoProv" readonly />
                            </div>
                        </div>

                        <!-- Información adicional del proveedor -->
                        @if (!string.IsNullOrEmpty(proveedorInfo.CodigoProveedor))
                        {
                            <div class="row mb-3">
                                <div class="col-md-3">
                                    <label class="form-label">Código Proveedor:</label>
                                    <InputText class="form-control" @bind-Value="proveedorInfo.CodigoProveedor" readonly />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Domicilio:</label>
                                    <InputText class="form-control" @bind-Value="proveedorInfo.Domicilio" readonly />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Cod.Postal:</label>
                                    <InputText class="form-control" @bind-Value="proveedorInfo.CodigoPostal" readonly />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Localidad:</label>
                                    <InputText class="form-control" @bind-Value="proveedorInfo.Localidad" readonly />
                                </div>
@*                                 <div class="col-md-4">
                                    <label class="form-label">Contacto:</label>
                                    <InputText class="form-control" @bind-Value="proveedorInfo.Contacto" readonly />
                                </div>
 *@                                <div class="col-md-4">
                                    <label class="form-label">CUIT:</label>
                                    <InputText class="form-control" @bind-Value="proveedorInfo.Cuit" readonly />
                                </div>
                            </div>
                        }

                        <!-- Información adicional -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Referencia:</label>
                                <InputText class="form-control" @bind-Value="ordenCompra.RefeOcom" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Cond. de Pago:</label>
                                <InputSelect class="form-select" @bind-Value="ordenCompra.CpagOcom">
                                    <option value="">Seleccionar...</option>
                                    @if (condicionesPago != null)
                                    {
                                        @foreach (var condicion in condicionesPago)
                                        {
                                            <option value="@condicion.NumCondPag">@condicion.DescCondPag</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Moneda:</label>
                                <InputSelect class="form-select" @bind-Value="CodigoMonedaSeleccionado">
                                    <option value="0">Seleccionar...</option>
                                    @if (monedas != null)
                                    {
                                        @foreach (var moneda in monedas)
                                        {
                                            <option value="@moneda.CodigoMoneda">@moneda.Descripcion</option>
                                        }
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tipo Cambio:</label>
                                <InputNumber class="form-control" @bind-Value="ordenCompra.TcamOcom" step="0.0001" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Valorizar en:</label>
                                <InputSelect class="form-select" @bind-Value="ordenCompra.MoneCos" title="Moneda para valorización de costos">
                                    <option value="">Seleccionar...</option>
                                    @if (monedas != null)
                                    {
                                        @foreach (var moneda in monedas)
                                        {
                                            <option value="@moneda.CodigoMoneda">@moneda.Descripcion</option>
                                        }
                                    }
                                </InputSelect>
                                <div class="form-text">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>Moneda utilizada para valorizar los costos de los productos
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Observaciones -->

                        <!-- Botones de acción -->
                        <div class="row">
                            <div class="col-12 text-end">
                                <button type="button" class="btn btn-secondary me-2" @onclick="Cancelar">
                                    <i class="fas fa-times"></i> Cancelar
                                </button>
                                <button type="submit" class="btn btn-success" disabled="@guardando">
                                    @if (guardando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    <i class="fas fa-save"></i> @(IsEdit ? "Actualizar" : "Crear")
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>

                <!-- Detalle de la orden (disponible en creación y edición) -->
                @if (true)
                {
                    <div class="border-top" style="border-color: #0a58ca !important; border-width: 2px !important; margin: 0 1.5rem;"></div>
                    <div class="card-body" style="padding: 1.5rem; padding-top: 1rem;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">
                                <i class="fas fa-list"></i> Detalle de la Orden
                            </h6>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="AgregarItem">
                                <i class="fas fa-plus"></i> Agregar Item
                            </button>
                        </div>
                        @if (detalleItems == null)
                        {
                            <div class="text-center">
                                <div class="spinner-border spinner-border-sm"></div>
                                <span class="ms-2">Cargando detalle...</span>
                            </div>
                        }
                        else if (!detalleItems.Any())
                        {
                            <div class="alert alert-info text-center">
                                <i class="fas fa-info-circle"></i> No hay items en esta orden.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Item</th>
                                            <th>Código</th>
                                            <th>Descripción</th>
                                            <th class="text-end">Cantidad</th>
                                            <th class="text-end">Precio Unit.</th>
                                            <th class="text-end">Total</th>
                                            <th>U.M.</th>
                                            <th>Sector</th>
                                            <th>Destino</th>
                                            <th>Fecha Entrega</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in detalleItems)
                                        {
                                            <tr>
                                                <td>@item.NuOrdItem</td>
                                                <td>@item.CodExte</td>
                                                <td>@item.Descritem</td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm text-end" step="0.01" 
                                                           @bind="item.CantOcom" @bind:after="RecalcularDescuentoDesdeTexto" />
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control form-control-sm text-end" step="0.0001" 
                                                           @bind="item.PreUnit" @bind:after="RecalcularDescuentoDesdeTexto" />
                                                </td>
                                                <td>@((item.CantOcom * item.PreUnit)?.ToString("C2"))</td>
                                                <td>
                                                    <input class="form-control form-control-sm" @bind="item.UniMas" />
                                                </td>
                                                <td>
                                                    <input class="form-control form-control-sm" @bind="item.SectorItem" maxlength="12" placeholder="Sector..." />
                                                </td>
                                                <td>
                                                    <select class="form-select form-select-sm" @bind="item.DestinoItem">
                                                        <option value="">Seleccionar...</option>
                                                        @if (cuentasDestino != null)
                                                        {
                                                            @foreach (var cuenta in cuentasDestino)
                                                            {
                                                                <option value="@cuenta.CodInCue">@cuenta.CodExCue - @cuenta.Denocue</option>
                                                            }
                                                        }
                                                    </select>
                                                </td>
                                                <td>
                                                    <input class="form-control form-control-sm" type="date" @bind-value="item.FentreSol" />
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="(() => EditarItem(item))">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="(() => EliminarItem(item))">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Totales y Descuentos -->
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <!-- Sección de Descuentos -->
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0">DESCUENTOS</h6>
                                        </div>
                                        <div class="card-body">
                                            <!-- Campo de descuento en texto -->
                                            <div class="mb-3">
                                                <label class="form-label">Descuento (texto)</label>
                                                <input type="text" class="form-control" @bind="DescuentoTexto" @bind:event="oninput" placeholder="Ej: 10 o 10 + 5" />
                                                <small class="text-muted">Ingrese número o expresiones como "10 + 5" para descuentos sucesivos.</small>
                                            </div>

                                            <!-- Descuento % y monto -->
                                            <div class="row mb-2 align-items-center">
                                                <div class="col-4">
                                                    <label class="form-label mb-0">Descuento %:</label>
                                                </div>
                                                <div class="col-8">
                                                    <input type="text" class="form-control text-end" readonly value="@descuentoPorcentaje.ToString("F2")" />
                                                </div>
                                            </div>

                                            <div class="row mb-2 align-items-center">
                                                <div class="col-4">
                                                    <label class="form-label mb-0">Descuento:</label>
                                                </div>
                                                <div class="col-8">
                                                    <input type="text" class="form-control text-end" readonly value="@descuentoMonto.ToString("F4")" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <!-- Resumen de Totales -->
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h6 class="mb-0">RESUMEN</h6>
                                        </div>
                                        <div class="card-body">
                                            <table class="table table-sm mb-0">
                                                <tr>
                                                    <td><strong>Total Items:</strong></td>
                                                    <td class="text-end"><strong>@detalleItems.Count</strong></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Total Neto:</strong></td>
                                                    <td class="text-end"><strong>@TotalNeto.ToString("C2")</strong></td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Descuento:</strong></td>
                                                    <td class="text-end text-danger"><strong>-@descuentoMonto.ToString("C2")</strong></td>
                                                </tr>
                                                <tr class="table-success">
                                                    <td><strong>Total con Descuento:</strong></td>
                                                    <td class="text-end"><strong>@TotalConDescuento.ToString("C2")</strong></td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <label class="form-label mb-0" @ondblclick="(() => AbrirModalIva())" 
                                                               style="cursor: pointer; color: #0066cc; text-decoration: underline;" 
                                                               title="Doble clic para abrir distribución de IVA">
                                                            <i class="fas fa-calculator me-1"></i>IVA:
                                                            <small class="text-muted d-block" style="font-size: 0.7em;">
                                                                <i class="fas fa-mouse-pointer"></i> Doble clic aquí
                                                            </small>
                                                        </label>
                                                    </td>
                                                    <td class="text-end"><strong>@TotalIva.ToString("C2")</strong></td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <label class="form-label mb-0">
                                                            <i class="fas fa-percentage me-1"></i>% IVA:
                                                        </label>
                                                    </td>
                                                    <td class="text-end">
                                                        <input type="text" class="form-control form-control-sm text-end bg-light" 
                                                               readonly value="@PorcentajeIvaTexto" 
                                                               style="font-weight: bold; border: none; background-color: #f8f9fa !important;" />
                                                    </td>
                                                </tr>
                                                <tr class="table-info">
                                                    <td><strong>Total Final:</strong></td>
                                                    <td class="text-end"><strong>@TotalConIva.ToString("C2")</strong></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Información adicional -->
                <div class="border-top" style="border-color: #0a58ca !important; border-width: 2px !important; margin: 0 1.5rem;"></div>
                <div class="card-body" style="padding: 1.5rem; padding-top: 1rem;">
                    <h6 class="mb-3">
                        <i class="fas fa-info-circle"></i> Información Adicional
                    </h6>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Lugar de Entrega:</label>
                            <InputText class="form-control" @bind-Value="ordenCompra.Lentrega" placeholder="Especificar lugar de entrega..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Solicita:</label>
                            <InputText class="form-control" @bind-Value="ordenCompra.ResponOcompra" placeholder="Persona que solicita la orden..." />
                        </div>
                    </div>
                    
                    <!-- Campo Atte. Señor -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="form-label">Atte. Señor:</label>
                            <InputText class="form-control" @bind-Value="ordenCompra.AtSrOcom" placeholder="Persona a quien va dirigida la orden..." />
                            <small class="text-muted">Persona de contacto o responsable a quien va dirigida la orden de compra</small>
                        </div>
                    </div>
                </div>

                <!-- Observaciones dentro del mismo marco -->
                <div class="border-top" style="border-color: #0a58ca !important; border-width: 2px !important; margin: 0 1.5rem;"></div>
                <div class="card-body" style="padding: 1.5rem; padding-top: 1rem;">
                    <h6 class="mb-3">
                        <i class="fas fa-comment"></i> Observaciones
                    </h6>
                    <InputTextArea class="form-control" @bind-Value="ordenCompra.ObseOcom" rows="3" placeholder="Ingrese observaciones adicionales..." />
                </div>

                <!-- Botones de acción adicionales para edición -->
                @if (IsEdit)
                {
                    <div class="border-top" style="border-color: #0a58ca !important; border-width: 2px !important; margin: 0 1.5rem;"></div>
                    <div class="card-body" style="padding: 1.5rem; padding-top: 1rem;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">
                                    <strong>Fecha Generación:</strong> @(ordenCompra.FGenOcom?.ToString("dd/MM/yyyy HH:mm") ?? "No disponible") | 
                                    <strong>Creado:</strong> @(ordenCompra.AddRecord?.ToString("dd/MM/yyyy HH:mm") ?? "No disponible") | 
                                    <strong>Modificado:</strong> @(ordenCompra.LastUpdate?.ToString("dd/MM/yyyy HH:mm") ?? "No disponible")
                                </small>
                            </div>
                            <div>
                                <button type="button" class="btn btn-outline-success me-2" @onclick="ImprimirOrden">
                                    <i class="fas fa-print"></i> Imprimir
                                </button>
                                <button type="button" class="btn btn-outline-info" @onclick="VerHistorial">
                                    <i class="fas fa-history"></i> Historial
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Componentes modales -->
<SelectorProveedores @ref="selectorProveedores" OnProveedorSeleccionado="OnProveedorSeleccionado" />
<SelectorProductosCompras @ref="selectorProductosCompras" 
                          SectorPorDefecto="@sectorPorDefecto"
                          DestinoPorDefecto="@destinoPorDefecto"
                          CuentasDestino="@cuentasDestino"
                          UnidadesMedida="@unidadesMedida"
                          ItemsExistentes="@detalleItems"
                          OnProductoSeleccionadoCompras="OnProductoSeleccionadoCompras" 
                          OnClose="TerminarCicloSeleccionProductos" />

<!-- Modal de distribución de IVA -->
@if (mostrarModalIva)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h4 class="modal-title">
                        <i class="fas fa-calculator me-2"></i>Distribución de IVA
                    </h4>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalIva"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Panel de ayuda e instrucciones -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="alert alert-info border-0 shadow-sm">
                                <div class="d-flex align-items-start">
                                    <i class="fas fa-info-circle fa-2x text-info me-3 mt-1"></i>
                                    <div>
                                        <h5 class="alert-heading mb-2">
                                            <i class="fas fa-question-circle me-1"></i>¿Cómo usar esta distribución?
                                        </h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <ul class="mb-0">
                                                    <li><strong><i class="fas fa-mouse-pointer text-primary"></i> Doble clic:</strong> En cualquier campo para asignar todo el total</li>
                                                    <li><strong><i class="fas fa-edit text-warning"></i> Edición manual:</strong> Modifique los campos amarillos</li>
                                                </ul>
                                            </div>
                                            <div class="col-md-6">
                                                <ul class="mb-0">
                                                    <li><strong><i class="fas fa-calculator text-success"></i> Automático:</strong> El campo gris se calcula solo</li>
                                                    <li><strong><i class="fas fa-exclamation-triangle text-danger"></i> Validación:</strong> Alertas si hay inconsistencias</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total a distribuir - Destacado -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card border-primary shadow-sm">
                                <div class="card-header bg-primary text-white text-center">
                                    <h5 class="mb-0">
                                        <i class="fas fa-coins me-2"></i>Total a Distribuir
                                    </h5>
                                </div>
                                <div class="card-body text-center bg-light">
                                    <h2 class="text-primary mb-1">@TotalConDescuento.ToString("C2")</h2>
                                    <small class="text-muted">Subtotal con descuentos aplicados</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Grid de distribución -->
                    <div class="row g-3">
                        <!-- Exento/N/Grav (0%) -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-secondary shadow-sm">
                                <div class="card-header bg-secondary text-white text-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-ban me-1"></i>Exento/N/Grav
                                    </h6>
                                    <small>0% IVA</small>
                                </div>
                                <div class="card-body">
                                    <label class="form-label small">
                                        <i class="fas fa-info-circle text-info me-1"></i>Base Imponible:
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control form-control-lg text-end bg-light" readonly 
                                               @bind="baseImponible0" @ondblclick="(() => PonerTodoEnCampo(0))"
                                               title="Doble clic para poner todo el total aquí" 
                                               style="cursor: pointer; font-weight: bold;" />
                                    </div>
                                    <div class="mt-2 text-center">
                                        <small class="text-muted">
                                            <i class="fas fa-calculator me-1"></i>IVA: <strong>$0.00</strong>
                                        </small>
                                        <br />
                                        <small class="text-info">
                                            <i class="fas fa-mouse-pointer me-1"></i>Doble clic para usar
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 10.5% -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-warning shadow-sm">
                                <div class="card-header bg-warning text-dark text-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-percentage me-1"></i>Gravado 10.5%
                                    </h6>
                                    <small>IVA Reducido</small>
                                </div>
                                <div class="card-body">
                                    <label class="form-label small">
                                        <i class="fas fa-edit text-warning me-1"></i>Base Imponible:
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control form-control-lg text-end" step="0.01" 
                                               @bind="baseImponible105" @bind:after="RecalcularDistribucionIva" 
                                               @ondblclick="(() => PonerTodoEnCampo(1))" 
                                               title="Editable - Doble clic para poner todo el total aquí" 
                                               placeholder="0.00" style="font-weight: bold;" />
                                    </div>
                                    <div class="mt-2 text-center">
                                        <small class="text-success">
                                            <i class="fas fa-calculator me-1"></i>IVA: <strong>@importeIva105.ToString("C2")</strong>
                                        </small>
                                        <br />
                                        <small class="text-warning">
                                            <i class="fas fa-mouse-pointer me-1"></i>Doble clic para usar
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 21% -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-danger shadow-sm">
                                <div class="card-header bg-danger text-white text-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-percentage me-1"></i>Gravado 21%
                                    </h6>
                                    <small>IVA General</small>
                                </div>
                                <div class="card-body">
                                    <label class="form-label small">
                                        <i class="fas fa-edit text-warning me-1"></i>Base Imponible:
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control form-control-lg text-end" step="0.01" 
                                               @bind="baseImponible21" @bind:after="RecalcularDistribucionIva" 
                                               @ondblclick="(() => PonerTodoEnCampo(2))" 
                                               title="Editable - Doble clic para poner todo el total aquí" 
                                               placeholder="0.00" style="font-weight: bold;" />
                                    </div>
                                    <div class="mt-2 text-center">
                                        <small class="text-success">
                                            <i class="fas fa-calculator me-1"></i>IVA: <strong>@importeIva21.ToString("C2")</strong>
                                        </small>
                                        <br />
                                        <small class="text-danger">
                                            <i class="fas fa-mouse-pointer me-1"></i>Doble clic para usar
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 27% -->
                        <div class="col-md-6 col-lg-3">
                            <div class="card h-100 border-dark shadow-sm">
                                <div class="card-header bg-dark text-white text-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-percentage me-1"></i>Gravado 27%
                                    </h6>
                                    <small>IVA Especial</small>
                                </div>
                                <div class="card-body">
                                    <label class="form-label small">
                                        <i class="fas fa-edit text-warning me-1"></i>Base Imponible:
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" class="form-control form-control-lg text-end" step="0.01" 
                                               @bind="baseImponible27" @bind:after="RecalcularDistribucionIva" 
                                               @ondblclick="(() => PonerTodoEnCampo(3))" 
                                               title="Editable - Doble clic para poner todo el total aquí" 
                                               placeholder="0.00" style="font-weight: bold;" />
                                    </div>
                                    <div class="mt-2 text-center">
                                        <small class="text-success">
                                            <i class="fas fa-calculator me-1"></i>IVA: <strong>@importeIva27.ToString("C2")</strong>
                                        </small>
                                        <br />
                                        <small class="text-dark">
                                            <i class="fas fa-mouse-pointer me-1"></i>Doble clic para usar
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Resumen y validaciones -->
                    <div class="row mt-4">
                        <div class="col-md-6">
                            @{
                                var diferencia = TotalConDescuento - TotalBaseImponible;
                                var totalGravado = baseImponible105 + baseImponible21 + baseImponible27;
                                var alertClass = totalGravado > TotalConDescuento ? "danger" : 
                                               (TotalBaseImponible == TotalConDescuento ? "success" : "warning");
                                var iconClass = totalGravado > TotalConDescuento ? "exclamation-triangle" : 
                                              (TotalBaseImponible == TotalConDescuento ? "check-circle" : "info-circle");
                            }
                            <div class="alert alert-@alertClass border-0 shadow-sm">
                                <h6 class="alert-heading">
                                    <i class="fas fa-@iconClass me-2"></i>Estado de la Distribución
                                </h6>
                                @if (totalGravado > TotalConDescuento)
                                {
                                    <p class="mb-2"><strong>¡ADVERTENCIA!</strong> Los campos editables suman más que el total disponible</p>
                                    <div class="row small">
                                        <div class="col-6"><strong>Suma editables:</strong></div>
                                        <div class="col-6 text-end">@totalGravado.ToString("C2")</div>
                                        <div class="col-6"><strong>Disponible:</strong></div>
                                        <div class="col-6 text-end">@TotalConDescuento.ToString("C2")</div>
                                        <div class="col-6"><strong>Exceso:</strong></div>
                                        <div class="col-6 text-end text-danger"><strong>@((totalGravado - TotalConDescuento).ToString("C2"))</strong></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row small">
                                        <div class="col-6"><strong>Total Base:</strong></div>
                                        <div class="col-6 text-end">@TotalBaseImponible.ToString("C2")</div>
                                        <div class="col-6"><strong>Diferencia:</strong></div>
                                        <div class="col-6 text-end">@diferencia.ToString("C2")</div>
                                    </div>
                                    @if (diferencia != 0)
                                    {
                                        <small class="text-muted d-block mt-1">
                                            <i class="fas fa-info-circle me-1"></i>La diferencia se asigna automáticamente a Exento/N/Grav
                                        </small>
                                    }
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="alert alert-info border-0 shadow-sm">
                                <h6 class="alert-heading">
                                    <i class="fas fa-calculator me-2"></i>Resumen Final
                                </h6>
                                <div class="row">
                                    <div class="col-6"><strong>Total IVA:</strong></div>
                                    <div class="col-6 text-end"><strong>@TotalIva.ToString("C2")</strong></div>
                                    <div class="col-6"><strong>Total Final:</strong></div>
                                    <div class="col-6 text-end"><h5 class="text-primary mb-0">@TotalConIva.ToString("C2")</h5></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones de acción rápida -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-center gap-2">
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="(() => PonerTodoEnCampo(0))">
                                    <i class="fas fa-ban me-1"></i>Todo Exento
                                </button>
                                <button type="button" class="btn btn-outline-warning btn-sm" @onclick="(() => PonerTodoEnCampo(1))">
                                    <i class="fas fa-percentage me-1"></i>Todo 10.5%
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="(() => PonerTodoEnCampo(2))">
                                    <i class="fas fa-percentage me-1"></i>Todo 21%
                                </button>
                                <button type="button" class="btn btn-outline-dark btn-sm" @onclick="(() => PonerTodoEnCampo(3))">
                                    <i class="fas fa-percentage me-1"></i>Todo 27%
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LimpiarDistribucion">
                                    <i class="fas fa-eraser me-1"></i>Limpiar Todo
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalIva">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </button>
                    @{
                        var totalGravadoFooter = baseImponible105 + baseImponible21 + baseImponible27;
                        var hayExceso = totalGravadoFooter > TotalConDescuento;
                    }
                    @if (hayExceso)
                    {
                        <button type="button" class="btn btn-warning" @onclick="AceptarDistribucionIva">
                            <i class="fas fa-exclamation-triangle me-1"></i>Aceptar con Advertencia
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary" @onclick="AceptarDistribucionIva">
                            <i class="fas fa-check me-1"></i>Aceptar Distribución
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Ocomenca ordenCompra { get; set; } = new();
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool IsEdit { get; set; } = false;

    private bool guardando = false;
    private string proveedorSeleccionado = string.Empty;
    private List<Ocomdeta>? detalleItems;
    private List<Tamoned>? monedas;
    private List<CondPag>? condicionesPago;
    private List<Plancuen>? cuentasDestino;
    private List<UnidadMedidas>? unidadesMedida;
    private SelectorProveedores.ProveedorSeleccionado proveedorInfo = new();

    // Variables para Sector y Destino por defecto
    private string sectorPorDefecto = string.Empty;
    private int? destinoPorDefecto;

    /// <summary>
    /// Propiedad intermediaria para el selector de destino por defecto.
    /// Sincroniza el valor seleccionado con destinoPorDefecto y ordenCompra.CodiEmpr
    /// </summary>
    private int? DestinoPorDefectoSeleccionado
    {
        get => destinoPorDefecto ?? ordenCompra.CodiEmpr;
        set
        {
            destinoPorDefecto = value;
            ordenCompra.CodiEmpr = value;
            Console.WriteLine($"[DestinoPorDefectoSeleccionado] Destino seleccionado: {value}");
        }
    }

    // Referencias a componentes
    private SelectorProveedores selectorProveedores = null!;
    private SelectorProductosCompras selectorProductosCompras = null!;
    private bool cicloSeleccionProductos = false;

    // ===== Sistema de Descuentos =====
    // Variables para el manejo de descuentos
    private decimal descuentoMonto = 0m;
    private decimal descuentoPorcentaje = 0m;

    // Total Neto calculado como suma(Cantidad * Precio) sin descuentos
    private decimal TotalNeto => detalleItems?.Sum(item => (item.CantOcom ?? 0) * (item.PreUnit ?? 0)) ?? 0m;

    // Total con descuento aplicado, no menor que 0
    private decimal TotalConDescuento => Math.Max(0m, TotalNeto - descuentoMonto);

    // ===== Sistema de IVA =====
    // Variables para el modal de distribución de IVA
    private bool mostrarModalIva = false;
    private decimal baseImponible0 = 0m;    // ITOGRA(0) - Exento/N/Grav (calculado automáticamente)
    private decimal baseImponible105 = 0m;  // IMPOGRA(1) - 10.5% (editable)
    private decimal baseImponible21 = 0m;   // IMPOGRA(2) - 21% (editable)
    private decimal baseImponible27 = 0m;   // IMPOGRA(3) - 27% (editable)
    private decimal importeIva105 = 0m;     // IMPOIVA(1) - IVA 10.5%
    private decimal importeIva21 = 0m;      // IMPOIVA(2) - IVA 21%
    private decimal importeIva27 = 0m;      // IMPOIVA(3) - IVA 27%

    // Propiedades calculadas para el sistema de IVA
    private decimal TotalBaseImponible => baseImponible0 + baseImponible105 + baseImponible21 + baseImponible27;
    private decimal TotalIva => importeIva105 + importeIva21 + importeIva27;
    private decimal TotalConIva => TotalConDescuento + TotalIva;
    
    /// <summary>
    /// Obtiene el porcentaje de IVA aplicado o "VAR" si hay distribución mixta
    /// </summary>
    private string PorcentajeIvaTexto
    {
        get
        {
            // Si no hay distribución de IVA, mostrar 0%
            if (TotalBaseImponible == 0) return "0%";
            
            // Contar cuántos campos tienen valor mayor a 0
            int camposConValor = 0;
            string porcentajeUnico = "";
            
            if (baseImponible0 > 0)
            {
                camposConValor++;
                porcentajeUnico = "0%";
            }
            
            if (baseImponible105 > 0)
            {
                camposConValor++;
                porcentajeUnico = "10.5%";
            }
            
            if (baseImponible21 > 0)
            {
                camposConValor++;
                porcentajeUnico = "21%";
            }
            
            if (baseImponible27 > 0)
            {
                camposConValor++;
                porcentajeUnico = "27%";
            }
            
            // Si solo hay un campo con valor, mostrar ese porcentaje
            if (camposConValor == 1)
            {
                return porcentajeUnico;
            }
            
            // Si hay múltiples campos con valor, mostrar "VAR"
            if (camposConValor > 1)
            {
                return "VAR";
            }
            
            // Por defecto, 0%
            return "0%";
        }
    }

    /// <summary>
    /// Propiedad intermediaria para el campo de texto de descuento.
    /// Cuando se modifica, actualiza ordenCompra.PdesOcom y recalcula automáticamente
    /// los valores de descuentoPorcentaje y descuentoMonto.
    /// </summary>
    private string DescuentoTexto
    {
        get => ordenCompra.PdesOcom ?? string.Empty;
        set
        {
            ordenCompra.PdesOcom = value;
            RecalcularDescuentoDesdeTexto();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarMonedas();
        await CargarCondicionesPago();
        await CargarCuentasDestino();
        await CargarUnidadesMedida();
        
        if (IsEdit && ordenCompra.NumeOcom.HasValue)
        {
            await CargarDetalle();
            if (ordenCompra.NproOcom.HasValue)
            {
                proveedorSeleccionado = $"{ordenCompra.NproOcom} - {ordenCompra.RaSoProv}";
            }
            
            // Para órdenes en edición, cargar moneda desde el detalle si existe
            await CargarMonedaDesdeDetalle();
            
            // Validar y cargar "Atte. Señor" si está vacío
            await ValidarYCargarAtteSenor();
            
            // Cargar distribución de IVA existente para órdenes en edición
            await CargarDistribucionIvaExistente();
        }
        else
        {
            // Para órdenes nuevas, establecer valores por defecto
            ordenCompra.FemiOcom = DateTime.Now;
            ordenCompra.StatOcom = 0;
            ordenCompra.CodiEmpr = 1; // Valor por defecto
            
            // Inicializar lista de detalle vacía para órdenes nuevas
            detalleItems = new List<Ocomdeta>();
            
            // Establecer moneda por defecto solo para órdenes nuevas
            await EstablecerMonedaPorDefecto();
        }
    }

    private async Task CargarMonedas()
    {
        try
        {
            var responseHttp = await repository.Get<List<Tamoned>>("/api/tamoneds/combo");
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                monedas = responseHttp.Response;
            }
            else
            {
                Console.WriteLine("Error al cargar monedas desde la API");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar monedas: {ex.Message}");
        }
    }

    private async Task CargarCondicionesPago()
    {
        try
        {
            var responseHttp = await repository.Get<List<CondPag>>("api/condpag/combo");
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                condicionesPago = responseHttp.Response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar condiciones de pago: {ex.Message}");
        }
    }

    private async Task CargarCuentasDestino()
    {
        try
        {
            var responseHttp = await repository.Get<List<Plancuen>>("api/plancuen/combo");
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                cuentasDestino = responseHttp.Response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar cuentas destino: {ex.Message}");
        }
    }

    private async Task CargarUnidadesMedida()
    {
        try
        {
            var responseHttp = await repository.Get<List<UnidadMedidas>>("api/umedidas/combo");
            if (!responseHttp.Error && responseHttp.Response != null)
            {
                unidadesMedida = responseHttp.Response.Where(u => u.status == 0).ToList();
                Console.WriteLine($"[UnidadesMedida] Cargadas {unidadesMedida.Count} unidades de medida");
            }
            else
            {
                Console.WriteLine($"[UnidadesMedida] Error en la respuesta: {responseHttp.Error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar unidades de medida: {ex.Message}");
        }
    }

    /// <summary>
    /// Establece las monedas por defecto (PESOS con código 1 para emisión y valorización, y tipo de cambio 1)
    /// </summary>
    private async Task EstablecerMonedaPorDefecto()
    {
        try
        {
            // Buscar la moneda PESOS (código 1) en la lista de monedas
            var monedaPesos = monedas?.FirstOrDefault(m => m.CodigoMoneda == 1);

            if (monedaPesos != null)
            {
                // Establecer PESOS como moneda por defecto para emisión y valorización
                ordenCompra.MoneEmis = Convert.ToInt16(monedaPesos.CodigoMoneda);
                ordenCompra.MoneCos = Convert.ToInt16(monedaPesos.CodigoMoneda); // Valorizar en PESOS por defecto
                ordenCompra.TcamOcom = monedaPesos.Cotizacion;
            }
            else
            {
                // Si no se encuentra PESOS, establecer valores por defecto
                ordenCompra.MoneEmis = 1; // Código 1 para PESOS
                ordenCompra.MoneCos = 1; // Valorizar en PESOS por defecto
                ordenCompra.TcamOcom = 1; // Tipo de cambio 1
            }
        }
        catch (Exception ex)
        {
            // En caso de error, establecer valores por defecto
            ordenCompra.MoneEmis = 1;
            ordenCompra.MoneCos = 1; // Valorizar en PESOS por defecto
            ordenCompra.TcamOcom = 1;
            await sweetAlertService.FireAsync("Advertencia", $"Se estableció la moneda por defecto debido a un error: {ex.Message}", SweetAlertIcon.Warning);
        }
    }

    /// <summary>
    /// Propiedad que maneja la selección de moneda en el combo desplegable.
    /// Actúa como intermediario entre el InputSelect y el modelo ordenCompra.
    /// Cuando se selecciona una moneda, automáticamente actualiza el tipo de cambio correspondiente.
    /// </summary>
    private int CodigoMonedaSeleccionado
    {
        // Getter: Devuelve el código de moneda actualmente seleccionado
        get => ordenCompra.MoneEmis ?? 0;
        set
        {
            // Guardar moneda anterior para conversión
            var monedaAnterior = ordenCompra.MoneEmis ?? 1;
            
            // Setter: Actualiza el código de moneda en el modelo
            ordenCompra.MoneEmis = checked((short)value);

            // Si se seleccionó una moneda válida (mayor a 0)
            if (value > 0)
            {
                // Busca la moneda completa en la lista para obtener su cotización
                var moneda = monedas?.FirstOrDefault(m => m.CodigoMoneda == value);
                // Actualiza el tipo de cambio en el modelo
                ordenCompra.TcamOcom = moneda?.Cotizacion ?? 1;
                
                // Si es una orden existente y cambió la moneda, convertir precios
                if (IsEdit && monedaAnterior != value && detalleItems?.Any() == true)
                {
                    _ = ConvertirPreciosMonedaAsync(monedaAnterior, value);
                }
            }
            else
            {
                // Si no se seleccionó ninguna moneda válida, establece tipo de cambio en 1
                ordenCompra.TcamOcom = 1;
            }
        }
    }

    /// <summary>
    /// Carga la moneda desde el detalle de la orden (similar a PedidosVentaForm)
    /// </summary>
    private async Task CargarMonedaDesdeDetalle()
    {
        if (detalleItems?.Any() == true)
        {
            var primerItem = detalleItems.First();
            
            // Tomar la moneda del primer item del detalle (todos son iguales en una orden)
            if (primerItem.MoneEmis.HasValue && primerItem.MoneEmis > 0)
            {
                ordenCompra.MoneEmis = primerItem.MoneEmis;
                // Para el tipo de cambio, buscar la cotización actual de la moneda
                var moneda = monedas?.FirstOrDefault(m => m.CodigoMoneda == primerItem.MoneEmis);
                ordenCompra.TcamOcom = moneda?.Cotizacion ?? 1;
                Console.WriteLine($"Orden en edición - Moneda cargada desde OCOMDETA: {ordenCompra.MoneEmis}, TipoCam: {ordenCompra.TcamOcom}");
            }
            else
            {
                // Si no tiene moneda en el detalle, usar pesos por defecto
                await EstablecerMonedaPorDefecto();
                Console.WriteLine($"Moneda no establecida en OCOMDETA, usando por defecto: {ordenCompra.MoneEmis}");
            }
        }
        else
        {
            // Si no hay items en el detalle, verificar si la orden tiene moneda establecida
            if (!ordenCompra.MoneEmis.HasValue || ordenCompra.MoneEmis == 0)
            {
                // Si no hay moneda establecida, usar pesos por defecto
                await EstablecerMonedaPorDefecto();
                Console.WriteLine($"Sin items en detalle y sin moneda, usando por defecto: {ordenCompra.MoneEmis}");
            }
            else
            {
                Console.WriteLine($"Orden en edición - Moneda preservada desde OCOMENCA: {ordenCompra.MoneEmis}, TipoCam: {ordenCompra.TcamOcom}");
            }
        }
    }

    /// <summary>
    /// Convierte los precios de todos los items cuando se cambia la moneda
    /// </summary>
    /// <param name="monedaOrigen">Código de moneda origen</param>
    /// <param name="monedaDestino">Código de moneda destino</param>
    private async Task ConvertirPreciosMonedaAsync(int monedaOrigen, int monedaDestino)
    {
        try
        {
            if (monedaOrigen == monedaDestino || detalleItems?.Any() != true)
                return;

            // Obtener cotizaciones
            var cotizacionOrigen = ObtenerCotizacionMoneda(monedaOrigen);
            var cotizacionDestino = ObtenerCotizacionMoneda(monedaDestino);

            // Convertir precios de cada item
            foreach (var item in detalleItems)
            {
                // Convertir precio
                if (item.PreUnit.HasValue && item.PreUnit > 0)
                {
                    // Convertir a pesos (moneda base) y luego a la moneda destino
                    var precioEnPesos = item.PreUnit.Value * cotizacionOrigen;
                    item.PreUnit = Math.Round(precioEnPesos / cotizacionDestino, 4);
                }
            }

            // Recalcular descuentos basados en el nuevo total
            RecalcularDescuentoDesdeTexto();

            StateHasChanged();

            // Mostrar mensaje de confirmación
            var monedaOrigenNombre = monedas?.FirstOrDefault(m => m.CodigoMoneda == monedaOrigen)?.Descripcion ?? "Desconocida";
            var monedaDestinoNombre = monedas?.FirstOrDefault(m => m.CodigoMoneda == monedaDestino)?.Descripcion ?? "Desconocida";

            await sweetAlertService.FireAsync(
                "Conversión Realizada", 
                $"Los precios han sido convertidos de {monedaOrigenNombre} a {monedaDestinoNombre}", 
                SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al convertir precios: {ex.Message}", SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Obtiene la cotización de una moneda específica
    /// </summary>
    /// <param name="codigoMoneda">Código de la moneda</param>
    /// <returns>Cotización de la moneda</returns>
    private decimal ObtenerCotizacionMoneda(int codigoMoneda)
    {
        try
        {
            var moneda = monedas?.FirstOrDefault(m => m.CodigoMoneda == codigoMoneda);
            return moneda?.Cotizacion ?? 1;
        }
        catch
        {
            return 1; // Cotización por defecto
        }
    }

