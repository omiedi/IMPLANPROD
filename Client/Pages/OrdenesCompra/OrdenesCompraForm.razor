    private async Task OnProductoSeleccionadoCompras(SelectorProductosCompras.SeleccionProductoCompras seleccion)
    {
        try
        {
            Console.WriteLine($"Iniciando OnProductoSeleccionado para producto: {seleccion.Producto.Codigo}");
            Console.WriteLine($"Precio del selector: {seleccion.Precio}");
            
            // Usar el precio ingresado en el selector o calcular precio desde MASTER.COSUNI
            decimal precioFinal;
            if (seleccion.Precio > 0)
            {
                // Si se ingresó un precio en el selector, usarlo
                precioFinal = seleccion.Precio;
                Console.WriteLine($"[OnProductoSeleccionado] ✅ Usando precio ingresado en selector: {precioFinal:C4}");
            }
            else
            {
                // Si no hay precio ingresado, obtener desde MASTER.COSUNI con conversión de monedas
                precioFinal = await CalcularPrecioConConversionMoneda(seleccion.Producto);
                Console.WriteLine($"[OnProductoSeleccionado] 🔄 Precio calculado desde MASTER.COSUNI: {precioFinal:C4}");
                
                // Si el precio calculado sigue siendo 0, mostrar advertencia pero continuar
                if (precioFinal == 0)
                {
                    Console.WriteLine($"[OnProductoSeleccionado] ⚠️ ADVERTENCIA: El producto {seleccion.Producto.Codigo} no tiene precio en MASTER.COSUNI");
                    // Mostrar mensaje informativo al usuario
                    await sweetAlertService.FireAsync(new SweetAlertOptions
                    {
                        Title = "Precio no disponible",
                        Text = $"El producto {seleccion.Producto.Codigo} - {seleccion.Producto.Descripcion} no tiene precio definido en el catálogo.\n\n" +
                               "Puede editar el precio directamente en la tabla después de agregarlo.",
                        Icon = SweetAlertIcon.Warning,
                        Timer = 4000,
                        ShowConfirmButton = false,
                        Toast = true,
                        Position = SweetAlertPosition.TopEnd
                    });
                }
            }
            
            // ===== CÁLCULOS SEGÚN LÓGICA VB6 =====
            
            // Obtener número de item secuencial (ORDIT% + 1)
            int numeroItem = (detalleItems?.Count ?? 0) + 1;
            
            // Obtener moneda de valorización (MONECOI%) - por defecto pesos (1)
            short monedaValorizacion = ordenCompra.MoneCos ?? 1;
            
            // Calcular precio unitario convertido (PREUNCO# = PREUNPE# / TICAMONE(MONECOI%))
            decimal precioUnitarioConvertido = precioFinal;
            if (monedaValorizacion > 1)
            {
                var cotizacionMoneda = await ObtenerCotizacionMonedaAsync(monedaValorizacion);
                if (cotizacionMoneda > 0)
                {
                    precioUnitarioConvertido = precioFinal / cotizacionMoneda;
                }
            }
            
            // Formatear valor unitario con símbolo de moneda (ValoUnid)
            string simboloMoneda = "$";
            if (monedaValorizacion > 1)
            {
                var moneda = monedas?.FirstOrDefault(m => m.CodigoMoneda == monedaValorizacion);
                simboloMoneda = moneda?.Descripcion?.Substring(0, Math.Min(2, moneda.Descripcion.Length)) ?? "$";
            }
            string valorUnitarioFormateado = $"{simboloMoneda} {precioUnitarioConvertido:F4}";
            
            // Determinar si es item libre (CI0% < 1)
            bool esItemLibre = seleccion.Producto.Codint <= 0 || string.IsNullOrEmpty(seleccion.Producto.Codigo);
            
            // Calcular precio unitario neto (sin descuentos)
            decimal precioUnitarioNeto = precioFinal;
            
            // Calcular importe neto del item (cantidad * precio unitario)
            decimal importeNetoItem = seleccion.Cantidad * precioUnitarioNeto;
            
            // Calcular precio unitario neto en pesos (PrUnNetoPes)
            // Si moneda = 1 (pesos): mismo valor que PrUnNeto
            // Si moneda > 1: precio * cotización de la moneda activa
            decimal precioUnitarioNetoPesos = precioUnitarioNeto;
            short monedaEmision = ordenCompra.MoneEmis ?? 1;
            
            if (monedaEmision == 1)
            {
                // Moneda pesos: mismo valor
                precioUnitarioNetoPesos = precioUnitarioNeto;
                Console.WriteLine($"[OnProductoSeleccionado] 💰 Moneda PESOS: PrUnNetoPes = {precioUnitarioNetoPesos:C4}");
            }
            else
            {
                // Moneda extranjera: precio * cotización
                var cotizacionMoneda = await ObtenerCotizacionMonedaAsync(monedaEmision);
                precioUnitarioNetoPesos = precioUnitarioNeto * cotizacionMoneda;
                Console.WriteLine($"[OnProductoSeleccionado] 💱 Moneda {monedaEmision}: {precioUnitarioNeto:C4} * {cotizacionMoneda} = {precioUnitarioNetoPesos:C4}");
            }
            
            Console.WriteLine($"[OnProductoSeleccionado] 📊 Cálculos VB6:");
            Console.WriteLine($"  - Número item: {numeroItem}");
            Console.WriteLine($"  - Moneda valorización: {monedaValorizacion}");
            Console.WriteLine($"  - Precio convertido: {precioUnitarioConvertido:C4}");
            Console.WriteLine($"  - Valor unitario: {valorUnitarioFormateado}");
            Console.WriteLine($"  - Es item libre: {esItemLibre}");
            Console.WriteLine($"  - Importe neto: {importeNetoItem:C4}");
            Console.WriteLine($"  - Precio en pesos: {precioUnitarioNetoPesos:C4}");
            
            var nuevoItem = new Ocomdeta
            {
                // ===== CAMPOS BÁSICOS SEGÚN VB6 =====
                CodiEmpr = 0, // Siempre 0 según VB6
                NumeOcom = null, // Se asignará cuando se guarde la orden completa
                NuOrdItem = (short)numeroItem, // ORDIT% + 1
                FemiOcom = DateTime.Now, // hoy
                NproOcom = ordenCompra.NproOcom.HasValue ? (short?)ordenCompra.NproOcom.Value : null,
                RaSoProv = ordenCompra.RaSoProv?.Length > 64 ? ordenCompra.RaSoProv.Substring(0, 64) : ordenCompra.RaSoProv,
                MediOcom = "", // Vacío según VB6
                
                // ===== CÓDIGOS Y DESCRIPCIÓN =====
                CodInte = esItemLibre ? (short?)0 : (short)seleccion.Producto.Codint, // CI0%
                CodExte = (seleccion.Producto.Codigo ?? "").Length > 24 ? 
                         (seleccion.Producto.Codigo ?? "").Substring(0, 24) : 
                         (seleccion.Producto.Codigo ?? ""),
                Descritem = esItemLibre && !string.IsNullOrEmpty(seleccion.Producto.Descripcion) ?
                           (seleccion.Producto.Descripcion.Length > 64 ? seleccion.Producto.Descripcion.Substring(0, 64) : seleccion.Producto.Descripcion) :
                           (seleccion.Producto.Descripcion ?? "").Length > 64 ? 
                           (seleccion.Producto.Descripcion ?? "").Substring(0, 64) : 
                           (seleccion.Producto.Descripcion ?? ""),
                Delibre = esItemLibre ? seleccion.Producto.Descripcion : null,
                
                // ===== VALORES Y CANTIDADES =====
                ValoUnid = valorUnitarioFormateado.Length > 12 ? valorUnitarioFormateado.Substring(0, 12) : valorUnitarioFormateado,
                UniMas = (seleccion.Producto.Umedida ?? "").Length > 4 ? (seleccion.Producto.Umedida ?? "").Substring(0, 4) : (seleccion.Producto.Umedida ?? ""),
                UnidsOcom = seleccion.Cantidad, // CAUNIS = cantidad
                CantOcom = seleccion.Cantidad, // CANTU = cantidades
                UniCom = (seleccion.Producto.Umedida ?? "").Length > 4 ? (seleccion.Producto.Umedida ?? "").Substring(0, 4) : (seleccion.Producto.Umedida ?? ""),
                CoefUnids = 1, // Siempre 1 según VB6
                
                // ===== PRECIOS Y CÁLCULOS =====
                PreUnit = precioFinal, // Precio unitario original
                DescItem = 0, // Sin descuento por item
                PrUnNeto = precioUnitarioNeto, // Precio unitario neto
                INetItem = importeNetoItem, // Importe neto del item
                PrUnNetoPes = precioUnitarioNetoPesos, // Precio en pesos
                
                // ===== FECHAS Y ESTADOS =====
                FentreSol = DateTime.Now.AddDays(7), // Fecha de entrega por defecto
                Consimat = "0", // Según VB6
                CantRec = 0, // Cantidad recibida inicial
                CodOper = 0, // Código de operación
                DocOrig = "", // Documento original vacío
                NOrServ = 0, // Número de orden de servicio
                
                // ===== MONEDAS =====
                MoneCos = monedaValorizacion, // Moneda de valorización
                MoneEmis = ordenCompra.MoneEmis, // Moneda de emisión de la O.C.
                TSumOcom = 0, // Materiales (siempre 0)
                
                // ===== ESTADO Y CONTABILIDAD =====
                StatOcom = 0, // Estado activo
                IContab = seleccion.Destino.HasValue ? (short)seleccion.Destino.Value : null, // Destino
                SectOcom = !string.IsNullOrEmpty(seleccion.Sector) && seleccion.Sector.Length > 12 
                    ? seleccion.Sector.Substring(0, 12) 
                    : seleccion.Sector, // Sector manual
                
                // ===== CAMPOS DE AUDITORÍA =====
                AddRecord = DateTime.Now,
                LastUpdate = DateTime.Now,
                Rowguid = Guid.NewGuid(),
                
                // ===== PROPIEDADES AUXILIARES FRONTEND =====
                SectorItem = seleccion.Sector ?? string.Empty,
                DestinoItem = seleccion.Destino
            };

            // Agregar a la lista local (no guardar en BD todavía)
            if (detalleItems == null)
            {
                detalleItems = new List<Ocomdeta>();
            }
            
            detalleItems.Add(nuevoItem);
            
            Console.WriteLine($"Item agregado a lista local - CodInte={nuevoItem.CodInte}, CantOcom={nuevoItem.CantOcom}, PreUnit={nuevoItem.PreUnit}");
            Console.WriteLine($"Total items en lista: {detalleItems.Count}");

            // Recalcular descuento al cambiar el total neto
            RecalcularDescuentoDesdeTexto();
            
            // Actualizar la interfaz
            StateHasChanged();
            
            // Si el ciclo sigue activo, reabrimos el modal para permitir agregar otro producto
            if (cicloSeleccionProductos)
            {
                await Task.Delay(100); // Espera corta para permitir cerrar y re-renderizar antes de reabrir
                await selectorProductosCompras.AbrirModal();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Excepción en OnProductoSeleccionado: {ex.Message}");
            await sweetAlertService.FireAsync("Error", $"Error al agregar item: {ex.Message}", SweetAlertIcon.Error);
        }
    }

