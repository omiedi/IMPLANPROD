    /// <summary>
    /// Calcula el precio del producto desde MASTER.COSUNI considerando conversión de monedas
    /// </summary>
    private async Task<decimal> CalcularPrecioConConversionMoneda(Master producto)
    {
        try
        {
            Console.WriteLine($"[CalcularPrecioConConversionMoneda] 🔍 Calculando precio para producto: {producto.Codigo}");
            
            // Obtener el precio base del COSUNI
            decimal precioBase = producto.Cosuni ?? 0m;
            Console.WriteLine($"[CalcularPrecioConConversionMoneda] 💰 MASTER.COSUNI = {precioBase:C4}");
            
            // Si no hay precio en COSUNI, retornar 0
            if (precioBase == 0m) 
            {
                Console.WriteLine($"[CalcularPrecioConConversionMoneda] ⚠️ Producto {producto.Codigo} no tiene precio en MASTER.COSUNI");
                return 0m;
            }
            
            // Obtener la moneda del costo del producto (MONECOS)
            short monedaCosto = producto.Monecos ?? 1; // Por defecto pesos si no está definido
            
            // Obtener la moneda activa de la orden de compra
            short monedaOrden = ordenCompra.MoneEmis ?? 1; // Por defecto pesos si no está definido
            
            Console.WriteLine($"[CalcularPrecioConConversionMoneda] 💱 Moneda costo: {monedaCosto}, Moneda orden: {monedaOrden}");
            
            // Si ambas monedas son iguales, no hay conversión
            if (monedaCosto == monedaOrden)
            {
                Console.WriteLine($"[CalcularPrecioConConversionMoneda] ✅ Misma moneda, sin conversión: {precioBase:C4}");
                return precioBase;
            }
            
            // Obtener cotizaciones para conversión
            decimal cotizacionOrigen = await ObtenerCotizacionMonedaAsync(monedaCosto);
            decimal cotizacionDestino = await ObtenerCotizacionMonedaAsync(monedaOrden);
            
            Console.WriteLine($"[CalcularPrecioConConversionMoneda] 📊 Cotización origen: {cotizacionOrigen}, Cotización destino: {cotizacionDestino}");
            
            // Validar cotizaciones
            if (cotizacionDestino == 0)
            {
                Console.WriteLine($"[CalcularPrecioConConversionMoneda] ❌ Error: Cotización destino es 0, usando precio base sin conversión");
                return precioBase;
            }
            
            // Convertir: Precio_Origen * Cotización_Origen / Cotización_Destino
            decimal precioEnPesos = precioBase * cotizacionOrigen;
            decimal precioConvertido = Math.Round(precioEnPesos / cotizacionDestino, 4);
            
            Console.WriteLine($"[CalcularPrecioConConversionMoneda] 🔄 Conversión: {precioBase:C4} (moneda {monedaCosto}) -> {precioConvertido:C4} (moneda {monedaOrden})");
            
            return precioConvertido;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CalcularPrecioConConversionMoneda] ❌ Error en conversión de precio: {ex.Message}");
            Console.WriteLine($"[CalcularPrecioConConversionMoneda] StackTrace: {ex.StackTrace}");
            
            // En caso de error, retornar el precio base sin conversión
            var precioFallback = producto.Cosuni ?? 0m;
            Console.WriteLine($"[CalcularPrecioConConversionMoneda] 🔄 Usando precio fallback: {precioFallback:C4}");
            return precioFallback;
        }
    }

    /// <summary>
    /// Obtiene la cotización de una moneda específica
    /// </summary>
    /// <param name="codigoMoneda">Código de la moneda</param>
    /// <returns>Cotización de la moneda</returns>
    private async Task<decimal> ObtenerCotizacionMonedaAsync(int codigoMoneda)
    {
        try
        {
            var moneda = monedas?.FirstOrDefault(m => m.CodigoMoneda == codigoMoneda);
            return moneda?.Cotizacion ?? 1;
        }
        catch
        {
            return 1; // Cotización por defecto
        }
    }

