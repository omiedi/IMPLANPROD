    /// <summary>
    /// Guarda la orden de compra con distribución de IVA
    /// Utiliza el endpoint crear-completa o actualizar-completa-con-iva según corresponda
    /// </summary>
    private async Task GuardarOrdenConIva()
    {
        try
        {
            // Validar que se haya seleccionado un proveedor (validación adicional)
            if (!await ValidarProveedorSeleccionado())
            {
                return; // La validación ya mostró el mensaje de error
            }

            // Crear el DTO de orden completa
            var ordenCompleta = new OrdenCompraCompletaDTO
            {
                Encabezado = ordenCompra,
                Detalle = detalleItems?.ToList() ?? new List<Ocomdeta>(),
                DistribucionIva = CrearDistribucionIva(),
                CodigoEmpresa = ordenCompra.CodiEmpr,
                ActualizarIva = true
            };

            // Validar la orden completa
            var errores = ordenCompleta.Validar();
            if (errores.Any())
            {
                await sweetAlertService.FireAsync("Error de Validación", 
                    string.Join("\n", errores), 
                    SweetAlertIcon.Error);
                return;
            }

            HttpResponseWrapper<object> responseHttp;

            if (IsEdit)
            {
                // Actualizar orden existente con IVA
                responseHttp = await repository.Put($"api/ocomenca/actualizar-completa-con-iva/{ordenCompra.OCOMENCA_ID}", ordenCompleta);
            }
            else
            {
                // Crear nueva orden con IVA
                responseHttp = await repository.Post("api/ocomenca/crear-completa", ordenCompleta);
            }

            if (responseHttp.Error)
            {
                var errorMessage = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", errorMessage, SweetAlertIcon.Error);
                return;
            }

            // Mostrar mensaje de éxito
            var accion = IsEdit ? "actualizada" : "creada";
            await sweetAlertService.FireAsync("Éxito", 
                $"Orden de compra {accion} exitosamente con distribución de IVA", 
                SweetAlertIcon.Success);

            // Invocar callback de éxito
            await OnValidSubmit.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar orden con IVA: {ex.Message}");
            await sweetAlertService.FireAsync("Error", 
                $"Error inesperado al guardar la orden: {ex.Message}", 
                SweetAlertIcon.Error);
        }
    }

