@page "/seg-modulos/crear"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService

<PageTitle>Nuevo Módulo</PageTitle>
<h4><i class="fas fa-cubes me-2"></i>Nuevo Módulo de Seguridad</h4>
<hr />

<SegModuloForm @ref="form" Modulo="modulo" OnValidSubmit="CreateAsync" ReturnAction="Return" />

@code {
    private SegModulo modulo = new() { Activo = true, Orden = 0 };
    private SegModuloForm? form;

    private async Task CreateAsync()
    {
        var resp = await repository.Post<SegModulo>("api/SegModulos", modulo);
        if (resp.Error)
        {
            await sweetAlertService.FireAsync("Error", await resp.GetErrorMessageAsync(), SweetAlertIcon.Error);
            return;
        }
        Return();
    }

    private void Return()
    {
        form!.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/seg-modulos");
    }
}
