    async Task AgregarJoin()
    {
        var nuevoJoin = new JoinDTO();
        Joins.Add(nuevoJoin);
        StateHasChanged();
    }

    /// <summary>
    /// Evento que se dispara al cambiar la tabla de un join. Carga los campos de la tabla seleccionada desde el backend.
    /// </summary>
    async Task OnTablaJoinChanged(JoinDTO join)
    {
        if (!string.IsNullOrEmpty(join.Tabla) && TablaEntidadMapeo.TryGetValue(join.Tabla, out var nombreEntidad))
        {
            var responseCampos = await repository.Get<List<CampoDTO>>($"/api/metadata-reportes/campos?tabla={nombreEntidad}");
            join.CamposForanea = responseCampos.Response?.Select(c => c.Nombre).ToList() ?? new List<string>();
            // Limpiar selección previa
            join.CampoForanea = null;
        }
        else
        {
            join.CamposForanea = new List<string>();
            join.CampoForanea = null;
        }
        StateHasChanged();
    }

    void AgregarFiltro()
    {
        Filtros.Add(new FiltroDTO());
    }

    /// <summary>
    /// Maneja la selección/deselección de campos de la tabla del join para la vista previa
    /// </summary>
    /// <summary>
    /// Maneja la selección/deselección de campos en los joins y gestiona los diccionarios de formato y alias.
    /// </summary>
    void OnCampoJoinSeleccionadoChanged(JoinDTO join, string campo, object checkedValue)
    {
        bool seleccionado = checkedValue is bool b && b;
        if (seleccionado)
        {
            if (!join.CamposSeleccionados.Contains(campo))
                join.CamposSeleccionados.Add(campo);
            // Inicializa la entrada en los diccionarios si no existe
            if (!join.FormatosCampos.ContainsKey(campo))
                join.FormatosCampos[campo] = string.Empty;
            if (!join.AliasCampos.ContainsKey(campo))
                join.AliasCampos[campo] = string.Empty;
        }
        else
        {
            join.CamposSeleccionados.Remove(campo);
            // Limpia la entrada de los diccionarios para evitar referencias huérfanas
            if (join.FormatosCampos.ContainsKey(campo))
                join.FormatosCampos.Remove(campo);
            if (join.AliasCampos.ContainsKey(campo))
                join.AliasCampos.Remove(campo);
        }
    }

    void EliminarFiltro(FiltroDTO filtro)
    {
        Filtros.Remove(filtro);
    }

    /// <summary>
    /// Ejecuta la consulta SQL escrita en el input y obtiene la vista previa de resultados.
    /// </summary>
    /// <summary>
    /// Ejecuta la consulta SQL para vista previa, validando primero en el frontend que sea segura.
    /// </summary>
    async Task VistaPrevia()
    {
        // Validaciones en el frontend para mayor seguridad y mejor experiencia de usuario
        MensajeErrorVistaPrevia = string.Empty;
        var sql = ConsultaSQL?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(sql))
        {
            MensajeErrorVistaPrevia = "La consulta SQL no puede estar vacía.";
            VistaPreviaColumnas = new List<string>();
            VistaPreviaDatos = new List<Dictionary<string, object>>();
            return;
        }
        // Validación: solo se permite SELECT
        if (!sql.StartsWith("SELECT", StringComparison.OrdinalIgnoreCase))
        {
            MensajeErrorVistaPrevia = "Solo se permiten consultas SELECT para vista previa.";
            VistaPreviaColumnas = new List<string>();
            VistaPreviaDatos = new List<Dictionary<string, object>>();
            return;
        }
        // Validación robusta de palabras prohibidas usando expresión regular (insensible a mayúsculas/minúsculas)
        var palabrasProhibidas = new[] {"INSERT", "UPDATE", "DELETE", "DROP", "ALTER", "TRUNCATE", ";"};
        foreach (var palabra in palabrasProhibidas)
        {
            // Expresión regular para buscar la palabra como palabra completa, sin importar posición ni mayúsculas
            var regex = new System.Text.RegularExpressions.Regex($@"\b{palabra}\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (regex.IsMatch(sql))
            {
                MensajeErrorVistaPrevia = $"La consulta contiene la palabra prohibida '{palabra}'. Solo se permite SELECT.";
                VistaPreviaColumnas = new List<string>();
                VistaPreviaDatos = new List<Dictionary<string, object>>();
                return;
            }
        }
        // Guardar el SQL ejecutado para depuración
        ConsultaEjecutada = ConsultaSQL;
        // Armar el payload para el backend (solo el SQL)
        var payload = new SqlPreviewDTO { Sql = ConsultaSQL };
        // Llamar al backend usando el patrón repository y el endpoint de vista previa
        var response = await repository.Post<SqlPreviewDTO, List<Dictionary<string, object>>>(
            "/api/metadata-reportes/preview-sql", payload);
        VistaPreviaColumnas = (response.Response != null && response.Response.Any())
            ? response.Response.First().Keys.ToList()
            : new List<string>();
        VistaPreviaDatos = response.Response ?? new List<Dictionary<string, object>>();
    }

    /// <summary>
    /// Evento que detecta si el usuario editó manualmente el textarea de la consulta SQL.
    /// Si el usuario edita, se deja de actualizar automáticamente.
    /// </summary>
    /// <summary>
    /// Método que se ejecuta cuando el usuario edita el textarea de la consulta SQL.
    /// Marca el modo manual para evitar que la consulta se sobreescriba automáticamente.
    /// </summary>
    void OnConsultaSqlInput(ChangeEventArgs e)
    {
        ConsultaSQLManual = true;
    }

    /// <summary>
    /// Método para construir la consulta SQL según las selecciones actuales.
    /// Usa alias de tabla y respeta el orden SELECT ... FROM ... JOIN ... WHERE ...
    /// </summary>
    void ConstruirConsultaSQL()
    {
        if (ConsultaSQLManual) return; // Si el usuario editó manualmente, no sobrescribir
        if (string.IsNullOrEmpty(TablaPrincipal))
        {
            ConsultaSQL = "SELECT ...";
            return;
        }
        // Asignar alias a las tablas (t0, t1, t2, ...)
        var aliasPrincipal = "t0";
        var aliasJoins = new List<string>();
        for (int i = 0; i < Joins.Count; i++) aliasJoins.Add($"t{i + 1}");
        // Campos SELECT
        var campos = CamposTablaPrincipal.Where(c => c.Seleccionado)
            .Select(c => $"{aliasPrincipal}.{c.Nombre}").ToList();
        for (int i = 0; i < Joins.Count; i++)
        {
            var join = Joins[i];
            campos.AddRange(join.CamposSeleccionados.Select(campo => $"{aliasJoins[i]}.{campo}"));
        }
        var select = "SELECT " + (campos.Any() ? string.Join(", ", campos) : "*");
        // FROM
        var from = $"FROM {TablaPrincipal} {aliasPrincipal}";
        // JOINS
        var joinsSql = new List<string>();
        for (int i = 0; i < Joins.Count; i++)
        {
            var join = Joins[i];
            if (!string.IsNullOrEmpty(join.Tabla) && !string.IsNullOrEmpty(join.CampoPrincipal) && !string.IsNullOrEmpty(join.CampoForanea))
            {
                var tipoJoin = join.TipoJoin ?? "INNER";
                joinsSql.Add($"{tipoJoin} JOIN {join.Tabla} {aliasJoins[i]} ON {aliasPrincipal}.{join.CampoPrincipal} = {aliasJoins[i]}.{join.CampoForanea}");
            }
        }
        // WHERE y filtros
        var filtrosSql = new List<string>();
        foreach (var filtro in Filtros)
        {
            if (!string.IsNullOrEmpty(filtro.Campo) && !string.IsNullOrEmpty(filtro.Operador) && !string.IsNullOrEmpty(filtro.Valor))
            {
                // Buscar a qué tabla pertenece el campo
                var alias = aliasPrincipal;
                if (CamposTablaPrincipal.Any(c => c.Nombre == filtro.Campo))
                    alias = aliasPrincipal;
                else
                {
                    for (int i = 0; i < Joins.Count; i++)
                        if (Joins[i].CamposSeleccionados.Contains(filtro.Campo) || Joins[i].CamposForanea.Contains(filtro.Campo))
                            alias = aliasJoins[i];
                }
                filtrosSql.Add($"{alias}.{filtro.Campo} {filtro.Operador} '{filtro.Valor}'");
            }
        }
        var where = filtrosSql.Any() ? $"WHERE {string.Join(" AND ", filtrosSql)}" : string.Empty;
        // Armar la consulta final
        ConsultaSQL = $"{select} {from} {(joinsSql.Any() ? string.Join(" ", joinsSql) : "")} {where}".Trim();
    }

    // DTOs auxiliares
    /// <summary>
    /// DTO que representa un campo de una entidad, incluyendo información de formato
    /// </summary>
    public class CampoDTO
    {
        public string Nombre { get; set; }
        public string Tipo { get; set; }
        public string TipoFormato { get; set; } // "Decimal", "Texto", "Entero", etc.
        public int? Decimales { get; set; } // Solo para decimales
        public int? LongitudMaxima { get; set; } // Para texto y enteros
        public bool Seleccionado { get; set; }
        public string Formato { get; set; } // Formato personalizado elegido por el usuario
        public string Alias { get; set; }
    }
    public class JoinDTO
    {
        public string Tabla { get; set; }
        /// <summary>
        /// Campo seleccionado de la tabla principal para la unión
        /// </summary>
        public string CampoPrincipal { get; set; }
        /// <summary>
        /// Campo seleccionado de la tabla unida (foránea)
        /// </summary>
        public string CampoForanea { get; set; }
        /// <summary>
        /// Lista de campos de la tabla foránea (cargada dinámicamente)
        /// </summary>
        public List<string> CamposForanea { get; set; } = new List<string>();
        /// <summary>
        /// Tipo de join: LEFT, RIGHT, INNER
        /// </summary>
        public string TipoJoin { get; set; } = "INNER";
        /// <summary>
        /// Lista de campos seleccionados de la tabla del join para mostrar en la vista previa
        /// </summary>
        public List<string> CamposSeleccionados { get; set; } = new List<string>();
        /// <summary>
        /// Diccionario para almacenar el formato seleccionado por cada campo del join
        /// </summary>
        public Dictionary<string, string> FormatosCampos { get; set; } = new Dictionary<string, string>();
        /// <summary>
        /// Diccionario para almacenar el alias personalizado de cada campo del join
        /// </summary>
        public Dictionary<string, string> AliasCampos { get; set; } = new Dictionary<string, string>();
    }
    public class FiltroDTO
    {
        public string Campo { get; set; }
        public string Operador { get; set; } = "=";
        public string Valor { get; set; }
    }

    /// <summary>
    /// DTO para enviar el SQL directo al backend
    /// </summary>
    public class SqlPreviewDTO
    {
        public string Sql { get; set; }
    }
}

@code {
    // Variables para la consulta SQL
    string ConsultaSQL { get; set; } = "SELECT ...";
    string ConsultaEjecutada { get; set; } = string.Empty;
    bool ConsultaSQLManual { get; set; } = false;

    /// <summary>
    /// Propiedad auxiliar para el binding del textarea de SQL.
    /// Si el usuario edita el textarea, se marca el modo manual.
    /// </summary>
    string ConsultaSQLBinding
    {
        get => ConsultaSQL;
        set
        {
            if (ConsultaSQL != value)
            {
                ConsultaSQLManual = true; // El usuario editó manualmente
                ConsultaSQL = value;
            }
        }
    }

    // Lógica para actualizar la consulta SQL cuando cambian selecciones
    protected override void OnParametersSet()
    {
        ConstruirConsultaSQL();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            ConstruirConsultaSQL();
    }
    // Llamar a ConstruirConsultaSQL desde los eventos de cambio de selección
    /// <summary>
    /// Evento que se dispara al cambiar la tabla principal seleccionada.
    /// Utiliza el mapeo dinámico para obtener el nombre real de la entidad (clase) asociada a la tabla seleccionada.
    /// Luego consulta los campos de la entidad y los ordena alfabéticamente por nombre para su presentación.
    /// </summary>
    async Task OnTablaPrincipalChanged(ChangeEventArgs e)
    {
        TablaPrincipal = e.Value?.ToString();
        ConsultaSQLManual = false;
        if (!string.IsNullOrEmpty(TablaPrincipal) && TablaEntidadMapeo.TryGetValue(TablaPrincipal, out var nombreEntidad))
        {
            // Usar el nombre de la entidad real para consultar los campos
            var responseCampos = await repository.Get<List<CampoDTO>>($"/api/metadata-reportes/campos?tabla={nombreEntidad}");
            // Ordenamos los campos alfabéticamente por nombre
            // Mapeo completo de las propiedades para que el selector de formato funcione correctamente
            CamposTablaPrincipal = responseCampos.Response
                ?.Select(c => new CampoDTO
                {
                    Nombre = c.Nombre,
                    Tipo = c.Tipo,
                    TipoFormato = c.TipoFormato,
                    Decimales = c.Decimales,
                    LongitudMaxima = c.LongitudMaxima
                })
                .OrderBy(c => c.Nombre)
                .ToList();
        }
        else
        {
            CamposTablaPrincipal.Clear();
        }
        ConstruirConsultaSQL();
    }
    void OnCamposSeleccionadosChanged()
    {
        ConsultaSQLManual = false;
        ConstruirConsultaSQL();
    }
    void OnJoinsChanged()
    {
        ConsultaSQLManual = false;
        ConstruirConsultaSQL();
    }
    void OnFiltrosChanged()
    {
        ConsultaSQLManual = false;
        ConstruirConsultaSQL();
    }
}
