@page "/reportes/generador"
@using System.Reflection
@using System.Text.Json
@using IMPLANPROD.Shared
@using IMPLANPROD.Shared.DTOs
@inject IRepository repository
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider

<!--
Componente generador de reportes dinámico.
Permite seleccionar tablas, campos, definir uniones (joins), condiciones, formato de columnas y ver una vista previa del reporte.
Todos los comentarios y la documentación están en español para máxima claridad y mantenibilidad.
-->

<h3>Generador de Reportes</h3>

<div class="mb-3">
    <label>Seleccionar tabla principal:</label>
    @if (!TablasCargadas)
    {
        <div class="text-info">Cargando tablas...</div>
    }
    else if (!string.IsNullOrEmpty(MensajeErrorTablas))
    {
        <div class="text-danger">@MensajeErrorTablas</div>
    }
    else if (Tablas == null || !Tablas.Any())
    {
        <div class="text-warning">No hay tablas disponibles.</div>
    }
    else
    {
        <select @onchange="OnTablaPrincipalChanged" class="form-select">
            <option value="">-- Seleccionar --</option>
            @foreach (var tabla in Tablas)
            {
                <option value="@tabla">@tabla</option>
            }
        </select>
        <!-- Debug: Mostrar contenido de Tablas -->
        <div class="small text-muted">Tablas cargadas: @string.Join(", ", Tablas)</div>
    }
</div>

@if (!string.IsNullOrEmpty(TablaPrincipal))
{
    <div class="mb-3">
        <label>Seleccionar campos:</label>
        <div>
            @foreach (var campo in CamposTablaPrincipal)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" @bind="campo.Seleccionado" />
                    <label class="form-check-label">@campo.Nombre (@campo.Tipo)</label>
                </div>
            }
        </div>
    </div>
    <!-- Espacio para agregar joins con otras tablas -->
    <div class="mb-3">
        <label>Agregar joins con otras tablas:</label>
        @foreach (var join in Joins)
        {
            <div class="mb-2 border rounded p-2">
                <select @bind="join.Tabla" class="form-select mb-1">
                    <option value="">-- Seleccionar tabla --</option>
                    @foreach (var tabla in Tablas)
                    {
                        <option value="@tabla">@tabla</option>
                    }
                </select>
                <button class="btn btn-sm btn-info ms-2 mb-1" @onclick="async () => await OnTablaJoinChanged(join)">Cargar campos</button>
                @* El usuario debe pulsar este botón tras seleccionar la tabla para cargar los campos de la tabla unida. *@
                @if (!string.IsNullOrEmpty(join.Tabla))
                {
                    <label>Tipo de join:</label>
                    <select class="form-select mb-1" @bind="join.TipoJoin">
                        <option value="INNER">INNER JOIN</option>
                        <option value="LEFT">LEFT JOIN</option>
                        <option value="RIGHT">RIGHT JOIN</option>
                    </select>
                    <label>Campo de la tabla principal:</label>
                    <select class="form-select mb-1" @bind="join.CampoPrincipal">
                        <option value="">-- Seleccionar campo --</option>
                        @foreach (var campo in CamposTablaPrincipal)
                        {
                            <option value="@campo.Nombre">@campo.Nombre</option>
                        }
                    </select>
                    <label>Campo de la tabla unida:</label>
                    <select class="form-select mb-1" @bind="join.CampoForanea">
                        <option value="">-- Seleccionar campo --</option>
                        @foreach (var campo in join.CamposForanea)
                        {
                            <option value="@campo">@campo</option>
                        }
                    </select>
                    <label>Campos de la tabla del join para mostrar en la vista previa:</label>
                    <div class="mb-1">
                        @foreach (var campo in join.CamposForanea)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" value="@campo" @onchange="e => OnCampoJoinSeleccionadoChanged(join, campo, e.Value)
                " checked="@join.CamposSeleccionados.Contains(campo)" />
                                <label class="form-check-label">@campo</label>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        <button class="btn btn-secondary" @onclick="AgregarJoin">Agregar join</button>
    </div>
    <!-- Espacio para condiciones y filtros -->
    <div class="mb-3">
        <label>Condiciones / Filtros:</label>
        @foreach (var filtro in Filtros)
        {
            <div class="input-group mb-1">
                <select @bind="filtro.Campo" class="form-select">
                    <option value="">-- Campo --</option>
                    @foreach (var campo in CamposTablaPrincipal)
                    {
                        <option value="@campo.Nombre">@campo.Nombre</option>
                    }
                </select>
                <select @bind="filtro.Operador" class="form-select">
                    <option value="=">=</option>
                    <option value=">">&gt;</option>
                    <option value="<">&lt;</option>
                    <option value="LIKE">LIKE</option>
                </select>
                <input class="form-control" @bind="filtro.Valor" placeholder="Valor" />
                <button class="btn btn-danger" @onclick="() => EliminarFiltro(filtro)">X</button>
            </div>
        }
        <button class="btn btn-secondary" @onclick="AgregarFiltro">Agregar filtro</button>
    </div>
    <!-- Espacio para formato de columnas -->
    <div class="mb-3">
        <label>Formato de columnas:</label>
        <!-- Mostrar una fila para cada campo seleccionado de la tabla principal -->
        @foreach (var campo in CamposTablaPrincipal.Where(c => c.Seleccionado))
        {
            <div class="input-group mb-1">
                <span class="input-group-text">@campo.Nombre</span>
                <!-- Selector de formato sugerido según el tipo de campo -->
                <select class="form-select" @bind="campo.Formato">
                    <option value="">Sin formato</option>
                    @if (campo.TipoFormato == "Decimal")
                    {
                        <option value="decimal">Decimal</option>
                    }
                    @if (campo.TipoFormato == "Entero")
                    {
                        <option value="entero">Entero</option>
                    }
                    @if (campo.TipoFormato == "Texto")
                    {
                        <option value="texto">Texto</option>
                    }
                    @if (campo.TipoFormato == "DateTime")
                    {
                        <option value="fecha">Fecha</option>
                    }
                </select>
                <!-- Mostrar información de formato según el tipo -->
                @if (campo.TipoFormato == "Decimal" && campo.Decimales != null)
                {
                    <span class="input-group-text">Decimales: @campo.Decimales</span>
                }
                @if ((campo.TipoFormato == "Texto" || campo.TipoFormato == "Entero") && campo.LongitudMaxima != null)
                {
                    <span class="input-group-text">Longitud máx: @campo.LongitudMaxima</span>
                }
                <input class="form-control" @bind="campo.Alias" placeholder="Alias (opcional)" />
            </div>
        }
        <!-- Mostrar una fila para cada campo seleccionado de cada tabla unida (join) -->
        @foreach (var join in Joins)
        {
            if (join.CamposSeleccionados != null)
            {
                foreach (var campoJoin in join.CamposSeleccionados)
                {
                    <div class="input-group mb-1">
                        <span class="input-group-text">@campoJoin <span class="badge bg-secondary ms-1">@join.Tabla</span></span>
                        <!-- Selector de formato genérico para campos de joins -->
                        <select class="form-select" @bind="join.FormatosCampos[campoJoin]">
                            <option value="">Sin formato</option>
                            <option value="decimal">Decimal</option>
                            <option value="entero">Entero</option>
                            <option value="texto">Texto</option>
                            <option value="fecha">Fecha</option>
                        </select>
                        <input class="form-control" @bind="join.AliasCampos[campoJoin]" placeholder="Alias (opcional)" />
                    </div>
                }
            }
        }
        <!-- Fin de filas de formato para campos de joins -->
    </div>
    <!-- Input para editar/ver la consulta SQL generada -->
    <div class="mb-3">
        <label for="consultaSqlInput">Consulta SQL generada:</label>
        <textarea id="consultaSqlInput" class="form-control font-monospace" rows="5"
        @bind-value="ConsultaSQLBinding"
        @bind-value:event="oninput"
        placeholder="La consulta SQL se generará aquí automáticamente, pero puedes editarla si lo deseas."></textarea>
        <!--
        Usamos @bind-value con una propiedad get/set (ConsultaSQLBinding) para detectar ediciones manuales y marcar ConsultaSQLManual=true.
        Así evitamos el error de duplicidad de eventos y la consulta se actualiza en tiempo real.
        -->
        <!--
        Usamos @bind-value y @bind-value:event="oninput" para que el textarea actualice ConsultaSQL en tiempo real.
        El evento @oninput llama a OnConsultaSqlInput, que marca ConsultaSQLManual=true si el usuario edita manualmente.
        -->
        <small class="text-muted">Puedes editar la consulta manualmente. Si lo haces, dejará de actualizarse automáticamente.</small>
    </div>
    <!-- Vista previa del reporte -->
    <div class="mb-3">
        <button class="btn btn-primary mt-2" @onclick="VistaPrevia">Vista previa</button>
        @* Bloque de depuración para mostrar el último SQL ejecutado *@
        <div class="small text-muted">Consulta ejecutada: @ConsultaEjecutada</div>

        <!-- Bloque de alerta para mostrar mensajes de error de la vista previa, SIEMPRE visible si hay error -->
        @if (!string.IsNullOrEmpty(MensajeErrorVistaPrevia))
        {
            <div class="alert alert-danger">@MensajeErrorVistaPrevia</div>
        }
        @if (VistaPreviaDatos != null && VistaPreviaDatos.Any())
        {
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        @foreach (var col in VistaPreviaColumnas)
                        {
                            <th>@col</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in VistaPreviaDatos)
                    {
                        <tr>
                            @foreach (var col in VistaPreviaColumnas)
                            {
                                <td>@fila[col]</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {

    // Lista de tablas obtenidas del backend
    // Diccionario que asocia nombre de tabla física con nombre de entidad (clase), obtenido dinámicamente del backend
