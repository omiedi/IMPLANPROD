    List<CampoDTO> CamposTablaPrincipal = new();
    string MensajeErrorTablas = null;
    bool TablasCargadas = false;

    string MensajeErrorVistaPrevia = null;
    // Joins y filtros
    List<JoinDTO> Joins = new();
    List<FiltroDTO> Filtros = new();

    // Vista previa
    List<string> VistaPreviaColumnas;
    List<Dictionary<string, object>> VistaPreviaDatos;

    // Variable para mostrar el payload serializado en modo depuración
