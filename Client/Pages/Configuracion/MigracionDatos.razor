        }
        finally
        {
            loadingSecoprep = false;
        }
    }

    private async Task MigrateObsoprep()
    {
        try
        {
            loadingObsoprep = true;
            messageObsoprep = "";
            StateHasChanged();

            var response = await Repository.Post<object>($"api/Migration/obsoprep?basePath={Uri.EscapeDataString(migrationBasePath)}", new { });
            
            if (!response.Error)
