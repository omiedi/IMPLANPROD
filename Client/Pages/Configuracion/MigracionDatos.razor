@page "/configuracion/migracion"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "SUPERADMIN")]
@inject IMPLANPROD.Client.Repositories.IRepository Repository
@inject IJSRuntime JS

<div class="container-fluid mt-4">
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-primary text-white">
            <h6 class="m-0 font-weight-bold">Migración de Datos Legacy</h6>
        </div>
        <div class="card-body">
            <!-- Campo editable para la ruta de archivos -->
            <div class="card mb-4 border-primary">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="fas fa-folder-open me-2"></i>Ruta de Archivos .DAT</h6>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-10">
                            <label for="migrationBasePath" class="form-label"><strong>Carpeta de archivos legacy:</strong></label>
                            <input type="text" 
                                   class="form-control" 
                                   id="migrationBasePath" 
                                   @bind="migrationBasePath" 
                                   @bind:event="oninput"
                                   placeholder="Ej: C:\Users\Omar\source\repos\omardemaio\IMPLANPROD\Legacy_VB6\ArchivosDat" />
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Ingrese la ruta de la carpeta donde se encuentran los archivos .DAT. El sistema seleccionará automáticamente el archivo según la migración.
                            </small>
                        </div>
                        <div class="col-md-2 text-end">
                            <button class="btn btn-outline-primary btn-sm" @onclick="SavePath" title="Guardar ruta">
                                <i class="fas fa-save me-1"></i>Guardar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Tabla INDIREP</h5>
                            <p class="card-text">Migrar datos desde el archivo legacy <code>INDIREP.DAT</code> a la tabla SQL <code>INDIREP</code>.</p>
                            <p class="text-muted small">Nota: La migración solo se realizará si la tabla destino está vacía.</p>
                            
                            @if (loadingIndirep)
                            {
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="MigrateIndirep">
                                    <i class="fas fa-database me-2"></i> Iniciar Migración
                                </button>
                            }

                            @if (!string.IsNullOrEmpty(messageIndirep))
                            {
                                <div class="alert @alertClassIndirep mt-3" role="alert">
                                    @messageIndirep
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Tabla REPUESRE</h5>
                            <p class="card-text">Migrar datos desde el archivo legacy <code>REPUESRE.DAT</code> a la tabla SQL <code>REPUESRE</code>.</p>
                            <p class="text-muted small">Nota: La migración solo se realizará si la tabla destino está vacía.</p>
                            
                            @if (loadingRepuesre)
                            {
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="MigrateRepuesre">
                                    <i class="fas fa-database me-2"></i> Iniciar Migración
                                </button>
                            }

                            @if (!string.IsNullOrEmpty(messageRepuesre))
                            {
                                <div class="alert @alertClassRepuesre mt-3" role="alert">
                                    @messageRepuesre
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Tabla SECOPREP</h5>
                            
                            <div class="row">
                                <!-- Columna izquierda: Migración SECOPREP -->
                                <div class="col-md-6">
                                    <h6 class="text-primary mb-3">Migración SECOPREP</h6>
                                    <p class="card-text">Migrar datos desde el archivo legacy <code>SECOPREP.DAT</code> a la tabla SQL <code>SECOPREP</code>.</p>
                                    <p class="text-muted small">Nota: La migración solo se realizará si la tabla destino está vacía.</p>
                                    
                                    @if (loadingSecoprep)
                                    {
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Cargando...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary" @onclick="MigrateSecoprep">
                                            <i class="fas fa-database me-2"></i> Iniciar Migración
                                        </button>
                                    }

                                    @if (!string.IsNullOrEmpty(messageSecoprep))
                                    {
                                        <div class="alert @alertClassSecoprep mt-3" role="alert">
                                            @messageSecoprep
                                        </div>
                                    }
                                </div>

                                <!-- Columna derecha: Actualizar con OBSOPREP -->
                                <div class="col-md-6 border-start">
                                    <h6 class="text-warning mb-3">Actualizar con OBSOPREP</h6>
                                    <p class="card-text">Actualizar observaciones desde el archivo legacy <code>OBSOPREP.DAT</code> en la tabla SQL <code>SECOPREP</code>.</p>
                                    <p class="text-muted small">Nota: Esta migración debe ejecutarse DESPUÉS de migrar SECOPREP. Actualiza el campo Observacion.</p>
                                    <p class="text-warning small"><strong>Orden de ejecución, luego de migrar SECOPREP</strong></p>
                                    
                                    @if (loadingObsoprep)
                                    {
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Cargando...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning" @onclick="MigrateObsoprep">
                                            <i class="fas fa-sync-alt me-2"></i> Actualizar Observaciones
                                        </button>
                                    }

                                    @if (!string.IsNullOrEmpty(messageObsoprep))
                                    {
                                        <div class="alert @alertClassObsoprep mt-3" role="alert">
                                            @messageObsoprep
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="row mt-3">
                <!-- Card Migración PLAINSP -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Tabla PLAINSP</h5>
                            <p class="card-text">Migrar datos desde el archivo legacy <code>PLAINSP.DAT</code> a la tabla SQL <code>PLAINSP</code>.</p>
                            <p class="card-text text-muted small">
                                <strong>Archivo plano:</strong> 128 bytes por registro &mdash;
                                Contiene las dimensiones según plano, instrumento de medición y observaciones
                                de cada ítem de inspección, agrupados por código interno (<code>Cod_Inte</code>).
                            </p>
                            <p class="text-muted small">Nota: La migración solo se realizará si la tabla destino está vacía.</p>

                            @if (loadingPlainsp)
                            {
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="MigratePlainsp">
                                    <i class="fas fa-database me-2"></i> Iniciar Migración
                                </button>
                            }

                            @if (!string.IsNullOrEmpty(messagePlainsp))
                            {
                                <div class="alert @alertClassPlainsp mt-3" role="alert">
                                    @messagePlainsp
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Card Migración CODIPROC -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Tabla CODIPROC</h5>
                            <p class="card-text">Migrar datos desde el archivo legacy <code>CODIPROC.DAT</code> a la tabla SQL <code>CODIPROC</code>.</p>
                            <p class="card-text text-muted small">
                                <strong>Archivo plano:</strong> 512 bytes por registro &mdash;
                                Contiene códigos de proceso de inspección con AQL, nivel %, frecuencia,
                                puntos de detención y trazabilidad de preparación/aprobación.
                            </p>
                            <p class="text-muted small">Nota: La migración solo se realizará si la tabla destino está vacía.</p>

                            @if (loadingCodiproc)
                            {
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="MigrateCodiproc">
                                    <i class="fas fa-database me-2"></i> Iniciar Migración
                                </button>
                            }

                            @if (!string.IsNullOrEmpty(messageCodiproc))
                            {
                                <div class="alert @alertClassCodiproc mt-3" role="alert">
                                    @messageCodiproc
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <!-- Card Migración INSTRUCI -->
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Tabla INSTRUCI</h5>
                            <p class="card-text">Migrar datos desde el archivo legacy <code>INSTRUCI.DAT</code> a la tabla SQL <code>INSTRUCI</code>.</p>
                            <p class="card-text text-muted small">
                                <strong>Archivo plano:</strong> 128 bytes por registro &mdash;
                                Contiene instrucciones de proceso de inspección con código, descripción,
                                revisión y trazabilidad de preparación/aprobación. 31 registros.
                            </p>
                            <p class="text-muted small">Nota: La migración solo se realizará si la tabla destino está vacía.</p>

                            @if (loadingInstruci)
                            {
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick="MigrateInstruci">
                                    <i class="fas fa-database me-2"></i> Iniciar Migración
                                </button>
                            }

                            @if (!string.IsNullOrEmpty(messageInstruci))
                            {
                                <div class="alert @alertClassInstruci mt-3" role="alert">
                                    @messageInstruci
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Card Actualizar Observaciones desde INSTRUCD -->
                <div class="col-md-6">
                    <div class="card border-warning">
                        <div class="card-body">
                            <h5 class="card-title">Actualizar Observaciones desde INSTRUCD</h5>
                            <p class="card-text">Carga el cuerpo de texto de cada instrucción desde <code>INSTRUCD.DAT</code> y lo almacena en <code>INSTRUCI.Observaciones</code>.</p>
                            <p class="card-text text-muted small">
                                <strong>Archivo plano:</strong> 128 bytes por registro &mdash;
                                2 bytes <code>Cod_Inte</code> (CVI) + 126 bytes de texto. 2.514 líneas en 29 documentos.
                            </p>
                            <p class="text-warning small"><strong>Orden de ejecución: ejecutar DESPUÉS de migrar INSTRUCI.</strong></p>

                            @if (loadingInstrucd)
                            {
                                <div class="spinner-border text-warning" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-warning" @onclick="MigrateInstrucd">
                                    <i class="fas fa-sync-alt me-2"></i> Actualizar Observaciones
                                </button>
                            }

                            @if (!string.IsNullOrEmpty(messageInstrucd))
                            {
                                <div class="alert @alertClassInstrucd mt-3" role="alert">
                                    @messageInstrucd
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Card Migración INSTRUME -->
                <div class="col-xl-6 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        Tabla INSTRUME (Instrumentos)
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                                        Migrar Instrumentos
                                    </div>
                                    <p class="text-muted small mt-2">Migra datos desde <code>INSTRUME.DAT</code> a la tabla <code>INSTRUME</code>. Incluye código, descripción, marca, modelo, serie, rango, ubicación e intervalos de calibración.</p>

                                    @if (loadingInstrume)
                                    {
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Cargando...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary" @onclick="MigrateInstrume">
                                            <i class="fas fa-tools me-2"></i> Iniciar Migración
                                        </button>
                                    }

                                    @if (!string.IsNullOrEmpty(messageInstrume))
                                    {
                                        <div class="alert @alertClassInstrume mt-3" role="alert">
                                            @messageInstrume
                                        </div>
                                    }
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-ruler-combined fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card Migración OBINSTRU (Observaciones de Instrumentos) -->
                <div class="col-xl-6 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                        Tabla INSTRUME - Observaciones
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                                        Actualizar Observaciones de Instrumentos
                                    </div>
                                    <p class="text-muted small mt-2">Migra observaciones desde <code>OBINSTRU.DAT</code> y las asigna a los registros de <code>INSTRUME</code> según <code>CodIntMedIdent</code>. Ejecutar después de migrar INSTRUME.</p>

                                    @if (loadingObInstru)
                                    {
                                        <div class="spinner-border text-warning" role="status">
                                            <span class="visually-hidden">Cargando...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning" @onclick="MigrateObInstru">
                                            <i class="fas fa-sync-alt me-2"></i> Actualizar Observaciones
                                        </button>
                                    }

                                    @if (!string.IsNullOrEmpty(messageObInstru))
                                    {
                                        <div class="alert @alertClassObInstru mt-3" role="alert">
                                            @messageObInstru
                                        </div>
                                    }
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-comment-alt fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card Migración DESCREP -->
                <div class="col-xl-6 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                        4. Tabla DESCREP (Descripciones)
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">
                                        Migrar Descripciones
                                    </div>
                                    <p class="text-muted small mt-2">Migra datos desde <code>DESCREP.DAT</code> a la tabla <code>DESCREP</code>. Concatena líneas de texto.</p>
                                    
                                    @if (loadingDescrep)
                                    {
                                        <div class="spinner-border text-info" role="status">
                                            <span class="visually-hidden">Cargando...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-info text-white" @onclick="MigrateDescrep">
                                            <i class="fas fa-file-alt me-2"></i> Iniciar Migración
                                        </button>
                                    }

                                    @if (!string.IsNullOrEmpty(messageDescrep))
                                    {
                                        <div class="alert @alertClassDescrep mt-3" role="alert">
                                            @messageDescrep
                                        </div>
                                    }
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-align-left fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card Migración BRECEPEN -->
                <div class="col-12 mb-4">
                    <div class="card shadow">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0"><i class="fas fa-boxes me-2"></i>Tabla BRECEPEN (Stock Recepción Pendiente)</h6>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">Migra datos desde <code>BRECEPEN.DAT</code> a la tabla <code>BRECEPEN</code>. Solo migra registros con saldo pendiente > 0.05.</p>
                            <p class="text-muted small">Nota: La migración solo se realizará si la tabla destino está vacía.</p>
                            
                            <div class="mb-3">
                                @if (loadingPreviewBrecepen)
                                {
                                    <button class="btn btn-info" disabled>
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        Cargando datos...
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-info" @onclick="PreviewBrecepen">
                                        <i class="fas fa-eye me-2"></i> Mostrar datos a migrar
                                    </button>
                                }
                            </div>

                            @if (brecepenPreviewData != null && brecepenPreviewData.Any())
                            {
                                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                    <table class="table table-striped table-sm table-bordered">
                                        <thead class="table-dark sticky-top">
                                            <tr>
                                                <th>Fecha</th>
                                                <th>CodInte</th>
                                                <th>IdLote</th>
                                                <th>CodMovi</th>
                                                <th>DopriCor</th>
                                                <th>DoseCor</th>
                                                <th>ReferCor</th>
                                                <th>Depo</th>
                                                <th>Prov</th>
                                                <th>Ingreso</th>
                                                <th>Salida</th>
                                                <th>Saldo</th>
                                                <th>Migrar</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in brecepenPreviewData)
                                            {
                                                <tr class="@(item.Migrar ? "table-success" : "table-secondary")">
                                                    <td>@item.Fecha</td>
                                                    <td>@item.CodInte</td>
                                                    <td>@item.IdLote</td>
                                                    <td>@item.CodMovi</td>
                                                    <td>@item.DopriCor</td>
                                                    <td>@item.DoseCor</td>
                                                    <td>@item.ReferCor</td>
                                                    <td>@item.DepoMovi</td>
                                                    <td>@item.NumeProv</td>
                                                    <td>@item.CantIngre</td>
                                                    <td>@item.CantSalid</td>
                                                    <td>@item.Saldo</td>
                                                    <td>
                                                        @if (item.Migrar)
                                                        {
                                                            <i class="fas fa-check text-success"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-times text-danger"></i>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <p class="text-muted small mt-2">
                                    <strong>Total registros:</strong> @brecepenPreviewData.Count() | 
                                    <strong>A migrar:</strong> @brecepenPreviewData.Count(x => x.Migrar)
                                </p>
                            }

                            <div class="mt-3">
                                @if (loadingBrecepen)
                                {
                                    <button class="btn btn-success" disabled>
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        Migrando...
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-success" @onclick="MigrateBrecepen">
                                        <i class="fas fa-database me-2"></i> Iniciar Migración
                                    </button>
                                }

                                @if (!string.IsNullOrEmpty(messageBrecepen))
                                {
                                    <div class="alert @alertClassBrecepen mt-3" role="alert">
                                        @messageBrecepen
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool loadingIndirep = false;
    private string messageIndirep = "";
    private string alertClassIndirep = "alert-info";

    private bool loadingRepuesre = false;
    private string messageRepuesre = "";
    private string alertClassRepuesre = "alert-info";

    private bool loadingSecoprep = false;
    private string messageSecoprep = "";
    private string alertClassSecoprep = "alert-info";

    private bool loadingObsoprep = false;
    private string messageObsoprep = "";
    private string alertClassObsoprep = "alert-info";

    private bool loadingDescrep = false;
    private string messageDescrep = "";
    private string alertClassDescrep = "alert-info";

    private bool loadingCodiproc = false;
    private string messageCodiproc = "";
    private string alertClassCodiproc = "alert-info";

    private bool loadingPlainsp = false;
    private string messagePlainsp = "";
    private string alertClassPlainsp = "alert-info";

    private bool loadingInstruci = false;
    private string messageInstruci = "";
    private string alertClassInstruci = "alert-info";

    private bool loadingInstrucd = false;
    private string messageInstrucd = "";
    private string alertClassInstrucd = "alert-info";

    private bool loadingInstrume = false;
    private string messageInstrume = "";
    private string alertClassInstrume = "alert-info";

    private bool loadingObInstru = false;
    private string messageObInstru = "";
    private string alertClassObInstru = "alert-info";

    private bool loadingBrecepen = false;
    private string messageBrecepen = "";
    private string alertClassBrecepen = "alert-info";

    private bool loadingPreviewBrecepen = false;
    private List<IMPLANPROD.Shared.DTOs.BrecepenPreviewDTO> brecepenPreviewData = new List<IMPLANPROD.Shared.DTOs.BrecepenPreviewDTO>();

    // Ruta base para archivos de migración
    private string migrationBasePath = @"C:\Users\Omar\source\repos\omardemaio\IMPLANPROD\Legacy_VB6\ArchivosDat";
    private const string STORAGE_KEY = "migrationBasePath";

    protected override async Task OnInitializedAsync()
    {
        // Cargar ruta desde localStorage
        try
        {
            var savedPath = await JS.InvokeAsync<string>("localStorage.getItem", STORAGE_KEY);
            if (!string.IsNullOrEmpty(savedPath))
            {
                migrationBasePath = savedPath;
            }
        }
        catch
        {
            // Si falla, usar ruta por defecto
        }
    }

    private async Task SavePath()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", STORAGE_KEY, migrationBasePath);
            await JS.InvokeVoidAsync("alert", "Ruta guardada correctamente");
        }
        catch (Exception ex)
        {
