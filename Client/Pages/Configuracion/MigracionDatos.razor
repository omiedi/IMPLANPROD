        }
        finally
        {
            loadingObsoprep = false;
        }
    }

    private async Task MigrateDescrep()
    {
        try
        {
            loadingDescrep = true;
            messageDescrep = "";
            StateHasChanged();

            var response = await Repository.Post<object>($"api/Migration/descrep?basePath={Uri.EscapeDataString(migrationBasePath)}", new { });
            
            if (!response.Error)
            {
                var content = await response.HttpResponseMessage.Content.ReadAsStringAsync();
                alertClassDescrep = "alert-success";
                messageDescrep = content;
            }
            else
            {
                var content = await response.HttpResponseMessage.Content.ReadAsStringAsync();
                alertClassDescrep = "alert-danger";
                messageDescrep = $"Error: {content}";
            }
        }
        catch (Exception ex)
        {
            alertClassDescrep = "alert-danger";
            messageDescrep = $"Error de conexión: {ex.Message}";
        }
        finally
        {
            loadingDescrep = false;
        }
    }
}
