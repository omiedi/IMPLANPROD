@page "/perfiles"
@using IMPLANPROD.Shared.Entities
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<h3>Listado de Perfiles</h3>

@if (cargando)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="CrearPerfil">
            <i class="oi oi-plus"></i> Nuevo Perfil
        </button>
    </div>

    @if (perfiles == null || !perfiles.Any())
    {
        <div class="alert alert-info">No hay perfiles registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Permisos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var perfil in perfiles)
                    {
                        <tr>
                            <td>@perfil.Nombre</td>
                            <td>@perfil.Descripcion</td>
                            <td>
                                @if (perfil.Permisos != null && perfil.Permisos.Any())
                                {
                                    <button class="btn btn-sm btn-info" @onclick="() => MostrarPermisos(perfil)">
                                        Ver Permisos (@perfil.Permisos.Count)
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">Sin permisos</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary me-1" @onclick="() => EditarPerfil(perfil.Id)">
                                    <i class="oi oi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarEliminar(perfil)">
                                    <i class="oi oi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (perfilSeleccionado != null && mostrarModalPermisos)
{
    <div class="modal fade show" style="display:block; background-color: rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #1F7246; color: white;">
                    <h5 class="modal-title">Permisos de @perfilSeleccionado.Nombre</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalPermisos"></button>
                </div>
                <div class="modal-body">
                    @if (perfilSeleccionado.Permisos != null && perfilSeleccionado.Permisos.Any())
                    {
                        <ul class="list-group">
                            @foreach (var permiso in perfilSeleccionado.Permisos)
                            {
                                <li class="list-group-item">
                                    <strong>@permiso.Nombre</strong>
                                    <br />
                                    <small class="text-muted">@permiso.Descripcion</small>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="alert alert-info">Este perfil no tiene permisos asignados.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalPermisos">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Perfil>? perfiles;
    private bool cargando = true;
    private Perfil? perfilSeleccionado;
    private bool mostrarModalPermisos;

    protected override async Task OnInitializedAsync()
    {
        await CargarPerfiles();
    }

    private async Task CargarPerfiles()
    {
        try
        {
            perfiles = await Http.GetFromJsonAsync<List<Perfil>>("api/Perfiles");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar perfiles: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void CrearPerfil()
    {
        NavigationManager.NavigateTo("/perfiles/crear");
    }

    private void EditarPerfil(int id)
    {
        NavigationManager.NavigateTo($"/perfiles/editar/{id}");
    }

    private async Task ConfirmarEliminar(Perfil perfil)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Está seguro que desea eliminar el perfil {perfil.Nombre}?"))
        {
            await EliminarPerfil(perfil.Id);
        }
    }

    private async Task EliminarPerfil(int id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Perfiles/{id}");
            if (response.IsSuccessStatusCode)
            {
                await CargarPerfiles();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar perfil: {ex.Message}");
        }
    }

    private void MostrarPermisos(Perfil perfil)
    {
        perfilSeleccionado = perfil;
        mostrarModalPermisos = true;
    }

    private void CerrarModalPermisos()
    {
        mostrarModalPermisos = false;
        perfilSeleccionado = null;
    }
}
