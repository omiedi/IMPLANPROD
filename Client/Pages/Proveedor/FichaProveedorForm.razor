@page "/ficha-proveedor-form/{Id:int?}"
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Shared.Entities
@inject IRepository repository
@inject NavigationManager NavigationManager
@inject SweetAlertService sweetAlertService
@inject PageAccessService PageAccess

<!--
    Componente: FichaProveedorForm.razor
    Descripción: Formulario reutilizable para crear y editar proveedores (entidad Proved12).
    Basado en FichaClienteForm.razor, adaptado para proveedores.
    Autor: IA Cascade (solicitud de Omar)
    Fecha: 23/04/2025
    Sigue el estándar ABM y el patrón repository del proyecto.
-->

<style>
    /* Estilo uniforme para todos los inputs de la cabecera */
    .cabecera-input {
        height: 38px !important;
        border: 2px solid #6c757d !important;
        border-radius: 0.25rem !important;
        font-size: 1em;
        background-color: #fff;
        box-shadow: none;
    }
    .tab-btn {
        border: none;
        background: none;
        padding: 10px 30px;
        font-weight: 600;
        font-size: 1.1em;
        color: #495057;
        border-bottom: 3px solid transparent;
        transition: color 0.2s, border-bottom 0.2s;
    }
    .tab-btn.active, .tab-btn:focus {
        color: #198754;
        border-bottom: 3px solid #198754;
        background: #f8f9fa;
    }
    .tab-btn:hover {
        color: #146c43;
    }
    .tab-content-custom {
        background: #fff;
        border: 1px solid #dee2e6;
        border-top: none;
        border-radius: 0 0 0.5rem 0.5rem;
        padding: 2rem 1.5rem 1.5rem 1.5rem;
        min-height: 350px;
    }
</style>

<div class="container-fluid">
    <div class="card mb-3">
        <!-- Cabecera visualmente mejorada -->
        <div class="card-header bg-light border-bottom-0">
            <div class="row align-items-center g-2">
                <!-- Nro de Id -->
                <div class="col-auto" style="min-width:120px;max-width:140px;">
                    <label class="fw-bold small text-secondary">Id</label>
                    <input type="text" class="form-control cabecera-input" style="font-weight:bold;" @bind="Proveedor.Id" disabled />
                </div>
                <!-- Nro de Proveedor reducido -->
                <div class="col-auto" style="min-width:120px;max-width:140px;">
                    <label class="fw-bold small text-secondary">Nro Proveedor</label>
                    <input type="text" class="form-control cabecera-input" style="font-weight:bold;" @bind="Proveedor.Nume_Cli" disabled />
                </div>
                <!-- Código de Proveedor reducido -->
                <div class="col-auto" style="min-width:120px;max-width:140px;">
                    <label class="fw-bold small text-secondary">Código</label>
                    <input type="text" class="form-control cabecera-input" @bind="Proveedor.Codi_Cli" readonly />
                </div>
                <!-- Razón Social más amplia -->
                <div class="col flex-grow-1">
                    <label class="fw-bold small text-secondary">Razón Social</label>
                    <input type="text" class="form-control cabecera-input" @bind="Proveedor.Raso_Cli" required maxlength="100" style="min-width:250px; font-size:1.1em; font-weight:bold;" />
                </div>
            </div>
        </div>
        <!-- Botones separados, con estilo y espacio -->
        <div class="card-header bg-white border-bottom-0 pt-2 pb-3 d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary px-4" @onclick="VolverListado">
                <i class="fas fa-arrow-left"></i> Regresar
            </button>
            <button class="btn btn-success px-4" title="Guardar" @onclick="GuardarAsync">
                <i class="fas fa-save"></i> Guardar
            </button>
        </div>
    </div>

    @* Solapas mejoradas visualmente y funcionales con Blazor *@
    <div class="d-flex border-bottom mb-0" style="background:#f8f9fa;">
        <button class="tab-btn @(activeTab == 0 ? "active" : "")" @onclick="() => CambiarTab(0)">Datos</button>
        <button class="tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => CambiarTab(1)">Notas</button>
    </div>
    <div class="tab-content-custom">
        @if (activeTab == 0)
        {
            <!-- Contenido de la ficha de proveedor (Datos) -->
            <EditForm Model="Proveedor" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <!-- Sección de Domicilio -->
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>DOMICILIO</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Calle y Número:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" @bind="Proveedor.Domi_Cli" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">País:</label>
                                    <div class="col-sm-9">
                                        <select class="form-select" @onchange="OnPaisChanged">
                                            <option value="">Seleccione...</option>
                                            @if (Paises != null)
                                            {
                                                foreach (var pais in Paises)
                                                {
                                                    <option value="@pais.Name" selected="@(Proveedor.Pais_Cli == pais.Name)">@pais.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Provincia:</label>
                                    <div class="col-sm-9">
                                        <select class="form-select" @onchange="OnProvinciaChanged">
                                            <option value="">Seleccione...</option>
                                            @if (Provincias != null)
                                            {
                                                foreach (var prov in Provincias)
                                                {
                                                    <option value="@prov.Name" selected="@(Proveedor.Prov_Cli == prov.Name)">@prov.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Localidad:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" @bind="Proveedor.Loca_Cli" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Código Postal:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" @bind="Proveedor.Cpos_Cli" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Nombre de Fantasía:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" @bind="Proveedor.Fant_Cli" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Sección de Agenda -->
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5>AGENDA</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Teléfono:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" @bind="Proveedor.Tele_Cli" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Fax:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" @bind="Proveedor.Faxi_Cli" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">E-Mail:</label>
                                    <div class="col-sm-9">
                                        <input type="email" class="form-control" @bind="Proveedor.Mail_Cli" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Contacto:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" @bind="Proveedor.Ctac_Cli" />
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <label class="col-sm-3 col-form-label">Horario:</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" @bind="Proveedor.Hora_Cli" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Frame de IMPUESTOS -->
                <div class="card mb-3">
                    <div class="card-header bg-light fw-bold">Impuestos</div>
                    <div class="card-body">
                        <div class="row mb-3 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Posición IVA</label>
                                <select class="form-select" @bind="Proveedor.Piva_Cli">
                                    <option value="">Seleccione...</option>
                                    @foreach (TipoIvaEnum tipo in Enum.GetValues(typeof(TipoIvaEnum)))
                                    {
                                        <option value="@((int)tipo)">@((int)tipo) - @ObtenerDescripcionIva(tipo)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">@ObtenerLabelCuit(Proveedor.Piva_Cli)</label>
                                <input type="text" class="form-control" @bind="Proveedor.Cuit_Cli" maxlength="24" />
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        }
        else if (activeTab == 1)
        {
            <!-- TextArea enlazado a Nota_Cli -->
            <div class="mb-3">
                <label for="notaProv" class="form-label fw-bold">Notas del Proveedor</label>
                <textarea id="notaProv" class="form-control" style="width:100%;height:50vh;resize:vertical;font-size:1.1em;" @bind="Proveedor.Nota_Cli" placeholder="Escriba aquí las notas del proveedor..."></textarea>
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Modelo de proveedor para crear o editar
    /// </summary>
    private Proved12 Proveedor { get; set; } = new();
    private int activeTab = 0; // 0: Datos, 1: Notas
    [Parameter]
    public int Id { get; set; }
    /// <summary>
    /// Cambia la pestaña activa (0: Datos, 1: Notas)
    /// </summary>
    private void CambiarTab(int tab)
    {
        activeTab = tab;
    }

    /// <summary>
    /// Guarda el proveedor (nuevo o editado) usando el patrón repository
    /// </summary>
    private async Task GuardarAsync()
    {
        try
        {
            if (Proveedor.Id == 0)
            {
                await repository.Post("/api/Proved12", Proveedor);
            }
            else
            {
                // El endpoint PUT requiere el id en la URL según el controlador
                await repository.Put($"/api/Proved12/{Proveedor.Id}", Proveedor);
            }
            await sweetAlertService.FireAsync("Éxito", "Proveedor guardado correctamente", SweetAlertIcon.Success);
            VolverListado();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

    /// <summary>
    /// Navega al listado principal de proveedores
    /// </summary>
    private void VolverListado()
    {
        NavigationManager.NavigateTo("/ficha-proveedor-index");
    }

    // Listas para combos de país y provincia
    private List<Country> Paises = new();
    private List<State> Provincias = new();

    // Indica si la página está en modo edición
    private bool isEdit => Id > 0;
    // Indica si se está cargando información (útil para mostrar spinners o deshabilitar botones)
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await PageAccess.RequiereAccesoAsync("/ficha-proveedor-form");   // ? validación
        Paises = (await repository.Get<List<Country>>("/api/countries/combo")).Response ?? new List<Country>();
        if (!string.IsNullOrEmpty(Proveedor.Pais_Cli))
        {
            var pais = Paises.FirstOrDefault(x => x.Id.ToString() == Proveedor.Pais_Cli);
            if (pais != null)
                await CargarProvincias(pais.Id);
        }
        else
        {
            Provincias.Clear();
        }
        if (isEdit)
        {
            isLoading = true;
            var response = await repository.Get<Proved12>($"/api/proved12/{Id}");
            if (response.Response != null)
                Proveedor = response.Response;
            else
                await sweetAlertService.FireAsync("Error", "No se encontró el proveedor para editar.", SweetAlertIcon.Error);
            isLoading = false;
            // Si el proveedor ya tiene país, cargar provincias
            if (!string.IsNullOrEmpty(Proveedor.Pais_Cli))
            {
                var pais = Paises.FirstOrDefault(x => x.Name == Proveedor.Pais_Cli);
                if (pais != null)
                    await CargarProvincias(pais.Id);
            }
        }
    }

    // /// <summary>
    // /// Evento para cargar provincias al cambiar país y guardar el texto en el modelo
    // /// </summary>
    // private async Task OnPaisChanged(ChangeEventArgs e)
    // {
    //     var paisSeleccionado = e.Value?.ToString();
    //     Proveedor.Pais_Cli = paisSeleccionado;
    //     var pais = Paises.FirstOrDefault(x => x.Id.ToString() == paisSeleccionado);
    //     if (pais != null)
    //     {
    //         await CargarProvincias(pais.Id);
    //     }
    //     else
    //     {
    //         Provincias.Clear();
    //         Proveedor.Prov_Cli = null;
    //     }
    // }

    // /// <summary>
    // /// Evento para guardar el texto de la provincia seleccionada
    // /// </summary>
    // private void OnProvinciaChanged(ChangeEventArgs e)
    // {
    //     Proveedor.Prov_Cli = e.Value?.ToString();
    // }
    // Evento para cargar provincias al cambiar país y guardar el texto en el modelo
    private async Task OnPaisChanged(ChangeEventArgs e)
    {
        var paisSeleccionado = e.Value?.ToString();
        Proveedor.Pais_Cli = paisSeleccionado;
        var pais = Paises.FirstOrDefault(x => x.Name == paisSeleccionado);
        if (pais != null)
        {
            await CargarProvincias(pais.Id);
        }
        else
        {
            Provincias.Clear();
            Proveedor.Prov_Cli = null;
        }
    }

    // Evento para guardar el texto de la provincia seleccionada
    private void OnProvinciaChanged(ChangeEventArgs e)
    {
        Proveedor.Prov_Cli = e.Value?.ToString();
    }

    /// <summary>
    /// Método auxiliar para cargar provincias por país
    /// </summary>
    private async Task CargarProvincias(int paisId)
    {
        Provincias = (await repository.Get<List<State>>($"/api/states/combo/{paisId}")).Response ?? new List<State>();
        StateHasChanged();
    }
    
    // Método para obtener la descripción legible del enum TipoIvaEnum
    private string ObtenerDescripcionIva(TipoIvaEnum tipo)
    {
        return tipo switch
        {
            TipoIvaEnum.ConsumidorFinal => "A CONSUMIDOR FINAL",
            TipoIvaEnum.IvaResponsableInscripto => "IVA RESPONSABLE INSCRIPTO",
            TipoIvaEnum.IvaResponsableNoInscripto => "IVA RESPONSABLE NO INSCRIPTO",
            TipoIvaEnum.IvaNoResponsable => "IVA NO RESPONSABLE",
            TipoIvaEnum.IvaExento => "IVA EXENTO",
            TipoIvaEnum.ComercioExterior => "OPs.COMERCIO EXTERIOR",
            TipoIvaEnum.Monotributo => "CONTRIBUYENTE MONOTRIBUTO",
            TipoIvaEnum.ExentoZonaPromovida => "EXENTO - ZONA PROMOVIDA",
            _ => tipo.ToString()
        };
    }

    // Método para obtener el label dinámico del campo CUIT según la posición de IVA
    private string ObtenerLabelCuit(object? piva)
    {
        // Si el valor es null o vacío, mostrar CUIT por defecto
        if (piva == null) return "CUIT:";
        int valor;
        if (!int.TryParse(piva.ToString(), out valor)) return "CUIT:";
        if (valor == (int)TipoIvaEnum.ConsumidorFinal)
            return "Doc.No:";
        else if (valor == (int)TipoIvaEnum.ComercioExterior)
            return "R.U.C.:";
        else
            return "CUIT:";
    }

