@page "/ficha-proveedor-edit/{Id:int}"
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Shared.Entities
@using Microsoft.AspNetCore.Components
@inject PageAccessService PageAccess

<!--
    Componente: FichaProveedorEdit.razor
    Descripción: Página para editar un proveedor utilizando el formulario reutilizable.
    Autor: IA Cascade (solicitud de Omar)
    Fecha: 22/04/2025
    Sigue el estándar ABM del proyecto.
-->

<!-- Este archivo es una copia adaptada de FichaClienteEdit.razor para proveedores -->
<!-- Aquí irá la edición de proveedores usando la entidad Proved12 -->
<PageTitle>Editar Proveedor</PageTitle>
@if (validando)
{
    <p>Validando acceso...</p>
}
else
{
   <FichaProveedorForm Id="@Id" />
}


@code {
    private bool validando = true;
    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await PageAccess.RequiereAccesoAsync("/ficha-proveedor-edit/");   // ? validación
        validando = false;
    }
}

