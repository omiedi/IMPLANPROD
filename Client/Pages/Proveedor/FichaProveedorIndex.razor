@page "/ficha-proveedor-index"
@using IMPLANPROD.Client.Services
@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Pages.Reportes
@inject IRepository repository
@inject NavigationManager NavigationManager
@inject SweetAlertService sweetAlertService
@inject PageAccessService PageAccess

<PageTitle>Ficha de Proveedores</PageTitle>

<!--
    Componente: FichaProveedorIndex.razor
    Descripción: Listado paginado de proveedores activos (Stat_Cli >= 0) con opción de editar y dar de baja.
    Autor: IA Cascade (solicitud de Omar)
    Fecha: 22/04/2025
    Sigue el estándar ABM y el patrón repository del proyecto.
-->

<div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-3">
    <h3 class="m-0 text-primary">Lista de Proveedores</h3>
</div>
<div class="mb-3">
    <button class="btn btn-primary" @onclick="NuevoProveedor">
        <i class="fas fa-plus"></i> Nuevo Proveedor
    </button>
    <button class="btn btn-secondary ms-2" @onclick="IrABajas">
        <i class="fas fa-trash-alt"></i> Proveedores dados de baja
    </button>
    <button class="btn btn-success ms-2" @onclick="MostrarImpresion" disabled="@(Proveedores == null || !Proveedores.Any())">
        <i class="fas fa-print"></i> Imprimir/Excel
    </button>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <input class="form-control" placeholder="Buscar por Código o Razón Social..." @bind="Filter" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-outline-secondary" @onclick="()=>LoadAsync(1)"><i class="fas fa-search"></i> Buscar</button>
    </div>
</div>

<div class="text-muted" style="font-size: 0.85rem; margin-top: -0.5rem;">
    Podés combinar términos con <b>+</b> para exigir coincidencia de ambos (AND). Ej: <code>1001 + perez</code>
</div>

@if (isLoading)
{
    <p>Cargando...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nro Proveedor</th>
                <th>Razón Social</th>
                <th>Domicilio</th>
                <th>Teléfono</th>
                <th>Mail</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Proveedores != null && Proveedores.Count > 0)
            {
                @foreach (var proveedor in Proveedores)
                {
                    <tr>
                        <td>@proveedor.Nume_Cli</td>
                        <td>@proveedor.Raso_Cli</td>
                        <td>@proveedor.Domi_Cli</td>
                        <td>@proveedor.Tele_Cli</td>
                        <td>@proveedor.Mail_Cli</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditarProveedor(proveedor.Id)"><i class="fas fa-edit"></i> Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DarDeBajaProveedor(proveedor.Id)"><i class="fas fa-trash-alt"></i> Dar de baja</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6">No hay proveedores para mostrar.</td></tr>
            }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center">
        <button class="btn btn-outline-secondary" @onclick="()=>LoadAsync(PaginaActual-1)" disabled="@(PaginaActual == 1)">Anterior</button>
        <span>Página @PaginaActual de @TotalPaginas</span>
        <button class="btn btn-outline-secondary" @onclick="()=>LoadAsync(PaginaActual+1)" disabled="@(PaginaActual == TotalPaginas)">Siguiente</button>
    </div>
}

@* Componente de impresión *@
@if (Proveedores != null && Proveedores.Any())
{
    <ImpresionLista TItem="Proved12"
                    Datos="Proveedores"
                    Titulo="@TituloReporte"
                    UrlExportarExcel="api/Excel/exportar-proveedores"
                    Encabezados="encabezadosProveedores"
                    ModoDirecto="false"
                    MostrarModal="mostrarModalImpresion"
                    OnCerrar="ResetearImpresion" />
}

@code {
    /// <summary>
    /// Lista de proveedores activos
    /// </summary>
    private List<Proved12> Proveedores = new();
    private int PaginaActual = 1;
    private int TotalPaginas = 1;
    private int RegistrosPorPagina = 10;
    private bool isLoading = true;
    private string? Filter = string.Empty;
    private string? Page = string.Empty;

    /// <summary>
    /// Carga los proveedores activos (Stat_Cli >= 0) paginados desde el backend
    /// </summary>
    private async Task LoadAsync(int page = 1)
    {
        if (!string.IsNullOrWhiteSpace(Page))
        {
            page = Convert.ToInt32(Page);
        }
        PaginaActual = page;
        string url1 = string.Empty;
        string url2 = string.Empty;
        if (string.IsNullOrEmpty(Filter))
        {
            url1 = $"api/proved12?page={page}&recordsNumber={RegistrosPorPagina}&stat_Cli=0";
            url2 = $"api/proved12/totalPages?recordsNumber={RegistrosPorPagina}&stat_Cli=0";
        }
        else
        {
            var encodedFilter = Uri.EscapeDataString(Filter);
            url1 = $"api/proved12?page={page}&recordsNumber={RegistrosPorPagina}&filter={encodedFilter}&stat_Cli=0";
            url2 = $"api/proved12/totalPages?recordsNumber={RegistrosPorPagina}&filter={encodedFilter}&stat_Cli=0";
        }
        try
        {
            isLoading = true;
            var responseHttp = await repository.Get<List<Proved12>>(url1);
            var responseHttp2 = await repository.Get<int>(url2);
            Proveedores = responseHttp.Response!;
            TotalPaginas = responseHttp2.Response!;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        isLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Inicializa la carga de proveedores activos
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await PageAccess.RequiereAccesoAsync("/ficha-proveedor-index");   // ? validación
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadAsync(1);
        }
    }

    /// <summary>
    /// Navega al formulario de creación de proveedor
    /// </summary>
    private void NuevoProveedor()
    {
        NavigationManager.NavigateTo("/ficha-proveedor-create");
    }

    /// <summary>
    /// Navega al listado de proveedores dados de baja
    /// </summary>
    private void IrABajas()
    {
        NavigationManager.NavigateTo("/ficha-proveedor-baja");
    }

    /// <summary>
    /// Navega al formulario de edición de proveedor
    /// </summary>
    private void EditarProveedor(int id)
    {
        NavigationManager.NavigateTo($"/ficha-proveedor-edit/{id}");
    }

    /// <summary>
    /// Da de baja un proveedor cambiando el status a -1
    /// </summary>
    private async Task DarDeBajaProveedor(int id)
    {
        var confirm = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmar baja",
                Text = "¿Deseás dar de baja este proveedor?",
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, dar de baja",
                CancelButtonText = "Cancelar"
            });

        if (!confirm.IsConfirmed)
        {
            return;
        }

        var proveedor = await repository.Get<Proved12>($"/api/proved12/{id}");
        if (proveedor.Response != null)
        {
            proveedor.Response.Stat_Cli = -1;
            await repository.Put("/api/proved12", proveedor.Response);
            await LoadAsync(PaginaActual);
        }
    }

    // ===================================================================
    // FUNCIONALIDAD DE IMPRESIÓN
    // ===================================================================

    private bool mostrarModalImpresion = false;
    private bool isPrinting = false;
    private string TituloReporte => $"Listado de Proveedores - {DateTime.Now:dd/MM/yyyy}";

    /// <summary>
    /// Diccionario de encabezados para el reporte de impresión
    /// Mapea las propiedades de Proved12 a nombres legibles
    /// </summary>
    private Dictionary<string, string> encabezadosProveedores = new Dictionary<string, string>
    {
        { "Id", "Nro Proveedor" },
        { "Raso_Cli", "Razón Social" },
        { "Domi_Cli", "Domicilio" },
        { "Tele_Cli", "Teléfono" },
        { "Mail_Cli", "Mail" },
        { "Cuit_Cli", "CUIT" },
        { "Loca_Cli", "Localidad" },
        { "Cpos_Cli", "Código Postal" }
    };

    /// <summary>
    /// Obtiene TODOS los proveedores que coincidan con los filtros actuales, sin paginación
    /// Utiliza los mismos filtros que LoadAsync pero sin límite de página
    /// </summary>
    private async Task<List<Proved12>?> ObtenerTodosLosProveedoresFiltrados()
    {
        try
        {
            // Construir URL con filtro si existe
            var parametros = new List<string>();
            
            if (!string.IsNullOrEmpty(Filter))
            {
                var encodedFilter = Uri.EscapeDataString(Filter);
                parametros.Add($"filter={encodedFilter}");
            }

            // Agregar parámetros para obtener todos los registros (sin paginación)
            parametros.Add("page=1");
            parametros.Add("recordsNumber=999999"); // Número muy alto para obtener todos los registros
            parametros.Add("stat_Cli=0"); // Solo proveedores activos

            string queryParams = parametros.Count > 0 ? "?" + string.Join("&", parametros) : "";
            string url = $"api/proved12{queryParams}";

            var responseHttp = await repository.Get<List<Proved12>>(url);
            
            if (!responseHttp.Error)
            {
                return responseHttp.Response;
            }
            else
            {
                await sweetAlertService.FireAsync("Error", "No se pudieron obtener los proveedores para impresión", SweetAlertIcon.Error);
                return new List<Proved12>();
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error al obtener proveedores: {ex.Message}", SweetAlertIcon.Error);
            return new List<Proved12>();
        }
    }

    /// <summary>
    /// Confirma la impresión del listado de proveedores respetando filtros activos
    /// Obtiene TODOS los registros que coincidan con los filtros, no solo la página actual
    /// </summary>
    private async Task MostrarImpresion()
    {
        isPrinting = true;
        StateHasChanged();

        try
        {
            // Obtener TODOS los proveedores que coincidan con los filtros actuales (sin paginación)
            var proveedoresCompletos = await ObtenerTodosLosProveedoresFiltrados();
            int cantidadTotal = proveedoresCompletos?.Count ?? 0;

            // Mensaje de confirmación
            string mensaje = string.IsNullOrEmpty(Filter)
                ? $"Se van a imprimir {cantidadTotal} registros que coinciden con los filtros aplicados (todas las páginas). ¿Desea continuar?"
                : $"Se van a imprimir {cantidadTotal} registros filtrados. ¿Desea continuar?";

            var result = await sweetAlertService.FireAsync(new SweetAlertOptions
            {
                Title = "Confirmar impresión",
                Text = mensaje,
                Icon = SweetAlertIcon.Warning,
                ShowCancelButton = true,
                ConfirmButtonText = "Sí, imprimir",
                CancelButtonText = "Cancelar"
            });

            if (result.IsConfirmed)
            {
                // Actualizar la lista de proveedores para impresión con todos los registros
                Proveedores = proveedoresCompletos;
                mostrarModalImpresion = true;
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            isPrinting = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Resetea el estado de impresión y cierra el modal
    /// Restaura la lista de proveedores original (paginada) después de la impresión
    /// </summary>
    private async void ResetearImpresion()
    {
        mostrarModalImpresion = false;
        
        // Restaurar la vista paginada original después de cerrar el modal de impresión
        await LoadAsync(PaginaActual);
        
        StateHasChanged();
    }
}
