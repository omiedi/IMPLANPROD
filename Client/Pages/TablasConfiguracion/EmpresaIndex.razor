@page "/empresas"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IRepository repository
@inject SweetAlertService sweetAlertService
@inject NavigationManager navigationManager
@inject IJSRuntime JS



@if (Empresas is null)
{
    <div class="spinner" />
}
else
{

    <div class="bg-primary text-white text-center p-3 mb-4">
        <!-- Añadido mb-4 para margen inferior -->
        <h1>Empresas</h1>
    </div>

    <div class="d-flex align-items-center mb-3">
        <div class="me-2">
            <a class="btn btn-sm btn-primary float-end" href="/empresas/create"><i class="oi oi-plus"></i> Nueva Empresa</a>
        </div>

        <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar Empresa..." @bind-value="Filter" />

        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>
    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />

    <GenericList MyList="Empresas">
        <Body>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th style="with: 220px"> Cantidad de Filiales</th>
                        <th style="with: 260px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var empresa in Empresas!)
                    {
                        <tr>

                            <td>
                                @empresa.razon
                            </td>
                            <td>
                                @empresa.DependenciasNumber
                            </td>
                            <td>
                                <a href="/empresas/detalles/@empresa.Id" class="btn btn-info btn-sm"><i class="oi oi-list" />Filiales</a>
                                <a href="/empresas/edit/@empresa.Id" class="btn btn-warning btn-sm"><i class="oi oi-pencil" /> Editar</a>
@*                                 <button class="btn btn-danger btn-sm" @onclick=@(() => DeleteAsync(empresa.Id))><i class="oi oi-trash" /> Borrar</button>
 *@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>
}
@code {
