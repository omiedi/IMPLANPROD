            // url2 = $"api/dependencias/totalPages?id={Id}";
        }
        else
        {
            url1 = $"api/dependencias?id={Id}&page={page}&filter={Filter}";
            url2 = $"api/dependencias/totalPages?id={Id}&filter={Filter}";


            // url1 = $"api/dependencias?page={page}&filter={Filter}";
            // url2 = $"api/dependencias/totalPages?id={Id}&filter={Filter}";
        }

        // try
