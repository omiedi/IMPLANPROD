@page "/empresas/detalles/{Id:int}"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService sweetAlertService
@if (empresa is null)
{
    <div class="spinner" />
}
else
{
    <div class="bg-primary text-white text-center p-3 mb-4">
        <!-- Añadido mb-4 para margen inferior -->
        <h1>Filiales de Empresa: @empresa.razon</h1>
    </div>

    <div class="d-flex align-items-center mb-3">
        <div class="me-2">
            <a class="btn btn-sm btn-primary float-end" href="/dependencias/create/@empresa.Id"><i class="oi oi-plus"></i> Agregar Filial</a>
            <a class="btn btn-success btn-sm mx-2" href="/empresas"><i class="oi oi-arrow-thick-left"></i> Regresar</a>
        </div>

        <input style="width: 400px;" type="text" class="form-control me-2" id="titulo" placeholder="Buscar Filial..." @bind-value="Filter" />

        <button type="button" class="btn btn-outline-primary me-2" @onclick="ApplyFilterAsync">Filtrar</button>
        <button type="button" class="btn btn-outline-danger" @onclick="CleanFilterAsync">Limpiar</button>
    </div>



    <Pagination CurrentPage="currentPage"
                TotalPages="totalPages"
                SelectedPage="SelectedPageAsync" />

    <GenericList MyList="dependencia">
        <Body>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Filiales</th>
                        <th style="width:140px">Sectores</th>
                        <th style="width:260px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dependencia in dependencia!)
                    {
                        <tr>

                            <td>
                                @dependencia.dependencia
                            </td>
                            <td>
                                @dependencia.SectoresNumber
                            </td>
                            <td>
                                <a href="/dependencias/detalles/@dependencia.Id" class="btn btn-info btn-sm"><i class="oi oi-list" />Sectores</a>
                                <a href="/dependencias/edit/@dependencia.Id" class="btn btn-warning btn-sm"><i class="oi oi-pencil" /> Editar</a>
@*                                 <button class="btn btn-danger btn-sm" @onclick=@(() => DeleteAsync(dependencia.Id))><i class="oi oi-trash" /> Borrar</button>
 *@                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </Body>
    </GenericList>
}
@code {
    private Empresa? empresa;//como cargo empresa uso directamente: empresa!.Dependencias!.ToList()

    private List<Dependencia>? dependencia;
    private int currentPage = 1;
    private int totalPages;

    [Parameter]
    public int Id { get; set; }
    [SupplyParameterFromQuery]//para que no se pierda la pagina
    public string Page { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery]//para que no se pieerda el filtro
    public string Filter { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }
    private async Task SelectedPageAsync(int page)
