        var responseHppt1 = await repository.Get<Empresa>($"api/empresas/{Id}");
        var responseHppt2 = await repository.Get<List<Dependencia>>(url1);
        var responseHppt3 = await repository.Get<int>(url2);
        empresa = responseHppt1.Response;
        dependencia = responseHppt2.Response;
        totalPages = responseHppt3.Response;
    }




