<style>
    .nav-category {
        font-weight: bold;
        margin-top: 1rem;
        background-color: rgba(255, 255, 255, 0.1);
    }

    .nav-link {
        padding: 0.5rem 0;
        transition: all 0.3s ease;
    }

        .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

        .nav-link i, .nav-link span {
            margin-right: 0.5rem;
            width: 1.5rem;
            text-align: center;
        }

    .config-submenu {
        transition: all 0.3s ease-in-out;
    }

        .config-submenu.d-none {
            display: none !important;
        }

    .submenu-title {
        padding: 0.5rem 0;
        transition: all 0.3s ease;
    }

        .submenu-title:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 4px;
        }

    .aux-tables-submenu {
        transition: all 0.3s ease-in-out;
    }

        .aux-tables-submenu.d-none {
            display: none !important;
        }
</style>

@code {
    private bool collapseNavMenu = false;
    private bool configMenuCollapsed = true;
    private bool auxTablesMenuCollapsed = true;
    private bool usuariosMenuCollapsed = true;
    private bool remitosMenuExpanded = false;
    private bool reparacionesMenuExpanded = false;
    private bool ingenieriaMenuExpanded = false;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private System.Threading.Timer? refreshTimer;

    /// <summary>
    /// Método que se ejecuta cuando se inicializa el componente
    /// </summary>
    protected override void OnInitialized()
    {
        ((AuthenticationStateProvider)AuthStateProvider).AuthenticationStateChanged += AuthenticationStateChanged;
    }

    /// <summary>
    /// Método que se ejecuta cuando cambia el estado de autenticación
    /// </summary>
    private void AuthenticationStateChanged(Task<AuthenticationState> task)
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Método para alternar la visibilidad del menú en dispositivos móviles
    /// </summary>
    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleConfigMenu()
    {
        configMenuCollapsed = !configMenuCollapsed;
    }

    private void ToggleAuxTablesMenu()
    {
        auxTablesMenuCollapsed = !auxTablesMenuCollapsed;
    }

    private void ToggleUsuariosMenu()
    {
        usuariosMenuCollapsed = !usuariosMenuCollapsed;
    }

    private void ToggleRemitosMenu()
    {
        remitosMenuExpanded = !remitosMenuExpanded;
    }

    private void ToggleReparacionesMenu()
    {
        reparacionesMenuExpanded = !reparacionesMenuExpanded;
    }

    private void ToggleIngenieriaMenu()
    {
        ingenieriaMenuExpanded = !ingenieriaMenuExpanded;
    }

    /// <summary>
    /// Método para cerrar sesión
    /// </summary>
    private async Task CerrarSesion()
    {
        // Obtener el AuthenticationService a través del proveedor
        var authService = (IMPLANPROD.Client.Auth.AuthenticationService)AuthStateProvider;
        await authService.LogoutAsync();

        // Navegar a la página de inicio
        NavigationManager.NavigateTo("/");
    }

    /// <summary>
    /// Método para liberar recursos cuando se destruye el componente
    /// </summary>
