@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using IMPLANPROD.Client.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject InactivityService InactivityService
@inject NotificationService NotificationService
@inject CurrentUserService CurrentUserService
@using Blazored.Modal.Services
@inject IModalService Modal
@implements IDisposable

<div class="page" @onmousemove="OnUserActivity" @onkeydown="OnUserActivity" @onclick="OnUserActivity">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
         <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex w-100 align-items-center justify-content-between">
                        <span>Bienvenido, @context.User.Identity?.Name</span>

                        <button type="button" class="btn btn-link text-decoration-none position-relative" title="Notificaciones" @onclick="OpenNotifications">
                            <i class="fas fa-bell"></i>
                            @if (UnreadForCurrentUser > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @UnreadForCurrentUser
                                </span>
                            }
                        </button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Iniciar Sesión</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>



@code {
    private int _userId;
    private int _unreadCount;
    private PeriodicTimer? _unreadPollingTimer;
    private CancellationTokenSource? _unreadPollingCts;
    private Task? _unreadPollingTask;

    private int UnreadForCurrentUser => _unreadCount;

    /// <summary>
    /// Método que se ejecuta cuando se inicializa el componente
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Suscribirse a los cambios de estado de autenticación
        ((AuthenticationStateProvider)AuthStateProvider).AuthenticationStateChanged += AuthenticationStateChanged;
        NotificationService.OnChange += OnNotificationsChanged;

        // Verificar si el usuario está autenticado para iniciar el monitoreo
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            InactivityService.StartMonitoring();
            await LoadUserIdFlexoftAsync();
            await RefreshNotificationsAsync();
            StartUnreadPolling();
        }
    }

    private async Task LoadUserIdFlexoftAsync()
    {
        _userId = await CurrentUserService.GetUserIdAsync();
    }

    private async Task RefreshNotificationsAsync()
    {
        if (_userId <= 0)
        {
            _unreadCount = 0;
            return;
        }

        await NotificationService.RefreshAsync();
        _unreadCount = await NotificationService.GetUnreadCountFromServerAsync();
    }

    private void StartUnreadPolling()
    {
        if (_unreadPollingTask is not null)
        {
            return;
        }

        _unreadPollingCts = new CancellationTokenSource();
        _unreadPollingTimer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        _unreadPollingTask = Task.Run(async () =>
        {
            try
            {
                while (_unreadPollingTimer is not null && await _unreadPollingTimer.WaitForNextTickAsync(_unreadPollingCts.Token))
                {
                    if (_userId <= 0)
                    {
                        continue;
                    }

                    var count = await NotificationService.GetUnreadCountFromServerAsync();
                    if (count != _unreadCount)
                    {
                        _unreadCount = count;
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch
            {
            }
        });
    }

    private void StopUnreadPolling()
    {
        try
        {
            _unreadPollingCts?.Cancel();
        }
        catch
        {
        }

        _unreadPollingCts?.Dispose();
        _unreadPollingCts = null;

        _unreadPollingTimer?.Dispose();
        _unreadPollingTimer = null;

        _unreadPollingTask = null;
    }

    private void OnNotificationsChanged()
    {
        InvokeAsync(async () =>
        {
            _unreadCount = await NotificationService.GetUnreadCountFromServerAsync();
            StateHasChanged();
        });
    }

    private void OpenNotifications()
    {
        Modal.Show<IMPLANPROD.Client.Shared.Components.NotificationsModal>(string.Empty);
    }

    /// <summary>
    /// Método que se ejecuta cuando cambia el estado de autenticación
    /// </summary>
    private async void AuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        
        // Si el usuario se autentica, iniciar monitoreo de inactividad
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            InactivityService.StartMonitoring();
            await LoadUserIdFlexoftAsync();
            await RefreshNotificationsAsync();
            StartUnreadPolling();
        }
        else
        {
            // Si cierra sesión, detener monitoreo
            InactivityService.StopMonitoring();
            _userId = 0;
            _unreadCount = 0;
            StopUnreadPolling();
        }

        // Forzar la actualización del componente cuando cambia el estado de autenticación
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Registra actividad del usuario (mouse, teclado, clicks)
    /// </summary>
    private void OnUserActivity()
    {
        if (InactivityService.IsMonitoring)
        {
            InactivityService.RegisterActivity();
        }
    }

    /// <summary>
    /// Método para liberar recursos cuando se destruye el componente
    /// </summary>
    public void Dispose()
    {
        // Cancelar la suscripción a los cambios de estado de autenticación
        ((AuthenticationStateProvider)AuthStateProvider).AuthenticationStateChanged -= AuthenticationStateChanged;
        NotificationService.OnChange -= OnNotificationsChanged;
        
        // Detener el monitoreo de inactividad
        InactivityService.StopMonitoring();

        StopUnreadPolling();
    }
}
