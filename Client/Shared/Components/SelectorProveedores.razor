@using IMPLANPROD.Client.Repositories
@using Microsoft.AspNetCore.Components.Web
@inject IRepository repository
@inject SweetAlertService sweetAlertService

<!-- Modal para seleccionar proveedor -->
<div class="modal fade @(mostrarModal ? "show" : "")" style="display: @(mostrarModal ? "block" : "none"); z-index: @ZIndex;" tabindex="-1" role="dialog"
     @onkeydown="OnKeyDown">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-truck"></i> Seleccionar Proveedor
                </h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                <!-- Filtro de búsqueda -->
                <div class="row mb-3">
                    <div class="col-md-8">
                        <div class="input-group">
                            <input type="text" class="form-control" @bind="filtroProveedor" @bind:event="oninput" 
                                   @onkeypress="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await FiltrarProveedores(); })" 
                                   placeholder="Buscar por código o razón social..." />
                            <button class="btn btn-outline-secondary" @onclick="LimpiarFiltro">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">@proveedoresFiltrados.Count proveedor(es) encontrado(s)</small>
                    </div>
                </div>

                <!-- Lista de proveedores -->
                @if (cargandoProveedores)
                {
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Cargando proveedores...</span>
                        </div>
                    </div>
                }
                else if (!proveedoresFiltrados.Any())
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle"></i> No se encontraron proveedores activos.
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th>Código</th>
                                    <th>Razón Social</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var proveedor in proveedoresFiltrados)
                                {
                                    <tr>
                                        <td><strong>@proveedor.Nume_Cli</strong></td>
                                        <td>@proveedor.Raso_Cli</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary" @onclick="(() => SeleccionarProveedor(proveedor))">
                                                <i class="fas fa-check"></i> Seleccionar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Backdrop del modal -->
@if (mostrarModal)
{
    <div class="modal-backdrop fade show" style="z-index: @(ZIndex - 5);"></div>
}

@code {
    /// <summary>
    /// Evento que se dispara cuando se selecciona un proveedor
    /// </summary>
    [Parameter] public EventCallback<ProveedorSeleccionado> OnProveedorSeleccionado { get; set; }

    /// <summary>
    /// z-index del modal. El padre puede elevarlo cuando el selector se abre
    /// desde dentro de otro modal (ej. Remito de Modelo a Proveedor).
    /// </summary>
    [Parameter] public int ZIndex { get; set; } = 1055;

    /// <summary>
    /// Controla la visibilidad del modal
    /// </summary>
    private bool mostrarModal = false;

    /// <summary>
    /// Lista completa de proveedores cargados desde el backend
    /// </summary>
    private List<Proved12> proveedoresCompletos = new();

    /// <summary>
    /// Lista filtrada de proveedores que se muestra en la tabla
    /// </summary>
    private List<Proved12> proveedoresFiltrados = new();

    /// <summary>
    /// Filtro de búsqueda por razón social
    /// </summary>
    private string filtroProveedor = string.Empty;

    /// <summary>
    /// Indica si se están cargando los proveedores
    /// </summary>
    private bool cargandoProveedores = false;

    /// <summary>
    /// Clase para representar los datos del proveedor en el combo
    /// </summary>
    public class ProveedorCombo
    {
        public int Nume_Cli { get; set; }
        public string Raso_Cli { get; set; } = string.Empty;
    }

    /// <summary>
    /// Clase para el proveedor seleccionado que se envía al componente padre
    /// </summary>
    public class ProveedorSeleccionado
    {
        public int NumeCli { get; set; }
        public string RazonSocial { get; set; } = string.Empty;
        public string CodigoProveedor { get; set; } = string.Empty;
        public string Domicilio { get; set; } = string.Empty;
        public string CodigoPostal { get; set; } = string.Empty;
        public string Localidad { get; set; } = string.Empty;
        public string Contacto { get; set; } = string.Empty;
        public string Cuit { get; set; } = string.Empty;
        public string ContactoAtencion { get; set; } = string.Empty; // Ctac_Cli del proveedor
    }

    /// <summary>
    /// Método público para abrir el modal desde el componente padre
    /// </summary>
    public async Task AbrirModal()
    {
        mostrarModal = true;
        await CargarProveedores();
        StateHasChanged();
    }

    /// <summary>
    /// Cierra el modal y limpia los filtros
    /// </summary>
    private void CerrarModal()
    {
        mostrarModal = false;
        filtroProveedor = string.Empty;
        proveedoresFiltrados = proveedoresCompletos;
        StateHasChanged();
    }

    /// <summary>
    /// Maneja las teclas presionadas en el modal
    /// </summary>
    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CerrarModal();
        }
    }

    /// <summary>
    /// Carga la lista de proveedores activos desde el backend
    /// </summary>
    private async Task CargarProveedores()
    {
        try
        {
            cargandoProveedores = true;
            StateHasChanged();

            var responseHttp = await repository.Get<List<Proved12>>("api/proved12/combo");
            if (responseHttp.Error)
            {
                var message = await responseHttp.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
                return;
            }

            proveedoresCompletos = responseHttp.Response ?? new List<Proved12>();
            await FiltrarProveedores();
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", $"Error inesperado: {ex.Message}", SweetAlertIcon.Error);
        }
        finally
        {
            cargandoProveedores = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Filtra los proveedores por número de proveedor o razón social
    /// </summary>
    private async Task FiltrarProveedores()
    {
        await Task.Delay(1); // Para permitir que se actualice la UI

        if (string.IsNullOrWhiteSpace(filtroProveedor))
        {
            proveedoresFiltrados = proveedoresCompletos;
        }
        else
        {
            proveedoresFiltrados = proveedoresCompletos
                .Where(p => (p.Raso_Cli ?? "").Contains(filtroProveedor, StringComparison.OrdinalIgnoreCase) ||
                           p.Nume_Cli.ToString().Contains(filtroProveedor, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        StateHasChanged();
    }

    /// <summary>
    /// Limpia el filtro de búsqueda
    /// </summary>
    private async Task LimpiarFiltro()
    {
        filtroProveedor = string.Empty;
        await FiltrarProveedores();
    }

    /// <summary>
    /// Selecciona un proveedor y cierra el modal
    /// </summary>
    private async Task SeleccionarProveedor(Proved12 proveedor)
    {
        var proveedorSeleccionado = new ProveedorSeleccionado
        {
            NumeCli = proveedor.Nume_Cli,
            RazonSocial = proveedor.Raso_Cli ?? "",
            CodigoProveedor = proveedor.Codi_Cli ?? "",
            Domicilio = proveedor.Domi_Cli ?? "",
            CodigoPostal = proveedor.Cpos_Cli ?? "",
            Localidad = proveedor.Loca_Cli ?? "",
            Contacto = proveedor.Tele_Cli ?? "",
            Cuit = proveedor.Cuit_Cli ?? "",
            ContactoAtencion = proveedor.Ctac_Cli ?? ""
        };

        await OnProveedorSeleccionado.InvokeAsync(proveedorSeleccionado);
        CerrarModal();
    }
}
