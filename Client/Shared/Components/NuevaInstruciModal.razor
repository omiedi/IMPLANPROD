@inject IRepository Repository
@inject SweetAlertService SweetAlertService
@using IMPLANPROD.Shared.Entities
@using System.Globalization

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.55);" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg">

                <!-- ══ HEADER ════════════════════════════════════════════════ -->
                <div class="modal-header bg-success text-white py-2">
                    <h5 class="modal-title mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Nueva Instrucción
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Cerrar" aria-label="Cerrar"></button>
                </div>

                <!-- ══ BODY ══════════════════════════════════════════════════ -->
                <div class="modal-body p-4">
                    <div class="border rounded-3 bg-light p-3 shadow-sm">

                        <!-- Fila 1: Código | Revisión | Interno -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-5">
                                <label class="form-label small text-uppercase fw-bold mb-1">Código <span class="text-danger">*</span></label>
                                <input type="text" class="form-control @(errCodigo ? "is-invalid" : "")"
                                       @bind="codigo" maxlength="50" />
                                @if (errCodigo)
                                { <div class="invalid-feedback">Campo obligatorio.</div> }
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-uppercase fw-bold mb-1">Revisión</label>
                                <input type="text" class="form-control"
                                       @bind="revision" maxlength="20" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-uppercase fw-bold mb-1">
                                    Interno <span class="text-muted small">(Cod_Inte)</span>
                                </label>
                                <input type="number" class="form-control fw-bold text-primary @(errCodInte ? "is-invalid" : "")"
                                       @bind="codInte" min="1" />
                                @if (errCodInte)
                                { <div class="invalid-feedback">Debe ser mayor a 0.</div> }
                            </div>
                        </div>

                        <!-- Fila 2: Descripción -->
                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label small text-uppercase fw-bold mb-1">Descripción <span class="text-danger">*</span></label>
                                <input type="text" class="form-control @(errDescripcion ? "is-invalid" : "")"
                                       @bind="descripcion" maxlength="200" />
                                @if (errDescripcion)
                                { <div class="invalid-feedback">Campo obligatorio.</div> }
                            </div>
                        </div>

                        <hr class="my-2" />

                        <!-- Fila 3: Preparó | Fecha Prep. | Aprobó | Fecha Aprob. -->
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small text-uppercase fw-bold mb-1">
                                    <i class="fas fa-user-edit me-1 text-secondary"></i>Preparó
                                </label>
                                <input type="text" class="form-control" @bind="preparo" maxlength="100" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small text-uppercase fw-bold mb-1">
                                    <i class="fas fa-calendar-alt me-1 text-secondary"></i>Fecha Prep.
                                </label>
                                <input type="date" class="form-control" @bind="fechaPrep" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-uppercase fw-bold mb-1">
                                    <i class="fas fa-user-check me-1 text-success"></i>Aprobó
                                </label>
                                <input type="text" class="form-control" @bind="aprobo" maxlength="100" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small text-uppercase fw-bold mb-1">
                                    <i class="fas fa-calendar-check me-1 text-success"></i>Fecha Aprob.
                                </label>
                                <input type="date" class="form-control" @bind="fechaPro" />
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ══ FOOTER ═════════════════════════════════════════════════ -->
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cerrar">
                        <i class="fas fa-times me-1"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-success btn-sm" @onclick="Guardar" disabled="@isGuardando">
                        @if (isGuardando)
                        { <span class="spinner-border spinner-border-sm me-1"></span> }
                        else
                        { <i class="fas fa-save me-1"></i> }
                        Guardar
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnCloseRequested { get; set; }
    [Parameter] public EventCallback<Instruci> OnCreated { get; set; }

    // ── Campos del formulario ──────────────────────────────────────────────
    private string   codigo      = string.Empty;
    private string   revision    = string.Empty;
    private int      codInte     = 0;
    private string   descripcion = string.Empty;
    private string   preparo     = string.Empty;
    private DateTime? fechaPrep  = null;
    private string   aprobo      = string.Empty;
    private DateTime? fechaPro   = null;
    private bool     isGuardando = false;

    // ── Validación ─────────────────────────────────────────────────────────
    private bool errCodigo     = false;
    private bool errCodInte    = false;
    private bool errDescripcion = false;

    private bool _lastVisible = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !_lastVisible)
        {
            await InicializarFormulario();
        }
        _lastVisible = IsVisible;
    }

    private async Task InicializarFormulario()
    {
        codigo      = string.Empty;
        revision    = string.Empty;
        descripcion = string.Empty;
        preparo     = string.Empty;
        fechaPrep   = null;
        aprobo      = string.Empty;
        fechaPro    = null;
        errCodigo   = errCodInte = errDescripcion = false;

        try
        {
            var resp = await Repository.Get<int>("api/instruci/next-cod-inte");
            codInte = resp.Error ? 1 : (resp.Response);
        }
        catch { codInte = 1; }
    }

    private async Task Guardar()
    {
        errCodigo      = string.IsNullOrWhiteSpace(codigo);
        errCodInte     = codInte <= 0;
        errDescripcion = string.IsNullOrWhiteSpace(descripcion);

        if (errCodigo || errCodInte || errDescripcion) return;

        isGuardando = true;
        StateHasChanged();
        try
        {
            var item = new Instruci
            {
                Codigo      = codigo.Trim(),
                Revision    = string.IsNullOrWhiteSpace(revision) ? null : revision.Trim(),
                Cod_Inte    = codInte,
                Descripcion = descripcion.Trim(),
                Preparo     = string.IsNullOrWhiteSpace(preparo)  ? null : preparo.Trim(),
                FechaPrep   = fechaPrep,
                Aprobo      = string.IsNullOrWhiteSpace(aprobo)   ? null : aprobo.Trim(),
                FechaPro    = fechaPro
            };

            var resp = await Repository.Post<Instruci, Instruci>("api/instruci", item);
            if (resp.Error)
            {
                var msg = await resp.GetErrorMessageAsync();
                await SweetAlertService.FireAsync("Error", msg, SweetAlertIcon.Error);
            }
            else
            {
                await OnCreated.InvokeAsync(resp.Response ?? item);
                await Cerrar();
            }
        }
        catch (Exception ex)
        {
            await SweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally { isGuardando = false; }
    }

    private async Task Cerrar() => await OnCloseRequested.InvokeAsync();
}
