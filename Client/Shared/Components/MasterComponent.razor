@using IMPLANPROD.Shared.Entities
@inject IRepository repository
@inject SweetAlertService sweetAlertService

<div class="componentes-container" style="max-height: 12cm; overflow-y: auto;">
    @if (loading)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <h5>Componentes de la Fórmula</h5>
            
            <div class="mb-3">
                <MasterSearchComponent OnMasterSelected="AgregarComponentePorBusqueda" />
            </div>

            @if (ComponentesAsignados.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Cantidad</th>
                            <th>Costo Unitario</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var componente in ComponentesAsignados.OrderBy(c => c.NuorIt))
                        {
                            <tr>
                                <td>@componente.CodXElem</td>
                                <td>@componente.COMPONENTE</td>
                                <td>
                                    <input type="number" 
                                           class="form-control" 
                                           @bind="componente.Unis_Form" 
                                           @bind:event="oninput" 
                                           min="0" 
                                           step="0.01" />
                                </td>
                                <td>@(componente.UsoBruto?.ToString("N2"))</td>
                                <td>
                                    <button class="btn btn-danger btn-sm" @onclick="() => QuitarComponente(componente)">
                                        <i class="oi oi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">
                    No hay componentes asignados.
                </div>
            }

            <div class="mt-2">
                <button type="button" class="btn btn-success" @onclick="GuardarComponentes">
                    Guardar
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int CodigoConjunto { get; set; }
    [Parameter] public string CodxConjunto { get; set; } = string.Empty;
    [Parameter] public EventCallback OnComponentesUpdated { get; set; }

    private List<Formulas> ComponentesAsignados { get; set; } = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarComponentes();
    }

    private async Task CargarComponentes()
    {
        try
        {
            loading = true;
            var response = await repository.Get<List<Formulas>>($"api/formulas/conjunto/{CodigoConjunto}");
            if (!response.Error)
            {
                ComponentesAsignados = response.Response ?? new List<Formulas>();
            }
            else
            {
                var mensaje = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task AgregarComponentePorBusqueda(Master componente)
    {
        // Verificar si el componente ya existe en la fórmula
        if (!ComponentesAsignados.Any(c => c.CodiElem.HasValue && c.CodiElem.Value == int.Parse(componente.Codigo)))
        {
            var nuevoComponente = new Formulas
            {
                CodIConj = CodigoConjunto,
                CodXConj = CodxConjunto,
                CodiElem = componente.Codint,
                CodXElem = componente.Codigo ?? string.Empty,
                NuorIt = (short)(ComponentesAsignados.Count + 1),
                Unis_Form = 1,
                UsoBruto = 1,
                UMED_FORM = componente.Umedida ?? string.Empty,
                COMPONENTE = componente.Descripcion ?? string.Empty,
                CodiEmpr = 1 // Valor por defecto para empresa
            };
            ComponentesAsignados.Add(nuevoComponente);
            StateHasChanged();
        }
        else
        {
            await sweetAlertService.FireAsync("Aviso", "Este componente ya está asignado a la fórmula", SweetAlertIcon.Warning);
        }
    }

    private void QuitarComponente(Formulas componente)
    {
        ComponentesAsignados.Remove(componente);
        // Reordenar los números de orden
        short index = 1;
        foreach (var comp in ComponentesAsignados.OrderBy(c => c.NuorIt))
        {
            comp.NuorIt = index++;
        }
        StateHasChanged();
    }

    private async Task GuardarComponentes()
    {
        try
        {
            var response = await repository.Post($"api/formulas/conjunto/{CodigoConjunto}", ComponentesAsignados);
            if (!response.Error)
            {
                await sweetAlertService.FireAsync("Éxito", "Componentes guardados correctamente", SweetAlertIcon.Success);
                await OnComponentesUpdated.InvokeAsync();
            }
            else
            {
                var mensaje = await response.GetErrorMessageAsync();
                await sweetAlertService.FireAsync("Error", mensaje, SweetAlertIcon.Error);
            }
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }
}
