    private async Task OnDepositoCheckedChangedAsync(int codigoDeposito, ChangeEventArgs e)
    {
        var checkedValue = e.Value switch
        {
            bool boolValue => boolValue,
            string textValue when bool.TryParse(textValue, out var parsed) => parsed,
            _ => false
        };

        if (checkedValue)
        {
            if (!depositosSeleccionados.Contains(codigoDeposito))
            {
                depositosSeleccionados.Add(codigoDeposito);
            }
        }
        else
        {
            depositosSeleccionados.Remove(codigoDeposito);
        }

        depositosSeleccionados.Sort();
        await CargarDetalleTrazabilidadAsync();
    }

    private async Task CargarDetalleTrazabilidadAsync()
    {
        detalleTrazabilidad.Clear();
        detalleVieneDeControserie = false;

        var idSubOr = ordenSeleccionada?.IdSubOr?.Trim();
        var nserie = numeroSerie?.Trim();
        var codInte = ordenSeleccionada?.Cod_Inte ?? 0;

        if (string.IsNullOrWhiteSpace(idSubOr) || string.IsNullOrWhiteSpace(nserie) || codInte < 1)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            isLoadingDetalle = true;
            await InvokeAsync(StateHasChanged);

            var queryDepositos = depositosSeleccionados.Any()
                ? $"?depositos={Uri.EscapeDataString(string.Join(",", depositosSeleccionados))}"
                : string.Empty;

            var response = await repository.Get<TrazabilidadOFSerieResultadoDTO>($"/api/ordefabr/trazabilidad-detalle/{Uri.EscapeDataString(idSubOr)}/{codInte}/{Uri.EscapeDataString(nserie)}{queryDepositos}");
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
                return;
            }

            if (response.Response is null)
            {
                return;
            }

            detalleVieneDeControserie = response.Response.TieneDatosControserie;
            detalleTrazabilidad.AddRange(response.Response.Items ?? Enumerable.Empty<TrazabilidadOFSerieDetalleDTO>());
        }
        finally
        {
            isLoadingDetalle = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetTextoDepositosSeleccionados()
    {
        if (!depositosSeleccionados.Any())
        {
            return "Seleccione depósitos";
        }

        return string.Join(", ", depositosSeleccionados);
    }

    private string GetTextoDepositoUnicoSeleccionado()
    {
        if (!depositoSeleccionadoUnico.HasValue)
        {
            return "Seleccione depósito";
        }

        var deposito = depositosDisponibles.FirstOrDefault(x => x.CodigoDepo == depositoSeleccionadoUnico.Value);
        if (deposito is null)
        {
            return depositoSeleccionadoUnico.Value.ToString();
        }

        return $"{deposito.CodigoDepo} - {deposito.Descripcion}";
    }
