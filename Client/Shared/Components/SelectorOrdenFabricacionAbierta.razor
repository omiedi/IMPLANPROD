    private bool PuedeGrabarNumeroSerie =>
        ordenSeleccionada is not null &&
        !string.IsNullOrWhiteSpace(ordenSeleccionada.IdSubOr) &&
        !string.IsNullOrWhiteSpace(numeroSerie) &&
        (ordenSeleccionada.Cod_Inte ?? 0) > 0 &&
        detalleTrazabilidad.Any() &&
        !detalleVieneDeControserie;

    private async Task GrabarNumeroSerieAsync()
    {
        if (!PuedeGrabarNumeroSerie || isGrabandoNumeroSerie)
        {
            return;
        }

        var idSubOr = ordenSeleccionada?.IdSubOr?.Trim() ?? string.Empty;
        var nserie = numeroSerie?.Trim() ?? string.Empty;
        var codInte = ordenSeleccionada?.Cod_Inte ?? 0;

        if (string.IsNullOrWhiteSpace(idSubOr))
        {
            await sweetAlertService.FireAsync("Advertencia", "Falta seleccionar Orden de Fabricación", SweetAlertIcon.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(nserie))
        {
            await sweetAlertService.FireAsync("Advertencia", "Falta seleccionar N° de Serie", SweetAlertIcon.Warning);
            return;
        }

        if (codInte < 1)
        {
            await sweetAlertService.FireAsync("Advertencia", "Falta Código", SweetAlertIcon.Warning);
            return;
        }

        try
        {
            isGrabandoNumeroSerie = true;

            var request = new GrabarNumeroSerieRequestDTO
            {
                IdSubOr = idSubOr,
                NumeroSerie = nserie,
                CodInte = codInte,
                DepositoMovi = depositoSeleccionadoUnico,
                Items = detalleTrazabilidad.Select(x => new TrazabilidadOFSerieDetalleDTO
                {
                    CodInte = x.CodInte,
                    CodExte = x.CodExte,
                    Descrip = x.Descrip,
                    Unidad = x.Unidad,
                    UsoBruto = x.UsoBruto,
                    CantidadAsignada = x.CantidadAsignada,
                    ControserieId = x.ControserieId,
                    Orden = x.Orden,
                    NivelIndentado = x.NivelIndentado
                }).ToList()
            };

            var response = await repository.Post<GrabarNumeroSerieRequestDTO, GrabarNumeroSerieResultadoDTO>("/api/ordefabr/grabar-numero-serie", request);
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
                return;
            }

            var resultado = response.Response;
            if (resultado is null)
            {
                await sweetAlertService.FireAsync("Advertencia", "No se recibió respuesta de grabación.", SweetAlertIcon.Warning);
                return;
            }

            await sweetAlertService.FireAsync(
                resultado.YaExistia ? "Información" : "Correcto",
                resultado.Mensaje,
                resultado.YaExistia ? SweetAlertIcon.Info : SweetAlertIcon.Success);

            if (!resultado.YaExistia)
            {
                await CargarDetalleTrazabilidadAsync();
            }
        }
        finally
        {
            isGrabandoNumeroSerie = false;
        }
    }

    private async Task CargarDepositosPosiblesConSaldoAsync()
    {
        if (isLoadingDepositosConSaldo)
        {
            return;
        }

        try
        {
            isLoadingDepositosConSaldo = true;

            var response = await repository.Get<List<DepositosPosiblesConSaldoDTO>>("/api/ordefabr/depositos-posibles-con-saldo");
            if (response.Error)
            {
                await sweetAlertService.FireAsync("Error", await response.GetErrorMessageAsync(), SweetAlertIcon.Error);
                return;
            }

            depositosPosiblesConSaldo.Clear();
            depositosPosiblesConSaldo.AddRange((response.Response ?? new List<DepositosPosiblesConSaldoDTO>())
                .OrderBy(x => x.Deposito)
                .ThenBy(x => x.Codigo));

            filtroDepositoConSaldo = string.Empty;
            mostrarModalDepositosConSaldo = true;
        }
        finally
        {
            isLoadingDepositosConSaldo = false;
            await InvokeAsync(StateHasChanged);
        }
    }

