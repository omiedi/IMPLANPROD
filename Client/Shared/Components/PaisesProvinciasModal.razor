@using IMPLANPROD.Shared.Entities
@using IMPLANPROD.Client.Pages.Countries
@using IMPLANPROD.Client.Pages.States
@inject IRepository repository
@inject SweetAlertService sweetAlertService

@*
    Componente reutilizable: PaisesProvinciasModal.razor

    Réplica en modal del circuito de las páginas /countries y
    /countries/details/{id}: ABM de países y, una vez elegido un país, ABM de
    sus provincias (State.CountryId = país seleccionado, igual que en
    /states/create/{CountryId}).

    Regla de negocio: para cargar una provincia es obligatorio haber elegido un
    país (se mantiene la relación país-provincia). No se gestionan ciudades ni
    localidades: el circuito llega hasta provincia.

    Uso desde cualquier página:
        await modalService.Show<PaisesProvinciasModal>("Países y Provincias",
            new ModalOptions { Size = ModalSize.ExtraLarge, DisableBackgroundCancel = true }).Result;
*@

<style>
    /* El modal de Blazored debe quedar por encima de otros modales/spinners */
    .blazored-modal-container {
        z-index: 2100 !important;
    }

    .blazored-modal {
        z-index: 2101 !important;
    }
</style>

<div class="modal-content">
    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
            <i class="oi oi-globe"></i>
            @if (vista == VistaModal.Provincias || vista == VistaModal.FormularioProvincia)
            {
                <text> Provincias de @paisSeleccionado?.Name</text>
            }
            else
            {
                <text> Países</text>
            }
        </h5>
        <button type="button" class="btn-close btn-close-white" @onclick="Cerrar"></button>
    </div>

    <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
        @if (vista == VistaModal.FormularioPais)
        {
            @* Alta / edición de país: se reutiliza el mismo CountryForm de la página /countries *@
            <CountryForm @ref="countryFormRef" Country="paisForm" OnValidSubmit="GuardarPaisAsync" ReturnAction="VolverDesdeFormPais" />
        }
        else if (vista == VistaModal.FormularioProvincia)
        {
            @* Alta / edición de provincia: solo se llega con un país seleccionado *@
            <StateForm @ref="stateFormRef" State="provinciaForm" OnValidSubmit="GuardarProvinciaAsync" ReturnAction="VolverDesdeFormProvincia" />
        }
        else if (vista == VistaModal.Provincias)
        {
            @* ============ VISTA PROVINCIAS (equivalente a /countries/details/{id}) ============ *@
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center">
                    <input style="width: 300px;" type="text" class="form-control form-control-sm"
                           placeholder="Buscar Provincia..." @bind-value="filtroProvincia" />
                    <button type="button" class="btn btn-sm btn-outline-primary mx-1" @onclick="AplicarFiltroProvincia"><i class="oi oi-layers"></i> Filtrar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LimpiarFiltroProvincia"><i class="oi oi-ban"></i> Limpiar</button>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="NuevaProvincia"><i class="oi oi-plus"></i> Nueva Provincia</button>
                    <button type="button" class="btn btn-sm btn-success" @onclick="VolverAPaises"><i class="oi oi-arrow-thick-left"></i> Regresar</button>
                </div>
            </div>

            <Pagination CurrentPage="paginaProvincia" TotalPages="totalPaginasProvincia" SelectedPage="SeleccionarPaginaProvincia" />

            @if (provincias == null)
            {
                <div class="spinner" />
            }
            else
            {
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Provincia</th>
                            <th style="width:180px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var state in provincias)
                        {
                            <tr>
                                <td>@state.Id</td>
                                <td>@state.Name</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" @onclick="() => EditarProvincia(state)"><i class="oi oi-pencil"></i> Editar</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => BorrarProvinciaAsync(state.Id)"><i class="oi oi-trash"></i> Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else
        {
            @* ============ VISTA PAÍSES (equivalente a /countries) ============ *@
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex align-items-center">
                    <input style="width: 300px;" type="text" class="form-control form-control-sm"
                           placeholder="Buscar país..." @bind-value="filtroPais" />
                    <button type="button" class="btn btn-sm btn-outline-primary mx-1" @onclick="AplicarFiltroPais"><i class="oi oi-layers"></i> Filtrar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="LimpiarFiltroPais"><i class="oi oi-ban"></i> Limpiar</button>
                </div>
                <button type="button" class="btn btn-sm btn-primary" @onclick="NuevoPais"><i class="oi oi-plus"></i> Nuevo País</button>
            </div>

            <Pagination CurrentPage="paginaPais" TotalPages="totalPaginasPais" SelectedPage="SeleccionarPaginaPais" />

            @if (paises == null)
            {
                <div class="spinner" />
            }
            else
            {
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>País</th>
                            <th style="width:110px">Provincias</th>
                            <th style="width:270px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var country in paises)
                        {
                            <tr>
                                <td>@country.Id</td>
                                <td>@country.Name</td>
                                <td>@country.StatesNumber</td>
                                <td>
                                    <button class="btn btn-info btn-sm" @onclick="() => VerProvincias(country)"><i class="oi oi-list"></i> Provincias</button>
                                    <button class="btn btn-warning btn-sm" @onclick="() => EditarPais(country)"><i class="oi oi-pencil"></i> Editar</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => BorrarPaisAsync(country.Id)"><i class="oi oi-trash"></i> Borrar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" @onclick="Cerrar">Cerrar</button>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance Modal { get; set; } = default!;

    /// <summary>Se invoca al cerrar el modal (por ejemplo, para recargar combos del llamador).</summary>
    [Parameter] public EventCallback OnCerrar { get; set; }

    // Vistas internas del modal
    private enum VistaModal { Paises, Provincias, FormularioPais, FormularioProvincia }
    private VistaModal vista = VistaModal.Paises;

    // ----- Estado: países -----
    private List<Country>? paises;
    private int paginaPais = 1;
    private int totalPaginasPais;
    private string filtroPais = string.Empty;
    private Country paisForm = new();
    private bool esEdicionPais = false;
    private CountryForm? countryFormRef;

    // ----- Estado: provincias -----
    private Country? paisSeleccionado;
    private List<State>? provincias;
    private int paginaProvincia = 1;
    private int totalPaginasProvincia;
    private string filtroProvincia = string.Empty;
    private State provinciaForm = new();
    private bool esEdicionProvincia = false;
    private StateForm? stateFormRef;

    protected override async Task OnInitializedAsync()
    {
        await CargarPaisesAsync();
    }

    // ======================== PAÍSES ========================

    private async Task CargarPaisesAsync(int page = 1)
    {
        try
        {
            var url = string.IsNullOrEmpty(filtroPais)
                ? $"api/countries?page={page}"
                : $"api/countries?page={page}&filter={filtroPais}";
            var urlTotal = string.IsNullOrEmpty(filtroPais)
                ? "api/countries/totalPages"
                : $"api/countries/totalPages?filter={filtroPais}";

            var response = await repository.Get<List<Country>>(url);
            var responseTotal = await repository.Get<int>(urlTotal);
            paises = response.Response;
            totalPaginasPais = responseTotal.Response;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

    private async Task SeleccionarPaginaPais(int page)
    {
        paginaPais = page;
        await CargarPaisesAsync(page);
    }

    private async Task AplicarFiltroPais() => await CargarPaisesAsync(1);

    private async Task LimpiarFiltroPais()
    {
        filtroPais = string.Empty;
        await CargarPaisesAsync(1);
    }

    private void NuevoPais()
    {
        paisForm = new Country();
        esEdicionPais = false;
        vista = VistaModal.FormularioPais;
    }

    private void EditarPais(Country country)
    {
        paisForm = country;
        esEdicionPais = true;
        vista = VistaModal.FormularioPais;
    }

    private async Task GuardarPaisAsync()
    {
        // Alta: POST api/countries | Edición: PUT api/countries (mismos
        // endpoints que usan CountryCreate / CountryEdit)
        var response = esEdicionPais
            ? await repository.Put("/api/countries", paisForm)
            : await repository.Post("/api/countries", paisForm);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        if (countryFormRef != null) countryFormRef.FormPostedSuccessfully = true;
        vista = VistaModal.Paises;
        await CargarPaisesAsync(paginaPais);
    }

    private async Task BorrarPaisAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Realmente deseas eliminar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si"
        });

        if (string.IsNullOrEmpty(result.Value)) return;

        // Baja lógica igual que CountriesIndex: cambiaStatus con Status = -1
        var response = await repository.Delete($"api/countries/cambiaStatus/{id}/-1");
        if (response.Error)
        {
            var mensajeError = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
        }
        else
        {
            await CargarPaisesAsync(paginaPais);
        }
    }

    private void VolverDesdeFormPais() => vista = VistaModal.Paises;

    // ======================== PROVINCIAS ========================

    private async Task VerProvincias(Country country)
    {
        paisSeleccionado = country;
        filtroProvincia = string.Empty;
        provincias = null;
        vista = VistaModal.Provincias;
        await CargarProvinciasAsync(1);
    }

    private async Task CargarProvinciasAsync(int page = 1)
    {
        if (paisSeleccionado == null) return;

        try
        {
            var url = string.IsNullOrEmpty(filtroProvincia)
                ? $"api/states?id={paisSeleccionado.Id}&page={page}"
                : $"api/states?id={paisSeleccionado.Id}&page={page}&filter={filtroProvincia}";
            var urlTotal = string.IsNullOrEmpty(filtroProvincia)
                ? $"api/states/totalPages?id={paisSeleccionado.Id}"
                : $"api/states/totalPages?id={paisSeleccionado.Id}&filter={filtroProvincia}";

            var response = await repository.Get<List<State>>(url);
            var responseTotal = await repository.Get<int>(urlTotal);
            provincias = response.Response;
            totalPaginasProvincia = responseTotal.Response;
        }
        catch (Exception ex)
        {
            await sweetAlertService.FireAsync("Error", ex.Message, SweetAlertIcon.Error);
        }
    }

    private async Task SeleccionarPaginaProvincia(int page)
    {
        paginaProvincia = page;
        await CargarProvinciasAsync(page);
    }

    private async Task AplicarFiltroProvincia() => await CargarProvinciasAsync(1);

    private async Task LimpiarFiltroProvincia()
    {
        filtroProvincia = string.Empty;
        await CargarProvinciasAsync(1);
    }

    private void NuevaProvincia()
    {
        // La relación país->provincia se garantiza porque solo se puede llegar
        // a este formulario desde la vista de provincias de un país elegido.
        provinciaForm = new State();
        esEdicionProvincia = false;
        vista = VistaModal.FormularioProvincia;
    }

    private void EditarProvincia(State state)
    {
        provinciaForm = state;
        esEdicionProvincia = true;
        vista = VistaModal.FormularioProvincia;
    }

    private async Task GuardarProvinciaAsync()
    {
        if (paisSeleccionado == null) return;

        // Igual que StateCreate: se fija el CountryId del país elegido
        provinciaForm.CountryId = paisSeleccionado.Id;

        var response = esEdicionProvincia
            ? await repository.Put("/api/states", provinciaForm)
            : await repository.Post("/api/states", provinciaForm);

        if (response.Error)
        {
            var message = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", message, SweetAlertIcon.Error);
            return;
        }

        if (stateFormRef != null) stateFormRef.FormPostedSuccessfully = true;
        vista = VistaModal.Provincias;
        await CargarProvinciasAsync(paginaProvincia);
    }

    private async Task BorrarProvinciaAsync(int id)
    {
        var result = await sweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Realmente deseas eliminar el registro?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true,
            CancelButtonText = "No",
            ConfirmButtonText = "Si"
        });

        if (string.IsNullOrEmpty(result.Value)) return;

        // Baja lógica igual que CountryDetails: cambiaStatus con Status = -1
        var response = await repository.Delete($"api/states/cambiaStatus/{id}/-1");
        if (response.Error)
        {
            var mensajeError = await response.GetErrorMessageAsync();
            await sweetAlertService.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
        }
        else
        {
            await CargarProvinciasAsync(paginaProvincia);
        }
    }

    private void VolverDesdeFormProvincia() => vista = VistaModal.Provincias;

    private void VolverAPaises() => vista = VistaModal.Paises;

    private async Task Cerrar()
    {
        await OnCerrar.InvokeAsync();
        await Modal.CloseAsync(ModalResult.Ok(true));
    }
}
