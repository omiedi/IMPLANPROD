@using Microsoft.AspNetCore.Components.Authorization
@using Blazored.Toast
@using Blazored.Toast.Services
@using Blazored.Toast.Configuration
@using CurrieTechnologies.Razor.SweetAlert2
@using IMPLANPROD.Client.Shared
@inject NavigationManager NavigationManager
@inject IRepository Repository
@inject SweetAlertService SweetAlertService

<CascadingBlazoredModal Position="ModalPosition.Middle" Size="ModalSize.Large" HideHeader="true"
                        DisableBackgroundCancel="true" AnimationType="ModalAnimationType.FadeInOut">
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <AuthorizeView>
                            <Authorized Context="authCtx">
                                <AccesoDenegado />
                            </Authorized>
                            <NotAuthorized Context="noAuthCtx">
                                <RedirectToLogin />
                            </NotAuthorized>
                        </AuthorizeView>
                    </NotAuthorized>
                    <Authorizing>
                        <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                        </div>
                    </Authorizing>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>No encontrado</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Lo siento, no hay nada en esta dirección.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
    <BlazoredToasts Position="ToastPosition.BottomRight"
                    Timeout="5"
                    IconType="IconType.FontAwesome"
                    SuccessClass="success-toast-override"
                    SuccessIcon="fa fa-check"
                    ErrorIcon="fa fa-times"
                    InfoIcon="fa fa-info"
                    WarningIcon="fa fa-warning" />
</CascadingBlazoredModal>

@code {
    /// <summary>
    /// Al abrir el sistema, siempre se debe pasar por login
    /// La gestión de sesión y timeout se maneja mediante InactivityService
    /// </summary>
}
