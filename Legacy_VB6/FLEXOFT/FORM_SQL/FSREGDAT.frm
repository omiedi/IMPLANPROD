   Text4.SetFocus
End Sub

Private Sub Text6_DblClick()
   RUTAX$ = TRIM$(SELECCION_Archivo$("*.*", cmd))
   If RUTAX$ <> "" Then Text6 = RUTAX$
   Screen.MousePointer = 1

End Sub

Private Sub Text7_DblClick()
   RUTAX$ = TRIM$(SELECCION_Archivo$("*.*", cmd))
   If RUTAX$ <> "" Then Text7 = RUTAX$
   Screen.MousePointer = 1

End Sub
