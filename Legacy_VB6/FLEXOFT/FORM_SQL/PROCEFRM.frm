    SQLX$ = SQLX$ + " FROM PDIARPROD1 "
    SQLX$ = SQLX$ + " union all"
    SQLX$ = SQLX$ + " SELECT H_DESDE,H_HASTA,NULNUMAYUD1,NULNUMAYUD2,NULNUMAYUD3,NULNUMAYUD4,NULNUMAYUD5,NULNUMAYUD6,NULNUMAYUD7,NULNUMAYUD8,FECHA,IDSUBOR,IDOP1,IDOP2,SOLAPASUP,PDIARPROD2_ID,NULNUMUSUMAQ,INDISOLSUP "
    SQLX$ = SQLX$ + " FROM PDIARPROD2 ) AS P"
    SQLX$ = SQLX$ + " WHERE (P.NUMAYUD1 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD2 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD3 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD4 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD5 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD6 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD7 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD8 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NULIDOP1 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NULIDOP2 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMUSUMAQ =" & NUSER%
    SQLX$ = SQLX$ + " ) AND P.FECHA = '" & FETEXCOR1$(FE%) & "'"
    '
    Set rs = READSET(SQLX$, , 1)
    With rs
      Do While Not .EOF
         k& = k& + 1
         DESLEIDO% = HORANUM(SAFETEXT$(!H_DESDE))
         HASLEIDO% = HORANUM(SAFETEXT$(!H_HASTA))
         IDLEIDO& = XVALO(!PDIARPROD1_ID)
         GRUPOSOLA_LEIDO% = XVALO(!INDISOLSUP)
         Select Case GRUPOSOLA_LEIDO%
             Case 0, 1, 2, 3, 8, 10, 11: GRUPOSOLA_LEIDO% = 1
             Case 4, 5, 6, 7, 9: GRUPOSOLA_LEIDO% = 2
         End Select
         AA = XVALO(!NULIDOP1)
         NORFA$ = SAFETEXT$(!idsubor)
         DESCRISOLAPA$ = SAFETEXT$(!SOLAPASUP)
         If HAY_SOLAPAMIENTO_HORARIO%(DESDX%, HASTX%, DESLEIDO%, HASLEIDO%) > 0 Then ' ESTA FUNCION VALIDA SI EXISTE SOLAPAMIENTO HORARIO
           If ID& <> IDLEIDO& Or (ID& = IDLEIDO& And GRUPOSOLA_LEIDO% <> GRUPOSOLAP%) Then ' SI ES EL MISMO REGISTRO NO LO CONSIDERA
               d = HORATEX$(DESDX%)
               h = HORATEX$(HASTX%)
               DL = HORATEX$(DESLEIDO%)
               HL = HORATEX$(HASLEIDO%)
               GoSub CARGOZELECHO
           End If
         End If
         .MoveNext
       Loop
    End With
    rs.Close
    Set rs = Nothing
            GoTo 80
CARGOZELECHO:
        If COLOR <> vbWhite Then
          COLOR = vbWhite
        Else
          COLOR = &H808080
        End If
        J& = FRMZELECHO.MSF2.Rows
        If L& = 0 Then
            FRMZELECHO.MSF2.Rows = J& + 1
            FRMZELECHO.MSF2.TextMatrix(J&, 1) = L&
            FRMZELECHO.MSF2.TextMatrix(J&, 2) = FECHATEX$(FE%)
            FRMZELECHO.MSF2.TextMatrix(J&, 3) = NUSER%
            FRMZELECHO.MSF2.TextMatrix(J&, 4) = NOMBREUSRSQL$
            FRMZELECHO.MSF2.TextMatrix(J&, 5) = NORFAPARAM$
            FRMZELECHO.MSF2.TextMatrix(J&, 6) = DESCRISOLAP$
            FRMZELECHO.MSF2.TextMatrix(J&, 7) = d
            FRMZELECHO.MSF2.TextMatrix(J&, 8) = h
            Call COLOREAR_GRILLA_SOLAFILA(FRMZELECHO.MSF2, COLOR, J&)
        End If
        L& = L& + 1
        J& = FRMZELECHO.MSF2.Rows
        FRMZELECHO.MSF2.Rows = J& + 1
        FRMZELECHO.MSF2.TextMatrix(J&, 1) = L&
        FRMZELECHO.MSF2.TextMatrix(J&, 2) = FECHATEX$(FE%)
        FRMZELECHO.MSF2.TextMatrix(J&, 3) = NUSER%
        FRMZELECHO.MSF2.TextMatrix(J&, 4) = NOMBREUSRSQL$
        FRMZELECHO.MSF2.TextMatrix(J&, 5) = NORFA$
        FRMZELECHO.MSF2.TextMatrix(J&, 6) = DESCRISOLAPA$
        FRMZELECHO.MSF2.TextMatrix(J&, 7) = DL
        FRMZELECHO.MSF2.TextMatrix(J&, 8) = HL
        Call COLOREAR_GRILLA_SOLAFILA(FRMZELECHO.MSF2, COLOR, J&, , 1)
Return

         
80

