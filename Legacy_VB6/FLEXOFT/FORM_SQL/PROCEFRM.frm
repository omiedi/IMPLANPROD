   NUMCOLUID% = 10
   jj& = 0
   Dim MSF As msFlexGrid
   Set MSF = MSF2(Index)
   TABLA$ = "PDIARPROD1"
   CAMPOID$ = "PDIARPROD1_ID"
   Select Case GLOBALFRM_SOLASUP%
     Case 4, 5, 9
        Set MSF = MSF7(GLOBALFRM_SOLASUP%)
        NUMCOLUID% = 15
        TABLA$ = "PDIARPROD2"
        CAMPOID$ = "PDIARPROD2_ID"
     Case 6, 7
        Set MSF = MSF7(GLOBALFRM_SOLASUP%)
        NUMCOLUID% = 13
        TABLA$ = "PDIARPROD2"
        CAMPOID$ = "PDIARPROD2_ID"
     Case 11
        NUMCOLUID% = 13
        TABLA$ = "PDIARPROD1"
        CAMPOID$ = "PDIARPROD1_ID"
   End Select
   '
   MSF.row = FilaActiva
   MSF.col = J&
   '
   IDT& = MSF.TextMatrix(FilaActiva, NUMCOLUID%)
   If IDT& < 1 Then
      Call COMUNI("Atención !!! Debe Grabar La Información, La Fila Seleccionada No Está Registrada Aún")
   End If
   
   Dim NUMEUSR%(12), NAMEUS$(12)
   J& = 0
   SQLX$ = " select * from " & TABLA$ & " WITH(NOLOCK)"
   SQLX$ = SQLX$ + " WHERE " & CAMPOID$ & " = " & IDT&
   Set rs = READSET(SQLX$)
   If Not rs.EOF Then
      If TABLA$ = "PDIARPROD1" Then
        NUMEUSR%(1) = XVALO(rs!NUMAYUD1): NAMEUS$(1) = SAFETEXT$(rs!NAMEAYUD1)
        NUMEUSR%(2) = XVALO(rs!NUMAYUD2): NAMEUS$(2) = SAFETEXT$(rs!NAMEAYUD2)
        NUMEUSR%(3) = XVALO(rs!NUMAYUD3): NAMEUS$(3) = SAFETEXT$(rs!NAMEAYUD3)
        NUMEUSR%(4) = XVALO(rs!NUMAYUD4): NAMEUS$(4) = SAFETEXT$(rs!NAMEAYUD4)
        NUMEUSR%(5) = XVALO(rs!NUMAYUD5): NAMEUS$(5) = SAFETEXT$(rs!NAMEAYUD5)
        NUMEUSR%(6) = XVALO(rs!NUMAYUD6): NAMEUS$(6) = SAFETEXT$(rs!NAMEAYUD6)
        NUMEUSR%(7) = XVALO(rs!NUMAYUD7): NAMEUS$(7) = SAFETEXT$(rs!NAMEAYUD7)
        NUMEUSR%(8) = XVALO(rs!NUMAYUD8): NAMEUS$(8) = SAFETEXT$(rs!NAMEAYUD8)
        NUMEUSR%(9) = XVALO(rs!NUMUSUMAQ): NAMEUS$(9) = SAFETEXT$(rs!NAMEUSUMAQ)
      Else
        'TABLA PDIARPROD2
        NUMEUSR%(1) = XVALO(rs!IDOP1): NAMEUS$(1) = SAFETEXT$(rs!NAMEOP1)
        NUMEUSR%(2) = XVALO(rs!IDOP2): NAMEUS$(2) = SAFETEXT$(rs!NAMEOP2)
      End If
   End If
   rs.Close
   Set rs = Nothing
   INICIALIZO% = 0
   For i% = 1 To 9
     If NUMEUSR%(i%) > 0 Then
       jj& = jj& + 1
       If jj& = 1 Then
        Campos$ = "Us./f5;Nombre/A48"
        Call CARGA_ENCABEZADO(FRMZELECHO.MSF1, Campos$, FRMZELECHO)
       End If
       TEXTOGRILLA$ = NUMEUSR%(i%) & "|" & NAMEUS$(i%)
       Call CARGA_GRILLA_GENERICO(FRMZELECHO, FRMZELECHO.MSF2, Campos$, TEXTOGRILLA$, INICIALIZO%)
     End If
   Next i%
   '
   If jj& > 0 Then
        FRMZELECHO.Width = 9000
        FRMZELECHO.Caption = "Usuarios Informados Para el Registro Seleccionado"
        FRMZELECHO.Show 1
   End If
   
   
   


