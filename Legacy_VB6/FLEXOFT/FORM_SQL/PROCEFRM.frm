Private Sub Command1_Click(Index As Integer)
'CAMPOS$ = "DESCRIPCIÓN/A16;ACCIÓN/A60;CTRL/A4;Observaciones/A64"
   Command1(Index).Enabled = False
   If TRIM$(Me.TXTOT) = "" Then
     Call COMUNI("Falta Seleccionar Orden de Fabricación")
     GoTo 99
   End If

   For i& = 1 To MSF4(Index).Rows - 1
      CTRL = TRIM$(MSF4(Index).TextMatrix(i&, 3))
      VALORESTADO% = Asc(CTRL)
      OBS$ = TRIM$(MSF4(Index).TextMatrix(i&, 4))
      If VALORESTADO% = 254 Or OBS$ <> "" Then
         J& = J& + 1
         MSF9(Index).Rows = MSF9(Index).Rows + 1
         REG& = MSF9(Index).Rows - 1
         MSF9(Index).TextMatrix(REG&, 1) = MSF4(Index).TextMatrix(i&, 1)
         MSF9(Index).TextMatrix(REG&, 2) = MSF4(Index).TextMatrix(i&, 2)
         MSF9(Index).col = 3: MSF9(Index).row = MSF9(Index).Rows - 1
         MSF9(Index).CellFontName = "Wingdings"
         MSF9(Index).CellFontSize = 14
         MSF9(Index).CellAlignment = flexAlignCenterCenter
         If VALORESTADO% <> 254 Then VALORESTADO% = 168
         MSF9(Index).TextMatrix(REG&, 3) = Chr(VALORESTADO%)
         MSF9(Index).TextMatrix(REG&, 4) = NOWSERVER
         MSF9(Index).TextMatrix(REG&, 5) = MSF4(Index).TextMatrix(i&, 4)
         MSF9(Index).TextMatrix(REG&, 6) = ORDEN
         If VALORESTADO% = 254 Then
           Call COLOREAR_GRILLA_SOLACELDA(MSF9(Index), &HC0FFC0, REG&, 3)
         Else
           Call COLOREAR_GRILLA_SOLACELDA(MSF9(Index), vbRed, REG&, 3)
         End If
      End If
   Next i&
   '
   'LIMPIO LA GRILLA SUPERIOR
    For i& = 1 To MSF4(Index).Rows - 1
         MSF4(Index).TextMatrix(i&, 3) = Chr(168)
         Call COLOREAR_GRILLA_SOLACELDA(MSF4(Index), vbWhite, i&, 3)
         MSF4(Index).TextMatrix(i&, 4) = ""
    Next i&
  
    Call POSICIONAR_ULTIMAFILA(MSF9(Index))
    MODIFICADO(Index) = 1
99 Command1(Index).Enabled = True
'CAMPOS$ = "DESCRIPCIÓN/A16;ACCIÓN/A60;CTRL/A4;Dia y Hora/A24;Observaciones/A64"
End Sub


