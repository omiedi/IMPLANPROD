        SQLX$ = SQLX$ + " ,COEFICIENTE = '" & FORMATNUM$(COEFIC, "F12.2") & "'"
        SQLX$ = SQLX$ + " ,CODTAREA = " & XVALO(MSF.TextMatrix(1, 8))
        SQLX$ = SQLX$ + " ,DESCRIPTAREA = '" & MSF.TextMatrix(1, 9) & "'"
        SQLX$ = SQLX$ + " ,CANTIDAD = " & XVALO(MSF.TextMatrix(1, 11))
        
        SQLX$ = SQLX$ + " ,H_DESDE = '" & MSF.TextMatrix(1, 12) & "'"
        SQLX$ = SQLX$ + " ,H_HASTA = '" & MSF.TextMatrix(1, 13) & "'"
        H_TRABA = FORMATNUM$(XVALO(DIFERENCIAHORASCENTESIMAL(HORANUM(MSF.TextMatrix(1, 12)), HORANUM(MSF.TextMatrix(1, 13)))), "F12.2")
        SQLX$ = SQLX$ + " ,H_TRABAJADAS = '" & H_TRABA & "'"

        SQLX$ = SQLX$ + " ,Observaciones = '" & Left(MSF.TextMatrix(1, 14), 512) & "'"
      Case 6, 7
        SQLX$ = "UPDATE PDIARPROD2 SET FECHA = '" & FETEXCOR1$(FECHANUM(MSF.TextMatrix(1, 1))) & "'"
        SQLX$ = SQLX$ + " ,IDOP1 = " & XVALO(MSF.TextMatrix(1, 2))
        SQLX$ = SQLX$ + " ,NAMEOP1 = '" & MSF.TextMatrix(1, 3) & "'"
        SQLX$ = SQLX$ + " ,IDOP2 = " & XVALO(MSF.TextMatrix(1, 4))
        SQLX$ = SQLX$ + " ,NAMEOP2 = '" & MSF.TextMatrix(1, 5) & "'"
           CONDIDAT$ = "CAMPO1 = " & XVALO(MSF.TextMatrix(1, 6)) & " AND LISTA  = 'TAREAS'"
           COEFIC = XVALO(VALOBADA("DATASQL", "CAMPO3", CONDIDAT$, "NOMESS"))
        SQLX$ = SQLX$ + " ,COEFICIENTE = '" & FORMATNUM$(COEFIC, "F12.2") & "'"
        SQLX$ = SQLX$ + " ,CODTAREA = " & XVALO(MSF.TextMatrix(1, 6))
        SQLX$ = SQLX$ + " ,DESCRIPTAREA = '" & MSF.TextMatrix(1, 7) & "'"
        SQLX$ = SQLX$ + " ,CANTIDAD = " & XVALO(MSF.TextMatrix(1, 9))
        
        SQLX$ = SQLX$ + " ,H_DESDE = '" & MSF.TextMatrix(1, 10) & "'"
        SQLX$ = SQLX$ + " ,H_HASTA = '" & MSF.TextMatrix(1, 11) & "'"
        
        H_TRABA = FORMATNUM$(XVALO(DIFERENCIAHORASCENTESIMAL(HORANUM(MSF.TextMatrix(1, 10)), HORANUM(MSF.TextMatrix(1, 11)))), "F16.2")
        SQLX$ = SQLX$ + " ,H_TRABAJADAS = '" & H_TRABA & "'"

        SQLX$ = SQLX$ + " ,Observaciones = '" & Left(MSF.TextMatrix(1, 12), 512) & "'"
      
    End Select
      
    SQLX$ = SQLX$ + " WHERE PDIARPROD2_ID = " & ID&
    
    FLEXCONN.Execute (SQLX$)
    Call mnuRefresh_Click
    Screen.MousePointer = 1
    Call COMUNI("Cambio Realizado")
        
    End If
    Set VENTANA = Nothing
    Unload VENTABNEW
End Sub

