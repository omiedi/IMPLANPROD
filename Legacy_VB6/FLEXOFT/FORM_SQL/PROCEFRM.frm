                 If VALIDAR_SOLAPAMIENTO_HORARIO2%(RET6%, FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            Case 7
                If RET7% > 0 Then
                 If VALIDAR_SOLAPAMIENTO_HORARIO2%(RET7%, FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            Case 8
