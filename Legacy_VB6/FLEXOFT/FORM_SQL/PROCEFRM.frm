Private Sub CMDDOTACION_Click(Index As Integer)
    CMDDOTACION(Index).Enabled = False
    '
    NORFA$ = TRIM$(Me.TXTOT)
    If NORFA$ = "" Then
      Call COMUNI("No Hay Una Orden de Fabricación Seleccionada")
      GoTo 99
    End If
    'VALIDO FECHA POR QUE TOMA LA FECHA QUE ESTA EN LA CAJA DE TEXTO QUE DEBERIA SER LA DE HOY
    Dim OBJFECHA As TextBox
    Set OBJFECHA = TXTFECHA(Index)
    Select Case GLOBALFRM_SOLASUP%
      Case 0, 1, 2, 3, 8, 10
      'VALIDO PARA ESTAS SOLAPAS QUE TIENEN CAJA DE TEXTO DE MAQUINA QUE SE AGREGUEN PARA TOMAR EN CUENTA EN LA DOTACION
      If TRIM$(TXTMAQUINA(GLOBALFRM_SOLASUP%)) = "" Then
         Call COMUNI("Debe Seleccionar una Máquina Previo a la Carga de Dotación\La Misma Queda Asociada a La Dotación a Ingresar")
         GoTo 99
      End If
      Set OBJFECHA = TXTFECHA(Index)
      Case 4, 5, 6, 7, 9
      Set OBJFECHA = TXTFECHA2(Index)
    End Select
    '
    If FECHANUM(OBJFECHA.TEXT) < 1 Then
       Call COMUNI("Fecha No Válida")
       Call PINTATEXT(OBJFECHA)
    End If
    'SI NO ES LA FECHA DEL DIA PRESENTA UN MENSAJE
    FE% = FECHANUM(OBJFECHA.TEXT)
    FEHOY% = HOYSERVER%
    
    'VALIDA SI LA FECHA DEL DIA ES DIFERENTE A LA FECHA SELECCIONADA SOLO PUEDE CONTINUAR SI POSEE LOS DERECHOS
    If FE% <> FEHOY% Then
       If DERACCE%("MODTCION", "MODIFICAR DATOS DE DOTACION FUERA DE FECHA") < 2 Then GoTo 99
    End If
    '
    If FE% <> FEHOY% Then
      OPX% = COMALTER%("ATENCIÓN !!\Fecha Asignada Difiere de la Fecha Actual\\Cancelar\Aplicar Dotación Para la Fecha: " & FECHATEX$(FE%))
      If OPX% < 2 Then GoTo 99
    End If
    '
    Unload VENTABNEW
    VENTANA.Inicializar = 0
    VENTANA.CampEditables = "2;4;5;6"
    Select Case GLOBALFRM_SOLASUP%
      Case 0, 1, 2, 3, 8, 10
       VENTANA.CampEditables = "2;4;5"
    End Select
    VENTANA.AgregaRegistro = 1
    VENTANA.UtilizaFormula = 1
    VENTANA.HabilitaBorrar = 1
    VENTANA.HabilitaInsertar = 1
    VENTANA.NoMostrarBotonTilde = 0
    VENTANA.TITULO = ""
    Campos$ = "FECHA/D8;ID USUARIO/F10;NOMBRE/A40;INGRESO/H12;SALIDA/H12;ID MÁQ./A7;MÁQUINA/A32;ID/A0;"
    VENTANA.Campox = Campos$
    VENTANA.ColEcoCampo(2) = "NUSER;NOMBRE;USUARIOSSQL"
    VENTANA.ColEcoCampo(6) = "CAMPO1;CAMPO2;DATASQL;LISTA  = 'CODIMAQ' AND CAMPO3 = " & GLOBALFRM_SOLASUP%
    VENTANA.TITULO = "Carga de Dotación Para Sector: " & SSTab1.Caption & " Día: " & FECHATEX$(HOYSERVER%)
    VENTANA.Inicializar = 1
    '****************************************************************
    Dim obj As New RECORXET
    Set rs1 = obj.RS_DOTADIARIA(FECHANUM(OBJFECHA.TEXT), GLOBALFRM_SOLASUP%, NORFA$)
    Call Carga_MSF_Recordset(rs1, Campos$, VENTABNEW.MSF)
    Set obj = Nothing
    rs1.Close
    Set rs1 = Nothing
    
30  VENTABNEW.Show 1
    Dim MSF As msFlexGrid
    Set MSF = VENTABNEW.MSF
        '
    If VENTABNEW.APROBADO% > 0 Then
      
      If FilaVacia%(VENTABNEW.MSF, 1) < 1 Then
        VALIEC& = VALIDAR_ECO(VENTABNEW.MSF, 3, 0)
        If VALIEC& > 0 Then
          Call COMUNI("Usuario No Válido En Fila: " & VALIEC&)
          GoTo 30
        End If
      'ASIGNO LA MAQUINA QUE ESTA ACTIVA EN PANTALLA A LA GRILLA SOLO EN LOS CASOS QUE ESTEN VACIAS DICHAS COLUMNAS
      Select Case GLOBALFRM_SOLASUP%
        Case 0, 1, 2, 3, 8, 10
        For i& = 1 To VENTABNEW.MSF.Rows - 1
         If TRIM$(VENTABNEW.MSF.TextMatrix(i&, 6)) = "" Then VENTABNEW.MSF.TextMatrix(i&, 6) = TXTIDMAQ(GLOBALFRM_SOLASUP%)
         If TRIM$(VENTABNEW.MSF.TextMatrix(i&, 7)) = "" Then VENTABNEW.MSF.TextMatrix(i&, 7) = TXTMAQUINA(GLOBALFRM_SOLASUP%)
        Next i&
      End Select
        
       'VALIDA QUE NO HAYA SOLAPAMIENTO EN LA MISMA GRILLA CONSIDERANDO EL USUARIO.
       For i& = 1 To MSF.Rows - 1
         Des% = HORANUM(VENTABNEW.MSF.TextMatrix(i&, 4))
         Has% = HORANUM(VENTABNEW.MSF.TextMatrix(i&, 5))
         US1% = VENTABNEW.MSF.TextMatrix(i&, 2)
         If VALI_SOLAP_HOR_ENGRILLA%(VENTABNEW.MSF, i&, Des%, Has%, 4, 5, 2, US1%) > 0 Then
          Call COMUNI("Solopamiento en Rango Horario En Grilla de Carga")
          Call COLOREAR_GRILLA_SOLAFILA(VENTABNEW.MSF, vbYellow, i&)
          GoTo 30
         End If
       Next i&
       'VALIDA QUE NO HAYA SOLAPAMIENTO CONTRA LA BASE DE DATOS
       For i& = 1 To MSF.Rows - 1
         NUS% = XVALO(VENTABNEW.MSF.TextMatrix(i&, 2))
         FE% = FECHANUM(VENTABNEW.MSF.TextMatrix(i&, 1))
         If FE% < 1 Then FE% = FECHANUM(OBJFECHA.TEXT)
         Des% = HORANUM(VENTABNEW.MSF.TextMatrix(i&, 4))
         Has% = HORANUM(VENTABNEW.MSF.TextMatrix(i&, 5))
         ID& = XVALO(VENTABNEW.MSF.TextMatrix(i&, 8))
         If env.VALIDAR_SOLAPAMIENTO_DOTACION%(NUS%, FE%, Des%, Has%, "", ID&) > 0 Then
           Call COLOREAR_GRILLA_SOLAFILA(VENTABNEW.MSF, vbYellow, i&)
           GoTo 30
         End If
       Next i&
     End If
