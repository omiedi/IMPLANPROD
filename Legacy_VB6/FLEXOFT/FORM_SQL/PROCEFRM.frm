Sub ACTUALIZAR_CAMPO_H_DESDE_A_H_DESDE_FN() ' CON FORMATO NUMERICO PARA EL ORDENAMIENTO
       Me.Caption = "TABLA DOTACION"
       'EN ESTA RUTINA VALIDA SI LA TABLA DOTACION TIENE EL CAMPO H_DESDE_FN (QUE ES LA HORA EN FORMATO NUMERICO)
       'Y SI NO TIENE VALOR HACE UN HORA NUM DEL CAMPO H_DESDE Y LO GUARDA EN H_DESDE_FN SOLO SE VA A USAR PARA EL ORDENAMIENTO
       'LO REPITE PARA CADA UNA DE ESTAS 3 TABLAS (DOTACION, PDIARPROD1, PDIARPORD2
       SQLX$ = "SELECT COUNT(*)AS CANTI FROM DOTACION WITH(NOLOCK) WHERE (H_DESDE_FN IS NULL OR H_DESDE_FN <= 0) and H_DESDE <> ''"
       Set rs = READSET(SQLX$)
       If rs!CANTI > 0 Then
           Dim rs1 As ADODB.Recordset
           Set rs1 = New ADODB.Recordset
25         On Error Resume Next
           SQLX$ = "SELECT H_DESDE,H_DESDE_FN FROM DOTACION WHERE (H_DESDE_FN IS NULL OR H_DESDE_FN <= 0) and H_DESDE <> ''"
           rs1.Open FILTSQL$(SQLX$), FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText
           If Err Then
            On Error GoTo 0
            Call CapturaErrorOpen
            GoTo 25
           End If
           With rs1
            Do While Not rs1.EOF
               HD$ = SAFETEXT$(rs1!H_DESDE)
               !H_DESDE_FN = HORANUM(HD$, "NOMESS")
               .Update
               .MoveNext
            Loop
           End With
           rs1.Close
           Set rs1 = Nothing
       End If
       rs.Close
       Set rs = Nothing


       'EN ESTE BLOQUE VALIDA SI LA TABLA PDIARPROD1 TIENE EL CAMPO H_DESDE_FN (QUE ES LA HORA EN FORMATO NUMERICO)
       'Y SI NO TIENE VALOR HACE UN HORA NUM DEL CAMPO H_DESDE Y LO GUARDA EN H_DESDE_FN SOLO SE VA A USAR PARA EL ORDENAMIENTO
     
       Me.Caption = "TABLA PDIARPROD1"
       SQLX$ = "SELECT COUNT(*)AS CANTI FROM PDIARPROD1 WITH(NOLOCK) WHERE (H_DESDE_FN IS NULL OR H_DESDE_FN <= 0)and H_DESDE <> ''"
       Set RS2 = READSET(SQLX$)
       If RS2!CANTI > 0 Then
           Dim rs3 As ADODB.Recordset
           Set rs3 = New ADODB.Recordset
35         On Error Resume Next
           SQLX$ = "SELECT H_DESDE,H_DESDE_FN FROM PDIARPROD1 WHERE   (H_DESDE_FN IS NULL OR H_DESDE_FN <= 0)and H_DESDE <> ''"
           rs3.Open SQLX$, FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText
           If Err Then
            On Error GoTo 0
            Call CapturaErrorOpen
            GoTo 35
           End If
           With rs3
            Do While Not .EOF
               HD$ = SAFETEXT$(!H_DESDE)
               !H_DESDE_FN = HORANUM(HD$, "NOMESS")
               .Update
               .MoveNext
            Loop
           End With
           rs3.Close
           Set rs3 = Nothing
       End If
       RS2.Close
       Set RS2 = Nothing
       
       'EN ESTE BLOQUE VALIDA SI LA TABLA PDIARPROD2 TIENE EL CAMPO H_DESDE_FN (QUE ES LA HORA EN FORMATO NUMERICO)
       'Y SI NO TIENE VALOR HACE UN HORA NUM DEL CAMPO H_DESDE Y LO GUARDA EN H_DESDE_FN SOLO SE VA A USAR PARA EL ORDENAMIENTO
       Me.Caption = "TABLA PDIARPROD2"
       SQLX$ = "SELECT COUNT(*)AS CANTI FROM PDIARPROD2 WITH(NOLOCK) WHERE (H_DESDE_FN IS NULL OR H_DESDE_FN <= 0) and  H_DESDE <> ''"
       Set RS4 = READSET(SQLX$)
       If RS4!CANTI > 0 Then
       
           Dim RS5 As ADODB.Recordset
           Set RS5 = New ADODB.Recordset
55         On Error Resume Next
           SQLX$ = "SELECT H_DESDE,H_DESDE_FN FROM PDIARPROD2 WHERE (H_DESDE_FN IS NULL OR H_DESDE_FN <= 0) and  H_DESDE <> ''"
           RS5.Open FILTSQL$(SQLX$), FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText
           If Err Then
            On Error GoTo 0
            Call CapturaErrorOpen
            GoTo 55
           End If
           With RS5
            Do While Not .EOF
               HD$ = SAFETEXT$(!H_DESDE)
               !H_DESDE_FN = HORANUM(HD$, "NOMESS")
               .Update
               .MoveNext
            Loop
           End With
           RS5.Close
           Set RS5 = Nothing
       End If
       
       RS4.Close
       Set RS4 = Nothing
       Me.Caption = "Informes de Procesos de Fábrica"
End Sub

