Function CorteEnvap(CI1%)
   SQLX$ = "SELECT  CORTE FROM ESPECIFIC WITH(NOLOCK) "
   SQLX$ = SQLX$ + " WHERE COD_INTE = " & CI1% & " ORDER BY ID"
   Set rs = READSET(SQLX$)
   Do While Not rs.EOF
    CorteEnvap = FORMATNUM$(XVALO(rs!corte), "F12.4")
    rs.MoveNext
   Loop
   rs.Close
   Set rs = Nothing
End Function

