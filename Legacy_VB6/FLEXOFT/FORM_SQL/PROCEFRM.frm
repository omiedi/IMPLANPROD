Private Sub mnuAsigTbDot_Click()
    'ESTA RUTINA ASIGNA AL CAMPO QUE TIENE EL NOMBRE DE LA SOLAPA SUPERIOR E INFERIOR SEGUN EL INDICE DE LA SOLAPA
     If CLACONTRA < 1 Then Exit Sub
     TABLA$ = "DOTACION"
10   SQLX$ = "SELECT SOLAPAINF ,SOLAPASUP,INDISOLINF ,INDISOLSUP from " & TABLA$ & "   WHERE MARBORRA < 1 AND (SOLAPAINF = '' OR  SOLAPASUP = '' OR SOLAPAINF IS NULL OR SOLAPASUP  IS NULL) "
     Dim rs As ADODB.Recordset
     Set rs = New ADODB.Recordset
25   On Error Resume Next
     rs.Open FILTSQL$(SQLX$), FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText
     If Err Then
      On Error GoTo 0
      Call CapturaErrorOpen
      GoTo 25
     End If
     J& = 0
     With rs
       Do While Not .EOF
          J& = J& + 1
          INSOLSUP% = XVALO(!INDISOLSUP)
          INSOLINF% = XVALO(!INDISOLINF)
          
          Select Case INSOLSUP%
            Case 0: NAMESOLAPASUP$ = "IMPRESIÓN"
            Case 1: NAMESOLAPASUP$ = "TUBERA"
            Case 2: NAMESOLAPASUP$ = "GOFRADORA"
            Case 3: NAMESOLAPASUP$ = "FONDERA"
            Case 4: NAMESOLAPASUP$ = "SELLADO"
            Case 5: NAMESOLAPASUP$ = "COSTURA"
            Case 6: NAMESOLAPASUP$ = "COLOCACIÓN DE POLIETILENO"
            Case 7: NAMESOLAPASUP$ = "VALVULA / MANGAS"
            Case 8: NAMESOLAPASUP$ = "IMPRESIÓN  DE POLIPROPILENO" 'IMPRESIÓN  DE POLIPRO -PILENO
            Case 9: NAMESOLAPASUP$ = "COSTURA DE POLIPROPILENO" ' COSTURA DE POLI- PROPILENO
            Case 10: NAMESOLAPASUP$ = "CORTADORA  DE POLIPROPILENO" 'CORTADORA  DE POLI- PROPILENO
            Case 11: NAMESOLAPASUP$ = "EMBALAJE"
          Case Else
            NAMESOLAPASUP$ = "NO IDENTIFICADA"
          End Select
          !SOLAPASUP = NAMESOLAPASUP$
          
          If INSOLINF% < 1 Then
            !SOLAPAINF = "PARTE DIARIO DE PRODUCCIÓN"
          End If
          .Update
          .MoveNext
       Loop
     End With
     rs.Close
     Set rs = Nothing
     Call COMUNI("SE HAN ASIGNADO DESCRIPCION DE LA SOLAPA EN " & J& & " REGISTROS A TABLA " & TABLA$)

