Private Sub mnuControlOrdenPf_Click()
    'ESTE PROCESO RECORRE EL PEDDETA DE LOS PEDIDOS PENDIENTES
    'ORDENADO POR NRO DE PEDIDO, CODIGO, Y FECHA DE ENTREGA
    'EN CADA REGISTRO LLAMA A LA RUTINA ACTUALIZA_ORDEN_ORFA
    'DONDE BUSCA SI HAY UNA ORDEN DE FABRICACION GENERADA PARA ESE PEDIDO, CODIGO Y QUE COINCIDA LA CANTIDAD
    'PEDIDA CON LA PROYECTADA Y TAMBIEN QUE TENGA EL NORDEN EN 0
    'EN ESE CASO LE AGREGA AL PRIMER REGISTRO QUE ENCUENTRA EL N.DE ORDEN Y SE VA
    '
    Screen.MousePointer = 11
    SQLX$ = "SELECT * FROM PEDDETA WITH(NOLOCK) WHERE CanPed > CantEnt "
    SQLX$ = SQLX$ + " ORDER BY NROPED,CODIINT,FESOLENT "
    Set rs = READSET(SQLX$)
    With rs
      Do While Not .EOF
        NP& = XVALO(!NROPED)
        CI1% = XVALO(!CODIINT)
        NUOR% = XVALO(!NuOrItem)
        CANPED& = XVALO(!CANPED)
        FEENT% = CVINT(!FeSolEnt)
        Call ACTUALIZA_ORDEN_ORFA(NP&, CI1%, NUOR%, CANPED&)
        .MoveNext
      Loop
    End With
    Screen.MousePointer = 1
    Call COMUNI("Proceso Finalizado")
End Sub

Sub ACTUALIZA_ORDEN_ORFA(NP&, CI1%, NUOR%, CANPED&)
        SQLX$ = "SELECT * FROM ORDEFABR WHERE NROPED = " & NP&
        SQLX$ = SQLX$ + " AND COD_INTE = " & CI1%
        SQLX$ = SQLX$ + " AND (NUORPROD < 1 OR NUORPROD IS NULL)"
        SQLX$ = SQLX$ + " AND CANPROY = " & CANPED&
        SQLX$ = SQLX$ + " ORDER BY NUMEORFA"
        Dim RSS As ADODB.Recordset
        Set RSS = New ADODB.Recordset
25      On Error Resume Next
        RSS.Open FILTSQL$(SQLX$), FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText
        If Err Then
        On Error GoTo 0
        Call CapturaErrorOpen
        GoTo 25
        End If
        With RSS
          Do While Not .EOF
             !NUORPROD = NUOR%
             .Update
             Exit Do
          Loop
        End With
        RSS.Close
        Set RSS = Nothing

End Sub
