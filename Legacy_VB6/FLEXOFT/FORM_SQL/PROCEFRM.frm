         SQLX$ = SQLX$ + " group by idsubor,cod_inte,cod_exte,usounit"
         Set rs1 = READSET(SQLX$)
         With rs1
           Do While Not .EOF
             CANTIRESERVADA = XVALO(!CANTRES)
             USOUNITARIOX = XVALO(!UsoUnit)
             CI_COMPONENTE = XVALO(!cod_inte)
                  SQLX$ = "SELECT count(*) AS CANTIVECES  ,CodIConj,CodXConj, CODIELEM, CODXELEM"
                  SQLX$ = SQLX$ + " FROM FORMULAS WITH(NOLOCK) WHERE CodIConj= " & CI_ORFA & " AND  CODIELEM  = " & CI_COMPONENTE
                  SQLX$ = SQLX$ + " GROUP BY CodIConj,CodXConj, CODIELEM, CODXELEM HAVING COUNT(*) > 1"
                  Set RS2 = READSET(SQLX$)
                  CANTIXVECES = XVALO(RS2!CANTIVECES)
                  CANTIDAD_A_RESERVAR = (CANTIXVECES * USOUNITARIOX) * CANTI_ORFA
                  CONDI$ = "IDSUBOR = '" & NORFA$ & "' AND COD_INTE = " & CI_COMPONENTE
