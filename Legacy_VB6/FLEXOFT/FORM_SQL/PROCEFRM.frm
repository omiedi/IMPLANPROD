Sub ACTUALIZACODTAREA()
    'ESTE PROCESO ES PARA RECUPEAR EL CODIGO DE TAREA POR QUE ANTES NO SE GUARDABA.
    Call PoneEnCeroNull("PDIARPROD2", "CODTAREA", REAGAF&, "NOMESS")
    SQLX$ = "SELECT DESCRIPTAREA,CODTAREA FROM PDIARPROD2 "
    SQLX$ = SQLX$ + " WHERE CODTAREA < 1 "
    Dim rs As ADODB.Recordset
    Set rs = New ADODB.Recordset
25  On Error Resume Next
    rs.Open FILTSQL$(SQLX$), FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText     ' SE MODIFICO EL adOpenDynamic POR EL adOpenKeyset
    '
    If Err Then  'VALIDACION DE ERROR POR SI GENERA ERROR POR TIEMPO DE ESPERA
       On Error GoTo 0
       Call CapturaErrorOpen
       GoTo 25
    End If
    With rs
      Do While Not .EOF
        CONDI$ = "CAMPO2 = '" & SAFETEXT$(!DESCRIPTAREA) & "' AND LISTA  = 'TAREAS'"
        COTAREA& = XVALO(VALOBADA("DATASQL", "CAMPO1", CONDI$, "NOMESS"))
        !CODTAREA = COTAREA&
        .Update
        .MoveNext
      Loop
    End With
    rs.Close
    Set rs = Nothing
End Sub


Function CANTSCRAP(NORFA$, FE%, Optional MAQUINA, Optional INDISOLSUP%, Optional INDISOLINF%)
    CONDI$ = "IDSUBOR = '" & NORFA$ & "' AND FECHA = '" & FETEXCOR1$(FE%) & "'"
    If TRIM(MAQUINA) <> "" Then CONDI$ = CONDI$ + " AND NUMMAQUI = '" & MAQUINA & "'"
    If XVALO(INDISOLSUP) >= 0 Then CONDI$ = CONDI$ + " AND INDISOLSUP = " & INDISOLSUP%
'    If XVALO(INDISOLINF) >= 0 Then CONDI$ = CONDI$ + " AND INDISOLINF = " & INDISOLINF% ' no esta bien que se considere
    CANTSCRAP = XVALO(VALOBADA("DESCARCONS", "SUM(CANT_DESC)", CONDI$, "NOMESS"))
End Function


