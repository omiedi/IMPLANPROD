    'CAMPOS$ = "1 Operación/A20; 2 Fecha/D8;3 Horas/A12;4 Máq./A6;5 Usuarios/A20;6 Cant.Ok/f10.1;7 M.P.Código/A16;8 DEscripcion/A32;9 Proveedor/A16;10 Lote/A14;11 Controles OK/A8"
    VENTANA.Campox = Campos$
    VENTANA.Inicializar = 1
