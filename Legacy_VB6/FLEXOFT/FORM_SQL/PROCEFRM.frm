    Me.TXTTOTBOBINAS2(i%) = ""
'    Me.TXTTOTALDESC2(i%) = ""
    Me.TXTTOTCANTI2(i%) = ""
    Me.TXTULTGRAB(i%) = ""
    Call LIMPIAR_MSF_SIN_BORRAR_REGISTROS(MSF11(i%), 2)
    On Error GoTo 0
  Case 11
    A = 1
  Case Else
    Call LIMPIAR_MSF_SIN_BORRAR_REGISTROS(MSF8(i%), 2)
  End Select
  
  
  If SOLIN% = 1 Then
       TXTULTGRABCONS(i%) = ""
  ElseIf SOLIN% = 2 Then
      TXTULTCHECK1(i%) = ""
  End If
  Command30(i%).Visible = False

