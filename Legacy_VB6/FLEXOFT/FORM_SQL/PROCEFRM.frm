Private Sub mnuPteDiProTodos_Click()
     
    INDISOLINF = GLOBALFRM_SOLAINF%
    INDISOLSUP = GLOBALFRM_SOLASUP%
    textox$ = TRIM$(SSTab1.Caption)
    
    Select Case INDISOLSUP
      Case 4, 5, 6, 7, 9 ' COSTURA - SELLADO - COSTURA - COLOCACION DE POLIETILENO - VALVULA - COSTURA
       If INDISOLINF = 0 Then 'PARTE DIARIO DE PRODUCCION
            Call SELECHO("SELFECHA")
            VDEV$ = VALACT1$("SELFECHA")
            If VDEV$ = "" Then Exit Sub
            FILTX$ = TRIM$(VDEV$) & ";" & TRIM$(Str$(INDISOLSUP)) & ";" & TRIM$(Str$(INDISOLINF)) & ";" & textox$
            Call STDFORM("PDCS-ENV", FILTX$)
       End If
      Case 0, 1, 2, 3, 5, 8, 10
       If INDISOLINF = 0 Then 'PARTE DIARIO DE PRODUCCION
            Call SELECHO("SELFECHA")
            VDEV$ = VALACT1$("SELFECHA")
            If VDEV$ = "" Then Exit Sub
20          OPX% = COMALTER%("Seleccionar !!!\\ Cancelar\Detalle de Parte Diario\Resumen (Totales)")
            If OPX% < 2 Then
              Exit Sub
            ElseIf OPX% = 2 Then
               FILTX$ = TRIM$(VDEV$) & ";" & TRIM$(Str$(INDISOLSUP)) & ";" & TRIM$(Str$(INDISOLINF)) & ";" & textox$
               Call STDFORM("PDIM-ENV", FILTX$)
               GoTo 20
            Else
               'ARMO LA CONSULTA LA MISMA QUE TIENE EL REPORTE QUE MUESTRA STDFORM
               FECHX = FETEXCOR1$(FECHANUM(VDEV$))
               CONDI$ = "FECHA = '" & FECHX & "'"
