       DESDEX% = HORANUM(RS0!H_DESDE)
       HASTAX% = HORANUM(RS0!H_HASTA)
       NUSER%(1) = XVALO(RS0!NUMAYUD1): NAMEUS$(1) = SAFETEXT$(RS0!NAMEAYUD1)
       NUSER%(2) = XVALO(RS0!NUMAYUD2): NAMEUS$(2) = SAFETEXT$(RS0!NAMEAYUD2)
       NUSER%(3) = XVALO(RS0!NUMAYUD3): NAMEUS$(3) = SAFETEXT$(RS0!NAMEAYUD3)
       NUSER%(4) = XVALO(RS0!NUMAYUD4): NAMEUS$(4) = SAFETEXT$(RS0!NAMEAYUD4)
       NUSER%(5) = XVALO(RS0!NUMAYUD5): NAMEUS$(5) = SAFETEXT$(RS0!NAMEAYUD5)
       NUSER%(6) = XVALO(RS0!NUMAYUD6): NAMEUS$(6) = SAFETEXT$(RS0!NAMEAYUD6)
       NUSER%(7) = XVALO(RS0!NUMAYUD7): NAMEUS$(7) = SAFETEXT$(RS0!NAMEAYUD7)
       NUSER%(8) = XVALO(RS0!NUMAYUD8): NAMEUS$(8) = SAFETEXT$(RS0!NAMEAYUD8)
       NUSER%(9) = XVALO(RS0!NUMUSUMAQ): NAMEUS$(9) = SAFETEXT$(RS0!NAMEUSUMAQ)
       NUSER%(10) = XVALO(RS0!NULIDOP1): NAMEUS$(10) = SAFETEXT$(RS0!NULNAMEOP1)
       NUSER%(11) = XVALO(RS0!NULIDOP2): NAMEUS$(11) = SAFETEXT$(RS0!NULNAMEOP2)

       SOLASUPERIOR% = XVALO(RS0!INDISOLSUP)
       DESCRISOLAP$ = SAFETEXT$(RS0!SOLAPASUP)
       DESBORDE% = 0
       jj& = 0: INICIALIZO% = 0
       For i% = 1 To UBound(NUSER%)
           If NUSER%(i%) > 0 Then
             SQLX$ = "SELECT * FROM DOTACION WITH(NOLOCK) WHERE FECHA = '" & FETEXCOR1$(FE%) & "' AND NUSER = " & NUSER%(i%)
             SQLX$ = SQLX$ + " AND IDSUBOR = '" & NORFA$ & "' AND INDISOLSUP = " & SOLASUPERIOR%
             SQLX$ = SQLX$ + " ORDER BY H_DESDE"
             Set rs = READSET(SQLX$)
             With rs
'                 ACA REVISO QUE LA HORAS DE PRODUCCION INFORMADAS ESTEN  DENTRO DE LAS INFORMADAS COMO DOTACION
'                 PARA MISMA ORDEN, FECHA Y SECTOR
                  Do While Not .EOF
                    DESBORDE% = 0
                    DESLEIDA% = HORANUM(!H_DESDE)
                    HASLEIDA% = HORANUM(!H_HASTA)
                    If DESDEX% < DESLEIDA% Then DESBORDE% = 1
                    If HASTAX% >= DESLEIDA% Then
                       If HASLEIDA% <= 0 Then DESBORDE% = 0 ' SI EL HASTA NO ESTA CARGADO LO DEJA CONTINUAR
                       'PARA CUANDO SOLO INICIALIZAN LA DOTACION Y LA COMPLETAN AL TERMINAR.
                       If HASTAX% <= HASLEIDA% Then
                          DESBORDE% = 0
                          Exit Do
                       Else
                          DESBORDE% = 1
                          DESDEX% = HASLEIDA%
                       End If
                    End If
                    .MoveNext
                  Loop
               End With
               rs.Close
               Set rs = Nothing
               'SI DESBORDA LA CARGA EN UN ZELECHO PARA INFORMAR LA SITUACION.
               If DESBORDE% > 0 Then
                  US1% = NUSER%(i%)
                  NAMEUSS$ = NAMEUS$(i%)
                  SECTOR = INDISOLSUP = " & SOLASUPERIOR%"
                  TXSECTOR$ = DESCRISOLAP$
                  jj& = jj& + 1
                  If jj& = 1 Then
                     Campos$ = "Us./f5;Nombre/A20;Sector/A20;Fecha/D8;O.Fab./A12;H.Desde/H10;H.Hasta/H10"
                     Call CARGA_ENCABEZADO(FRMZELECHO.MSF1, Campos$, FRMZELECHO)
                  End If
                  TEXTOGRILLA$ = US1% & "|" & NAMEUSS$ & "|" & TXSECTOR$ & "|" & FECHATEX$(FE%) & "|" & NORFA$ & "|" & HORATEX$(DESDEX%) & "|" & HORATEX$(HASTAX%)
                  Call CARGA_GRILLA_GENERICO(FRMZELECHO, FRMZELECHO.MSF2, Campos$, TEXTOGRILLA$, INICIALIZO%)
               End If

           End If
           
       Next i%

       RS0.MoveNext
      Loop
      RS0.Close
      Set RS0 = Nothing
      If jj& > 0 Then
        FRMZELECHO.Width = 13000
        FRMZELECHO.MSF2.col = 1
        FRMZELECHO.MSF2.Sort = 1
        FRMZELECHO.mnuImprimir.Visible = True
        FRMZELECHO.Show 1
      Else
        Call COMUNI("No se Han Encontrado Inconsistencias de Cargas de Producción")
      End If
      
      '
      If FRMZELECHO.IMPRIMIR > 0 Then
        Dim MSFX As msFlexGrid
        Set MSFX = FRMZELECHO.MSF2
        If FRMZELECHO.MSF1.Rows > 1 Then Set MSFX = FRMZELECHO.MSF1
        Call CARGA_TABLA_IMPRE(MSFX, Campos$, "ESTADMES", "ESTADÍSTICO DE CONSUMOS FORMATO MENSUAL", "TABLA_IMPRE", RET_NAMECONS$, 1)
        Call FINAL("?" & RET_NAMECONS$)
      End If


'90        If DESBORDE% > 0 And UCase$(MODO$) <> "NOMESS" Then
'             TX$ = "Atención !!! Se Han Informado Horas No Cargadas Como Dotación"
'             TX$ = TX$ + "\Para el Usuario: " & NUSER%
'             TX$ = TX$ + "\En Orden de Fabricación: " & NORFA$
'             TX$ = TX$ + "\Sector: " & SSTab1.Caption
'             Call COMUNI(TX$)
'             Exit Function
'          End If


End Function
Function TOTALHORASDELCALRADAS(NORFA$, INDISOLSUPX%)
        TOTALHORAX = 0
        SQLX$ = "SELECT  P.H_DESDE,P.H_HASTA,P.NUMAYUD1,P.NUMAYUD2,P.NUMAYUD3,P.NUMAYUD4,P.NUMAYUD5,P.NUMAYUD6,P.NUMAYUD7,P.NUMAYUD8 "
        SQLX$ = SQLX$ + " ,P.FECHA,P.IDSUBOR,P.NULIDOP1,P.NULIDOP2,P.SOLAPASUP,P.PDIARPROD1_ID,P.INDISOLSUP,P.NUMUSUMAQ,P.H_TRABAJADAS FROM(SELECT H_DESDE,H_HASTA "
        SQLX$ = SQLX$ + " ,NUMAYUD1,NUMAYUD2 , NUMAYUD3, NUMAYUD4, NUMAYUD5, NUMAYUD6, NUMAYUD7, NUMAYUD8, FECHA, IDSUBOR, NULIDOP1, NULIDOP2 "
        SQLX$ = SQLX$ + " ,SOLAPASUP, INDISOLSUP,PDIARPROD1_ID,NUMUSUMAQ,H_TRABAJADAS FROM PDIARPROD1  union all SELECT H_DESDE,H_HASTA,NULNUMAYUD1,NULNUMAYUD2"
        SQLX$ = SQLX$ + " ,NULNUMAYUD3,NULNUMAYUD4,NULNUMAYUD5,NULNUMAYUD6,NULNUMAYUD7,NULNUMAYUD8,FECHA,IDSUBOR,IDOP1,IDOP2,SOLAPASUP"
        SQLX$ = SQLX$ + " ,INDISOLSUP,PDIARPROD2_ID,NULNUMUSUMAQ,H_TRABAJADAS  FROM PDIARPROD2)"
        SQLX$ = SQLX$ + " AS P  WHERE  P.IDSUBOR = '" & NORFA$ & "' AND  P.INDISOLSUP = " & INDISOLSUPX%
        Set rs = READSET(SQLX$, , 1)
        With rs
          Do While Not .EOF
              CANTIOPX% = 0
              AY1% = XVALO(!NUMAYUD1): If AY1% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY2% = XVALO(!NUMAYUD2): If AY2% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY3% = XVALO(!NUMAYUD3): If AY3% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY4% = XVALO(!NUMAYUD4): If AY4% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY5% = XVALO(!NUMAYUD5): If AY5% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY6% = XVALO(!NUMAYUD6): If AY6% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY7% = XVALO(!NUMAYUD7): If AY7% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY8% = XVALO(!NUMAYUD8): If AY8% > 0 Then CANTIOPX% = CANTIOPX% + 1
              IDO1% = XVALO(!NULIDOP1): If IDO1% > 0 Then CANTIOPX% = CANTIOPX% + 1
              IDO2% = XVALO(!NULIDOP2): If IDO2% > 0 Then CANTIOPX% = CANTIOPX% + 1
              MAQX% = XVALO(!NUMUSUMAQ): If MAQX% > 0 Then CANTIOPX% = CANTIOPX% + 1 ' SE INCLUYE AL MAQUINISTA
              HORAX = XVALO(!H_TRABAJADAS)
              TOTALHORAX = TOTALHORAX + (CANTIOPX% * HORAX) 'CANTIDAD DE OPERARIOS POR HORAS DECLARADAS EN ESE REGISTRO
          .MoveNext
          Loop
        End With
        rs.Close: Set rs = Nothing
        TOTALHORASDELCALRADAS = TOTALHORAX
End Function

Sub USUARIOS_PDIARIO1(ID&, RETMAQ%, RET1%, RET2%, RET3%, RET4%, RET5%, RET6%, RET7%, RET8%)
   RE1% = 0: RET2% = 0: RET3% = 0: RET4% = 0: RET5% = 0: RET6% = 0: RET7% = 0: RET8% = 0
   If ID& < 1 Then Exit Sub
   SQLX$ = "SELECT NUMUSUMAQ,NUMAYUD1,NUMAYUD2,NUMAYUD3,NUMAYUD4,NUMAYUD5,NUMAYUD6,NUMAYUD7,NUMAYUD8"
   SQLX$ = SQLX$ + " FROM PDIARPROD1 WITH(NOLOCK) WHERE PDIARPROD1_ID = " & ID&
   Set rs = READSET(SQLX$)
   With rs
    If Not .EOF Then
      RETMAQ% = XVALO(!NUMUSUMAQ)
      RET1% = XVALO(!NUMAYUD1)
      RET2% = XVALO(!NUMAYUD2)
      RET3% = XVALO(!NUMAYUD3)
      RET4% = XVALO(!NUMAYUD4)
      RET5% = XVALO(!NUMAYUD5)
      RET6% = XVALO(!NUMAYUD6)
      RET7% = XVALO(!NUMAYUD7)
      RET8% = XVALO(!NUMAYUD8)
     End If
   End With
   
   rs.Close
   Set rs = Nothing
End Sub

Function VALI_SOLAP_HOR_ENGRILLA%(MSF As msFlexGrid, REG&, Des%, Has%, COLDES%, COLHAS%, Optional COLUMNAUSER%, Optional USUARIO%)
    VALI_SOLAP_HOR_ENGRILLA% = 0
    For i& = 1 To MSF.Rows - 1
      DESLEIDO% = HORANUM(MSF.TextMatrix(i&, COLDES%))
      HASLEIDO% = HORANUM(MSF.TextMatrix(i&, COLHAS%))
      A = 0
      If i& <> REG& Then
        If COLUMNAUSER% > 0 Then
          If XVALO(MSF.TextMatrix(i&, COLUMNAUSER%)) = USUARIO% Then
            A = HAY_SOLAPAMIENTO_HORARIO%(Des%, Has%, DESLEIDO%, HASLEIDO%)
          End If
        Else
          A = HAY_SOLAPAMIENTO_HORARIO%(Des%, Has%, DESLEIDO%, HASLEIDO%)
        End If
        If A > 0 Then
          VALI_SOLAP_HOR_ENGRILLA% = 1
        End If
      End If
    
    Next i&
End Function

Function VALIDAR_SOLAPAMIENTO_HORARIO_ANT%(NUSER%, FE%, DESDX%, HASTX%, MODO$)
    VALIDAR_SOLAPAMIENTO_HORARIO% = 0
    SQLX$ = "SELECT  P.H_DESDE,P.H_HASTA,P.NUMAYUD1,P.NUMAYUD2,P.NUMAYUD3,P.NUMAYUD4,P.NUMAYUD5,P.NUMAYUD6,P.NUMAYUD7,P.NUMAYUD8,P.FECHA,P.IDSUBOR"
    SQLX$ = SQLX$ + " FROM ( "
    SQLX$ = SQLX$ + " SELECT H_DESDE,H_HASTA,NUMAYUD1,NUMAYUD2,NUMAYUD3,NUMAYUD4,NUMAYUD5,NUMAYUD6,NUMAYUD7,NUMAYUD8,FECHA,IDSUBOR "
    SQLX$ = SQLX$ + " FROM PDIARPROD1 "
    SQLX$ = SQLX$ + " union all"
    SQLX$ = SQLX$ + " SELECT H_DESDE,H_HASTA,NULNUMAYUD1,NULNUMAYUD2,NULNUMAYUD3,NULNUMAYUD4,NULNUMAYUD5,NULNUMAYUD6,NULNUMAYUD7,NULNUMAYUD8,FECHA,IDSUBOR "
    SQLX$ = SQLX$ + " FROM PDIARPROD2 ) AS P"
    SQLX$ = SQLX$ + " WHERE (P.NUMAYUD1 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD2 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD3 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD4 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD5 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD6 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD7 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD8 =" & NUSER%
    SQLX$ = SQLX$ + " ) AND P.FECHA = '" & FETEXCOR1$(FE%) & "'"
    '
    Set rs = READSET(SQLX$, , 1)
    With rs
      Do While Not .EOF
         k& = k& + 1
         DESLEIDO% = HORANUM(SAFETEXT$(!H_DESDE))
         HASLEIDO% = HORANUM(SAFETEXT$(!H_HASTA))
 
         NORFA$ = SAFETEXT$(!idsubor)
        
         If HAY_SOLAPAMIENTO_HORARIO%(DESDX%, HASTX%, DESLEIDO%, HASLEIDO%) > 0 Then   ' ESTA FUNCION VALIDA SI EXISTE SOLAPAMIENTO HORARIO
            If InStr(UCase$(MODO$), "NOMESS") < 1 Then
               Call COMUNI("Usuario N° " & NUSER% & " \Solapamiento Horario Con Orden de Fabricación: " & NORFA$)
               VALIDAR_SOLAPAMIENTO_HORARIO% = 1
               Exit Function
            End If
         End If
         .MoveNext
       Loop
    End With
    rs.Close
    Set rs = Nothing
         
          
End Function

Function VALIDAR_SOLAPAMIENTO_HORARIO2%(NUSER%, FE%, DESDX%, HASTX%, MODO$, ID&, Optional GRUPOSOLAP%)
    'ESTA FUNCION RECORRE LAS DOS TABLAS DONDE SE DECLARAN LAS  HORAS TRABAJADAS Y CHEQUE QUE
    'QUE UN MISMO DIA NO SE DECLAREN PARA EL MISMO OPERARIO HORAS QUE SE ENCIMEN CON OTRAS DECLARADAS POR EL MISMO OPERARIO
    VALIDAR_SOLAPAMIENTO_HORARIO2% = 0
    If NUSER% < 1 Then Exit Function
    SQLX$ = "SELECT  P.H_DESDE,P.H_HASTA,P.NUMAYUD1,P.NUMAYUD2,P.NUMAYUD3,P.NUMAYUD4,P.NUMAYUD5,P.NUMAYUD6,P.NUMAYUD7,P.NUMAYUD8,P.FECHA,P.IDSUBOR,P.NULIDOP1,P.NULIDOP2,P.SOLAPASUP,P.PDIARPROD1_ID,P.NUMUSUMAQ"
    SQLX$ = SQLX$ + " FROM ( "
