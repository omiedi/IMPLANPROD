                      SQLX$ = SQLX$ + " SELECT Cod_Inte, CodiEmpr, Cod_Exte, Descrip, IdSubOr, NuOrItem, Status, FechRes, '" & FORMATNUM$(CANTIDAD_A_RESERVAR, "F12.4") & "',CantCons,   '" & FORMATNUM$(CANTIDAD_A_RESERVAR, "F12.4") & "', IdenLote, Deposito, UbicaLot, UsoUnit, Observa, PNL_Des, PLC_Has, Nume_Solint, Nume_Ocom, Marborra,  NUMEROSERIE  FROM RESERVA "
