Private Sub AsigNPedSOF_Click()
    If CLACONTRA < 1 Then Exit Sub
    'Esta rutina asigna a tabla de PDIARPROD1 y PDIARPROD2 que no tengan el nro de pedido le asigna segun of
     TABLA$ = "PDIARPROD1"
10   SQLX$ = "select NROPED,IDSUBOR from " & TABLA$ & "   WHERE   NroPed < 1"
     Dim rs As ADODB.Recordset
     Set rs = New ADODB.Recordset
25   On Error Resume Next
     rs.Open FILTSQL$(SQLX$), FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText
     If Err Then
      On Error GoTo 0
      Call CapturaErrorOpen
      GoTo 25
     End If
     J& = 0
     With rs
       Do While Not .EOF
          J& = J& + 1
          NORFA$ = SAFETEXT$(!idsubor)
          !NROPED = NroPedidoSegunOf&(NORFA$)
          .Update
          .MoveNext
       Loop
     End With
     rs.Close
     Set rs = Nothing
