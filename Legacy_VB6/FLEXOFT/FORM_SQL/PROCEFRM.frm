    SQLX$ = SQLX$ + " FROM PDIARPROD2 ) AS P"
    SQLX$ = SQLX$ + " WHERE (P.NUMAYUD1 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD2 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD3 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD4 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD5 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD6 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD7 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMAYUD8 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NULIDOP1 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NULIDOP2 =" & NUSER%
    SQLX$ = SQLX$ + " OR P.NUMUSUMAQ =" & NUSER%
    SQLX$ = SQLX$ + " ) AND P.FECHA = '" & FETEXCOR1$(FE%) & "'"
    '
    Set rs = READSET(SQLX$, , 1)
    With rs
      Do While Not .EOF
         k& = k& + 1
         DESLEIDO% = HORANUM(SAFETEXT$(!H_DESDE))
         HASLEIDO% = HORANUM(SAFETEXT$(!H_HASTA))
         IDLEIDO& = XVALO(!PDIARPROD1_ID)
         
         NORFA$ = SAFETEXT$(!idsubor)
         DESCRISOLAPA$ = SAFETEXT$(!SOLAPASUP)
         If HAY_SOLAPAMIENTO_HORARIO%(DESDX%, HASTX%, DESLEIDO%, HASLEIDO%) > 0 Then ' ESTA FUNCION VALIDA SI EXISTE SOLAPAMIENTO HORARIO
           If ID& <> IDLEIDO& Then  ' SI ES EL MISMO REGISTRO NO LO CONSIDERA
             If InStr(UCase$(MODO$), "NOMESS") < 1 Then
               d = HORATEX$(DESDX%)
               h = HORATEX$(HASTX%)
               DL = HORATEX$(DESLEIDO%)
               HL = HORATEX$(HASLEIDO%)
               RX$ = "Usuario N° " & NUSER% & " \Solapamiento Horario ("
               RX$ = RX$ + "" & d & " / " & h & ") \Con Orden de Fabricación: " & NORFA$ & ""
               RX$ = RX$ + "\En Sector: " & DESCRISOLAPA$ & "(" & DL & " / " & HL & ")"
               Call COMUNI(RX$)
               VALIDAR_SOLAPAMIENTO_HORARIO2% = 1
               Exit Function
             End If
           End If
         End If
         .MoveNext
       Loop
    End With
    rs.Close
    Set rs = Nothing
         
          
End Function
Sub CARGA_SELECHO_CONTROL_SOLOP_DOTACION(NUSER%, FE%, DESDX%, HASTX%, ID&, NORFAPARAM$, DESCRISOLAP$)
    L& = 0
    Static COLOR

    NOMBREUSRSQL$ = NAMEUSERSQL$(NUSER%)
    SQLX$ = "SELECT  NUSER,NOMBRE,FECHA,IDSUBOR,SOLAPASUP,DOTACION_ID,H_DESDE,H_HASTA"
    SQLX$ = SQLX$ + " FROM  DOTACION"
    SQLX$ = SQLX$ + " WHERE FECHA = '" & FETEXCOR1$(FE%) & "'"
    SQLX$ = SQLX$ + " AND NUSER = " & NUSER%
    '
    Set rs = READSET(SQLX$, , 1)
    With rs
      Do While Not .EOF
         k& = k& + 1
         DESLEIDO% = HORANUM(SAFETEXT$(!H_DESDE))
         HASLEIDO% = HORANUM(SAFETEXT$(!H_HASTA))
         IDLEIDO& = XVALO(!DOTACION_ID)
         NORFA$ = SAFETEXT$(!idsubor)
         DESCRISOLAPA$ = SAFETEXT$(!SOLAPASUP)
 Me.Caption = DESLEIDO% & " " & HASLEIDO%
         If HAY_SOLAPAMIENTO_HORARIO%(DESDX%, HASTX%, DESLEIDO%, HASLEIDO%) > 0 Then ' ESTA FUNCION VALIDA SI EXISTE SOLAPAMIENTO HORARIO
           If ID& <> IDLEIDO& Then  ' SI ES EL MISMO REGISTRO NO LO CONSIDERA
               d = HORATEX$(DESDX%)
               h = HORATEX$(HASTX%)
               DL = HORATEX$(DESLEIDO%)
               HL = HORATEX$(HASLEIDO%)
               GoSub CARGOZELECHO
           End If
         End If
         .MoveNext
       Loop
    End With
    rs.Close
    Set rs = Nothing
            GoTo 80
