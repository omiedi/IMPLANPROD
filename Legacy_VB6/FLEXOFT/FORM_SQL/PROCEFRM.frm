Private Sub CMDAPLPP_Click(Index As Integer)
   CMDAPLPP(Index).Enabled = False
   If TRIM$(Me.TXTOT) = "" Then
     Call COMUNI("No Hay Una Orden de Fabricación Seleccionada")
     GoTo 99
   End If
   If FilaVacia%(MSF10(Index)) > 0 Then GoTo 99
   
   FE% = FECHANUM(Me.TXTFECHA(Index))
   FEHOY% = HOYSERVER%
   If FE% <> FEHOY% Then
      OPX% = COMALTER%("ATENCIÓN !!\Fecha Asignada Difiere de la Fecha Actual\\Cancelar\Aplicar Igual")
      If OPX% < 2 Then GoTo 99
   End If
   '
   X = FilaVacia%(MSF2(Index), 1)
   '
   If Index <> 11 Then
        If TRIM$(Me.TXTIDMAQ(Index)) = "" Then
           Call COMUNI("Imposible Aplicar - Falta Ingresar Maquina")
           GoTo 99
        End If
        
        If XVALO(Me.TXTIDMAQUINISTA(Index)) + XVALO(Me.TXTNUMAYUDANTE1(Index)) + XVALO(Me.TXTNUMAYUDANTE2(Index)) + XVALO(Me.TXTNUMAYUDANTE3(Index)) + XVALO(Me.TXTNUMAYUDANTE4(Index)) < 1 Then
           Call COMUNI("Debe Ingresar Al Menos un Maquinista o un Ayudante")
           GoTo 99
        End If
        '
'        If XVALO(Me.TXTIDMAQUINISTA(Index)) <= 0 Then
'           Call COMUNI("Imposible Aplicar - Falta Ingresar Maquinista")
'           GoTo 99
'        End If
    Else
       If XVALO(Me.TXTNUMAYUDANTE1(Index)) + XVALO(Me.TXTNUMAYUDANTE2(Index)) + XVALO(Me.TXTNUMAYUDANTE3(Index)) + XVALO(Me.TXTNUMAYUDANTE4(Index)) < 1 Then
        Call COMUNI("Debe Ingresar Al Menos un Ayudante")
        GoTo 99
       End If

    End If
    
    'VALIDACION DE SOLAPAMIENTO EN PARTES DIARIOS DE PRODUCCION
    
    Dim MSF As msFlexGrid
    Set MSF = MSF10(Index)
    Dim VECAYUDANTES%(): INDIX% = 0
    If XVALO(TXTIDMAQUINISTA(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTIDMAQUINISTA(INDISOLSUP%))
    If XVALO(TXTNUMAYUDANTE1(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTNUMAYUDANTE1(INDISOLSUP%))
    If XVALO(TXTNUMAYUDANTE2(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTNUMAYUDANTE2(INDISOLSUP%))
    If XVALO(TXTNUMAYUDANTE3(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTNUMAYUDANTE3(INDISOLSUP%))
    If XVALO(TXTNUMAYUDANTE4(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTNUMAYUDANTE4(INDISOLSUP%))
    'valido primero el solapamiento en grilla
    Select Case Index
      Case 4, 5, 9
        DX1% = 12
        HX% = 13
        IDX% = 15
      Case 6, 7
        DX1% = 10
        HX% = 11
        IDX% = 13
      Case 11
        DX1% = 4
        HX% = 5
        IDX% = 13
        If XVALO(TXTNUMAYUDANTE1(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTNUMAYUDANTE5(INDISOLSUP%))
        If XVALO(TXTNUMAYUDANTE2(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTNUMAYUDANTE6(INDISOLSUP%))
        If XVALO(TXTNUMAYUDANTE3(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTNUMAYUDANTE7(INDISOLSUP%))
        If XVALO(TXTNUMAYUDANTE4(INDISOLSUP%)) > 0 Then INDIX% = INDIX% + 1: ReDim Preserve VECAYUDANTES%(INDIX%): VECAYUDANTES%(INDIX%) = XVALO(TXTNUMAYUDANTE8(INDISOLSUP%))
    End Select
    For i& = 1 To MSF.Rows - 1
       Des% = HORANUM(MSF.TextMatrix(i&, DX1%))
       Has% = HORANUM(MSF.TextMatrix(i&, HX%))
       If VALI_SOLAP_HOR_ENGRILLA%(MSF, i&, Des%, Has%, DX1%, HX%) > 0 Then
          Call COMUNI("Solopamiento en Rango Horario En Grilla de Carga")
          GoTo 99
       End If
    Next i&
    For i& = 1 To MSF.Rows - 1
        If TRIM$(MSF.TextMatrix(i&, DX1%)) <> "" And TRIM$(MSF.TextMatrix(i&, HX%)) <> "" Then
          FE% = FECHANUM(MSF.TextMatrix(i&, 1))
          Des% = HORANUM(MSF.TextMatrix(i&, DX1%))
          Has% = HORANUM(MSF.TextMatrix(i&, HX%))
          ID& = XVALO(MSF.TextMatrix(i&, IDX%))

          For jj% = 1 To INDIX% 'AHORA RECORRO LOS CASILLEROS DE AYUDANTES GUARDADOS EN EL VECTOR
            If VALIDAR_SOLAPAMIENTO_HORARIO2%(VECAYUDANTES%(jj%), FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
              Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
              GoTo 99
           End If
          Next jj%
        End If
    Next i&
    'FIN VALIDACION DE SOLAPAMIENTO
   '
   'ACA TRANSFIERE LOS DATOS A LA GRILLA INFERIOR
   For i& = 1 To MSF10(Index).Rows - 1
      U& = MSF2(Index).Rows
      MSF2(Index).Rows = U& + 1
      For J& = 1 To MSF10(Index).Cols - 1
        If J& = 1 Then
          Dato$ = Me.TXTFECHA(Index)
        Else
          Dato$ = TRIM$(MSF10(Index).TextMatrix(i&, J&))
        End If
        MSF2(Index).TextMatrix(U&, J&) = Dato$
      Next J&
   Next i&
   '

'   If SSTab1.Caption = "EMBALAJE" Then GoTo 80
      'ACA FALTA GENERAR CODIGO PARA TOTALIZAR
   MSF10(Index) = 1
   Me.TXTTOTBOBINAS2(Index) = ValorMaximoColumna(MSF2(Index), 7) 'MSF2(Index).TextMatrix(MSF2(Index).Rows - 1, 7) 'PONE EL VALOR DE LA ULTIMA FILA DE LA COLUMNA 7
   If Index = 11 Then Me.TXTTOTBOBINAS2(Index) = ValorMaximoColumna(MSF2(Index), 9) 'MSF2(Index).TextMatrix(MSF2(Index).Rows - 1, 9) 'embalaje PONE EL VALOR DE LA ULTIMA FILA DE LA COLUMNA 7
   Me.TXTTOTCANTI2(Index) = FORMATNUM$(XVALO(SUMA_COLUMNA_SELECCION(MSF2(Index), 8)), "F12.2")
   'Me.TXTTOTALDESC2(Index) = FORMATNUM$(XVALO(SUMA_COLUMNA_SELECCION(MSF2(Index), 11)), "F12.2")
   'Call ACTUALIZAR_HORAS2(Index)
    Me.TXTTOTALHORAS(Index) = FORMATNUM$(TOTALHORASDELCALRADAS(Me.TXTOT, GLOBALFRM_SOLASUP%), "F12.2")

   MSF10(Index).Rows = 1
   MSF10(Index).Rows = 2

   TXTFECHA(Index) = FECHATEX$(HOYSERVER%)
   MODIFICADO(Index) = 1
80 Call ORDENAR_MSF(MSF2(Index), 1, 1, 1)
   Call POSICIONAR_ULTIMAFILA(MSF2(Index))
99 CMDAPLPP(Index).Enabled = True
End Sub

