               CONDI$ = CONDI$ + " AND INDISOLINF  = " & INDISOLINF
               FECHAX$ = VDEV$
               Call ResumenParteDiario(CONDI$, textox$, CONDISCRAP$, FECHAX$)
               GoTo 20
            End If
        End If
    End Select

