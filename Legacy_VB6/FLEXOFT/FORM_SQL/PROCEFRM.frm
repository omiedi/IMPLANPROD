                'StringCodigosComponentes$ = VALOBADA("FORMULAS", "STRING_AGG('''' + CAST(CodiElem AS VARCHAR) + '''', ',')", "CodIConj = " & CI1%, "NOMESS")
                StringCodigosComponentes$ = StringAggFlex$("FORMULAS", "CodIConj = " & CI1%, "CodiElem", ",") 'LA FUNC STRING_AGG NO FUNCIONA EN ENVAPLAST
                
                CONDI$ = " CODINT IN(" & StringCodigosComponentes$ & ""
                Condi1$ = CONDI$
                CONDI$ = CONDI$ + " ) AND FAMILIA = 90"
                MICRONES = VALOBADA("MASTER", "MICRONES", CONDI$, "NOMESS")
                Condi1$ = Condi1$ + " ) AND FAMILIA = 10"
                GRAMAJE = ROUND(XVALO(VALOBADA("MASTER", "GRAMAJE", Condi1$, "NOMESS")), 2)
                
                COEFICIENTE = XVALO("0.00184")
                PESOPLIEGOS = TipPapel * XORTE * GRAMAJE * CANTPLIEGOS
                PESOLAMINA = (TipPapel * XORTE * XVALO(MICRONES) * COEFICIENTE) / 2
