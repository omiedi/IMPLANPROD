    SQLX$ = SQLX$ + " FROM PROD1Y2 WITH(NOLOCK) WHERE IDSUBOR = '" & NROOF$ & "'"
    SQLX$ = SQLX$ + " GROUP BY FECHA,NUMMAQUI ,INDISOLSUP,SOLAPASUP"
    SQLX$ = SQLX$ + " HAVING SUM(CANTOK) > 0   ORDER BY INDISOLSUP,FECHA,NUMMAQUI"
    Set rs = READSET(SQLX$)
    VALORX = 0
    CANIOKK = 0
    IngresoPdiarprod% = 0
    With rs
      INDSOL_ANT% = -1
      Do While Not .EOF
         k& = k& + 1
         INDSOL% = XVALO(!INDISOLSUP)
         VENTABNEW.MSF.Rows = k& + 1
         Call env.HorasMenMaySectorXOfyFecha(NROOF$, XVALO(!INDISOLSUP), CVINT(!FECHA), SAFETEXT$(!NUMMAQUI))     'RUTINA QUE ACTULIZA VARIABLE env.HoraMenor Y env.HoraMayor,env.CantTotParticipantes,CantTotHoras_X_Particip
         Call env.CarVectParticipantes(NROOF$, XVALO(!INDISOLSUP), 0, CVINT(!FECHA), SAFETEXT$(!NUMMAQUI))
         CANTHORASOF = env.CantTotHoras_X_Particip
         CANTPART = env.CantTotParticipantes
         USUARIOX$ = "": ENTRO% = 0
         For R% = 1 To 512
           AB = env.NumParticipante(R%)
           If AB > 0 Then
             ENTRO% = ENTRO% + 1
             If ENTRO% = 1 Then
                USUARIOX$ = USUARIOX$ & SAFETEXT$(R%)
             Else
               USUARIOX$ = USUARIOX$ & "/" & SAFETEXT$(R%)
             End If
           End If
         Next R%
         

         VENTABNEW.MSF.TextMatrix(k&, 1) = SAFETEXT$(!SOLAPASUP)
         VENTABNEW.MSF.TextMatrix(k&, 2) = FECHATEX$(CVINT(!FECHA))
         VENTABNEW.MSF.TextMatrix(k&, 3) = TRIM$(FORMATNUM$(XVALO(CANTHORASOF), "F12.2")) ' CARGAR MAS ABAJO
         VENTABNEW.MSF.TextMatrix(k&, 4) = SAFETEXT$(!NUMMAQUI)
         VENTABNEW.MSF.TextMatrix(k&, 5) = USUARIOX$
         XANTI = XVALO(!CANTI)
         If XORTE > 0 Then  'EN EL CASO QUE SEA IMPRESION O GOFRADORA SE CALCULA LA CANTIDAD DE UNIDADES SEGUN EL CORTE
           If INDSOL% = 0 Or INDSOL% = 2 Then
            XANTI = XVALO(!CANTI) / XORTE
           End If
         End If
         VENTABNEW.MSF.TextMatrix(k&, 6) = FORMATNUM$(XANTI, "F10.1")
         SICHECK = CantRegistros&("CHECKPROCESO", "IDSUBOR = '" & NROOF$ & "' And INDISOLSUP = " & INDSOL%)
         If SICHECK > 0 Then
              CONTROLX$ = "OK"
           Else
              CONTROLX$ = "X"
         End If
         VENTABNEW.MSF.TextMatrix(k&, 11) = CONTROLX$ 'ACA CONTROL

         If INDSOL% <> INDSOL_ANT% Then
           SQLX$ = " SELECT C.CODIGO,C.DESCRIPCION,C.RAZONSOCIAL,C.LOTE,C.IDSUBOR,C.INDISOLSUP"
           SQLX$ = SQLX$ + "  FROM (SELECT CODIGO,DESCRIPCION,RAZONSOCIAL,LOTE,IDSUBOR ,INDISOLSUP  FROM CONSUMO1 WITH(NOLOCK)"
           SQLX$ = SQLX$ + "  UNION ALL SELECT CODIGO,DESCRIPCION,RAZONSOCIAL,BOBINALOTE,IDSUBOR,INDISOLSUP   FROM CONSUMO2 WITH(NOLOCK)"
           SQLX$ = SQLX$ + "  UNION ALL SELECT CODIGO,DESCRIPCION,RAZONSOCIAL,BOBINALOTE,IDSUBOR,INDISOLSUP FROM CONSUMO3)  AS C"
           SQLX$ = SQLX$ + "   WHERE C.IDSUBOR = '" & NROOF$ & "' AND C.INDISOLSUP = " & XVALO(!INDISOLSUP)
           
           Set RS2 = READSET(SQLX$)
           With RS2
             VUELTA% = 0
             Do While Not .EOF
                   k& = k& + 1
                   VUELTA% = VUELTA% + 1
                   VENTABNEW.MSF.Rows = k&
                   VENTABNEW.MSF.TextMatrix(k& - 1, 7) = SAFETEXT$(!Codigo)
                   VENTABNEW.MSF.TextMatrix(k& - 1, 8) = SAFETEXT$(!Descripcion)
                   VENTABNEW.MSF.TextMatrix(k& - 1, 9) = SAFETEXT$(!razonSocial)
                   VENTABNEW.MSF.TextMatrix(k& - 1, 10) = SAFETEXT$(!LOTE)
               .MoveNext
             Loop
           End With
         End If
         INDSOL_ANT% = XVALO(!INDISOLSUP)
         .MoveNext
         'CON ESTO CADA VEZ QUE CAMBIA EL TIPO DE OPERACION AGREGA UNA FILA PUNTEADA
         INDSOL% = XVALO(!INDISOLSUP)
         If INDSOL% <> INDSOL_ANT% Then
           k& = k& + 1
           
           VENTABNEW.MSF.Rows = k& + 1
           Call Linea_Caracteres(Campos$, VENTABNEW.MSF, k&, "-")
         End If
'
      Loop

     End With
    rs.Close
    Set rs = Nothing
    '
    'VENTABNEW.Show 1
    Call CARGA_TABLA_IMPRE(VENTABNEW.MSF, Campos$, "LISTRAZA", "LISTADO DE TRAZABILIDAD", "TABLA_IMPRE", , 1)
    '*****************************************************'
