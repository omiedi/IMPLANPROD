Private Sub TXTOT_Change()
    If TRIM$(TXTOT) = "" Then Exit Sub
    Call LIMPIARPROD(GLOBALFRM_SOLASUP%, GLOBALFRM_SOLAINF%)
    '
    On Error Resume Next
    Me.TXTFECHA(GLOBALFRM_SOLASUP%) = FECHATEX$(HOYSERVER%)
    Me.TXTFECHA2(GLOBALFRM_SOLASUP%) = FECHATEX$(HOYSERVER%)
    On Error GoTo 0
    
    If GLOBALFRM_SOLAINF% = 1 Then
        NORFA$ = TRIM$(TXTOT)
        CONDI$ = " IDSUBOR = '" & NORFA$ & "' AND INDISOLINF = " & GLOBALFRM_SOLAINF% & " And INDISOLSUP = " & GLOBALFRM_SOLASUP%
        TXTTOTALDESC(GLOBALFRM_SOLASUP%) = FORMATNUM$(XVALO(VALOBADA("DESCARCONS", "SUM(CANT_DESC)", CONDI$ & " AND MARBORRA = 0", "NOMESS")), "F12.2")
    End If
    
    If GLOBALFRM_SOLAINF% = 1 Then
       Call MOSTRAR_SOLAPA2
    End If
    If GLOBALFRM_SOLAINF% = 2 Then
       Call MOSTRAR_SOLAPA3
    End If
    If GLOBALFRM_SOLAINF% = 3 Then
       Call MOSTRAR_SOLAPA4
    End If

    'ESTA SELECT VA A ENTRAR SI ES LA SOLAPA 0
    Select Case GLOBALFRM_SOLASUP%
       Case 4, 5, 9
            If GLOBALFRM_SOLAINF% = 0 Then Call MUESTRA_PARTEDIARIO_CODMAQ
            Exit Sub
       Case 6, 7
            If GLOBALFRM_SOLAINF% = 0 Then Call MUESTRA_PARTEDIARIO_ID
            Exit Sub
       Case 11
            If GLOBALFRM_SOLAINF% = 0 Then Call MUESTRA_PARTEDIARIO_EMBALAJE
            Exit Sub
       Case Else
          If GLOBALFRM_SOLAINF% = 0 Then
            CONDI$ = "IDSUBOR = '" & TXTOT & "'"
            CONDI$ = CONDI$ + " AND INDISOLSUP = " & GLOBALFRM_SOLASUP%
            CONDI$ = CONDI$ + " AND INDISOLINF = " & GLOBALFRM_SOLAINF%
            CONDI$ = CONDI$ + " AND MARBORRA < 1"
            
            Dim MSF As msFlexGrid
            Set MSF = MSF2(GLOBALFRM_SOLASUP%)
            MSF.Rows = 1
            If MSF.Rows < 2 Then MSF.Rows = 2
            '
            SQLX$ = "SELECT * FROM PDIARPROD1 WITH(NOLOCK)"
            SQLX$ = SQLX$ + " WHERE " & CONDI$
            SQLX$ = SQLX$ + " ORDER BY FECHA,H_DESDE_FN,PDIARPROD1_ID  "
            Set rs = READSET(SQLX$)
            With rs
              Do While Not .EOF
                REG& = REG& + 1
                MSF.Rows = REG& + 1
                MSF.TextMatrix(REG&, 1) = FECHATEX$(CVINT(SAFETEXT$(!FECHA)))
                MSF.TextMatrix(REG&, 2) = SAFETEXT$(!MEDIDAS)
                MSF.TextMatrix(REG&, 3) = FORMATNUM$(XVALO(!COD_P_DIAR), "F10")
                MSF.TextMatrix(REG&, 4) = SAFETEXT$(!DESC_P_DIAR)
                MSF.TextMatrix(REG&, 5) = SAFETEXT$(!H_DESDE)
                MSF.TextMatrix(REG&, 6) = SAFETEXT$(!H_HASTA)
                MSF.TextMatrix(REG&, 7) = XVALO(!NROBOBINA)
                MSF.TextMatrix(REG&, 8) = XVALO(!CANTOK)
'                MSF.TextMatrix(REG&, 9) = XVALO(!COD_DESCAR)
'                MSF.TextMatrix(REG&, 10) = SAFETEXT$(!DESCR_DESCAR)
'                MSF.TextMatrix(REG&, 11) = XVALO(!KG_DESCAR)
                MSF.TextMatrix(REG&, 9) = SAFETEXT$(!Observaciones)
                MSF.TextMatrix(REG&, 10) = XVALO(!PDIARPROD1_ID)
                
                'TXTFECHA(GLOBALFRM_SOLASUP%) = FECHATEX$(CVINT(!FECHA))
                Me.TXTULTGRAB(GLOBALFRM_SOLASUP%) = !FECHAYHORA
                TXTNUMAYUDANTE1(GLOBALFRM_SOLASUP%) = XVALO(!NUMAYUD1)
                TXTAYUDANTE1(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEAYUD1)
                TXTNUMAYUDANTE2(GLOBALFRM_SOLASUP%) = XVALO(!NUMAYUD2)
                TXTAYUDANTE2(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEAYUD2)
                TXTNUMAYUDANTE3(GLOBALFRM_SOLASUP%) = XVALO(!NUMAYUD3)
                TXTAYUDANTE3(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEAYUD3)
                TXTNUMAYUDANTE4(GLOBALFRM_SOLASUP%) = XVALO(!NUMAYUD4)
                TXTAYUDANTE4(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEAYUD4)
                If GLOBALFRM_SOLASUP% = 11 Then
                    TXTAYUDANTE5(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEAYUD5)
                    TXTNUMAYUDANTE5(GLOBALFRM_SOLASUP%) = XVALO(!NUMAYUD5)
                    TXTAYUDANTE6(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEAYUD6)
                    TXTNUMAYUDANTE6(GLOBALFRM_SOLASUP%) = XVALO(!NUMAYUD6)
                    TXTAYUDANTE7(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEAYUD7)
                    TXTNUMAYUDANTE7(GLOBALFRM_SOLASUP%) = XVALO(!NUMAYUD7)
                    TXTAYUDANTE8(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEAYUD8)
                    TXTNUMAYUDANTE8(GLOBALFRM_SOLASUP%) = XVALO(!NUMAYUD8)
                Else
                    TXTIDMAQ(GLOBALFRM_SOLASUP%) = SAFETEXT(!NUMMAQUI)
                    TXTMAQUINA(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAME_MAQUI)
                    TXTMAQUINISTA(GLOBALFRM_SOLASUP%) = SAFETEXT$(!NAMEUSUMAQ)
                    TXTIDMAQUINISTA(GLOBALFRM_SOLASUP%) = XVALO(!NUMUSUMAQ)
                    XXX = TXTIDMAQUINISTA(GLOBALFRM_SOLASUP%)
                End If
               .MoveNext
              Loop
            End With
        
            rs.Close
            Set rs = Nothing
'            Select Case GLOBALFRM_SOLASUP%
'            Case 0, 1, 2, 3, 8, 10
            Me.TXTTOTBOBINAS2(GLOBALFRM_SOLASUP%) = ValorMaximoColumna(MSF2(GLOBALFRM_SOLASUP%), 7) 'MSF2(Index).TextMatrix(MSF2(Index).Rows - 1, 7) 'PONE EL VALOR DE LA ULTIMA FILA DE LA COLUMNA 7
            If GLOBALFRM_SOLASUP% = 11 Then Me.TXTTOTBOBINAS2(GLOBALFRM_SOLASUP%) = ValorMaximoColumna(MSF2(GLOBALFRM_SOLASUP%), 9) 'MSF2(Index).TextMatrix(MSF2(Index).Rows - 1, 9) 'embalaje PONE EL VALOR DE LA ULTIMA FILA DE LA COLUMNA 7

'            Me.TXTTOTBOBINAS2(GLOBALFRM_SOLASUP%) = MSF2(GLOBALFRM_SOLASUP%).TextMatrix(MSF2(GLOBALFRM_SOLASUP%).Rows - 1, 7) 'PONE EL VALOR DE LA ULTIMA FILA DE LA COLUMNA 7
            Me.TXTTOTCANTI2(GLOBALFRM_SOLASUP%) = FORMATNUM$(XVALO(SUMA_COLUMNA_SELECCION(MSF2(GLOBALFRM_SOLASUP%), 8)), "F12.2")
            'Me.TXTTOTALDESC2(Index) = FORMATNUM$(XVALO(SUMA_COLUMNA_SELECCION(MSF2(Index), 11)), "F12.2")
            'Call ACTUALIZAR_HORAS2(GLOBALFRM_SOLASUP%)
            Me.TXTTOTALHORAS(GLOBALFRM_SOLASUP%) = FORMATNUM$(TOTALHORASDELCALRADAS(Me.TXTOT, GLOBALFRM_SOLASUP%), "F12.2")

          End If
'            Case Else
'
'            End Select
            End Select

End Sub
Sub MUESTRA_PARTEDIARIO_EMBALAJE()
            
            CONDI$ = "IDSUBOR = '" & TXTOT & "'"
            CONDI$ = CONDI$ + " AND INDISOLSUP = " & GLOBALFRM_SOLASUP%
            CONDI$ = CONDI$ + " AND INDISOLINF = " & GLOBALFRM_SOLAINF%
            CONDI$ = CONDI$ + " AND MARBORRA < 1"
            
            Dim MSF As msFlexGrid
            Set MSF = MSF2(GLOBALFRM_SOLASUP%)
            MSF.Rows = 1
            If MSF.Rows < 2 Then MSF.Rows = 2
            '
            SQLX$ = "SELECT * FROM PDIARPROD1 WITH(NOLOCK)"
            SQLX$ = SQLX$ + " WHERE " & CONDI$
            SQLX$ = SQLX$ + " ORDER BY PDIARPROD1_ID  "
            Set rs = READSET(SQLX$)
            With rs
              Do While Not .EOF
                REG& = REG& + 1
                MSF.Rows = REG& + 1
                'CODIGO, REFERENCIA,DESDE,HASTA,BOLSAS X BTO,BULTOS,BOLSAS,PALLET CAJA,TIPO,OBSERVACIONES, ID
                MSF.TextMatrix(REG&, 1) = FECHATEX$(CVINT(SAFETEXT$(!FECHA)))
                'MSF.TextMatrix(REG&, 2) = SAFETEXT$(!MEDIDAS)
                MSF.TextMatrix(REG&, 2) = FORMATNUM$(XVALO(!COD_P_DIAR), "F10")
                MSF.TextMatrix(REG&, 3) = SAFETEXT$(!DESC_P_DIAR)
                MSF.TextMatrix(REG&, 4) = SAFETEXT$(!H_DESDE)
                MSF.TextMatrix(REG&, 5) = SAFETEXT$(!H_HASTA)
                MSF.TextMatrix(REG&, 6) = XVALO(!BOLSASXBTO)
                MSF.TextMatrix(REG&, 7) = XVALO(!CANBULTOS)
                MSF.TextMatrix(REG&, 8) = XVALO(!BOLSASXBTO) * XVALO(!CANBULTOS) 'EQUIVALE A CANT_OK
                MSF.TextMatrix(REG&, 9) = XVALO(!NROBOBINA)
