                GRILLAGRAL.GRID.TextMatrix(J&, 8) = FORMATNUM$(XVALO(PESOTOTAL), "F12.2")
                GRILLAGRAL.GRID.TextMatrix(J&, 9) = FORMATNUM$(XVALO(Scrap), "F8.2")
                GRILLAGRAL.GRID.TextMatrix(J&, 10) = FORMATNUM$(XVALO(PORCENTAJE), "F8.2")
                GRILLAGRAL.GRID.TextMatrix(J&, 11) = FORMATNUM$(XVALO(TipPapel), "F10.2")
                GRILLAGRAL.GRID.TextMatrix(J&, 12) = FORMATNUM$(XVALO(XORTE), "F10.2")
                GRILLAGRAL.GRID.TextMatrix(J&, 13) = FORMATNUM$(XVALO(GRAMAJE), "F10.2")
                GRILLAGRAL.GRID.TextMatrix(J&, 14) = CANTPLIEGOS
                GRILLAGRAL.GRID.TextMatrix(J&, 15) = MICRONES
                GRILLAGRAL.GRID.TextMatrix(J&, 16) = COEFICIENTE
                
            .MoveNext
            
          Loop
    End With
    Screen.MousePointer = 1
        RS0.Close
