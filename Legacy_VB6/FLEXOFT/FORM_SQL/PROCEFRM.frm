            FRMZELECHO.MSF2.TextMatrix(J&, 1) = L&
            FRMZELECHO.MSF2.TextMatrix(J&, 2) = FECHATEX$(FE%)
            FRMZELECHO.MSF2.TextMatrix(J&, 3) = NUSER%
            FRMZELECHO.MSF2.TextMatrix(J&, 4) = NOMBREUSRSQL$
            FRMZELECHO.MSF2.TextMatrix(J&, 5) = NORFAPARAM$
            FRMZELECHO.MSF2.TextMatrix(J&, 6) = DESCRISOLAP$
            FRMZELECHO.MSF2.TextMatrix(J&, 7) = d
            FRMZELECHO.MSF2.TextMatrix(J&, 8) = h
            Call COLOREAR_GRILLA_SOLAFILA(FRMZELECHO.MSF2, COLOR, J&)
        End If
        L& = L& + 1
        J& = FRMZELECHO.MSF2.Rows
        FRMZELECHO.MSF2.Rows = J& + 1
        FRMZELECHO.MSF2.TextMatrix(J&, 1) = L&
        FRMZELECHO.MSF2.TextMatrix(J&, 2) = FECHATEX$(FE%)
        FRMZELECHO.MSF2.TextMatrix(J&, 3) = NUSER%
        FRMZELECHO.MSF2.TextMatrix(J&, 4) = NOMBREUSRSQL$
        FRMZELECHO.MSF2.TextMatrix(J&, 5) = NORFA$
        FRMZELECHO.MSF2.TextMatrix(J&, 6) = DESCRISOLAPA$
        FRMZELECHO.MSF2.TextMatrix(J&, 7) = DL
        FRMZELECHO.MSF2.TextMatrix(J&, 8) = HL
        Call COLOREAR_GRILLA_SOLAFILA(FRMZELECHO.MSF2, COLOR, J&, , 1)
Return

         
80
End Sub

Sub CARGA_SELECHO_CONTROL_SOLOPAMIENTO(NUSER%, FE%, DESDX%, HASTX%, MODO$, ID&, GRUPOSOLAP%, NORFAPARAM$, DESCRISOLAP$)
    L& = 0
    
    'ESTA FUNCION RECORRE LAS DOS TABLAS DONDE SE DECLARAN LAS  HORAS TRABAJADAS Y CHEQUE QUE
    'QUE UN MISMO DIA NO SE DECLAREN PARA EL MISMO OPERARIO HORAS QUE SE ENCIMEN CON OTRAS DECLARADAS POR EL MISMO OPERARIO
    'ESTO ES PARA VALIDAR DE QUE TABLA VIENE LA SOLICITUD DE COMPARACION, PARA QUE AL COMPARAR SI ES EL REGISTRO
    'PASADO COMO PARAMETRO NO PRESENTE SOLAPAMIENTO SI ESTA LEYENDO EL MISMO PERO SI ES EL MISMO ID DE LA OTRA TABLA LO CARGUE EN EL SELECHO
    NOMBREUSRSQL$ = NAMEUSERSQL$(NUSER%)
    Static COLOR
    Select Case GRUPOSOLAP%
        Case 0, 1, 2, 3, 8, 10, 11: GRUPOSOLAP% = 1
        Case 4, 5, 6, 7, 9: GRUPOSOLAP% = 2
    End Select
