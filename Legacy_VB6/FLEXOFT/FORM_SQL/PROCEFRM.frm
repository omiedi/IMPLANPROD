Private Sub TXTTOTALDESC_DblClick(Index As Integer)

        If TRIM$(Me.TXTOT) = "" Then
          Call COMUNI("No Hay Una Orden de Fabricación Seleccionada")
          Exit Sub
        End If

        NORFA$ = TRIM$(TXTOT)
        INDISOLSUP% = GLOBALFRM_SOLASUP%
        INDISOLINF% = GLOBALFRM_SOLAINF%
        DESCRISOLA2$ = SSTab2(INDISOLSUP%).Caption
        DESCRISOLA1$ = SSTab1.Caption
        '
        VENTANA.Inicializar = 0
        VENTANA.CampEditables = "1;2;4;6;7"
        VENTANA.TOTALES(6) = "S"
        VENTANA.AgregaRegistro = 1
        VENTANA.UtilizaFormula = 1
        VENTANA.HabilitaBorrar = 1
        VENTANA.HabilitaInsertar = 1
        VENTANA.NoMostrarBotonTilde = 0
        VENTANA.ColEcoCampo(4) = "CAMPO1;CAMPO2;DATASQL;LISTA = 'DESCCODI'"
        VENTANA.ColEcoCampo(2) = "CAMPO1;CAMPO2;DATASQL;LISTA = 'CODIMAQ'"
        VENTANA.TITULO = ""
        VENTANA.Inicializar = 1
        VENTANA.Campox = "FECHA/D8;COD.MAQ./A8;REFERECIA/A32;CODIGO/F12;DESCRIPCION/A32;CANT.DESCARTE/F14.2;OBSERVACIONES/A48"
        
        Dim obj As New RECORXET
        Set rs1 = obj.RS_CARGADODESC(NORFA$, GLOBALFRM_SOLAINF%, GLOBALFRM_SOLASUP%)
        Call Carga_MSF_Recordset(rs1, "FECHA/D12;COD.MAQ./A8;REFERECIA/A32;CODIGO/F12;DESCRIPCION/A32;CANT.DESCARTE/F14.2;OBSERVACIONES/A48", VENTABNEW.MSF)
        Set obj = Nothing
        rs1.Close
        Set rs1 = Nothing
        
15      VENTABNEW.Show 1
        Set VENTANA = Nothing
        If VENTABNEW.APROBADO% < 1 Then Exit Sub
        Dim MSF As msFlexGrid
        Set MSF = VENTABNEW.MSF
        
        For REG& = 1 To MSF.Rows - 1
                VALIDAFECHA% = FECHANUM(MSF.TextMatrix(REG&, 1))
                If VALIDAFECHA% < 1 Then
                  Call COMUNI("Atención!!!\Fecha en Fila: " & REG& & " No Válida")
                  GoTo 15
                End If
        Next REG&
        
        CONDI$ = " IDSUBOR = '" & NORFA$ & "' AND INDISOLINF = " & INDISOLINF% & " And INDISOLSUP = " & INDISOLSUP%
        Call ACTUREGISTRO("DESCARCONS", "MARBORRA", CONDI$, 1, REGAF&, "NOMESS")
        
        SQLX$ = "SELECT * FROM DESCARCONS WHERE DESCARCONS_ID < 1"
        Dim rs As ADODB.Recordset
        Set rs = New ADODB.Recordset
25      On Error Resume Next
        rs.Open FILTSQL$(SQLX$), FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText
        If Err Then
        On Error GoTo 0
        Call CapturaErrorOpen
        GoTo 25
        End If
        With rs
            For REG& = 1 To MSF.Rows - 1
                .AddNew
                
                !FECHA = FETEXCOR$(FECHANUM(MSF.TextMatrix(REG&, 1)))
                !NUMMAQUI = MSF.TextMatrix(REG&, 2)
                !NAME_MAQUI = MSF.TextMatrix(REG&, 3)
                !CODIDESC = XVALO(MSF.TextMatrix(REG&, 4))
                !DESCRIDESC = MSF.TextMatrix(REG&, 5)
                !CANT_DESC = XVALO(MSF.TextMatrix(REG&, 6))
                !Observaciones = Left(MSF.TextMatrix(REG&, 7), 512)
                !idsubor = NORFA$
                !INDISOLSUP = INDISOLSUP%
                !INDISOLINF = INDISOLINF%
                If VUELTA% < 1 Then
                  VUELTA% = 1
                  !FECHAYHORA = NOWSERVER
                  Me.TXTULTGRABCONS(INDISOLSUP%) = SAFETEXT$(!FECHAYHORA)
                Else
                  !FECHAYHORA = Me.TXTULTGRABCONS(INDISOLSUP%)
                End If
                On Error Resume Next
                !CODIEMPR = CodiEmp%
                On Error GoTo 0
                !NROCLIE = XVALO(Me.TXTNUMCLIE)
                !NROPED = XVALO(Me.TXTNROPEDIDO)
                !NUSERLOG = User%
                !NUSERGRAB = User% ' ACA SE DEBERIA GRABAR EL USUARIO QUE SE REGISTRE AL GRABAR
                !MARBORRA = 0
               .Update
            Next REG&
        End With
        
        rs.Close
        Set rs = Nothing
        '
        TXTTOTALDESC(Index) = FORMATNUM$(XVALO(VALOBADA("DESCARCONS", "SUM(CANT_DESC)", CONDI$ & " AND MARBORRA = 0", "NOMESS")), "F12.2")
        '
        CONDI$ = CONDI$ + " AND  MARBORRA = 1  "
        Call BORRAREGISTROS("DESCARCONS", CONDI$, REGAF&, "NOMESS")
        
End Sub
        
        
