Sub MOSTRAR_DETALLEDEHORAS(NORFA$, INDISOLSUPX%)
        Campos$ = "Fecha/D8;Tarea/A32;Operario/A32;Desde/A12;Hasta/A12;Horas/F7.2"
        Call CARGA_ENCABEZADO(FRMZELECHO.MSF2, Campos$, FRMZELECHO)
        Call CARGA_ENCABEZADO(FRMZELECHO.MSF1, Campos$, FRMZELECHO)
        FRMZELECHO.Caption = "Detalle de Horas Declaradas"
        J& = 0
        SQLX$ = "SELECT  P.H_DESDE,P.H_HASTA,P.NUMAYUD1,P.NUMAYUD2,P.NUMAYUD3,P.NUMAYUD4,P.NUMAYUD5,P.NUMAYUD6,P.NUMAYUD7,P.NUMAYUD8 "
        SQLX$ = SQLX$ + " ,P.FECHA,P.IDSUBOR,P.NULIDOP1,P.NULIDOP2,P.SOLAPASUP,P.PDIARPROD1_ID,P.INDISOLSUP,P.NUMUSUMAQ,P.H_TRABAJADAS "
        SQLX$ = SQLX$ + " ,P.NAMEUSUMAQ,P.NAMEAYUD1,P.NAMEAYUD2,P.NAMEAYUD3,P.NAMEAYUD4 "
        SQLX$ = SQLX$ + " ,P.NAMEAYUD5,P.NAMEAYUD6,P.NAMEAYUD7,P.NAMEAYUD8,P.NULNAMEOP1,P.NULNAMEOP2,P.DESC_P_DIAR"
        SQLX$ = SQLX$ + " FROM (SELECT H_DESDE,H_HASTA,NUMAYUD1,NUMAYUD2 , NUMAYUD3, NUMAYUD4, NUMAYUD5"
        SQLX$ = SQLX$ + " , NUMAYUD6, NUMAYUD7, NUMAYUD8, FECHA, IDSUBOR, NULIDOP1, NULIDOP2 "
        SQLX$ = SQLX$ + " ,SOLAPASUP, INDISOLSUP,PDIARPROD1_ID,NUMUSUMAQ,H_TRABAJADAS,NAMEUSUMAQ,NAMEAYUD1,NAMEAYUD2, "
        SQLX$ = SQLX$ + " NAMEAYUD3,NAMEAYUD4,NAMEAYUD5,NAMEAYUD6,NAMEAYUD7,NAMEAYUD8,NULNAMEOP1,NULNAMEOP2,DESC_P_DIAR "
        SQLX$ = SQLX$ + " FROM PDIARPROD1 "
        
        SQLX$ = SQLX$ + " union all "
        
        SQLX$ = SQLX$ + " SELECT H_DESDE,H_HASTA,NULNUMAYUD1,NULNUMAYUD2,NULNUMAYUD3,NULNUMAYUD4,NULNUMAYUD5,NULNUMAYUD6"
        SQLX$ = SQLX$ + " ,NULNUMAYUD7,NULNUMAYUD8,FECHA,IDSUBOR,IDOP1,IDOP2,SOLAPASUP"
        SQLX$ = SQLX$ + " ,INDISOLSUP,PDIARPROD2_ID,NULNUMUSUMAQ,H_TRABAJADAS,NULNAMEUSUMAQ,NULNAMEAYUD1"
        SQLX$ = SQLX$ + " ,NULNAMEAYUD2,NULNAMEAYUD3,NULNAMEAYUD4,NULNAMEAYUD5,NULNAMEAYUD6,NULNAMEAYUD7,NULNAMEAYUD8"
        SQLX$ = SQLX$ + " ,NAMEOP1 , NAMEOP2,DESCRIPTAREA"
        SQLX$ = SQLX$ + " FROM PDIARPROD2)"
        SQLX$ = SQLX$ + " AS P  "
        SQLX$ = SQLX$ + " WHERE  P.IDSUBOR = '" & NORFA$ & "' AND  P.INDISOLSUP = " & INDISOLSUPX%
        SQLX$ = SQLX$ + " ORDER BY P.FECHA,P.DESC_P_DIAR"
        Set rs = READSET(SQLX$, , 1)
        With rs
          Do While Not .EOF
              CANTIOPX% = 0
              AY1% = XVALO(!NUMAYUD1): If AY1% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY2% = XVALO(!NUMAYUD2): If AY2% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY3% = XVALO(!NUMAYUD3): If AY3% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY4% = XVALO(!NUMAYUD4): If AY4% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY5% = XVALO(!NUMAYUD5): If AY5% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY6% = XVALO(!NUMAYUD6): If AY6% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY7% = XVALO(!NUMAYUD7): If AY7% > 0 Then CANTIOPX% = CANTIOPX% + 1
              AY8% = XVALO(!NUMAYUD8): If AY8% > 0 Then CANTIOPX% = CANTIOPX% + 1
              IDO1% = XVALO(!NULIDOP1): If IDO1% > 0 Then CANTIOPX% = CANTIOPX% + 1
              IDO2% = XVALO(!NULIDOP2): If IDO2% > 0 Then CANTIOPX% = CANTIOPX% + 1
              MAQX% = XVALO(!NUMUSUMAQ): If MAQX% > 0 Then CANTIOPX% = CANTIOPX% + 1 ' SE INCLUYE AL MAQUINISTA
              HORAX = XVALO(!H_TRABAJADAS)
              If AY1% > 0 Then NAMEUSU$ = SAFETEXT$(!NAMEAYUD1): GoSub CARGOZELECHO
              If AY2% > 0 Then NAMEUSU$ = SAFETEXT$(!NAMEAYUD2): GoSub CARGOZELECHO
              If AY3% > 0 Then NAMEUSU$ = SAFETEXT$(!NAMEAYUD3): GoSub CARGOZELECHO
              If AY4% > 0 Then NAMEUSU$ = SAFETEXT$(!NAMEAYUD4): GoSub CARGOZELECHO
