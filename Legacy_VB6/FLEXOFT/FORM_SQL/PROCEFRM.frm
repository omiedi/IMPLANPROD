            GRILLAGRAL.GRID.TextMatrix(J&, 4) = SAFETEXT$(!CAMPOTEXT3)
            GRILLAGRAL.GRID.TextMatrix(J&, 5) = XVALO(!CAMPONUM8)
            
            GRILLAGRAL.GRID.TextMatrix(J&, 6) = XVALO(!CAMPONUM3)
            GRILLAGRAL.GRID.TextMatrix(J&, 7) = XVALO(!CAMPONUM4) '
            GRILLAGRAL.GRID.TextMatrix(J&, 8) = SAFETEXT$(!CAMPOTEXT4)
            GRILLAGRAL.GRID.TextMatrix(J&, 9) = FORMATNUM$(XVALO(!CAMPONUM5), "F10.1")
            GRILLAGRAL.GRID.TextMatrix(J&, 10) = FORMATNUM$(XVALO(!CAMPONUM6), "F10.1")
            GRILLAGRAL.GRID.TextMatrix(J&, 11) = FORMATNUM$(XVALO(!CAMPONUM7), "F10.1")
            .MoveNext
          Loop
        End With
        
