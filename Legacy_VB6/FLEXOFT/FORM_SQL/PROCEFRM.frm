   If CLACONTRA% < 1 Then Exit Sub
   Screen.MousePointer = 11
   SQLX$ = " select IDSUBOR,Cod_Inte,CanProy from ordefabr WITH(NOLOCK) where statuorf < 3 and numeorfa >= 839 and canapro <= 0   "
   Set rs = READSET(SQLX$)
   With rs
      Do While Not .EOF
         NORFA$ = SAFETEXT$(!idsubor)
         CI_ORFA = XVALO(!cod_inte)
         CANTI_ORFA = XVALO(!CANPROY)
         SQLX$ = " select sum(cantres) as cantres , idsubor,cod_inte,cod_exte,usounit  "
