'            MSF12(Index).TextMatrix(i&, 10) = TRIM$(FORMATNUM$(XVALO(strArray(1)), "F16.4"))
'            MSF12(Index).TextMatrix(i&, 11) = TRIM$(strArray(2))
                CONDI$ = "INDISOLSUP = 1 And INDISOLINF = 1 And (MARBORRA < 1 Or MARBORRA Is Null)"
                TipPapel = XVALO(VALOBADA("CONSUMO2", "MAX(ANCHO)", CONDI$ & " AND IDSUBOR = '" & SAFETEXT$(!idsubor) & "'", "NOMESS"))
                XORTE = XVALO(CorteEnvap(CI1%))
