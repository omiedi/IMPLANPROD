Sub ACTUALIZAHORASPRODUCCIÓN(Index, NORFA$)
   SQLX$ = "select idsubor,NAMEOP1 ,NAMEOP2,IDOP1 ,IDOP2 ,sum(H_TRABAJADAS) AS HTRAB,DESCRIPTAREA,SUM(CANTIDAD)AS CANTI  "
   SQLX$ = SQLX$ + " from PDIARPROD2 WITH(NOLOCK)"
   SQLX$ = SQLX$ + " where IDSUBOR = '" & NORFA$ & "'  and INDISOLSUP = " & Index
   SQLX$ = SQLX$ + " group by IDOP1,IDOP2,NAMEOP1 ,NAMEOP2,IDSUBOR,DESCRIPTAREA"
   Set rs = READSET(SQLX$)
   i& = 0
   MSF8(Index).Rows = 5
   With rs
     Do While Not .EOF
        i& = i& + 1
        MSF8(Index).Cols = i& + 2
        MSF8(Index).ColWidth(i& + 1) = MSF8(Index).ColWidth(i&)
        CANTIOP% = 0
        ID1% = XVALO(!IDOP1): If ID1% > 0 Then CANTIOP% = CANTIOP% + 1
        ID2% = XVALO(!IDOP2): If ID2% > 0 Then CANTIOP% = CANTIOP% + 1
        
        USU1$ = SAFETEXT$(!NAMEOP1)
        USU2$ = SAFETEXT$(!NAMEOP2)
        TAREAX$ = SAFETEXT$(!DESCRIPTAREA)
        CANTI = XVALO(!CANTI)
        HTRAB = CANTIOP% * XVALO(!HTRAB) 'CANTIDAD DE OPERARIOS POR LA CANTIDAD DE HORAS DECLARADAS
        MSF8(Index).TextMatrix(0, i& + 1) = AJUSTD(USU1$ & " y " & USU2$, 30)
        MSF8(Index).TextMatrix(1, i& + 1) = AJUSTD(TRIM$(FORMATNUM$(HTRAB, "F12.2")), 30)
        MSF8(Index).TextMatrix(2, i& + 1) = AJUSTD(TAREAX$, 30)
        MSF8(Index).TextMatrix(3, i& + 1) = AJUSTD(TRIM$(FORMATNUM$(CANTI, "f12.2")), 30)
       .MoveNext
     Loop
   End With
   Exit Sub
   
   
   
    MSF7(Index).col = 1
    MSF7(Index).Sort = 1
    MSF8(Index).Cols = 2
    Select Case TRIM$(SSTab1.Caption)
       Case "SELLADO", "COSTURA", "COSTURA DE POLI- PROPILENO"
        For i& = 1 To MSF7(Index).Rows - 1
          MSF8(Index).Cols = i& + 2
          MSF8(Index).ColWidth(i& + 1) = MSF8(Index).ColWidth(i&)
          USU1$ = MSF7(Index).TextMatrix(i&, 5)
          USU2$ = MSF7(Index).TextMatrix(i&, 7)
          TAREAX$ = MSF7(Index).TextMatrix(i&, 9)
          CANTI = XVALO(MSF7(Index).TextMatrix(i&, 11))
          XOEF = XVALO(MSF7(Index).TextMatrix(i&, 9))
          Des = MSF7(Index).TextMatrix(i&, 12)
          Has = MSF7(Index).TextMatrix(i&, 13)
          
          MSF8(Index).TextMatrix(1, i& + 1) = AJUSTD(TRIM$(Des & " a " & Has), 30)
          MSF8(Index).TextMatrix(0, i& + 1) = AJUSTD(USU1$ & " y " & USU2$, 30)
          MSF8(Index).TextMatrix(2, i& + 1) = AJUSTD(TAREAX$, 30)
          MSF8(Index).TextMatrix(3, i& + 1) = FORMATNUM$(CANTI, "f30.1")
         ' MSF8(Index).TextMatrix(4, i& + 1) = FORMATNUM$(XOEF * CANTI, "F30.1")

        Next i&
        MSF7(Index).col = 3
        MSF7(Index).Sort = 3
        'CAMPOS$ = "C.MAQ./A10;DESCRIP.MÁQUINA/A32;ID OP./F8;NOMBRE/A24;ID OP./F8;NOMBRE/A24;DESCRIP.TAREA/A32;COEF./F7.2;CANTIDAD/F12;DESDE H./H12;HASTA H./H12;OBSERVACIONES/A48;ULT/F0"

'           CAMPOS$ = "C.MAQ./A10;DESCRIP.MÁQUINA/A20;MEDIDAS/A20;CÓDIGO/F10;REFERENCIA/A32;H.DESDE/H12;H.HASTA/H12;N° PALLETS/F10;CANT.PROD.OK/F12;CODIGO/f10;REFERENCIA/A32;DESCARTE KG./f14;OBSERVACIONES/A48;ULT/F0"
       Case "COLOCACIÓN DE POLIETILENO", "VALVULA / MANGAS"
        For i& = 1 To MSF7(Index).Rows - 1
          MSF8(Index).Cols = i& + 2
          MSF8(Index).ColWidth(i& + 1) = MSF8(Index).ColWidth(i&)
          USU1$ = MSF7(Index).TextMatrix(i&, 3)
          USU2$ = MSF7(Index).TextMatrix(i&, 5)
          TAREAX$ = MSF7(Index).TextMatrix(i&, 7)
          CANTI = XVALO(MSF7(Index).TextMatrix(i&, 9))
          XOEF = XVALO(MSF7(Index).TextMatrix(i&, 7))
          Des = MSF7(Index).TextMatrix(i&, 10)
          Has = MSF7(Index).TextMatrix(i&, 11)
          MSF8(Index).TextMatrix(1, i& + 1) = AJUSTD(TRIM$(Des & " a " & Has), 30)
          MSF8(Index).TextMatrix(0, i& + 1) = AJUSTD(USU1$ & " y " & USU2$, 30)
          MSF8(Index).TextMatrix(2, i& + 1) = AJUSTD(TAREAX$, 30)
          MSF8(Index).TextMatrix(3, i& + 1) = FORMATNUM$(CANTI, "f30.1")
          'MSF8(Index).TextMatrix(4, i& + 1) = FORMATNUM$(XOEF * CANTI, "F30.1")
