Sub PDiarioSectorYMaquina(INSOLAPASUP%, FE%)
    VectCliente.cargarvector
    
    Call CARGA_ENCABEZADO(FRMZELECHO.MSF2, "Código/a10;Máquina/a64", FRMZELECHO)
    Call CARGA_ENCABEZADO(FRMZELECHO.MSF1, "Código/a10;Máquina/a64", FRMZELECHO)
    FRMZELECHO.Caption = ""
    'VECTOR PARA CALCULAR CUNATOS USUARIOS SON LOS QUE PARTICIPAN
    Dim CANTIPARTICIPANTES%(), CANPARTIXOF%()
    COUX = CantRegistros&("USUARIOSSQL", "NUSER > 0", "NOMESS")
    ReDim Preserve CANTIPARTICIPANTES%(COUX), CANPARTIXOF%(COUX)
    ''''''''''''''''''''''''''''''''''
    
    Dim obj As New RECORXET
    Set rs1 = obj.RS_SELECODIMAQUI(TRIM$(Str$(INSOLAPASUP%)))
    Call Carga_MSF_Recordset(rs1, "Código/a10;Máquina/a64", FRMZELECHO.MSF2)
    Set obj = Nothing
    rs1.Close
    Set rs1 = Nothing
    '*****************************************************'
    FRMZELECHO.Width = 8500
    FRMZELECHO.Show 1
    NRO$ = RESP_ZELE_VECT(1)
    REFE$ = RESP_ZELE_VECT(2)
    If TRIM$(NRO$) = "" Then Exit Sub
    'HASTA AQUI LA SELECCION DE LA FECHA Y LA MAQUINA
    ''''''''''''''-----------------------------
    Unload VENTABNEW
    VENTANA.Inicializar = 0
    VENTANA.UtilizaFormula = 1
    'VENTANA.CampEditables = 3
    VENTANA.ColEcoCampo(3) = "nume_cli;RASO_CLI;DEUDOR12"
    Campos$ = "OF/A12;N°.Ped./F10;Cta/F0;R.Social/A20;Comienzo/H16;Fin/H16;Op.X OF/F8.0;H.Inf.X OF/F12.2;Cant.OK/F12.1;SCRAP/F12.2"
    VENTANA.Campox = Campos$
    VENTANA.DejarLibre(4) = "S"
    VENTANA.Inicializar = 1
    VENTABNEW.MSF.Cols = 12
    VENTABNEW.MSF.Rows = 1
    CANTINORFA% = 0: ACUSCRAPX = 0
    SQLX$ = "SELECT IDSUBOR,NroPed,NroClie, NUMMAQUI, "
    SQLX$ = SQLX$ + " SUM(H_TRABAJADAS) AS HT , SUM(CANTOK) AS CANTI "
    SQLX$ = SQLX$ + "FROM PDIARPROD1 WITH(NOLOCK)"
    SQLX$ = SQLX$ + " WHERE NUMMAQUI  = '" & NRO$ & "' AND FECHA = '" & FETEXCOR1$(FE%) & "' AND (H_TRABAJADAS > 0 OR CANTOK > 0)and MARBORRA < 1 AND INDISOLSUP = " & INSOLAPASUP%
    SQLX$ = SQLX$ + " GROUP BY IDSUBOR,NROPED,NROCLIE,NUMMAQUI"
    SQLX$ = SQLX$ + " ORDER BY IDSUBOR, NROPED"
    Set rs = READSET(SQLX$)
    VALORX = 0
    CANIOKK = 0
    With rs
      Do While Not .EOF

         k& = k& + 1
         VENTABNEW.MSF.Rows = k& + 1
         NORFA$ = SAFETEXT$(!idsubor)
         VENTABNEW.MSF.TextMatrix(k&, 1) = NORFA$
         VENTABNEW.MSF.TextMatrix(k&, 2) = XVALO(!NROPED)
         NC = XVALO(!NROCLIE)
         VENTABNEW.MSF.TextMatrix(k&, 3) = NC
         VENTABNEW.MSF.TextMatrix(k&, 4) = VectCliente.nombre(NC)
         Call env.HorasMenMaySectorXOfyFecha(NORFA$, INSOLAPASUP%, FE%, NRO$)   'RUTINA QUE ACTULIZA VARIABLE env.HoraMenor Y env.HoraMayor,env.CantTotParticipantes,CantTotHoras_X_Particip
         Call env.CarVectParticipantes(NORFA$, INSOLAPASUP%, 0, FE%, NRO$)
          'DOTACION% = DOTACION% + env.CantTotParticipantes
          CANTHORASOF = env.CantTotHoras_X_Particip
         VENTABNEW.MSF.TextMatrix(k&, 5) = HORATEX(env.HoraMenor)
         VENTABNEW.MSF.TextMatrix(k&, 6) = HORATEX(env.HoraMayor)
         VENTABNEW.MSF.TextMatrix(k&, 7) = env.CantTotParticipantes
         VENTABNEW.MSF.TextMatrix(k&, 8) = FORMATNUM$(XVALO(CANTHORASOF), "F12.2")
'         HORTRABAJ = HORTRABAJ + XVALO(!HT)
         VENTABNEW.MSF.TextMatrix(k&, 9) = XVALO(!CANTI)
         VENTABNEW.MSF.TextMatrix(k&, 10) = ""
         CANIOKK = CANIOKK + XVALO(!CANTI)
         HORASXOF = HORASXOF + XVALO(VENTABNEW.MSF.TextMatrix(k& - 1, 8))
         CANTIXOF = CANTIXOF + XVALO(VENTABNEW.MSF.TextMatrix(k& - 1, 9))
         If NORFA_ANTERIOR <> NORFA$ Then 'ESTA ORDENADO POR OF
            CANTINORFA% = CANTINORFA% + 1 'CADA VEZ QUE CAMBIO LA OF SUMO 1 PARA TENER LA CANTIDAD OF. QUE HAY EN EL REPORTE
            SCRAPX = CANTSCRAP(SAFETEXT$(!idsubor), FE%, NRO$, -1) '-1 para que no considere sector con la of y la maquina seria suficiente.
            VENTABNEW.MSF.TextMatrix(k&, 10) = ROUND(SCRAPX) 'SOLO MUESTRA UN SOLA VEZ EL SCRAP POR OF
            ACUSCRAPX = ACUSCRAPX + SCRAPX
            SUBTACUSCRAPX = SUBTACUSCRAPX + SCRAPX
            TOTCANTHORASOF = TOTCANTHORASOF + CANTHORASOF
         End If
         .MoveNext
         NORFA_ANTERIOR = NORFA$
      Loop

     End With
    rs.Close
    Set rs = Nothing
    '
    
    Call CARGA_TABLA_IMPRE(VENTABNEW.MSF, Campos$, "PDIMPRXMAQ", "PARTE DIARIO IMPRESIÓN X MAQUINA", "TABLA_IMPRE", , 1)
    '*****************************************************'
    Set VENTANA = Nothing
    Unload VENTABNEW
    textox$ = REFE$
    Call REPLA(TEXTOX2$, AJUSTI("TOTAL O.F.: " & CANTINORFA%, 24), 1, 24)
    Call REPLA(TEXTOX2$, AJUSTI("PRODUCCIÓN DIARIA CANTIDAD: " & TRIM$(FORMATNUM$(CANIOKK, "F12.1")), 36), 26, 50)
    Call REPLA(TEXTOX2$, AJUSTI("DOTACIÓN TOTAL: " & env.PARTICIP_SEGUN_DOTACION(INSOLAPASUP%, FE%, "", NRO$), 24), 78, 24)
    Call REPLA(TEXTOX2$, AJUSTI("T.H-Hmb en Máq: " & TRIM$(FORMATNUM$(env.HORASHOMBRE(INSOLAPASUP%, FE%, "", NRO$), "F12.2")), 24), 102, 24)
    Call REPLA(TEXTOX2$, AJUSTI("TOTAL SCRAP: " & TRIM$(FORMATNUM$(ACUSCRAPX, "F12")), 24), 130, 24)

    FILTX$ = TRIM$(FECHATEX$(FE%)) & ";" & TRIM$(NRO$) & ";" & textox$ & ";" & TEXTOX2$
    Call STDFORM("PDPI-ENV", FILTX$)
    Set env = Nothing
   
    

End Sub

