Function VALIDAR_USUARIO_SIESTA_CARGADO_DOTACION%(FE%, NORFA$, DESDEX%, HASTAX%, NUSER%, Optional MODO$)
'    GRILLADES% , GRILLAHAS%
    'ESTA RUTINA VALIDA SI LOS HORARIOS INFORMADOS COMO DETALLE DE TRABAJOS REALIZADOS
    'ESTAN TAMBIEN INFORMADOS COMO DOTACION
    'EJEMPLO SI INFORMA DE 10 A 14 COMO TRABAJO Y EN DOTACION ESTA DE 10 A 13 VA A PROTESTAR
    
    'CRITERIO
    'CONTRASTA LA HORA INFORMADA CON LA GUARDADA COMO DOTACION
    'SE RECORRE LAS HORAS INFORMADAS ORDENADA POR LA HORA DESDE
    'SI LA HORA INFORMADA ES < A LA HORA LEIDA DE LA DOTACION AL ESTAR ORDENADA YA LA TOMA COMO DESBORDE
    'SI POR EJEMPLO SE INFORMA DE 10 A 14 Y COMO DOTACION ESTA CARGADO DE 10 A 12 Y DE 13 A 15 _
    LA PRIMER VUELTA VA A PASAR CUANDO QUIERA BUSCAR EL SALDO QUE LE QUEDA SIN CUBRIR (12 A 14) VA A COMPARAR _
    CONTRA 13 A 15 Y VA A PROVOCAR EL DESBORDE.
    '
    'EN EL CASO QUE NO TENGA VALORES DE DESDE O HASTA LO APRUEBA IGUAL
    'ESTO DADO POR QUE ELLOS INFORMAN EL DESDE Y NO CIERRAN EL HASTA LO DEJAN VACIO.
    'SOLO VA A TERMINAR VALIDANDO SI TIENE LOS DOS DATOS.
    If DESDEX% < 1 Or HASTAX% < 1 Then DESBORDE% = 0: Exit Function
    
    
    VALIDAR_USUARIO_SIESTA_CARGADO_DOTACION% = 1 ' POR DEFECTO LE PONE PARA QUE PROTESTE
    DESBORDE% = 1
          GRILLADES1% = DESDEX%
          GRILLAHAS1% = HASTAX%
    
          SQLX$ = "SELECT * FROM DOTACION WITH(NOLOCK) WHERE FECHA = '" & FETEXCOR1$(FE%) & "' AND NUSER = " & NUSER%
          SQLX$ = SQLX$ + " AND IDSUBOR = '" & NORFA$ & "' AND INDISOLSUP = " & GLOBALFRM_SOLASUP%
          SQLX$ = SQLX$ + " ORDER BY H_DESDE_FN"
          Set rs = READSET(SQLX$)
          With rs
             Do While Not .EOF
               DESLEIDA% = HORANUM(!H_DESDE)
               HASLEIDA% = HORANUM(!H_HASTA)
               If GRILLADES1% < DESLEIDA% Then DESBORDE% = 1: GoTo 90
               If GRILLADES1% >= DESLEIDA% Then
                  If HASLEIDA% <= 0 Then DESBORDE% = 0: GoTo 99 ' SI EL HASTA NO ESTA CARGADO LO DEJA CONTINUAR
                  'PARA CUANDO SOLO INICIALIZAN LA DOTACION Y LA COMPLETAN AL TERMINAR.
                  If GRILLAHAS1% <= HASLEIDA% Then
                     DESBORDE% = 0
                     Exit Do
                  Else
                     GRILLADES1% = HASLEIDA%
                  End If
               End If
               .MoveNext
             Loop
          End With
          rs.Close
          Set rs = Nothing
90        If DESBORDE% > 0 And UCase$(MODO$) <> "NOMESS" Then
             TX$ = "Atención !!! Se Han Informado Horas No Cargadas Como Dotación"
             TX$ = TX$ + "\Para el Usuario: " & NUSER%
             TX$ = TX$ + "\En Orden de Fabricación: " & NORFA$
             TX$ = TX$ + "\Sector: " & SSTab1.Caption
             Call COMUNI(TX$)
             Exit Function
          End If
99        VALIDAR_USUARIO_SIESTA_CARGADO_DOTACION% = DESBORDE%


End Function

