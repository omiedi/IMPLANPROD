                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            End Select
          Next J%
        End If
    Next i&
    '
    'REALIZAR CIERRE DE ORDEN DE FABRICACION
    '1.-VERIFICAR SI LA CANTIDAD APROBADA > CANTIDAD INFORMADA GENERAR CIERRE POR LA DIFERENCIA.
    ' 2.-SI LA CANTIDAD ES IGUAL A LA CANTIDAD PROYECTADA PREGUNTAR SI SE DESEA DAR POR CERRADA LA OF.
    '  3.-VER DE PONER OPCION DE DAR POR CERRADA LA O.F.DE MODO MANUAL O BIEN SI SE VUELVE A GRABAR QUE LO PREGUNTE SIEMPRE
        'FIN VALIDACION DE SOLAPAMIENTO
    OPX% = COMALTER%("Grabación de Datos de Embalaje Realizada\\Finalizar\Generar Cierre de O.Fabricación")
    If OPX% <= 1 Then GoTo 99
    
    If STATORFA%(TXTOT.TEXT) >= 3 Then
       Call COMUNI("Imposible Realizar Cierre de Esta O.Fabricación\La Misma, Yá se Encuentra Cerrada")
       Exit Sub
    End If
    '
    CANTIOKEY = 0
    For REG& = 1 To MSF.Rows - 1
        If XVALO(MSF.TextMatrix(REG&, 8)) > 0 Then
           CANTIOKEY = CANTIOKEY + XVALO(MSF.TextMatrix(REG&, 8))
        End If
    Next REG&

    CANT_APROX = CantiAprobadaOF(TXTOT.TEXT)
    CANTAPROYEX = CantiProyectadaOF(TXTOT.TEXT)
    DIFERENCIA_A_CERRAR = CANTIOKEY - CANT_APROX
    If DIFERENCIA_A_CERRAR > 0 Then
       'FECHINFO$ = FECHATEX$(HOY(HO$))se cambio para que traiga la fecha del servidor
       FECHINFO$ = FECHATEX$(HOYSERVER%)
       Call ORFCIE(TXTOT.TEXT, DIFERENCIA_A_CERRAR, FECHINFO$)
    ElseIf DIFERENCIA_A_CERRAR < 0 Then
       Call COMUNI("Imposible Realizar Cierre de O.F. La Cantidad Aprobada: " & TRIM$(FORMATNUM$(CANT_APROX, "F10.1")) & "\Supera a La Cantidad Total Informada Como Embalaje: " & TRIM$(FORMATNUM$(CANTIOKEY, "F10.1")))
    Else
        Call COMUNI("No se Puede Realizar Cierre O.F. La Cantidad Aprobada: " & TRIM$(FORMATNUM$(CANT_APROX, "F10.1")) & "\Es Igual a La Cantidad Total Informada Como Embalaje: " & TRIM$(FORMATNUM$(CANTIOKEY, "F10.1")))
    End If
    '
99  Screen.MousePointer = 1
    MODIFICADO(Index) = 0
    CMDGRABPARTED(IND%).Enabled = True
End Sub

