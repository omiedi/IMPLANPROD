Private Sub mnuReptrabTermPendEntrega_Click()
    'HAY QUE TENER EN CUENTA QUE LOS PEDIDOS ELLOS NO LOS CIERRAN
    'LA CONSULTA SE ESTA BASANDO EN QUE LAS OF GENERADAS ESTEN CERRADAS NORMALMENTE PARA QUE LOS PENDIENTES SEAN CORRECTOS
    'Y QUE LA CANTIDAD ENTREGADA APROBADA SEA MAYOR A LA REMTIDA, ES DECIR QUE TENGAN UN PENDIENTE PARA ENTREAGAR
    Dim CTP As New Conteplast
    SQLX$ = "SELECT  o.NroPed ,P.NroClie,P.RaSoClie, o.idsubor, m.Cod_Inte,m.Cod_Exte,m.Descrip, "
    SQLX$ = SQLX$ + " o.canapro as cantiFabricada,"
    SQLX$ = SQLX$ + " SUM(m.cantsalid)  As REMITIDA"
    SQLX$ = SQLX$ + " FROM ORDEFABR  O WITH(NOLOCK)"
    SQLX$ = SQLX$ + " INNER JOIN MOVISTO M ON M.IdenLote = O.IDSUBOR"
    SQLX$ = SQLX$ + " INNER JOIN PEDDETA P ON O.NroPed = P.NroPed"
    'SQLX$ = SQLX$ + " where o.StatuOrf = 3  and m.CodiMovi = 'rt' and m.NuPedCli > 0"
    SQLX$ = SQLX$ + " where   m.CodiMovi = 'rt' and m.NuPedCli > 0"
    SQLX$ = SQLX$ + " AND P.STATUS < 8 "
    SQLX$ = SQLX$ + " GROUP BY P.NroClie,P.RaSoClie, o.idsubor, o.NroPed ,m.Cod_Inte,m.Cod_Exte,m.Descrip ,o.canapro"
    SQLX$ = SQLX$ + " Having canapro > SUM(m.cantsalid)"
    SQLX$ = SQLX$ + " ORDER BY o.NroPed ,P.NroClie,P.RaSoClie,o.idsubor, m.Cod_Inte,m.Cod_Exte"
    
    
    Campos$ = "Cliente/A20;Cta/F8;Código/A18;O.F./A12;P.N°/F8;Formato/f8;Corte/F10.2;Polietileno/A30"
    Campos$ = Campos$ + ";Cant.Fab/F10.1;Remitida/F10.1;Saldo/F10.1"
    Call CARGA_ENCABEZADO(GRILLAGRAL.GRID, Campos$, GRILLAGRAL, 1)
    Call CARGA_ENCABEZADO(GRILLAGRAL.MSF_2, Campos$, GRILLAGRAL, 1)
    J& = 0
    
    On Error GoTo ERROR_GUARDAR
    FLEXCONN.BeginTrans
    
    
    SQLX1$ = "DELETE FROM ORDENADOR"
    FLEXCONN.Execute (FILTSQL$(SQLX1$))
    
    
    Set RS0 = READSET(SQLX$)
    With RS0
        Do While Not .EOF
            J& = J& + 1

            CI1% = XVALO(!cod_inte)

            RAZONSO$ = SAFETEXT$(!RaSoClie)

            NCUENTA = XVALO(!NROCLIE)

            Codigo$ = SAFETEXT$(!Cod_Exte)

            NORFA$ = SAFETEXT$(!idsubor)

            NPED& = XVALO(!NROPED) 'obtengo el nro de orden segun codigo y pedido
             'NORDEN% = XVALO(VALOBADA("PEDDETA", "NuOrItem", "NROPED = " & NPED& & " AND CodiInt = " & CI1%, "NOMESS"))

            Formato = FORMATNUM$(ANCHOXNumCodigo$(CI1%) * 100, "F12.0") 'FORMATNUM$(ANCHOESPECIFIC(CI1%), "F12.2")

            corte = FORMATNUM$(XVALO(CORTEESPECIFIC(CI1%)), "F12.2")

            POLIETILENO = DescripXNumCodigo$(CI1%, "40-")

            CANTAPRO = FORMATNUM$(XVALO(!cantiFabricada), "F12.2")

            REMITIDA = FORMATNUM$(XVALO(!REMITIDA), "F12.2")

            SALDO = FORMATNUM$(XVALO(!cantiFabricada) - XVALO(!REMITIDA), "F12.2")
            'FECHENTREGA$ = FECHATEX$(CTP.FechaEntregaSegunNroPedyOrdenPedido(NPED&, NORDEN%))
            'FE% = FECHANUM(FECHENTREGA$)
            
            Dim rs As ADODB.Recordset
            Set rs = New ADODB.Recordset
            SQLX$ = "SELECT * FROM ORDENADOR WHERE ORDENADOR_ID < 1 "
            rs.Open FILTSQL$(SQLX$), FLEXCONN, adOpenKeyset, adLockPessimistic, adCmdText
            rs.AddNew
            

            rs!CAMPONUM1 = NCUENTA

            rs!CAMPOTEXT1 = RAZONSO$
            

            rs!CAMPOTEXT2 = Codigo$

           rs!CAMPOTEXT3 = NORFA$

            rs!CAMPONUM3 = XVALO(Formato)

            rs!CAMPONUM4 = XVALO(corte)

            rs!CAMPOTEXT4 = SAFETEXT$(POLIETILENO)

            rs!CAMPONUM5 = XVALO(CANTAPRO)

            rs!CAMPONUM6 = XVALO(REMITIDA)

            rs!CAMPONUM7 = XVALO(SALDO)

            rs!CAMPONUM8 = NPED&
            rs.Update
            rs.Close
            Set rs = Nothing
            RS0.MoveNext
          Loop
        End With
        
        RS0.Close
        Set RS0 = Nothing
        J& = 0
        SQLX$ = "SELECT * FROM ORDENADOR WITH(NOLOCK) ORDER BY CAMPONUM3,CAMPOTEXT3,CAMPOFECHA1"
