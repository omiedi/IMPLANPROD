          Call USUARIOS_PDIARIO1(ID&, RETMAQ%, RET1%, RET2%, RET3%, RET4%, RET5%, RET6%, RET7%, RET8%) 'DEVUELVE LOS USUARIOS SEGUN ID
          For J% = 0 To 8 'AHORA RECORRO LOS CASILLEROS DE AYUDANTES GUARDADOS EN EL VECTOR
            Select Case J%
            Case 0
                If RETMAQ% > 0 Then
                 If VALIDAR_SOLAPAMIENTO_HORARIO2%(RETMAQ%, FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            Case 1
                If RET1% > 0 Then
                 If VALIDAR_SOLAPAMIENTO_HORARIO2%(RET1%, FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            Case 2
                If RET2% > 0 Then
                 If VALIDAR_SOLAPAMIENTO_HORARIO2%(RET2%, FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            Case 3
                If RET3% > 0 Then
                 If VALIDAR_SOLAPAMIENTO_HORARIO2%(RET3%, FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            Case 4
                If RET4% > 0 Then
                 If VALIDAR_SOLAPAMIENTO_HORARIO2%(RET4%, FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            Case 5
                If RET5% > 0 Then
                 If VALIDAR_SOLAPAMIENTO_HORARIO2%(RET5%, FE%, Des%, Has%, "", ID&, INDISOLSUP%) > 0 Then
                   Call COLOREAR_GRILLA_SOLAFILA(MSF, vbYellow, i&)
                   GoTo 99
                 End If
                End If
            Case 6
