Private Sub MSF1_Click(Index As Integer)
    MODIFICADO(Index) = 1
    REG& = MSF1(Index).MouseRow
    If REG& < 1 Then Exit Sub
    col% = MSF1(Index).MouseCol
    If MSF1(Index).row > MSF1(Index).Rows - 1 Then Exit Sub
    TXTMOVIL(Index).ToolTipText = REG& & "," & col%
    If col% = 3 Then
      With MSF1(Index)
        .CellFontName = "Wingdings"
        .CellFontSize = 14
        .CellAlignment = flexAlignCenterCenter
