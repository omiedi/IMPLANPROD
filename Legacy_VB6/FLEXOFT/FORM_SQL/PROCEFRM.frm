    Me.TXTAYUDANTE2(i%) = ""
    Me.TXTAYUDANTE3(i%) = ""
    Me.TXTAYUDANTE4(i%) = ""
    Me.TXTNUMAYUDANTE1(i%) = ""
    Me.TXTNUMAYUDANTE2(i%) = ""
    Me.TXTNUMAYUDANTE3(i%) = ""
    Me.TXTNUMAYUDANTE4(i%) = ""
    Me.TXTMAQUINA(i%) = ""
    Me.TXTIDMAQ(i%) = ""
    Me.TXTIDMAQUINISTA(i%) = ""
    Me.TXTMAQUINISTA(i%) = ""
    Me.TXTFECHA(i%) = ""
    Me.TXTINICIO(i%) = ""
    Me.TXTFINAL(i%) = ""
    Me.TXTTOTBOBINAS(i%) = ""
    Me.TXTTOTCANTI(i%) = ""
    Me.TXTULTGRAB(i%) = ""
    Call LIMPIAR_MSF_SIN_BORRAR_REGISTROS(MSF10(i%), 2)
