Private Sub ENTRA_GotFocus(Index As Integer)
    '
    If POED%(Index + 1) <> 1 Then
       Call SETNEXTFOCPLA(Index + 1)
    End If
    '
    ENTRA(Index).BackColor = &H80FFFF
    ENTRA(Index).SelStart = 0
    ENTRA(Index).SelLength = Len(ENTRA(Index).TEXT)
    '
End Sub
'

Private Sub ENTRA_KeyPress(Index As Integer, KeyAscii As Integer)
    '
    If KeyAscii = 13 Then
      Call SETNEXTFOCPLA(Index + 1)
    End If
    '
End Sub
'

Private Sub ENTRA_LostFocus(Index As Integer)
    '
