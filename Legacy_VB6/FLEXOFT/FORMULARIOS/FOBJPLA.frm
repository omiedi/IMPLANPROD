Private Sub ENTRA_Change(Index As Integer)
    '
    If AVAL$(Index + 1) <> "" Then
      If RGEC%(Index + 1) > 0 Then
        If CLEC%(Index + 1) > 0 Then
          If LGEC%(Index + 1) > 0 Then
            VDEC$ = ""
            '
            If TRIM$(UCase$(AVAL$(Index + 1))) <> "MASTER" Then
                XXZ$ = CBIN$(ENTRA(Index).TEXT, TIVAA%(Index + 1), LGGR%(Index + 1))
                VDEC$ = ECOARCH$(AVAL$(Index + 1), XXZ$)
              Else
                CI% = CODINT%(ENTRA(Index).TEXT)
                VDEC$ = DESCRIT$(CI%)
            End If
            '
            ECO(Index).TEXT = VDEC$
            '
          End If
        End If
      End If
    End If
    '
End Sub
