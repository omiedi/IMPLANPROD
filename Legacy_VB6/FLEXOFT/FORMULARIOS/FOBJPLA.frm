Private Sub OBJECTNAME_Change()
   '
   If OBJECTNAME.Caption <> "" Then
      '
      OBX$ = OBJECTNAME.Caption
      PPXX% = InStr(OBX$, "/")
      If PPXX% < 2 Then PPXX% = 1 + Len(OBX$)
      OBY$ = TRIM$(Left$(OBX$, PPXX% - 1))
      TTY$ = Mid$(OBX$, PPXX% + 1)
      '
      VDEF$ = OBJECT_DEFVAL
      Call PREPLA(OBY$, VDEF$, TTY$)
      OKEY% = 0
      '
      XXY$ = Left$(VDEF$ + String$(LOREC%, 0), LOREC%)
      For II% = 1 To KPLA%
        XXZ$ = Mid$(XXY$, PXGR%(II%), LGGR%(II%))
        ENTRA(II% - 1).TEXT = TRIM$(MSTRING$(XXZ$, Form$(II%) + "<"))
      Next II%
      '
      SMP = Screen.MousePointer
      Screen.MousePointer = 1
   End If

End Sub

Sub PREPLA(OBY$, VDEF$, TTY$)
       '
       Dim AECO$(32)
       '
       OBJNAME$ = AJUSTI$(UCase$(OBY$), 16)
       OBNAME = OBJNAME$
       '
       OBNM$ = LOADFILE(LUBAS$ + "OBJNAME.DRV")
       For I& = 1 To Len(OBNM$) Step 256
         If Mid$(OBNM$, I&, 16) = OBJNAME$ Then GoTo 10100
       Next I&
       '
       Call COMUNI("Error de Invocación de Rutina 'OBJPLA':\  \No Existe un Objeto denominado '" + OBJNAME$ + "'.")
       Call FINAL("")
       '
10100  X$ = Mid$(OBNM$, I&, 256)
       OBJDESC$ = Mid$(X$, 17, 48)
       OBJTYPE% = CVI(Mid$(X$, 65, 2))
       If OBJTYPE% <> 2 Then
          Call COMUNI("ERROR FATAL: El Objeto\" + TRIM$(OBJNAME$) + " no es\Caja Entrada de Datos.")
          Call FINAL("")
       End If
       OBJPUNT& = CVS(Mid$(X$, 67, 4))
       '
       BSUP% = Asc(Mid$(X$, 71, 1))
       BIZQ% = Asc(Mid$(X$, 72, 1))
       ALTU% = Asc(Mid$(X$, 73, 1))
       ALIB% = Asc(Mid$(X$, 74, 1))
       '
       For UU% = 1 To 32
         AECO$(UU%) = ""
         ARGATRI$ = "ARCHECO(" + TRIM$(Str$(UU%)) + ")="
         PX% = InStr(UCase$(TTY$), ARGATRI$)
         If PX% > 0 Then
            XX$ = Mid$(TTY$, PX% + Len(ARGATRI$))
            PY% = InStr(XX$, "/"): If PY% < 1 Then PY% = 1 + Len(XX$)
            XX$ = Left$(XX$, PY% - 1)
            If TRIM$(XX$) <> "" Then AECO$(UU%) = XX$
            TTY$ = Left$(TTY$, PX% - 1) + Mid$(TTY$, PX% + Len(ARGATRI$) + Len(XX$))
         End If
       Next UU%
       '
       TTZ$ = REPLACAR$(TTY$, "/", "")
       TITU$ = TTZ$
       If TRIM$(TITU$) = "" Then TITU$ = Mid$(X$, 75, 32)
       If TRIM$(TITU$) = "" Then TITU$ = OBJDESC$
       If TRIM$(TITU$) = "" Then TITU$ = OBJNAME$
       COLO$ = Mid$(X$, 107, 3): If MONICOL% <> 1 Then COLO$ = "B-N"
       CIER% = Asc(Mid$(X$, 110, 1)): CIERS$ = "NO"
          If CIER% = 1 Then CIERS$ = "SI"
       CONF% = Asc(Mid$(X$, 111, 1)): CONFS$ = "NO"
          If CONF% = 1 Then CONFS$ = "SI"
          '
10200  PUNTE& = OBJPUNT&: KPLA% = 0: PRICA% = 0
       '
       'Dim X2 As String * 128
       'N1% = FreeFile
       OBDT$ = LOADFILE$(LUBAS$ + "OBJDETA.DRV") ' For Random Access Read Shared As #N1% Len = 128
       '
       LOREC% = Len(VDEF$)
       '
       While PUNTE& > 0
          'Get #N1%, PUNTE&, X2$
          X2$ = Mid$(OBDT$, 1 + 128 * (PUNTE& - 1), 128)
          X$ = Mid$(X2$, 17)
          KPLA% = KPLA% + 1: If KPLA% > 64 Then GoTo 10300
          '
          PUNTE& = CVS(Left$(X$, 4))
          '
          LABE$(KPLA%) = REPLACEN$(TRIM$(Mid$(X$, 5, 30)))
          TIVAA%(KPLA%) = Asc(Mid$(X$, 35, 1))
          RENG%(KPLA%) = Asc(Mid$(X$, 36, 1))
          COLU%(KPLA%) = Asc(Mid$(X$, 37, 1))
          Form$(KPLA%) = TRIM$(Mid$(X$, 38, 6))
          MALEN%(KPLA%) = Int(Val(Mid$(Form$(KPLA%), 2)))
          PPXXYY% = InStr(Form$(KPLA%), "/")
          If PPXXYY% > 0 Then MALEN%(KPLA%) = Int(Val(Mid$(Form$(KPLA%), PPXXYY% + 1)))
          '
          AVAL$(KPLA%) = TRIM$(Mid$(X$, 44, 8))
          If AECO$(KPLA%) <> "" Then AVAL$(KPLA%) = AECO$(KPLA%)
          POED%(KPLA%) = Asc(Mid$(X$, 52, 1))
             If POED%(KPLA%) = 1 Then If PRICA% = 0 Then PRICA% = KPLA%
          RGEC%(KPLA%) = Asc(Mid$(X$, 53, 1))
          CLEC%(KPLA%) = Asc(Mid$(X$, 54, 1))
          LGEC%(KPLA%) = Asc(Mid$(X$, 55, 1))
          PXGR%(KPLA%) = CVI(Mid$(X$, 56, 2))
          LGGR%(KPLA%) = CVI(Mid$(X$, 58, 2))
          '
          If LOREC% < PXGR%(KPLA%) + LGGR%(KPLA%) - 1 Then LOREC% = PXGR%(KPLA%) + LGGR%(KPLA%) - 1
          '
       Wend
       '
10300  For II% = 0 To 31
          ENTRA(II%).Visible = False
          ECO(II%).Visible = False
          Label(II%).Visible = False
          BOTSEL(II%).Visible = False
       Next II%
       '
       REFLABEL.Caption = Space$(ALIB%)
       COEF = REFLABEL.Width / ALIB%
       COEFV = Screen.Height / 25
       Caption = TITU$
       MATOP = Height - ScaleHeight
       '
       Top = BSUP% * COEFV
       Height = MATOP + COEFV * (ALTU% + 0.5) + 1.5 * Command1.Height
       '
       Left = BIZQ% * Screen.Width / 80
       Width = COEF * (ALIB% + 1)
       '
       Command1.Left = (ScaleWidth - 2 * Command1.Width) / 3
       Command2.Left = 2 * Command1.Left + Command1.Width
       Command1.Top = ScaleHeight - 1.3 * Command1.Height
       Command2.Top = ScaleHeight - 1.3 * Command1.Height
       Command1.Visible = True
       Command2.Visible = True
       '
       For II% = 1 To KPLA%
          If TRIM$(LABE$(II%)) <> "" Then
              CLL% = COLU%(II%) - 2
              Label(II% - 1).Font = Label(0).Font
              Label(II% - 1).FontBold = Label(0).FontBold
              Label(II% - 1).Caption = LABE$(II%) + " "
              Label(II% - 1).Left = COEF * (COLU%(II%) - Len(LABE$(II%)) - 2)
              Label(II% - 1).Top = 20 + COEFV * RENG%(II%) - COEFV / 2
              Label(II% - 1).Width = COEF * (2 + Len(LABE$(II%)))
              Label(II% - 1).Visible = True
              '
          End If
          '
          ENTRA(II% - 1).Left = COEF * (COLU%(II%) - 1)
          ENTRA(II% - 1).Top = COEFV * RENG(II%) - COEFV / 2
          ENTRA(II% - 1).Width = COEF * Int(Val(Mid$(Form$(II%), 2)))
          ENTRA(II% - 1).MaxLength = MALEN%(II%)
          ENTRA(II% - 1).Visible = True
          '
          If TRIM$(AVAL$(II%)) <> "" Then
            If LGEC%(II%) > 0 Then
               ECO(II% - 1).Left = COEF * (CLEC%(II%) - 1)
               ECO(II% - 1).Top = COEFV * RGEC%(II%) - COEFV / 2
               ECO(II% - 1).Width = COEF * (LGEC%(II%) + 1)
               ECO(II% - 1).Visible = True
            End If
          End If
          '
          If TRIM$(AVAL$(II%)) <> "" Or TIVAA%(II%) = 5 Then
            If POED%(II%) = 1 Then
              BOTSEL(II% - 1).Top = ENTRA(II% - 1).Top
              BOTSEL(II% - 1).Height = ENTRA(II% - 1).Height
              BOTSEL(II% - 1).Width = BOTSEL(II% - 1).Height * 0.6
              ENTRA(II% - 1).Width = ENTRA(II% - 1).Width + BOTSEL(II% - 1).Height * 0.6
              BOTSEL(II% - 1).Left = ENTRA(II% - 1).Left + ENTRA(II% - 1).Width - BOTSEL(II% - 1).Width
              BOTSEL(II% - 1).Visible = True
            End If
          End If
          '
       Next II%
       '
End Sub

Sub SETNEXTFOCPLA(IIAA%)
    '
    For II% = IIAA% + 1 To KPLA%
       If POED%(II%) = 1 Then
           On Error Resume Next
           ENTRA(II% - 1).SetFocus
           On Error GoTo 0
           Exit Sub
       End If
    Next II%
    Command1.SetFocus
    '
End Sub

