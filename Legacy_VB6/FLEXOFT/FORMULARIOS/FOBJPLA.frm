    If TIVAA%(Index + 1) = 5 Then
         Call SELECHO("SELFECHA")
         VDEV$ = TRIM$(VALACT1$("SELFECHA"))
            If VDEV$ <> "" Then
            ENTRA(Index).TEXT = VDEV$
         End If
         Call SETNEXTFOCPLA(Index + 1)
         Exit Sub
    End If
    '
    If TRIM$(AVAL$(Index + 1)) <> "" Then
         Call SELECHO(AVAL$(Index + 1))
         VDEV$ = TRIM$(VALACT1$(AVAL$(Index + 1)))
         If VDEV$ <> "" Then
             ENTRA(Index).TEXT = VDEV$
         End If
         Call SETNEXTFOCPLA(Index + 1)
       Else
         Call MENSERR(24, "No hay Tabla de Validación\para el Campo Seleccionado.")
    End If
    IANT% = Index
    '
End Sub

Private Sub Command1_Click()
    '
    XXY$ = OBJECT_DEFVAL$
    For II% = 1 To KPLA%
      VDS$(II%) = TRIM$(ENTRA(II% - 1).TEXT)
      If TIVAA%(II%) = 7 Then VDS$(II%) = AJUSTI$(VDS$(II%), 16)
      XXZ$ = CBIN$(VDS$(II%), TIVAA%(II%), LGGR%(II%))
      Mid$(XXY$, PXGR%(II%), LGGR%(II%)) = XXZ$
    Next II%
    OBJECT_RETVAL = XXY$
    '
    Hide
    Call FRESHALL
    '
End Sub

Private Sub Command2_Click()
    '
    OBJECT_RETVAL$ = ""
    Hide
    Call FRESHALL
    '
End Sub

