Exit Sub
    If Option1(4).Value = True Then  ' pantalla
         If Option1(3).Value = False Then
            Call FINAL("*COFAPE1")
            Exit Sub
          Else
            Call FINAL("*COFAPE2")
            Exit Sub
         End If
       Else                          ' impresora
         If Option1(3).Value = False Then
            Call FINAL("*LIFAPE1")
            Exit Sub
